#!/bin/bash
# ASC Hub, one container: starts the hub and `asc serve` together and keeps them together.
#
#  0. Refuse to start on a volume this user cannot write, or one that another hub already uses.
#  1. First boot: generate the shared secrets under $WORK/bootstrap. Every boot: write the
#     asc serve configuration from the environment, so a changed variable takes effect.
#  2. `asc serve migrate`, then the hub, then (when the hub answers) `asc serve` on 127.0.0.1:7890.
#  3. Optionally create the first administrator once.
#  4. Wait for either process to exit. If one exits, stop the other and exit non-zero, so the
#     container restarts as a whole. SIGTERM and SIGINT are forwarded to both and give exit 0.
#
# Run as the unprivileged user (uid 1000). pid 1 is dumb-init, which starts this script.
#
# ASC_HUB_TEST_HUB_COMMAND and ASC_HUB_TEST_FORGEJO replace the hub launcher and the `forgejo`
# command. They exist so that tests/allinone/entrypoint_test.sh can run this script against fake
# programs; leave them unset.

set -euo pipefail

WORK="${GITEA_WORK_DIR:-/var/lib/gitea}"
BOOT="$WORK/bootstrap"
ASC_DIR="$WORK/asc"
REPO_ROOT="$WORK/git/repositories"
SERVE_CFG="$ASC_DIR/asc-serve.toml"
LOCK_FILE="$WORK/.asc-hub.lock"
ASC_BIN="${ASC_BINARY:-/usr/local/bin/asc}"
HUB_CMD="${ASC_HUB_TEST_HUB_COMMAND:-/usr/local/bin/docker-entrypoint.sh}"
FORGEJO_CMD="${ASC_HUB_TEST_FORGEJO:-forgejo}"

# What belongs to asc serve and must not reach the hub.
HUB_UNSET=(-u ASC_DATABASE_URL -u ASC_S3_ACCESS_KEY_ID -u ASC_S3_SECRET_ACCESS_KEY -u ASC_ALLOW_LOOPBACK_HTTP)

log() { printf 'asc-hub: %s\n' "$*" >&2; }
die() {
	log "error: $*"
	exit 1
}

# A command line (docker run IMAGE forgejo admin ...) runs the hub's own entrypoint and nothing else.
if [ "$#" -gt 0 ]; then
	exec "$HUB_CMD" "$@"
fi

# set_default NAME VALUE: export NAME=VALUE unless NAME is already set (even to an empty string).
set_default() {
	if [ -z "${!1+x}" ]; then
		export "$1=$2"
	fi
}

# safe_value NAME: the value goes into a TOML string, so refuse quotes and line breaks.
safe_value() {
	local v="${!1:-}"
	case "$v" in
	*\'* | *\"* | *$'\n'* | *$'\r'*) die "$1 must not contain quotes or line breaks" ;;
	esac
}

# require_match NAME REGEX WHAT: when NAME is set and not empty it must match REGEX.
require_match() {
	local v="${!1:-}"
	if [ -n "$v" ] && ! [[ "$v" =~ $2 ]]; then
		die "$1 is not valid: expected $3"
	fi
}

# url_host URL: the host name of an absolute URL (no user info, no port, no brackets).
url_host() {
	local h="${1#*://}"
	h="${h%%/*}"
	h="${h##*@}"
	case "$h" in
	\[*)
		h="${h#\[}"
		h="${h%%\]*}"
		;;
	*) h="${h%%:*}" ;;
	esac
	printf '%s' "$h"
}

is_loopback_host() {
	case "$1" in
	localhost | 127.* | ::1) return 0 ;;
	esac
	return 1
}

# --- the volume ------------------------------------------------------------------------------

if [ "$(id -u)" = 0 ]; then
	die "do not run as root; the hub refuses to start as root. Run as uid 1000 (the image default)."
fi
uid="$(id -u)"
hint="the volume at $WORK must be owned by uid 1000; for a bind mount run: chown -R 1000:1000 <host directory>"
[ -d "$WORK" ] || die "$WORK does not exist; $hint"
{ [ -w "$WORK" ] && [ -x "$WORK" ]; } || die "$WORK is not writable by uid $uid; $hint"
foreign="$(find "$WORK" -xdev -maxdepth 3 -name lost+found -prune -o ! -user "$uid" -print -quit 2>/dev/null || true)"
[ -z "$foreign" ] || die "$foreign is not owned by uid $uid; $hint"

# One hub per volume. Both programs inherit this lock, so a second container, or the backup script,
# cannot touch the volume while either of them still runs.
{ exec 9>>"$LOCK_FILE"; } 2>/dev/null || die "cannot open $LOCK_FILE; $hint"
flock -n 9 || die "another ASC Hub is running on $WORK (lock $LOCK_FILE is held)"

# --- validate the environment before anything is written -------------------------------------

require_match ASC_HUB_START_TIMEOUT '^[0-9]{1,4}$' "a number of seconds"
timeout="${ASC_HUB_START_TIMEOUT:-120}"
[ "$timeout" -ge 1 ] || die "ASC_HUB_START_TIMEOUT must be at least 1"

require_match ASC_HUB_ASC_PORT '^[0-9]{1,5}$' "a port number"
ASC_PORT="${ASC_HUB_ASC_PORT:-7890}"
{ [ "$ASC_PORT" -ge 1 ] && [ "$ASC_PORT" -le 65535 ]; } || die "ASC_HUB_ASC_PORT must be between 1 and 65535"

# Git over SSH is off unless ASC_HUB_SSH_ENABLE=true: the only inbound port is HTTPS.
require_match ASC_HUB_SSH_ENABLE '^(true|false)$' "true or false"
SSH_ENABLE="${ASC_HUB_SSH_ENABLE:-false}"

ADMIN_USER="${ASC_HUB_ADMIN_USER:-asc-admin}"
if [ -n "${ASC_HUB_ADMIN_EMAIL:-}" ]; then
	require_match ASC_HUB_ADMIN_EMAIL '^[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}$' "an e-mail address such as admin@example.org"
	require_match ASC_HUB_ADMIN_USER '^[A-Za-z0-9][A-Za-z0-9_.-]{0,38}$' "letters, digits, '-', '_' and '.', starting with a letter or digit, at most 39 characters"
fi

# --- directories and secrets --------------------------------------------------------------

(
	umask 077
	mkdir -p "$BOOT" "$ASC_DIR" "$ASC_DIR/objects" "$ASC_DIR/cache" "$ASC_DIR/gitview" "$ASC_DIR/home"
) || die "cannot create the state directories under $WORK; $hint"
mkdir -p "$REPO_ROOT"
chmod 0700 "$BOOT" "$ASC_DIR"

# ensure_secret FILE LENGTH [CHARS]: create a random secret once and keep it (alphanumeric unless CHARS says otherwise).
ensure_secret() {
	local f="$1" n="$2" chars="${3:-A-Za-z0-9}"
	if [ ! -s "$f" ]; then
		rm -f "$f.tmp"
		(
			umask 077
			set +o pipefail
			LC_ALL=C tr -dc "$chars" </dev/urandom | head -c "$n" >"$f.tmp"
		)
		[ "$(stat -c %s "$f.tmp")" -ge "$n" ] || die "could not generate $f"
		mv -f "$f.tmp" "$f"
	fi
	chmod 0400 "$f"
}
ensure_secret "$BOOT/internal-token" 48
ensure_secret "$BOOT/webhook-secret" 48
# The key of the claims the hub signs about the signed-in person (32 bytes as 64 hex digits). The hub makes no access
# tokens for its web pages: it calls asc serve with its own credential and a signed claim, and asc serve verifies the
# claim with this same file.
ensure_secret "$BOOT/forwarded-key" 64 '0-9a-f'
ensure_secret "$BOOT/secret-key" 64

# --- hub defaults (each can be overridden by setting the variable) -------------------------

if [ -z "${ROOT_URL:-}" ] && [ -z "${FORGEJO__server__ROOT_URL:-}" ]; then
	log "warning: ROOT_URL is not set; using http://localhost:3000/ (set ROOT_URL to the public https address)"
fi
set_default ROOT_URL "http://localhost:3000/"
ROOT_URL="${FORGEJO__server__ROOT_URL:-$ROOT_URL}"
case "$ROOT_URL" in
http://* | https://*) ;;
*) die "ROOT_URL must be an absolute http or https URL (got '$ROOT_URL')" ;;
esac
host="$(url_host "$ROOT_URL")"
[ -n "$host" ] || die "ROOT_URL has no host name"

set_default APP_NAME "ASC Hub"
if [ "$SSH_ENABLE" = true ]; then
	# Opt in: the hub's built-in SSH server listens on SSH_LISTEN_PORT (publish it yourself) and clone
	# addresses show SSH_DOMAIN and SSH_PORT. The values are forced, so a stray variable cannot turn it off.
	set_default SSH_DOMAIN "$host"
	set_default SSH_PORT "2222"
	set_default SSH_LISTEN_PORT "2222"
	export DISABLE_SSH=false START_SSH_SERVER=true FORGEJO__server__DISABLE_SSH=false FORGEJO__server__START_SSH_SERVER=true
	export FORGEJO__asc__SSH_ENABLED=true
else
	# The default: no SSH server, no SSH instructions in the UI. These are forced, whatever the
	# environment says, because an SSH port is not reachable behind the HTTPS proxy anyway.
	for v in SSH_PORT SSH_LISTEN_PORT FORGEJO__server__SSH_PORT FORGEJO__server__SSH_LISTEN_PORT; do
		if [ -n "${!v:-}" ]; then log "warning: $v is ignored because ASC_HUB_SSH_ENABLE is not true"; fi
	done
	set_default SSH_DOMAIN "$host"
	export DISABLE_SSH=true START_SSH_SERVER=false FORGEJO__server__DISABLE_SSH=true FORGEJO__server__START_SSH_SERVER=false
	export FORGEJO__asc__SSH_ENABLED=false
fi
set_default INSTALL_LOCK "true"
set_default DISABLE_REGISTRATION "true"
SECRET_KEY="${SECRET_KEY:-$(cat "$BOOT/secret-key")}"
export SECRET_KEY

set_default FORGEJO__server__ROOT_URL "$ROOT_URL"
set_default FORGEJO__actions__ENABLED "true"
# The shared secret is a file, so it never lands in app.ini. The hub refuses a file URI together with
# a literal INTERNAL_TOKEN, so INSTALL_LOCK stays true (the web installer would write one).
set_default FORGEJO__security__INTERNAL_TOKEN_URI "file://$BOOT/internal-token"
set_default FORGEJO__asc__FORWARDED_KEY_URI "file://$BOOT/forwarded-key"
set_default FORGEJO__asc__ENABLED "true"
set_default FORGEJO__asc__SERVER_URL "http://127.0.0.1:${ASC_PORT}"
set_default FORGEJO__asc__PUBLIC_URL "${ROOT_URL%/}"
set_default FORGEJO__asc__WRITER "asc"
set_default FORGEJO__asc__NEW_REPOSITORIES "asc"
set_default FORGEJO__asc__BRIDGE "${ASC_HUB_BRIDGE:-eager}"
set_default FORGEJO__asc__SHADOW_SAMPLE_PERCENT "0"

# --- the asc download page: signed releases fetched from a private source ----------------------
# ASC_HUB_DOWNLOAD_SOURCE_URL is an https address: the API address of a (private) GitHub release such as
# https://api.github.com/repos/OWNER/REPO/releases/latest, or a directory that holds manifest.json and the files.
# The hub fetches the release into $WORK/asc-releases on start and then every ASC_HUB_DOWNLOAD_SYNC_INTERVAL, and
# publishes it only when the checksums and the files verify with ASC_HUB_DOWNLOAD_PUBLIC_KEY. A token that may read a
# private release is ASC_HUB_DOWNLOAD_SOURCE_TOKEN_FILE (a file, best) or ASC_HUB_DOWNLOAD_SOURCE_TOKEN; either way
# the hub reads it from a file, so it does not land in app.ini.
DL_URL="${ASC_HUB_DOWNLOAD_SOURCE_URL:-}"
if [ -n "$DL_URL" ]; then
	require_match ASC_HUB_DOWNLOAD_SOURCE_URL '^https://[^[:space:]?#@\]+$' "an https address without credentials, query or fragment"
	[ -n "${ASC_HUB_DOWNLOAD_PUBLIC_KEY:-}" ] || die "ASC_HUB_DOWNLOAD_SOURCE_URL needs ASC_HUB_DOWNLOAD_PUBLIC_KEY: the minisign public key the release is signed with"
	require_match ASC_HUB_DOWNLOAD_PUBLIC_KEY '^[A-Za-z0-9+/=]{40,120}$' "the key line of a minisign .pub file (it starts with RW)"
	require_match ASC_HUB_DOWNLOAD_SYNC_INTERVAL '^[1-9][0-9]{0,4}[mh]$' "a number of minutes or hours such as 30m or 6h"
	if [ -n "${ASC_HUB_DOWNLOAD_SOURCE_TOKEN:-}" ] && [ -n "${ASC_HUB_DOWNLOAD_SOURCE_TOKEN_FILE:-}" ]; then
		die "set ASC_HUB_DOWNLOAD_SOURCE_TOKEN or ASC_HUB_DOWNLOAD_SOURCE_TOKEN_FILE, not both"
	fi
	DL_TOKEN_FILE="${ASC_HUB_DOWNLOAD_SOURCE_TOKEN_FILE:-}"
	if [ -n "$DL_TOKEN_FILE" ]; then
		[ -r "$DL_TOKEN_FILE" ] || die "ASC_HUB_DOWNLOAD_SOURCE_TOKEN_FILE ($DL_TOKEN_FILE) cannot be read"
	elif [ -n "${ASC_HUB_DOWNLOAD_SOURCE_TOKEN:-}" ]; then
		DL_TOKEN_FILE="$BOOT/download-source-token"
		(umask 077 && printf '%s' "$ASC_HUB_DOWNLOAD_SOURCE_TOKEN" >"$DL_TOKEN_FILE")
	fi
	unset ASC_HUB_DOWNLOAD_SOURCE_TOKEN
	set_default FORGEJO__asc__DOWNLOAD_DIR "$WORK/asc-releases"
	set_default FORGEJO__asc__DOWNLOAD_SOURCE_URL "$DL_URL"
	set_default FORGEJO__asc__DOWNLOAD_PUBLIC_KEY "$ASC_HUB_DOWNLOAD_PUBLIC_KEY"
	if [ -n "${ASC_HUB_DOWNLOAD_SYNC_INTERVAL:-}" ]; then set_default FORGEJO__asc__DOWNLOAD_SYNC_INTERVAL "$ASC_HUB_DOWNLOAD_SYNC_INTERVAL"; fi
	if [ -n "$DL_TOKEN_FILE" ]; then set_default FORGEJO__asc__DOWNLOAD_SOURCE_TOKEN_URI "file://$DL_TOKEN_FILE"; fi
else
	for v in ASC_HUB_DOWNLOAD_PUBLIC_KEY ASC_HUB_DOWNLOAD_SOURCE_TOKEN ASC_HUB_DOWNLOAD_SOURCE_TOKEN_FILE ASC_HUB_DOWNLOAD_SYNC_INTERVAL; do
		if [ -n "${!v:-}" ]; then log "warning: $v is ignored because ASC_HUB_DOWNLOAD_SOURCE_URL is not set"; fi
	done
fi

# Clients send credentials to the public address, so it is https unless it is a loopback host. The
# hub checks this too; saying it here names the variable to change.
# shellcheck disable=SC2154 # set by set_default above
case "$FORGEJO__asc__PUBLIC_URL" in
https://*) ;;
http://*)
	is_loopback_host "$(url_host "$FORGEJO__asc__PUBLIC_URL")" ||
		die "the public address ($FORGEJO__asc__PUBLIC_URL) must use https unless the host is loopback; set ROOT_URL to the https address that your TLS proxy serves"
	;;
*) die "[asc] PUBLIC_URL must be an absolute https URL (got '$FORGEJO__asc__PUBLIC_URL')" ;;
esac

HTTP_PORT_EFFECTIVE="${FORGEJO__server__HTTP_PORT:-${HTTP_PORT:-3000}}"
[[ "$HTTP_PORT_EFFECTIVE" =~ ^[0-9]{1,5}$ ]] || die "the hub's HTTP port is not a number (got '$HTTP_PORT_EFFECTIVE')"
HUB_URL="http://127.0.0.1:${HTTP_PORT_EFFECTIVE}"

# --- asc serve configuration ----------------------------------------------------------------

# shellcheck disable=SC2154 # set by set_default above
BRIDGE="$(printf '%s' "$FORGEJO__asc__BRIDGE" | tr '[:upper:]' '[:lower:]')"
case "$BRIDGE" in
eager)
	BRIDGE_PROMOTE=true
	GIT_ENABLED=true
	;;
lazy | off)
	BRIDGE_PROMOTE=false
	GIT_ENABLED="${ASC_GIT_ENABLED:-false}"
	;;
*) die "[asc] BRIDGE must be eager, lazy or off (got '$FORGEJO__asc__BRIDGE')" ;;
esac

for v in ASC_S3_ENDPOINT ASC_S3_BUCKET ASC_S3_REGION ASC_DATABASE_URL ASC_CACHE_MEMORY ASC_CACHE_DISK ASC_TEXT_MEMORY ASC_GIT_ENABLED; do
	safe_value "$v"
done
require_match ASC_GIT_ENABLED '^(true|false)$' "true or false"
require_match ASC_LOG_FORMAT '^(text|json)$' "text or json"
require_match ASC_CACHE_MEMORY '^[0-9]+[A-Za-z]{0,3}$' "a size such as 256MiB"
require_match ASC_CACHE_DISK '^[0-9]+[A-Za-z]{0,3}$' "a size such as 2GiB"
require_match ASC_TEXT_MEMORY '^[0-9]+[A-Za-z]{0,3}$' "a size such as 256MiB"
require_match ASC_S3_ENDPOINT '^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$' "an https URL without query, fragment or credentials (asc serve refuses plain http)"
require_match ASC_S3_BUCKET '^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$' "a bucket name"
require_match ASC_S3_REGION '^[A-Za-z0-9-]{1,32}$' "a region name"
case "${ASC_DATABASE_URL:-}" in
"" | sqlite://* | postgres://* | postgresql://*) ;;
*) die "ASC_DATABASE_URL must start with sqlite://, postgres:// or postgresql://" ;;
esac
if [ -n "${ASC_S3_ENDPOINT:-}" ] && { [ -z "${ASC_S3_ACCESS_KEY_ID:-}" ] || [ -z "${ASC_S3_SECRET_ACCESS_KEY:-}" ]; }; then
	die "ASC_S3_ENDPOINT needs ASC_S3_ACCESS_KEY_ID and ASC_S3_SECRET_ACCESS_KEY"
fi

if [ -n "${ASC_S3_ENDPOINT:-}" ]; then
	STORE="s3://${ASC_S3_BUCKET:-asc-hub}?endpoint=${ASC_S3_ENDPOINT}&region=${ASC_S3_REGION:-garage}&path_style=true"
else
	STORE="file://$ASC_DIR/objects"
fi
if [ -n "${ASC_DATABASE_URL:-}" ]; then
	DB="$ASC_DATABASE_URL"
else
	DB="sqlite://$ASC_DIR/asc.db?mode=rwc"
fi

(
	umask 077
	{
		printf 'listen = "127.0.0.1:%s"\n' "$ASC_PORT"
		printf "store = '%s'\n" "$STORE"
		printf "db = '%s'\n" "$DB"
		printf 'cache = { memory = "%s", disk_dir = "%s/cache", disk = "%s" }\n\n' "${ASC_CACHE_MEMORY:-256MiB}" "$ASC_DIR" "${ASC_CACHE_DISK:-2GiB}"
		printf '[auth]\nprovider = "forgejo"\nforwarded_key_file = "%s/forwarded-key"\n\n' "$BOOT"
		printf '[forgejo]\nurl = "%s"\n' "$HUB_URL"
		printf 'internal_token_file = "%s/internal-token"\n' "$BOOT"
		printf 'webhook_secret_file = "%s/webhook-secret"\n' "$BOOT"
		printf 'repo_root = "%s"\n' "$REPO_ROOT"
		printf 'bridge_promote = %s\n\n' "$BRIDGE_PROMOTE"
		printf '[limits]\ntext_memory = "%s"\ntrusted_proxies = ["127.0.0.1/32"]\n\n' "${ASC_TEXT_MEMORY:-256MiB}"
		printf '[git]\nenabled = %s\nview_dir = "%s/gitview"\n\n' "$GIT_ENABLED" "$ASC_DIR"
		# asc serve has its own SSH listener; it stays off. The hub's SSH server (ASC_HUB_SSH_ENABLE) is the one that serves git over SSH.
		printf '[ssh]\nenabled = false\n'
	} >"$SERVE_CFG.tmp"
)
mv -f "$SERVE_CFG.tmp" "$SERVE_CFG"

# run_asc ARGS: replaces the (background) shell with asc, run with its own small environment: what it
# needs to run and the object store keys. It does not get the hub's SECRET_KEY or database password.
# Plain http to the hub on loopback is allowed for this process only.
run_asc() {
	local -a e=(
		"PATH=$PATH"
		"HOME=$ASC_DIR/home"
		"ASC_SERVE_CONFIG=$SERVE_CFG"
		"ASC_ALLOW_LOOPBACK_HTTP=1"
		"RUST_LOG=${ASC_LOG:-info}"
		"ASC_LOG_FORMAT=${ASC_LOG_FORMAT:-text}"
		"AWS_ACCESS_KEY_ID=${ASC_S3_ACCESS_KEY_ID:-}"
		"AWS_SECRET_ACCESS_KEY=${ASC_S3_SECRET_ACCESS_KEY:-}"
		"AWS_REGION=${ASC_S3_REGION:-garage}"
	)
	local v
	for v in LANG LC_ALL TZ TMPDIR HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy SSL_CERT_FILE SSL_CERT_DIR; do
		if [ -n "${!v+x}" ]; then e+=("$v=${!v}"); fi
	done
	exec env -i "${e[@]}" "$ASC_BIN" "$@"
}

# --- supervision ---------------------------------------------------------------------------

hub_pid=""
asc_pid=""
mig_pid=""
stopping=0

stop_all() {
	local p
	for p in "$asc_pid" "$hub_pid" "$mig_pid"; do
		if [ -n "$p" ]; then kill -TERM "$p" 2>/dev/null || true; fi
	done
}

on_signal() {
	stopping=1
	log "signal received, stopping"
	stop_all
}
trap on_signal TERM INT

# reap gives the processes a grace period (shorter than stop_grace_period: 30s), then kills what is left.
reap() {
	local i p alive
	for i in $(seq 1 25); do
		alive=0
		for p in "$asc_pid" "$hub_pid" "$mig_pid"; do
			if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then alive=1; fi
		done
		[ "$alive" = 0 ] && break
		sleep 1
	done
	for p in "$asc_pid" "$hub_pid" "$mig_pid"; do
		if [ -n "$p" ]; then kill -KILL "$p" 2>/dev/null || true; fi
	done
	wait 2>/dev/null || true
}

# The migration runs in the background so that a stop request does not wait for it.
log "asc serve migrate"
run_asc serve migrate &
mig_pid=$!
set +e
wait "$mig_pid"
rc=$?
set -e
if [ "$stopping" = 1 ]; then
	reap
	exit 0
fi
mig_pid=""
[ "$rc" -eq 0 ] || die "asc serve migrate failed (status $rc)"

log "starting the hub"
(exec env "${HUB_UNSET[@]}" "$HUB_CMD") &
hub_pid=$!

# asc serve asks the hub for authorization, so start it once the hub answers.
up=0
for ((i = 0; i < timeout; i++)); do
	if [ "$stopping" = 1 ]; then
		reap
		exit 0
	fi
	if ! kill -0 "$hub_pid" 2>/dev/null; then
		set +e
		wait "$hub_pid"
		rc=$?
		set -e
		die "the hub exited during start (status $rc)"
	fi
	if curl -fsS -m 3 -o /dev/null "$HUB_URL/api/healthz" 2>/dev/null; then
		up=1
		break
	fi
	sleep 1
done
if [ "$stopping" = 1 ]; then
	reap
	exit 0
fi
if [ "$up" != 1 ]; then
	stop_all
	reap
	die "the hub did not answer $HUB_URL/api/healthz within ${timeout}s"
fi

log "starting asc serve"
run_asc serve &
asc_pid=$!

# --- first administrator (once) --------------------------------------------------------------

if [ -n "${ASC_HUB_ADMIN_EMAIL:-}" ] && [ ! -e "$BOOT/.admin-done" ]; then
	(
		umask 077
		if env "${HUB_UNSET[@]}" "$FORGEJO_CMD" admin user list 2>/dev/null | awk 'NR>1 {print $2}' | grep -qx -- "$ADMIN_USER"; then
			: >"$BOOT/.admin-done"
			log "user $ADMIN_USER exists: nothing to create"
		elif env "${HUB_UNSET[@]}" "$FORGEJO_CMD" admin user create --admin --username "$ADMIN_USER" --email "$ASC_HUB_ADMIN_EMAIL" \
			--random-password --must-change-password=true >"$BOOT/admin-password.tmp"; then
			mv -f "$BOOT/admin-password.tmp" "$BOOT/admin-password"
			: >"$BOOT/.admin-done"
			log "admin $ADMIN_USER created: the password is in $BOOT/admin-password (mode 0600); change it at first sign-in, then delete the file"
		else
			rm -f "$BOOT/admin-password.tmp"
			log "warning: creating the admin user failed; it is tried again at the next start, or create it by hand (docs/asc/OPERATIONS.md)"
		fi
	) || true
fi

# --- wait --------------------------------------------------------------------------------------

set +e
wait -n "$hub_pid" "$asc_pid"
rc=$?
set -e

if [ "$stopping" = 1 ]; then
	reap
	exit 0
fi
log "a process exited (status $rc); stopping the other one"
stop_all
reap
[ "$rc" -ne 0 ] || rc=1
exit "$rc"
