{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content ui {{if .IsRepo}}repository{{end}}">
	{{if .IsRepo}}{{template "repo/header" .}}{{end}}
	<div class="hub-status">
		<p class="error-code" aria-hidden="true">404</p>
		<h1 class="hub-status-title">{{ctx.Locale.Tr "asc_status.not_found_title"}}</h1>
		<p class="hub-status-text">{{if .NotFoundPrompt}}{{.NotFoundPrompt}}{{else}}{{ctx.Locale.Tr "error404"}}{{end}}</p>
		<div class="hub-status-actions">
			{{if .NotFoundGoBackURL}}<a class="hub-btn hub-btn-primary-solid" href="{{.NotFoundGoBackURL}}">{{ctx.Locale.Tr "go_back"}}</a>{{end}}
			<a class="hub-btn hub-btn-outline" href="{{AppSubUrl}}/">{{if .IsSigned}}{{ctx.Locale.Tr "dashboard"}}{{else}}{{ctx.Locale.Tr "home"}}{{end}}</a>
			<a class="hub-btn hub-btn-outline" href="{{AppSubUrl}}/explore/repos">{{ctx.Locale.Tr "explore"}}</a>
		</div>
		{{if .ShowFooterVersion}}<p class="hub-status-meta">{{ctx.Locale.Tr "admin.config.app_ver"}}: {{AppVerNoMetadata}}</p>{{end}}
	</div>
</div>
{{template "base/footer" .}}
