{{/*
Top of every Storage and AI keys page.
  .Root    the page data (.)
  .Active  "storage" or "ai"
*/}}
{{$a := .Root.Asc}}
<nav class="asc-byo-tabs" aria-label="{{ctx.Locale.Tr "ascbyo.nav_storage"}} / {{ctx.Locale.Tr "ascbyo.nav_ai"}}">
	<a class="asc-byo-tab{{if eq .Active "storage"}} active{{end}}" href="{{$a.StorageURL}}"{{if eq .Active "storage"}} aria-current="page"{{end}}>{{svg "octicon-database" 16}} {{ctx.Locale.Tr "ascbyo.nav_storage"}}</a>
	<a class="asc-byo-tab{{if eq .Active "ai"}} active{{end}}" href="{{$a.AIURL}}"{{if eq .Active "ai"}} aria-current="page"{{end}}>{{svg "octicon-key" 16}} {{ctx.Locale.Tr "ascbyo.nav_ai"}}</a>
</nav>
<p class="asc-byo-scope">
	{{if eq $a.Kind "user"}}{{ctx.Locale.Tr "ascbyo.scope.user"}}
	{{else if eq $a.Kind "org"}}{{ctx.Locale.Tr "ascbyo.scope.org" $a.ScopeLabel}}
	{{else}}{{ctx.Locale.Tr "ascbyo.scope.repo" $a.ScopeLabel}}{{end}}
</p>
{{with $a.Problem}}
	<div class="ui negative message asc-byo-problem" role="alert" data-testid="asc-byo-problem">
		<p>{{.Message}}</p>
		{{if .Reason}}<p>{{.Reason}}</p>{{end}}
		{{if .Detail}}<p class="asc-byo-detail">{{.Detail}}</p>{{end}}
	</div>
{{end}}
{{if $a.Unsupported}}
	<div class="ui warning message" role="status" data-testid="asc-byo-unsupported"><p>{{ctx.Locale.Tr "ascbyo.unsupported"}}</p></div>
{{else if $a.Unavailable}}
	<div class="ui warning message" role="status" data-testid="asc-byo-unavailable"><p>{{ctx.Locale.Tr "ascbyo.unavailable"}}</p></div>
{{end}}
