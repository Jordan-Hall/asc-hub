{{/* Repository only: usage, where new objects go, migration, progress and history. */}}
{{$a := .Asc}}
<section class="asc-byo-card" aria-labelledby="asc-usage-h" data-testid="asc-storage-usage">
	<h3 id="asc-usage-h">{{ctx.Locale.Tr "ascbyo.storage.usage.title"}}</h3>
	{{if $a.UsageFailed}}
		<p class="asc-byo-empty">{{ctx.Locale.Tr "ascbyo.storage.usage.failed"}}</p>
	{{else}}{{with $a.Usage}}
		{{if .ComputedAt}}
			<p class="asc-usage-total"><strong>{{ctx.Locale.TrSize .TotalSize}}</strong> {{ctx.Locale.Tr "ascbyo.storage.usage.objects" .Objects}}</p>
			{{if .Kinds}}
				<table class="ds-table asc-stack asc-usage-kinds" data-testid="asc-usage-kinds">
					<thead>
						<tr>
							<th>{{ctx.Locale.Tr "ascbyo.storage.usage.kind"}}</th>
							<th>{{ctx.Locale.Tr "ascbyo.storage.usage.size"}}</th>
							<th>{{ctx.Locale.Tr "ascbyo.storage.usage.count"}}</th>
						</tr>
					</thead>
					<tbody>
						{{$total := .Total}}
						{{range .Kinds}}
							<tr data-kind="{{.Name}}">
								<td data-label="{{ctx.Locale.Tr "ascbyo.storage.usage.kind"}}">{{ctx.Locale.Tr .Key}}</td>
								<td data-label="{{ctx.Locale.Tr "ascbyo.storage.usage.size"}}">
									<progress class="asc-usage-bar" max="{{$total}}" value="{{.Bytes}}" aria-label="{{ctx.Locale.Tr .Key}}"></progress>
									{{ctx.Locale.TrSize .Size}}
								</td>
								<td data-label="{{ctx.Locale.Tr "ascbyo.storage.usage.count"}}">{{.Objects}}</td>
							</tr>
						{{end}}
					</tbody>
				</table>
			{{else}}
				<p class="asc-byo-empty">{{ctx.Locale.Tr "ascbyo.storage.usage.empty"}}</p>
			{{end}}
			<p class="asc-byo-hint">{{ctx.Locale.Tr "ascbyo.storage.usage.counted" (DateUtils.TimeSince .ComputedAt)}}</p>
		{{else}}
			<p class="asc-byo-empty">{{ctx.Locale.Tr "ascbyo.storage.usage.first"}}</p>
		{{end}}
		{{if .Month}}<p data-testid="asc-usage-read">{{ctx.Locale.Tr "ascbyo.storage.usage.read" (ctx.Locale.TrSize .ReadSize) .Month}}</p>{{end}}
		{{if .Computing}}
			<p class="asc-byo-hint" role="status" data-testid="asc-usage-computing">{{ctx.Locale.Tr "ascbyo.storage.usage.computing"}}</p>
		{{else}}
			<form method="post" action="{{$a.StorageURL}}/usage/refresh">
				{{$.CsrfTokenHtml}}
				<button class="ds-btn" type="submit">{{ctx.Locale.Tr "ascbyo.storage.usage.refresh"}}</button>
			</form>
		{{end}}
	{{end}}{{end}}
</section>

<section class="asc-byo-card" aria-labelledby="asc-assign-h">
	<h3 id="asc-assign-h">{{ctx.Locale.Tr "ascbyo.storage.repo.assign_title"}}</h3>
	<p>{{ctx.Locale.Tr "ascbyo.storage.repo.assign_help"}}</p>
	{{if $a.Usable}}
		<form class="asc-byo-form" method="post" action="{{$a.StorageURL}}/assign" data-testid="asc-assign">
			{{.CsrfTokenHtml}}
			<input type="hidden" name="op_id" value="{{$a.Op "assign"}}">
			<div class="ds-field asc-field">
				<label for="asc-assign-target">{{ctx.Locale.Tr "ascbyo.storage.repo.assign_field"}}</label>
				<select class="ds-select" id="asc-assign-target" name="target_id">
					<option value="">{{ctx.Locale.Tr "ascbyo.storage.repo.assign_default"}}</option>
					{{range $a.Usable}}<option value="{{.ID}}">{{.Label}}</option>{{end}}
				</select>
			</div>
			<button class="ds-btn ds-btn-primary" type="submit">{{ctx.Locale.Tr "ascbyo.storage.repo.assign_button"}}</button>
		</form>
	{{else}}
		<p class="asc-byo-empty">{{ctx.Locale.Tr "ascbyo.storage.repo.no_usable"}}</p>
	{{end}}
</section>

<section class="asc-byo-card" aria-labelledby="asc-migrate-h">
	<h3 id="asc-migrate-h">{{ctx.Locale.Tr "ascbyo.storage.repo.migrate_title"}}</h3>
	<p>{{ctx.Locale.Tr "ascbyo.storage.repo.migrate_help"}}</p>
	{{with $a.ActiveMigration}}
		<div class="asc-byo-progress" role="status" data-testid="asc-migration-active" data-asc-migration-status-url="{{$a.StorageURL}}/migrations/{{.ID}}/status">
			<p><strong class="asc-migration-label">{{ctx.Locale.Tr .StateKey}}</strong></p>
			<progress class="asc-migration-bar" max="100" value="{{.Percent}}" aria-label="{{ctx.Locale.Tr .StateKey}}">{{.Percent}}%</progress>
			<p class="asc-byo-hint"><span class="asc-migration-count">{{ctx.Locale.Tr "ascbyo.storage.repo.progress" .Copied .Total}}</span></p>
			{{if .Cancellable}}
				<form method="post" action="{{$a.StorageURL}}/migrations/{{.ID}}/cancel">
					{{$.CsrfTokenHtml}}
					<button class="ds-btn ds-btn-danger" type="submit">{{ctx.Locale.Tr "ascbyo.storage.repo.cancel"}}</button>
				</form>
			{{end}}
		</div>
		<p class="asc-byo-hint">{{ctx.Locale.Tr "ascbyo.storage.repo.migrate_running"}}</p>
	{{else}}
		{{if $a.Usable}}
			<form class="asc-byo-form" method="post" action="{{$a.StorageURL}}/migrations" data-testid="asc-migrate">
				{{.CsrfTokenHtml}}
				<input type="hidden" name="op_id" value="{{$a.Op "migrate"}}">
				<div class="ds-field asc-field">
					<label for="asc-migrate-target">{{ctx.Locale.Tr "ascbyo.storage.repo.migrate_field"}}</label>
					<select class="ds-select" id="asc-migrate-target" name="target_id">
						<option value="">{{ctx.Locale.Tr "ascbyo.storage.repo.assign_default"}}</option>
						{{range $a.Usable}}<option value="{{.ID}}">{{.Label}}</option>{{end}}
					</select>
				</div>
				<div class="ds-field asc-field asc-field-check">
					<label><input type="checkbox" name="delete_source" value="on"> {{ctx.Locale.Tr "ascbyo.storage.repo.migrate_delete_source"}}</label>
					<p class="ds-hint asc-field-hint">{{ctx.Locale.Tr "ascbyo.storage.repo.migrate_delete_help"}}</p>
				</div>
				<div class="ds-field asc-field asc-field-check{{if $a.Errors.confirm_delete_source}} has-error{{end}}">
					<label><input type="checkbox" name="confirm_delete_source" value="on"{{if $a.Errors.confirm_delete_source}} aria-invalid="true" aria-describedby="asc-confirm-err"{{end}}> {{ctx.Locale.Tr "ascbyo.storage.repo.migrate_confirm_delete"}}</label>
					{{if $a.Errors.confirm_delete_source}}<p class="ds-hint ds-c-err asc-field-error" id="asc-confirm-err" role="alert">{{ctx.Locale.Tr $a.Errors.confirm_delete_source}}</p>{{end}}
				</div>
				<button class="ds-btn ds-btn-primary" type="submit">{{ctx.Locale.Tr "ascbyo.storage.repo.migrate_button"}}</button>
			</form>
		{{else}}
			<p class="asc-byo-empty">{{ctx.Locale.Tr "ascbyo.storage.repo.no_usable"}}</p>
		{{end}}
	{{end}}
</section>

<section class="asc-byo-section" aria-labelledby="asc-history-h">
	<h3 id="asc-history-h">{{ctx.Locale.Tr "ascbyo.storage.repo.history_title"}}</h3>
	{{if $a.Migrations}}
		<table class="ds-table asc-stack" data-testid="asc-migration-history">
			<thead>
				<tr>
					<th>{{ctx.Locale.Tr "ascbyo.storage.repo.history_state"}}</th>
					<th>{{ctx.Locale.Tr "ascbyo.storage.repo.history_to"}}</th>
					<th>{{ctx.Locale.Tr "ascbyo.storage.repo.history_started"}}</th>
				</tr>
			</thead>
			<tbody>
				{{range $a.Migrations}}
					<tr>
						<td data-label="{{ctx.Locale.Tr "ascbyo.storage.repo.history_state"}}">
							{{ctx.Locale.Tr .StateKey}}{{if .Active}} ({{.Percent}}%){{end}}
							{{if .Error}}<br><span class="asc-byo-error-line">{{.Error}}</span>{{end}}
						</td>
						<td data-label="{{ctx.Locale.Tr "ascbyo.storage.repo.history_to"}}" class="asc-byo-mono">{{if .ToTarget}}{{.ToTarget}}{{else}}{{ctx.Locale.Tr "ascbyo.storage.repo.history_default"}}{{end}}</td>
						<td data-label="{{ctx.Locale.Tr "ascbyo.storage.repo.history_started"}}">{{if .Created}}{{DateUtils.AbsoluteShort .Created}}{{end}}</td>
					</tr>
				{{end}}
			</tbody>
		</table>
	{{else}}
		<p class="asc-byo-empty">{{ctx.Locale.Tr "ascbyo.storage.repo.history_none"}}</p>
	{{end}}
</section>
