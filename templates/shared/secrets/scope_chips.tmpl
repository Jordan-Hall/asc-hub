{{/* The scopes of a secret or variable as chips; the argument is its ascscope.Scope. */}}
<ul class="asc-scope-chips" aria-label="{{ctx.Locale.Tr "secrets.scopes"}}" data-testid="scope-chips">
	{{range .List}}<li class="asc-scope-chip" data-scope="{{.Word}}">{{ctx.Locale.Tr (printf "secrets.scope.%s" .Word)}}</li>{{end}}
</ul>
