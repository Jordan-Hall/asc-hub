{{/* The scope boxes of a secret or variable dialog. Prefix: the id prefix of the boxes, so a button can tick
them with data-modal-<Prefix>-scope-<word>; Scopes: the scopes in page order; Checked: the scopes ticked first. */}}
<fieldset class="ds-field asc-scope-boxes">
	<legend>{{ctx.Locale.Tr "secrets.scopes"}}</legend>
	<input type="hidden" name="scopes_sent" value="1">
	<div class="asc-scope-box-row">
		{{range .Scopes}}
		<label class="asc-scope-box"><input type="checkbox" name="scopes" value="{{.Word}}" id="{{$.Prefix}}-scope-{{.Word}}"{{if $.Checked.Has .}} checked{{end}}> {{ctx.Locale.Tr (printf "secrets.scope.%s" .Word)}}</label>
		{{end}}
	</div>
	<p class="help">{{ctx.Locale.Tr "secrets.scopes.help"}}</p>
</fieldset>
