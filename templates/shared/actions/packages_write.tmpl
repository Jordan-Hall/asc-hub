<h4 class="ds-card-top">
	{{ctx.Locale.Tr "actions.permissions.packages_write.title"}}
</h4>
<div class="ds-card ds-card-b ds-card-attach">
	<p>
		{{if .PackagesWriteForOrg}}
			{{ctx.Locale.Tr "actions.permissions.packages_write.org_desc"}}
		{{else}}
			{{ctx.Locale.Tr "actions.permissions.packages_write.repo_desc"}}
		{{end}}
	</p>
	{{if .PackagesWriteOrgOff}}
		<div class="ds-banner ds-banner-warn">{{ctx.Locale.Tr "actions.permissions.packages_write.org_off"}}</div>
	{{end}}
	<form class="ui form ds-form" action="{{.Link}}" method="post">
		<div class="ds-field">
			<div class="ui checkbox">
				<input name="allow_packages_write" type="checkbox" {{if .PackagesWriteOn}}checked{{end}} {{if .PackagesWriteOrgOff}}disabled{{end}}>
				<label>
					{{if .PackagesWriteForOrg}}
						{{ctx.Locale.Tr "actions.permissions.packages_write.org_label"}}
					{{else}}
						{{ctx.Locale.Tr "actions.permissions.packages_write.repo_label"}}
					{{end}}
				</label>
			</div>
		</div>
		<button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "save"}}</button>
	</form>
</div>
