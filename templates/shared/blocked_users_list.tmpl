{{/* The people one account or organization blocks, one row each with Unblock. Put it inside a .ds-card. */}}
{{if .BlockedUsers}}
<ul class="ds-list wk-rows">
	{{range .BlockedUsers}}
		<li class="ds-li wk-row">
			<span class="ds-li-av">{{ctx.AvatarUtils.Avatar . 40}}</span>
			<div class="ds-li-main">
				<div class="ds-li-title">{{template "shared/user/name" .}}</div>
				<div class="ds-li-sub">{{ctx.Locale.Tr "settings.blocked_since" (DateUtils.AbsoluteShort .CreatedUnix)}}</div>
			</div>
			<div class="wk-row-acts">
				<form action="{{$.Link}}/unblock" method="post">
					{{$.CsrfTokenHtml}}
					<input type="hidden" name="user_id" value="{{.ID}}">
					<button class="ds-btn ds-btn-danger ds-btn-sm">{{ctx.Locale.Tr "user.unblock"}}</button>
				</form>
			</div>
		</li>
	{{end}}
</ul>
{{else}}
	{{template "shared/ds/empty" (dict "Icon" "ban" "Title" (ctx.Locale.Tr "settings.blocked_users_none"))}}
{{end}}
