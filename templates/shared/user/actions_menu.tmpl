{{/*
The actions of a person's profile as a sheet: a bottom sheet on a phone, a dialog from 640 (native <dialog>, opened by
<button class="show-modal" data-modal="#profile-actions">). Lives inside #profile-avatar-card so a follow or block answer redraws it.
*/}}
<dialog id="profile-actions" class="wk-sheet-menu">
	<article>
		<header>{{ctx.Locale.Tr "profile.actions.tooltip"}}</header>
		<div class="content">
			<ul class="wk-sheet-list">
				{{if eq .SignedUserID .ContextUser.ID}}
					<li><a href="{{AppSubUrl}}/user/settings">{{svg "dsi-pencil" 18}}<span>{{ctx.Locale.Tr "profile.edit.link"}}</span></a></li>
				{{end}}
				{{if .IsAdmin}}
					<li><a href="{{AppSubUrl}}/admin/users/{{.ContextUser.ID}}">{{svg "dsi-sliders" 18}}<span>{{ctx.Locale.Tr "admin.users.details"}}</span></a></li>
				{{end}}
				{{if and .EnableFeed (or .IsAdmin (eq .SignedUserID .ContextUser.ID) (not .ContextUser.KeepActivityPrivate))}}
					<li><a href="{{.ContextUser.HomeLink}}.rss">{{svg "dsi-activity" 18}}<span>{{ctx.Locale.Tr "rss_feed"}}</span></a></li>
					<li><a href="{{.ContextUser.HomeLink}}.atom">{{svg "dsi-activity" 18}}<span>{{ctx.Locale.Tr "feed.atom.link"}}</span></a></li>
				{{end}}
				<li><a href="{{.ContextUser.HomeLink}}.keys">{{svg "dsi-key" 18}}<span>{{ctx.Locale.Tr "keys.ssh.link"}}</span></a></li>
				<li><a href="{{.ContextUser.HomeLink}}.gpg">{{svg "dsi-key" 18}}<span>{{ctx.Locale.Tr "keys.gpg.link"}}</span></a></li>
				{{if and .IsSigned (ne .SignedUserID .ContextUser.ID)}}
					<li class="wk-sheet-sep" role="presentation"></li>
					<li hx-target="#profile-avatar-card" hx-indicator="#profile-avatar-card" id="action-block">
						{{if .IsBlocked}}
							<button type="button" class="is-danger" hx-post="{{.ContextUser.HomeLink}}?action=unblock">{{svg "dsi-ban" 18}}<span>{{ctx.Locale.Tr "user.unblock"}}</span></button>
						{{else}}
							<button type="button" class="is-danger" data-modal-id="block-user" hx-post="{{.ContextUser.HomeLink}}?action=block" hx-confirm="-">{{svg "dsi-ban" 18}}<span>{{ctx.Locale.Tr "user.block"}}</span></button>
						{{end}}
					</li>
					{{if .IsModerationEnabled}}
						<li><a class="is-danger" href="{{AppSubUrl}}/report_abuse?type=user&id={{.ContextUser.ID}}">{{svg "dsi-flag" 18}}<span>{{ctx.Locale.Tr "moderation.report_abuse"}}</span></a></li>
					{{end}}
				{{end}}
			</ul>
		</div>
		<div class="actions"><button type="button" class="ds-btn ds-btn-secondary cancel">{{ctx.Locale.Tr "cancel"}}</button></div>
	</article>
</dialog>
