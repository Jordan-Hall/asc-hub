{{/*
The head of a person's profile (design boards "Profile" and "Mobile-Profile"): avatar, name, the facts about the person, follow and
the actions sheet. The element #profile-avatar-card is what the follow and block buttons swap in place (htmx), so
routers/web/user/profile.go answers those actions with this same template.
*/}}
{{if .IsHTMX}}
	{{template "base/alert" .}}
{{end}}

{{$showFollow := and .IsSigned (ne .SignedUserID .ContextUser.ID) (not .AscAsVisitor)}}
{{/* the person on their own profile, also while they view it as a visitor */}}
{{$owner := or (eq .SignedUserID .ContextUser.ID) .AscAsVisitor}}
{{/* a viewer of a private profile who is not the person sees the name only (AscPrivateLimited) */}}
{{$limited := .AscPrivateLimited}}

<div id="profile-avatar-card" class="wk-pf-card" hx-swap="morph">
	<div class="wk-pf-av">
		{{if eq .SignedUserID .ContextUser.ID}}
			<a href="{{AppSubUrl}}/user/settings#avatar-settings" data-tooltip-content="{{ctx.Locale.Tr "user.change_avatar"}}" aria-label="{{ctx.Locale.Tr "user.change_avatar"}}">{{ctx.AvatarUtils.Avatar .ContextUser 96}}</a>
		{{else}}
			{{ctx.AvatarUtils.Avatar .ContextUser 96}}
		{{end}}
		{{if .AscOnline}}<span class="wk-pf-online" role="img" aria-label="{{ctx.Locale.Tr "asc_work.pf_online"}}"></span>{{end}}
	</div>
	<div class="wk-pf-info tw-break-anywhere">
		<div class="wk-pf-line1">
			<h1 class="wk-pf-name">{{if .ContextUser.FullName}}{{.ContextUser.FullName}}{{else}}{{.ContextUser.Name}}{{end}}</h1>
			{{if .ContextUser.Visibility.IsPrivate}}<span class="ds-chip">{{ctx.Locale.Tr "org.settings.visibility.private_shortname"}}</span>{{end}}
			{{with .AscPresence}}<span class="ds-chip wk-pf-presence" data-asc-presence="{{if .Online}}online{{else}}away{{end}}">{{if and .Online .LocalTime}}{{ctx.Locale.Tr "asc_work.pf_online_local" .LocalTime}}{{else if .Online}}{{ctx.Locale.Tr "asc_work.pf_online"}}{{else}}{{ctx.Locale.Tr "asc_work.pf_local" .LocalTime}}{{end}}</span>{{end}}
		</div>
		<div class="wk-pf-line2">
			<span>@{{.ContextUser.Name}}</span>
			{{if not $limited}}
			{{with .ContextUser.GetPronouns (and .IsSigned (not .AscAsVisitor))}}<span>{{.}}</span>{{end}}
			{{with .AscProfileRole}}<span data-asc-pf-role>{{.}}</span>{{end}}
			{{with .AscProfileTeams}}<span data-asc-pf-team>{{ctx.Locale.Tr "user.asc_profile.team_line" (index . 0).Name}}</span>{{end}}
			{{if .ContextUser.Location}}
				<span>{{.ContextUser.Location}}{{if .ContextUserLocationMapURL}} <a href="{{.ContextUserLocationMapURL}}" rel="nofollow noreferrer" data-tooltip-content="{{ctx.Locale.Tr "user.show_on_map"}}" aria-label="{{ctx.Locale.Tr "user.show_on_map"}}">{{svg "dsi-external" 12}}</a>{{end}}</span>
			{{end}}
			{{end}}
		</div>
		{{if not $limited}}
		{{if $.RenderedDescription}}<div class="wk-pf-desc render-content markup">{{$.RenderedDescription}}</div>{{end}}
		<div class="wk-pf-stats">
			<a href="{{.ContextUser.HomeLink}}?tab=followers">{{ctx.Locale.TrN .NumFollowers "user.followers_one" "user.followers_few" .NumFollowers}}</a>
			<a href="{{.ContextUser.HomeLink}}?tab=following">{{ctx.Locale.TrN .NumFollowing "user.following_one" "user.following_few" .NumFollowing}}</a>
			<span>{{ctx.Locale.Tr "user.joined_on" (DateUtils.AbsoluteShort .ContextUser.CreatedUnix)}}</span>
			{{if .ShowUserEmail}}
				<span><a href="mailto:{{.ContextUser.Email}}" rel="nofollow">{{.ContextUser.Email}}</a>{{if (eq .SignedUserID .ContextUser.ID)}} <a class="ds-icon-link" href="{{AppSubUrl}}/user/settings#privacy-user-settings" aria-label="{{ctx.Locale.Tr "user.email_visibility.limited"}}" data-tooltip-content="{{ctx.Locale.Tr "user.email_visibility.limited"}}">{{svg "dsi-eye" 12}}</a>{{end}}</span>
			{{end}}
			{{if .ContextUser.Website}}<a class="ds-mono" target="_blank" rel="noopener noreferrer me" href="{{.ContextUser.Website}}">{{.ContextUser.Website}}</a>{{end}}
			{{range .OpenIDs}}{{if .Show}}<a target="_blank" rel="noopener noreferrer" href="{{.URI}}">{{.URI}}</a>{{end}}{{end}}
		</div>
		{{if .Badges}}
			<ul class="wk-pf-badges">
				{{range .Badges}}
					<li><img width="32" height="32" src="{{.ImageURL}}" alt="{{.Description}}" data-tooltip-content="{{.Description}}"></li>
				{{end}}
			</ul>
		{{end}}
		{{end}}
	</div>
	<div class="wk-pf-actions">
		{{if $owner}}
			{{/* the owner view: Edit profile, and a toggle that shows the profile as a visitor sees it */}}
			<a class="ds-btn ds-btn-secondary" href="{{AppSubUrl}}/user/settings" data-asc-pf-edit>{{ctx.Locale.Tr "profile.edit.link"}}</a>
			<a class="ds-btn {{if .AscAsVisitor}}ds-btn-primary{{else}}ds-btn-ghost{{end}}" role="button" aria-pressed="{{if .AscAsVisitor}}true{{else}}false{{end}}" href="{{.ContextUser.HomeLink}}{{if not .AscAsVisitor}}?visitor=1{{end}}" data-asc-pf-visitor>{{svg "dsi-eye" 16}}{{ctx.Locale.Tr "user.asc_profile.view_as_visitor"}}</a>
		{{end}}
		{{if $showFollow}}
			<div class="wk-pf-primary" hx-target="#profile-avatar-card" hx-indicator="#profile-avatar-card">
				{{if .IsFollowing}}
					<button hx-post="{{.ContextUser.HomeLink}}?action=unfollow" class="ds-btn ds-btn-secondary">{{ctx.Locale.Tr "user.unfollow"}}</button>
				{{else}}
					<button hx-post="{{.ContextUser.HomeLink}}?action=follow" class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "user.follow"}}</button>
				{{end}}
			</div>
			{{if and (not $limited) .ContextUser.IsIndividual}}
				<button type="button" class="ds-btn ds-btn-secondary show-modal" data-modal="#profile-ask-review" aria-haspopup="dialog" data-asc-pf-review>{{ctx.Locale.Tr "user.asc_profile.review_ask"}}</button>
				<button type="button" class="ds-btn ds-btn-secondary show-modal" data-modal="#profile-ask-mention" aria-haspopup="dialog" data-asc-pf-mention>{{ctx.Locale.Tr "user.asc_profile.mention_ask"}}</button>
			{{end}}
		{{end}}
		<button type="button" class="ds-btn ds-btn-secondary show-modal" data-modal="#profile-actions" aria-haspopup="dialog">{{ctx.Locale.Tr "asc_work.pf_more"}}</button>
	</div>
	{{template "shared/user/actions_menu" .}}
	{{if and $showFollow (not $limited) .ContextUser.IsIndividual}}
		<dialog id="profile-ask-review" class="wk-sheet-menu wk-ask" aria-labelledby="profile-ask-review-h">
			<article>
				<header id="profile-ask-review-h">{{ctx.Locale.Tr "user.asc_profile.review_head" .ContextUser.Name}}</header>
				<div class="content" hx-get="{{.ContextUser.HomeLink}}/-/ask/review" hx-trigger="intersect once" hx-swap="innerHTML"><p class="wk-ask-loading">{{ctx.Locale.Tr "loading"}}</p></div>
				<div class="actions"><button type="button" class="ds-btn ds-btn-secondary cancel">{{ctx.Locale.Tr "cancel"}}</button></div>
			</article>
		</dialog>
		<dialog id="profile-ask-mention" class="wk-sheet-menu wk-ask" aria-labelledby="profile-ask-mention-h">
			<article>
				<header id="profile-ask-mention-h">{{ctx.Locale.Tr "user.asc_profile.mention_head" .ContextUser.Name}}</header>
				<div class="content" hx-get="{{.ContextUser.HomeLink}}/-/ask/mention" hx-trigger="intersect once" hx-swap="innerHTML"><p class="wk-ask-loading">{{ctx.Locale.Tr "loading"}}</p></div>
				<div class="actions"><button type="button" class="ds-btn ds-btn-secondary cancel">{{ctx.Locale.Tr "cancel"}}</button></div>
			</article>
		</dialog>
	{{end}}
</div>
