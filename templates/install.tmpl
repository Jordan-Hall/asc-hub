{{/* First run setup (board Install, Mobile-Install). Posts once to "/". The script web_src/js/features/install.js needs: .page-content.install, #db_type (change event), [data-db-setting-for], #db_host #db_user #db_name, #app_url, #domain, and the wrappers #offline-mode #disable-gravatar #federated-avatar-lookup #enable-openid-signin #enable-openid-signup #disable-registration #enable-captcha (each holding one checkbox). */}}
{{template "base/head" .}}
<header class="ds-hdr ds-hdr-lg ins-bar" role="banner">
	<div class="ds-topbar ds-topbar-static">
		<a class="ds-brand" href="{{AppSubUrl}}/" aria-label="{{ctx.Locale.Tr "home"}}">{{template "base/brand_tile" .}}<span>{{AppName}}</span></a>
		<span class="ins-bar-sub">{{ctx.Locale.Tr "asc_install.bar"}}</span>
	</div>
</header>
<div role="main" aria-label="{{.Title}}" class="page-content install ds-main ins">
	<form class="ds-container ins-form" action="{{AppSubUrl}}/" method="post">
		<header class="ins-head">
			<p class="ds-t-eyebrow">{{ctx.Locale.Tr "asc_install.eyebrow"}}</p>
			<h1 class="ds-t-h1">{{ctx.Locale.Tr "asc_install.h1"}}</h1>
			<p class="ds-t-lead ds-c-2">{{ctx.Locale.Tr "asc_install.lead"}}</p>
		</header>

		{{template "base/alert" .}}

		<div class="ds-split ins-split">
			<div class="ds-min0 ins-main">
				<p class="ds-t-small ds-c-2 ins-docker">{{ctx.Locale.Tr "install.docker_helper" "https://forgejo.org/docs/latest/admin/installation-docker/"}}</p>

				<!-- Database -->
				<section class="ds-card ins-card" id="ins-db" aria-labelledby="ins-db-h">
					<div class="ds-card-h"><div class="ds-grow"><h2 id="ins-db-h">{{ctx.Locale.Tr "install.db_title"}}</h2><p class="ds-t-small ds-c-2">{{ctx.Locale.Tr "install.require_db_desc"}}</p></div><span class="ds-chip ds-chip-info">{{ctx.Locale.Tr "asc_install.step" 1}}</span></div>
					<div class="ds-card-b ds-form">
						<div class="ds-field">
							<label class="ds-label" for="db_type">{{ctx.Locale.Tr "install.db_type"}}</label>
							<select class="ds-select{{if .Err_DbType}} is-err{{end}}" id="db_type" name="db_type"{{if .Err_DbType}} aria-invalid="true"{{end}}>
								{{range .DbTypeNames}}
									<option value="{{.type}}"{{if eq .type $.CurDbType}} selected{{end}}>{{.name}}</option>
								{{end}}
							</select>
						</div>

						<div class="tw-hidden ds-form" data-db-setting-for="common-host">
							{{template "shared/ds/field" (dict "ID" "db_host" "Name" "db_host" "Label" (ctx.Locale.Tr "install.host") "Value" .db_host "Error" .Err_DbSetting "Extra" "off")}}
							<div class="ds-form-row ds-form-row-2">
								{{template "shared/ds/field" (dict "ID" "db_name" "Name" "db_name" "Label" (ctx.Locale.Tr "install.db_name") "Value" .db_name "Error" .Err_DbSetting "Extra" "off")}}
								{{template "shared/ds/field" (dict "ID" "db_user" "Name" "db_user" "Label" (ctx.Locale.Tr "install.user") "Value" .db_user "Error" .Err_DbSetting "Extra" "off")}}
							</div>
							{{template "shared/ds/field" (dict "ID" "db_passwd" "Name" "db_passwd" "Label" (ctx.Locale.Tr "install.password") "Type" "password" "Value" .db_passwd "Error" .Err_DbSetting "Autocomplete" "off" "Reveal" true)}}
						</div>

						<div class="tw-hidden ds-form" data-db-setting-for="postgres">
							<div class="ds-field">
								<label class="ds-label" for="ssl_mode">{{ctx.Locale.Tr "install.ssl_mode"}}</label>
								<select class="ds-select" id="ssl_mode" name="ssl_mode">
									<option value="disable"{{if or (not .ssl_mode) (eq .ssl_mode "disable")}} selected{{end}}>{{ctx.Locale.Tr "asc_install.ssl_disable"}}</option>
									<option value="require"{{if eq .ssl_mode "require"}} selected{{end}}>{{ctx.Locale.Tr "asc_install.ssl_require"}}</option>
									<option value="verify-full"{{if eq .ssl_mode "verify-full"}} selected{{end}}>{{ctx.Locale.Tr "asc_install.ssl_verify"}}</option>
								</select>
							</div>
							{{template "shared/ds/field" (dict "ID" "db_schema" "Name" "db_schema" "Label" (ctx.Locale.Tr "install.db_schema") "Value" .db_schema "Optional" true "Error" .Err_DbSetting "Hint" (ctx.Locale.Tr "install.db_schema_helper") "Extra" "off")}}
						</div>

						<div class="tw-hidden ds-form" data-db-setting-for="sqlite3">
							{{template "shared/ds/field" (dict "ID" "db_path" "Name" "db_path" "Label" (ctx.Locale.Tr "install.path") "Value" .db_path "Error" (or .Err_DbPath .Err_DbSetting) "Hint" (ctx.Locale.Tr "install.sqlite_helper") "Extra" "off" "Mono" true)}}
						</div>

						{{if .Err_DbInstalledBefore}}
						<div class="ds-callout ds-stack ds-stack-12">
							<p>{{ctx.Locale.Tr "install.reinstall_confirm_message"}}</p>
							<div class="ds-check"><input id="reinstall_1" name="reinstall_confirm_first" type="checkbox"><label for="reinstall_1">{{ctx.Locale.Tr "install.reinstall_confirm_check_1"}}</label></div>
							<div class="ds-check"><input id="reinstall_2" name="reinstall_confirm_second" type="checkbox"><label for="reinstall_2">{{ctx.Locale.Tr "install.reinstall_confirm_check_2"}}</label></div>
							<div class="ds-check"><input id="reinstall_3" name="reinstall_confirm_third" type="checkbox"><label for="reinstall_3">{{ctx.Locale.Tr "install.reinstall_confirm_check_3"}}</label></div>
						</div>
						{{end}}
					</div>
				</section>

				<!-- General -->
				<section class="ds-card ins-card" id="ins-general" aria-labelledby="ins-general-h">
					<div class="ds-card-h"><div class="ds-grow"><h2 id="ins-general-h">{{ctx.Locale.Tr "install.general_title"}}</h2></div><span class="ds-chip ds-chip-info">{{ctx.Locale.Tr "asc_install.step" 2}}</span></div>
					<div class="ds-card-b ds-form">
						{{template "shared/ds/field" (dict "ID" "app_name" "Name" "app_name" "Label" (ctx.Locale.Tr "install.app_name") "Value" .app_name "Required" true "Error" .Err_AppName "Hint" (ctx.Locale.Tr "install.app_name_helper"))}}
						{{template "shared/ds/field" (dict "ID" "app_slogan" "Name" "app_slogan" "Label" (ctx.Locale.Tr "install.app_slogan") "Value" .app_slogan "Optional" true "Hint" (ctx.Locale.Tr "install.app_slogan_helper"))}}
						{{template "shared/ds/field" (dict "ID" "app_url" "Name" "app_url" "Label" (ctx.Locale.Tr "install.app_url") "Type" "url" "Value" .app_url "Placeholder" "https://" "Required" true "Hint" (ctx.Locale.Tr "install.app_url_helper") "Extra" "off")}}
						<div class="ds-form-row ds-form-row-2">
							{{template "shared/ds/field" (dict "ID" "domain" "Name" "domain" "Label" (ctx.Locale.Tr "install.domain") "Value" .domain "Required" true "Hint" (ctx.Locale.Tr "install.domain_helper") "Extra" "off")}}
							{{template "shared/ds/field" (dict "ID" "http_port" "Name" "http_port" "Label" (ctx.Locale.Tr "install.http_port") "Value" .http_port "Required" true "InputMode" "numeric" "Hint" (ctx.Locale.Tr "install.http_port_helper"))}}
						</div>
						{{template "shared/ds/field" (dict "ID" "ssh_port" "Name" "ssh_port" "Label" (ctx.Locale.Tr "install.ssh_port") "Value" .ssh_port "Optional" true "InputMode" "numeric" "Hint" (ctx.Locale.Tr "install.ssh_port_helper"))}}
						{{template "shared/ds/field" (dict "ID" "repo_root_path" "Name" "repo_root_path" "Label" (ctx.Locale.Tr "install.repo_path") "Value" .repo_root_path "Required" true "Error" .Err_RepoRootPath "Hint" (ctx.Locale.Tr "install.repo_path_helper") "Extra" "off" "Mono" true)}}
						{{template "shared/ds/field" (dict "ID" "lfs_root_path" "Name" "lfs_root_path" "Label" (ctx.Locale.Tr "install.lfs_path") "Value" .lfs_root_path "Optional" true "Error" .Err_LFSRootPath "Hint" (ctx.Locale.Tr "install.lfs_path_helper") "Extra" "off" "Mono" true)}}
						{{template "shared/ds/field" (dict "ID" "log_root_path" "Name" "log_root_path" "Label" (ctx.Locale.Tr "install.log_root_path") "Value" .log_root_path "Required" true "Hint" (ctx.Locale.Tr "install.log_root_path_helper") "Extra" "off" "Mono" true)}}
						{{template "shared/ds/field" (dict "ID" "run_user" "Name" "run_user" "Label" (ctx.Locale.Tr "install.run_user") "Value" .run_user "Required" true "Readonly" true "Error" .Err_RunUser "Hint" (ctx.Locale.Tr "install.run_user_helper") "Extra" "off")}}
						<div class="ds-stack ds-stack-12">
							<div class="ds-field">
								<div class="ds-check" id="disable-registration"><input id="disable_registration" name="disable_registration" type="checkbox"{{if .disable_registration}} checked{{end}}><label for="disable_registration"{{if .Err_DisabledRegistration}} class="ds-c-err"{{end}}>{{ctx.Locale.Tr "install.disable_registration"}}</label></div>
								<div class="ds-hint">{{ctx.Locale.Tr "install.disable_registration.description"}}</div>
							</div>
							<div class="ds-field">
								<div class="ds-check"><input id="enable_update_checker" name="enable_update_checker" type="checkbox"{{if .enable_update_checker}} checked{{end}}><label for="enable_update_checker">{{ctx.Locale.Tr "install.enable_update_checker"}}</label></div>
								<div class="ds-hint">{{ctx.Locale.Tr "install.enable_update_checker_helper_forgejo"}}</div>
							</div>
						</div>
					</div>
				</section>

				<!-- Administrator -->
				<section class="ds-card ins-card" id="ins-admin" aria-labelledby="ins-admin-h">
					<div class="ds-card-h"><div class="ds-grow"><h2 id="ins-admin-h">{{ctx.Locale.Tr "install.admin_title"}}</h2><p class="ds-t-small ds-c-2">{{ctx.Locale.Tr "install.admin_setting.description"}}</p></div><span class="ds-chip ds-chip-info">{{ctx.Locale.Tr "asc_install.step" 3}}</span></div>
					<div class="ds-card-b ds-form">
						<div class="ds-form-row ds-form-row-2">
							{{template "shared/ds/field" (dict "ID" "admin_name" "Name" "admin_name" "Label" (ctx.Locale.Tr "install.admin_name") "Value" .admin_name "Error" .Err_AdminName "Autocomplete" "username" "Extra" "off")}}
							{{template "shared/ds/field" (dict "ID" "admin_email" "Name" "admin_email" "Label" (ctx.Locale.Tr "install.admin_email") "Type" "email" "Value" .admin_email "Error" .Err_AdminEmail "Autocomplete" "email" "Extra" "off")}}
						</div>
						<div class="ds-form-row ds-form-row-2">
							{{template "shared/ds/field" (dict "ID" "admin_passwd" "Name" "admin_passwd" "Label" (ctx.Locale.Tr "install.admin_password") "Type" "password" "Value" .admin_passwd "Error" .Err_AdminPasswd "Autocomplete" "new-password" "Reveal" true)}}
							{{template "shared/ds/field" (dict "ID" "admin_confirm_passwd" "Name" "admin_confirm_passwd" "Label" (ctx.Locale.Tr "install.confirm_password") "Type" "password" "Value" .admin_confirm_passwd "Error" .Err_AdminPasswd "Autocomplete" "new-password" "Reveal" true)}}
						</div>
					</div>
				</section>

				<!-- Optional -->
				<section class="ds-card ins-card" aria-labelledby="ins-opt-h">
					<div class="ds-card-h"><h2 id="ins-opt-h">{{ctx.Locale.Tr "install.optional_title"}}</h2></div>
					<div class="ds-card-b">
						<details class="ds-acc"{{if .Err_SMTP}} open{{end}}>
							<summary{{if .Err_SMTP}} class="ds-c-err"{{end}}>{{ctx.Locale.Tr "install.email_title"}}</summary>
							<div class="ds-form ins-acc-body">
								<div class="ds-form-row ds-form-row-2">
									{{template "shared/ds/field" (dict "ID" "smtp_addr" "Name" "smtp_addr" "Label" (ctx.Locale.Tr "install.smtp_addr") "Value" .smtp_addr "Extra" "off")}}
									{{template "shared/ds/field" (dict "ID" "smtp_port" "Name" "smtp_port" "Label" (ctx.Locale.Tr "install.smtp_port") "Value" .smtp_port "InputMode" "numeric")}}
								</div>
								{{template "shared/ds/field" (dict "ID" "smtp_from" "Name" "smtp_from" "Label" (ctx.Locale.Tr "install.smtp_from") "Value" .smtp_from "Error" .Err_SMTPFrom "Hint" (ctx.Locale.TrString "install.smtp_from_helper") "Extra" "off")}}
								<div class="ds-form-row ds-form-row-2">
									{{template "shared/ds/field" (dict "ID" "smtp_user" "Name" "smtp_user" "Label" (ctx.Locale.Tr "install.mailer_user") "Value" .smtp_user "Error" .Err_SMTPUser "Extra" "off" "Autocomplete" "off")}}
									{{template "shared/ds/field" (dict "ID" "smtp_passwd" "Name" "smtp_passwd" "Label" (ctx.Locale.Tr "install.mailer_password") "Type" "password" "Value" .smtp_passwd "Autocomplete" "new-password" "Reveal" true)}}
								</div>
								<div class="ds-check"><input id="register_confirm" name="register_confirm" type="checkbox"{{if .register_confirm}} checked{{end}}><label for="register_confirm">{{ctx.Locale.Tr "install.register_confirm"}}</label></div>
								<div class="ds-check"><input id="mail_notify" name="mail_notify" type="checkbox"{{if .mail_notify}} checked{{end}}><label for="mail_notify">{{ctx.Locale.Tr "install.mail_notify"}}</label></div>
							</div>
						</details>

						<details class="ds-acc">
							<summary>{{ctx.Locale.Tr "install.server_service_title"}}</summary>
							<div class="ds-form ins-acc-body">
								<div class="ds-field"><div class="ds-check" id="offline-mode"><input id="offline_mode" name="offline_mode" type="checkbox"{{if .offline_mode}} checked{{end}}><label for="offline_mode">{{ctx.Locale.Tr "install.offline_mode"}}</label></div><div class="ds-hint">{{ctx.Locale.Tr "install.offline_mode.description"}}</div></div>
								<div class="ds-field"><div class="ds-check" id="disable-gravatar"><input id="disable_gravatar" name="disable_gravatar" type="checkbox"{{if .disable_gravatar}} checked{{end}}><label for="disable_gravatar">{{ctx.Locale.Tr "install.disable_gravatar"}}</label></div><div class="ds-hint">{{ctx.Locale.Tr "install.disable_gravatar.description"}}</div></div>
								<div class="ds-field"><div class="ds-check" id="federated-avatar-lookup"><input id="enable_federated_avatar" name="enable_federated_avatar" type="checkbox"{{if .enable_federated_avatar}} checked{{end}}><label for="enable_federated_avatar">{{ctx.Locale.Tr "install.federated_avatar_lookup"}}</label></div><div class="ds-hint">{{ctx.Locale.Tr "install.federated_avatar_lookup.description"}}</div></div>
								<div class="ds-field"><div class="ds-check" id="enable-openid-signin"><input id="enable_open_id_sign_in" name="enable_open_id_sign_in" type="checkbox"{{if .enable_open_id_sign_in}} checked{{end}}><label for="enable_open_id_sign_in">{{ctx.Locale.Tr "install.openid_signin"}}</label></div><div class="ds-hint">{{ctx.Locale.Tr "install.openid_signin.description"}}</div></div>
								<div class="ds-field"><div class="ds-check" id="allow-only-external-registration"><input id="allow_only_external_registration" name="allow_only_external_registration" type="checkbox"{{if .allow_only_external_registration}} checked{{end}}><label for="allow_only_external_registration">{{ctx.Locale.Tr "install.allow_only_external_registration"}}</label></div><div class="ds-hint">{{ctx.Locale.Tr "install.allow_only_external_registration.description"}}</div></div>
								<div class="ds-field"><div class="ds-check" id="enable-openid-signup"><input id="enable_open_id_sign_up" name="enable_open_id_sign_up" type="checkbox"{{if .enable_open_id_sign_up}} checked{{end}}><label for="enable_open_id_sign_up">{{ctx.Locale.Tr "install.openid_signup"}}</label></div><div class="ds-hint">{{ctx.Locale.Tr "install.openid_signup.description"}}</div></div>
								<div class="ds-field"><div class="ds-check" id="enable-captcha"><input id="enable_captcha" name="enable_captcha" type="checkbox"{{if .enable_captcha}} checked{{end}}><label for="enable_captcha">{{ctx.Locale.Tr "install.enable_captcha"}}</label></div><div class="ds-hint">{{ctx.Locale.Tr "install.enable_captcha.description"}}</div></div>
								<div class="ds-field"><div class="ds-check"><input id="require_sign_in_view" name="require_sign_in_view" type="checkbox"{{if .require_sign_in_view}} checked{{end}}><label for="require_sign_in_view">{{ctx.Locale.Tr "install.require_sign_in_view"}}</label></div><div class="ds-hint">{{ctx.Locale.Tr "install.require_sign_in_view.description"}}</div></div>
								<div class="ds-field"><div class="ds-check"><input id="default_keep_email_private" name="default_keep_email_private" type="checkbox"{{if .default_keep_email_private}} checked{{end}}><label for="default_keep_email_private">{{ctx.Locale.Tr "install.default_keep_email_private"}}</label></div><div class="ds-hint">{{ctx.Locale.Tr "install.default_keep_email_private.description"}}</div></div>
								<div class="ds-field"><div class="ds-check"><input id="default_allow_create_organization" name="default_allow_create_organization" type="checkbox"{{if .default_allow_create_organization}} checked{{end}}><label for="default_allow_create_organization">{{ctx.Locale.Tr "install.default_allow_create_organization"}}</label></div><div class="ds-hint">{{ctx.Locale.Tr "install.default_allow_create_organization.description"}}</div></div>
								<div class="ds-field"><div class="ds-check"><input id="default_enable_timetracking" name="default_enable_timetracking" type="checkbox"{{if .default_enable_timetracking}} checked{{end}}><label for="default_enable_timetracking">{{ctx.Locale.Tr "install.default_enable_timetracking"}}</label></div><div class="ds-hint">{{ctx.Locale.Tr "install.default_enable_timetracking.description"}}</div></div>
								{{template "shared/ds/field" (dict "ID" "no_reply_address" "Name" "no_reply_address" "Label" (ctx.Locale.Tr "install.no_reply_address") "Value" .no_reply_address "Optional" true "Hint" (ctx.Locale.Tr "install.no_reply_address_helper") "Extra" "off")}}
								<div class="ds-field">
									<label class="ds-label" for="password_algorithm">{{ctx.Locale.Tr "install.password_algorithm"}}</label>
									<select class="ds-select" id="password_algorithm" name="password_algorithm">
										{{range .PasswordHashAlgorithms}}<option value="{{.}}"{{if eq . $.password_algorithm}} selected{{end}}>{{.}}</option>{{end}}
									</select>
									<div class="ds-hint">{{ctx.Locale.Tr "install.password_algorithm_helper"}}</div>
								</div>
							</div>
						</details>
					</div>
				</section>

				{{if .EnvConfigKeys}}
				<section class="ds-card ins-card" aria-labelledby="ins-env-h">
					<div class="ds-card-h"><h2 id="ins-env-h">{{ctx.Locale.Tr "install.env_config_keys"}}</h2></div>
					<div class="ds-card-b ds-stack ds-stack-12">
						<p class="ds-c-2">{{ctx.Locale.Tr "install.env_config_keys_prompt"}}</p>
						<p class="ins-keys">{{range .EnvConfigKeys}}<span class="ds-chip ds-chip-outline ds-mono">{{.}}</span>{{end}}</p>
					</div>
				</section>
				{{end}}

				<p class="ds-t-small ds-c-2">{{ctx.Locale.Tr "install.config_location_hint"}} <span class="ds-mono ds-break">{{.CustomConfFile}}</span></p>

				<div class="ds-sticky-actions">
					<button type="submit" class="ds-btn ds-btn-primary ds-btn-lg">{{ctx.Locale.Tr "install.install_btn_confirm"}}</button>
				</div>
			</div>

			<aside class="ds-rail ins-rail" aria-label="{{ctx.Locale.Tr "asc_install.rail"}}">
				<nav class="ds-card" aria-labelledby="ins-steps-h">
					<div class="ds-card-b">
						<h2 class="ds-t-micro ds-c-3" id="ins-steps-h">{{ctx.Locale.Tr "asc_install.rail"}}</h2>
						<ol class="ins-steps">
							<li><a href="#ins-db"><b>{{ctx.Locale.Tr "asc_install.s1"}}</b><span>{{ctx.Locale.Tr "asc_install.s1_sub"}}</span></a></li>
							<li><a href="#ins-general"><b>{{ctx.Locale.Tr "asc_install.s2"}}</b><span>{{ctx.Locale.Tr "asc_install.s2_sub"}}</span></a></li>
							<li><a href="#ins-admin"><b>{{ctx.Locale.Tr "asc_install.s3"}}</b><span>{{ctx.Locale.Tr "asc_install.s3_sub"}}</span></a></li>
						</ol>
					</div>
				</nav>
				<p class="ds-t-small ds-c-2 ins-note">{{ctx.Locale.Tr "asc_install.note"}}</p>
			</aside>
		</div>
	</form>
</div>
<img class="tw-hidden" src="{{AssetUrlPrefix}}/img/forgejo-loading.svg" alt="{{ctx.Locale.Tr "loading"}}" width="256" height="256">
{{template "base/footer" .}}
