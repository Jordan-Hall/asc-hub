{{/* The dialog that adds or invites a member (opened by #add-org-member-button, web_src/js/features/add-org-member.ts): a sheet on a phone. */}}
<div class="ui g-modal-confirm delete modal" id="delete-label">
	<div class="header">
		{{svg "dsi-trash" 18}}
		{{ctx.Locale.Tr "repo.issues.label_deletion"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "repo.issues.label_deletion_desc"}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>

<dialog id="add-member-modal">
	<article>
		<header>
			{{if $.AddMembersByInvitations}}
				{{ctx.Locale.Tr "asc_work.invite_dialog_title"}}
			{{else}}
				{{ctx.Locale.Tr "members.add_member"}}
			{{end}}
		</header>
		<form class="ui add-member form ignore-dirty ds-form" action="{{$.OrgLink}}/members/action/add" method="post">
			<input type="hidden" name="uid" value="{{.SignedUser.ID}}">
			<div class="content">
				<div class="field ds-field">
					<label class="ds-label" for="add-member-user">{{ctx.Locale.Tr "asc_work.invite_people_label"}}</label>
					<textarea id="add-member-user" class="ds-textarea" name="invitees" rows="2" placeholder="{{ctx.Locale.Tr "search.user_kind"}}" autocomplete="off" spellcheck="false" required></textarea>
					<p class="ds-hint">{{ctx.Locale.Tr "asc_work.invite_people_hint"}}</p>
				</div>
				<div class="field ds-field">
					<label class="ds-label" for="add-member-role">{{ctx.Locale.Tr "asc_work.invite_role_label"}}</label>
					<select id="add-member-role" class="ds-select" name="role">
						<option value="member" selected>{{ctx.Locale.Tr "asc_work.role_member"}}</option>
						<option value="maintainer">{{ctx.Locale.Tr "asc_work.role_maintainer"}}</option>
						<option value="owner">{{ctx.Locale.Tr "asc_work.role_owner"}}</option>
					</select>
				</div>

				<details class="ds-details wk-team-pick">
					<summary>{{ctx.Locale.Tr "asc_work.invite_teams_more"}}</summary>
					<div class="team-list">
						{{range .Teams}}
							<div class="ds-check">
								<input name="team_{{.ID}}" id="add-member-team_{{.ID}}" type="checkbox">
								<label for="add-member-team_{{.ID}}">{{.Name}}</label>
							</div>
						{{end}}
						<a class="ds-link" href="{{$.OrgLink}}/teams/new">{{ctx.Locale.Tr "org.create_new_team"}}</a>
					</div>
				</details>
			</div>
		</form>
		<div class="actions">
			<button class="ds-btn ds-btn-secondary cancel" type="button">{{ctx.Locale.Tr "cancel"}}</button>
			<button class="ds-btn ds-btn-primary ok" type="submit">
				{{if $.AddMembersByInvitations}}
					{{ctx.Locale.Tr "asc_work.invite_send"}}
				{{else}}
					{{ctx.Locale.Tr "members.add_member"}}
				{{end}}
			</button>
		</div>
	</article>
</dialog>
