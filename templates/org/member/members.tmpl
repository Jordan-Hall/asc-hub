{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="ds-main organization members wk-org">
	{{template "shared/ds/subbar" (dict "Data" . "Title" (ctx.Locale.Tr "org.members") "BackHref" .Org.HomeLink "BackLabel" .Org.DisplayName)}}
	{{template "org/header" .}}
	<div class="ds-container ds-container-wide wk-org-body wk-people-page">
		{{template "base/alert" .}}
		<div class="wk-toolbar wk-people-bar">
			<form class="ds-filterbar-form wk-people-filter" role="search" method="get" action="{{$.OrgLink}}/members">
				{{if .PeopleFilter}}<input type="hidden" name="filter" value="{{.PeopleFilter}}">{{end}}
				<div class="ds-inwrap">
					{{svg "dsi-search" 16}}
					<label class="ds-sr" for="people-q">{{ctx.Locale.Tr "asc_work.people_search"}}</label>
					<input id="people-q" class="ds-input" type="search" name="q" value="{{.PeopleQuery}}" maxlength="100" spellcheck="false" placeholder="{{ctx.Locale.Tr "asc_work.people_search"}}">
				</div>
			</form>
			<div class="ds-scrollx wk-people-chips" role="group" aria-label="{{ctx.Locale.Tr "filter"}}">
				{{$q := QueryEscape .PeopleQuery}}
				{{template "shared/ds/pill" (dict "Label" (printf "%s %d" (ctx.Locale.TrString "asc_work.people_all") .PeopleCountAll) "Href" (print $.OrgLink "/members?q=" $q) "Active" (not .PeopleFilter))}}
				{{template "shared/ds/pill" (dict "Label" (printf "%s %d" (ctx.Locale.TrString "org.members.owner") .PeopleCountOwners) "Href" (print $.OrgLink "/members?filter=owners&q=" $q) "Active" (eq .PeopleFilter "owners"))}}
				{{if $.CanSee2FA}}{{template "shared/ds/pill" (dict "Label" (printf "%s %d" (ctx.Locale.TrString "asc_work.people_2fa_off") .PeopleCountTwoFAOff) "Href" (print $.OrgLink "/members?filter=2fa_off&q=" $q) "Active" (eq .PeopleFilter "2fa_off"))}}{{end}}
				{{if .ShowPending}}{{template "shared/ds/pill" (dict "Label" (printf "%s %d" (ctx.Locale.TrString "asc_work.people_pending") .PeopleCountPending) "Href" (print $.OrgLink "/members?filter=pending") "Active" (eq .PeopleFilter "pending"))}}{{end}}
			</div>
			{{if $.IsOrganizationOwner}}
				<button class="ds-btn ds-btn-primary wk-people-invite" id="add-org-member-button" type="button">
					{{svg "dsi-plus" 16}}
					{{if $.AddMembersByInvitations}}{{ctx.Locale.Tr "asc_work.invite_dialog_title"}}{{else}}{{ctx.Locale.Tr "members.add_member"}}{{end}}
				</button>
			{{end}}
		</div>
		{{if ne .PeopleFilter "pending"}}
		<div class="ds-card">
			<ul class="ds-list">
				{{range .Members}}
					{{$uid := .ID}}
					{{$isPublic := index $.MembersIsPublicMember .ID}}
					{{$role := index $.MembersRole .ID}}
					<li class="ds-li wk-member">
						<span class="ds-li-av"><a href="{{.HomeLink}}" tabindex="-1" aria-hidden="true">{{ctx.AvatarUtils.Avatar . 40}}</a></span>
						<div class="ds-li-main">
							<div class="ds-li-title">
								<a class="wk-member-name" href="{{.HomeLink}}">{{.DisplayName}}</a>
								<span class="ds-mono ds-c-2 ds-t-small">@{{.Name}}</span>
								{{if not $.PublicOnly}}
									{{if eq $role "owner"}}<span class="ds-chip ds-chip-info">{{ctx.Locale.Tr "asc_work.role_owner"}}</span>
									{{else if eq $role "maintainer"}}<span class="ds-chip ds-chip-info">{{ctx.Locale.Tr "asc_work.role_maintainer"}}</span>
									{{else}}<span class="ds-chip ds-chip-outline">{{ctx.Locale.Tr "asc_work.role_member"}}</span>{{end}}
								{{end}}
								{{if not $isPublic}}<span class="ds-chip ds-chip-outline">{{ctx.Locale.Tr "org.members.private"}}</span>{{end}}
								{{if and $.CanSee2FA (not $.PublicOnly)}}
									{{if index $.MembersTwoFaStatus .ID}}
										<span class="ds-chip ds-chip-ok">{{svg "dsi-shield-check" 12}} {{ctx.Locale.Tr "asc_work.org_2fa_on"}}</span>
									{{else}}
										<span class="ds-chip ds-chip-warn">{{svg "dsi-alert" 12}} {{ctx.Locale.Tr "asc_work.org_2fa_off"}}</span>
									{{end}}
								{{end}}
							</div>
							{{if not $.PublicOnly}}
								{{$teams := index $.MembersTeams .ID}}
								<div class="ds-li-sub">{{if $teams}}{{ctx.Locale.Tr "asc_work.people_teams" $teams}}{{else}}{{ctx.Locale.Tr "asc_work.people_no_teams"}}{{end}}</div>
							{{end}}
							<div class="ds-li-meta">{{if .LastLoginUnix}}{{ctx.Locale.Tr "asc_work.people_active" (DateUtils.TimeSince .LastLoginUnix)}}{{else}}{{ctx.Locale.Tr "asc_work.people_never"}}{{end}}</div>
						</div>
						{{if $.MembersLanded}}
							<div class="wk-member-stat" title="{{ctx.Locale.Tr "asc_work.people_changesets_hint"}}">
								<strong>{{index $.MembersLanded .LowerName}}</strong>
								<span>{{ctx.Locale.Tr "asc_work.people_changesets"}}</span>
							</div>
						{{end}}
						<div class="wk-member-acts">
							{{if and $.IsOrganizationOwner (ne $.SignedUser.ID .ID)}}
								<details class="wk-menu">
									<summary class="ds-btn ds-btn-ghost ds-btn-sm">{{ctx.Locale.Tr "asc_work.people_change_role"}}</summary>
									<div class="wk-menu-list" role="group" aria-label="{{ctx.Locale.Tr "asc_work.people_change_role"}}">
										{{range $r := $.RoleChoices}}
											<a class="wk-menu-item link-action{{if eq $role $r}} is-current{{end}}" href data-url="{{$.OrgLink}}/members/action/role?uid={{$uid}}&role={{$r}}"{{if eq $role $r}} aria-current="true"{{end}}>
												<strong>{{ctx.Locale.Tr (print "asc_work.role_" $r)}}</strong>
												<span>{{ctx.Locale.Tr (print "asc_work.role_" $r "_sub")}}</span>
											</a>
										{{end}}
									</div>
								</details>
							{{end}}
							{{if or (eq $.SignedUser.ID .ID) $.IsOrganizationOwner}}
								<details class="wk-menu wk-menu-end">
									<summary class="ds-btn ds-btn-ghost ds-btn-icon ds-btn-sm" aria-label="{{ctx.Locale.Tr "asc_work.people_more" .DisplayName}}">{{svg "dsi-dots" 16}}</summary>
									<div class="wk-menu-list" role="group">
										{{if $isPublic}}
											<a class="wk-menu-item link-action" href data-url="{{$.OrgLink}}/members/action/private?uid={{.ID}}">{{svg "dsi-eye" 14}} {{ctx.Locale.Tr "org.members.public_helper"}}</a>
										{{else}}
											<a class="wk-menu-item link-action" href data-url="{{$.OrgLink}}/members/action/public?uid={{.ID}}">{{svg "dsi-eye" 14}} {{ctx.Locale.Tr "org.members.private_helper"}}</a>
										{{end}}
										{{if eq $.SignedUser.ID .ID}}
											<button class="wk-menu-item wk-menu-danger delete-button" type="button" data-modal-id="leave-organization"
												data-url="{{$.OrgLink}}/members/action/leave" data-datauid="{{.ID}}"
												data-name="{{.DisplayName}}"
												data-data-organization-name="{{$.Org.DisplayName}}">{{ctx.Locale.Tr "org.members.leave"}}</button>
										{{else if $.IsOrganizationOwner}}
											<button class="wk-menu-item wk-menu-danger delete-button" type="button" data-modal-id="remove-organization-member"
												data-url="{{$.OrgLink}}/members/action/remove" data-datauid="{{.ID}}"
												data-name="{{.DisplayName}}"
												data-data-organization-name="{{$.Org.DisplayName}}">{{ctx.Locale.Tr "org.members.remove"}}</button>
										{{end}}
									</div>
								</details>
							{{end}}
						</div>
					</li>
				{{else}}
					<li class="wk-empty-li">
						<div class="ds-empty wk-empty-in">
							<span class="ds-empty-ic" aria-hidden="true">{{svg "dsi-users" 32}}</span>
							<h3>{{ctx.Locale.Tr "asc_work.org_no_members"}}</h3>
						</div>
					</li>
				{{end}}
			</ul>
		</div>

		<div class="wk-people-foot">
			<p class="ds-t-small ds-c-2">{{ctx.Locale.Tr "asc_work.people_shown" .PeopleShown .PeopleCountAll}}</p>
			{{template "base/paginate" .}}
		</div>
		{{end}}

		{{if and .OrgAgents (ne .PeopleFilter "pending")}}
			<section class="wk-people-sec" aria-labelledby="people-agents">
				<h2 class="ds-t-h3" id="people-agents">{{ctx.Locale.Tr "asc_work.people_agents_title"}}</h2>
				<div class="ds-card">
					<ul class="ds-list">
						{{range .OrgAgents}}
							<li class="ds-li wk-member" data-testid="people-agent">
								<span class="ds-li-av"><span class="wk-agent-av" aria-hidden="true">{{svg "dsi-agent" 22}}</span></span>
								<div class="ds-li-main">
									<div class="ds-li-title">
										<strong>{{.Label}}</strong>
										<span class="ds-mono ds-c-2 ds-t-small">@{{$.Org.Name}}/{{.Name}}</span>
										<span class="ds-chip ds-chip-agent">{{svg "dsi-agent" 12}} {{ctx.Locale.Tr "asc_work.people_agent_tag"}}</span>
										{{if .Paused}}<span class="ds-chip ds-chip-warn">{{ctx.Locale.Tr "asc_work.people_agent_paused"}}</span>{{end}}
									</div>
									<div class="ds-li-meta">
										{{if .RunBy}}<span>{{ctx.Locale.Tr "asc_work.people_agent_runby" .RunBy}}</span>{{end}}
										{{if .Paths}}<span title="{{.PathsText}}">{{ctx.Locale.Tr "asc_work.people_agent_scoped"}}</span>{{end}}
									</div>
								</div>
								{{if $.IsOrganizationOwner}}<div class="wk-member-acts"><a class="ds-btn ds-btn-ghost ds-btn-sm" href="{{AppSubUrl}}/org/{{$.Org.Name}}/settings/asc/agents">{{ctx.Locale.Tr "asc_work.people_manage"}}</a></div>{{end}}
							</li>
						{{end}}
					</ul>
				</div>
			</section>
		{{end}}

		{{if and .ShowPending (or .PendingInvites (eq .PeopleFilter "pending"))}}
			<section class="wk-people-sec" aria-labelledby="people-pending" id="pending">
				<h2 class="ds-t-h3" id="people-pending">{{ctx.Locale.Tr "asc_work.people_pending_title"}}</h2>
				<div class="ds-card">
					<ul class="ds-list">
						{{range .PendingInvites}}
							<li class="ds-li wk-member" data-testid="people-invite">
								<span class="ds-li-av"><span class="wk-agent-av wk-invite-av" aria-hidden="true">{{svg "dsi-mail" 20}}</span></span>
								<div class="ds-li-main">
									<div class="ds-li-title">
										<strong>{{if .User}}{{.User.DisplayName}}{{else}}{{.Email}}{{end}}</strong>
										<span class="ds-chip ds-chip-warn">{{svg "dsi-clock" 12}} {{ctx.Locale.Tr "asc_work.people_invited"}}</span>
									</div>
									<div class="ds-li-meta">
										<span>{{ctx.Locale.Tr (print "asc_work.role_" .Role)}}{{if .By}} &middot; {{ctx.Locale.Tr "asc_work.people_invited_by" .By.DisplayName}} {{DateUtils.TimeSince .Created}}{{end}}</span>
									</div>
								</div>
								<div class="wk-member-acts">
									<a class="ds-btn ds-btn-ghost ds-btn-sm link-action" href data-url="{{$.OrgLink}}/members/action/resend_invite?id={{.ID}}">{{ctx.Locale.Tr "asc_work.people_resend"}}</a>
									<a class="ds-btn ds-btn-ghost ds-btn-sm link-action" href data-url="{{$.OrgLink}}/members/action/revoke_invite?id={{.ID}}">{{ctx.Locale.Tr "asc_work.people_revoke"}}</a>
								</div>
							</li>
						{{else}}
							<li class="wk-empty-li"><p class="ds-c-2">{{ctx.Locale.Tr "asc_work.people_pending_none"}}</p></li>
						{{end}}
					</ul>
				</div>
			</section>
		{{end}}
	</div>
</div>
<div class="ui g-modal-confirm delete modal" id="leave-organization">
	<div class="header">
		{{ctx.Locale.Tr "org.members.leave"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "org.members.leave.detail" (`<span class="dataOrganizationName"></span>`|TrustHTML)}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>
<div class="ui g-modal-confirm delete modal" id="remove-organization-member">
	<div class="header">
		{{ctx.Locale.Tr "org.members.remove"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "org.members.remove.detail" (`<span class="name"></span>`|TrustHTML) (`<span class="dataOrganizationName"></span>`|TrustHTML)}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>
{{template "org/member/add_org_member" .}}

{{template "base/footer" .}}
