{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="ds-main organization new team wk-org">
	{{template "shared/ds/subbar" (dict "Data" . "Title" (or .Team.Name (ctx.Locale.Tr "org.create_new_team")) "BackHref" (print .OrgLink "/teams") "BackLabel" (ctx.Locale.Tr "org.teams"))}}
	{{template "org/header" .}}
	<div class="ds-container ds-container-wide wk-org-body">
		<form class="ui form ds-form wk-team-form" action="{{if .PageIsOrgTeamsNew}}{{.OrgLink}}/teams/new{{else}}{{.OrgLink}}/teams/{{.Team.LowerName | PathEscape}}/edit{{end}}" data-delete-url="{{.OrgLink}}/teams/{{.Team.LowerName | PathEscape}}/delete" method="post">
			{{.CsrfTokenHtml}}
			{{template "base/alert" .}}
			<section class="ds-card">
				<div class="ds-card-h"><h2>{{if .PageIsOrgTeamsNew}}{{ctx.Locale.Tr "org.create_new_team"}}{{else}}{{ctx.Locale.Tr "org.teams.settings"}}{{end}}</h2></div>
				<div class="ds-card-b ds-stack-16">
					<div class="required field ds-field {{if .Err_TeamName}}error{{end}}">
						<label class="ds-label" for="team_name">{{ctx.Locale.Tr "org.team_name"}}</label>
						{{if eq .Team.LowerName "owners"}}
							<input type="hidden" name="team_name" value="{{.Team.Name}}">
						{{end}}
						<input id="team_name" class="ds-input{{if .Err_TeamName}} is-err{{end}}" name="team_name" value="{{.Team.Name}}" required {{if eq .Team.LowerName "owners"}}disabled{{end}} autofocus>
						<p class="ds-hint">{{ctx.Locale.Tr "org.team_name_helper"}}</p>
					</div>
					<div class="field ds-field {{if .Err_Description}}error{{end}}">
						<label class="ds-label" for="description">{{ctx.Locale.Tr "org.team_desc"}}</label>
						<input id="description" class="ds-input{{if .Err_Description}} is-err{{end}}" name="description" value="{{.Team.Description}}">
						<p class="ds-hint">{{ctx.Locale.Tr "org.team_desc_helper"}}</p>
					</div>
				</div>
			</section>
			{{if not (eq .Team.LowerName "owners")}}
				<section class="ds-card">
					<div class="ds-card-h"><h2>{{ctx.Locale.Tr "settings.specific_repo_access"}}</h2></div>
					<fieldset class="ds-card-b wk-choice-list">
						<legend class="ds-sr">{{ctx.Locale.Tr "settings.specific_repo_access"}}</legend>
						<label class="wk-choice ds-check">
							<input type="radio" name="repo_access" value="specific" {{if not .Team.IncludesAllRepositories}}checked{{end}}>
							<span><b>{{ctx.Locale.Tr "org.teams.specific_repositories"}}</b><span class="ds-hint">{{ctx.Locale.Tr "org.teams.specific_repositories_helper"}}</span></span>
						</label>
						<label class="wk-choice ds-check">
							<input type="radio" name="repo_access" value="all" {{if .Team.IncludesAllRepositories}}checked{{end}}>
							<span><b>{{ctx.Locale.Tr "org.teams.all_repositories"}}</b><span class="ds-hint">{{ctx.Locale.Tr "org.teams.all_repositories_helper"}}</span></span>
						</label>
						<label class="wk-choice ds-check">
							<input name="can_create_org_repo" type="checkbox" {{if .Team.CanCreateOrgRepo}}checked{{end}}>
							<span><b>{{ctx.Locale.Tr "org.teams.can_create_org_repo"}}</b><span class="ds-hint">{{ctx.Locale.Tr "org.teams.can_create_org_repo_helper"}}</span></span>
						</label>
					</fieldset>
				</section>
				<section class="ds-card">
					<div class="ds-card-h"><h2>{{ctx.Locale.Tr "org.team_permission_desc"}}</h2></div>
					<fieldset class="ds-card-b wk-choice-list">
						<legend class="ds-sr">{{ctx.Locale.Tr "org.team_permission_desc"}}</legend>
						<label class="wk-choice ds-check">
							<input type="radio" name="permission" value="admin" {{if eq .Team.AccessMode 3}}checked{{end}}>
							<span><b>{{ctx.Locale.Tr "org.teams.admin_access"}}</b><span class="ds-hint">{{ctx.Locale.Tr "org.teams.admin_access_helper"}}</span></span>
						</label>
						<label class="wk-choice ds-check">
							<input type="radio" name="permission" value="read" {{if or .PageIsOrgTeamsNew (le .Team.AccessMode 2)}}checked{{end}}>
							<span><b>{{ctx.Locale.Tr "org.teams.general_access"}}</b><span class="ds-hint">{{ctx.Locale.Tr "org.teams.general_access_helper"}}</span></span>
						</label>
						<fieldset class="hide-unless-checked wk-units">
							<legend class="ds-label">{{ctx.Locale.Tr "org.team_unit_desc"}} <span class="ds-hint">{{ctx.Locale.Tr "org.teams.none_access_helper"}}</span></legend>
							<div class="ds-table-wrap">
								<table class="ds-table optionmatrix">
									<thead>
										<tr>
											<th scope="col">{{ctx.Locale.Tr "units.unit"}}</th>
											<th scope="col" id="access_none">{{ctx.Locale.Tr "org.teams.none_access"}}</th>
											<th scope="col">{{ctx.Locale.Tr "org.teams.read_access"}}</th>
											<th scope="col">{{ctx.Locale.Tr "org.teams.write_access"}}</th>
										</tr>
									</thead>
									<tbody>
										{{range $t, $unit := $.Units}}
											{{if ge $unit.MaxPerm 2}}
												<tr>
													<td>
														<label {{if $unit.Type.UnitGlobalDisabled}} data-tooltip-content="{{ctx.Locale.Tr "repo.unit_disabled"}}"{{end}}>
															<span id="help_{{$unit.Type.Value}}_name">{{ctx.Locale.Tr $unit.NameKey}}{{if $unit.Type.UnitGlobalDisabled}} {{ctx.Locale.Tr "org.team_unit_disabled"}}{{end}}</span>
															<span class="ds-hint" id="help_{{$unit.Type.Value}}_r">{{ctx.Locale.Tr (print "repo.permissions." $unit.Name ".read")}}</span>
															<span class="ds-hint" id="help_{{$unit.Type.Value}}_w">{{ctx.Locale.Tr (print "repo.permissions." $unit.Name ".write")}}</span>
														</label>
													</td>
													<td>
														<label>
															<input aria-labelledby="help_{{$unit.Type.Value}}_name access_none" type="radio" name="unit_{{$unit.Type.Value}}" value="0"{{if or ($unit.Type.UnitGlobalDisabled) (eq ($.Team.UnitAccessMode $.Context $unit.Type) 0)}} checked{{end}}>
															<span class="wk-only-small">{{ctx.Locale.Tr "org.teams.none_access"}}</span>
														</label>
													</td>
													<td>
														<label>
															<input aria-labelledby="help_{{$unit.Type.Value}}_name help_{{$unit.Type.Value}}_r" type="radio" name="unit_{{$unit.Type.Value}}" value="1"{{if or (eq $.Team.ID 0) (eq ($.Team.UnitAccessMode $.Context $unit.Type) 1)}} checked{{end}} {{if $unit.Type.UnitGlobalDisabled}}disabled{{end}}>
															<span class="wk-only-small">{{ctx.Locale.Tr "org.teams.read_access"}}</span>
														</label>
													</td>
													<td>
														<label>
															<input aria-labelledby="help_{{$unit.Type.Value}}_name help_{{$unit.Type.Value}}_w" type="radio" name="unit_{{$unit.Type.Value}}" value="2"{{if (ge ($.Team.UnitAccessMode $.Context $unit.Type) 2)}} checked{{end}} {{if $unit.Type.UnitGlobalDisabled}}disabled{{end}}>
															<span class="wk-only-small">{{ctx.Locale.Tr "org.teams.write_access"}}</span>
														</label>
													</td>
												</tr>
											{{end}}
										{{end}}
									</tbody>
								</table>
							</div>
							<div class="wk-choice-list">
							{{range $t, $unit := $.Units}}
								{{if lt $unit.MaxPerm 2}}
									<label class="wk-choice ds-check" {{if $unit.Type.UnitGlobalDisabled}}data-tooltip-content="{{ctx.Locale.Tr "repo.unit_disabled"}}"{{end}}>
										<input type="checkbox" name="unit_{{$unit.Type.Value}}" value="1"{{if or (eq $.Team.ID 0) (eq ($.Team.UnitAccessMode $.Context $unit.Type) 1)}} checked{{end}} {{if $unit.Type.UnitGlobalDisabled}}disabled{{end}}>
										<span><b>{{ctx.Locale.Tr $unit.NameKey}}{{if $unit.Type.UnitGlobalDisabled}} {{ctx.Locale.Tr "org.team_unit_disabled"}}{{end}}</b><span class="ds-hint">{{ctx.Locale.Tr (print "repo.permissions." $unit.Name)}}</span></span>
									</label>
								{{end}}
							{{end}}
							</div>
						</fieldset>
					</fieldset>
				</section>
			{{end}}

			<div class="ds-sticky-actions wk-form-actions">
				{{if .PageIsOrgTeamsNew}}
					<button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "org.create_team"}}</button>
				{{else}}
					<button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "org.teams.update_settings"}}</button>
					{{if not (eq .Team.LowerName "owners")}}
						<button type="button" class="ds-btn ds-btn-danger delete-button" data-url="{{.OrgLink}}/teams/{{.Team.Name | PathEscape}}/delete" data-modal-id="delete-team">{{ctx.Locale.Tr "org.teams.delete_team"}}</button>
					{{end}}
				{{end}}
			</div>
		</form>
	</div>
</div>

<div class="ui g-modal-confirm delete modal" id="delete-team">
	<div class="header">
		{{svg "dsi-trash" 18}}
		{{ctx.Locale.Tr "org.teams.delete_team_title"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "org.teams.delete_team_desc"}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>
{{template "base/footer" .}}
