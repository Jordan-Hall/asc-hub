{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="ds-main organization teams wk-org">
	{{template "shared/ds/subbar" (dict "Data" . "Title" (ctx.Locale.Tr "org.teams") "BackHref" .Org.HomeLink "BackLabel" .Org.DisplayName)}}
	{{template "org/header" .}}
	<div class="ds-container wk-org-body">
		{{template "base/alert" .}}
		<div class="wk-toolbar">
			<p class="ds-t-small ds-c-2" data-testid="org-teams-count">{{ctx.Locale.TrN (len .Teams) "asc_work.org_teams_one" "asc_work.org_teams_n" (len .Teams)}}</p>
			{{if .IsOrganizationOwner}}
				<a class="ds-btn ds-btn-primary" href="{{.OrgLink}}/teams/new">{{svg "dsi-plus" 16}} {{ctx.Locale.Tr "org.create_new_team"}}</a>
			{{end}}
		</div>

		{{if .Teams}}
			{{$sel := .SelectedTeam}}
			<ul class="wk-team-grid">
				{{range .Teams}}
					<li class="ds-card wk-team-card{{if eq .ID $sel.ID}} is-selected{{end}}">
						<div class="wk-team-head">
							<span class="ds-ico-box" aria-hidden="true">{{svg "dsi-users" 20}}</span>
							<div class="ds-min0">
								<h3 class="wk-team-title"><a class="wk-team-pick-link" href="{{$.OrgLink}}/teams?team={{.LowerName | QueryEscape}}#team-detail"{{if eq .ID $sel.ID}} aria-current="true"{{end}}>{{.Name}}</a></h3>
								<div class="wk-team-access">{{if ge .AccessMode 3}}{{ctx.Locale.Tr "repo.settings.collaboration.admin"}}{{else if eq .AccessMode 2}}{{ctx.Locale.Tr "repo.settings.collaboration.write"}}{{else}}{{ctx.Locale.Tr "repo.settings.collaboration.read"}}{{end}}</div>
							</div>
						</div>
						<p class="wk-team-desc">{{if .Description}}{{.Description}}{{else}}<span class="ds-c-2">{{ctx.Locale.Tr "org.teams.no_desc"}}</span>{{end}}</p>
						<div class="wk-team-foot">
							<div class="wk-team-avatars">
								{{range .Members}}
									<a class="avatar" href="{{.HomeLink}}" title="{{.Name}}" aria-label="{{.Name}}">{{ctx.AvatarUtils.Avatar . 32}}</a>
								{{end}}
							</div>
							<a class="wk-team-repos" href="{{$.OrgLink}}/teams/{{.LowerName | PathEscape}}/repositories">{{ctx.Locale.TrN .NumRepos "asc_work.org_repo_one" "asc_work.org_repo_n" .NumRepos}}</a>
						</div>
					</li>
				{{end}}
			</ul>

			{{with $sel}}
			<section class="ds-card wk-team-detail" id="team-detail" aria-labelledby="wk-team-detail-h" data-testid="org-team-detail">
				<div class="ds-card-h wk-team-detail-h">
					<span class="ds-ico-box" aria-hidden="true">{{svg "dsi-users" 20}}</span>
					<div class="ds-min0">
						<h2 id="wk-team-detail-h" class="ds-t-h4">{{.Name}}</h2>
						<p class="ds-t-small ds-c-2">{{ctx.Locale.Tr "asc_work.org_team_summary" (ctx.Locale.TrN .NumMembers "asc_work.org_people_one" "asc_work.org_people_n" .NumMembers) (ctx.Locale.TrN .NumRepos "asc_work.org_repo_one" "asc_work.org_repo_n" .NumRepos) (ctx.Locale.Tr (print "asc_work.org_access_" .AccessMode))}}</p>
					</div>
					<div class="wk-team-acts">
						{{if $.IsOrganizationOwner}}
							<a class="ds-btn ds-btn-secondary" href="{{$.OrgLink}}/teams/{{.LowerName | PathEscape}}/edit">{{svg "dsi-pencil" 16}} {{ctx.Locale.Tr "asc_work.org_edit_team"}}</a>
							<a class="ds-btn ds-btn-primary" href="{{$.OrgLink}}/teams/{{.LowerName | PathEscape}}">{{svg "dsi-plus" 16}} {{ctx.Locale.Tr "asc_work.org_add_member"}}</a>
						{{end}}
						{{if .IsMember ctx $.SignedUser.ID}}
							<button type="button" class="ds-btn ds-btn-danger delete-button" data-modal-id="leave-team"
								data-url="{{$.OrgLink}}/teams/{{.LowerName | PathEscape}}/action/leave" data-datauid="{{$.SignedUser.ID}}"
								data-name="{{.Name}}">{{ctx.Locale.Tr "org.teams.leave"}}</button>
						{{else if $.IsOrganizationOwner}}
							<form class="wk-inline-form" method="post" action="{{$.OrgLink}}/teams/{{.LowerName | PathEscape}}/action/join">
								{{$.CsrfTokenHtml}}
								<button type="submit" class="ds-btn ds-btn-secondary" name="uid" value="{{$.SignedUser.ID}}">{{ctx.Locale.Tr "org.teams.join"}}</button>
							</form>
						{{end}}
					</div>
				</div>
				<div class="ds-card-b wk-team-split">
					<div>
						<h3 class="wk-team-sub">{{ctx.Locale.Tr "org.members"}}</h3>
						<ul class="wk-team-rows">
							{{range .Members}}
								<li><a class="wk-team-row-main" href="{{.HomeLink}}">{{ctx.AvatarUtils.Avatar . 32}}<b>{{.DisplayName}}</b></a></li>
							{{else}}
								<li class="ds-c-2">{{ctx.Locale.Tr "org.teams.members.none"}}</li>
							{{end}}
						</ul>
					</div>
					<div>
						<h3 class="wk-team-sub">{{ctx.Locale.Tr "org.repositories"}}</h3>
						<ul class="wk-team-rows">
							{{range .Repos}}
								<li><a class="wk-team-row-main" href="{{.Link}}"><b>{{.FullName}}</b></a><span class="ds-chip ds-chip-outline">{{ctx.Locale.Tr (print "asc_work.org_access_" $.SelectedTeam.AccessMode)}}</span></li>
							{{else}}
								<li class="ds-c-2">{{ctx.Locale.Tr "org.teams.repos.none"}}</li>
							{{end}}
						</ul>
					</div>
				</div>
			</section>
			{{end}}
		{{else}}
			<div class="ds-empty ds-card">
				<span class="ds-empty-ic" aria-hidden="true">{{svg "dsi-users" 32}}</span>
				<h3>{{ctx.Locale.Tr "asc_work.org_no_teams"}}</h3>
				{{if .IsOrganizationOwner}}
					<div class="ds-empty-acts"><a class="ds-btn ds-btn-primary" href="{{.OrgLink}}/teams/new">{{ctx.Locale.Tr "org.create_new_team"}}</a></div>
				{{end}}
			</div>
		{{end}}
	</div>
</div>
<div class="ui g-modal-confirm delete modal" id="leave-team">
	<div class="header">
		{{ctx.Locale.Tr "org.teams.leave"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "org.teams.leave.detail" (`<span class="name"></span>`|TrustHTML)}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>
{{template "base/footer" .}}
