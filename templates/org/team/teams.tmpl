{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="ds-main organization teams wk-org">
	{{template "shared/ds/subbar" (dict "Data" . "Title" (ctx.Locale.Tr "org.teams") "BackHref" .Org.HomeLink "BackLabel" .Org.DisplayName)}}
	{{template "org/header" .}}
	<div class="ds-container ds-container-wide wk-org-body">
		{{template "base/alert" .}}
		<div class="wk-toolbar">
			<h2 class="ds-t-h3">{{ctx.Locale.Tr "org.teams"}} <span class="ds-count">{{len .Teams}}</span></h2>
			{{if .IsOrganizationOwner}}
				<a class="ds-btn ds-btn-primary" href="{{.OrgLink}}/teams/new">{{svg "dsi-plus" 16}} {{ctx.Locale.Tr "org.create_new_team"}}</a>
			{{end}}
		</div>

		{{if .Teams}}
			<ul class="wk-team-grid">
				{{range .Teams}}
					<li class="ds-card wk-team-card">
						<div class="wk-team-head">
							<span class="ds-ico-box" aria-hidden="true">{{svg "dsi-users" 20}}</span>
							<div class="ds-min0">
								<h3 class="wk-team-title"><a href="{{$.OrgLink}}/teams/{{.LowerName | PathEscape}}">{{.Name}}</a></h3>
								<div class="wk-team-access">{{if ge .AccessMode 3}}{{ctx.Locale.Tr "repo.settings.collaboration.admin"}}{{else if eq .AccessMode 2}}{{ctx.Locale.Tr "repo.settings.collaboration.write"}}{{else}}{{ctx.Locale.Tr "repo.settings.collaboration.read"}}{{end}}</div>
							</div>
						</div>
						<p class="wk-team-desc">{{if .Description}}{{.Description}}{{else}}<span class="ds-c-2">{{ctx.Locale.Tr "org.teams.no_desc"}}</span>{{end}}</p>
						<div class="wk-team-avatars">
							{{range .Members}}
								<a class="avatar" href="{{.HomeLink}}" title="{{.Name}}" aria-label="{{.Name}}">{{ctx.AvatarUtils.Avatar . 32}}</a>
							{{end}}
						</div>
						<div class="wk-team-foot">
							<a href="{{$.OrgLink}}/teams/{{.LowerName | PathEscape}}"><b>{{.NumMembers}}</b> {{ctx.Locale.Tr "org.lower_members"}}</a>
							<a href="{{$.OrgLink}}/teams/{{.LowerName | PathEscape}}/repositories"><b>{{.NumRepos}}</b> {{ctx.Locale.Tr "org.lower_repositories"}}</a>
							<span class="wk-team-acts">
								<a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{$.OrgLink}}/teams/{{.LowerName | PathEscape}}">{{ctx.Locale.Tr "view"}}</a>
								{{if .IsMember ctx $.SignedUser.ID}}
									<button type="button" class="ds-btn ds-btn-danger ds-btn-sm delete-button" data-modal-id="leave-team"
										data-url="{{$.OrgLink}}/teams/{{.LowerName | PathEscape}}/action/leave" data-datauid="{{$.SignedUser.ID}}"
										data-name="{{.Name}}">{{ctx.Locale.Tr "org.teams.leave"}}</button>
								{{else if $.IsOrganizationOwner}}
									<form class="wk-inline-form" method="post" action="{{$.OrgLink}}/teams/{{.LowerName | PathEscape}}/action/join">
										{{$.CsrfTokenHtml}}
										<button type="submit" class="ds-btn ds-btn-secondary ds-btn-sm" name="uid" value="{{$.SignedUser.ID}}">{{ctx.Locale.Tr "org.teams.join"}}</button>
									</form>
								{{end}}
							</span>
						</div>
					</li>
				{{end}}
			</ul>
		{{else}}
			<div class="ds-empty ds-card">
				<span class="ds-empty-ic" aria-hidden="true">{{svg "dsi-users" 32}}</span>
				<h3>{{ctx.Locale.Tr "asc_work.org_no_teams"}}</h3>
				{{if .IsOrganizationOwner}}
					<div class="ds-empty-acts"><a class="ds-btn ds-btn-primary" href="{{.OrgLink}}/teams/new">{{ctx.Locale.Tr "org.create_new_team"}}</a></div>
				{{end}}
			</div>
		{{end}}
	</div>
</div>
<div class="ui g-modal-confirm delete modal" id="leave-team">
	<div class="header">
		{{ctx.Locale.Tr "org.teams.leave"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "org.teams.leave.detail" (`<span class="name"></span>`|TrustHTML)}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>
{{template "base/footer" .}}
