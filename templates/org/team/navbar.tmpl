<nav class="ds-tabs org-team-navbar" aria-label="{{.Team.Name}}">
	<a class="ds-tab" href="{{.OrgLink}}/teams/{{.Team.LowerName | PathEscape}}"{{if .PageIsOrgTeamMembers}} aria-current="page"{{end}}>{{ctx.Locale.Tr "org.members"}} <span class="ds-count">{{.Team.NumMembers}}</span></a>
	<a class="ds-tab" href="{{.OrgLink}}/teams/{{.Team.LowerName | PathEscape}}/repositories"{{if .PageIsOrgTeamRepos}} aria-current="page"{{end}}>{{ctx.Locale.Tr "user.repositories"}} <span class="ds-count">{{.Team.NumRepos}}</span></a>
</nav>
