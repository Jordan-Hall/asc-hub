{{template "org/settings/layout_head" (dict "ctxData" . "pageClass" "ds-main organization settings blocked-users wk-settings")}}
{{template "user/settings/page_head" (dict "Title" (ctx.Locale.Tr "settings.blocked_users") "Lead" (ctx.Locale.Tr "asc_work.sp_blocked_org_lead"))}}
<div class="wk-sp">
	<section class="ds-card" aria-labelledby="sp-block">
		<div class="ds-card-h"><h2 id="sp-block">{{ctx.Locale.Tr "user.block"}}</h2></div>
		<form class="ui form ds-form wk-card-form ignore-dirty" action="{{$.Link}}/block" method="post">
			{{.CsrfTokenHtml}}
			<input type="hidden" name="uid" value="">
			<div class="ds-field">
				<label class="ds-label" for="block-uname">{{ctx.Locale.Tr "search.user_kind"}}</label>
				<div class="wk-inline-field">
					<div id="search-user-box" class="ui search ds-grow">
						<div class="ui input">
							<input id="block-uname" class="prompt ds-input" name="uname" placeholder="{{ctx.Locale.Tr "search.user_kind"}}" autocomplete="off" required>
						</div>
					</div>
					<button type="submit" class="ds-btn ds-btn-danger-fill">{{ctx.Locale.Tr "user.block"}}</button>
				</div>
			</div>
		</form>
	</section>
	<section class="ds-card" aria-labelledby="sp-blocked">
		<div class="ds-card-h"><h2 id="sp-blocked">{{ctx.Locale.Tr "settings.blocked_users"}}</h2></div>
		{{template "shared/blocked_users_list" .}}
	</section>
</div>
{{template "org/settings/layout_footer" .}}
