{{template "org/settings/layout_head" (dict "ctxData" . "pageClass" "organization settings delete")}}

			<div class="org-setting-content">
				<h4 class="ds-card-top">{{ctx.Locale.Tr "org.settings.transfer_title"}}</h4>
				<div class="ds-card ds-card-b ds-card-attach" data-testid="org-transfer">
					<p>{{ctx.Locale.Tr "org.settings.transfer_desc"}}</p>
					{{if .TransferCandidates}}
					<form class="ui form ignore-dirty" action="{{.TransferLink}}" method="post">
						{{.CsrfTokenHtml}}
						<div class="inline required field">
							<label for="new_owner">{{ctx.Locale.Tr "org.settings.transfer_new_owner"}}</label>
							<select class="ds-select" id="new_owner" name="new_owner" required>
								{{range .TransferCandidates}}<option value="{{.Name}}">{{.DisplayName}} ({{.Name}})</option>{{end}}
							</select>
						</div>
						<div class="inline required field">
							<label for="transfer_org_name">{{ctx.Locale.Tr "org.org_name_holder"}}</label>
							<input class="ds-input" id="transfer_org_name" name="org_name" value="" autocomplete="off" required>
						</div>
						<label class="ds-check"><input type="checkbox" name="leave" value="true"> {{ctx.Locale.Tr "org.settings.transfer_leave"}}</label>
						<button class="ds-btn ds-btn-danger" type="submit">{{ctx.Locale.Tr "org.settings.transfer_button"}}</button>
					</form>
					{{else}}
					<p class="ds-hint">{{ctx.Locale.Tr "org.settings.transfer_nobody"}}</p>
					{{end}}
				</div>
				<h4 class="ds-card-top">
					{{ctx.Locale.Tr "org.settings.delete_account"}}
				</h4>
				<div class="ds-card ds-card-b ds-card-attach">
					<div class="ds-banner ds-banner-err">
						<p class="text left">{{svg "octicon-alert"}} {{ctx.Locale.Tr "org.settings.delete_prompt"}}</p>
					</div>
					<form class="ui form ignore-dirty" id="delete-form" action="{{.Link}}" method="post">
						<div class="inline required field {{if .Err_OrgName}}error{{end}}">
							<label for="org_name">{{ctx.Locale.Tr "org.org_name_holder"}}</label>
							<input class="ds-input" id="org_name" name="org_name" value="" autocomplete="off" autofocus required>
						</div>
						<button class="ds-btn ds-btn-danger delete-button" data-type="form" data-form="#delete-form" data-modal-id="delete-org">
							{{ctx.Locale.Tr "org.settings.confirm_delete_account"}}
						</button>
					</form>
				</div>
			</div>

<div class="ui g-modal-confirm delete modal" id="delete-org">
	<div class="header">
		{{svg "octicon-trash"}}
		{{ctx.Locale.Tr "org.settings.delete_org_title"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "org.settings.delete_org_desc"}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>

{{template "org/settings/layout_footer" .}}
