{{/* The organization settings menu: the same shell as the account settings (user/settings/navbar). */}}
{{$base := print .OrgLink "/settings"}}
<nav class="ds-settings-nav" id="settings-menu" aria-label="{{ctx.Locale.Tr "org.settings"}}">
	{{template "shared/ds/snav_bar" (dict "Title" (ctx.Locale.Tr "org.settings"))}}
	<div class="ds-settings-nav-in">
		{{template "shared/ds/snav_who" (dict "Entity" .Org "Name" (or .Org.FullName .Org.Name) "Sub" (print "@" .Org.Name) "Href" .OrgLink "Label" (ctx.Locale.Tr "asc_shell.sn_view_org"))}}

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_general"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" $base "Label" (ctx.Locale.Tr "org.settings.options") "Icon" "sliders" "Active" .PageIsSettingsOptions)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/domain") "Label" (ctx.Locale.Tr "asc_work.org_domain") "Icon" "shield-check" "Active" .PageIsSettingsDomain)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/labels") "Label" (ctx.Locale.Tr "repo.labels") "Icon" "tag" "Active" .PageIsOrgSettingsLabels)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/blocked_users") "Label" (ctx.Locale.Tr "settings.blocked_users") "Icon" "eye" "Active" .PageIsSettingsBlockedUsers)}}
			{{if .EnableQuota}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/storage_overview") "Label" (ctx.Locale.Tr "settings.storage_overview") "Icon" "gauge" "Active" .PageIsSettingsStorageOverview)}}
			{{end}}
		</ul>

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_integrations"}}</h2>
		<ul class="ds-settings-list">
			{{if not DisableWebhooks}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/hooks") "Label" (ctx.Locale.Tr "repo.settings.hooks") "Icon" "link" "Active" .PageIsSettingsHooks)}}
			{{end}}
			{{if .EnableOAuth2}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/applications") "Label" (ctx.Locale.Tr "settings.applications") "Icon" "puzzle" "Active" .PageIsSettingsApplications)}}
			{{end}}
			{{if .EnablePackages}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/packages") "Label" (ctx.Locale.Tr "packages.title") "Icon" "package" "Active" .PageIsSettingsPackages)}}
			{{end}}
			{{if .EnableActions}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/actions/permissions") "Label" (ctx.Locale.Tr "actions.permissions.title") "Icon" "shield-check" "Active" .PageIsSharedSettingsPermissions)}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/actions/runners") "Label" (ctx.Locale.Tr "actions.runners") "Icon" "cpu" "Active" .PageIsSharedSettingsRunners)}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/actions/secrets") "Label" (ctx.Locale.Tr "secrets.secrets") "Icon" "lock" "Active" .PageIsSharedSettingsSecrets)}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/actions/variables") "Label" (ctx.Locale.Tr "actions.variables") "Icon" "hash" "Active" .PageIsSharedSettingsVariables)}}
			{{end}}
		</ul>

		{{if .AscEnabled}}
		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_byo"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/ai") "Label" (ctx.Locale.Tr "ascbyo.nav_ai") "Icon" "sparkles" "Active" .PageIsSettingsAscAI)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/storage") "Label" (ctx.Locale.Tr "ascbyo.nav_storage") "Icon" "database" "Active" .PageIsSettingsAscStorage)}}
		</ul>
		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_governance"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/usage") "Label" (ctx.Locale.Tr "asc_shell.sn_usage") "Icon" "dollar" "Active" .PageIsSettingsAscUsage)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/audit") "Label" (ctx.Locale.Tr "asc_shell.sn_audit_log") "Icon" "history" "Active" .PageIsSettingsAscAudit)}}
		</ul>
		{{end}}

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_danger"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/delete") "Label" (ctx.Locale.Tr "org.settings.delete") "Icon" "trash" "Danger" true "Active" .PageIsSettingsDelete)}}
		</ul>
	</div>
</nav>
