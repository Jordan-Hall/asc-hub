{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="ds-main organization profile wk-org">
	{{template "shared/ds/subbar" (dict "Data" . "Title" .Org.DisplayName "BackHref" (print AppSubUrl "/explore/organizations") "BackLabel" (ctx.Locale.Tr "explore.organizations"))}}
	{{template "org/header" .}}

	<div class="ds-container ds-container-wide wk-org-body">
		{{template "base/alert" .}}
		<div class="ds-split wk-org-split">
			<div class="ds-min0 wk-org-main">
				{{if .ProfileReadme}}
					<div id="readme_profile" class="ds-card wk-pf-readme {{if not .IsProfileReadmePlain}}markup{{end}}">
					{{if .IsProfileReadmePlain}}
						<pre>{{.ProfileReadme}}</pre>
					{{else}}
						{{.ProfileReadme}}
					{{end}}
					</div>
				{{end}}
				{{if and .ShowMemberAndTeamTab .CanCreateOrgRepo}}
					<div class="wk-org-actions">
						<a class="ds-btn ds-btn-primary" href="{{AppSubUrl}}/repo/create?org={{.Org.ID}}">{{ctx.Locale.Tr "new_repo.link"}}</a>
						{{if not .DisableMigrations}}
							<a class="ds-btn ds-btn-secondary" href="{{AppSubUrl}}/repo/migrate?org={{.Org.ID}}&mirror=1">{{ctx.Locale.Tr "new_migrate.link"}}</a>
						{{end}}
					</div>
				{{end}}
				{{template "shared/repo_search" .}}
				{{template "explore/repo_list" .}}
				{{template "base/paginate" .}}
			</div>

			{{if .ShowMemberAndTeamTab}}
			<aside class="ds-rail" aria-label="{{ctx.Locale.Tr "asc_work.org_aside"}}">
				{{if .NumMembers}}
					<section class="ds-card" aria-labelledby="wk-org-people">
						<div class="ds-card-h">
							<h2 id="wk-org-people">{{ctx.Locale.Tr "asc_work.org_people_h"}}</h2>
							<a class="ds-link ds-ml-auto ds-t-small ds-sb" href="{{.OrgLink}}/members">{{ctx.Locale.Tr "asc_work.org_all_n" .NumMembers}}</a>
						</div>
						<div class="wk-org-avatars">
							{{$isMember := .IsOrganizationMember}}
							{{range $i, $m := .Members}}
								{{if lt $i 5}}{{if or $isMember (call $.IsPublicMember $m.ID)}}
									<a href="{{$m.HomeLink}}" title="{{$m.Name}}{{if $m.FullName}} ({{$m.FullName}}){{end}}" aria-label="{{$m.Name}}">{{ctx.AvatarUtils.Avatar $m 40}}</a>
								{{end}}{{end}}
							{{end}}
							{{if gt .NumMembers 5}}<a class="wk-org-more" href="{{.OrgLink}}/members" aria-label="{{ctx.Locale.Tr "asc_work.org_all_n" .NumMembers}}">+{{Eval .NumMembers "-" 5}}</a>{{end}}
						</div>
						{{if .OrgAgentList}}
						<div class="wk-org-agents" data-testid="org-agents">
							<h3 class="wk-org-sub">{{ctx.Locale.Tr "asc_work.org_agents_h"}}</h3>
							<div class="wk-org-avatars">
								{{range .OrgAgentList}}<a class="wk-agent-av" href="{{$.OrgLink}}/members#people-agents" title="{{.DisplayName}}" aria-label="{{.DisplayName}}">{{svg "dsi-agent" 20}}</a>{{end}}
							</div>
						</div>
						{{end}}
					</section>
				{{end}}
				{{if .IsOrganizationMember}}
					<section class="ds-card" aria-labelledby="wk-org-teams">
						<div class="ds-card-h">
							<h2 id="wk-org-teams">{{ctx.Locale.Tr "org.teams"}}</h2>
						</div>
						<ul class="wk-org-teamlist">
							{{range .Teams}}
								<li>
									<a class="wk-org-team-name" href="{{$.OrgLink}}/teams?team={{.LowerName | QueryEscape}}">{{.Name}}</a>
									<span class="wk-org-team-meta">{{ctx.Locale.TrN .NumMembers "asc_work.org_people_one" "asc_work.org_people_n" .NumMembers}}</span>
								</li>
							{{end}}
						</ul>
					</section>
				{{end}}
				{{if and .IsOrganizationMember .OrgAscOn}}
					<section class="ds-card wk-org-policy" aria-labelledby="wk-org-policy" data-testid="org-merge-policy">
						<div class="ds-card-b">
							<h2 id="wk-org-policy" class="ds-t-h4">{{ctx.Locale.Tr "asc_work.org_policy_h"}}</h2>
							<p class="ds-t-small ds-c-2">{{ctx.Locale.Tr "asc_rp.p_org_lead"}}</p>
							<a class="ds-link ds-sb" href="{{.OrgLink}}/settings/asc/agents">{{ctx.Locale.Tr "asc_work.org_policy_read"}}</a>
						</div>
					</section>
				{{end}}
			</aside>
			{{end}}
		</div>
	</div>
</div>
{{template "base/footer" .}}
