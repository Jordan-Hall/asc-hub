{{/* The head of an organization (design boards "OrgProfile" and "Mobile-OrgProfile"): avatar, name, description, facts, actions, then the tabs. */}}
<div class="wk-pf-band wk-org-band">
	<div class="ds-container ds-container-wide">
		<div id="org-info" class="wk-pf-card wk-org-card">
			<div class="wk-pf-av wk-org-av">{{if or .Org.UseCustomAvatar (not .OrgInitial)}}{{ctx.AvatarUtils.Avatar .Org 96 "org-avatar"}}{{else}}<span class="wk-org-tile" aria-hidden="true">{{.OrgInitial}}</span>{{end}}</div>
			<div class="wk-pf-info tw-break-anywhere">
				<div class="wk-pf-line1">
					<h1 class="wk-pf-name">{{.Org.DisplayName}}</h1>
					{{if .AscOrgDomain}}<span class="ds-chip ds-chip-ok wk-verified" data-tooltip-content="{{ctx.Locale.Tr "asc_work.org_verified_tip" .AscOrgDomain}}">{{svg "dsi-shield-check" 14}} {{ctx.Locale.Tr "asc_work.org_verified"}}</span>{{end}}
					{{if .Org.Visibility.IsLimited}}<span class="ds-chip">{{ctx.Locale.Tr "org.settings.visibility.limited_shortname"}}</span>{{end}}
					{{if .Org.Visibility.IsPrivate}}<span class="ds-chip">{{ctx.Locale.Tr "org.settings.visibility.private_shortname"}}</span>{{end}}
				</div>
				{{if .RenderedDescription}}<div class="wk-pf-desc render-content markup">{{.RenderedDescription}}</div>{{end}}
				<div class="wk-pf-line2 wk-org-facts">
					{{if .Org.Location}}<span>{{.Org.Location}}</span>{{end}}
					{{if .Org.Website}}<a class="ds-mono" target="_blank" rel="noopener noreferrer me" href="{{.Org.Website}}">{{.Org.Website}}</a>{{end}}
					{{if .IsSigned}}{{if .Org.Email}}<a href="mailto:{{.Org.Email}}">{{.Org.Email}}</a>{{end}}{{end}}
					{{if .NumMembers}}<a href="{{.OrgLink}}/members">{{ctx.Locale.TrN .NumMembers "asc_work.org_people_one" "asc_work.org_people_n" .NumMembers}}</a>{{end}}
					{{if .AscOrgAgents}}<a href="{{.OrgLink}}/members#people-agents">{{ctx.Locale.TrN .AscOrgAgents "asc_work.org_agents_one" "asc_work.org_agents_n" .AscOrgAgents}}</a>{{end}}
				</div>
			</div>
			<div class="wk-pf-actions">
				{{if .IsSigned}}
					<div class="wk-pf-primary">{{template "org/follow_unfollow" .}}</div>
				{{end}}
				{{if .IsOrganizationOwner}}
					<a id="settings-btn" class="ds-btn ds-btn-secondary" href="{{.OrgLink}}/settings">{{ctx.Locale.Tr "asc_work.org_settings"}}</a>
				{{else if .IsOrganizationMember}}
					<a class="ds-btn ds-btn-secondary" href="{{.OrgLink}}/dashboard">{{ctx.Locale.Tr "org.open_dashboard"}}</a>
				{{end}}
				{{$moderationEntryNeeded := and .IsModerationEnabled .IsSigned (not .IsOrganizationOwner)}}
				{{if or .EnableFeed $moderationEntryNeeded .IsOrganizationOwner}}
					<button type="button" class="ds-btn ds-btn-secondary show-modal" data-modal="#org-actions" aria-haspopup="dialog">{{ctx.Locale.Tr "asc_work.pf_more"}}</button>
				{{end}}
			</div>
		</div>
		{{template "org/menu" .}}
	</div>
</div>
{{$moderationEntryNeeded := and .IsModerationEnabled .IsSigned (not .IsOrganizationOwner)}}
{{if or .EnableFeed $moderationEntryNeeded .IsOrganizationOwner}}
<dialog id="org-actions" class="wk-sheet-menu">
	<article>
		<header>{{ctx.Locale.Tr "profile.actions.tooltip"}}</header>
		<div class="content">
			<ul class="wk-sheet-list">
				{{if .IsOrganizationOwner}}
					<li><a href="{{.OrgLink}}/dashboard">{{svg "dsi-grid" 18}}<span>{{ctx.Locale.Tr "org.open_dashboard"}}</span></a></li>
				{{end}}
				{{if .EnableFeed}}
					<li><a href="{{.Org.HomeLink}}.rss">{{svg "dsi-activity" 18}}<span>{{ctx.Locale.Tr "rss_feed"}}</span></a></li>
					<li><a href="{{.Org.HomeLink}}.atom">{{svg "dsi-activity" 18}}<span>{{ctx.Locale.Tr "feed.atom.link"}}</span></a></li>
				{{end}}
				{{if $moderationEntryNeeded}}
					<li><a class="is-danger" href="{{AppSubUrl}}/report_abuse?type=org&id={{$.Org.ID}}">{{svg "dsi-flag" 18}}<span>{{ctx.Locale.Tr "moderation.report_abuse"}}</span></a></li>
				{{end}}
			</ul>
		</div>
		<div class="actions"><button type="button" class="ds-btn ds-btn-secondary cancel">{{ctx.Locale.Tr "cancel"}}</button></div>
	</article>
</dialog>
{{end}}
