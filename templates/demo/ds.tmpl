{{/* The component gallery of the ASC design system (non-production only): every class and partial in docs/asc/THEME.md, in the state a page group will use it. */}}
{{template "base/head" .}}
<div role="main" aria-label="Design system" class="ds-main">
	{{template "shared/ds/subbar" (dict "Data" . "Title" "Design system" "BackHref" (print AppSubUrl "/-/demo"))}}
	<div class="ds-container ds-section">
		{{template "shared/ds/page_head" (dict "Title" "Design system" "Prefix" "Demo" "Description" "Every component and partial a page group builds with." "PrimaryLabel" "Primary action" "PrimaryHref" "#buttons" "SecondaryLabel" "Secondary" "SecondaryHref" "#buttons")}}

		<nav class="ds-tabs" aria-label="Tabs">
			{{template "shared/ds/tab" (dict "Label" "Overview" "Href" "#" "Active" true)}}
			{{template "shared/ds/tab" (dict "Label" "Changes" "Href" "#" "Count" "12")}}
			{{template "shared/ds/tab" (dict "Label" "Checks" "Href" "#" "Count" "3")}}
			{{template "shared/ds/tab" (dict "Label" "Settings" "Href" "#")}}
		</nav>
	</div>

	{{template "shared/ds/filter_bar" (dict "Label" "Filter the list" "Value" "ledger" "Hidden" (dict "sort" "newest") "Action" "")}}

	<div class="ds-container ds-section ds-stack ds-stack-24">
		<section id="buttons" class="ds-card"><div class="ds-card-h"><h2>Buttons</h2></div><div class="ds-card-b ds-row ds-row-wrap ds-gap-8">
			<button class="ds-btn ds-btn-primary">Primary</button>
			<button class="ds-btn ds-btn-secondary">Secondary</button>
			<button class="ds-btn ds-btn-ghost">Ghost</button>
			<button class="ds-btn ds-btn-danger">Danger</button>
			<button class="ds-btn ds-btn-danger-fill">Delete</button>
			<button class="ds-btn ds-btn-primary" disabled>Disabled</button>
			<button class="ds-btn ds-btn-secondary ds-btn-sm">Small</button>
			<button class="ds-btn ds-btn-secondary ds-btn-icon" aria-label="More">{{svg "dsi-dots" 18}}</button>
			<button class="ds-btn ds-btn-secondary show-modal" data-modal="#demo-confirm">Open confirm</button>
		</div></section>

		<section class="ds-card"><div class="ds-card-h"><h2>Pills, chips, counts, avatars</h2></div><div class="ds-card-b ds-stack ds-stack-12">
			<div class="ds-row ds-row-wrap ds-gap-8">
				<span class="ds-chip ds-chip-ok">Passing</span><span class="ds-chip ds-chip-warn">Waiting on you</span><span class="ds-chip ds-chip-err">Failing</span>
				<span class="ds-chip ds-chip-info">Info</span><span class="ds-chip ds-chip-agent">Agent</span><span class="ds-chip">Neutral</span><span class="ds-chip ds-chip-outline">Outline</span>
				<span class="ds-count">12</span><span class="ds-count ds-count-hot">3</span><span class="ds-count ds-count-agent">2</span>
			</div>
			<div class="ds-scrollx" role="group" aria-label="Filter pills">
				{{template "shared/ds/pill" (dict "Label" "All" "Href" "#" "Active" true)}}
				{{template "shared/ds/pill" (dict "Label" "Open" "Href" "#" "Count" "4")}}
				{{template "shared/ds/pill" (dict "Label" "Mine" "Href" "#")}}
				{{template "shared/ds/pill" (dict "Label" "Archived" "Href" "#")}}
			</div>
			<div class="ds-row ds-gap-8">
				<span class="ds-av ds-av-24">MO</span><span class="ds-av ds-av-32">MO</span><span class="ds-av ds-av-40">MO</span><span class="ds-av ds-av-48 ds-av-agent">AG</span><span class="ds-av ds-av-48 ds-av-org">OR</span>
			</div>
		</div></section>

		<section class="ds-card"><div class="ds-card-h"><h2>Form fields</h2></div><div class="ds-card-b ds-form">
			{{template "shared/ds/field" (dict "ID" "demo-name" "Name" "name" "Label" "Display name" "Hint" "Shown on changes and comments.")}}
			{{template "shared/ds/field" (dict "ID" "demo-bad" "Name" "bad" "Label" "Username" "Value" "maya" "Error" true "ErrorText" "That username is taken. Try another.")}}
			{{template "shared/ds/field" (dict "ID" "demo-pw" "Name" "pw" "Label" "Password" "Type" "password" "Reveal" true "LabelHref" "#" "LabelLink" "Forgot password?")}}
			<div class="ds-field"><label class="ds-label" for="demo-sel">Visibility</label><select class="ds-select" id="demo-sel"><option>Public</option><option>Private</option></select></div>
			<div class="ds-field"><label class="ds-label" for="demo-ta">Bio</label><textarea class="ds-textarea" id="demo-ta" rows="3"></textarea></div>
			<div class="ds-check"><input type="checkbox" id="demo-c1" checked><label for="demo-c1">Hide my email address</label></div>
			<label class="ds-switch"><input type="checkbox" role="switch" checked><span class="ds-switch-track"></span><span>Run checks on every push</span></label>
			<div class="ds-sticky-actions"><button class="ds-btn ds-btn-primary">Save changes</button><button class="ds-btn ds-btn-secondary">Discard</button></div>
		</div></section>

		<section class="ds-card"><div class="ds-card-h"><h2>List rows</h2></div>
			<ul class="ds-list">
				{{template "shared/ds/list_row" (dict "Owner" "acme" "Title" "payments-core" "Href" "#" "Chip" "Internal" "Sub" "Payment orchestration: authorisation, capture, refunds." "Meta1" "Rust" "Meta2" "3,812 changesets" "Meta3" "Updated 12 min ago" "StatValue" "4" "StatLabel" "open stacks")}}
				{{template "shared/ds/list_row" (dict "Owner" "northwind" "Title" "web-checkout" "Href" "#" "Chip" "Agent activity" "ChipTone" "agent" "Sub" "The hosted checkout, built for sub-second interactions." "Meta1" "TypeScript" "Meta2" "5,120 changesets")}}
				{{template "shared/ds/list_row" (dict "Title" "maya / dotfiles" "Href" "#" "Chip" "Public" "ChipTone" "ok")}}
			</ul>
		</section>

		<div class="ds-grid ds-grid-stats">
			{{template "shared/ds/stat" (dict "Label" "Open changes" "Value" "14" "Sub" "3 need you" "Href" "#")}}
			{{template "shared/ds/stat" (dict "Label" "Landed this week" "Value" "52")}}
			{{template "shared/ds/stat" (dict "Label" "Checks passing" "Value" "97%" "Sub" "last 7 days")}}
		</div>

		<section class="ds-card"><div class="ds-card-h"><h2>Table</h2></div>
			<div class="ds-table-wrap"><table class="ds-table"><thead><tr><th>Name</th><th>Status</th><th class="ds-r">Size</th></tr></thead><tbody>
				<tr><td data-label="Name">ledger</td><td data-label="Status"><span class="ds-chip ds-chip-ok">Healthy</span></td><td class="ds-r" data-label="Size">664 B</td></tr>
				<tr><td data-label="Name">stackdiff</td><td data-label="Status"><span class="ds-chip ds-chip-warn">Stale</span></td><td class="ds-r" data-label="Size">1.2 MB</td></tr>
			</tbody></table></div>
		</section>

		<div class="ds-banner ds-banner-ok" role="status">{{svg "dsi-check-circle" 18}}<div class="ds-banner-body">Settings saved.</div></div>
		<div class="ds-banner ds-banner-warn" role="status">{{svg "dsi-alert" 18}}<div class="ds-banner-body">This change is stale. Restack it before it can land.</div></div>
		<div class="ds-banner ds-banner-err" role="alert">{{svg "dsi-alert" 18}}<div class="ds-banner-body">The push was rejected by policy.</div></div>

		<section class="ds-card">
			{{template "shared/ds/empty" (dict "Icon" "book" "Title" "No repositories yet" "Body" "Create one, or import a project with its history." "PrimaryLabel" "New repository" "PrimaryHref" "#" "SecondaryLabel" "Import" "SecondaryHref" "#")}}
		</section>
		<section class="ds-card">
			{{template "shared/ds/empty" (dict "Icon" "alert" "Tone" "err" "Title" "We could not load this list" "Body" "Nothing was changed." "PrimaryLabel" "Try again" "PrimaryHref" "#")}}
		</section>

		<section class="ds-card"><div class="ds-card-h"><h2>Loading</h2></div><div class="ds-card-b ds-stack ds-stack-12">
			<div class="ds-sk" style="height:16px;width:60%"></div><div class="ds-sk" style="height:12px;width:90%"></div><div class="ds-sk" style="height:12px;width:40%"></div>
		</div></section>

		{{template "shared/ds/code_box" (dict "Title" "src/ledger/post.rs" "Meta" "rust" "Body" "fn post(entry: Entry) -> Result<Posted> {\n    validate(&entry)?;\n    store(entry)\n}")}}

		<div class="ds-diff" role="region" aria-label="Diff" tabindex="0">
			<div class="ds-l"><span class="ds-n">41</span><span>fn post(entry: Entry) {</span></div>
			<div class="ds-l ds-d"><span class="ds-n">42</span><span>-    store(entry)</span></div>
			<div class="ds-l ds-a"><span class="ds-n">42</span><span>+    validate(&amp;entry)?; store(entry)</span></div>
		</div>

		<div class="ds-term"><div class="ds-term-hd">Terminal</div><div class="ds-term-bd">$ asc clone {{AppUrl}}acme/ledger</div></div>
	</div>

	{{template "shared/ds/confirm" (dict "Data" . "ID" "demo-confirm" "Title" "Delete this repository?" "Body" "This cannot be undone. Everything in it is removed." "Action" "#" "Confirm" "Delete repository" "Danger" true)}}
</div>
{{template "base/footer" .}}
