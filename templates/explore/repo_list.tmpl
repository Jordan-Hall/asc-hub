{{/* A list of repositories (boards A8 and B4): one row per repository. Also used by profile, organization, subscription and admin pages. */}}
{{if .Repos}}
<ul class="ds-list ds-repolist">
	{{range .Repos}}
		{{$repo := .}}
		<li class="ds-li ds-repo-row">
			{{if and (or $.PageIsExplore $.PageIsProfileStarList) .Owner}}
				<a class="ds-repo-av" href="{{.Owner.HomeLink}}" tabindex="-1" aria-hidden="true">{{ctx.AvatarUtils.Avatar .Owner 48 "ds-avatar-org"}}</a>
			{{else}}
				<span class="ds-repo-av" aria-hidden="true">{{template "repo/icon" .}}</span>
			{{end}}
			<div class="ds-li-main">
				<div class="ds-li-title">
					<span class="ds-li-name">
						{{if and (or $.PageIsExplore $.PageIsProfileStarList) .Owner}}<a class="ds-li-owner" href="{{.Owner.HomeLink}}">{{.Owner.Name}}</a><span class="ds-li-owner" aria-hidden="true"> / </span><span class="ds-sr">/</span>{{end}}<a href="{{.Link}}">{{.Name}}</a>
					</span>
					{{if .IsArchived}}<span class="ds-chip">{{ctx.Locale.Tr "repo.desc.archived"}}</span>{{end}}
					{{if .IsPrivate}}
						<span class="ds-chip">{{ctx.Locale.Tr "repo.desc.private"}}</span>
					{{else if .Owner.Visibility.IsPrivate}}
						<span class="ds-chip ds-chip-info">{{ctx.Locale.Tr "repo.desc.internal"}}</span>
					{{else}}
						<span class="ds-chip ds-chip-ok">{{ctx.Locale.Tr "explore.public"}}</span>
					{{end}}
					{{if .IsTemplate}}<span class="ds-chip">{{ctx.Locale.Tr "repo.desc.template"}}</span>{{end}}
					{{if eq .ObjectFormatName "sha256"}}<span class="ds-chip">{{ctx.Locale.Tr "repo.desc.sha256"}}</span>{{end}}
				</div>
				{{$description := .DescriptionHTML $.Context}}
				{{if $description}}<div class="ds-li-sub ds-repo-desc">{{$description}}</div>{{end}}
				{{if .Topics}}
					<div class="ds-repo-topics">
						{{range .Topics}}{{if ne . ""}}<a class="ds-chip ds-chip-outline" href="{{AppSubUrl}}/explore/repos?q={{.}}&topic=1">{{.}}</a>{{end}}{{end}}
					</div>
				{{end}}
				<div class="ds-li-meta">
					{{if .PrimaryLanguage}}
						<a href="?q={{$.Keyword}}&sort={{$.SortType}}&language={{.PrimaryLanguage.Language}}{{if $.TabName}}&tab={{$.TabName}}{{end}}"><i class="ds-dot ds-lang-dot" style="background-color: {{.PrimaryLanguage.Color}}"></i>{{.PrimaryLanguage.Language}}</a>
					{{end}}
					{{if not $.DisableStars}}
						<a href="{{.Link}}/stars" aria-label="{{ctx.Locale.TrPluralString .NumStars "stars.n_stars" (printf "%d" .NumStars)}}"{{if ge .NumStars 1000}} data-tooltip-content="{{ctx.Locale.TrPluralString .NumStars "stars.n_stars" (ctx.Locale.PrettyNumber .NumStars)}}"{{end}}>{{svg "octicon-star" 14}}{{CountFmt .NumStars}}</a>
					{{end}}
					{{if not $.DisableForks}}
						<a href="{{.Link}}/forks" aria-label="{{ctx.Locale.TrPluralString .NumForks "fork.n_forks" (printf "%d" .NumForks)}}"{{if ge .NumForks 1000}} data-tooltip-content="{{ctx.Locale.TrPluralString .NumForks "fork.n_forks" (ctx.Locale.PrettyNumber .NumForks)}}"{{end}}>{{svg "octicon-repo-forked" 14}}{{CountFmt .NumForks}}</a>
					{{end}}
					{{$open := .NumOpenPulls $.Context}}
					{{if $open}}<span class="ds-only-mobile">{{ctx.Locale.TrPluralString $open "explore.open_stacks_n" (ctx.Locale.PrettyNumber $open)}}</span>{{end}}
					{{if $.AscRowChecks}}{{with index $.AscRowChecks .ID}}
						<a class="ds-repo-check" href="{{$repo.Link}}/commits/branch/{{PathEscapeSegments $repo.DefaultBranch}}" data-check="{{.State}}">{{if eq .State "passing"}}{{svg "octicon-check" 14}}{{ctx.Locale.Tr "explore.check_passing"}}{{else if eq .State "failing"}}{{svg "octicon-x" 14}}{{ctx.Locale.TrPluralString .Failing "explore.check_failing_n" (ctx.Locale.PrettyNumber .Failing)}}{{else if eq .State "running"}}{{svg "octicon-dot-fill" 14}}{{ctx.Locale.Tr "explore.check_running"}}{{else}}{{ctx.Locale.Tr "explore.check_none"}}{{end}}</a>
					{{end}}{{end}}
					<span>{{ctx.Locale.Tr "org.repo_updated" (DateUtils.TimeSince .UpdatedUnix)}}</span>
					{{if $.AscContributors}}{{with index $.AscContributors .ID}}
						{{$label := ctx.Locale.TrPluralString .Total "explore.contributors_n" (ctx.Locale.PrettyNumber .Total) $.AscContributorDays}}
						<span class="ds-av-stack ds-repo-contrib" role="group" aria-label="{{$label}}" title="{{$label}}" data-testid="repo-contributors">
							{{range .Users}}<a class="ds-av ds-av-24{{if .IsBot}} ds-av-agent{{end}}" href="{{.HomeLink}}" title="{{if .IsBot}}{{ctx.Locale.Tr "explore.contributor_agent" .GetDisplayName}}{{else}}{{.GetDisplayName}}{{end}}" aria-label="{{if .IsBot}}{{ctx.Locale.Tr "explore.contributor_agent" .GetDisplayName}}{{else}}{{.GetDisplayName}}{{end}}">{{ctx.AvatarUtils.Avatar . 24}}</a>{{end}}
						</span>
					{{end}}{{end}}
				</div>
			</div>
			{{if $open}}
				<div class="ds-li-aside ds-hide-md"><a class="ds-chip ds-chip-info" href="{{.Link}}/pulls">{{ctx.Locale.TrPluralString $open "explore.open_stacks_n" (ctx.Locale.PrettyNumber $open)}}</a></div>
			{{end}}
			{{if or AscEnabled (and $.IsSigned (not $.DisableStars) $.StarredRepos) (and $.IsSigned $.WatchedRepos)}}
			<div class="ds-row-acts{{if $.AscRowMenu}} has-row-menu{{end}}">
				{{if AscEnabled}}
				<button type="button" class="ds-btn ds-btn-ghost ds-btn-sm" data-clipboard-text="asc clone {{AscHubHost}}/{{.FullName}}" data-ds-toast-copied="{{ctx.Locale.Tr "asc_shell.clone_copied"}}" aria-label="{{ctx.Locale.Tr "asc_shell.row_copy_clone_for" .FullName}}">{{svg "dsi-copy" 16}}<span class="ds-row-act-text">{{ctx.Locale.Tr "asc_shell.row_copy_clone"}}</span></button>
				{{end}}
				{{if and $.IsSigned (not $.DisableStars) $.StarredRepos}}
					{{$starred := index $.StarredRepos .ID}}
					<form action="{{.Link}}/action/{{if $starred}}unstar{{else}}star{{end}}" method="post">
						{{$.CsrfTokenHtml}}
						<input type="hidden" name="redirect_to" value="{{$.CurrentURL}}">
						<button type="submit" class="ds-btn ds-btn-ghost ds-btn-sm" aria-pressed="{{if $starred}}true{{else}}false{{end}}" aria-label="{{if $starred}}{{ctx.Locale.Tr "repo.unstar"}}{{else}}{{ctx.Locale.Tr "repo.star"}}{{end}} {{.FullName}}">{{if $starred}}{{svg "octicon-star-fill" 14}}{{else}}{{svg "octicon-star" 14}}{{end}} {{if $starred}}{{ctx.Locale.Tr "repo.unstar"}}{{else}}{{ctx.Locale.Tr "repo.star"}}{{end}}</button>
					</form>
				{{end}}
				{{if and $.IsSigned $.WatchedRepos}}
					{{$watching := index $.WatchedRepos .ID}}
					<form action="{{.Link}}/action/{{if $watching}}unwatch{{else}}watch{{end}}" method="post" data-testid="row-watch">
						{{$.CsrfTokenHtml}}
						<input type="hidden" name="redirect_to" value="{{$.CurrentURL}}">
						<button type="submit" class="ds-btn ds-btn-ghost ds-btn-sm" aria-pressed="{{if $watching}}true{{else}}false{{end}}" aria-label="{{if $watching}}{{ctx.Locale.Tr "explore.unwatch_repo" .FullName}}{{else}}{{ctx.Locale.Tr "explore.watch_repo" .FullName}}{{end}}">{{svg "octicon-eye" 14}} {{if $watching}}{{ctx.Locale.Tr "repo.unwatch"}}{{else}}{{ctx.Locale.Tr "repo.watch"}}{{end}} <span class="ds-row-act-count" data-watch-count>{{CountFmt .NumWatches}}</span></button>
					</form>
				{{end}}
				</div>
				{{if $.AscRowMenu}}
				{{/* on a phone the same actions sit in the row menu */}}
				<details class="wk-menu ds-row-menu" data-asc-row-menu>
					<summary class="ds-btn ds-btn-ghost ds-btn-icon" aria-label="{{ctx.Locale.Tr "asc_shell.row_menu_for" .FullName}}">{{svg "dsi-dots" 18}}</summary>
					<div class="wk-menu-list" role="group" aria-label="{{ctx.Locale.Tr "asc_shell.row_menu_for" .FullName}}">
						{{if AscEnabled}}
						<button type="button" class="wk-menu-item" data-clipboard-text="asc clone {{AscHubHost}}/{{.FullName}}" data-ds-toast-copied="{{ctx.Locale.Tr "asc_shell.clone_copied"}}">{{ctx.Locale.Tr "asc_shell.row_copy_clone"}}</button>
						{{end}}
						{{if and $.IsSigned (not $.DisableStars) $.StarredRepos}}
							{{$starred := index $.StarredRepos .ID}}
							<form action="{{.Link}}/action/{{if $starred}}unstar{{else}}star{{end}}" method="post">
								{{$.CsrfTokenHtml}}
								<input type="hidden" name="redirect_to" value="{{$.CurrentURL}}">
								<button type="submit" class="wk-menu-item" aria-pressed="{{if $starred}}true{{else}}false{{end}}">{{if $starred}}{{ctx.Locale.Tr "repo.unstar"}}{{else}}{{ctx.Locale.Tr "repo.star"}}{{end}}</button>
							</form>
						{{end}}
						{{if and $.IsSigned $.WatchedRepos}}
							{{$watching := index $.WatchedRepos .ID}}
							<form action="{{.Link}}/action/{{if $watching}}unwatch{{else}}watch{{end}}" method="post">
								{{$.CsrfTokenHtml}}
								<input type="hidden" name="redirect_to" value="{{$.CurrentURL}}">
								<button type="submit" class="wk-menu-item" aria-pressed="{{if $watching}}true{{else}}false{{end}}">{{if $watching}}{{ctx.Locale.Tr "repo.unwatch"}}{{else}}{{ctx.Locale.Tr "repo.watch"}}{{end}}</button>
							</form>
						{{end}}
					</div>
				</details>
				{{end}}
			{{end}}
		</li>
	{{end}}
</ul>
{{else}}
<div class="ds-card"{{if .ExploreLoadFailed}} role="alert"{{end}}>
	{{if .ExploreLoadFailed}}
		{{template "shared/ds/empty" (dict "Icon" "alert" "Tone" "err" "Title" (ctx.Locale.Tr "asc_shell.list_failed_title") "Body" (ctx.Locale.Tr "asc_shell.list_failed_text" .RequestID) "PrimaryHref" .ExploreRetryHref "PrimaryLabel" (ctx.Locale.Tr "asc_shell.try_again") "SecondaryHref" (print AppSubUrl "/-/status") "SecondaryLabel" (ctx.Locale.Tr "asc_err.status_page"))}}
	{{else if or .Keyword .Language .AscQuickLabel}}
		{{$active := 0}}{{if .Keyword}}{{$active = Eval $active "+" 1}}{{end}}{{if .Language}}{{$active = Eval $active "+" 1}}{{end}}{{if .AscQuickLabel}}{{$active = Eval $active "+" 1}}{{end}}
		<div class="ds-empty" data-asc-explore-nomatch>
			<div class="ds-empty-ic" aria-hidden="true">{{svg "dsi-search" 34}}</div>
			<h2>{{if .Keyword}}{{ctx.Locale.Tr "asc_shell.nomatch_title" .Keyword}}{{else}}{{ctx.Locale.Tr "asc_shell.nomatch_title_filters"}}{{end}}</h2>
			<p>{{if gt $active 1}}{{ctx.Locale.Tr "asc_shell.nomatch_text_n" $active}}{{else}}{{ctx.Locale.Tr "asc_shell.nomatch_text_1" 1}}{{end}}</p>
			{{template "shared/ds/active_filters" (dict "Keyword" .Keyword "Language" .Language "Quick" .AscQuickLabel "Sort" .SortType "NoClear" true)}}
			<div class="ds-empty-acts"><a class="ds-btn ds-btn-primary" href="?sort={{QueryEscape .SortType}}">{{ctx.Locale.Tr "asc_shell.filters_clear"}}</a></div>
		</div>
	{{else if and .IsSigned .PageIsExplore}}
		{{template "shared/ds/empty" (dict "Icon" "book" "Title" (ctx.Locale.Tr "asc_shell.norepos_title") "Body" (ctx.Locale.Tr "asc_shell.norepos_text") "PrimaryHref" (print AppSubUrl "/repo/create") "PrimaryLabel" (ctx.Locale.Tr "new_repo.link") "SecondaryHref" (print AppSubUrl "/repo/migrate") "SecondaryLabel" (ctx.Locale.Tr "asc_shell.norepos_import"))}}
	{{else if .PageIsExplore}}
		{{template "shared/ds/empty" (dict "Icon" "book" "Title" (ctx.Locale.Tr "asc_shell.norepos_title") "Body" (ctx.Locale.Tr "asc_shell.norepos_text"))}}
	{{else}}
		{{template "shared/ds/empty" (dict "Icon" "search" "Title" (ctx.Locale.Tr "explore.no_repos_title") "Body" (ctx.Locale.Tr "search.no_results"))}}
	{{end}}
</div>
{{end}}
