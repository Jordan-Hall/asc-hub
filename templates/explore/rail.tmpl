{{/* The right rail of the repository list (from 1024 on): how to clone what is listed, with the asc command. */}}
{{with index .Repos 0}}
<aside class="ds-rail ds-only-desktop" aria-label="{{ctx.Locale.Tr "explore.clone_title"}}">
	<div class="ds-callout ds-rail-clone">
		<h2 class="ds-t-h4">{{ctx.Locale.Tr "explore.clone_title"}}</h2>
		<p class="ds-t-small ds-c-2 ds-mt-8">{{ctx.Locale.Tr "explore.clone_lead"}}</p>
		<div class="ds-cmd ds-mt-12"><span class="ds-pr" aria-hidden="true">$</span><code>asc clone {{AscHubHost}}/{{.FullName}}</code><button type="button" class="ds-copy" data-clipboard-text="asc clone {{AscHubHost}}/{{.FullName}}">{{svg "dsi-copy" 14}} {{ctx.Locale.Tr "asc_download.copy"}}</button></div>
	</div>
</aside>
{{end}}
{{if .PopularTopics}}
<aside class="ds-rail ds-only-desktop" aria-label="{{ctx.Locale.Tr "explore.popular_topics"}}">
	<div class="ds-callout">
		<h2 class="ds-t-h4">{{ctx.Locale.Tr "explore.popular_topics"}}</h2>
		<div class="ds-rail-topics">
			{{range .PopularTopics}}<a class="ds-chip ds-chip-outline" href="{{AppSubUrl}}/explore/repos?q={{QueryEscape .}}&topic=1">{{.}}</a>{{end}}
		</div>
	</div>
</aside>
{{end}}
{{if .TrendingRepos}}
<aside class="ds-rail ds-only-desktop" aria-label="{{ctx.Locale.Tr "explore.trending"}}">
	<div class="ds-callout">
		<h2 class="ds-t-h4">{{ctx.Locale.Tr "explore.trending"}}</h2>
		<ol class="ds-rail-trend">
			{{range .TrendingRepos}}
				<li><a href="{{.Repo.Link}}">{{.Repo.FullName}}</a><span class="ds-hint">{{ctx.Locale.Tr "explore.trending_n" .Count}}</span></li>
			{{end}}
		</ol>
	</div>
</aside>
{{end}}
