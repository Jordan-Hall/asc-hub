{{/* A list of people or organizations (boards A9 and A10). Also used by the admin user page. */}}
{{if .Users}}
<ul class="ds-list ds-userlist">
	{{range .Users}}
		<li class="ds-li ds-user-row">
			<a class="ds-user-av" href="{{.HomeLink}}" tabindex="-1" aria-hidden="true">{{if .IsOrganization}}{{ctx.AvatarUtils.Avatar . 48 "ds-avatar-org"}}{{else}}{{ctx.AvatarUtils.Avatar . 48}}{{end}}</a>
			<div class="ds-li-main">
				<div class="ds-li-title">
					<a href="{{.HomeLink}}">{{.Name}}</a>
					{{if .FullName}}<span class="ds-li-owner ds-hide-xs">{{.FullName}}</span>{{end}}
					{{if and $.AscVerifiedOrgs (index $.AscVerifiedOrgs .ID)}}<span class="ds-chip ds-chip-ok">{{svg "dsi-shield-check" 14}} {{ctx.Locale.Tr "asc_work.org_verified"}}</span>{{end}}
					{{if .Visibility.IsPrivate}}<span class="ds-chip">{{ctx.Locale.Tr "repo.desc.private"}}</span>{{end}}
				</div>
				{{if .Description}}<div class="ds-li-sub ds-clamp-2">{{.Description}}</div>{{end}}
				<div class="ds-li-meta">
					{{if .Location}}<span>{{svg "octicon-location" 14}}{{.Location}}</span>{{end}}
					{{if and .Email (or (and $.ShowUserEmail $.IsSigned (not .KeepEmailPrivate)) $.PageIsAdminUsers)}}
						<span>{{svg "octicon-mail" 14}}<a href="mailto:{{.Email}}">{{.Email}}</a></span>
					{{end}}
					<span>{{svg "octicon-calendar" 14}}{{ctx.Locale.Tr "user.joined_on" (DateUtils.AbsoluteShort .CreatedUnix)}}</span>
				</div>
			</div>
			{{if .IsOrganization}}
				<div class="ds-li-stats ds-hide-xs">
					<div class="ds-li-stat"><b>{{.NumRepos}}</b><span>{{ctx.Locale.Tr "explore.stat_repos"}}</span></div>
					<div class="ds-li-stat"><b>{{.NumMembers}}</b><span>{{ctx.Locale.Tr "explore.stat_people"}}</span></div>
				</div>
			{{else}}
				<div class="ds-li-stats ds-hide-xs">
					<div class="ds-li-stat"><b>{{.NumRepos}}</b><span>{{ctx.Locale.Tr "explore.stat_repos"}}</span></div>
					<div class="ds-li-stat"><b>{{.NumFollowers}}</b><span>{{ctx.Locale.Tr "explore.stat_followers"}}</span></div>
				</div>
			{{end}}
		</li>
	{{end}}
</ul>
{{else}}
<div class="ds-card">
	{{if .Keyword}}
		{{template "shared/ds/empty" (dict "Icon" "search" "Title" (ctx.Locale.Tr "explore.no_users_title") "Body" (ctx.Locale.Tr "search.no_results") "PrimaryHref" "?" "PrimaryLabel" (ctx.Locale.Tr "asc_shell.filters_clear"))}}
	{{else}}
		{{template "shared/ds/empty" (dict "Icon" "search" "Title" (ctx.Locale.Tr "explore.no_users_title") "Body" (ctx.Locale.Tr "search.no_results"))}}
	{{end}}
</div>
{{end}}
