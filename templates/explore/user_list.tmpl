{{/* A list of people or organizations (boards A9 and A10). Also used by the admin user page. */}}
{{if .Users}}
<ul class="ds-list ds-userlist">
	{{range .Users}}
		<li class="ds-li ds-user-row">
			<a class="ds-user-av" href="{{.HomeLink}}" tabindex="-1" aria-hidden="true">{{if .IsOrganization}}{{ctx.AvatarUtils.Avatar . 48 "ds-avatar-org"}}{{else}}{{ctx.AvatarUtils.Avatar . 48}}{{end}}</a>
			<div class="ds-li-main">
				<div class="ds-li-title">
					<a href="{{.HomeLink}}">{{.Name}}</a>
					{{if .FullName}}<span class="ds-li-owner ds-hide-xs">{{.FullName}}</span>{{end}}
					{{if and $.AscVerifiedOrgs (index $.AscVerifiedOrgs .ID)}}<span class="ds-chip ds-chip-ok">{{svg "dsi-shield-check" 14}} {{ctx.Locale.Tr "asc_work.org_verified"}}</span>{{end}}
					{{if .Visibility.IsPrivate}}<span class="ds-chip">{{ctx.Locale.Tr "repo.desc.private"}}</span>{{end}}
					{{if .IsBot}}<span class="ds-chip ds-chip-agent" data-testid="user-agent-chip">{{ctx.Locale.Tr "explore.agent_chip"}}</span>{{else if $.ExploreRoles}}{{with index $.ExploreRoles .ID}}<span class="ds-chip{{if eq . "owner"}} ds-chip-info{{else if eq . "maintainer"}} ds-chip-ok{{end}}" data-testid="user-role-chip" data-role="{{.}}">{{ctx.Locale.Tr (print "explore.role_" .)}}</span>{{end}}{{end}}
				</div>
				{{if .Description}}<div class="ds-li-sub ds-clamp-2">{{.Description}}</div>{{end}}
				<div class="ds-li-meta">
					{{if .Location}}<span>{{svg "dsi-map-pin" 14}}{{.Location}}</span>{{end}}
					<span>{{svg "dsi-calendar" 14}}{{ctx.Locale.Tr "user.joined_on" (DateUtils.AbsoluteShort .CreatedUnix)}}</span>
					{{with and $.ExploreUserOrgs (index $.ExploreUserOrgs .ID)}}<span data-asc-user-orgs><span class="tw-sr-only">{{ctx.Locale.Tr "asc_shell.user_orgs"}}</span>{{svg "dsi-building" 14}}{{range $i, $o := .}}{{if $i}}, {{end}}<a href="{{$o.HomeLink}}">{{$o.Name}}</a>{{end}}</span>{{end}}
					{{if .IsOrganization}}{{with and $.ExploreActivity (index $.ExploreActivity .ID)}}{{if .Last}}<span data-asc-org-active>{{svg "dsi-clock" 14}}{{ctx.Locale.Tr "explore.org_active_ago" (DateUtils.TimeSince .Last)}}</span>{{end}}{{end}}{{end}}
					{{if and .Email (or (and $.ShowUserEmail $.IsSigned (not .KeepEmailPrivate)) $.PageIsAdminUsers)}}
						<span data-asc-user-email><span class="tw-sr-only">{{ctx.Locale.Tr "asc_shell.user_email"}}</span>{{svg "dsi-mail" 14}}<a href="mailto:{{.Email}}">{{.Email}}</a></span>
					{{end}}
				</div>
			</div>
			{{if .IsOrganization}}
				<div class="ds-li-stats ds-hide-xs">
					{{template "explore/asc_activity" (dict "A" (and $.ExploreActivity (index $.ExploreActivity .ID)) "Weeks" $.ExploreActivityWeeks)}}
					<div class="ds-li-stat"><b>{{.NumRepos}}</b><span>{{ctx.Locale.Tr "explore.stat_repos"}}</span></div>
					<div class="ds-li-stat"><b>{{.NumMembers}}</b><span>{{ctx.Locale.Tr "explore.stat_people"}}</span></div>
					{{if $.ExploreOrgAgents}}{{with index $.ExploreOrgAgents .ID}}<div class="ds-li-stat" data-asc-org-agents><b>{{ctx.Locale.PrettyNumber .}}</b><span>{{ctx.Locale.Tr "explore.stat_agents"}}</span></div>{{end}}{{end}}
					{{if $.ExploreOrgMembers}}{{with index $.ExploreOrgMembers .ID}}
						{{$label := ctx.Locale.TrPluralString .Total "explore.org_members_n" (ctx.Locale.PrettyNumber .Total)}}
						<span class="ds-av-stack ds-org-members" role="group" aria-label="{{$label}}" title="{{$label}}" data-asc-org-members>
							{{range .Users}}<a class="ds-av ds-av-24{{if .IsBot}} ds-av-agent{{end}}" href="{{.HomeLink}}" title="{{.GetDisplayName}}" aria-label="{{.GetDisplayName}}">{{ctx.AvatarUtils.Avatar . 24}}</a>{{end}}
							{{if .More}}<span class="ds-av ds-av-24 ds-av-more" aria-hidden="true">{{ctx.Locale.Tr "explore.org_members_more" (ctx.Locale.PrettyNumber .More)}}</span>{{end}}
						</span>
					{{end}}{{end}}
				</div>
			{{else}}
				<div class="ds-li-stats ds-hide-xs">
					{{$act := and $.ExploreActivity (index $.ExploreActivity .ID)}}
					{{template "explore/asc_activity" (dict "A" $act "Weeks" $.ExploreActivityWeeks)}}
					{{if $act}}
					<div class="ds-li-stat" data-asc-user-changesets><b>{{ctx.Locale.PrettyNumber $act.Changesets}}</b><span>{{ctx.Locale.Tr "explore.stat_changesets"}}</span></div>
					<div class="ds-li-stat" data-asc-user-reviews><b>{{ctx.Locale.PrettyNumber $act.Reviews}}</b><span>{{ctx.Locale.Tr "explore.stat_reviews"}}</span></div>
					{{end}}
					<div class="ds-li-stat"><b>{{.NumRepos}}</b><span>{{ctx.Locale.Tr "explore.stat_repos"}}</span></div>
					<div class="ds-li-stat"><b>{{.NumFollowers}}</b><span>{{ctx.Locale.Tr "explore.stat_followers"}}</span></div>
				</div>
			{{end}}
			{{if and $.ExploreFollowing (not .IsOrganization) (ne .ID $.SignedUserID)}}
			{{$following := index $.ExploreFollowing .ID}}
			<div class="ds-row-acts">
				<form method="post" action="{{.HomeLink}}?action={{if $following}}unfollow{{else}}follow{{end}}">
					{{$.CsrfTokenHtml}}
					<input type="hidden" name="redirect_to" value="{{$.CurrentURL}}">
					<button type="submit" class="ds-btn {{if $following}}ds-btn-ghost{{else}}ds-btn-secondary{{end}} ds-btn-sm" aria-pressed="{{if $following}}true{{else}}false{{end}}" aria-label="{{if $following}}{{ctx.Locale.Tr "asc_shell.row_unfollow_for" .Name}}{{else}}{{ctx.Locale.Tr "asc_shell.row_follow_for" .Name}}{{end}}">{{if $following}}{{ctx.Locale.Tr "user.unfollow"}}{{else}}{{ctx.Locale.Tr "user.follow"}}{{end}}</button>
				</form>
			</div>
			{{end}}
			{{if .IsOrganization}}
			<div class="ds-row-acts"><a class="ds-btn ds-btn-ghost ds-btn-sm" href="{{.HomeLink}}" aria-label="{{ctx.Locale.Tr "asc_shell.row_view_for" .Name}}">{{ctx.Locale.Tr "asc_shell.row_view"}}</a></div>
			{{end}}
		</li>
	{{end}}
</ul>
{{else}}
<div class="ds-card"{{if .ExploreLoadFailed}} role="alert"{{end}}>
	{{if .ExploreLoadFailed}}
		{{template "shared/ds/empty" (dict "Icon" "alert" "Tone" "err" "Title" (ctx.Locale.Tr "asc_shell.list_failed_title") "Body" (ctx.Locale.Tr "asc_shell.list_failed_text" .RequestID) "PrimaryHref" .ExploreRetryHref "PrimaryLabel" (ctx.Locale.Tr "asc_shell.try_again") "SecondaryHref" (print AppSubUrl "/-/status") "SecondaryLabel" (ctx.Locale.Tr "asc_err.status_page"))}}
	{{else if and .Keyword .PageIsExplore}}
		<div class="ds-empty" data-asc-explore-nomatch>
			<div class="ds-empty-ic" aria-hidden="true">{{svg "dsi-search" 34}}</div>
			<h2>{{ctx.Locale.Tr "asc_shell.nomatch_title" .Keyword}}</h2>
			<p>{{ctx.Locale.Tr "asc_shell.nomatch_text_1" 1}}</p>
			{{template "shared/ds/active_filters" (dict "Keyword" .Keyword "Language" "" "Sort" .SortType "NoClear" true)}}
			<div class="ds-empty-acts"><a class="ds-btn ds-btn-primary" href="?sort={{QueryEscape .SortType}}">{{ctx.Locale.Tr "asc_shell.filters_clear"}}</a></div>
		</div>
	{{else if .Keyword}}
		{{template "shared/ds/empty" (dict "Icon" "search" "Title" (ctx.Locale.Tr "explore.no_users_title") "Body" (ctx.Locale.Tr "search.no_results") "PrimaryHref" "?" "PrimaryLabel" (ctx.Locale.Tr "asc_shell.filters_clear"))}}
	{{else if and .PageIsExploreUsers .ExploreUsersFiltered}}
		<div data-asc-users-filtered-none>
		{{template "shared/ds/empty" (dict "Icon" "search" "Title" (ctx.Locale.Tr "explore.filtered_none_title") "Body" (ctx.Locale.Tr "explore.filtered_none_text") "PrimaryHref" (print "?sort=" (QueryEscape .SortType)) "PrimaryLabel" (ctx.Locale.Tr "asc_shell.filters_clear"))}}
		</div>
	{{else if .PageIsExploreUsers}}
		{{template "shared/ds/empty" (dict "Icon" "users" "Title" (ctx.Locale.Tr "asc_shell.nopeople_title") "Body" (ctx.Locale.Tr "asc_shell.nopeople_text"))}}
	{{else if and .PageIsExploreOrganizations .ExploreOrgsFiltered}}
		<div data-asc-orgs-filtered-none>
		{{template "shared/ds/empty" (dict "Icon" "search" "Title" (ctx.Locale.Tr "explore.orgs_filtered_none_title") "Body" (ctx.Locale.Tr "explore.orgs_filtered_none_text") "PrimaryHref" (print "?sort=" (QueryEscape .SortType)) "PrimaryLabel" (ctx.Locale.Tr "asc_shell.filters_clear"))}}
		</div>
	{{else if .PageIsExploreOrganizations}}
		<div data-asc-orgs-empty>
		{{if and .IsSigned .SignedUser.CanCreateOrganization}}
			{{template "shared/ds/empty" (dict "Icon" "building" "Title" (ctx.Locale.Tr "asc_shell.noorgs_title") "Body" (ctx.Locale.Tr "asc_shell.noorgs_text") "PrimaryHref" (print AppSubUrl "/org/create") "PrimaryLabel" (ctx.Locale.Tr "new_org.link"))}}
		{{else}}
			{{template "shared/ds/empty" (dict "Icon" "building" "Title" (ctx.Locale.Tr "asc_shell.noorgs_title") "Body" (ctx.Locale.Tr "asc_shell.noorgs_text"))}}
		{{end}}
		</div>
	{{else}}
		{{template "shared/ds/empty" (dict "Icon" "search" "Title" (ctx.Locale.Tr "explore.no_users_title") "Body" (ctx.Locale.Tr "search.no_results"))}}
	{{end}}
</div>
{{end}}
