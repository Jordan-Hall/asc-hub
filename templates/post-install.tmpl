{{template "base/head" .}}
<header class="ds-hdr ds-hdr-lg ins-bar" role="banner">
	<div class="ds-topbar ds-topbar-static">
		<a class="ds-brand" href="{{AppSubUrl}}/" aria-label="{{ctx.Locale.Tr "home"}}">{{template "base/brand_tile" .}}<span>{{AppName}}</span></a>
		<span class="ins-bar-sub">{{ctx.Locale.Tr "asc_install.bar"}}</span>
	</div>
</header>
<div role="main" aria-label="{{.Title}}" class="page-content install post-install ds-main ins">
	<div class="ds-container st-wrap">
		<section class="st-card" aria-labelledby="ins-post-h" aria-live="polite">
			<h1 class="ds-t-h2" id="ins-post-h">{{ctx.Locale.Tr "asc_install.post_h"}}</h1>
			<p class="st-text">{{ctx.Locale.Tr "asc_install.post_t"}}</p>
			<progress class="ds-bar ins-wait" aria-label="{{ctx.Locale.Tr "asc_install.post_h"}}"></progress>
			<div class="st-actions">
				<a class="ds-btn ds-btn-primary" id="goto-user-login" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "asc_install.post_link"}}</a>
			</div>
		</section>
	</div>
</div>
{{template "base/footer" .}}
