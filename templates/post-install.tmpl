{{/* Post-install page (board Install, "Done: post-install"). It is rendered ready; install.js shows the waiting state, the install progress with its first three steps done and the merge queue starting, and polls data-ins-poll until the hub answers, then shows the ready state again. */}}
{{template "base/head" .}}
<header class="ds-hdr ds-hdr-lg ins-bar" role="banner">
	<div class="ds-topbar ds-topbar-static">
		<a class="ds-brand" href="{{AppSubUrl}}/" aria-label="{{ctx.Locale.Tr "home"}}">{{template "base/brand_tile" .}}<span>{{AppName}}</span></a>
		<span class="ins-bar-sub">{{ctx.Locale.Tr "asc_install.bar"}}</span>
	</div>
</header>
<div role="main" aria-label="{{.Title}}" class="page-content install post-install ds-main ins">
	<div class="ds-container st-wrap">
		<section class="st-card ins-done" aria-live="polite" data-ins-poll="{{AppSubUrl}}/user/login">
			<div class="ds-stack ds-stack-8" data-ins-wait hidden>
				<h1 class="ds-t-h3" tabindex="-1">{{ctx.Locale.Tr "asc_install.post_h"}}</h1>
				{{template "install_progress" dict "Done" 3}}
			</div>
			<div class="ds-stack ds-stack-16" data-ins-ready data-testid="post-install-connect">
				<div>
					<h1 class="ds-t-h2" tabindex="-1">{{ctx.Locale.Tr "asc_install.ready_h"}}</h1>
					<p class="st-text">{{if .AscSignedInAs}}{{ctx.Locale.Tr "asc_install.ready_signed_in" .AscSignedInAs}}{{else}}{{ctx.Locale.Tr "asc_install.ready_no_admin"}}{{end}}</p>
				</div>
				<div class="ds-cmd ds-cmd-scroll"><span class="ds-pr" aria-hidden="true">$</span><code tabindex="0">{{.AscConnectCommand}}</code><button type="button" class="ds-copy" data-ds-toast-copied="{{ctx.Locale.Tr "asc_download.copied_toast"}}" data-clipboard-text="{{.AscConnectCommand}}">{{svg "dsi-copy" 14}} {{ctx.Locale.Tr "asc_download.copy"}}</button></div>
				<div class="st-actions">
					<a class="ds-btn ds-btn-primary" href="{{AppSubUrl}}/">{{ctx.Locale.Tr "asc_install.ready_open"}}</a>
					<a class="ds-btn ds-btn-secondary" href="{{AppSubUrl}}/download">{{ctx.Locale.Tr "asc_install.post_download"}}</a>
				</div>
			</div>
		</section>
	</div>
</div>
{{template "base/footer" .}}
