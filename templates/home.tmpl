{{/*
The landing page (board A3, Main and Mobile-Landing). Signed out visitors see it at "/"; a signed in person with nothing to show sees the same page without the account buttons.
Sections: hero with the install command, the tools strip, why, three benefits, three steps, agents, search and compatibility, download, public repositories, call to action. Mobile first (see web_src/css/asc-ds/landing.css).
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{if .IsSigned}}{{ctx.Locale.Tr "dashboard"}}{{else}}{{ctx.Locale.Tr "home"}}{{end}}" class="ds-main ds-land home">
	<section class="ds-land-hero" aria-labelledby="hub-hero-title">
		<div class="ds-container">
			<p class="ds-land-pill"><i aria-hidden="true"></i>{{ctx.Locale.Tr "startpage.pill"}}</p>
			<h1 class="ds-land-title" id="hub-hero-title">{{ctx.Locale.Tr "startpage.headline"}}</h1>
			<p class="ds-land-lead">{{ctx.Locale.Tr "startpage.lead"}}</p>
			{{if not .IsSigned}}
				<div class="ds-land-actions">
					{{if .AscDownload}}<a class="ds-btn ds-btn-accent" href="#download">{{ctx.Locale.Tr "asc_download.home_cta"}}</a>{{end}}
					{{if .ShowRegistrationButton}}
						<a class="ds-btn {{if .AscDownload}}ds-btn-ondark-outline{{else}}ds-btn-accent{{end}}" href="{{AppSubUrl}}/user/sign_up">{{ctx.Locale.Tr "asc_shell.create_account"}}</a>
					{{end}}
					<a class="ds-btn ds-btn-ondark-outline" rel="nofollow" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "sign_in"}}</a>
				</div>
			{{end}}
			<div class="ds-land-install" role="group" aria-label="{{ctx.Locale.Tr "startpage.connect_label"}}">
				<div class="ds-cmd ds-cmd-scroll"><span class="ds-pr" aria-hidden="true">$</span><code tabindex="0">asc auth login --host {{.AscHubURL}} --prompt</code><button type="button" class="ds-copy" data-clipboard-text="asc auth login --host {{.AscHubURL}} --prompt">{{svg "dsi-copy" 14}} {{ctx.Locale.Tr "asc_download.copy"}}</button></div>
			</div>
		</div>
	</section>

	<section class="ds-land-strip" aria-label="{{ctx.Locale.Tr "startpage.works_with"}}">
		<div class="ds-container ds-land-strip-in">
			<p>{{ctx.Locale.Tr "startpage.works_with"}}</p>
			<ul>
				<li>VS Code</li>
				<li>JetBrains</li>
				<li>Claude Code</li>
				<li>Cursor</li>
				<li>MCP</li>
			</ul>
		</div>
	</section>

	<section class="ds-land-sec" aria-labelledby="asc-why-title">
		<div class="ds-container">
			<p class="ds-t-eyebrow">{{ctx.Locale.Tr "startpage.why_eyebrow"}}</p>
			<h2 class="ds-land-h2" id="asc-why-title">{{ctx.Locale.Tr "startpage.why_title"}}</h2>
			<p class="ds-land-p">{{ctx.Locale.Tr "startpage.why_text"}}</p>
			<div class="ds-land-cards" aria-label="{{ctx.Locale.Tr "startpage.benefits_label"}}">
				<article class="ds-land-card">
					<span class="ds-land-ic" aria-hidden="true">{{svg "dsi-layers" 20}}</span>
					<h3>{{ctx.Locale.Tr "startpage.benefit1_title"}}</h3>
					<p>{{ctx.Locale.Tr "startpage.benefit1_text"}}</p>
				</article>
				<article class="ds-land-card">
					<span class="ds-land-ic" aria-hidden="true">{{svg "dsi-message" 20}}</span>
					<h3>{{ctx.Locale.Tr "startpage.benefit2_title"}}</h3>
					<p>{{ctx.Locale.Tr "startpage.benefit2_text"}}</p>
				</article>
				<article class="ds-land-card">
					<span class="ds-land-ic" aria-hidden="true">{{svg "dsi-inbox" 20}}</span>
					<h3>{{ctx.Locale.Tr "startpage.benefit3_title"}}</h3>
					<p>{{ctx.Locale.Tr "startpage.benefit3_text"}}</p>
				</article>
			</div>
		</div>
	</section>

	<section class="ds-land-sec ds-land-sec-tint" aria-labelledby="asc-how-title">
		<div class="ds-container">
			<p class="ds-t-eyebrow">{{ctx.Locale.Tr "startpage.how_eyebrow"}}</p>
			<h2 class="ds-land-h2" id="asc-how-title">{{ctx.Locale.Tr "startpage.how_title"}}</h2>
			<ol class="ds-land-steps">
				<li class="ds-land-step">
					<span class="ds-land-num" aria-hidden="true">1</span>
					<h3>{{ctx.Locale.Tr "startpage.step1_title"}}</h3>
					<p>{{ctx.Locale.Tr "startpage.step1_text"}}</p>
					<div class="ds-cmd ds-cmd-scroll"><span class="ds-pr" aria-hidden="true">$</span><code tabindex="0">asc auth login --host {{.AscHubURL}} --prompt</code></div>
				</li>
				<li class="ds-land-step">
					<span class="ds-land-num" aria-hidden="true">2</span>
					<h3>{{ctx.Locale.Tr "startpage.step2_title"}}</h3>
					<p>{{ctx.Locale.Tr "startpage.step2_text"}}</p>
					<div class="ds-cmd ds-cmd-scroll"><span class="ds-pr" aria-hidden="true">$</span><code tabindex="0">asc clone {{.AscHubURL}}/OWNER/REPOSITORY</code></div>
				</li>
				<li class="ds-land-step">
					<span class="ds-land-num" aria-hidden="true">3</span>
					<h3>{{ctx.Locale.Tr "startpage.step3_title"}}</h3>
					<p>{{ctx.Locale.Tr "startpage.step3_text"}}</p>
					<div class="ds-cmd ds-cmd-scroll"><span class="ds-pr" aria-hidden="true">$</span><code tabindex="0">asc submit --publish</code></div>
				</li>
			</ol>
		</div>
	</section>

	<section class="ds-land-sec ds-land-sec-dark" aria-labelledby="asc-agents-title">
		<div class="ds-container ds-land-split">
			<div>
				<p class="ds-t-eyebrow ds-land-eyebrow-dark">{{ctx.Locale.Tr "startpage.agents_eyebrow"}}</p>
				<h2 class="ds-land-h2" id="asc-agents-title">{{ctx.Locale.Tr "startpage.agents_title"}}</h2>
				<p class="ds-land-p">{{ctx.Locale.Tr "startpage.agents_text"}}</p>
			</div>
			<ul class="ds-land-mini">
				<li><h3>{{ctx.Locale.Tr "startpage.agents_scope_title"}}</h3><p>{{ctx.Locale.Tr "startpage.agents_scope_text"}}</p></li>
				<li><h3>{{ctx.Locale.Tr "startpage.agents_budget_title"}}</h3><p>{{ctx.Locale.Tr "startpage.agents_budget_text"}}</p></li>
				<li><h3>{{ctx.Locale.Tr "startpage.agents_checkpoint_title"}}</h3><p>{{ctx.Locale.Tr "startpage.agents_checkpoint_text"}}</p></li>
				<li><h3>{{ctx.Locale.Tr "startpage.agents_audit_title"}}</h3><p>{{ctx.Locale.Tr "startpage.agents_audit_text"}}</p></li>
			</ul>
		</div>
	</section>

	<section class="ds-land-sec" aria-label="{{ctx.Locale.Tr "startpage.git_label"}}">
		<div class="ds-container">
			<div class="ds-land-cards ds-land-cards-2">
				<article class="ds-land-card">
					<p class="ds-t-eyebrow">{{ctx.Locale.Tr "startpage.search_eyebrow"}}</p>
					<h3>{{ctx.Locale.Tr "startpage.search_title"}}</h3>
					<p>{{ctx.Locale.Tr "startpage.search_text"}}</p>
				</article>
				<article class="ds-land-card">
					<p class="ds-t-eyebrow">{{ctx.Locale.Tr "startpage.git_eyebrow"}}</p>
					<details class="ds-land-compat">
						<summary><h3>{{ctx.Locale.Tr "startpage.git_title"}}</h3>{{svg "dsi-chevron-down" 18}}</summary>
						<p>{{ctx.Locale.Tr "startpage.git_text"}}</p>
						<div class="ds-cmd ds-cmd-scroll ds-mt-12"><span class="ds-pr" aria-hidden="true">$</span><code tabindex="0">git clone {{.AscHubURL}}/OWNER/REPOSITORY</code></div>
					</details>
				</article>
			</div>
		</div>
	</section>

	{{if .AscDownload}}
	{{$view := .AscDownload}}
	{{$arch := $view.ActiveArchOffer}}
	<section class="ds-land-sec ds-land-sec-tint" id="download" aria-labelledby="asc-home-download-title">
		<div class="ds-container ds-land-dl">
			<div>
				<p class="ds-t-eyebrow">{{ctx.Locale.Tr "asc_download.nav"}}</p>
				<h2 class="ds-land-h2" id="asc-home-download-title">{{ctx.Locale.Tr "asc_download.home_title"}}</h2>
				<p class="ds-land-p">{{ctx.Locale.Tr "asc_download.home_desc"}}</p>
				<div class="ds-row ds-row-wrap ds-gap-8 ds-mt-16">
					{{with $arch.Primary}}
					<a class="ds-btn ds-btn-primary ds-btn-lg" href="{{.URL}}" download="{{.Name}}">{{svg "dsi-download" 18}} {{ctx.Locale.Tr "asc_download.download_for" $view.ActiveOSOffer.Label}} <span class="ds-t-small">{{ctx.Locale.TrSize .Size}}</span></a>
					{{end}}
					<a class="ds-btn ds-btn-secondary ds-btn-lg" href="{{AppSubUrl}}/download">{{ctx.Locale.Tr "asc_download.all_downloads"}}</a>
				</div>
				<p class="ds-t-small ds-c-2 ds-mt-12">{{ctx.Locale.Tr "asc_download.version" $view.Offers.Manifest.Version}}{{if $view.Detected}} &middot; {{$arch.Label}}{{end}}</p>
			</div>
			<div class="ds-land-dl-cmds">
				{{range $arch.Commands}}
				<div class="ds-term">
					<div class="ds-term-hd"><span>{{.Title}}</span><button type="button" class="ds-copy" data-clipboard-text="{{.Text}}">{{svg "dsi-copy" 14}} {{ctx.Locale.Tr "asc_download.copy"}}</button></div>
					<div class="ds-term-bd" tabindex="0">{{.Text}}</div>
				</div>
				{{end}}
			</div>
		</div>
	</section>
	{{end}}

	{{if .AscHomeRepos}}
	<section class="ds-land-sec" aria-labelledby="asc-explore-title">
		<div class="ds-container">
			<div class="ds-land-head">
				<h2 class="ds-t-h2" id="asc-explore-title">{{ctx.Locale.Tr "startpage.explore_title"}}</h2>
				<a class="ds-link" href="{{AppSubUrl}}/explore/repos">{{ctx.Locale.Tr "startpage.explore_all"}}</a>
			</div>
			<ul class="ds-list">
				{{range .AscHomeRepos}}
					{{template "shared/ds/list_row" (dict "Title" .FullName "Href" .Link "Sub" .Description "Meta1" (ctx.Locale.Tr "startpage.explore_updated" (DateUtils.TimeSince .UpdatedUnix)))}}
				{{end}}
			</ul>
		</div>
	</section>
	{{end}}

	{{if not .IsSigned}}
	<section class="ds-land-sec ds-land-sec-flush" aria-labelledby="hub-cta-title">
		<div class="ds-container">
			<div class="ds-land-cta">
				<h2 id="hub-cta-title">{{ctx.Locale.Tr "startpage.cta_title"}}</h2>
				<p>{{ctx.Locale.Tr "startpage.cta_text"}}</p>
				<div class="ds-land-actions">
					{{if .ShowRegistrationButton}}<a class="ds-btn ds-btn-accent" href="{{AppSubUrl}}/user/sign_up">{{ctx.Locale.Tr "asc_shell.create_account"}}</a>{{end}}
					<a class="ds-btn ds-btn-ondark-outline" rel="nofollow" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "sign_in"}}</a>
					<a class="ds-btn ds-btn-ondark-outline" href="https://github.com/Jordan-Hall/asc-hub/blob/asc/v16/docs/asc/README.md" target="_blank" rel="noopener noreferrer">{{ctx.Locale.Tr "startpage.cta_docs"}}</a>
				</div>
			</div>
		</div>
	</section>
	{{end}}
</div>
{{template "base/footer" .}}
