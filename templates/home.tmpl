{{template "base/head" .}}
<div role="main" aria-label="{{if .IsSigned}}{{ctx.Locale.Tr "dashboard"}}{{else}}{{ctx.Locale.Tr "home"}}{{end}}" class="page-content home">
	<section class="asc-hero">
		<div class="asc-hero-inner">
			<img class="asc-hero-wordmark" width="160" height="40" src="{{AssetUrlPrefix}}/img/wordmark-hub-dark.svg" alt="{{ctx.Locale.Tr "startpage.title"}}">
			<h1 class="asc-hero-title">{{ctx.Locale.Tr "startpage.app_desc"}}</h1>
			<p class="asc-hero-lead">{{ctx.Locale.Tr "startpage.meta_description"}}</p>
			{{if not .IsSigned}}
				<div class="asc-hero-actions">
					{{if .ShowRegistrationButton}}
						<a class="ui primary button" href="{{AppSubUrl}}/user/sign_up">{{ctx.Locale.Tr "register"}}</a>
					{{end}}
					<a class="ui button asc-button-on-dark" rel="nofollow" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "sign_in"}}</a>
				</div>
			{{end}}
			<div class="asc-hero-command" role="group" aria-label="asc clone">
				<span class="asc-prompt" aria-hidden="true">$</span>
				<code class="asc-command-text">asc clone {{AppUrl}}acme/payments</code>
			</div>
		</div>
	</section>
	<section class="asc-features">
		<div class="asc-features-inner">
			<article class="asc-card">
				<span class="asc-card-icon">{{svg "octicon-git-commit" 20}}</span>
				<h2 class="asc-card-title">{{ctx.Locale.Tr "startpage.changesets"}}</h2>
				<p>{{ctx.Locale.Tr "startpage.changesets_desc"}}</p>
			</article>
			<article class="asc-card">
				<span class="asc-card-icon">{{svg "octicon-stack" 20}}</span>
				<h2 class="asc-card-title">{{ctx.Locale.Tr "startpage.stacks"}}</h2>
				<p>{{ctx.Locale.Tr "startpage.stacks_desc"}}</p>
			</article>
			<article class="asc-card">
				<span class="asc-card-icon">{{svg "octicon-code-review" 20}}</span>
				<h2 class="asc-card-title">{{ctx.Locale.Tr "startpage.review"}}</h2>
				<p>{{ctx.Locale.Tr "startpage.review_desc"}}</p>
			</article>
			<article class="asc-card">
				<span class="asc-card-icon">{{svg "octicon-inbox" 20}}</span>
				<h2 class="asc-card-title">{{ctx.Locale.Tr "startpage.inbox"}}</h2>
				<p>{{ctx.Locale.Tr "startpage.inbox_desc"}}</p>
			</article>
		</div>
	</section>
</div>
{{template "base/footer" .}}
