{{/*
The landing page (boards Main and Mobile-Landing), signed out visitors see it at "/". The two boards have their own copy
and layout, so the page carries both: the desktop one from 1024 (asc/land_desktop), the phone one below (asc/land_mobile).
Both come from the boards word for word (locale section asc_bl, stylesheet asc-ds/board-landing.css) and take the install
commands from the latest GitHub release (AscInstallMethods). Without a release they say so and link nothing dead.
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{if .IsSigned}}{{ctx.Locale.Tr "dashboard"}}{{else}}{{ctx.Locale.Tr "home"}}{{end}}" class="ds-main ds-land-boards home">
	{{template "asc/land_desktop" .}}
	{{template "asc/land_mobile" .}}
	{{if and (not .IsSigned) .AscDownload}}
		<div class="ds-land-sticky">
			<a class="ds-btn ds-btn-accent" href="{{AppSubUrl}}/download">{{ctx.Locale.Tr "asc_download.home_cta"}}</a>
			<a class="ds-btn ds-btn-ondark-outline" rel="nofollow" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "sign_in"}}</a>
		</div>
	{{end}}
</div>
{{template "base/footer" .}}
