{{/*
The landing page (board A3, Main and Mobile-Landing). Signed out visitors see it at "/"; a signed in person with nothing to show sees the same page without the account buttons.
Sections: hero with the install command, the tools strip, why, three benefits, three steps, agents, search and compatibility, download, public repositories, call to action. Mobile first (see web_src/css/asc-ds/landing.css).
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{if .IsSigned}}{{ctx.Locale.Tr "dashboard"}}{{else}}{{ctx.Locale.Tr "home"}}{{end}}" class="ds-main ds-land home">
	<section class="ds-land-hero ds-land-home" aria-labelledby="hub-hero-title">
		<div class="ds-container">
			<p class="ds-land-pill"><i aria-hidden="true"></i>{{ctx.Locale.Tr "startpage.pill"}}</p>
			<h1 class="ds-land-title" id="hub-hero-title">{{ctx.Locale.Tr "startpage.headline"}}</h1>
			<p class="ds-land-lead">{{ctx.Locale.Tr "startpage.lead"}}</p>
			{{if not .IsSigned}}
				<div class="ds-land-actions">
					{{if .AscDownload}}<a class="ds-btn ds-btn-accent" href="{{AppSubUrl}}/download">{{ctx.Locale.Tr "asc_download.home_cta"}}</a>{{end}}
					{{if .ShowRegistrationButton}}
						<a class="ds-btn {{if .AscDownload}}ds-btn-ondark-outline{{else}}ds-btn-accent{{end}}" href="{{AppSubUrl}}/user/sign_up">{{ctx.Locale.Tr "asc_shell.create_account"}}</a>
					{{end}}
					<a class="ds-btn ds-btn-ondark-outline" rel="nofollow" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "sign_in"}}</a>
				</div>
			{{end}}
			{{if .AscInstallMethods}}
				<div class="ds-land-install" data-ds-install>
					<div class="ds-install-pills" role="group" aria-label="{{ctx.Locale.Tr "asc_land.install_method"}}">
						{{range $i, $m := .AscInstallMethods}}
							<button type="button" class="ds-install-pill" data-install-key="{{$m.Key}}" aria-pressed="{{if eq $i 0}}true{{else}}false{{end}}">{{$m.Label}}</button>
						{{end}}
					</div>
					<div class="ds-install-card">
						<p class="ds-install-step"><b>1</b> {{ctx.Locale.Tr "asc_land.install_step1"}} <span class="ds-install-ok">{{ctx.Locale.Tr "asc_land.install_signed"}}</span></p>
						{{range $i, $m := .AscInstallMethods}}
							<div class="ds-cmd ds-cmd-scroll" data-install-key="{{$m.Key}}"{{if ne $i 0}} hidden{{end}}><span class="ds-pr" aria-hidden="true">$</span><code tabindex="0">{{$m.Command}}</code><button type="button" class="ds-copy" data-ds-toast-copied="{{ctx.Locale.Tr "asc_download.copied_toast"}}" data-clipboard-text="{{$m.Command}}">{{svg "dsi-copy" 14}} {{ctx.Locale.Tr "asc_download.copy"}}</button></div>
						{{end}}
					</div>
					<div class="ds-install-card">
						<p class="ds-install-step"><b>2</b> {{ctx.Locale.Tr "asc_land.install_step2"}}</p>
						<div class="ds-cmd ds-cmd-scroll"><span class="ds-pr" aria-hidden="true">$</span><code tabindex="0">asc auth login --host {{.AscHubURL}} --prompt</code><button type="button" class="ds-copy" data-ds-toast-copied="{{ctx.Locale.Tr "asc_download.copied_toast"}}" data-clipboard-text="asc auth login --host {{.AscHubURL}} --prompt">{{svg "dsi-copy" 14}} {{ctx.Locale.Tr "asc_download.copy"}}</button></div>
					</div>
					<p class="ds-land-meta">{{ctx.Locale.Tr "asc_land.install_note"}}</p>
				</div>
			{{else}}
			<div class="ds-land-install" role="group" aria-label="{{ctx.Locale.Tr "startpage.connect_label"}}">
				<div class="ds-cmd ds-cmd-scroll"><span class="ds-pr" aria-hidden="true">$</span><code tabindex="0">asc auth login --host {{.AscHubURL}} --prompt</code><button type="button" class="ds-copy" data-ds-toast-copied="{{ctx.Locale.Tr "asc_download.copied_toast"}}" data-clipboard-text="asc auth login --host {{.AscHubURL}} --prompt">{{svg "dsi-copy" 14}} {{ctx.Locale.Tr "asc_download.copy"}}</button></div>
			</div>
			{{end}}
			<figure class="ds-land-window">
				<figcaption class="tw-sr-only">{{ctx.Locale.Tr "asc_land.window_alt"}}</figcaption>
				<div class="ds-win" aria-hidden="true">
					<div class="ds-win-bar"><i></i><i></i><i></i><span>{{ctx.Locale.Tr "asc_land.window_path"}}</span></div>
					<div class="ds-win-body">
						<ol class="ds-win-rail">
							<li class="ok"><b>{{ctx.Locale.Tr "asc_land.window_c1"}}</b><small>{{ctx.Locale.Tr "asc_land.window_c1s"}}</small></li>
							<li class="ok"><b>{{ctx.Locale.Tr "asc_land.window_c2"}}</b><small>{{ctx.Locale.Tr "asc_land.window_c2s"}}</small></li>
							<li class="on"><b>{{ctx.Locale.Tr "asc_land.window_c3"}}</b><small>{{ctx.Locale.Tr "asc_land.window_c3s"}}</small></li>
							<li><b>{{ctx.Locale.Tr "asc_land.window_c4"}}</b><small>{{ctx.Locale.Tr "asc_land.window_c4s"}}</small></li>
						</ol>
						<div class="ds-win-main">
							<p class="ds-win-h">{{ctx.Locale.Tr "asc_land.window_c3"}} <span>{{ctx.Locale.Tr "asc_land.window_agent"}}</span></p>
							<p class="ds-win-intent"><b>{{ctx.Locale.Tr "asc_land.window_intent"}}</b> {{ctx.Locale.Tr "asc_land.window_intent_text"}}</p>
							<p class="ds-win-comment"><b>{{ctx.Locale.Tr "asc_land.window_you"}}</b> {{ctx.Locale.Tr "asc_land.window_comment"}}</p>
						</div>
						<ul class="ds-win-turn">
							<li><b>{{ctx.Locale.Tr "asc_land.window_turn1"}}</b><small>{{ctx.Locale.Tr "asc_land.window_turn1s"}}</small></li>
							<li><b>{{ctx.Locale.Tr "asc_land.window_turn2"}}</b><small>{{ctx.Locale.Tr "asc_land.window_turn2s"}}</small></li>
							<li><b>{{ctx.Locale.Tr "asc_land.window_turn3"}}</b><small>{{ctx.Locale.Tr "asc_land.window_turn3s"}}</small></li>
						</ul>
					</div>
				</div>
			</figure>
		</div>
	</section>

	<section class="ds-land-strip" aria-label="{{ctx.Locale.Tr "startpage.works_with"}}">
		<div class="ds-container ds-land-strip-in">
			<p>{{ctx.Locale.Tr "startpage.works_with"}}</p>
