						<li class="ds-li"><div class="ds-li-main"><span class="ds-li-title">Anthropic <span class="ds-chip ds-chip-ok">{{ctx.Locale.Tr "asc_land.byo_on"}}</span></span></div><span class="ds-mono ds-c-2">sk-ant-&bull;&bull;&bull;&bull;&bull;a91f</span></li>
						<li class="ds-li"><div class="ds-li-main"><span class="ds-li-title">OpenAI <span class="ds-chip ds-chip-ok">{{ctx.Locale.Tr "asc_land.byo_on"}}</span></span></div><span class="ds-mono ds-c-2">sk-&bull;&bull;&bull;&bull;&bull;77c2</span></li>
						<li class="ds-li"><div class="ds-li-main"><span class="ds-li-title">{{ctx.Locale.Tr "asc_land.byo_local"}} <span class="ds-chip">{{ctx.Locale.Tr "asc_land.byo_off"}}</span></span></div></li>
					</ul>
				</article>
				<article class="ds-land-card">
					<h3>{{ctx.Locale.Tr "asc_land.byo_s3_h"}}</h3>
					<p>{{ctx.Locale.Tr "asc_land.byo_s3_p"}}</p>
					<dl class="ls-s3">
						<div><dt>{{ctx.Locale.Tr "asc_land.byo_endpoint"}}</dt><dd class="ds-mono">https://s3.eu-west-1.amazonaws.com</dd></div>
						<div><dt>{{ctx.Locale.Tr "asc_land.byo_bucket"}}</dt><dd class="ds-mono">acme-asc-artifacts</dd></div>
						<div><dt>{{ctx.Locale.Tr "asc_land.byo_region"}}</dt><dd class="ds-mono">eu-west-1</dd></div>
					</dl>
				</article>
			</div>
		</div>
	</section>

	{{if .AscDownload}}
	{{$view := .AscDownload}}
	{{$arch := $view.ActiveArchOffer}}
	<section class="ds-land-sec ds-land-sec-tint" id="download" aria-labelledby="asc-home-download-title">
		<div class="ds-container ds-land-dl">
			<div>
				<p class="ds-t-eyebrow">{{ctx.Locale.Tr "asc_download.nav"}}</p>
				<h2 class="ds-land-h2" id="asc-home-download-title">{{ctx.Locale.Tr "asc_download.home_title"}}</h2>
				<p class="ds-land-p">{{ctx.Locale.Tr "asc_download.home_desc"}}</p>
				<div class="ds-row ds-row-wrap ds-gap-8 ds-mt-16">
					{{with $arch.Primary}}
					<a class="ds-btn ds-btn-primary ds-btn-lg" href="{{.URL}}" download="{{.Name}}">{{svg "dsi-download" 18}} {{ctx.Locale.Tr "asc_download.download_for" $view.ActiveOSOffer.Label}} <span class="ds-t-small">{{ctx.Locale.TrSize .Size}}</span></a>
					{{end}}
					<a class="ds-btn ds-btn-secondary ds-btn-lg" href="{{AppSubUrl}}/download">{{ctx.Locale.Tr "asc_download.all_downloads"}}</a>
				</div>
				<p class="ds-t-small ds-c-2 ds-mt-12">{{ctx.Locale.Tr "asc_download.version" $view.Offers.Manifest.Version}}{{if $view.Detected}} &middot; {{$arch.Label}}{{end}}</p>
			</div>
			<div class="ds-land-dl-cmds">
				{{range $arch.Commands}}
				<div class="ds-term">
					<div class="ds-term-hd"><span>{{.Title}}</span><button type="button" class="ds-copy" data-ds-toast-copied="{{ctx.Locale.Tr "asc_download.copied_toast"}}" data-clipboard-text="{{.Text}}">{{svg "dsi-copy" 14}} {{ctx.Locale.Tr "asc_download.copy"}}</button></div>
					<div class="ds-term-bd" tabindex="0">{{.Text}}</div>
				</div>
				{{end}}
			</div>
		</div>
	</section>
	{{end}}

	{{if .AscHomeRepos}}
	<section class="ds-land-sec" aria-labelledby="asc-explore-title">
		<div class="ds-container">
			<div class="ds-land-head">
				<h2 class="ds-t-h2" id="asc-explore-title">{{ctx.Locale.Tr "startpage.explore_title"}}</h2>
				<a class="ds-link" href="{{AppSubUrl}}/explore/repos">{{ctx.Locale.Tr "startpage.explore_all"}}</a>
			</div>
			<ul class="ds-list">
				{{range .AscHomeRepos}}
					{{template "shared/ds/list_row" (dict "Title" .FullName "Href" .Link "Sub" .Description "Meta1" (ctx.Locale.Tr "startpage.explore_updated" (DateUtils.TimeSince .UpdatedUnix)))}}
				{{end}}
			</ul>
		</div>
	</section>
	{{end}}

	{{if not .IsSigned}}
	<section class="ds-land-sec ds-land-sec-flush" aria-labelledby="hub-cta-title">
		<div class="ds-container">
			<div class="ds-land-cta">
				<h2 id="hub-cta-title">{{ctx.Locale.Tr "startpage.cta_title"}}</h2>
				<p>{{ctx.Locale.Tr "startpage.cta_text"}}</p>
				<div class="ds-land-actions">
					{{if .ShowRegistrationButton}}<a class="ds-btn ds-btn-accent" href="{{AppSubUrl}}/user/sign_up">{{ctx.Locale.Tr "asc_shell.create_account"}}</a>{{end}}
					<a class="ds-btn ds-btn-ondark-outline" rel="nofollow" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "sign_in"}}</a>
					<a class="ds-btn ds-btn-ondark-outline" href="https://github.com/Jordan-Hall/asc-hub/blob/asc/v16/docs/asc/README.md" target="_blank" rel="noopener noreferrer">{{ctx.Locale.Tr "startpage.cta_docs"}}</a>
				</div>
			</div>
		</div>
	</section>
	{{end}}
	{{if and (not .IsSigned) .AscDownload}}
		<div class="ds-land-sticky">
			<a class="ds-btn ds-btn-accent" href="{{AppSubUrl}}/download">{{ctx.Locale.Tr "asc_download.home_cta"}}</a>
			<a class="ds-btn ds-btn-ondark-outline" rel="nofollow" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "sign_in"}}</a>
		</div>
	{{end}}
</div>
{{template "base/footer" .}}
