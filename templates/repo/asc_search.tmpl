{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository asc-repo-page">
	{{template "repo/header" .}}
	<div class="ui container">
		<div id="asc-search-container" class="ui segment">
			<h2>Search this repository</h2>
			<form id="asc-search-form" class="ui form tw-mb-4" method="get" action="{{.RepoLink}}/asc/search">
				<div class="tw-flex tw-flex-wrap tw-gap-3 tw-items-end">
					<div class="field">
						<label for="asc-search-mode">Mode</label>
						<select id="asc-search-mode" name="mode">
							<option value="lexical"{{if eq .AscSearchMode "lexical"}} selected{{end}}>Text (lexical)</option>
							<option value="symbol"{{if eq .AscSearchMode "symbol"}} selected{{end}}>Symbol</option>
							<option value="semantic"{{if eq .AscSearchMode "semantic"}} selected{{end}}>Semantic</option>
						</select>
					</div>
					<div class="field tw-flex-1">
						<label for="asc-search-q">Query</label>
						<input id="asc-search-q" name="q" type="search" maxlength="4096" value="{{.AscSearchText}}" autocomplete="off" required>
					</div>
					<div class="field">
						<label for="asc-search-match">Text match</label>
						<select id="asc-search-match" name="match">
							<option value="literal"{{if eq .AscSearchMatch "literal"}} selected{{end}}>Literal</option>
							<option value="word"{{if eq .AscSearchMatch "word"}} selected{{end}}>Whole word</option>
							<option value="regex"{{if eq .AscSearchMatch "regex"}} selected{{end}}>Regular expression</option>
						</select>
					</div>
					<div class="field">
						<div class="ui checkbox">
							<input id="asc-search-case" name="case" type="checkbox" value="1"{{if .AscSearchCase}} checked{{end}}>
							<label for="asc-search-case">Match case</label>
						</div>
					</div>
				</div>
				<fieldset id="asc-search-scope" class="tw-mt-3 tw-border-0 tw-p-0">
					<legend class="text grey">Scope</legend>
					<div class="tw-flex tw-flex-wrap tw-gap-3 tw-items-end">
						<div class="field">
							<label for="asc-search-ref">Branch or commit</label>
							<input id="asc-search-ref" name="ref" type="text" maxlength="255" value="{{.AscSearchRefInput}}" placeholder="{{.AscSearchDefaultBranch}}">
						</div>
						<div class="field">
							<label for="asc-search-path">Path prefix</label>
							<input id="asc-search-path" name="path" type="text" maxlength="4096" value="{{.AscSearchPathInput}}" placeholder="the whole repository">
						</div>
						<div class="field">
							<label for="asc-search-lang">Language</label>
							<input id="asc-search-lang" name="lang" type="text" maxlength="40" value="{{.AscSearchLangInput}}" placeholder="any">
						</div>
						<div class="field">
							<button class="ui primary button" type="submit">Search</button>
						</div>
					</div>
				</fieldset>
			</form>

			{{if .AscSearchError}}
				<div class="ui warning message" role="alert">
					{{if eq .AscSearchError 400}}<p>This search is not valid. Check the query, the path, the language and the branch.</p>
					{{else if eq .AscSearchError 404}}<p>The branch, or the repository in the code index, was not found.</p>
					{{else if eq .AscSearchError 429}}<p>Too many searches right now. Try again in a moment.</p>
					{{else if eq .AscSearchError 503}}<p>This kind of search is not available for this repository yet.</p>
					{{else if eq .AscSearchError 504}}<p>The search took too long.</p>
					{{else}}<p>Search is not available right now.</p>{{end}}
				</div>
			{{else if .AscSearchDone}}
				<p class="text grey" id="asc-search-where">
					{{.AscSearchCount}} result{{if ne .AscSearchCount 1}}s{{end}} at <span class="tw-font-mono">{{.AscSearchRev}}</span>
					{{if eq .AscSearchMode "semantic"}}{{if .AscSearchModel}} using model <span class="tw-font-mono">{{.AscSearchModel}}</span>{{end}}{{end}}
				</p>
				<div id="asc-search-coverage" class="ui small {{if .AscSearchComplete}}info{{else}}warning{{end}} message" role="status">
					{{if not .AscSearchCoverageKnown}}
						How much of this scope is indexed is not known, so the results may be incomplete.
					{{else if .AscSearchComplete}}
						The index covers all of this scope.
					{{else}}
						The index does not cover all of this scope yet, so the results may be incomplete.
					{{end}}
					{{range $c := .AscSearchCoverage}}
						<span class="ui basic mini label asc-search-index">{{$c.Index}} {{$c.Percent}}%{{if $c.Lag}}, {{$c.Lag}} s behind{{end}}</span>
					{{end}}
				</div>

				{{if eq .AscSearchCount 0}}
					<div class="ui info message">Nothing found.</div>
				{{end}}

				{{if .AscSearchFiles}}
					<ul class="asc-search-files tw-list-none tw-p-0">
						{{range $f := .AscSearchFiles}}
							<li class="asc-search-file tw-mb-4">
								<div class="tw-flex tw-flex-wrap tw-gap-2 tw-items-baseline">
									<a class="tw-font-mono" href="{{$f.Link}}">{{$f.Path}}</a>
									{{if $f.Lang}}<span class="ui basic mini label">{{$f.Lang}}</span>{{end}}
									{{range $a := $f.Also}}<span class="text grey">also at <a class="tw-font-mono" href="{{$a.Link}}">{{$a.Path}}</a></span>{{end}}
								</div>
								{{if $f.Redacted}}
									<div class="ui tiny message">The content of this file is hidden because it may hold secrets.</div>
								{{else}}
									<table class="asc-search-lines tw-font-mono tw-text-13">
										<tbody>
											{{range $l := $f.Lines}}
												<tr{{if $l.IsMatch}} class="asc-search-match"{{end}}>
													<td class="tw-text-right tw-pr-3 text grey"><a href="{{$l.Link}}">{{$l.Number}}</a></td>
													<td class="tw-whitespace-pre-wrap tw-break-all">{{range $s := $l.Segments}}{{if $s.Hit}}<mark>{{$s.Text}}</mark>{{else}}{{$s.Text}}{{end}}{{end}}</td>
												</tr>
											{{end}}
										</tbody>
									</table>
								{{end}}
							</li>
						{{end}}
					</ul>
				{{end}}

				{{if .AscSearchSymbols}}
					<ul class="asc-search-symbols tw-list-none tw-p-0">
						{{range $r := .AscSearchSymbols}}
							<li class="asc-symbol tw-flex tw-flex-wrap tw-gap-2 tw-items-baseline">
								<span class="ui basic mini label">{{$r.Kind}}</span>
								<a class="tw-font-mono" href="{{$r.Link}}">{{$r.Path}}{{if $r.Line}}:{{$r.Line}}{{end}}</a>
								<span class="tw-font-mono">{{$r.Name}}</span>
								{{if $r.Signature}}<code class="gt-ellipsis">{{$r.Signature}}</code>{{end}}
								{{if $r.Container}}<span class="text grey">in {{$r.Container}}</span>{{end}}
								<span class="ui mini label asc-confidence-{{$r.Confidence}}" title="How this match was found">{{$r.Confidence}}</span>
								{{if $r.Doc}}<span class="text grey">{{$r.Doc}}</span>{{end}}
							</li>
						{{end}}
					</ul>
				{{end}}

				{{if .AscSearchChunks}}
					<ul class="asc-search-chunks tw-list-none tw-p-0">
						{{range $c := .AscSearchChunks}}
							<li class="asc-search-chunk tw-mb-4">
								<div class="tw-flex tw-flex-wrap tw-gap-2 tw-items-baseline">
									<a class="tw-font-mono" href="{{$c.Link}}">{{$c.Path}}{{if $c.StartLine}}:{{$c.StartLine}}{{if gt $c.EndLine $c.StartLine}}-{{$c.EndLine}}{{end}}{{end}}</a>
									{{if $c.Symbol}}<span class="tw-font-mono">{{$c.Symbol}}</span>{{end}}
									<span class="ui basic mini label" title="Relevance score">{{$c.Score}}</span>
									{{range $s := $c.Sources}}<span class="ui basic mini label">{{$s}}</span>{{end}}
								</div>
								{{if $c.Redacted}}
									<div class="ui tiny message">The content of this chunk is hidden because it may hold secrets.</div>
								{{else if $c.Text}}
									<pre class="tw-font-mono tw-text-13 tw-overflow-x-auto">{{$c.Text}}</pre>
								{{end}}
							</li>
						{{end}}
					</ul>
				{{end}}

				{{if .AscSearchTruncated}}<div class="ui info message">More results exist than are shown. Narrow the scope or the query.</div>{{end}}
			{{end}}
		</div>
	</div>
</div>
{{template "base/footer" .}}
