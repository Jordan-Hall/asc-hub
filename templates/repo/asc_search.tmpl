{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="ds-main page-content repository asc-repo-page asc-search rp-page rp-searchpage">
	{{template "repo/header" (dict "HdrData" . "SubTitle" (ctx.Locale.Tr "asc_rp.s_title") "SubBack" .RepoLink)}}
	<div class="ds-container rp-body">
		<h1 class="tw-sr-only">{{ctx.Locale.Tr "asc_rp.s_title"}}</h1>
		<form id="asc-search-form" class="asc-search-form ds-form" method="get" action="{{.RepoLink}}/asc/search" role="search">
			<div class="asc-search-bar">
				<label class="tw-sr-only" for="asc-search-q">{{ctx.Locale.Tr "asc_rp.s_label"}}</label>
				<input id="asc-search-q" name="q" type="search" maxlength="4096" value="{{.AscSearchText}}" autocomplete="off" placeholder="{{ctx.Locale.Tr "asc_rp.s_placeholder"}}" required>
				<button class="ds-btn ds-btn-primary" type="submit">{{ctx.Locale.Tr "asc_rp.s_label"}}</button>
			</div>
			<div class="asc-search-modes" role="radiogroup" aria-label="{{ctx.Locale.Tr "asc_rp.s_kind"}}">
				<label class="asc-mode"><input type="radio" name="mode" value="lexical"{{if eq .AscSearchMode "lexical"}} checked{{end}}><span>{{ctx.Locale.Tr "asc_rp.s_text"}}</span></label>
				<label class="asc-mode"><input type="radio" name="mode" value="symbol"{{if eq .AscSearchMode "symbol"}} checked{{end}}><span>{{ctx.Locale.Tr "asc_rp.s_symbol"}}</span></label>
				<label class="asc-mode"><input type="radio" name="mode" value="semantic"{{if eq .AscSearchMode "semantic"}} checked{{end}}><span>{{ctx.Locale.Tr "asc_rp.s_meaning"}}</span></label>
			</div>
			<fieldset id="asc-search-scope" class="asc-scope">
				<legend>{{ctx.Locale.Tr "asc_rp.s_scope"}}</legend>
				<label class="asc-scope-option"><input type="radio" name="scope" value="version"{{if eq .AscSearchScope "version"}} checked{{end}}><span>{{ctx.Locale.Tr "asc_rp.s_scope_version"}}{{if .AscSearchDefaultBranch}} ({{.AscSearchDefaultBranch}}){{end}}</span></label>
				<label class="asc-scope-option"><input type="radio" name="scope" value="change"{{if eq .AscSearchScope "change"}} checked{{end}}><span>{{ctx.Locale.Tr "asc_rp.s_scope_change"}}</span></label>
				<label class="asc-scope-option"><input type="radio" name="scope" value="stack"{{if eq .AscSearchScope "stack"}} checked{{end}}><span>{{ctx.Locale.Tr "asc_rp.s_scope_stack"}}</span></label>
				<label class="asc-scope-option"><input type="radio" name="scope" value="branches"{{if eq .AscSearchScope "branches"}} checked{{end}}><span>{{ctx.Locale.Tr "asc_rp.s_scope_branches"}}</span></label>
				<label class="asc-scope-option"><input type="radio" name="scope" value="repos"{{if eq .AscSearchScope "repos"}} checked{{end}}><span>{{ctx.Locale.Tr "asc_rp.s_scope_repos"}}</span></label>
			</fieldset>
			<details class="asc-search-options"{{if or .AscSearchRefInput .AscSearchPullInput .AscSearchPathInput .AscSearchLangInput .AscSearchError}} open{{end}}>
				<summary>{{ctx.Locale.Tr "asc_rp.s_narrow"}}</summary>
				<div class="asc-search-fields">
					<div class="ds-field">
						<label class="ds-label" for="asc-search-ref">{{ctx.Locale.Tr "asc_rp.s_ref"}}</label>
						<input id="asc-search-ref" class="ds-input" name="ref" type="text" maxlength="255" value="{{.AscSearchRefInput}}" placeholder="{{.AscSearchDefaultBranch}}">
					</div>
					<div class="ds-field">
						<label class="ds-label" for="asc-search-pull">{{ctx.Locale.Tr "asc_rp.s_pull"}}</label>
						<input id="asc-search-pull" class="ds-input" name="pull" type="text" inputmode="numeric" maxlength="12" value="{{.AscSearchPullInput}}" placeholder="{{ctx.Locale.Tr "asc_rp.s_number"}}">
					</div>
					<div class="ds-field asc-search-case">
						<div class="ds-check">
							<input id="asc-search-diff" name="diff" type="checkbox" value="1"{{if .AscSearchStackDiff}} checked{{end}}>
							<label for="asc-search-diff">{{ctx.Locale.Tr "asc_rp.s_diff_only"}}</label>
						</div>
					</div>
					<div class="ds-field">
						<label class="ds-label" for="asc-search-path">{{ctx.Locale.Tr "asc_rp.s_path_prefix"}}</label>
						<input id="asc-search-path" class="ds-input" name="path" type="text" maxlength="4096" value="{{.AscSearchPathInput}}" placeholder="{{ctx.Locale.Tr "asc_rp.s_whole_repo"}}">
					</div>
					<div class="ds-field">
						<label class="ds-label" for="asc-search-lang">{{ctx.Locale.Tr "asc_rp.s_language"}}</label>
						<input id="asc-search-lang" class="ds-input" name="lang" type="text" maxlength="40" value="{{.AscSearchLangInput}}" placeholder="{{ctx.Locale.Tr "asc_rp.s_any"}}">
					</div>
					<div class="ds-field">
						<label class="ds-label" for="asc-search-match">{{ctx.Locale.Tr "asc_rp.s_match"}}</label>
						<select id="asc-search-match" class="ds-select" name="match">
							<option value="literal"{{if eq .AscSearchMatch "literal"}} selected{{end}}>{{ctx.Locale.Tr "asc_rp.s_match_literal"}}</option>
							<option value="word"{{if eq .AscSearchMatch "word"}} selected{{end}}>{{ctx.Locale.Tr "asc_rp.s_match_word"}}</option>
							<option value="regex"{{if eq .AscSearchMatch "regex"}} selected{{end}}>{{ctx.Locale.Tr "asc_rp.s_match_regex"}}</option>
						</select>
					</div>
					<div class="ds-field asc-search-case">
						<div class="ds-check">
							<input id="asc-search-case" name="case" type="checkbox" value="1"{{if .AscSearchCase}} checked{{end}}>
							<label for="asc-search-case">{{ctx.Locale.Tr "asc_rp.s_case"}}</label>
						</div>
					</div>
				</div>
			</details>
		</form>

		{{if .AscSearchError}}
			<div class="ds-banner ds-banner-warn" role="alert">
				{{if eq .AscSearchError 400}}<p>{{ctx.Locale.Tr "asc_rp.s_err_400"}}</p>
				{{else if eq .AscSearchError 404}}<p>{{ctx.Locale.Tr "asc_rp.s_err_404"}}</p>
				{{else if eq .AscSearchError 429}}<p>{{ctx.Locale.Tr "asc_rp.s_err_429"}}</p>
				{{else if eq .AscSearchError 503}}<p>{{ctx.Locale.Tr "asc_rp.s_err_503"}}</p>
				<p class="ds-row ds-row-wrap">{{if ne .AscSearchMode "lexical"}}<a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{.RepoLink}}/asc/search?q={{QueryEscape .AscSearchText}}&amp;mode=lexical">{{ctx.Locale.Tr "asc_rp.s_use_text"}}</a>{{end}}{{if .IsRepositoryAdmin}}<a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{.RepoLink}}/settings/asc/storage">{{ctx.Locale.Tr "asc_rp.s_open_storage"}}</a>{{end}}</p>
				{{else if eq .AscSearchError 504}}<p>{{ctx.Locale.Tr "asc_rp.s_err_504"}}</p>
				{{else}}<p>{{ctx.Locale.Tr "asc_rp.s_err_other"}}</p>{{end}}
			</div>
		{{else if .AscSearchDone}}
			<div class="asc-search-layout">
				<div class="asc-search-facets" role="group" aria-label="{{ctx.Locale.Tr "asc_rp.s_filters"}}">
					{{if .AscSearchLangFacets}}
						<section>
							<h2 class="asc-facet-title">{{ctx.Locale.Tr "asc_rp.s_language"}}</h2>
							<ul class="asc-facet-list">
								{{range .AscSearchLangFacets}}
									<li><a class="asc-chip{{if .Active}} active{{end}}" href="{{.URL}}"{{if .Active}} aria-current="true"{{end}}><span>{{.Name}}</span><span class="asc-count">{{.Count}}</span></a></li>
								{{end}}
							</ul>
						</section>
					{{end}}
					{{if .AscSearchDirFacets}}
						<section>
							<h2 class="asc-facet-title">{{ctx.Locale.Tr "asc_rp.s_path"}}</h2>
							<ul class="asc-facet-list">
								{{range .AscSearchDirFacets}}
									<li><a class="asc-chip tw-font-mono{{if .Active}} active{{end}}" href="{{.URL}}"{{if .Active}} aria-current="true"{{end}}><span>{{.Name}}</span><span class="asc-count">{{.Count}}</span></a></li>
								{{end}}
							</ul>
						</section>
					{{end}}
				</div>

				<div class="asc-search-results">
					<p class="asc-search-where" id="asc-search-where" role="status">
						<b>{{.AscSearchCount}} {{ctx.Locale.TrN .AscSearchCount "asc_rp.s_result_1" "asc_rp.s_result_n"}}</b> {{ctx.Locale.Tr "asc_rp.s_at"}} <span class="tw-font-mono">{{.AscSearchRev}}</span>
						{{if eq .AscSearchMode "semantic"}}{{if .AscSearchModel}} {{ctx.Locale.Tr "asc_rp.s_using_model"}} <span class="tw-font-mono">{{.AscSearchModel}}</span>{{end}}{{end}}
					</p>
					{{if .AscSearchFailed}}
						<div class="ds-banner ds-banner-warn" role="status">{{ctx.Locale.Tr "asc_rp.s_failed" .AscSearchFailed .AscSearchTargets}}</div>
					{{end}}
					{{if .AscSearchBranchesCut}}
						<div class="ds-banner" role="status">{{ctx.Locale.Tr "asc_rp.s_cut"}}</div>
					{{end}}

					{{if eq .AscSearchCount 0}}
						{{template "shared/ds/empty" (dict "Icon" "search" "Title" (ctx.Locale.Tr "asc_rp.s_nothing_title") "Body" (ctx.Locale.Tr "asc_rp.s_nothing") "PrimaryLabel" (ctx.Locale.Tr "asc_rp.s_all_branches") "PrimaryHref" (printf "%s/asc/search?q=%s&mode=%s&scope=branches" .RepoLink (QueryEscape .AscSearchText) .AscSearchMode) "SecondaryLabel" (ctx.Locale.Tr "asc_rp.s_all_repos") "SecondaryHref" (printf "%s/asc/search?q=%s&mode=%s&scope=repos" .RepoLink (QueryEscape .AscSearchText) .AscSearchMode))}}
					{{end}}

					{{if .AscSearchFiles}}
						<div class="asc-group asc-search-files">
							{{range $f := .AscSearchFiles}}
								<article class="asc-card asc-search-file">
									<div class="asc-card-head">
										<a class="asc-path" href="{{$f.Link}}">{{$f.Path}}</a>
										{{if $f.Lang}}<span class="asc-pill asc-pill-lang">{{$f.Lang}}</span>{{end}}
									</div>
									{{if $f.Redacted}}
										<p class="asc-redacted">{{ctx.Locale.Tr "asc_rp.s_hidden_file"}}</p>
									{{else}}
										<div class="asc-lines">
											{{range $l := $f.Lines}}
												<div class="asc-line{{if $l.IsMatch}} match asc-search-match{{end}}"><a class="n" href="{{$l.Link}}">{{$l.Number}}</a><span class="c">{{range $s := $l.Segments}}{{if $s.Hit}}<mark>{{$s.Text}}</mark>{{else}}{{$s.Text}}{{end}}{{end}}</span></div>
											{{end}}
										</div>
									{{end}}
									{{if $f.Also}}
										<p class="asc-also">{{ctx.Locale.Tr "asc_rp.s_same_file"}} {{range $a := $f.Also}}<a class="tw-font-mono" href="{{$a.Link}}">{{$a.Path}}</a> {{end}}</p>
									{{end}}
									{{if $f.Branches}}{{if (index $f.Branches 0).Name}}
										<p class="asc-also asc-branches">{{ctx.Locale.Tr "asc_rp.s_on"}} {{range $b := $f.Branches}}<a class="tw-font-mono" href="{{$b.Link}}">{{$b.Name}}</a> {{end}}</p>
									{{end}}{{end}}
								</article>
							{{end}}
						</div>
					{{end}}

					{{if .AscSearchSymbols}}
						<ul class="asc-symbols asc-search-symbols">
							{{range $r := .AscSearchSymbols}}
								<li class="asc-card asc-symbol">
									<div class="asc-card-head">
										<span class="asc-pill asc-pill-lang">{{$r.Kind}}</span>
										<a class="tw-font-mono" href="{{$r.Link}}">{{$r.Path}}{{if $r.Line}}:{{$r.Line}}{{end}}</a>
										<span class="tw-font-mono">{{$r.Name}}</span>
										{{if $r.IsDef}}<span class="asc-pill asc-pill-def">{{ctx.Locale.Tr "asc_rp.s_definition"}}</span>{{end}}
										<span class="asc-pill asc-confidence asc-confidence-{{$r.Confidence}}" title="{{ctx.Locale.Tr "asc_rp.s_how_found"}}">{{$r.Confidence}}</span>
									</div>
									<p class="asc-symbol-body">
										{{if $r.Container}}<span class="asc-muted">{{ctx.Locale.Tr "asc_rp.s_in" $r.Container}}</span>{{end}}
										{{if $r.Signature}}<code class="asc-signature">{{$r.Signature}}</code>{{end}}
										{{if $r.Doc}}<span class="asc-muted">{{$r.Doc}}</span>{{end}}
										{{if $r.Branches}}{{if (index $r.Branches 0).Name}}<span class="asc-muted">{{ctx.Locale.Tr "asc_rp.s_on"}} {{range $b := $r.Branches}}<a class="tw-font-mono" href="{{$b.Link}}">{{$b.Name}}</a> {{end}}</span>{{end}}{{end}}
									</p>
								</li>
							{{end}}
						</ul>
					{{end}}

					{{if .AscSearchChunks}}
						<div class="asc-group asc-search-chunks">
							{{range $c := .AscSearchChunks}}
								<article class="asc-card asc-search-chunk">
									<div class="asc-card-head">
										<a class="asc-path" href="{{$c.Link}}">{{$c.Path}}{{if $c.StartLine}}:{{$c.StartLine}}{{if gt $c.EndLine $c.StartLine}}-{{$c.EndLine}}{{end}}{{end}}</a>
										{{if $c.Symbol}}<span class="tw-font-mono">{{$c.Symbol}}</span>{{end}}
										<span class="rp-relevance" title="{{ctx.Locale.Tr "asc_rp.s_score"}}: {{$c.Score}}"><span class="rp-relevance-bar" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{$c.ScorePct}}" aria-label="{{ctx.Locale.Tr "asc_rp.s_relevance"}}"><span class="rp-relevance-fill" data-pct="{{$c.ScorePct}}"></span></span><span class="rp-relevance-pct">{{$c.ScorePct}}%</span></span>
										{{range $s := $c.Sources}}<span class="asc-pill asc-pill-lang">{{$s}}</span>{{end}}
									</div>
									{{if $c.Redacted}}
										<p class="asc-redacted">{{ctx.Locale.Tr "asc_rp.s_hidden_chunk"}}</p>
									{{else if $c.Text}}
										<pre class="asc-chunk-text">{{$c.Text}}</pre>
									{{end}}
									{{if $c.Branches}}{{if (index $c.Branches 0).Name}}
										<p class="asc-also asc-branches">{{ctx.Locale.Tr "asc_rp.s_on"}} {{range $b := $c.Branches}}<a class="tw-font-mono" href="{{$b.Link}}">{{$b.Name}}</a> {{end}}</p>
									{{end}}{{end}}
								</article>
							{{end}}
						</div>
					{{end}}

					{{if .AscSearchTruncated}}<div class="ds-banner">{{ctx.Locale.Tr "asc_rp.s_more"}}</div>{{end}}
				</div>

				<div class="asc-search-coverage" id="asc-search-coverage" role="status">
					<b>{{ctx.Locale.Tr "asc_rp.s_coverage"}}</b>
					{{if not .AscSearchCoverageKnown}}
						{{ctx.Locale.Tr "asc_rp.s_cov_unknown"}}
					{{else if .AscSearchComplete}}
						{{ctx.Locale.Tr "asc_rp.s_cov_all"}}
					{{else}}
						{{ctx.Locale.Tr "asc_rp.s_cov_part"}}
					{{end}}
					{{range $c := .AscSearchCoverage}}
						<span class="asc-pill asc-search-index">{{$c.Index}} {{$c.Percent}}%{{if $c.Lag}}, {{ctx.Locale.Tr "asc_rp.s_lag" $c.Lag}}{{end}}</span>
					{{end}}
					{{if gt .AscSearchTargets 1}}<span class="asc-muted">{{ctx.Locale.Tr "asc_rp.s_read_for" .AscSearchCoverageOf}}</span>{{end}}
				</div>
			</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
