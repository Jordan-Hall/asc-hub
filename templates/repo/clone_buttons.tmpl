<!-- there is always at least one button (by context/repo.go) -->
{{if $.CloneButtonShowHTTPS}}
	<button class="ds-btn ds-btn-secondary ds-btn-sm" id="repo-clone-https" data-link="{{$.CloneButtonOriginLink.HTTPS}}">
		HTTPS
	</button>
{{end}}
{{if $.CloneButtonShowSSH}}
	<button class="ds-btn ds-btn-secondary ds-btn-sm" id="repo-clone-ssh" data-link="{{$.CloneButtonOriginLink.SSH}}">
		SSH
	</button>
{{end}}
{{/* An asc repository shows the asc command: the script puts data-clone-prefix before the URL, so the copy button copies the whole command. The wiki is a git repository. */}}
{{if and (eq .Repository.GetStorageBackend "asc") (not .PageIsWiki)}}
	<input id="repo-clone-url" size="20" class="js-clone-url" data-clone-prefix="asc clone " value="asc clone {{$.CloneButtonOriginLink.HTTPS}}" readonly>
{{else}}
	<input id="repo-clone-url" size="20" class="js-clone-url" value="{{$.CloneButtonOriginLink.HTTPS}}" readonly>
{{end}}
<button class="ds-btn ds-btn-secondary ds-btn-sm" id="clipboard-btn" data-tooltip-content="{{ctx.Locale.Tr "copy_url"}}" data-clipboard-target="#repo-clone-url" aria-label="{{ctx.Locale.Tr "copy_url"}}">
	{{svg "octicon-copy" 14}}
</button>
