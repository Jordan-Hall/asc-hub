{{$v := call .ctxData.VerifyTag .release}}
{{if call .ctxData.HasSignature $v}}
	{{if $v.Verified}}
		<span class="ds-chip ds-chip-ok isSigned isVerified" title="{{$v.Reason}}">{{svg "dsi-shield-check" 12}}{{ctx.Locale.Tr "asc_rp.verified"}}</span>
	{{else}}
		<span class="ds-chip ds-chip-warn isSigned isWarning" title="{{ctx.Locale.Tr $v.Reason}}">{{svg "dsi-alert" 12}}{{ctx.Locale.Tr "asc_rp.unverified"}}</span>
	{{end}}
{{end}}
