{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="ds-main page-content repository tags rp-page">
	{{template "repo/header" (dict "HdrData" . "SubTitle" (ctx.Locale.Tr "repo.release.tags") "SubBack" .RepoLink)}}
	<div class="ds-container rp-body">
		{{template "base/alert" .}}
		{{template "repo/release_tag_header" .}}
		{{if .Permission.CanRead $.UnitTypeCode}}
		<div class="rp-pills rp-refpills" role="group" aria-label="{{ctx.Locale.Tr "asc_rp.ref_kinds"}}">
			<a class="ds-chip-btn" href="{{.RepoLink}}/branches">{{ctx.Locale.Tr "repo.branches"}} <span class="ds-count">{{.BranchesCount}}</span></a>
			<a class="ds-chip-btn" href="{{.RepoLink}}/tags" aria-current="true">{{ctx.Locale.Tr "repo.release.tags"}} <span class="ds-count">{{.NumTags}}</span></a>
		</div>
		{{end}}
		{{$canReadReleases := $.Permission.CanRead $.UnitTypeReleases}}
		<section class="rp-sec rp-refcard" aria-labelledby="rp-tags-h">
			<div class="rp-sec-h">
				<div>
					<h3 class="rp-sec-title" id="rp-tags-h">{{ctx.Locale.Tr "repo.release.tags"}}</h3>
					<p class="rp-sec-sub">{{ctx.Locale.Tr "asc_rp.tags_rule"}}</p>
				</div>
				<span class="ds-count">{{.NumTags}}</span>
			</div>
			{{if .Releases}}
			<ul class="rp-reflist" id="tags-table">
				{{range $idx, $release := .Releases}}
					<li class="rp-ref tag">
						<div class="rp-ref-main">
							<div class="rp-ref-title">
								{{if $canReadReleases}}
									<a class="rp-ref-name ds-mono release-tag-name" href="{{$.RepoLink}}/releases/tag/{{.TagName | PathEscapeSegments}}" rel="nofollow">{{.TagName}}</a>
								{{else}}
									<a class="rp-ref-name ds-mono release-tag-name" href="{{$.RepoLink}}/src/tag/{{.TagName | PathEscapeSegments}}" rel="nofollow">{{.TagName}}</a>
								{{end}}
								{{template "repo/tag/verification_box" (dict "ctxData" $ "release" $release)}}
							</div>
							{{if $.Permission.CanRead $.UnitTypeCode}}
							<p class="rp-ref-meta download">
								<a class="rp-hash" href="{{$.RepoLink}}/src/commit/{{.Sha1}}" rel="nofollow">{{ShortSha .Sha1}}</a>
								{{if .CreatedUnix}}<span>{{DateUtils.TimeSince .CreatedUnix}}</span>{{end}}
							</p>
							{{end}}
						</div>
						{{if $.Permission.CanRead $.UnitTypeCode}}
						<div class="rp-ref-side">
							{{if and $canReadReleases (not $release.IsTag)}}
								<a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{$.RepoLink}}/releases/tag/{{.TagName | PathEscapeSegments}}" rel="nofollow">{{ctx.Locale.Tr "repo.release.detail"}}</a>
							{{else if and $canReadReleases $.CanCreateRelease $release.IsTag}}
								<a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{$.RepoLink}}/releases/new?tag={{.TagName}}" rel="nofollow">{{ctx.Locale.Tr "repo.release.new_release"}}</a>
							{{end}}
							{{$canArchive := not $.DisableDownloadSourceArchives}}
							{{$canDelete := and ($.Permission.CanWrite $.UnitTypeCode) $release.IsTag}}
							{{if or $canArchive $canDelete}}
							<details class="dropdown rp-dd rp-ref-more">
								<summary class="ds-btn ds-btn-secondary ds-btn-sm ds-btn-icon" aria-label="{{ctx.Locale.Tr "asc_rp.more_for" .TagName}}">{{svg "dsi-dots" 18}}</summary>
								<div class="content rp-pop">
									<div class="rp-pop-h ds-mono">{{.TagName}}</div>
									<ul>
										{{if $canArchive}}
											<li><a class="archive-link" href="{{$.RepoLink}}/archive/{{.TagName | PathEscapeSegments}}.zip" rel="nofollow">{{svg "dsi-download" 18}}ZIP</a></li>
											<li><a class="archive-link" href="{{$.RepoLink}}/archive/{{.TagName | PathEscapeSegments}}.tar.gz" rel="nofollow">{{svg "dsi-download" 18}}TAR.GZ</a></li>
										{{end}}
										{{if $canDelete}}
											<li><button type="button" class="delete-button rp-danger" data-url="{{$.RepoLink}}/tags/delete" data-id="{{.ID}}" data-modal-id="delete-tag">{{svg "dsi-trash" 18}}{{ctx.Locale.Tr "repo.release.delete_tag"}}</button></li>
										{{end}}
									</ul>
								</div>
							</details>
							{{end}}
						</div>
						{{end}}
					</li>
				{{end}}
			</ul>
			{{else}}
				<div class="rp-sec-b">
					{{template "shared/ds/empty" (dict "Icon" "tag" "Title" (ctx.Locale.Tr "asc_rp.no_tags_title") "Body" (ctx.Locale.Tr "asc_rp.no_tags_body"))}}
				</div>
			{{end}}
		</section>
		{{template "base/paginate" .}}
	</div>
</div>

{{if $.Permission.CanWrite $.UnitTypeCode}}
<div class="ui g-modal-confirm delete modal" id="delete-tag">
	<div class="header">
		{{svg "octicon-trash"}}
		{{ctx.Locale.Tr "repo.release.delete_tag"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "repo.release.deletion_tag_desc"}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>
{{end}}

{{template "base/footer" .}}
