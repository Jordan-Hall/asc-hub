{{template "repo/settings/layout_head" (dict "ctxData" . "pageClass" "repository settings asc-trust-page")}}
<div class="repo-setting-content">
{{with .AscPolicy}}
<div class="asc-trust" data-testid="asc-policy">
	<div class="asc-trust-head">
		<h2 class="asc-trust-title">{{ctx.Locale.Tr "asc_rp.p_title"}}</h2>
	</div>
	<p class="asc-trust-lead">{{ctx.Locale.Tr "asc_rp.p_lead"}}</p>
	<nav class="asc-trust-links" aria-label="{{ctx.Locale.Tr "asc_rp.p_pages"}}">
		<a href="{{.SecurityURL}}">{{ctx.Locale.Tr "asc_rp.p_secret"}}</a>
		<a href="{{.AuditURL}}">{{ctx.Locale.Tr "asc_rp.p_audit"}}</a>
		<a href="{{.ChecksURL}}">{{ctx.Locale.Tr "asc_rp.p_checks"}}</a>
	</nav>

	{{if .Unsupported}}
		<div class="ds-banner ds-banner-warn" role="status" data-testid="asc-policy-unsupported">{{ctx.Locale.Tr "asc_rp.p_unsupported"}}</div>
	{{else}}
		{{if .Problem}}<div class="ds-banner ds-banner-err" role="alert" data-testid="asc-policy-problem">{{.Problem}}</div>{{end}}

		{{with .Org}}
		<section class="ast-card" aria-labelledby="asc-policy-org" data-testid="asc-policy-org">
			<div class="ast-card-head">
				<h3 id="asc-policy-org" class="ast-card-title">{{ctx.Locale.Tr "asc_rp.p_org_title" .Org}}</h3>
				<span class="ast-card-aside">{{ctx.Locale.Tr "asc_rp.p_org_lead"}}</span>
			</div>
			{{if .Set}}
			<dl class="ast-org-list">
				<dt>{{ctx.Locale.Tr "asc_rp.p_org_required"}}</dt>
				<dd data-testid="asc-policy-org-required">{{if .Required}}{{range $i, $v := .Required}}{{if $i}}, {{end}}{{$v}}{{end}}{{else}}{{ctx.Locale.Tr "asc_rp.p_org_nothing"}}{{end}}</dd>
				<dt>{{ctx.Locale.Tr "asc_rp.p_org_effective"}}</dt>
				<dd data-testid="asc-policy-org-effective">{{if .Effective}}{{range $i, $v := .Effective}}{{if $i}}, {{end}}{{$v}}{{end}}{{else}}{{ctx.Locale.Tr "asc_rp.p_org_nothing"}}{{end}}</dd>
				{{if .Tightened}}<dt>{{ctx.Locale.Tr "asc_rp.p_org_tightened"}}</dt>
				<dd data-testid="asc-policy-org-tightened">{{range $i, $v := .Tightened}}{{if $i}}, {{end}}{{$v}}{{end}}</dd>{{end}}
			</dl>
			{{else}}<p class="asc-trust-sub" data-testid="asc-policy-org-none">{{ctx.Locale.Tr "asc_rp.p_org_none"}}</p>{{end}}
		</section>
		{{end}}

		{{if .View}}
		<section class="ast-card" aria-labelledby="asc-policy-file">
			<div class="ast-card-head">
				<h3 id="asc-policy-file" class="ast-card-title">{{ctx.Locale.Tr "asc_rp.p_file"}}</h3>
				{{if .View.Usable}}<span class="ast-pill ast-pill-ok" data-testid="asc-policy-state">{{ctx.Locale.Tr "asc_rp.p_valid"}}</span>
				{{else if .View.Present}}<span class="ast-pill ast-pill-no" data-testid="asc-policy-state">{{ctx.Locale.Tr "asc_rp.p_unusable"}}</span>
				{{else}}<span class="ast-pill ast-pill-ro" data-testid="asc-policy-state">{{ctx.Locale.Tr "asc_rp.p_nofile"}}</span>{{end}}
				{{if .View.Source}}<span class="asc-trust-sub">{{ctx.Locale.Tr "asc_rp.p_read_from"}} <code class="asc-trust-code">{{.View.Source}}</code></span>{{end}}
				<span class="ast-card-aside">{{ctx.Locale.Tr "asc_rp.p_aside"}}</span>
			</div>
			{{if .View.Error}}<div class="ds-banner ds-banner-warn" role="alert">{{.View.Error}}</div>{{end}}

			<div class="rp-doctabs" role="tablist" aria-label="{{ctx.Locale.Tr "asc_rp.pf_views"}}" data-doc-tabs data-testid="asc-policy-views">
				<button type="button" role="tab" id="pf-tab-form" aria-controls="pf-form" aria-selected="{{if not .Dirty}}true{{else}}false{{end}}" data-doc-tab="pf-form">{{ctx.Locale.Tr "asc_rp.pf_form"}}</button>
				<button type="button" role="tab" id="pf-tab-toml" aria-controls="pf-toml" aria-selected="false" tabindex="-1" data-doc-tab="pf-toml">TOML</button>
				<button type="button" role="tab" id="pf-tab-changes" aria-controls="pf-changes" aria-selected="{{if .Dirty}}true{{else}}false{{end}}" data-doc-tab="pf-changes">{{ctx.Locale.Tr "asc_rp.pf_changes"}}{{if .Dirty}} <span class="ds-count">{{len .Diff}}</span>{{end}}</button>
			</div>
			{{if and .View.Present (not .View.Maintainer)}}
			<div class="ds-banner ds-banner-warn" role="status" data-testid="asc-policy-readonly">{{ctx.Locale.Tr "asc_rp.pf_readonly"}}{{if .Maintainers}} {{ctx.Locale.Tr "asc_rp.pf_ask"}} {{range $i, $m := .Maintainers}}{{if $i}}, {{end}}<strong>{{$m}}</strong>{{end}}.{{end}}</div>
			{{end}}
			<section id="pf-form" role="tabpanel" aria-labelledby="pf-tab-form" data-doc-panel="pf-form"{{if .Dirty}} hidden{{end}}>
				<div class="ast-split">
				<form class="ds-form ast-policy-form" method="post" action="{{.PolicyURL}}/form" data-testid="asc-policy-fields">
					{{$.CsrfTokenHtml}}
					<fieldset class="ds-fieldset ds-fieldset-bare"{{if and .View.Present (not .View.Maintainer)}} disabled{{end}}>
					<fieldset class="ds-fieldset"><legend>{{ctx.Locale.Tr "asc_rp.pf_landing"}}</legend>
						<div class="ds-field"><label for="pf-approvals">{{ctx.Locale.Tr "asc_rp.pf_approvals"}}</label><input id="pf-approvals" class="ds-input" name="approvals" type="number" min="0" max="64" inputmode="numeric" value="{{.Form.RequireApprovals}}"></div>
						<div class="ds-field"><label for="pf-checks">{{ctx.Locale.Tr "asc_rp.pf_checks"}}</label><textarea id="pf-checks" class="ds-textarea ds-mono" name="checks" rows="3" spellcheck="false">{{range .Form.RequireChecks}}{{.}}
{{end}}</textarea><p class="asc-trust-sub">{{ctx.Locale.Tr "asc_rp.pf_one_per_line"}}</p></div>
						<label class="ds-check"><input type="checkbox" name="require_signed"{{if .Form.RequireSigned}} checked{{end}}> {{ctx.Locale.Tr "asc_rp.pf_signed"}}</label>
						<label class="ds-check"><input type="checkbox" name="allow_force"{{if .Form.AllowForce}} checked{{end}}> {{ctx.Locale.Tr "asc_rp.pf_force"}}</label>
					</fieldset>
					<fieldset class="ds-fieldset"><legend>{{ctx.Locale.Tr "asc_rp.pf_queue"}}</legend>
						<div class="ds-field"><label for="pf-strategy">{{ctx.Locale.Tr "asc_rp.pf_strategy"}}</label><select id="pf-strategy" class="ds-select" name="strategy"><option value=""{{if not .Form.MergeStrategy}} selected{{end}}>{{ctx.Locale.Tr "asc_rp.pf_default"}}</option>{{range $.AscPolicy.Strategies}}<option value="{{.}}"{{if eq . $.AscPolicy.Form.MergeStrategy}} selected{{end}}>{{.}}</option>{{end}}</select></div>
						<label class="ds-check"><input type="checkbox" name="queue"{{if .Form.MergeQueue}} checked{{end}}> {{ctx.Locale.Tr "asc_rp.pf_use_queue"}}</label>
						<div class="ds-field"><label for="pf-batch">{{ctx.Locale.Tr "asc_rp.pf_batch"}}</label><input id="pf-batch" class="ds-input" name="batch" type="number" min="1" max="20" inputmode="numeric" value="{{if .Form.MergeBatch}}{{.Form.MergeBatch}}{{else}}1{{end}}"></div>
						<label class="ds-check"><input type="checkbox" name="post_merge_checks"{{if .Form.PostMergeChecks}} checked{{end}}> {{ctx.Locale.Tr "asc_rp.pf_post_checks"}}</label>
					</fieldset>
					<fieldset class="ds-fieldset"><legend>{{ctx.Locale.Tr "asc_rp.pf_agents"}}</legend>
						<label class="ds-check"><input type="checkbox" name="agents_enabled"{{if .Form.AgentsEnabled}} checked{{end}}> {{ctx.Locale.Tr "asc_rp.pf_agents_on"}}</label>
						<div class="ds-field"><label for="pf-scope">{{ctx.Locale.Tr "asc_rp.pf_scope"}}</label><textarea id="pf-scope" class="ds-textarea ds-mono" name="agent_scope" rows="3" spellcheck="false">{{range .Form.AgentScope}}{{.}}
{{end}}</textarea></div>
						<div class="ds-field"><label for="pf-denied">{{ctx.Locale.Tr "asc_rp.pf_denied"}}</label><textarea id="pf-denied" class="ds-textarea ds-mono" name="agent_denied" rows="3" spellcheck="false">{{range .Form.AgentDenied}}{{.}}
{{end}}</textarea></div>
						<div class="ds-field"><label for="pf-runtime">{{ctx.Locale.Tr "asc_rp.pf_runtime"}}</label><input id="pf-runtime" class="ds-input" name="max_runtime" type="number" min="0" inputmode="numeric" value="{{.Form.MaxRuntimeSecs}}"></div>
						<div class="ds-field"><label for="pf-changes-run">{{ctx.Locale.Tr "asc_rp.pf_changes_run"}}</label><input id="pf-changes-run" class="ds-input" name="max_changes" type="number" min="0" inputmode="numeric" value="{{.Form.MaxChangesPerRun}}"></div>
						<div class="ds-field"><label for="pf-tokens">{{ctx.Locale.Tr "asc_rp.pf_tokens"}}</label><input id="pf-tokens" class="ds-input" name="max_tokens" type="number" min="0" inputmode="numeric" value="{{.Form.MaxTokens}}"></div>
						<p class="asc-trust-sub">{{ctx.Locale.Tr "asc_rp.pf_human_approves"}}</p>
					</fieldset>
					<div class="asc-trust-actions"><button class="ds-btn ds-btn-primary" type="submit" data-testid="asc-policy-review">{{ctx.Locale.Tr "asc_rp.pf_review"}}</button></div>
					</fieldset>
				</form>
				<aside class="ast-meaning" aria-label="{{ctx.Locale.Tr "asc_rp.pf_live"}}" data-testid="asc-policy-live">
					<h4 class="ast-meaning-title">{{ctx.Locale.Tr "asc_rp.pf_live"}}</h4>
					<pre class="ast-diff">{{range .Diff}}<span class="ast-diff-{{if eq .Op "+"}}add{{else if eq .Op "-"}}del{{else}}ctx{{end}}"><span aria-hidden="true">{{.Op}} </span>{{.Text}}
</span>{{end}}</pre>
				</aside>
				</div>
			</section>
			<section id="pf-changes" role="tabpanel" aria-labelledby="pf-tab-changes" data-doc-panel="pf-changes"{{if not .Dirty}} hidden{{end}} data-testid="asc-policy-changes">
				{{if .Diff}}
				<pre class="ast-diff" aria-label="{{ctx.Locale.Tr "asc_rp.pf_changes"}}">{{range .Diff}}<span class="ast-diff-{{if eq .Op "+"}}add{{else if eq .Op "-"}}del{{else}}ctx{{end}}"><span aria-hidden="true">{{.Op}} </span>{{.Text}}
</span>{{end}}</pre>
				<p class="asc-trust-sub">{{ctx.Locale.Tr "asc_rp.pf_is_change"}}{{if .Maintainers}} {{ctx.Locale.Tr "asc_rp.pf_reviewers"}} {{range $i, $m := .Maintainers}}{{if $i}}, {{end}}<strong>{{$m}}</strong>{{end}}.{{end}}</p>
				<p><button type="button" class="ds-btn ds-btn-primary" data-doc-goto="pf-toml">{{ctx.Locale.Tr "asc_rp.pf_go_propose"}}</button></p>
				{{else}}
				<p class="asc-trust-sub">{{ctx.Locale.Tr "asc_rp.pf_nothing"}}</p>
				{{end}}
			</section>
			<div id="pf-toml" role="tabpanel" aria-labelledby="pf-tab-toml" data-doc-panel="pf-toml" hidden>
			<div class="ast-split">
				<form class="ds-form ast-policy-form" method="post" action="{{.PolicyURL}}/propose" data-testid="asc-policy-form">
					{{$.CsrfTokenHtml}}
					<input type="hidden" name="op" value="{{.Op}}">
					<input type="hidden" name="base" value="{{.Base}}">
					<div class="ds-field">
						<label for="asc-policy-text">.asc/policy.toml</label>
						<textarea id="asc-policy-text" class="ds-textarea ds-mono ast-policy-text" name="text" rows="18" spellcheck="false" autocapitalize="off" autocomplete="off" wrap="off" data-testid="asc-policy-text">{{.Draft}}</textarea>
					</div>
					<div class="ds-field">
						<label for="asc-policy-message">{{ctx.Locale.Tr "asc_rp.p_describe"}}</label>
						<input id="asc-policy-message" class="ds-input" name="message" type="text" maxlength="200" value="{{.Message}}" placeholder="{{ctx.Locale.Tr "asc_rp.p_message_ph"}}">
					</div>
					<div class="asc-trust-actions">
						<button class="ds-btn ds-btn-secondary" type="submit" formaction="{{.PolicyURL}}/check" data-testid="asc-policy-check">{{ctx.Locale.Tr "asc_rp.p_check"}}</button>
						<button class="ds-btn ds-btn-primary" type="submit" data-testid="asc-policy-propose"{{if or (not .Dirty) (and .View.Present (not .View.Maintainer))}} disabled{{end}}>{{ctx.Locale.Tr "asc_rp.p_propose"}}</button>
					</div>
					{{if not .Dirty}}<p class="asc-trust-sub">{{ctx.Locale.Tr "asc_rp.p_edit_first"}}</p>{{end}}
				</form>

				<div class="ast-meaning" data-testid="asc-policy-meaning">
					<h4 class="ast-meaning-title">{{ctx.Locale.Tr "asc_rp.p_means"}}</h4>
					{{if .View.Meaning}}
						<ul class="ast-meaning-list">{{range .View.Meaning}}<li>{{.}}</li>{{end}}</ul>
					{{else}}
						<p class="asc-trust-sub">{{ctx.Locale.Tr "asc_rp.p_nothing"}}</p>
					{{end}}
					{{if .View.MergeNote}}<p class="asc-trust-sub">{{.View.MergeNote}}</p>{{end}}
				</div>
			</div>
			</div>

			{{if .Preview}}
			<div class="ast-preview" data-testid="asc-policy-preview">
				<div class="ast-card-head">
					<h4 class="ast-card-title">{{ctx.Locale.Tr "asc_rp.p_draft"}}</h4>
					{{if .Preview.Valid}}<span class="ast-pill ast-pill-ok">{{ctx.Locale.Tr "asc_rp.p_valid"}}</span>{{else}}<span class="ast-pill ast-pill-no">{{ctx.Locale.Tr "asc_rp.p_not_valid"}}</span>{{end}}
				</div>
				{{if .Preview.Diagnostics}}
					<ul class="ast-diag" data-testid="asc-policy-diagnostics">
						{{range .Preview.Diagnostics}}
						<li class="ast-diag-{{if .Error}}error{{else}}warning{{end}}">
							<span class="ast-pill ast-pill-{{if .Error}}no{{else}}wn{{end}}">{{if .Error}}{{ctx.Locale.Tr "asc_rp.p_error"}}{{else}}{{ctx.Locale.Tr "asc_rp.p_warning"}}{{end}}</span>
							{{if .Line}}<span class="asc-trust-code">{{ctx.Locale.Tr "asc_rp.p_line" .Line}}{{if .Column}}, {{ctx.Locale.Tr "asc_rp.p_column" .Column}}{{end}}</span>{{end}}
							{{.Message}}
						</li>
						{{end}}
					</ul>
				{{end}}
				{{if and .Preview.Valid (not .Preview.StaysMaintainer)}}
					<div class="ds-banner ds-banner-warn" role="alert" data-testid="asc-policy-lockout">{{ctx.Locale.Tr "asc_rp.p_lockout"}}</div>
				{{end}}
				{{if .Preview.Meaning}}
					<h4 class="ast-meaning-title">{{ctx.Locale.Tr "asc_rp.p_draft_means"}}</h4>
					<ul class="ast-meaning-list">{{range .Preview.Meaning}}<li>{{.}}</li>{{end}}</ul>
				{{end}}
			</div>
			{{end}}

			{{if .Proposed}}
			<div class="ds-banner" role="status">{{ctx.Locale.Tr "asc_rp.p_proposed" .Proposed.Change}}</div>
			{{end}}
		</section>

		{{if .View.Table.Rows}}
		<section class="ast-card" aria-labelledby="asc-policy-who">
			<div class="ast-card-head">
				<h3 id="asc-policy-who" class="ast-card-title">{{ctx.Locale.Tr "asc_rp.p_who"}}</h3>
				<span class="ast-card-aside">{{ctx.Locale.Tr "asc_rp.p_computed"}}</span>
			</div>
			<div class="asc-trust-table-wrap" tabindex="0" role="region" aria-label="{{ctx.Locale.Tr "asc_trust.table_region"}}">
				<table class="ds-table asc-trust-table" data-testid="asc-policy-who">
					<thead>
						<tr><th scope="col">{{ctx.Locale.Tr "asc_rp.p_who_col"}}</th>{{range .View.Table.Columns}}<th scope="col">{{.}}</th>{{end}}</tr>
					</thead>
					<tbody>
						{{range .View.Table.Rows}}
						<tr>
							<th scope="row"><b>{{.Who}}</b>{{if .Detail}} <span class="text grey">({{.Detail}})</span>{{end}}</th>
							{{range .Cells}}<td><span class="ast-cell ast-cell-{{.Tone}}"{{if .Title}} title="{{.Title}}"{{end}}>{{.Text}}</span></td>{{end}}
						</tr>
						{{end}}
					</tbody>
				</table>
			</div>
			<p class="asc-trust-sub ast-card-foot">{{ctx.Locale.Tr "asc_rp.p_foot"}}</p>
		</section>
		{{end}}

		{{if .View.Usable}}
		<section class="ast-card" aria-labelledby="asc-policy-protections">
			<div class="ast-card-head"><h3 id="asc-policy-protections" class="ast-card-title">{{ctx.Locale.Tr "asc_rp.p_protections"}}</h3><span class="ast-card-aside">{{ctx.Locale.Tr "asc_rp.p_switch"}}</span></div>
			<ul class="ast-protections">
				{{range .View.Protections}}
				<li class="ast-protection" data-testid="asc-protection-{{.Key}}">
					<div class="ast-protection-text">
						<b>{{.Title}}</b>
						<div class="asc-trust-sub">{{.Help}}</div>
					</div>
					<span class="ast-pill ast-pill-{{if .On}}ok{{else}}ro{{end}}">{{if .On}}{{ctx.Locale.Tr "asc_rp.p_on"}}{{else}}{{ctx.Locale.Tr "asc_rp.p_off"}}{{end}}</span>
					<form method="post" action="{{$.AscPolicy.PolicyURL}}/protection">
						{{$.CsrfTokenHtml}}
						<input type="hidden" name="key" value="{{.Key}}">
						<input type="hidden" name="value" value="{{if .On}}off{{else}}on{{end}}">
						<input type="hidden" name="op" value="{{index $.AscPolicy.ToggleOps .Key}}">
						<button class="ds-btn ds-btn-secondary" type="submit">{{if .On}}{{ctx.Locale.Tr "asc_rp.p_turn_off"}}{{else}}{{ctx.Locale.Tr "asc_rp.p_turn_on"}}{{end}}</button>
					</form>
				</li>
				{{end}}
			</ul>
		</section>
		{{end}}
		{{end}}
	{{end}}
</div>
{{end}}
</div>
{{template "repo/settings/layout_footer" .}}
