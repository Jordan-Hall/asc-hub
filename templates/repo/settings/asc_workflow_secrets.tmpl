{{/*
The secrets that the workflows of a repository read (routers/web/repo/setting/asc_wfsecrets.go).
Template Attributes:
* AscWorkflowSecrets: the page data (Rows, Ops, SetOp, Problem, Unsupported, PageURL)
A value is typed here once and goes to asc. It is never shown again: the list holds names and hints.
*/}}
{{template "repo/settings/layout_head" (dict "ctxData" . "pageClass" "repository settings rv-trust-page")}}
<div class="repo-setting-content">
{{with .AscWorkflowSecrets}}
<div class="rv rv-trust-inline" data-testid="asc-workflow-secrets-page">
	<header class="rv-head rv-head-inline">
		<div class="rv-head-main">
			<div class="rv-eyebrow">{{ctx.Locale.Tr "asc_review.wfs_eyebrow"}}</div>
			<h1 class="rv-title">{{ctx.Locale.Tr "asc_review.wfs_title"}}</h1>
			<p class="rv-lead">{{ctx.Locale.Tr "asc_review.wfs_lead"}}</p>
		</div>
	</header>
	{{if .Unsupported}}
		<div class="rv-banner rv-banner-warn" role="status" data-testid="asc-workflow-secrets-unsupported"><div>{{ctx.Locale.Tr "asc_review.wfs_unsupported"}}</div></div>
	{{else}}
		{{if .Problem}}<div class="rv-banner rv-banner-err" role="alert" data-testid="asc-workflow-secrets-problem"><div>{{.Problem}}</div></div>
		{{else}}
		<section class="rv-card rv-gap" aria-labelledby="wfs-list">
			<div class="rv-card-h"><h2 id="wfs-list">{{ctx.Locale.Tr "asc_review.wfs_list"}}</h2><span class="rv-count rv-end">{{len .Rows}}</span></div>
			{{if .Rows}}
			<ul class="rv-list" data-testid="asc-workflow-secrets-rows">
				{{range .Rows}}
				<li class="rv-li">
					<div class="rv-li-main">
						<div class="rv-li-title"><code>{{.Name}}</code>{{if .Hint}} <span class="rv-faint">&hellip;{{.Hint}}</span>{{end}}</div>
						<div class="rv-li-sub">{{if .UpdatedBy}}{{ctx.Locale.Tr "asc_review.wfs_updated_by" .UpdatedBy}}{{end}}{{if not .Updated.IsZero}} {{DateUtils.TimeSince .Updated}}{{end}}</div>
					</div>
					<form method="post" action="{{$.AscWorkflowSecrets.PageURL}}/delete" class="rv-li-act">
						{{$.CsrfTokenHtml}}
						<input type="hidden" name="name" value="{{.Name}}">
						<input type="hidden" name="op" value="{{index $.AscWorkflowSecrets.Ops .Name}}">
						<button class="rv-btn rv-btn-secondary rv-btn-sm" type="submit" aria-label="{{ctx.Locale.Tr "asc_review.wfs_delete_named" .Name}}">{{ctx.Locale.Tr "asc_review.wfs_delete"}}</button>
					</form>
				</li>
				{{end}}
			</ul>
			{{else}}<p class="rv-card-b rv-muted" data-testid="asc-workflow-secrets-empty">{{ctx.Locale.Tr "asc_review.wfs_none"}}</p>{{end}}
		</section>

		<section class="rv-card rv-gap" aria-labelledby="wfs-set">
			<div class="rv-card-h"><h2 id="wfs-set">{{ctx.Locale.Tr "asc_review.wfs_set"}}</h2></div>
			<form class="rv-card-b rv-form" method="post" action="{{.PageURL}}" autocomplete="off" data-testid="asc-workflow-secrets-form">
				{{$.CsrfTokenHtml}}
				<input type="hidden" name="op" value="{{.SetOp}}">
				<div class="rv-field"><label class="rv-label" for="wfs-name">{{ctx.Locale.Tr "asc_review.wfs_name"}}</label><input class="rv-input rv-mono" id="wfs-name" name="name" required maxlength="64" pattern="[A-Za-z0-9_.\-]{1,64}" spellcheck="false" autocapitalize="none"><small class="rv-hint">{{ctx.Locale.Tr "asc_review.wfs_name_help"}}</small></div>
				<div class="rv-field"><label class="rv-label" for="wfs-value">{{ctx.Locale.Tr "asc_review.wfs_value"}}</label><textarea class="rv-input rv-mono" id="wfs-value" name="value" required rows="3" maxlength="16384" spellcheck="false" autocapitalize="none" autocomplete="off"></textarea><small class="rv-hint">{{ctx.Locale.Tr "asc_review.wfs_value_help"}}</small></div>
				<button class="rv-btn rv-btn-primary" type="submit">{{ctx.Locale.Tr "asc_review.wfs_save"}}</button>
			</form>
		</section>
		{{end}}
	{{end}}
</div>
{{end}}
</div>
{{template "repo/settings/layout_footer" .}}
