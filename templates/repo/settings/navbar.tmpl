{{/* The repository settings menu: the same shell as the account settings (user/settings/navbar). */}}
{{$base := print .RepoLink "/settings"}}
<nav class="ds-settings-nav" id="settings-menu" aria-label="{{ctx.Locale.Tr "repo.settings"}}">
	{{template "shared/ds/snav_bar" (dict "Title" (ctx.Locale.Tr "repo.settings"))}}
	<div class="ds-settings-nav-in">
		{{template "shared/ds/snav_who" (dict "Icon" "book" "Name" .Repository.Name "Sub" .Repository.OwnerName "Href" .RepoLink "Label" (ctx.Locale.Tr "asc_shell.sn_view_repo"))}}

		{{if and .AscEnabled (eq .Repository.StorageBackend "asc")}}
		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_repository"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" $base "Label" (ctx.Locale.Tr "repo.settings.options") "Icon" "sliders" "Active" .PageIsSettingsOptions)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/units") "Label" (ctx.Locale.Tr "repo.settings.units.units") "Icon" "layers" "Active" .PageIsRepoSettingsUnits)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/collaboration") "Label" (ctx.Locale.Tr "asc_shell.sn_access") "Icon" "users" "Active" .PageIsSettingsCollaboration)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/keys") "Label" (ctx.Locale.Tr "repo.settings.deploy_keys") "Icon" "key" "Active" .PageIsSettingsKeys)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/branchless") "Label" (ctx.Locale.Tr "repo.settings.asc_branchless") "Icon" "branch" "Active" .PageIsSettingsAscBranchless)}}
		</ul>
		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_rules"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/policy") "Label" (ctx.Locale.Tr "asc_shell.sn_policy_trust") "Icon" "shield-check" "Active" .PageIsSettingsAscPolicy)}}
			{{if not .Repository.IsEmpty}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/branches") "Label" (ctx.Locale.Tr "asc_shell.sn_branches_stacks") "Icon" "branch" "Active" .PageIsSettingsBranches)}}
			{{end}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/tags") "Label" (ctx.Locale.Tr "repo.settings.tags") "Icon" "tag" "Active" .PageIsSettingsTags)}}
		</ul>
		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_automation"}}</h2>
		<ul class="ds-settings-list">
			{{if not DisableWebhooks}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/hooks") "Label" (ctx.Locale.Tr "repo.settings.hooks") "Icon" "link" "Active" .PageIsSettingsHooks)}}
			{{end}}
			{{if and .EnableActions (not .UnitActionsGlobalDisabled) (.Permission.CanRead $.UnitTypeActions)}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/actions/secrets") "Label" (ctx.Locale.Tr "asc_shell.sn_secrets_vars") "Icon" "lock" "Active" .PageIsSharedSettingsSecrets)}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/actions/variables") "Label" (ctx.Locale.Tr "actions.variables") "Icon" "hash" "Active" .PageIsSharedSettingsVariables)}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/actions/runners") "Label" (ctx.Locale.Tr "actions.runners") "Icon" "cpu" "Active" .PageIsSharedSettingsRunners)}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/actions/permissions") "Label" (ctx.Locale.Tr "actions.permissions.title") "Icon" "shield-check" "Active" .PageIsSharedSettingsPermissions)}}
			{{end}}
		</ul>
		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_data"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/storage") "Label" (ctx.Locale.Tr "ascbyo.nav_storage") "Icon" "database" "Active" .PageIsSettingsAscStorage)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/ai") "Label" (ctx.Locale.Tr "ascbyo.nav_ai") "Icon" "sparkles" "Active" .PageIsSettingsAscAI)}}
		</ul>
		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_safety"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/security") "Label" (ctx.Locale.Tr "asc_shell.sn_secret_scanning") "Icon" "fingerprint" "Active" .PageIsSettingsAscSecurity)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/workflow-secrets") "Label" (ctx.Locale.Tr "asc_review.wfs_nav") "Icon" "key" "Active" .PageIsSettingsAscWorkflowSecrets)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/audit") "Label" (ctx.Locale.Tr "asc_shell.sn_audit_log") "Icon" "history" "Active" .PageIsSettingsAscAudit)}}
		</ul>
		{{else}}
		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_general"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" $base "Label" (ctx.Locale.Tr "repo.settings.options") "Icon" "sliders" "Active" .PageIsSettingsOptions)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/units") "Label" (ctx.Locale.Tr "repo.settings.units.units") "Icon" "layers" "Active" .PageIsRepoSettingsUnits)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/collaboration") "Label" (ctx.Locale.Tr "repo.settings.collaboration") "Icon" "users" "Active" .PageIsSettingsCollaboration)}}
			{{if and .AscEnabled (eq .Repository.StorageBackend "asc")}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/branchless") "Label" (ctx.Locale.Tr "repo.settings.asc_branchless") "Icon" "branch" "Active" .PageIsSettingsAscBranchless)}}
			{{end}}
		</ul>

		{{if .Repository.UnitEnabled $.Context $.UnitTypeCode}}
		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_code"}}</h2>
		<ul class="ds-settings-list">
			{{if not .Repository.IsEmpty}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/branches") "Label" (ctx.Locale.Tr "repo.settings.branches") "Icon" "branch" "Active" .PageIsSettingsBranches)}}
			{{end}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/tags") "Label" (ctx.Locale.Tr "repo.settings.tags") "Icon" "tag" "Active" .PageIsSettingsTags)}}
			{{if .SignedUser.CanEditGitHook}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/hooks/git") "Label" (ctx.Locale.Tr "repo.settings.githooks") "Icon" "terminal" "Active" .PageIsSettingsGitHooks)}}
			{{end}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/keys") "Label" (ctx.Locale.Tr "repo.settings.deploy_keys") "Icon" "key" "Active" .PageIsSettingsKeys)}}
			{{if .LFSStartServer}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/lfs") "Label" (ctx.Locale.Tr "repo.settings.lfs") "Icon" "database" "Active" .PageIsSettingsLFS)}}
			{{end}}
		</ul>
		{{end}}

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_integrations"}}</h2>
		<ul class="ds-settings-list">
			{{if not DisableWebhooks}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/hooks") "Label" (ctx.Locale.Tr "repo.settings.hooks") "Icon" "link" "Active" .PageIsSettingsHooks)}}
			{{end}}
			{{if and .EnableActions (not .UnitActionsGlobalDisabled) (.Permission.CanRead $.UnitTypeActions)}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/actions/permissions") "Label" (ctx.Locale.Tr "actions.permissions.title") "Icon" "shield-check" "Active" .PageIsSharedSettingsPermissions)}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/actions/runners") "Label" (ctx.Locale.Tr "actions.runners") "Icon" "cpu" "Active" .PageIsSharedSettingsRunners)}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/actions/secrets") "Label" (ctx.Locale.Tr "secrets.secrets") "Icon" "lock" "Active" .PageIsSharedSettingsSecrets)}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/actions/variables") "Label" (ctx.Locale.Tr "actions.variables") "Icon" "hash" "Active" .PageIsSharedSettingsVariables)}}
			{{end}}
		</ul>

		{{if and .AscEnabled (eq .Repository.StorageBackend "asc")}}
		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_byo"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/ai") "Label" (ctx.Locale.Tr "ascbyo.nav_ai") "Icon" "sparkles" "Active" .PageIsSettingsAscAI)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/storage") "Label" (ctx.Locale.Tr "ascbyo.nav_storage") "Icon" "database" "Active" .PageIsSettingsAscStorage)}}
		</ul>
		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_policy"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/policy") "Label" (ctx.Locale.Tr "asc_shell.sn_policy_trust") "Icon" "shield-check" "Active" .PageIsSettingsAscPolicy)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/security") "Label" (ctx.Locale.Tr "asc_shell.sn_secret_scanning") "Icon" "fingerprint" "Active" .PageIsSettingsAscSecurity)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/workflow-secrets") "Label" (ctx.Locale.Tr "asc_review.wfs_nav") "Icon" "key" "Active" .PageIsSettingsAscWorkflowSecrets)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/audit") "Label" (ctx.Locale.Tr "asc_shell.sn_audit_log") "Icon" "history" "Active" .PageIsSettingsAscAudit)}}
		</ul>
		{{end}}
		{{end}}
	</div>
</nav>
