<section class="ds-card wh-sec" aria-labelledby="wh-list-title">
	<div class="ds-card-h wh-head">
		<div class="ds-grow">
			<h2 id="wh-list-title">{{ctx.Locale.Tr "repo.settings.hooks"}}</h2>
			<p class="ds-card-sub">{{.Description}}</p>
		</div>
		<button type="button" class="ds-btn ds-btn-primary ds-btn-sm wh-add-btn" data-wh-add-open>{{ctx.Locale.Tr "repo.settings.add_webhook"}}</button>
	</div>
	{{if .Webhooks}}
		{{template "shared/webhook/list" (dict "Rows" .Webhooks "BaseLink" .BaseLink "ListLink" .BaseLink "Replay" .WebhookReplayInList)}}
	{{else}}
		<div class="ds-card-b">
			{{template "shared/ds/empty" (dict "Icon" "link" "Title" (ctx.Locale.Tr "asc_hooks.none_title") "Body" (ctx.Locale.Tr "asc_hooks.none_text"))}}
		</div>
	{{end}}
</section>
<button type="button" class="ds-btn ds-btn-primary ds-btn-block wh-add-phone" data-wh-add-open>{{ctx.Locale.Tr "repo.settings.add_webhook"}}</button>
{{template "repo/settings/webhook/add_dialog" .}}
