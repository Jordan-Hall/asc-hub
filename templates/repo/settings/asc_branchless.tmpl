{{template "repo/settings/layout_head" (dict "ctxData" . "pageClass" "repository settings asc-branchless-page")}}
	<div class="repo-setting-content">
		<h4 class="ds-card-top">{{ctx.Locale.Tr "repo.settings.asc_branchless"}}</h4>
		<div class="ds-card ds-card-b ds-card-attach">
			{{if .AscBranchlessError}}
				<div class="ds-banner ds-banner-warn" role="alert">{{ctx.Locale.Tr "repo.settings.asc_branchless.error"}}</div>
			{{else}}
				<p>{{ctx.Locale.Tr "repo.settings.asc_branchless.desc"}}</p>
				<dl class="tw-grid tw-grid-cols-1 tw-gap-2">
					<div>
						<dt class="tw-font-semibold">{{ctx.Locale.Tr "repo.settings.asc_branchless.mode"}}</dt>
						<dd>{{if .AscBranchless}}{{ctx.Locale.Tr "repo.settings.asc_branchless.mode_branchless"}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_branchless.mode_branches"}}{{end}}</dd>
					</div>
					<div>
						<dt class="tw-font-semibold">{{ctx.Locale.Tr "repo.settings.asc_branchless.cloud"}}</dt>
						<dd>{{if .AscCloud}}{{ctx.Locale.Tr "repo.settings.asc_branchless.on"}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_branchless.off"}}{{end}}</dd>
					</div>
					<div>
						<dt class="tw-font-semibold">{{ctx.Locale.Tr "repo.settings.asc_branchless.shared_refs"}}</dt>
						<dd>
							{{if .AscSharedRefs}}
								<ul class="tw-list-none tw-p-0 tw-m-0">
									{{range .AscSharedRefs}}<li><code>{{.}}</code></li>{{end}}
								</ul>
							{{else}}
								{{ctx.Locale.Tr "repo.settings.asc_branchless.shared_refs_none"}}
							{{end}}
						</dd>
					</div>
				</dl>
				<p class="tw-mt-4">{{ctx.Locale.Tr "repo.settings.asc_branchless.how" .AscRepoName}}</p>
			{{end}}
		</div>
	</div>
{{template "repo/settings/layout_footer" .}}
