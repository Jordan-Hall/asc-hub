{{template "repo/settings/layout_head" (dict "ctxData" . "pageClass" "repository settings collaboration")}}
	<div class="repo-setting-content">
		<p class="ds-hint rp-access-lede">{{ctx.Locale.Tr "asc_rp.access_lede"}}</p>
		{{if .AscAccessRequests}}
		<h4 class="ds-card-top" id="access-requests-title">{{ctx.Locale.Tr "asc_rp.access_requests_title"}}<span class="ds-count">{{len .AscAccessRequests}}</span></h4>
		<div class="ds-card ds-card-b ds-card-attach" data-testid="access-requests">
			<div class="flex-list" role="list" aria-labelledby="access-requests-title">
				{{range .AscAccessRequests}}
				<div class="flex-item" role="listitem" data-access-request="{{.User.Name}}">
					<div class="flex-item-leading"><a href="{{.User.HomeLink}}" aria-label="{{.User.GetDisplayName}}">{{ctx.AvatarUtils.Avatar .User 32}}</a></div>
					<div class="flex-item-main">
						<div class="flex-item-title">{{template "shared/user/name" .User}}</div>
						<div class="flex-item-body" data-request-role="{{.Role}}">{{ctx.Locale.Tr "asc_rp.access_request_asks" (ctx.Locale.Tr (print "repo.settings.collaboration." .Role)) (DateUtils.TimeSince .CreatedUnix)}}</div>
						{{if .Message}}<p class="rp-access-request-msg" data-request-message>{{.Message}}</p>{{end}}
					</div>
					<div class="flex-item-trailing">
						<form method="post" action="{{$.RepoLink}}/settings/collaboration/requests/grant">
							{{$.CsrfTokenHtml}}
							<input type="hidden" name="id" value="{{.ID}}">
							<button class="ds-btn ds-btn-primary ds-btn-sm" aria-label="{{ctx.Locale.Tr "asc_rp.access_request_grant_for" .User.GetDisplayName}}">{{ctx.Locale.Tr "asc_rp.access_request_grant"}}</button>
						</form>
						<form method="post" action="{{$.RepoLink}}/settings/collaboration/requests/dismiss">
							{{$.CsrfTokenHtml}}
							<input type="hidden" name="id" value="{{.ID}}">
							<button class="ds-btn ds-btn-secondary ds-btn-sm" aria-label="{{ctx.Locale.Tr "asc_rp.access_request_dismiss_for" .User.GetDisplayName}}">{{ctx.Locale.Tr "asc_rp.access_request_dismiss"}}</button>
						</form>
					</div>
				</div>
				{{end}}
			</div>
		</div>
		{{end}}
		<h4 class="ds-card-top">{{ctx.Locale.Tr "asc_rp.access_title"}}</h4>
		<div class="ds-card ds-card-b ds-card-attach" data-testid="access-list">
			<p class="ds-hint">{{ctx.Locale.Tr "asc_rp.access_desc"}}</p>
			{{$allowedToChangeTeams := or (not .RepoOwnerIsOrganization) .Org.RepoAdminChangeTeamAccess .Permission.IsOwner}}
			<form class="ui form ds-form rp-access-add" id="repo-collab-form" action="{{.RepoLink}}/settings/collaboration" method="post" data-testid="access-add">
				{{.CsrfTokenHtml}}
				<input type="hidden" name="kind" value="" data-access-kind>
				<div id="search-access-box" class="ui search input rp-access-find" data-url="{{.RepoLink}}/settings/collaboration/search" data-kind-person="{{ctx.Locale.Tr "asc_rp.access_kind_person"}}" data-kind-agent="{{ctx.Locale.Tr "asc_rp.agent"}}" data-kind-team="{{ctx.Locale.Tr "asc_rp.access_kind_team"}}">
					<label class="ds-sr" for="access-name">{{ctx.Locale.Tr "asc_rp.access_search"}}</label>
					<input class="prompt ds-input" id="access-name" name="collaborator" placeholder="{{ctx.Locale.Tr "asc_rp.access_search"}}" autocomplete="off" required>
				</div>
				<label class="ds-sr" for="access-role">{{ctx.Locale.Tr "asc_rp.access_role"}}</label>
				<select class="ds-select" id="access-role" name="role" aria-describedby="access-role-hint">
					{{range .AccessRoles}}<option value="{{.}}"{{if eq . "write"}} selected{{end}}>{{if eq . "maintain"}}{{ctx.Locale.Tr "asc_rp.access_maintain"}}{{else}}{{ctx.Locale.Tr (print "repo.settings.collaboration." .)}}{{end}}</option>{{end}}
				</select>
				<button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "asc_rp.access_add"}}</button>
				<p class="ds-hint rp-access-role-hint" id="access-role-hint">{{if .RepoOwnerIsOrganization}}{{ctx.Locale.Tr "asc_rp.access_role_hint_org"}}{{else}}{{ctx.Locale.Tr "asc_rp.access_role_hint"}}{{end}}</p>
			</form>

			<nav class="ds-tabs" aria-label="{{ctx.Locale.Tr "asc_rp.access_show"}}" data-testid="access-show">
				{{range $show := .AccessShows}}
				<a class="ds-tab" href="{{$.RepoLink}}/settings/collaboration{{if ne $show "all"}}?show={{$show}}{{end}}"{{if eq $.AccessShow $show}} aria-current="page"{{end}} data-show="{{$show}}">{{ctx.Locale.Tr (print "asc_rp.access_show_" $show)}}<span class="ds-count">{{index $.AccessCount $show}}</span></a>
				{{end}}
			</nav>

			{{if .AccessRows}}
			<div class="flex-list" role="list">
				{{range .AccessRows}}
				{{if eq .Kind "team"}}
				{{$team := .Team}}
				<div class="flex-item tw-items-center" role="listitem" data-access-row="team" data-name="{{$team.Name}}">
					<div class="flex-item-leading"><span class="rp-access-team" aria-hidden="true">{{svg "dsi-users" 20}}</span></div>
					<div class="flex-item-main">
						<div class="flex-item-title">
							<a class="text primary" href="{{AppSubUrl}}/org/{{$.OrgName|PathEscape}}/teams/{{$team.LowerName|PathEscape}}">{{$team.Name}}</a>
							<span class="ds-chip">{{ctx.Locale.Tr "asc_rp.access_kind_team"}}</span>
						</div>
						<div class="flex-item-body">{{ctx.Locale.TrN $team.NumMembers "asc_rp.access_members_one" "asc_rp.access_members_other" $team.NumMembers}}</div>
					</div>
					<div class="flex-item-trailing">
						<span class="rp-access-role" data-role="{{.Role}}">{{if eq .Role "owner"}}{{ctx.Locale.Tr "repo.settings.collaboration.owner"}}{{else if .Role}}{{ctx.Locale.Tr (print "repo.settings.collaboration." .Role)}}{{else}}{{ctx.Locale.Tr "repo.settings.collaboration.undefined"}}{{end}}</span>
						{{if $allowedToChangeTeams}}
						<span{{if $team.IncludesAllRepositories}} data-tooltip-content="{{ctx.Locale.Tr "repo.settings.delete_team_tip"}}"{{end}}>
							<button class="ds-btn ds-btn-danger ds-btn-sm inline delete-button{{if $team.IncludesAllRepositories}} disabled{{end}}" data-url="{{$.RepoLink}}/settings/collaboration/team/delete" data-id="{{$team.ID}}" data-modal-id="delete-collaborator" aria-label="{{ctx.Locale.Tr "asc_rp.access_remove_for" $team.Name}}">{{ctx.Locale.Tr "repo.settings.delete_collaborator"}}</button>
						</span>
						{{end}}
					</div>
				</div>
				{{else}}
				{{$u := .Collaborator}}
				<div class="flex-item tw-items-center" role="listitem" data-access-row="{{.Kind}}" data-name="{{$u.Name}}">
					<div class="flex-item-leading">
						<a href="{{$u.HomeLink}}" aria-label="{{$u.GetDisplayName}}"{{if $u.IsBot}} class="rp-agent-mark"{{end}}>{{ctx.AvatarUtils.Avatar $u.User 32}}</a>
					</div>
					<div class="flex-item-main">
						<div class="flex-item-title">
							{{template "shared/user/name" $u.User}}
							{{if $u.IsBot}}<span class="ds-chip ds-chip-agent">{{ctx.Locale.Tr "asc_rp.agent"}}</span>{{end}}
						</div>
						{{if and $u.IsBot $.AgentScope}}
						<div class="flex-item-body rp-agent-scope">{{if $.AgentScope.Off}}{{ctx.Locale.Tr "asc_rp.agent_scope_off"}}{{else}}{{ctx.Locale.Tr "asc_rp.agent_scope" $.AgentScope.Paths}}{{end}}</div>
						{{end}}
						<div class="flex-item-body" data-last-active>{{if .LastActive}}{{ctx.Locale.Tr "asc_rp.access_last_active" (DateUtils.TimeSince .LastActive)}}{{else}}{{ctx.Locale.Tr "asc_rp.access_never_active"}}{{end}}</div>
					</div>
					<div class="flex-item-trailing">
						<div class="ui inline dropdown access-mode" tabindex="0" aria-label="{{ctx.Locale.Tr "asc_rp.access_role_for" $u.GetDisplayName}}" data-url="{{$.RepoLink}}/settings/collaboration/access_mode" data-uid="{{$u.ID}}" data-last-value="{{if eq .Role "maintain"}}maintain{{else}}{{printf "%d" $u.Collaboration.Mode}}{{end}}" data-changed="{{ctx.Locale.Tr "asc_rp.access_changed" $u.GetDisplayName}}" data-undo="{{ctx.Locale.Tr "asc_rp.access_undo"}}" data-close="{{ctx.Locale.Tr "asc_rp.access_close"}}">
							<div class="text">{{if eq .Role "maintain"}}{{ctx.Locale.Tr "asc_rp.access_maintain"}}{{else if .Role}}{{ctx.Locale.Tr (print "repo.settings.collaboration." .Role)}}{{else}}{{ctx.Locale.Tr "repo.settings.collaboration.undefined"}}{{end}}</div>
							{{svg "octicon-triangle-down" 14 "dropdown icon"}}
							<div class="menu">
								<div class="item" data-text="{{ctx.Locale.Tr "repo.settings.collaboration.admin"}}" data-value="3">{{ctx.Locale.Tr "repo.settings.collaboration.admin"}}</div>
								<div class="item" data-text="{{ctx.Locale.Tr "asc_rp.access_maintain"}}" data-value="maintain">{{ctx.Locale.Tr "asc_rp.access_maintain"}}</div>
								<div class="item" data-text="{{ctx.Locale.Tr "repo.settings.collaboration.write"}}" data-value="2">{{ctx.Locale.Tr "repo.settings.collaboration.write"}}</div>
								<div class="item" data-text="{{ctx.Locale.Tr "repo.settings.collaboration.read"}}" data-value="1">{{ctx.Locale.Tr "repo.settings.collaboration.read"}}</div>
							</div>
						</div>
						<button class="ds-btn ds-btn-danger ds-btn-sm inline delete-button" data-url="{{$.RepoLink}}/settings/collaboration/delete" data-id="{{$u.ID}}" data-modal-id="delete-collaborator" aria-label="{{ctx.Locale.Tr "asc_rp.access_remove_for" $u.GetDisplayName}}">{{ctx.Locale.Tr "repo.settings.delete_collaborator"}}</button>
					</div>
				</div>
				{{end}}
				{{end}}
			</div>
			{{else}}
			<p class="ds-empty" data-testid="access-empty">{{ctx.Locale.Tr (print "asc_rp.access_none_" .AccessShow)}}</p>
			{{end}}
		</div>
		{{template "repo/settings/deploy_keys_section" .}}
	</div>

<div class="ui g-modal-confirm delete modal" id="delete-collaborator">
	<div class="header">
		{{svg "octicon-trash"}}
		{{ctx.Locale.Tr "repo.settings.collaborator_deletion"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "repo.settings.collaborator_deletion_desc"}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>

{{template "repo/settings/layout_footer" .}}
