{{/* Secrets and variables are one place in the menu and two lists: the tabs go between them (board RepoSettingsSecrets). */}}
<nav class="ds-tabs" role="tablist" aria-label="{{ctx.Locale.Tr "asc_shell.sn_secrets_vars"}}" data-testid="secrets-variables-tabs">
	<a class="ds-tab" role="tab" href="{{.RepoLink}}/settings/actions/secrets"{{if eq .PageType "secrets"}} aria-selected="true" aria-current="page"{{else}} aria-selected="false"{{end}}>{{ctx.Locale.Tr "secrets.secrets"}}</a>
	<a class="ds-tab" role="tab" href="{{.RepoLink}}/settings/actions/variables"{{if eq .PageType "variables"}} aria-selected="true" aria-current="page"{{else}} aria-selected="false"{{end}}>{{ctx.Locale.Tr "actions.variables"}}</a>
</nav>
