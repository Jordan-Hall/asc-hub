{{template "repo/settings/layout_head" (dict "ctxData" . "pageClass" "repository settings asc-trust-page")}}
<div class="repo-setting-content">
{{with .AscSecurity}}
<div class="asc-trust" data-testid="asc-security">
	<div class="asc-trust-head">
		<h2 class="asc-trust-title">{{ctx.Locale.Tr "asc_rp.p_secret"}}</h2>
	</div>
	<p class="asc-trust-lead">{{ctx.Locale.Tr "asc_rp.x_lead"}}</p>
	<nav class="asc-trust-links" aria-label="{{ctx.Locale.Tr "asc_rp.p_pages"}}">
		<a href="{{.PolicyURL}}">{{ctx.Locale.Tr "asc_rp.p_title"}}</a>
		<a href="{{.AuditURL}}">{{ctx.Locale.Tr "asc_rp.p_audit"}}</a>
	</nav>

	{{if .Unsupported}}
		<div class="ds-banner ds-banner-warn" role="status" data-testid="asc-security-unsupported">{{ctx.Locale.Tr "asc_rp.x_unsupported"}}</div>
	{{else}}
		{{if .Problem}}<div class="ds-banner ds-banner-err" role="alert" data-testid="asc-security-problem">{{.Problem}}</div>{{end}}

		{{if .Data}}
		<section class="ast-card" aria-labelledby="asc-sec-state">
			<div class="ast-card-head">
				<h3 id="asc-sec-state" class="ast-card-title">{{ctx.Locale.Tr "asc_rp.x_scanning"}}</h3>
				{{if .Data.Rules.BlockOnPush}}<span class="ast-pill ast-pill-ok" data-testid="asc-security-block">{{ctx.Locale.Tr "asc_rp.x_blocks"}}</span>{{else}}<span class="ast-pill ast-pill-wn" data-testid="asc-security-block">{{ctx.Locale.Tr "asc_rp.x_records"}}</span>{{end}}
				<form class="ast-inline-form" method="post" action="{{.SecurityURL}}/scan">
					{{$.CsrfTokenHtml}}
					<button class="ds-btn ds-btn-secondary" type="submit" data-testid="asc-security-scan">{{ctx.Locale.Tr "asc_rp.x_scan_now" .Branch}}</button>
				</form>
			</div>
			<p class="asc-trust-sub">{{ctx.Locale.Tr "asc_rp.x_where_set" .PolicyURL}}</p>
		</section>

		{{if .Blocked}}
		<section class="ast-card" aria-labelledby="asc-sec-blocked">
			<div class="ast-card-head"><h3 id="asc-sec-blocked" class="ast-card-title">{{ctx.Locale.Tr "asc_rp.x_refused"}}</h3><span class="ast-card-aside">{{ctx.Locale.Tr "asc_rp.x_from_audit"}}</span></div>
			<ul class="ast-blocked" data-testid="asc-security-blocked">
				{{range .Blocked}}
				<li>
					<b>{{ctx.Locale.Tr "asc_rp.x_blocked" (DateUtils.TimeSince .Time)}}</b> {{ctx.Locale.Tr "asc_rp.x_push_by" .Actor}}{{if .Target}} {{ctx.Locale.Tr "asc_rp.x_to"}} <code class="asc-trust-code">{{.Target}}</code>{{end}} {{ctx.Locale.Tr "asc_rp.x_was_refused"}}
					{{range .Details}}<span class="asc-trust-code">{{.Key}}: {{.Value}}</span> {{end}}
				</li>
				{{end}}
			</ul>
		</section>
		{{end}}

		<section class="ast-card" aria-labelledby="asc-sec-findings">
			<div class="ast-card-head"><h3 id="asc-sec-findings" class="ast-card-title">{{ctx.Locale.Tr "asc_rp.x_findings"}}</h3></div>
			<div class="ast-tabs" role="navigation" aria-label="{{ctx.Locale.Tr "asc_rp.x_finding_state"}}">
				{{range .States}}
				<a class="ast-tab{{if .Active}} active{{end}}" href="{{$.AscSecurity.SecurityURL}}?state={{.Key}}"{{if .Active}} aria-current="page"{{end}} data-testid="asc-findings-tab-{{.Key}}">{{.Label}} <span class="ast-count">{{.Count}}</span></a>
				{{end}}
			</div>
			<div class="asc-trust-table-wrap" tabindex="0" role="region" aria-label="{{ctx.Locale.Tr "asc_trust.table_region"}}">
				<table class="ui very basic table asc-trust-table" data-testid="asc-findings">
					<caption class="tw-sr-only">{{ctx.Locale.Tr "asc_rp.x_findings"}}</caption>
					<thead><tr><th scope="col">{{ctx.Locale.Tr "asc_rp.x_where"}}</th><th scope="col">{{ctx.Locale.Tr "asc_rp.x_rule"}}</th><th scope="col">{{ctx.Locale.Tr "asc_rp.x_seen"}}</th><th scope="col">{{ctx.Locale.Tr "asc_rp.x_state"}}</th><th scope="col"><span class="tw-sr-only">{{ctx.Locale.Tr "asc_rp.x_actions"}}</span></th></tr></thead>
					<tbody>
						{{range .Data.Findings.Rows}}
						<tr>
							<td><code class="asc-trust-code">{{.Location}}</code><div class="asc-trust-sub">{{ctx.Locale.Tr "asc_rp.x_starts_with"}} <code class="asc-trust-code">{{.Preview}}</code>{{if .Change}} {{ctx.Locale.Tr "asc_rp.x_in_change"}} <code class="asc-trust-code">{{.Change}}</code>{{end}}</div></td>
							<td><span class="ast-pill ast-pill-{{.Tone}}">{{.Severity}}</span> <code class="asc-trust-code">{{.Rule}}</code></td>
							<td class="asc-trust-nowrap">{{DateUtils.TimeSince .LastSeen}}</td>
							<td>{{.State}}{{if .ResolvedBy}}<div class="asc-trust-sub">{{ctx.Locale.Tr "asc_rp.x_by" .ResolvedBy}}</div>{{end}}{{if .Note}}<div class="asc-trust-sub">{{.Note}}</div>{{end}}</td>
							<td>
								<form class="ds-form ast-finding-form" method="post" action="{{$.AscSecurity.SecurityURL}}/finding">
									{{$.CsrfTokenHtml}}
									<input type="hidden" name="id" value="{{.ID}}">
									<input type="hidden" name="back" value="{{$.AscSecurity.State}}">
									<input type="hidden" name="op" value="{{index $.AscSecurity.Ops .ID}}">
									<label class="tw-sr-only" for="asc-finding-state-{{.ID}}">{{ctx.Locale.Tr "asc_rp.x_new_state"}}</label>
									<select id="asc-finding-state-{{.ID}}" class="ds-select" name="state">
										<option value="open"{{if eq .StateKey "open"}} selected{{end}}>{{ctx.Locale.Tr "asc_rp.x_open"}}</option>
										<option value="revoked"{{if eq .StateKey "revoked"}} selected{{end}}>{{ctx.Locale.Tr "asc_rp.x_revoked"}}</option>
										<option value="false_positive"{{if eq .StateKey "false_positive"}} selected{{end}}>{{ctx.Locale.Tr "asc_rp.x_false_positive"}}</option>
										<option value="accepted_risk"{{if eq .StateKey "accepted_risk"}} selected{{end}}>{{ctx.Locale.Tr "asc_rp.x_accepted_risk"}}</option>
									</select>
									<label class="tw-sr-only" for="asc-finding-note-{{.ID}}">{{ctx.Locale.Tr "asc_rp.x_note"}}</label>
									<input id="asc-finding-note-{{.ID}}" class="ds-input" name="note" type="text" maxlength="1024" placeholder="{{ctx.Locale.Tr "asc_rp.x_note"}}" autocomplete="off">
									<button class="ds-btn ds-btn-secondary" type="submit">{{ctx.Locale.Tr "asc_rp.x_save"}}</button>
								</form>
							</td>
						</tr>
						{{else}}
						<tr><td colspan="5" class="center aligned text grey" data-testid="asc-findings-empty">{{ctx.Locale.Tr "asc_rp.x_no_findings"}}</td></tr>
						{{end}}
					</tbody>
				</table>
			</div>
			{{if .NextURL}}<div class="asc-trust-actions"><a class="ds-btn ds-btn-secondary" href="{{.NextURL}}" rel="next">{{ctx.Locale.Tr "asc_rp.x_more"}}</a></div>{{end}}
		</section>

		<section class="ast-card" aria-labelledby="asc-sec-allow">
			<div class="ast-card-head"><h3 id="asc-sec-allow" class="ast-card-title">{{ctx.Locale.Tr "asc_rp.x_allowlist"}}</h3><span class="ast-card-aside">{{ctx.Locale.Tr "asc_rp.x_reviewed"}}</span></div>
			<p class="asc-trust-sub">{{ctx.Locale.Tr "asc_rp.x_allow_help"}}</p>
			<form class="ds-form" method="post" action="{{.SecurityURL}}/allowlist" data-testid="asc-allowlist-form">
				{{$.CsrfTokenHtml}}
				<input type="hidden" name="op" value="{{.AllowOp}}">
				<div class="ds-field">
					<label for="asc-allow-paths">{{ctx.Locale.Tr "asc_rp.x_paths"}}</label>
					<textarea id="asc-allow-paths" class="ds-textarea ds-mono" name="paths" rows="5" spellcheck="false" autocomplete="off" wrap="off" placeholder="tests/fixtures/**">{{.Allowlist}}</textarea>
				</div>
				<button class="ds-btn ds-btn-primary" type="submit" data-testid="asc-allowlist-save">{{ctx.Locale.Tr "asc_rp.x_propose_allow"}}</button>
			</form>
		</section>

		<section class="ast-card" aria-labelledby="asc-sec-rules">
			<div class="ast-card-head"><h3 id="asc-sec-rules" class="ast-card-title">{{ctx.Locale.Tr "asc_rp.x_rules"}}</h3><span class="ast-card-aside">{{ctx.Locale.Tr "asc_rp.x_rules_aside"}}</span></div>
			<div class="asc-trust-table-wrap" tabindex="0" role="region" aria-label="{{ctx.Locale.Tr "asc_trust.table_region"}}">
				<table class="ui very basic table asc-trust-table" data-testid="asc-rules">
					<caption class="tw-sr-only">{{ctx.Locale.Tr "asc_rp.x_scan_rules"}}</caption>
					<thead><tr><th scope="col">{{ctx.Locale.Tr "asc_rp.x_rule"}}</th><th scope="col">{{ctx.Locale.Tr "asc_rp.x_severity"}}</th><th scope="col">{{ctx.Locale.Tr "asc_rp.x_detector"}}</th><th scope="col">{{ctx.Locale.Tr "asc_rp.p_on"}}</th></tr></thead>
					<tbody>
						{{range .Data.Rules.Rules}}
						<tr>
							<td><b>{{.Name}}</b> <code class="asc-trust-code">{{.ID}}</code>{{if not .Builtin}} <span class="ast-pill ast-pill-ro">{{ctx.Locale.Tr "asc_rp.x_custom"}}</span>{{end}}<div class="asc-trust-sub">{{.Description}}</div></td>
							<td><span class="ast-pill ast-pill-{{.Tone}}">{{.Severity}}</span></td>
							<td>{{.Detector}}</td>
							<td>{{if .Enabled}}{{ctx.Locale.Tr "asc_rp.x_yes"}}{{else}}{{ctx.Locale.Tr "asc_rp.x_no"}}{{end}}</td>
						</tr>
						{{end}}
					</tbody>
				</table>
			</div>
		</section>
		{{end}}
	{{end}}
</div>
{{end}}
</div>
{{template "repo/settings/layout_footer" .}}
