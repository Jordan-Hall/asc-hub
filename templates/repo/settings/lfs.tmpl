{{template "repo/settings/layout_head" (dict "ctxData" . "pageClass" "repository settings lfs")}}
	<div class="repo-setting-content">
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "repo.settings.lfs_filelist"}} ({{ctx.Locale.Tr "admin.total" .Total}})
			<div class="ui right">
				<a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{.Link}}/locks">{{ctx.Locale.Tr "repo.settings.lfs_locks"}}</a>
				<a class="ds-btn ds-btn-primary ds-btn-sm" href="{{.Link}}/pointers">&nbsp;{{ctx.Locale.Tr "repo.settings.lfs_findpointerfiles"}}</a>
			</div>
		</h4>
		<table id="lfs-files-table" class="ui attached segment single line table">
			<tbody>
				{{range .LFSFiles}}
					<tr>
						<td>
							<a href="{{$.Link}}/show/{{.Oid}}" title="{{.Oid}}" class="ds-btn ds-btn-secondary tw-font-mono">
								{{ShortSha .Oid}}
							</a>
						</td>
						<td>{{ctx.Locale.TrSize .Size}}</td>
						<td>{{DateUtils.TimeSince .CreatedUnix}}</td>
						<td class="right aligned">
							<a class="ds-btn ds-btn-primary" href="{{$.Link}}/find?oid={{.Oid}}&size={{.Size}}">{{ctx.Locale.Tr "repo.settings.lfs_findcommits"}}</a>
							<button class="ds-btn ds-btn-danger show-modal" data-modal="#delete-{{.Oid}}">
								<span class="btn-octicon btn-octicon-danger" data-tooltip-content="{{ctx.Locale.Tr "repo.editor.delete_this_file"}}">{{svg "octicon-trash"}}</span>
							</button>
						</td>
					</tr>
				{{else}}
					<tr>
						<td colspan="4">{{ctx.Locale.Tr "repo.settings.lfs_no_lfs_files"}}</td>
					</tr>
				{{end}}
			</tbody>
		</table>
		{{template "base/paginate" .}}
		{{range .LFSFiles}}
			<dialog id="delete-{{.Oid}}">
				<article>
					<header>{{ctx.Locale.Tr "repo.settings.lfs_delete" .Oid}}</header>
					<div class="content">
						<p>{{ctx.Locale.Tr "repo.settings.lfs_delete_warning"}}</p>
					</div>
					<form class="ui form" action="{{$.Link}}/delete/{{.Oid}}" method="post">
						{{template "base/modal_actions_confirm"}}
					</form>
				</article>
			</dialog>
		{{end}}
	</div>
{{template "repo/settings/layout_footer" .}}
