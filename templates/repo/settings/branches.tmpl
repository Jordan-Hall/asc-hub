{{template "repo/settings/layout_head" (dict "ctxData" . "pageClass" "repository settings edit")}}
	<div class="repo-setting-content">
		{{if .Repository.IsArchived}}
			<div class="ds-banner ds-banner-warn">
				{{ctx.Locale.Tr "repo.settings.archive.branchsettings_unavailable"}}
			</div>
		{{else}}
			<h4 class="ds-card-top">
				{{ctx.Locale.Tr "repo.default_branch"}}
			</h4>
			<div class="ds-card ds-card-b ds-card-attach">
				<p>
					{{ctx.Locale.Tr "repo.settings.default_branch_desc"}}
				</p>
				<form class="tw-flex" action="{{.Link}}" method="post">
					<input type="hidden" name="action" value="default_branch">
					{{if not .Repository.IsEmpty}}
						<div class="ui dropdown selection search tw-flex-1 tw-mr-2 tw-max-w-96">
							{{svg "octicon-triangle-down" 14 "dropdown icon"}}
							<input type="hidden" name="branch" value="{{.Repository.DefaultBranch}}">
							<div class="default text">{{.Repository.DefaultBranch}}</div>
							<div class="menu">
								{{range .Branches}}
									<div class="item" data-value="{{.}}">{{.}}</div>
								{{end}}
							</div>
						</div>
						<button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "repo.settings.branches.update_default_branch"}}</button>
					{{end}}
				</form>
			</div>

			{{if .AscRules}}
			<h4 class="ds-card-top">{{ctx.Locale.Tr "repo.settings.asc_rules.title"}}</h4>
			<div class="ds-card ds-card-b ds-card-attach" data-testid="asc-rules">
				<p>{{ctx.Locale.Tr "repo.settings.asc_rules.desc" .AscRules.PolicyURL}}</p>
				{{if .AscRules.Problem}}<div class="ds-banner ds-banner-warn" role="status">{{.AscRules.Problem}}</div>{{end}}
				{{with .AscRules.Protection}}
				<dl class="rp-factstrip">
					<div><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.branch"}}</dt><dd class="ds-mono">{{.Branch}}</dd></div>
					<div><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.approvals"}}</dt><dd class="ds-num">{{.RequiredApprovals}}</dd></div>
					<div><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.checks"}}</dt><dd>{{if .StatusChecks}}{{range $i, $c := .StatusChecks}}{{if $i}}, {{end}}<span class="ds-mono">{{$c}}</span>{{end}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_rules.none"}}{{end}}</dd></div>
					<div><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.signed"}}</dt><dd>{{if .RequireSigned}}{{ctx.Locale.Tr "repo.settings.asc_rules.on"}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_rules.off"}}{{end}}</dd></div>
					<div><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.force"}}</dt><dd>{{if .AllowForcePush}}{{ctx.Locale.Tr "repo.settings.asc_rules.on"}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_rules.off"}}{{end}}</dd></div>
					<div><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.queue"}}</dt><dd>{{if .QueueOnly}}{{ctx.Locale.Tr "repo.settings.asc_rules.on"}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_rules.off"}}{{end}}</dd></div>
					<div><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.paths"}}</dt><dd>{{if .ProtectedPaths}}{{range $i, $c := .ProtectedPaths}}{{if $i}}, {{end}}<span class="ds-mono">{{$c}}</span>{{end}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_rules.none"}}{{end}}</dd></div>
				</dl>
				{{end}}
				<a class="ds-btn ds-btn-primary" href="{{.AscRules.PolicyURL}}">{{ctx.Locale.Tr "repo.settings.asc_rules.edit"}}</a>
			</div>
			{{else}}
			<h4 class="ds-card-top">
				{{ctx.Locale.Tr "repo.settings.protected_branch"}}
				<div class="ui right">
					<a class="ds-btn ds-btn-primary ds-btn-sm" href="{{$.Repository.Link}}/settings/branches/edit">{{ctx.Locale.Tr "repo.settings.branches.add_new_rule"}}</a>
				</div>
			</h4>

			<div class="ds-card ds-card-b ds-card-attach">
				<div class="flex-list">
					{{range .ProtectedBranches}}
						<div class="flex-item tw-items-center">
							<div class="flex-item-main">
								<div class="flex-item-title">
									<div class="ds-chip ds-chip-outline primary">{{.RuleName}}</div>
								</div>
							</div>
							<div class="flex-item-trailing">
								<a class="ds-btn ds-btn-secondary ds-btn-sm rm" href="{{$.Repository.Link}}/settings/branches/edit?rule_name={{.RuleName}}">{{ctx.Locale.Tr "repo.settings.edit_protected_branch"}}</a>
								<button class="ds-btn ds-btn-danger ds-btn-sm delete-button" data-url="{{$.Repository.Link}}/settings/branches/{{.ID}}/delete" data-id="{{.ID}}" data-modal-id="delete-protected-branch">
									{{ctx.Locale.Tr "repo.settings.protected_branch.delete_rule"}}
								</button>
							</div>
						</div>
					{{else}}
						<div class="flex-item center aligned">
							{{ctx.Locale.Tr "repo.settings.no_protected_branch"}}
						</div>
					{{end}}
				</div>
			</div>
			{{end}}
		{{end}}
	</div>

<div class="ui g-modal-confirm delete modal" id="delete-protected-branch">
	<div class="header">
		{{svg "octicon-trash"}}
		{{ctx.Locale.Tr "repo.settings.protected_branch_deletion"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "repo.settings.protected_branch_deletion_desc"}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>

{{template "repo/settings/layout_footer" .}}
