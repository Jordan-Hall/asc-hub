{{template "repo/settings/layout_head" (dict "ctxData" . "pageClass" "repository settings edit")}}
	<div class="repo-setting-content">
		{{if .Repository.IsArchived}}
			<div class="ds-banner ds-banner-warn">
				{{ctx.Locale.Tr "repo.settings.archive.branchsettings_unavailable"}}
			</div>
		{{else}}
			<h4 class="ds-card-top">
				{{ctx.Locale.Tr "repo.default_branch"}}
			</h4>
			<div class="ds-card ds-card-b ds-card-attach">
				<p>
					{{ctx.Locale.Tr "repo.settings.default_branch_desc"}}
				</p>
				{{if not .Permission.IsAdmin}}
				<p class="ds-mono" data-testid="default-branch">{{.Repository.DefaultBranch}}</p>
				<p class="ds-hint" data-testid="maintain-default-note">{{ctx.Locale.Tr "asc_rp.maintain_default_branch_note"}}</p>
				{{else}}
				<form class="tw-flex" action="{{.Link}}" method="post">
					<input type="hidden" name="action" value="default_branch">
					{{if not .Repository.IsEmpty}}
						<div class="ui dropdown selection search tw-flex-1 tw-mr-2 tw-max-w-96">
							{{svg "octicon-triangle-down" 14 "dropdown icon"}}
							<input type="hidden" name="branch" value="{{.Repository.DefaultBranch}}">
							<div class="default text">{{.Repository.DefaultBranch}}</div>
							<div class="menu">
								{{range .Branches}}
									<div class="item" data-value="{{.}}">{{.}}</div>
								{{end}}
							</div>
						</div>
						<button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "repo.settings.branches.update_default_branch"}}</button>
					{{end}}
				</form>
				{{end}}
			</div>

			{{if .AscRules}}
			<h4 class="ds-card-top">{{ctx.Locale.Tr "repo.settings.asc_rules.title"}}</h4>
			<div class="ds-card ds-card-b ds-card-attach" data-testid="asc-rules">
				<p>{{ctx.Locale.Tr "repo.settings.asc_rules.desc" .AscRules.PolicyURL}}</p>
				{{if .AscRules.Problem}}<div class="ds-banner ds-banner-warn" role="status">{{.AscRules.Problem}}</div>{{end}}
				{{with .AscRules.Protection}}
				<dl class="rp-factstrip">
					<div><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.branch"}}</dt><dd class="ds-mono">{{.Branch}}</dd></div>
					<div><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.approvals"}}</dt><dd class="ds-num">{{.RequiredApprovals}}</dd></div>
					<div><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.checks"}}</dt><dd>{{if .StatusChecks}}{{range $i, $c := .StatusChecks}}{{if $i}}, {{end}}<span class="ds-mono">{{$c}}</span>{{end}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_rules.none"}}{{end}}</dd></div>
					<div><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.signed"}}</dt><dd>{{if .RequireSigned}}{{ctx.Locale.Tr "repo.settings.asc_rules.on"}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_rules.off"}}{{end}}</dd></div>
					<div><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.force"}}</dt><dd>{{if .AllowForcePush}}{{ctx.Locale.Tr "repo.settings.asc_rules.on"}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_rules.off"}}{{end}}</dd></div>
					<div data-testid="asc-rules-lands"><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.lands"}}</dt><dd>{{if $.AscRules.Squash}}{{ctx.Locale.Tr "repo.settings.asc_rules.lands_squash"}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_rules.lands_keep"}}{{end}}</dd></div>
					<div data-testid="asc-rules-depth"><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.depth"}}</dt><dd>{{if $.AscRules.MaxDepth}}{{ctx.Locale.TrN $.AscRules.MaxDepth "repo.settings.asc_rules.depth_1" "repo.settings.asc_rules.depth_n" $.AscRules.MaxDepth}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_rules.depth_none"}}{{end}}</dd></div>
					<div data-testid="asc-rules-cleanup"><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.cleanup"}}</dt><dd>{{if $.AscRules.CleanupDays}}{{ctx.Locale.TrN $.AscRules.CleanupDays "repo.settings.asc_rules.cleanup_1" "repo.settings.asc_rules.cleanup_n" $.AscRules.CleanupDays}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_rules.cleanup_server"}}{{end}}</dd></div>
					<div data-testid="asc-rules-restack"><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.restack"}}</dt><dd>{{if $.AscRules.RestackOnMove}}{{ctx.Locale.Tr "repo.settings.asc_rules.on"}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_rules.off"}}{{end}}</dd></div>
					<div data-testid="asc-rules-writers"><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.writers"}}</dt><dd>{{if $.AscRules.WritersMayPush}}{{ctx.Locale.Tr "repo.settings.asc_rules.on"}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_rules.off"}}{{end}}</dd></div>
					<div data-testid="asc-rules-keep"><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.keep"}}</dt><dd>{{if $.AscRules.KeepApprovals}}{{ctx.Locale.Tr "repo.settings.asc_rules.on"}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_rules.off"}}{{end}}</dd></div>
					<div><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.queue"}}</dt><dd>{{if .QueueOnly}}{{ctx.Locale.Tr "repo.settings.asc_rules.on"}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_rules.off"}}{{end}}</dd></div>
					<div><dt>{{ctx.Locale.Tr "repo.settings.asc_rules.paths"}}</dt><dd>{{if .ProtectedPaths}}{{range $i, $c := .ProtectedPaths}}{{if $i}}, {{end}}<span class="ds-mono">{{$c}}</span>{{end}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_rules.none"}}{{end}}</dd></div>
				</dl>
				{{end}}
				<a class="ds-btn ds-btn-primary" href="{{.AscRules.PolicyURL}}">{{ctx.Locale.Tr "repo.settings.asc_rules.edit"}}</a>
			</div>
			{{if and .AscRules.Protection (not .AscRules.Problem)}}
			{{$r := .AscRules}}
			<h4 class="ds-card-top asc-refs-head">
				{{ctx.Locale.Tr "repo.settings.asc_refs.title"}}
				<a class="ds-btn ds-btn-primary ds-btn-sm" href="{{$r.AddURL}}" data-testid="asc-refs-add">{{ctx.Locale.Tr "repo.settings.asc_refs.add"}}</a>
			</h4>
			<div class="ds-card ds-card-attach asc-refs{{if $r.Panel}} asc-refs-open{{end}}" data-testid="asc-refs">
				<div class="ds-table-wrap asc-refs-list">
					<table class="ds-table">
						<thead><tr>
							<th scope="col">{{ctx.Locale.Tr "repo.settings.asc_refs.pattern"}}</th>
							<th scope="col">{{ctx.Locale.Tr "repo.settings.asc_refs.kind"}}</th>
							<th scope="col">{{ctx.Locale.Tr "repo.settings.asc_refs.can_land"}}</th>
							<th scope="col">{{ctx.Locale.Tr "repo.settings.asc_refs.force"}}</th>
							<th scope="col">{{ctx.Locale.Tr "repo.settings.asc_refs.signed"}}</th>
							<th scope="col"><span class="tw-sr-only">{{ctx.Locale.Tr "repo.settings.asc_refs.actions"}}</span></th>
						</tr></thead>
						<tbody>
							{{with $r.Protection}}
							<tr data-testid="asc-refs-trunk">
								<td class="ds-mono">{{.Branch}}</td>
								<td>{{ctx.Locale.Tr "repo.settings.asc_refs.kind_trunk"}}</td>
								<td>{{ctx.Locale.Tr "repo.settings.asc_refs.land_queue"}}{{if not .QueueOnly}}, {{ctx.Locale.Tr "repo.settings.asc_refs.land_push"}}{{end}}</td>
								<td>{{if .AllowForcePush}}{{ctx.Locale.Tr "repo.settings.asc_refs.allowed"}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_refs.never"}}{{end}}</td>
								<td>{{if .RequireSigned}}{{ctx.Locale.Tr "repo.settings.asc_refs.required"}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_refs.not_required"}}{{end}}</td>
								<td><a href="{{$r.PolicyURL}}">{{ctx.Locale.Tr "repo.settings.asc_refs.edit"}}</a></td>
							</tr>
							{{end}}
							{{range $r.Refs}}
							<tr data-testid="asc-refs-row" data-pattern="{{.Pattern}}">
								<td class="ds-mono">{{.Name}}</td>
								<td>{{if .IsTags}}{{ctx.Locale.Tr "repo.settings.asc_refs.kind_tags"}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_refs.kind_lines"}}{{end}}</td>
								<td>{{if .Land}}{{range $i, $w := .Land}}{{if $i}}, {{end}}{{ctx.Locale.Tr (printf "repo.settings.asc_refs.land_%s" $w)}}{{end}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_refs.land_nobody"}}{{end}}</td>
								<td>{{if .Force}}{{ctx.Locale.Tr "repo.settings.asc_refs.allowed"}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_refs.never"}}{{end}}{{if .Delete}} · {{ctx.Locale.Tr "repo.settings.asc_refs.deletable"}}{{end}}</td>
								<td>{{if .Signed}}{{ctx.Locale.Tr "repo.settings.asc_refs.required"}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_refs.not_required"}}{{end}}</td>
								<td class="asc-refs-actions">
									<a href="{{.EditURL}}">{{ctx.Locale.Tr "repo.settings.asc_refs.edit"}}</a>
									<form method="post" action="{{$r.RemoveURL}}">
										{{$.CsrfTokenHtml}}
										<input type="hidden" name="pattern" value="{{.Pattern}}">
										<input type="hidden" name="base" value="{{$r.Base}}">
										<input type="hidden" name="op" value="{{$r.Op}}">
										<button class="ds-btn ds-btn-ghost ds-btn-sm" aria-label="{{ctx.Locale.Tr "repo.settings.asc_refs.remove_for" .Name}}">{{ctx.Locale.Tr "repo.settings.asc_refs.remove"}}</button>
									</form>
								</td>
							</tr>
							{{end}}
						</tbody>
					</table>
					{{if not $r.Refs}}<p class="asc-refs-empty">{{ctx.Locale.Tr "repo.settings.asc_refs.only_trunk"}}</p>{{end}}
				</div>
				{{with $r.Panel}}
				<aside class="asc-refs-panel" aria-labelledby="asc-refs-panel-title" data-testid="asc-refs-panel">
					<div class="asc-refs-panel-head">
						<h5 id="asc-refs-panel-title">{{if .Was}}{{ctx.Locale.Tr "repo.settings.asc_refs.edit_title"}}{{else}}{{ctx.Locale.Tr "repo.settings.asc_refs.add_title"}}{{end}}</h5>
						<a class="ds-btn ds-btn-ghost ds-btn-sm" href="{{$r.RulesURL}}">{{ctx.Locale.Tr "repo.settings.asc_refs.close"}}</a>
					</div>
					{{if .Problem}}<div class="ds-banner ds-banner-warn" role="alert">{{.Problem}}</div>{{end}}
					<form method="post" action="{{$r.SaveURL}}">
						{{$.CsrfTokenHtml}}
						<input type="hidden" name="was" value="{{.Was}}">
						<input type="hidden" name="base" value="{{$r.Base}}">
						<input type="hidden" name="op" value="{{$r.Op}}">
						<div class="ds-field"><label for="asc-refs-kind">{{ctx.Locale.Tr "repo.settings.asc_refs.kind"}}</label>
							<select id="asc-refs-kind" class="ds-select" name="kind">
								<option value="branches"{{if not .Tags}} selected{{end}}>{{ctx.Locale.Tr "repo.settings.asc_refs.kind_lines"}}</option>
								<option value="tags"{{if .Tags}} selected{{end}}>{{ctx.Locale.Tr "repo.settings.asc_refs.kind_tags"}}</option>
							</select>
						</div>
						<div class="ds-field"><label for="asc-refs-name">{{ctx.Locale.Tr "repo.settings.asc_refs.pattern"}}</label>
							<input id="asc-refs-name" class="ds-input ds-mono" name="name" required maxlength="256" value="{{.Name}}" placeholder="release/*" aria-describedby="asc-refs-name-help">
							<p id="asc-refs-name-help" class="ds-help">{{ctx.Locale.Tr "repo.settings.asc_refs.pattern_help"}}</p>
						</div>
						<fieldset class="ds-fieldset"><legend>{{ctx.Locale.Tr "repo.settings.asc_refs.who"}}</legend>
							{{$rule := .Rule}}
							{{range $r.LandWords}}
							<div class="ds-check"><input type="checkbox" id="asc-refs-land-{{.}}" name="land" value="{{.}}"{{if $rule.Lets .}} checked{{end}}><label for="asc-refs-land-{{.}}">{{ctx.Locale.Tr (printf "repo.settings.asc_refs.who_%s" .)}}</label></div>
							{{end}}
						</fieldset>
						<label class="ds-switch"><input type="checkbox" role="switch" name="signed"{{if .Rule.Signed}} checked{{end}}><span class="ds-switch-track"></span><span>{{ctx.Locale.Tr "repo.settings.asc_refs.require_signed"}}</span></label>
						<label class="ds-switch"><input type="checkbox" role="switch" name="force"{{if .Rule.Force}} checked{{end}}><span class="ds-switch-track"></span><span>{{ctx.Locale.Tr "repo.settings.asc_refs.allow_force"}}</span></label>
						<label class="ds-switch"><input type="checkbox" role="switch" name="delete"{{if .Rule.Delete}} checked{{end}}><span class="ds-switch-track"></span><span>{{ctx.Locale.Tr "repo.settings.asc_refs.allow_delete"}}</span></label>
						<p class="ds-help">{{ctx.Locale.Tr "repo.settings.asc_refs.proposed"}}</p>
						<button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "repo.settings.asc_refs.save"}}</button>
					</form>
				</aside>
				{{end}}
			</div>
			{{end}}
			{{else}}
			<h4 class="ds-card-top">
				{{ctx.Locale.Tr "repo.settings.protected_branch"}}
				<div class="ui right">
					<a class="ds-btn ds-btn-primary ds-btn-sm" href="{{$.Repository.Link}}/settings/branches/edit">{{ctx.Locale.Tr "repo.settings.branches.add_new_rule"}}</a>
				</div>
			</h4>

			{{if .AscRemovedRules}}
			<div class="ds-card ds-card-b ds-card-attach rp-rule-removed" data-testid="removed-rules" role="region" aria-label="{{ctx.Locale.Tr "repo.settings.asc_rules.removed_title"}}">
				<div class="flex-list">
					{{range .AscRemovedRules}}
						<form class="flex-item tw-items-center" method="post" action="{{$.Repository.Link}}/settings/branches/removed/{{.ID}}/restore" data-removed-rule="{{.RuleName}}">
							{{$.CsrfTokenHtml}}
							<div class="flex-item-main">
								<div class="flex-item-title">{{ctx.Locale.Tr "repo.settings.asc_rules.removed_row" .RuleName}}</div>
								<div class="flex-item-body">{{ctx.Locale.Tr "repo.settings.asc_rules.undo_until" (DateUtils.AbsoluteShort .Until)}}</div>
							</div>
							<div class="flex-item-trailing">
								<button class="ds-btn ds-btn-secondary ds-btn-sm" type="submit" aria-label="{{ctx.Locale.Tr "repo.settings.asc_rules.undo_for" .RuleName}}">{{ctx.Locale.Tr "repo.settings.asc_rules.undo"}}</button>
							</div>
						</form>
					{{end}}
				</div>
			</div>
			{{end}}

			{{if .ProtectedBranches}}
			<div class="ds-card ds-card-b ds-card-attach">
				<div class="flex-list">
					{{range .ProtectedBranches}}
						<div class="flex-item tw-items-center">
							<div class="flex-item-main">
								<div class="flex-item-title">
									<div class="ds-chip ds-chip-outline primary">{{.RuleName}}</div>
								</div>
							</div>
							<div class="flex-item-trailing">
								<a class="ds-btn ds-btn-secondary ds-btn-sm rm" href="{{$.Repository.Link}}/settings/branches/edit?rule_name={{.RuleName}}">{{ctx.Locale.Tr "repo.settings.edit_protected_branch"}}</a>
								<button class="ds-btn ds-btn-danger ds-btn-sm delete-button" data-url="{{$.Repository.Link}}/settings/branches/{{.ID}}/delete" data-id="{{.ID}}" data-modal-id="delete-protected-branch">
									{{ctx.Locale.Tr "repo.settings.protected_branch.delete_rule"}}
								</button>
							</div>
						</div>
					{{end}}
				</div>
			</div>
			{{else}}
			{{template "repo/settings/rules_empty" .}}
			{{end}}
			{{end}}
		{{end}}
	</div>

<div class="ui g-modal-confirm delete modal" id="delete-protected-branch">
	<div class="header">
		{{svg "octicon-trash"}}
		{{ctx.Locale.Tr "repo.settings.protected_branch_deletion"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "repo.settings.protected_branch_deletion_desc"}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>

{{template "repo/settings/layout_footer" .}}
