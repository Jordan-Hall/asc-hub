{{/*
Confirmation page of a stack operation: the dry run, then a form that posts to the operation (asc_confirm.go).
Template Attributes:
* AscOp: queue, unqueue, merge, restack or revert (checked by the handler before the page renders)
* AscRows: []AscConfirmRow, the pull requests or changes the operation meets
* AscCanConfirm: bool, false disables the button (a blocker, or nothing to do)
* AscFailure: string, why it cannot go on (already translated)
* AscPreviewNote: string, an informational line (already translated)
* AscPaused, AscNeedsContentMerge, AscNoContentMerge, AscReady: merge and queue only
* AscScopeThis, AscSquash: revert only
* AscAction: the URL the form posts to; AscBack: the pull request page
Every text comes from the locale or from the handler; pull request titles are escaped by the template engine.
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository asc-confirm asc-repo-page rv-trust-page">
	{{template "repo/header" .}}
	<div class="rv rv-page">
		{{template "base/alert" .}}
		<div class="rv-narrow asc-confirm-box" data-testid="asc-confirm" data-asc-op="{{.AscOp}}">
			<header class="rv-head">
				<div class="rv-head-main">
					<div class="rv-eyebrow"><a href="{{.AscBack}}">{{ctx.Locale.Tr "asc_review.rev_back_change"}}</a></div>
					<h1 class="rv-title">{{.Title}}</h1>
				</div>
			</header>
			<p class="rv-lead">{{ctx.Locale.Tr (printf "repo.pulls.asc_op.desc.%s" .AscOp)}}</p>

			{{if eq .AscOp "revert"}}
			<form class="rv-form rv-card rv-gap asc-revert-options" method="get" action="{{.AscBack}}/asc/confirm">
				<input type="hidden" name="op" value="revert">
				<div class="rv-card-b rv-stack">
					<label class="rv-check" for="asc-scope-stack">
						<input id="asc-scope-stack" type="radio" name="scope" value="stack"{{if not .AscScopeThis}} checked{{end}}>
						<span>{{ctx.Locale.Tr "repo.pulls.asc_op.revert_scope_stack"}}</span>
					</label>
					<label class="rv-check" for="asc-scope-this">
						<input id="asc-scope-this" type="radio" name="scope" value="this"{{if .AscScopeThis}} checked{{end}}>
						<span>{{ctx.Locale.Tr "repo.pulls.asc_op.revert_scope_this"}}</span>
					</label>
					<label class="rv-check" for="asc-squash">
						<input id="asc-squash" type="checkbox" name="squash" value="1"{{if .AscSquash}} checked{{end}}>
						<span>{{ctx.Locale.Tr "repo.pulls.asc_op.revert_squash"}}</span>
					</label>
				</div>
				<div class="rv-card-f"><button class="rv-btn rv-btn-secondary" type="submit">{{ctx.Locale.Tr "repo.pulls.asc_op.preview"}}</button></div>
			</form>
			{{end}}

			{{if .AscFailure}}
			<div class="rv-banner rv-banner-err rv-gap asc-op-message" role="alert" data-testid="asc-failure"><div>{{svg "octicon-x-circle" 16}} {{.AscFailure}}</div></div>
			{{end}}
			{{if .AscPreviewNote}}
			<div class="rv-banner rv-gap asc-op-message" role="status"><div>{{.AscPreviewNote}}</div></div>
			{{end}}
			{{if .AscPaused}}
			<div class="rv-banner rv-banner-warn rv-gap asc-op-message" role="status"><div>{{svg "octicon-alert" 16}} {{ctx.Locale.Tr "repo.pulls.asc_op.paused_note"}}</div></div>
			{{end}}
			{{if and .AscNeedsContentMerge .AscNoContentMerge}}
			<div class="rv-banner rv-banner-warn rv-gap asc-op-message" role="status" data-testid="asc-content-merge"><div>{{svg "octicon-alert" 16}} {{ctx.Locale.Tr "repo.pulls.asc_op.content_merge_note"}}</div></div>
			{{end}}

			{{if .AscRows}}
			<section class="rv-card rv-gap" aria-label="{{ctx.Locale.Tr "asc_review.rev_dry_run"}}">
				<div class="rv-tablewrap">
					<table class="rv-tbl rv-tbl-stack asc-stack asc-op-table" data-testid="asc-rows">
						<thead>
							<tr>
								<th scope="col">{{ctx.Locale.Tr "repo.pulls.asc_op.col_pull"}}</th>
								<th scope="col">{{ctx.Locale.Tr "repo.pulls.asc_op.col_state"}}</th>
								<th scope="col">{{ctx.Locale.Tr "repo.pulls.asc_op.col_detail"}}</th>
							</tr>
						</thead>
						<tbody>
							{{range .AscRows}}
							<tr>
								<td class="rv-cell-main" data-label="{{ctx.Locale.Tr "repo.pulls.asc_op.col_pull"}}">
									{{if .Link}}<a href="{{.Link}}">#{{.Index}} {{.Title}}</a>{{else}}<span class="rv-mono">{{.Change}}</span>{{end}}
								</td>
								<td data-label="{{ctx.Locale.Tr "repo.pulls.asc_op.col_state"}}">
									{{$tone := "info"}}
									{{if or (eq .Status "ready") (eq .Status "merged") (eq .Status "rewritten") (eq .Status "revert")}}{{$tone = "ok"}}
									{{else if or (eq .Status "not_ready") (eq .Status "queued_blocked") (eq .Status "skipped_frozen")}}{{$tone = "warn"}}
									{{else if or (eq .Status "conflict") (eq .Status "blocked") (eq .Status "cancelled")}}{{$tone = "err"}}{{end}}
									<span class="rv-pill rv-pill-{{$tone}} asc-state asc-state-{{.Status}}">{{ctx.Locale.Tr (printf "repo.pulls.asc_op.state.%s" .Status)}}</span>
								</td>
								<td class="rv-muted{{if not .Detail}} rv-cell-empty{{end}}" data-label="{{ctx.Locale.Tr "repo.pulls.asc_op.col_detail"}}">{{.Detail}}</td>
							</tr>
							{{end}}
						</tbody>
					</table>
				</div>
			</section>
			{{end}}

			<form class="rv-form rv-gap asc-op-form" method="post" action="{{.AscAction}}">
				{{.CsrfTokenHtml}}
				{{if eq .AscOp "revert"}}
					<input type="hidden" name="scope" value="{{if .AscScopeThis}}this{{else}}stack{{end}}">
					{{if .AscSquash}}<input type="hidden" name="squash" value="1">{{end}}
				{{end}}
				<div class="rv-sticky asc-op-buttons">
					<button class="rv-btn rv-btn-primary" type="submit" data-testid="asc-confirm-button"{{if not .AscCanConfirm}} disabled aria-disabled="true"{{end}}>{{ctx.Locale.Tr (printf "repo.pulls.asc_op.confirm.%s" .AscOp)}}</button>
					<a class="rv-btn rv-btn-secondary" href="{{.AscBack}}">{{ctx.Locale.Tr "repo.pulls.asc_op.cancel"}}</a>
				</div>
			</form>
		</div>
	</div>
</div>
{{template "base/footer" .}}
