{{/* Props: HdrMainData (the page data), OwnH1 (the page has its own h1, so the name of the repository is not one) */}}
{{$p := .HdrMainData}}{{$own := .OwnH1}}
{{$ready := not (or $p.Repository.IsBeingCreated $p.Repository.IsBroken)}}
<div class="rp-top">
	<div class="ds-container rp-top-in">
		{{with $p.Repository}}
		<div class="rp-head">
			<div class="rp-head-main">
				<div class="rp-title-row">
					{{if $own}}<p class="rp-title"><a class="rp-owner" href="{{.Owner.HomeLink}}">{{.Owner.Name}}</a><span class="rp-sep" aria-hidden="true">/</span><a class="rp-name" href="{{$p.RepoLink}}">{{.Name}}</a></p>{{else}}<h1 class="rp-title"><a class="rp-owner" href="{{.Owner.HomeLink}}">{{.Owner.Name}}</a><span class="rp-sep" aria-hidden="true">/</span><a class="rp-name" href="{{$p.RepoLink}}">{{.Name}}</a></h1>{{end}}
					{{if .IsPrivate}}<span class="ds-chip ds-chip-outline">{{if .IsInternal}}{{ctx.Locale.Tr "repo.desc.internal"}}{{else}}{{ctx.Locale.Tr "repo.desc.private"}}{{end}}</span>
					{{else if .Owner.Visibility.IsPrivate}}<span class="ds-chip ds-chip-outline">{{ctx.Locale.Tr "repo.desc.internal"}}</span>{{end}}
					{{if .IsArchived}}<span class="ds-chip ds-chip-warn">{{ctx.Locale.Tr "repo.desc.archived"}}</span>{{end}}
					{{if .IsTemplate}}<span class="ds-chip ds-chip-info">{{ctx.Locale.Tr "repo.desc.template"}}</span>{{end}}
					{{if eq .ObjectFormatName "sha256"}}<span class="ds-chip ds-chip-outline">{{ctx.Locale.Tr "repo.desc.sha256"}}</span>{{end}}
				</div>
				{{if .IsFork}}<p class="rp-flag">{{ctx.Locale.Tr "repo.forked_from"}} <a href="{{.BaseRepo.Link}}">{{.BaseRepo.FullName}}</a></p>{{end}}
				{{if .IsGenerated}}<p class="rp-flag">{{ctx.Locale.Tr "repo.generated_from"}} <a href="{{(.TemplateRepo ctx).Link}}">{{(.TemplateRepo ctx).FullName}}</a></p>{{end}}
				{{if $p.PullMirror}}
					{{$address := MirrorRemoteAddress $p.Context $p.PullMirror}}
					<p class="rp-flag">{{ctx.Locale.Tr "repo.mirror_from"}} <a target="_blank" rel="noopener noreferrer" href="{{$address.Address}}">{{$address.Address}}</a>{{if $p.PullMirror.UpdatedUnix}} {{ctx.Locale.Tr "repo.mirror_sync"}} {{DateUtils.TimeSince $p.PullMirror.UpdatedUnix}}{{end}}</p>
				{{end}}
				{{if .Description}}<p class="rp-desc ds-only-mobile">{{.Description}}</p>{{end}}
			</div>
			{{if $ready}}
			<div class="rp-acts">
				{{if $p.RepoTransfer}}
					<form method="post" action="{{$p.RepoLink}}/action/accept_transfer?redirect_to={{$p.RepoLink}}">
						<button type="submit" class="ds-btn ds-btn-primary ds-btn-sm"{{if not $p.CanUserAcceptTransfer}} disabled title="{{ctx.Locale.Tr "repo.transfer.no_permission_to_accept"}}"{{end}}>{{ctx.Locale.Tr "repo.transfer.accept"}}</button>
					</form>
					<form method="post" action="{{$p.RepoLink}}/action/reject_transfer?redirect_to={{$p.RepoLink}}">
						<button type="submit" class="ds-btn ds-btn-danger ds-btn-sm"{{if not $p.CanUserAcceptTransfer}} disabled title="{{ctx.Locale.Tr "repo.transfer.no_permission_to_reject"}}"{{end}}>{{ctx.Locale.Tr "repo.transfer.reject"}}</button>
					</form>
				{{end}}
				<details class="rp-acts-more" data-asc-open-from="640">
					<summary class="rp-act rp-act-icon rp-acts-more-btn" aria-label="{{ctx.Locale.Tr "repo.more_operations"}}">{{svg "dsi-dots" 18}}</summary>
					<div class="rp-acts-more-body">
						{{template "repo/watch_unwatch" $p}}
						{{if not $p.DisableStars}}{{template "repo/star_unstar" $p}}{{end}}
						{{if not $p.DisableForks}}{{template "repo/header_fork" $p}}{{end}}
						{{if $p.EnableFeed}}<a class="rp-act rp-act-icon ds-hide-xs" href="{{$p.RepoLink}}.rss" aria-label="{{ctx.Locale.Tr "rss_feed"}}" title="{{ctx.Locale.Tr "rss_feed"}}">{{svg "octicon-rss" 16}}</a>{{end}}
					</div>
				</details>
				{{if and $p.IsModerationEnabled $p.IsSigned (not $p.IsRepositoryAdmin)}}
					<a class="rp-act rp-act-icon" href="{{AppSubUrl}}/report_abuse?type=repo&id={{$p.Repository.ID}}" aria-label="{{ctx.Locale.Tr "moderation.report_content"}}" title="{{ctx.Locale.Tr "moderation.report_content"}}">{{svg "dsi-flag" 16}}</a>
				{{end}}
			</div>
			{{end}}
		</div>
		{{end}}
		{{template "repo/header_tabs" $p}}
	</div>
</div>
