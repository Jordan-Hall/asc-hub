{{/*
The task form (routers/web/repo/asc_agents.go).
Template Attributes:
* AscAgentForm: *ascAgentForm (values as typed, Errors by field, Summary)
* AscAgentKeys: []ascAgentKeyOption (the AI keys the person may pick), AscAgentModelsJSON: model ids per key, as JSON
* AscBudgetFields: the names of the budget fields; AscAgentPolicy: see repo/asc_agents_policy
* CsrfTokenHtml
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository rv-agents">
	{{template "repo/header" .}}
	<div class="rv rv-page">
		{{template "base/alert" .}}
		<div class="rv-area">{{template "repo/asc_agents_nav" .}}</div>
		<header class="rv-head">
			<div class="rv-head-main">
				<div class="rv-eyebrow">{{.Repository.FullName}} · {{ctx.Locale.Tr "asc_review.agents_eyebrow"}}</div>
				<h1 class="rv-title">{{ctx.Locale.Tr "asc_review.new_title"}}</h1>
				<p class="rv-lead">{{ctx.Locale.Tr "asc_review.new_lead"}}</p>
			</div>
		</header>
		{{template "repo/asc_agents_notice" .}}

		<div class="rv-cols rv-cols-main-side">
			<form class="rv-card rv-form-card" method="post" action="{{.AscAgentsBase}}/new" data-testid="asc-agent-form">
				{{.CsrfTokenHtml}}
				<input type="hidden" name="op" value="{{.AscAgentForm.OpID}}">
				<div class="rv-card-b rv-form">
					{{if .AscAgentForm.Summary}}<div class="rv-banner rv-banner-err" role="alert"><div>{{.AscAgentForm.Summary}}</div></div>{{end}}

					<div class="rv-field">
						<label class="rv-label" for="asc-ag-task">{{ctx.Locale.Tr "asc_review.new_task"}}</label>
						<textarea class="rv-textarea rv-textarea-lg" id="asc-ag-task" data-asc-estimate-task name="task" rows="8" required maxlength="{{.AscAgentsMaxTask}}" aria-describedby="asc-ag-task-help{{if index .AscAgentForm.Errors "task"}} asc-ag-task-err{{end}}"{{if index .AscAgentForm.Errors "task"}} aria-invalid="true"{{end}}>{{.AscAgentForm.Task}}</textarea>
						<small id="asc-ag-task-help" class="rv-hint">{{ctx.Locale.Tr "asc_review.new_task_help"}}</small>
						{{with index .AscAgentForm.Errors "task"}}<div id="asc-ag-task-err" class="rv-error" role="alert">{{.}}</div>{{end}}
					</div>

					<div class="rv-field">
						<label class="rv-label" for="asc-ag-title">{{ctx.Locale.Tr "asc_review.new_title_field"}} <span class="rv-opt">{{ctx.Locale.Tr "asc_review.optional"}}</span></label>
						<input class="rv-input" id="asc-ag-title" name="title" type="text" maxlength="200" value="{{.AscAgentForm.Title}}" autocomplete="off"{{if index .AscAgentForm.Errors "title"}} aria-invalid="true"{{end}}>
						{{with index .AscAgentForm.Errors "title"}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
					</div>

					<div class="rv-formgrid rv-formgrid-2">
						<div class="rv-field">
							<label class="rv-label" for="asc-ag-agent">{{ctx.Locale.Tr "asc_review.new_agent"}}</label>
							<input class="rv-input" id="asc-ag-agent" name="agent" type="text" maxlength="40" value="{{.AscAgentForm.Agent}}" required autocomplete="off" autocapitalize="none" spellcheck="false"{{if index .AscAgentForm.Errors "agent"}} aria-invalid="true"{{end}} list="asc-ag-agents" data-asc-estimate-agent>
							<datalist id="asc-ag-agents">{{range .AscAgentsRoster}}<option value="{{.Name}}">{{.Scope}}</option>{{end}}</datalist>
							{{with index .AscAgentForm.Errors "agent"}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
						</div>
						<div class="rv-field">
							<label class="rv-label" for="asc-ag-target">{{ctx.Locale.Tr "asc_review.new_target"}}</label>
							<input class="rv-input" id="asc-ag-target" name="target" type="text" maxlength="255" value="{{.AscAgentForm.Target}}" required autocomplete="off" spellcheck="false"{{if index .AscAgentForm.Errors "target"}} aria-invalid="true"{{end}}>
							{{with index .AscAgentForm.Errors "target"}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
						</div>
					</div>

					<fieldset class="rv-fieldset rv-fieldset-box">
						<legend>{{ctx.Locale.Tr "asc_review.new_model"}}</legend>
						<div class="rv-formgrid rv-formgrid-2">
							<div class="rv-field">
								<label class="rv-label" for="asc-ag-key">{{ctx.Locale.Tr "asc_review.new_key"}}</label>
								<select class="rv-select" id="asc-ag-key" name="key" data-asc-models="{{.AscAgentModelsJSON}}"{{if index .AscAgentForm.Errors "key"}} aria-invalid="true"{{end}}>
									<option value="">{{ctx.Locale.Tr "asc_review.new_key_default"}}</option>
									{{range .AscAgentKeys}}
										<option value="{{.ID}}" data-model="{{.Model}}"{{if not .Usable}} disabled{{end}}{{if eq $.AscAgentForm.Key .ID}} selected{{end}}>{{.Label}} ({{.Provider}}, {{.Owner}}){{if .Note}}, {{.Note}}{{end}}</option>
									{{end}}
								</select>
								{{with index .AscAgentForm.Errors "key"}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
							</div>
							<div class="rv-field">
								<label class="rv-label" for="asc-ag-model">{{ctx.Locale.Tr "asc_review.new_model_field"}} <span class="rv-opt">{{ctx.Locale.Tr "asc_review.optional"}}</span></label>
								<input class="rv-input" id="asc-ag-model" name="model" type="text" maxlength="128" value="{{.AscAgentForm.Model}}" list="asc-ag-model-list" placeholder="{{ctx.Locale.Tr "asc_review.new_model_placeholder"}}" autocomplete="off" autocapitalize="none" spellcheck="false"{{if index .AscAgentForm.Errors "model"}} aria-invalid="true"{{end}}>
								<datalist id="asc-ag-model-list"></datalist>
								{{with index .AscAgentForm.Errors "model"}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
							</div>
						</div>
						{{if not .AscAgentKeys}}<p class="rv-hint">{{ctx.Locale.Tr "asc_review.new_no_keys"}}</p>{{end}}
					</fieldset>

					<div class="ag-switch">
						<input type="checkbox" role="switch" id="asc-ag-plan" name="plan_first" value="1"{{if .AscAgentForm.PlanFirst}} checked{{end}} aria-describedby="asc-ag-plan-help">
						<div><label for="asc-ag-plan"><b>{{ctx.Locale.Tr "asc_review.new_plan_first"}}</b></label><div id="asc-ag-plan-help" class="rv-hint">{{ctx.Locale.Tr "asc_review.new_plan_first_help"}}</div></div>
					</div>

					<fieldset class="rv-fieldset rv-fieldset-box">
						<legend>{{ctx.Locale.Tr "asc_review.new_limits"}} <span class="rv-opt">{{ctx.Locale.Tr "asc_review.new_limits_help"}}</span></legend>
						<div class="rv-formgrid rv-formgrid-3">
							<div class="rv-field">
								<label class="rv-label" for="asc-ag-changes">{{ctx.Locale.Tr "asc_review.new_changes"}}</label>
								<input class="rv-input" id="asc-ag-changes" name="{{.AscBudgetFields.Changes}}" type="text" inputmode="numeric" maxlength="6" value="{{.AscAgentForm.Budget.Changes}}" autocomplete="off"{{if index .AscAgentForm.Errors .AscBudgetFields.Changes}} aria-invalid="true"{{end}}>
								{{with index .AscAgentForm.Errors .AscBudgetFields.Changes}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
							</div>
							<div class="rv-field">
								<label class="rv-label" for="asc-ag-tokens">{{ctx.Locale.Tr "asc_review.new_tokens"}}</label>
								<input class="rv-input" id="asc-ag-tokens" name="{{.AscBudgetFields.Tokens}}" type="text" inputmode="numeric" maxlength="15" value="{{.AscAgentForm.Budget.Tokens}}" autocomplete="off"{{if index .AscAgentForm.Errors .AscBudgetFields.Tokens}} aria-invalid="true"{{end}}>
								{{with index .AscAgentForm.Errors .AscBudgetFields.Tokens}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
							</div>
							<div class="rv-field">
								<label class="rv-label" for="asc-ag-cost">{{ctx.Locale.Tr "asc_review.new_cost"}}</label>
								<input class="rv-input" id="asc-ag-cost" name="{{.AscBudgetFields.CostUSD}}" type="text" inputmode="decimal" maxlength="14" value="{{.AscAgentForm.Budget.CostUSD}}" placeholder="2.50" autocomplete="off"{{if index .AscAgentForm.Errors .AscBudgetFields.CostUSD}} aria-invalid="true"{{end}}>
								{{with index .AscAgentForm.Errors .AscBudgetFields.CostUSD}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
							</div>
							<div class="rv-field">
								<label class="rv-label" for="asc-ag-maxpaths">{{ctx.Locale.Tr "asc_review.new_paths_written"}}</label>
								<input class="rv-input" id="asc-ag-maxpaths" name="{{.AscBudgetFields.Paths}}" type="text" inputmode="numeric" maxlength="7" value="{{.AscAgentForm.Budget.Paths}}" autocomplete="off"{{if index .AscAgentForm.Errors .AscBudgetFields.Paths}} aria-invalid="true"{{end}}>
								{{with index .AscAgentForm.Errors .AscBudgetFields.Paths}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
							</div>
							<div class="rv-field">
								<label class="rv-label" for="asc-ag-minutes">{{ctx.Locale.Tr "asc_review.new_minutes"}}</label>
								<input class="rv-input" id="asc-ag-minutes" name="{{.AscBudgetFields.Minutes}}" type="text" inputmode="numeric" maxlength="6" value="{{.AscAgentForm.Budget.Minutes}}" autocomplete="off"{{if index .AscAgentForm.Errors .AscBudgetFields.Minutes}} aria-invalid="true"{{end}}>
								{{with index .AscAgentForm.Errors .AscBudgetFields.Minutes}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
							</div>
						</div>
						<div class="rv-field">
							<label class="rv-label" for="asc-ag-paths">{{ctx.Locale.Tr "asc_review.new_scope"}} <span class="rv-opt">{{ctx.Locale.Tr "asc_review.new_scope_help"}}</span></label>
							<textarea class="rv-textarea rv-mono" id="asc-ag-paths" name="paths" rows="3" maxlength="4500" spellcheck="false" placeholder="src/**&#10;tests/**"{{if index .AscAgentForm.Errors "paths"}} aria-invalid="true"{{end}}>{{.AscAgentForm.Paths}}</textarea>
							{{with index .AscAgentForm.Errors "paths"}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
						</div>
					</fieldset>
				</div>
				<div class="rv-card-f rv-sticky-form">
					<div class="rv-sticky">
						<button class="rv-btn rv-btn-primary" type="submit">{{ctx.Locale.Tr "asc_review.new_start"}}</button>
						<a class="rv-btn rv-btn-secondary" href="{{.AscAgentsBase}}">{{ctx.Locale.Tr "asc_review.cancel"}}</a>
					</div>
				</div>
			</form>
			<div class="rv-side">
				{{template "repo/asc_agents_policy" .}}
				<section class="rv-card ag-estimate" aria-labelledby="ag-est-h" data-testid="asc-agent-estimate" data-asc-estimate="{{.AscAgentsBase}}/estimate" data-known="{{if .AscAgentEstimate.Known}}1{{end}}">
					<div class="rv-card-h"><h2 id="ag-est-h">{{ctx.Locale.Tr "asc_review.new_estimate"}}</h2></div>
					<div class="rv-card-b" aria-live="polite">
						<p data-est-known{{if not .AscAgentEstimate.Known}} hidden{{end}}><b>{{ctx.Locale.Tr "asc_review.new_est_about"}} <span data-est-duration>{{.AscAgentEstimate.Duration}}</span> {{ctx.Locale.Tr "asc_review.new_est_and"}} <span data-est-cost>{{.AscAgentEstimate.Cost}}</span></b><br><span class="rv-hint">{{ctx.Locale.Tr "asc_review.new_est_based"}} <span data-est-samples>{{.AscAgentEstimate.Samples}}</span> {{ctx.Locale.Tr "asc_review.new_est_runs"}}</span></p>
						<p class="rv-muted" data-est-unknown{{if .AscAgentEstimate.Known}} hidden{{end}}>{{ctx.Locale.Tr "asc_review.new_est_none"}}</p>
					</div>
				</section>
				{{if .AscAgentRecent}}
				<section class="rv-card ag-recent" aria-labelledby="ag-recent-h" data-testid="asc-agent-recent">
					<div class="rv-card-h"><h2 id="ag-recent-h">{{ctx.Locale.Tr "asc_review.new_recent"}}</h2></div>
					<ul class="rv-list">
						{{range .AscAgentRecent}}
						<li class="ag-recent-row"><span>{{.Title}}</span><button class="rv-btn rv-btn-ghost rv-btn-sm" type="button" data-asc-reuse="{{.Task}}" data-asc-reuse-agent="{{.Agent}}">{{ctx.Locale.Tr "asc_review.new_reuse"}}</button></li>
						{{end}}
					</ul>
				</section>
				{{end}}
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
