{{with .Repository}}
{{if and (not .IsEmpty) ($.Permission.CanRead $.UnitTypeCode)}}
	{{$off := or (not $.IsSigned) (and (not $.CanSignedUserFork) (not $.UserAndOrgForks))}}
	<div class="rp-actg{{if $off}} rp-actg-off{{end}}">
		<a class="rp-act{{if and $.ShowForkModal}} show-modal{{end}}"
			{{if $off}}aria-disabled="true"{{end}}
			{{if not $.IsSigned}}title="{{ctx.Locale.Tr "repo.fork_guest_user"}}"{{else if and (not $.CanSignedUserFork) (not $.UserAndOrgForks)}}title="{{ctx.Locale.Tr "repo.fork_from_self"}}"{{end}}
			{{if not $.CanSignedUserFork}}
				{{if gt (len $.UserAndOrgForks) 1}}
					href="#" data-modal="#fork-repo-modal"
				{{else if eq (len $.UserAndOrgForks) 1}}
					href="{{AppSubUrl}}/{{(index $.UserAndOrgForks 0).FullName}}"
				{{end}}
			{{else if not $.UserAndOrgForks}}
				href="{{$.RepoLink}}/fork"
			{{else}}
				href="#" data-modal="#fork-repo-modal"
			{{end}}
		>
			{{svg "octicon-repo-forked" 16}}<span class="rp-act-text">{{ctx.Locale.Tr "repo.fork"}}</span>
		</a>
		<dialog id="fork-repo-modal">
			<article>
				<header>{{ctx.Locale.Tr "repo.already_forked" .Name}}</header>
				<div class="content">
					<ul class="ds-stack-8 rp-plain-list">
						{{range $.UserAndOrgForks}}
							<li><a class="ds-link" href="{{.Link}}">{{svg "octicon-repo-forked" 16}} {{.FullName}}</a></li>
						{{end}}
					</ul>
					{{if $.CanSignedUserFork}}
						<p class="ds-mt-16"><a class="ds-link" href="{{$.RepoLink}}/fork">{{ctx.Locale.Tr "repo.fork_to_different_account"}}</a></p>
					{{end}}
				</div>
			</article>
		</dialog>
		<a class="ds-count" href="{{.Link}}/forks" aria-label="{{ctx.Locale.TrPluralString .NumForks "fork.n_forks" (printf "%d" .NumForks)}}">{{CountFmt .NumForks}}</a>
	</div>
{{end}}
{{end}}
