{{/*
The CI failures page of a repository (routers/web/repo/asc_checks.go): three views. "failures" shows the failing jobs
and the failure groups, "flaky" the tests that flip between pass and fail, "trends" the history of each failing job.
Template Attributes:
* AscChecks: *ascChecksPage
Texts from asc and from runners are cleaned in services/asctrust and escaped by the template engine.
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository rv-trust-page">
	{{template "repo/header" .}}
	<div class="rv rv-page">
		{{template "base/alert" .}}
		{{with .AscChecks}}
		<div data-testid="asc-checks">
			<nav class="rv-seg rv-area rv-area-nav" aria-label="{{ctx.Locale.TrString "asc_trust.checks.views_aria"}}" data-testid="asc-checks-views">
				{{range .Views}}<a href="{{.URL}}"{{if .Active}} aria-current="page"{{end}} data-testid="asc-checks-view-{{.Key}}">{{ctx.Locale.Tr (printf "asc_trust.checks.view.%s" .Key)}}</a>{{end}}
			</nav>
			<header class="rv-head">
				<div class="rv-head-main">
					<div class="rv-eyebrow">{{$.Repository.FullName}} · {{ctx.Locale.Tr "asc_review.checks_eyebrow"}}</div>
					<h1 class="rv-title">{{ctx.Locale.Tr "asc_trust.checks.title"}}</h1>
					<p class="rv-lead">{{ctx.Locale.Tr "asc_trust.checks.lead"}}</p>
				</div>
				{{if and .CanRerun (eq .View "failures") (not .Unsupported)}}
				<form class="rv-acts" method="post" action="{{.ChecksURL}}/rerun_failed">
					{{$.CsrfTokenHtml}}
					<button class="rv-btn rv-btn-secondary" type="submit" data-testid="asc-rerun-failed-repo">{{ctx.Locale.Tr "asc_trust.checks.rerun_failed_repo"}}</button>
				</form>
				{{end}}
			</header>

			{{if .Unsupported}}
				<div class="rv-banner rv-banner-warn" role="status" data-testid="asc-checks-unsupported"><div>{{ctx.Locale.Tr "asc_trust.checks.unsupported"}}</div></div>
			{{else}}
				{{if .Problem}}<div class="rv-banner rv-banner-err" role="alert" data-testid="asc-checks-problem"><div>{{.Problem}}<div class="rv-acts"><a class="rv-btn rv-btn-secondary" href="">{{ctx.Locale.Tr "asc_review.try_again"}}</a></div></div></div>{{end}}

				{{if eq .View "failures"}}
				<nav class="rv-chips" aria-label="{{ctx.Locale.TrString "asc_trust.checks.state_aria"}}">
					{{range .States}}<a class="rv-chip-btn" href="{{$.AscChecks.ChecksURL}}{{if .Key}}?state={{.Key}}{{end}}"{{if .Active}} aria-current="page"{{end}} data-testid="asc-checks-tab-{{if .Key}}{{.Key}}{{else}}open{{end}}">{{ctx.Locale.Tr (printf "asc_trust.checks.state.%s" .Label)}}{{if .Count}} <span class="rv-count" data-testid="asc-checks-count-{{.Key}}">{{.Count}}</span>{{end}}</a>{{end}}
				</nav>
				<form class="rv-filters" method="get" action="{{.ChecksURL}}" role="search" aria-label="{{ctx.Locale.Tr "asc_trust.checks.filter"}}">
					{{if .State}}<input type="hidden" name="state" value="{{.State}}">{{end}}
					<div class="rv-filter-fields rv-filter-fields-3">
						<div class="rv-field"><label class="rv-label" for="asc-checks-job">{{ctx.Locale.Tr "asc_trust.checks.job"}}</label><input class="rv-input" id="asc-checks-job" name="job" type="text" maxlength="512" value="{{.Job}}" autocomplete="off"></div>
						<div class="rv-field"><label class="rv-label" for="asc-checks-test">{{ctx.Locale.Tr "asc_trust.checks.test"}}</label><input class="rv-input" id="asc-checks-test" name="test" type="text" maxlength="512" value="{{.Test}}" autocomplete="off"></div>
						<label class="rv-check" for="asc-checks-flaky"><input id="asc-checks-flaky" name="flaky" type="checkbox" value="1"{{if .Flaky}} checked{{end}}> {{ctx.Locale.Tr "asc_trust.checks.flaky_only"}}</label>
						<div class="rv-acts"><button class="rv-btn rv-btn-primary" type="submit">{{ctx.Locale.Tr "asc_trust.checks.filter"}}</button><a class="rv-btn rv-btn-secondary" href="{{.ChecksURL}}">{{ctx.Locale.Tr "asc_trust.checks.clear"}}</a></div>
					</div>
				</form>

				{{if .Data}}
				{{if or .Main .Side}}
				<div class="rv-sidecards rv-gap" data-testid="asc-checks-side">
					{{if .Main}}
					<section class="rv-card" aria-labelledby="asc-main-state">
						<div class="rv-card-h"><h2 id="asc-main-state">{{ctx.Locale.Tr "asc_trust.checks.main_title"}}</h2></div>
						<div class="rv-card-b"><span class="rv-pill rv-pill-{{if eq .Main "green"}}ok{{else if eq .Main "failing"}}err{{else}}warn{{end}}" data-testid="asc-main-state">{{ctx.Locale.Tr (printf "asc_trust.checks.main_%s" .Main)}}</span></div>
					</section>
					{{end}}
					{{with .Side}}{{if .Quarantined}}
					<section class="rv-card" aria-labelledby="asc-quarantined">
						<div class="rv-card-h"><h2 id="asc-quarantined">{{ctx.Locale.Tr "asc_trust.checks.state.quarantined"}}</h2><a href="{{$.AscChecks.ChecksURL}}?state=quarantined" data-testid="asc-quarantined-manage">{{ctx.Locale.Tr "asc_trust.checks.manage"}}</a></div>
						<ul class="rv-checklist" data-testid="asc-quarantined-list">
							{{range .Quarantined}}<li><a href="{{$.AscChecks.ChecksURL}}/groups/{{.ID}}">{{if .TestName}}{{.TestName}}{{else}}{{.Title}}{{end}}</a><span class="rv-faint">{{DateUtils.TimeSince .LastSeen}}</span></li>{{end}}
						</ul>
					</section>
					{{end}}{{end}}
				</div>
				{{end}}
				{{if .Jobs}}
				<section class="rv-card rv-gap" aria-labelledby="asc-jobs">
					<div class="rv-card-h"><h2 id="asc-jobs">{{ctx.Locale.Tr "asc_trust.checks.jobs_title"}}</h2><span class="rv-faint">{{ctx.Locale.Tr "asc_trust.checks.jobs_aside"}}</span></div>
					<div class="rv-tablewrap rv-flat" tabindex="0" role="region" aria-label="{{ctx.Locale.Tr "asc_trust.table_region"}}">
						<table class="rv-tbl rv-tbl-stack" data-testid="asc-jobs">
							<caption class="rv-sr">{{ctx.Locale.Tr "asc_trust.checks.jobs_title"}}</caption>
							<thead><tr><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.job"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_causes"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_failures"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_changes"}}</th></tr></thead>
							<tbody>
								{{range .Jobs}}
								<tr>
									<th scope="row" class="rv-cell-main">{{if .Job}}<a href="{{$.AscChecks.ChecksURL}}?job={{.Job | QueryEscape}}">{{.Job}}</a>{{else}}<span class="rv-muted">{{ctx.Locale.Tr "asc_trust.checks.no_job"}}</span>{{end}}{{if .Flaky}} <span class="rv-pill rv-pill-warn">{{ctx.Locale.Tr "asc_trust.checks.flaky"}}</span>{{end}}<span class="ds-bar rv-jobbar" aria-hidden="true"><i style="width: {{.Share}}%"></i></span></th>
									<td data-label="{{ctx.Locale.Tr "asc_trust.checks.col_causes"}}">{{.Groups}}</td>
									<td data-label="{{ctx.Locale.Tr "asc_trust.checks.col_failures"}}">{{.Occurrences}}</td>
									<td data-label="{{ctx.Locale.Tr "asc_trust.checks.col_changes"}}">{{.Changes}}</td>
								</tr>
								{{end}}
							</tbody>
						</table>
					</div>
				</section>
				{{end}}

				<section class="rv-card rv-gap" aria-labelledby="asc-groups">
					<div class="rv-card-h"><h2 id="asc-groups">{{ctx.Locale.Tr "asc_trust.checks.groups_title"}}</h2><span class="rv-faint">{{ctx.Locale.Tr "asc_trust.checks.groups_aside"}}</span></div>
					<div class="rv-tablewrap rv-flat" tabindex="0" role="region" aria-label="{{ctx.Locale.Tr "asc_trust.table_region"}}">
						<table class="rv-tbl rv-tbl-stack" data-testid="asc-groups">
							<caption class="rv-sr">{{ctx.Locale.Tr "asc_trust.checks.groups_title"}}</caption>
							<thead><tr><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_cause"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_state"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_seen"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_changes"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_last_seen"}}</th></tr></thead>
							<tbody>
								{{range .Data.Groups.Rows}}
								<tr>
									<td class="rv-cell-main">
										<a href="{{$.AscChecks.ChecksURL}}/groups/{{.ID}}">{{if .Title}}{{.Title}}{{else}}{{.TestName}}{{end}}</a>
										{{if .Flaky}} <span class="rv-pill rv-pill-warn">{{ctx.Locale.Tr "asc_trust.checks.flaky"}}</span>{{end}}
										<div class="rv-li-sub">{{if .TestName}}<code>{{.TestName}}</code> {{end}}{{if .JobName}}{{ctx.Locale.Tr "asc_trust.checks.in_job" .JobName}}{{end}}</div>
									</td>
									<td data-label="{{ctx.Locale.Tr "asc_trust.checks.col_state"}}"><span class="rv-pill rv-pill-{{.Tone}}">{{ctx.Locale.Tr (printf "asc_trust.checks.state.%s" .StateKey)}}</span></td>
									<td data-label="{{ctx.Locale.Tr "asc_trust.checks.col_seen"}}">{{.Occurrences}}</td>
									<td data-label="{{ctx.Locale.Tr "asc_trust.checks.col_changes"}}">{{.ChangesAffected}}</td>
									<td data-label="{{ctx.Locale.Tr "asc_trust.checks.col_last_seen"}}" class="rv-nowrap">{{DateUtils.TimeSince .LastSeen}}</td>
								</tr>
								{{else}}
								<tr><td colspan="5" class="rv-center rv-muted" data-testid="asc-groups-empty">{{if and (eq .State "open") (not .Job) (not .Test) (not .Flaky)}}{{template "shared/ds/empty" (dict "Icon" "check" "Title" (ctx.Locale.Tr "asc_trust.checks.nothing_title") "Body" (ctx.Locale.Tr "asc_trust.checks.nothing_body"))}}{{else}}{{ctx.Locale.Tr "asc_trust.checks.groups_empty"}}{{end}}</td></tr>
								{{end}}
							</tbody>
						</table>
					</div>
					{{if .NextURL}}<div class="rv-card-f rv-center"><a class="rv-btn rv-btn-secondary" href="{{.NextURL}}" rel="next">{{ctx.Locale.Tr "asc_trust.checks.more_groups"}}</a></div>{{end}}
				</section>
				{{end}}
				{{end}}

				{{if or (eq .View "flaky") (eq .View "trends")}}
				<form class="rv-filters" method="get" action="{{.ChecksURL}}">
					<input type="hidden" name="view" value="{{.View}}">
					<div class="rv-filter-fields">
						<div class="rv-field">
							<label class="rv-label" for="asc-checks-window">{{ctx.Locale.Tr "asc_trust.checks.window"}}</label>
							<select class="rv-select" id="asc-checks-window" name="window">
								{{range .Windows}}<option value="{{.}}"{{if eq $.AscChecks.Window .}} selected{{end}}>{{ctx.Locale.Tr "asc_trust.checks.days" .}}</option>{{end}}
							</select>
						</div>
						<button class="rv-btn rv-btn-secondary" type="submit">{{ctx.Locale.Tr "asc_trust.checks.show"}}</button>
					</div>
				</form>
				{{end}}

				{{if eq .View "flaky"}}
				<section class="rv-card rv-gap" aria-labelledby="asc-flaky">
					<div class="rv-card-h"><h2 id="asc-flaky">{{ctx.Locale.Tr "asc_trust.checks.flaky_title"}}</h2><span class="rv-faint">{{ctx.Locale.Tr "asc_trust.checks.last_days" .Window}}</span></div>
					<div class="rv-tablewrap rv-flat" tabindex="0" role="region" aria-label="{{ctx.Locale.Tr "asc_trust.table_region"}}">
						<table class="rv-tbl rv-tbl-stack" data-testid="asc-flaky">
							<caption class="rv-sr">{{ctx.Locale.Tr "asc_trust.checks.flaky_title"}}</caption>
							<thead><tr><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.test"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_rate"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_runs"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_last_flip"}}</th></tr></thead>
							<tbody>
								{{range .FlakyRows}}
								<tr>
									<td class="rv-cell-main">{{if .GroupID}}<a href="{{$.AscChecks.ChecksURL}}/groups/{{.GroupID}}">{{.TestName}}</a>{{else}}{{.TestName}}{{end}}{{if .JobName}}<div class="rv-li-sub">{{ctx.Locale.Tr "asc_trust.checks.in_job" .JobName}}</div>{{end}}</td>
									<td data-label="{{ctx.Locale.Tr "asc_trust.checks.col_rate"}}">{{.RatePercent}}%</td>
									<td data-label="{{ctx.Locale.Tr "asc_trust.checks.col_runs"}}">{{.Runs}}</td>
									<td data-label="{{ctx.Locale.Tr "asc_trust.checks.col_last_flip"}}" class="rv-nowrap">{{DateUtils.TimeSince .LastFlip}}</td>
								</tr>
								{{else}}
								<tr><td colspan="4" class="rv-center rv-muted" data-testid="asc-flaky-empty">{{ctx.Locale.Tr "asc_trust.checks.flaky_empty"}}</td></tr>
								{{end}}
							</tbody>
						</table>
					</div>
					{{if .NextURL}}<div class="rv-card-f rv-center"><a class="rv-btn rv-btn-secondary" href="{{.NextURL}}" rel="next">{{ctx.Locale.Tr "asc_trust.checks.more_tests"}}</a></div>{{end}}
				</section>
				{{end}}

				{{if eq .View "trends"}}
				<section class="rv-card rv-gap" aria-labelledby="asc-trends">
					<div class="rv-card-h"><h2 id="asc-trends">{{ctx.Locale.Tr "asc_trust.checks.trends_title"}}</h2><span class="rv-faint">{{ctx.Locale.Tr "asc_trust.checks.last_days" .Window}}</span></div>
					{{range .Trends}}
					<div class="rv-card-b rv-trend" data-testid="asc-trend">
						<h3 class="rv-h4"><a href="{{$.AscChecks.ChecksURL}}?job={{.Job | QueryEscape}}">{{.Job}}</a></h3>
						{{template "repo/asc_strip" .History}}
					</div>
					{{else}}
					<p class="rv-card-b rv-muted" data-testid="asc-trends-empty">{{ctx.Locale.Tr "asc_trust.checks.trends_empty"}}</p>
					{{end}}
				</section>
				{{end}}
			{{end}}
		</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
