{{/*
The CI failures page of a repository (routers/web/repo/asc_checks.go): three views. "failures" shows the failing jobs
and the failure groups, "flaky" the tests that flip between pass and fail, "trends" the history of each failing job.
Template Attributes:
* AscChecks: *ascChecksPage (Rows, Open: the failure groups and the expanded one; Retry: Problem is a failure to reach asc)
Texts from asc and from runners are cleaned in services/asctrust and escaped by the template engine.
What a view lists sits in data-asc-list-main: a filter, a tab or the window shows the skeleton card while the page loads
again (web_src/js/features/asc-list-loading.js).
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository rv-trust-page">
	{{template "repo/header" .}}
	<div class="rv rv-page">
		{{template "base/alert" .}}
		{{with .AscChecks}}
		<div data-testid="asc-checks">
			<nav class="rv-seg rv-area rv-area-nav" aria-label="{{ctx.Locale.TrString "asc_trust.checks.views_aria"}}" data-testid="asc-checks-views">
				{{range .Views}}<a href="{{.URL}}"{{if .Active}} aria-current="page"{{end}} data-testid="asc-checks-view-{{.Key}}">{{ctx.Locale.Tr (printf "asc_trust.checks.view.%s" .Key)}}</a>{{end}}
			</nav>
			<header class="rv-head">
				<div class="rv-head-main">
					<div class="rv-eyebrow">{{$.Repository.FullName}} · {{ctx.Locale.Tr "asc_review.checks_eyebrow"}}</div>
					<h1 class="rv-title">{{ctx.Locale.Tr "asc_trust.checks.title"}}</h1>
					<p class="rv-lead">{{ctx.Locale.Tr "asc_trust.checks.lead"}}</p>
				</div>
				{{if and .CanRerun (eq .View "failures") (not .Unsupported)}}
				<form class="rv-acts" method="post" action="{{.ChecksURL}}/rerun_failed">
					{{$.CsrfTokenHtml}}
					<button class="rv-btn rv-btn-secondary" type="submit" data-testid="asc-rerun-failed-repo">{{ctx.Locale.Tr "asc_trust.checks.rerun_failed_repo"}}</button>
				</form>
				{{end}}
			</header>

			{{if .Unsupported}}
				<div class="rv-banner rv-banner-warn" role="status" data-testid="asc-checks-unsupported"><div>{{ctx.Locale.Tr "asc_trust.checks.unsupported"}}</div></div>
			{{else}}
				{{if .Problem}}
					<div class="rv-banner rv-banner-err" role="alert" data-testid="asc-checks-problem">
						<div>
							{{if .Retry}}<b>{{ctx.Locale.Tr (printf "asc_trust.checks.err_title.%s" .View)}}</b> {{end}}{{.Problem}}
							{{if .Retry}}<div class="rv-acts"><a class="rv-btn rv-btn-secondary" href="" data-testid="asc-checks-retry">{{svg "dsi-refresh" 14}}{{ctx.Locale.Tr "asc_review.try_again"}}</a></div>{{end}}
						</div>
					</div>
				{{end}}

				{{if eq .View "failures"}}
				<nav class="rv-chips" aria-label="{{ctx.Locale.TrString "asc_trust.checks.state_aria"}}">
					{{range .States}}<a class="rv-chip-btn" href="{{$.AscChecks.ChecksURL}}{{if .Key}}?state={{.Key}}{{end}}"{{if .Active}} aria-current="page"{{end}} data-testid="asc-checks-tab-{{if .Key}}{{.Key}}{{else}}open{{end}}">{{ctx.Locale.Tr (printf "asc_trust.checks.state.%s" .Label)}}{{if .Count}} <span class="rv-count" data-testid="asc-checks-count-{{.Key}}">{{.Count}}</span>{{end}}</a>{{end}}
				</nav>
				<form class="rv-filters" method="get" action="{{.ChecksURL}}" role="search" aria-label="{{ctx.Locale.Tr "asc_trust.checks.filter"}}" data-asc-list-filter>
					{{if .State}}<input type="hidden" name="state" value="{{.State}}">{{end}}
					<div class="rv-filter-fields rv-filter-fields-3">
						<div class="rv-field"><label class="rv-label" for="asc-checks-job">{{ctx.Locale.Tr "asc_trust.checks.job"}}</label><input class="rv-input" id="asc-checks-job" name="job" type="text" maxlength="512" value="{{.Job}}" autocomplete="off"></div>
						<div class="rv-field"><label class="rv-label" for="asc-checks-test">{{ctx.Locale.Tr "asc_trust.checks.test"}}</label><input class="rv-input" id="asc-checks-test" name="test" type="text" maxlength="512" value="{{.Test}}" autocomplete="off"></div>
						<label class="rv-check" for="asc-checks-flaky"><input id="asc-checks-flaky" name="flaky" type="checkbox" value="1"{{if .Flaky}} checked{{end}}> {{ctx.Locale.Tr "asc_trust.checks.flaky_only"}}</label>
						<div class="rv-acts"><button class="rv-btn rv-btn-primary" type="submit">{{ctx.Locale.Tr "asc_trust.checks.filter"}}</button><a class="rv-btn rv-btn-secondary" href="{{.ChecksURL}}">{{ctx.Locale.Tr "asc_trust.checks.clear"}}</a></div>
					</div>
				</form>

				{{if .Data}}
				<div class="rv-stack" data-asc-list-main>
					<div class="rv-card ag-loading" role="status" aria-busy="true" aria-label="{{ctx.Locale.Tr "asc_rp.loading"}}" data-asc-list-loading data-testid="asc-checks-loading" hidden>
						<ul class="rv-list" aria-hidden="true">
							<li class="ag-sk-row"><span class="ag-sk-main"><span class="rv-sk ag-sk-t"></span><span class="rv-sk ag-sk-s"></span></span><span class="rv-sk ag-sk-pill"></span></li>
							<li class="ag-sk-row"><span class="ag-sk-main"><span class="rv-sk ag-sk-t"></span><span class="rv-sk ag-sk-s"></span></span><span class="rv-sk ag-sk-pill"></span></li>
							<li class="ag-sk-row"><span class="ag-sk-main"><span class="rv-sk ag-sk-t"></span><span class="rv-sk ag-sk-s"></span></span><span class="rv-sk ag-sk-pill"></span></li>
						</ul>
					</div>
				{{if or .Main .Side}}
				<div class="rv-sidecards rv-gap" data-testid="asc-checks-side">
					{{if .Main}}
					<section class="rv-card" aria-labelledby="asc-main-state">
						<div class="rv-card-h"><h2 id="asc-main-state">{{ctx.Locale.Tr "asc_trust.checks.main_title"}}</h2></div>
						<div class="rv-card-b"><span class="rv-pill rv-pill-{{if eq .Main "green"}}ok{{else if eq .Main "failing"}}err{{else}}warn{{end}}" data-testid="asc-main-state">{{ctx.Locale.Tr (printf "asc_trust.checks.main_%s" .Main)}}</span></div>
					</section>
					{{end}}
					{{with .Side}}{{if .Quarantined}}
					<section class="rv-card" aria-labelledby="asc-quarantined">
						<div class="rv-card-h"><h2 id="asc-quarantined">{{ctx.Locale.Tr "asc_trust.checks.state.quarantined"}}</h2><a href="{{$.AscChecks.ChecksURL}}?state=quarantined" data-testid="asc-quarantined-manage">{{ctx.Locale.Tr "asc_trust.checks.manage"}}</a></div>
						<ul class="rv-checklist" data-testid="asc-quarantined-list">
							{{range .Quarantined}}<li><a href="{{$.AscChecks.ChecksURL}}/groups/{{.ID}}">{{if .TestName}}{{.TestName}}{{else}}{{.Title}}{{end}}</a><span class="rv-faint">{{DateUtils.TimeSince .LastSeen}}</span></li>{{end}}
						</ul>
					</section>
					{{end}}{{end}}
				</div>
				{{end}}
				{{if .Jobs}}
				<section class="rv-card rv-gap" aria-labelledby="asc-jobs">
					<div class="rv-card-h"><h2 id="asc-jobs">{{ctx.Locale.Tr "asc_trust.checks.jobs_title"}}</h2><span class="rv-faint">{{ctx.Locale.Tr "asc_trust.checks.jobs_aside"}}</span></div>
					<div class="rv-tablewrap rv-flat" tabindex="0" role="region" aria-label="{{ctx.Locale.Tr "asc_trust.table_region"}}">
						<table class="rv-tbl rv-tbl-stack" data-testid="asc-jobs">
							<caption class="rv-sr">{{ctx.Locale.Tr "asc_trust.checks.jobs_title"}}</caption>
							<thead><tr><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.job"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_causes"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_failures"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_changes"}}</th></tr></thead>
							<tbody>
								{{range .Jobs}}
								<tr>
									<th scope="row" class="rv-cell-main">{{if .Job}}<a href="{{$.AscChecks.ChecksURL}}?job={{.Job | QueryEscape}}">{{.Job}}</a>{{else}}<span class="rv-muted">{{ctx.Locale.Tr "asc_trust.checks.no_job"}}</span>{{end}}{{if .Flaky}} <span class="rv-pill rv-pill-warn">{{ctx.Locale.Tr "asc_trust.checks.flaky"}}</span>{{end}}<span class="ds-bar rv-jobbar" aria-hidden="true"><i style="width: {{.Share}}%"></i></span></th>
									<td data-label="{{ctx.Locale.Tr "asc_trust.checks.col_causes"}}">{{.Groups}}</td>
									<td data-label="{{ctx.Locale.Tr "asc_trust.checks.col_failures"}}">{{.Occurrences}}</td>
									<td data-label="{{ctx.Locale.Tr "asc_trust.checks.col_changes"}}">{{.Changes}}</td>
								</tr>
								{{end}}
							</tbody>
						</table>
					</div>
				</section>
				{{end}}

				<section class="rv-card rv-gap" aria-labelledby="asc-groups">
					<div class="rv-card-h"><h2 id="asc-groups">{{ctx.Locale.Tr "asc_trust.checks.groups_title"}}</h2><span class="rv-faint">{{ctx.Locale.Tr "asc_trust.checks.groups_aside"}}</span></div>
					{{if .Rows}}
					<ul class="rv-groups" data-testid="asc-groups">
						{{range .Rows}}
						{{$title := .Title}}{{if not $title}}{{$title = .TestName}}{{end}}
						<li class="rv-group{{if .Expanded}} is-open{{end}}" id="asc-group-{{.ID}}" data-testid="asc-group-row">
							<div class="rv-group-row">
								<span class="rv-dot rv-dot-{{.Dot}}" aria-hidden="true"></span>
								<div class="rv-li-main">
									<div class="rv-li-title"><a href="{{$.AscChecks.ChecksURL}}/groups/{{.ID}}">{{$title}}</a></div>
									<div class="rv-li-meta">
										{{if .JobName}}<span class="rv-pill rv-pill-outline">{{.JobName}}</span>{{end}}
										{{if and .TestName .Title}}<code>{{.TestName}}</code>{{end}}
										<span class="rv-ic-text">{{svg "dsi-hash" 14}}{{ctx.Locale.Tr "asc_trust.checks.group_seen" .Occurrences .ChangesAffected}}</span>
										<span class="rv-ic-text">{{svg "dsi-clock" 14}}{{ctx.Locale.Tr "asc_trust.checks.group_last"}} {{DateUtils.TimeSince .LastSeen}}</span>
										{{if .Flaky}}<span class="rv-pill rv-pill-warn">{{ctx.Locale.Tr "asc_trust.checks.flaky"}}</span>{{end}}
									</div>
									{{if .Note}}<div class="rv-li-sub">{{ctx.Locale.Tr "asc_trust.checks.group_note" .Note}}</div>{{end}}
									<div class="rv-group-act" data-testid="asc-group-acts">
										{{if .AckURL}}<a class="rv-btn rv-btn-secondary rv-btn-sm" href="{{.AckURL}}" data-testid="asc-group-ack">{{svg "dsi-eye" 14}}{{ctx.Locale.Tr "asc_trust.checks.acknowledge"}}</a>{{end}}
										{{if .QuarantineURL}}<a class="rv-btn rv-btn-secondary rv-btn-sm" href="{{.QuarantineURL}}" data-testid="asc-group-quarantine-row">{{svg "dsi-ban" 14}}{{ctx.Locale.Tr "asc_trust.checks.quarantine_short"}}</a>{{end}}
										<details class="rv-menu rv-group-more">
											<summary class="rv-btn rv-btn-ghost rv-btn-icon rv-btn-sm" aria-label="{{ctx.Locale.Tr "asc_trust.checks.more_for" $title}}" data-testid="asc-group-more">{{svg "dsi-dots" 14}}</summary>
											<div class="rv-menu-panel rv-group-menu">
												<a class="rv-menu-item" href="{{.ToggleURL}}" data-testid="asc-group-toggle">{{svg "dsi-terminal" 14}}{{if .Expanded}}{{ctx.Locale.Tr "asc_trust.checks.hide_details"}}{{else}}{{ctx.Locale.Tr "asc_trust.checks.show_details"}}{{end}}</a>
												<a class="rv-menu-item" href="{{$.AscChecks.ChecksURL}}/groups/{{.ID}}">{{svg "dsi-history" 14}}{{ctx.Locale.Tr "asc_trust.checks.open_group"}}</a>
												{{if or .CanResolve .CanReopen}}
												<form method="post" action="{{$.AscChecks.ChecksURL}}/groups/{{.ID}}/state">
													{{$.CsrfTokenHtml}}
													<input type="hidden" name="op" value="{{.Op}}">
													<input type="hidden" name="next" value="checks">
													<input type="hidden" name="back" value="{{$.AscChecks.ListQuery}}">
													{{if .CanResolve}}<button class="rv-menu-item" type="submit" name="state" value="resolved" data-testid="asc-group-resolve">{{svg "dsi-check" 14}}{{ctx.Locale.Tr "asc_trust.checks.resolve"}}</button>{{end}}
													{{if .CanReopen}}<button class="rv-menu-item" type="submit" name="state" value="open" data-testid="asc-group-reopen">{{svg "dsi-undo" 14}}{{ctx.Locale.Tr "asc_trust.checks.reopen"}}</button>{{end}}
												</form>
												{{end}}
											</div>
										</details>
									</div>
								</div>
								<span class="rv-pill rv-pill-{{.Tone}} rv-group-state">{{ctx.Locale.Tr (printf "asc_trust.checks.state.%s" .StateKey)}}</span>
							</div>
							{{if .Expanded}}{{with $.AscChecks.Open}}
							<div class="rv-group-open" data-testid="asc-group-open">
								<div class="rv-group-where">
									{{if .Lines}}
									<div class="rv-loglines" tabindex="0" role="region" aria-label="{{ctx.Locale.Tr "asc_trust.checks.log_aria" $title}}" data-testid="asc-group-log">
										<div class="rv-loglines-h">{{with .LogOf}}{{if .JobName}}{{.JobName}} · {{end}}{{ctx.Locale.Tr "asc_trust.checks.attempt" .Attempt}}{{if .Version}} · v{{.Version}}{{end}}{{if .Head}} <code>{{.Head}}</code>{{end}}{{end}}</div>
										<ol class="rv-loglines-b">{{range .Lines}}<li><span class="rv-ln" aria-hidden="true">{{.N}}</span><span class="rv-lt">{{.Text}}</span></li>{{end}}</ol>
									</div>
									{{end}}
									<div class="rv-tablewrap rv-flat rv-inset" tabindex="0" role="region" aria-label="{{ctx.Locale.Tr "asc_trust.checks.where"}}">
										<table class="rv-tbl rv-tbl-stack" data-testid="asc-group-where">
											<caption class="rv-sr">{{ctx.Locale.Tr "asc_trust.checks.where"}}</caption>
											<thead><tr><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.where"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.job"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_attempt"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_when"}}</th></tr></thead>
											<tbody>
												{{range .Occurrences}}
												<tr>
													<th scope="row" class="rv-cell-main">{{if .Change}}{{if .RunURL}}<a href="{{.RunURL}}">{{ctx.Locale.Tr "asc_trust.checks.change"}} <code>{{.Change}}</code></a>{{else}}{{ctx.Locale.Tr "asc_trust.checks.change"}} <code>{{.Change}}</code>{{end}}{{if .Version}} <span class="rv-faint">v{{.Version}}</span>{{end}}{{else if .Head}}{{if .RunURL}}<a href="{{.RunURL}}"><code>{{.Head}}</code></a>{{else}}<code>{{.Head}}</code>{{end}}{{else if .RunURL}}<a href="{{.RunURL}}">{{ctx.Locale.Tr "asc_trust.checks.show_run"}}</a>{{end}}</th>
													<td data-label="{{ctx.Locale.Tr "asc_trust.checks.job"}}">{{.JobName}}</td>
													<td data-label="{{ctx.Locale.Tr "asc_trust.checks.col_attempt"}}">{{.Attempt}}</td>
													<td data-label="{{ctx.Locale.Tr "asc_trust.checks.col_when"}}" class="rv-nowrap">{{DateUtils.TimeSince .At}}</td>
												</tr>
												{{else}}
												<tr><td colspan="4" class="rv-muted">{{ctx.Locale.Tr "asc_trust.checks.no_occurrences"}}</td></tr>
												{{end}}
											</tbody>
										</table>
									</div>
									{{if .More}}<p><a href="{{$.AscChecks.ChecksURL}}/groups/{{.ID}}" data-testid="asc-group-all">{{ctx.Locale.Tr "asc_trust.checks.all_occurrences"}}</a></p>{{end}}
								</div>
								{{if $.AscChecks.CanWrite}}
								<form class="rv-group-do rv-inset rv-form" method="post" action="{{$.AscChecks.ChecksURL}}/groups/{{.ID}}/state" data-testid="asc-group-do">
									<h3 class="rv-h4">{{ctx.Locale.Tr "asc_trust.checks.actions_title"}}</h3>
									{{$.CsrfTokenHtml}}
									<input type="hidden" name="op" value="{{.Op}}">
									<input type="hidden" name="next" value="checks">
									<input type="hidden" name="back" value="{{$.AscChecks.ListQuery}}">
									<div class="rv-field">
										<label class="rv-label" for="asc-group-{{.ID}}-note">{{ctx.Locale.Tr "asc_trust.checks.note"}}</label>
										<textarea class="rv-textarea" id="asc-group-{{.ID}}-note" name="note" rows="3" maxlength="1024" placeholder="{{ctx.Locale.Tr "asc_trust.checks.note_hint"}}"{{if .Act}} autofocus{{end}}></textarea>
									</div>
									<div class="rv-acts">
										<button class="rv-btn {{if eq .Act "acknowledged"}}rv-btn-primary{{else}}rv-btn-secondary{{end}} rv-btn-sm" type="submit" name="state" value="acknowledged" data-testid="asc-group-do-ack">{{ctx.Locale.Tr "asc_trust.checks.acknowledge"}}</button>
										{{if $.AscChecks.AllowQuarantine}}<button class="rv-btn {{if eq .Act "quarantined"}}rv-btn-primary{{else}}rv-btn-secondary{{end}} rv-btn-sm" type="submit" name="state" value="quarantined" data-testid="asc-group-do-quarantine">{{svg "dsi-ban" 14}}{{ctx.Locale.Tr "asc_trust.checks.quarantine"}}</button>{{end}}
										<a class="rv-btn rv-btn-ghost rv-btn-sm" href="{{$.RepoLink}}/issues/new?{{.IssueQuery}}" data-testid="asc-group-do-issue">{{svg "dsi-external" 14}}{{ctx.Locale.Tr "asc_trust.checks.open_issue"}}</a>
									</div>
									<p class="rv-hint">{{ctx.Locale.Tr "asc_trust.checks.quarantine_note"}}</p>
								</form>
								{{end}}
							</div>
							{{end}}{{end}}
						</li>
						{{end}}
					</ul>
					{{else}}
					<div class="rv-card-b" data-testid="asc-groups-empty">
						{{if .Filtered}}
							<div class="rv-empty rv-empty-flat">
								<h3>{{ctx.Locale.Tr "asc_trust.checks.match_none_title"}}</h3>
								<p>{{ctx.Locale.Tr "asc_trust.checks.match_none_help"}}</p>
								<div class="rv-acts"><a class="rv-btn rv-btn-secondary rv-btn-sm" href="{{.ChecksURL}}{{if .State}}?state={{.State}}{{end}}" data-testid="asc-groups-clear">{{ctx.Locale.Tr "asc_review.agents_clear"}}</a></div>
							</div>
						{{else if or (not .State) (eq .State "open")}}
							{{template "shared/ds/empty" (dict "Icon" "check-circle" "Title" (ctx.Locale.Tr "asc_trust.checks.nothing_title") "Body" (ctx.Locale.Tr "asc_trust.checks.nothing_body") "SecondaryLabel" (ctx.Locale.Tr "asc_trust.checks.see_trends") "SecondaryHref" .TrendsURL)}}
						{{else}}
							<p class="rv-center rv-muted">{{ctx.Locale.Tr "asc_trust.checks.groups_empty"}}</p>
						{{end}}
					</div>
					{{end}}
					{{if .NextURL}}<div class="rv-card-f rv-center"><a class="rv-btn rv-btn-secondary" href="{{.NextURL}}" rel="next">{{ctx.Locale.Tr "asc_trust.checks.more_groups"}}</a></div>{{end}}
				</section>
				</div>
				{{end}}
				{{end}}

				{{if or (eq .View "flaky") (eq .View "trends")}}
				<form class="rv-filters" method="get" action="{{.ChecksURL}}" data-asc-list-filter>
					<input type="hidden" name="view" value="{{.View}}">
					<div class="rv-filter-fields">
						<div class="rv-field">
							<label class="rv-label" for="asc-checks-window">{{ctx.Locale.Tr "asc_trust.checks.window"}}</label>
							<select class="rv-select" id="asc-checks-window" name="window">
								{{range .Windows}}<option value="{{.}}"{{if eq $.AscChecks.Window .}} selected{{end}}>{{ctx.Locale.Tr "asc_trust.checks.days" .}}</option>{{end}}
							</select>
						</div>
						<button class="rv-btn rv-btn-secondary" type="submit">{{ctx.Locale.Tr "asc_trust.checks.show"}}</button>
					</div>
				</form>
				{{end}}

				{{if and (eq .View "flaky") (not .Problem)}}
				<div class="rv-stack" data-asc-list-main>
					<div class="rv-card ag-loading" role="status" aria-busy="true" aria-label="{{ctx.Locale.Tr "asc_rp.loading"}}" data-asc-list-loading data-testid="asc-flaky-loading" hidden>
						<ul class="rv-list" aria-hidden="true">
							<li class="ag-sk-row"><span class="ag-sk-main"><span class="rv-sk ag-sk-t"></span><span class="rv-sk ag-sk-s"></span></span><span class="rv-sk ag-sk-pill"></span></li>
							<li class="ag-sk-row"><span class="ag-sk-main"><span class="rv-sk ag-sk-t"></span><span class="rv-sk ag-sk-s"></span></span><span class="rv-sk ag-sk-pill"></span></li>
							<li class="ag-sk-row"><span class="ag-sk-main"><span class="rv-sk ag-sk-t"></span><span class="rv-sk ag-sk-s"></span></span><span class="rv-sk ag-sk-pill"></span></li>
						</ul>
					</div>
				<section class="rv-card rv-gap" aria-labelledby="asc-flaky">
					<div class="rv-card-h"><h2 id="asc-flaky">{{ctx.Locale.Tr "asc_trust.checks.flaky_title"}}</h2><span class="rv-faint">{{ctx.Locale.Tr "asc_trust.checks.last_days" .Window}}</span></div>
					<div class="rv-tablewrap rv-flat" tabindex="0" role="region" aria-label="{{ctx.Locale.Tr "asc_trust.table_region"}}">
						<table class="rv-tbl rv-tbl-stack" data-testid="asc-flaky">
							<caption class="rv-sr">{{ctx.Locale.Tr "asc_trust.checks.flaky_title"}}</caption>
							<thead><tr><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.test"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_rate"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_runs"}}</th><th scope="col">{{ctx.Locale.Tr "asc_trust.checks.col_last_flip"}}</th></tr></thead>
							<tbody>
								{{range .FlakyRows}}
								<tr>
									<td class="rv-cell-main">{{if .GroupID}}<a href="{{$.AscChecks.ChecksURL}}/groups/{{.GroupID}}">{{.TestName}}</a>{{else}}{{.TestName}}{{end}}{{if .JobName}}<div class="rv-li-sub">{{ctx.Locale.Tr "asc_trust.checks.in_job" .JobName}}</div>{{end}}</td>
									<td data-label="{{ctx.Locale.Tr "asc_trust.checks.col_rate"}}">{{.RatePercent}}%</td>
									<td data-label="{{ctx.Locale.Tr "asc_trust.checks.col_runs"}}">{{.Runs}}</td>
									<td data-label="{{ctx.Locale.Tr "asc_trust.checks.col_last_flip"}}" class="rv-nowrap">{{DateUtils.TimeSince .LastFlip}}</td>
								</tr>
								{{else}}
								<tr><td colspan="4" class="rv-center rv-muted" data-testid="asc-flaky-empty">{{ctx.Locale.Tr "asc_trust.checks.flaky_empty"}}</td></tr>
								{{end}}
							</tbody>
						</table>
					</div>
					{{if .NextURL}}<div class="rv-card-f rv-center"><a class="rv-btn rv-btn-secondary" href="{{.NextURL}}" rel="next">{{ctx.Locale.Tr "asc_trust.checks.more_tests"}}</a></div>{{end}}
				</section>
				</div>
				{{end}}

				{{if and (eq .View "trends") (not .Problem)}}
				<div class="rv-stack" data-asc-list-main>
					<div class="rv-card ag-loading" role="status" aria-busy="true" aria-label="{{ctx.Locale.Tr "asc_rp.loading"}}" data-asc-list-loading data-testid="asc-trends-loading" hidden>
						<ul class="rv-list" aria-hidden="true">
							<li class="ag-sk-row"><span class="ag-sk-main"><span class="rv-sk ag-sk-t"></span><span class="rv-sk ag-sk-s"></span></span><span class="rv-sk ag-sk-pill"></span></li>
							<li class="ag-sk-row"><span class="ag-sk-main"><span class="rv-sk ag-sk-t"></span><span class="rv-sk ag-sk-s"></span></span><span class="rv-sk ag-sk-pill"></span></li>
							<li class="ag-sk-row"><span class="ag-sk-main"><span class="rv-sk ag-sk-t"></span><span class="rv-sk ag-sk-s"></span></span><span class="rv-sk ag-sk-pill"></span></li>
						</ul>
					</div>
				<section class="rv-card rv-gap" aria-labelledby="asc-trends">
					<div class="rv-card-h"><h2 id="asc-trends">{{ctx.Locale.Tr "asc_trust.checks.trends_title"}}</h2><span class="rv-faint">{{ctx.Locale.Tr "asc_trust.checks.last_days" .Window}}</span></div>
					{{range .Trends}}
					<div class="rv-card-b rv-trend" data-testid="asc-trend">
						<h3 class="rv-h4"><a href="{{$.AscChecks.ChecksURL}}?job={{.Job | QueryEscape}}">{{.Job}}</a></h3>
						{{template "repo/asc_strip" .History}}
					</div>
					{{else}}
					<p class="rv-card-b rv-muted" data-testid="asc-trends-empty">{{ctx.Locale.Tr "asc_trust.checks.trends_empty"}}</p>
					{{end}}
				</section>
				</div>
				{{end}}
			{{end}}
		</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
