{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="ds-main page-content repository commits rp-page rp-activity">
	{{template "repo/header" (dict "HdrData" . "SubTitle" (ctx.Locale.Tr "asc_rp.insights") "SubBack" .RepoLink)}}
	<div class="ds-container rp-body rp-skin">
		{{template "base/alert" .}}
		<div class="rp-insights">
			{{if and (not .IsEmptyRepo) (.Permission.CanRead $.UnitTypeCode)}}
				<div class="rp-insights-nav">
					{{template "repo/navbar" .}}
				</div>
			{{end}}
			<div class="rp-insights-main">
				{{if .PageIsPulse}}{{template "repo/pulse" .}}{{end}}
				{{if .PageIsContributors}}{{template "repo/contributors" .}}{{end}}
				{{if .PageIsCodeFrequency}}{{template "repo/code_frequency" .}}{{end}}
				{{if .PageIsRecentCommits}}{{template "repo/recent_commits" .}}{{end}}
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
