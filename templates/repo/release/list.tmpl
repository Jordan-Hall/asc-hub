{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="ds-main page-content repository releases rp-page">
	{{template "repo/header" (dict "HdrData" . "SubTitle" (ctx.Locale.Tr "repo.releases") "SubBack" .RepoLink)}}
	<div class="ds-container rp-body">
		{{template "base/alert" .}}
		{{template "repo/release_tag_header" .}}
		{{if .Releases}}
		<div class="ds-split">
		<div class="ds-min0">
		<ul id="release-list" class="rp-rels">
			{{range $idx, $info := .Releases}}
				{{$release := $info.Release}}
				<li class="rp-rel">
					<time class="rp-rel-date">{{if $release.CreatedUnix}}{{DateUtils.AbsoluteShort $release.CreatedUnix}}{{end}}</time>
					<span class="rp-rel-node{{if $release.IsPrerelease}} is-pre{{end}}" aria-hidden="true"></span>
					<article class="rp-rel-card" aria-labelledby="rp-rel-{{$release.ID}}">
						<header class="rp-rel-h">
							<div class="rp-rel-title">
								<h3 class="rp-rel-tag ds-mono" id="rp-rel-{{$release.ID}}">
									<a href="{{if not (and $release.Sha1 ($.Permission.CanRead $.UnitTypeCode))}}#{{else}}{{$.RepoLink}}/src/tag/{{$release.TagName | PathEscapeSegments}}{{end}}" rel="nofollow">{{$release.TagName}}</a>
								</h3>
								{{if $release.IsDraft}}<span class="ds-chip ds-chip-warn">{{ctx.Locale.Tr "repo.release.draft"}}</span>
								{{else if $release.IsPrerelease}}<span class="ds-chip ds-chip-warn">{{ctx.Locale.Tr "repo.release.prerelease"}}</span>
								{{else if (not $release.IsTag)}}<span class="ds-chip ds-chip-ok">{{if and $.LatestStable (eq $.LatestStable.Release.ID $release.ID)}}{{ctx.Locale.Tr "repo.release.latest"}}{{else}}{{ctx.Locale.Tr "repo.release.stable"}}{{end}}</span>{{end}}
								{{template "repo/commit_statuses" dict "Status" $info.CommitStatus "Statuses" $info.CommitStatuses "AdditionalClasses" "tw-flex"}}
							</div>
							<div class="rp-rel-acts">
								{{if and (not $release.IsDraft) ($.Permission.CanRead $.UnitTypeCode)}}
									<a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{$.RepoLink}}/compare/{{$release.TagName | PathEscapeSegments}}...{{$release.TargetBehind | PathEscapeSegments}}">{{ctx.Locale.Tr "asc_rp.compare"}}</a>
								{{end}}
								{{if and $.CanCreateRelease (not $release.IsTag)}}
									<a class="ds-btn ds-btn-secondary ds-btn-sm ds-btn-icon" title="{{ctx.Locale.Tr "repo.release.edit"}}" aria-label="{{ctx.Locale.Tr "repo.release.edit"}}" href="{{$.RepoLink}}/releases/edit/{{$release.TagName | PathEscapeSegments}}" rel="nofollow">{{svg "dsi-pencil" 16}}</a>
								{{end}}
							</div>
						</header>
						<div class="rp-rel-body detail">
							<h4 class="rp-rel-name"><a href="{{$.RepoLink}}/releases/tag/{{$release.TagName | PathEscapeSegments}}">{{$release.Title}}</a></h4>
							<p class="rp-ref-meta">
								<span class="author rp-ref-who">
								{{if $release.OriginalAuthor}}
									{{svg (MigrationIcon $release.Repo.GetOriginalURLHostname) 20 "tw-mr-1"}}{{$release.OriginalAuthor}}
								{{else if $release.Publisher}}
									{{ctx.AvatarUtils.Avatar $release.Publisher 20 "ds-av ds-av-24"}}
									{{template "shared/user/authorlink" $release.Publisher}}
								{{else}}
									{{template "shared/user/authorlink" (dict "ID" -1)}}
								{{end}}
								</span>
								<span class="released">{{ctx.Locale.Tr "repo.released_this"}}</span>
								{{if $release.CreatedUnix}}<span class="time">{{DateUtils.TimeSince $release.CreatedUnix}}</span>{{end}}
								{{if and $release.Sha1 ($.Permission.CanRead $.UnitTypeCode)}}
									<a class="rp-hash" href="{{$.RepoLink}}/src/commit/{{$release.Sha1}}" rel="nofollow">{{ShortSha $release.Sha1}}</a>
								{{end}}
								{{if and (not $release.IsDraft) ($.Permission.CanRead $.UnitTypeCode)}}
									<span class="ahead"><a href="{{$.RepoLink}}/compare/{{$release.TagName | PathEscapeSegments}}...{{$release.TargetBehind | PathEscapeSegments}}">{{ctx.Locale.TrN $release.NumCommitsBehind "repo.release.ahead.commits_one" "repo.release.ahead.commits" $release.NumCommitsBehind}}</a> {{ctx.Locale.Tr "repo.release.ahead.target" $release.TargetBehind}}</span>
								{{end}}
							</p>
							{{template "repo/tag/verification_line" (dict "ctxData" $ "release" $release)}}
							{{if $info.ChecksTotal}}
								<p class="rp-rel-prov" data-testid="release-provenance">{{ctx.Locale.Tr "asc_rp.rel_prov" (ShortSha $release.Sha1) $info.ChecksPass $info.ChecksTotal}}</p>
							{{end}}
							{{if $release.RenderedNote}}
								<div class="markup desc rp-rel-notes">
									{{$release.RenderedNote}}
								</div>
							{{end}}
							{{with $info.Changes}}
								{{if .Total}}
								<details class="rp-rel-changes" data-testid="release-changes"{{if eq $idx 0}} open{{end}}>
									<summary>
										<span class="rp-assets-t">{{ctx.Locale.TrN .Total "asc_rp.rel_changes_one" "asc_rp.rel_changes_other" (ctx.Locale.PrettyNumber .Total)}}{{if .Agents}} &middot; {{ctx.Locale.Tr "asc_rp.rel_by_agents" .Agents}}{{end}}</span>
										{{svg "dsi-chevron-down" 16}}
									</summary>
									<p class="rp-quiet">{{ctx.Locale.Tr "asc_rp.rel_written_from"}}{{if .Previous}} {{ctx.Locale.Tr "asc_rp.rel_since_tag" .Previous}}{{end}}</p>
									{{range .Groups}}
										<h5 class="rp-rel-group">{{ctx.Locale.Tr (print "asc_rp.rel_cat_" .Category)}}</h5>
										<ul class="rp-rel-list">
											{{range .Changes}}
												<li>
													<a href="{{$.RepoLink}}/commit/{{PathEscape .Sha}}">{{.Summary}}</a>
													<span class="rp-rel-who">{{if .User}}{{.User.GetDisplayName}}{{else}}{{.Author}}{{end}}{{if .Agent}} <span class="ds-chip ds-chip-agent">{{ctx.Locale.Tr "asc_rp.agent"}}</span>{{end}}</span>
													<a class="rp-hash" href="{{$.RepoLink}}/commit/{{PathEscape .Sha}}">{{ShortSha .Sha}}</a>
												</li>
											{{end}}
										</ul>
									{{end}}
								</details>
								{{end}}
							{{end}}
						</div>
						{{$hasReleaseAttachment := gt (len $release.Attachments) 0}}
						{{$hasArchiveLinks := and (not $.DisableDownloadSourceArchives) (not $release.IsDraft) (not $release.HideArchiveLinks) ($.Permission.CanRead $.UnitTypeCode)}}
						{{if or $hasArchiveLinks $hasReleaseAttachment}}
							<details class="download rp-assets" {{if eq $idx 0}}open{{end}}>
								<summary>
									<span class="rp-assets-t">{{ctx.Locale.Tr "repo.release.downloads"}}</span>
									{{svg "dsi-chevron-down" 16}}
								</summary>
								<div class="ds-table-wrap rp-asset-wrap">
								<table class="ds-table rp-asset-table">
									<caption class="ds-sr">{{ctx.Locale.Tr "repo.release.downloads"}}</caption>
									<thead><tr><th scope="col">{{ctx.Locale.Tr "asc_rp.asset_name"}}</th><th scope="col" class="ds-r">{{ctx.Locale.Tr "asc_rp.asset_size"}}</th><th scope="col" class="ds-r">{{ctx.Locale.Tr "asc_rp.asset_downloads"}}</th></tr></thead>
									<tbody>
									{{if $hasArchiveLinks}}
										<tr>
											<td data-label="{{ctx.Locale.Tr "asc_rp.asset_name"}}"><a class="archive-link rp-asset-name" href="{{$.RepoLink}}/archive/{{$release.TagName | PathEscapeSegments}}.zip" rel="nofollow" type="application/zip">{{svg "dsi-download" 16}}{{ctx.Locale.Tr "repo.release.source_code"}} (ZIP)</a> <span class="rp-asset-meta">{{ctx.Locale.Tr "repo.release.system_generated"}}</span></td>
											<td class="ds-r" data-label="{{ctx.Locale.Tr "asc_rp.asset_size"}}">&mdash;</td>
											<td class="ds-r" data-label="{{ctx.Locale.Tr "asc_rp.asset_downloads"}}">{{ctx.Locale.PrettyNumber .Release.ArchiveDownloadCount.Zip}}</td>
										</tr>
										<tr>
											<td data-label="{{ctx.Locale.Tr "asc_rp.asset_name"}}"><a class="archive-link rp-asset-name" href="{{$.RepoLink}}/archive/{{$release.TagName | PathEscapeSegments}}.tar.gz" rel="nofollow" type="application/gzip">{{svg "dsi-download" 16}}{{ctx.Locale.Tr "repo.release.source_code"}} (TAR.GZ)</a> <span class="rp-asset-meta">{{ctx.Locale.Tr "repo.release.system_generated"}}</span></td>
											<td class="ds-r" data-label="{{ctx.Locale.Tr "asc_rp.asset_size"}}">&mdash;</td>
											<td class="ds-r" data-label="{{ctx.Locale.Tr "asc_rp.asset_downloads"}}">{{ctx.Locale.PrettyNumber .Release.ArchiveDownloadCount.TarGz}}</td>
										</tr>
									{{end}}
									{{range $release.Attachments}}
										{{if .ExternalURL}}
											<tr>
												<td data-label="{{ctx.Locale.Tr "asc_rp.asset_name"}}"><a class="rp-asset-name" target="_blank" rel="nofollow noopener" href="{{.DownloadURL}}">{{svg "dsi-external" 16}}{{.Name}}</a></td>
												<td class="ds-r" data-label="{{ctx.Locale.Tr "asc_rp.asset_size"}}">&mdash;</td>
												<td class="ds-r" data-label="{{ctx.Locale.Tr "asc_rp.asset_downloads"}}">&mdash;</td>
											</tr>
										{{else}}
											<tr class="attachment">
												<td data-label="{{ctx.Locale.Tr "asc_rp.asset_name"}}"><a class="rp-asset-name" target="_blank" rel="nofollow" href="{{.DownloadURL}}" download>{{svg "dsi-package" 16}}{{.Name}}</a></td>
												<td class="ds-r" data-label="{{ctx.Locale.Tr "asc_rp.asset_size"}}">{{.Size | ctx.Locale.TrSize}}</td>
												<td class="ds-r" data-label="{{ctx.Locale.Tr "asc_rp.asset_downloads"}}">{{ctx.Locale.PrettyNumber .DownloadCount}}</td>
											</tr>
										{{end}}
									{{end}}
									</tbody>
								</table>
								</div>
							</details>
						{{end}}
					</article>
				</li>
			{{end}}
		</ul>
		</div>
		<aside class="ds-rail rp-rel-rail" aria-label="{{ctx.Locale.Tr "asc_rp.rel_rail"}}">
			{{with .LatestStable}}
			<section class="rp-card" aria-labelledby="rp-next-h" data-testid="release-next">
				<p class="ds-t-micro">{{ctx.Locale.Tr "asc_rp.rel_next"}}</p>
				<h2 class="rp-rail-title" id="rp-next-h">{{ctx.Locale.TrN .Release.NumCommitsBehind "asc_rp.rel_since_one" "asc_rp.rel_since_other" .Release.NumCommitsBehind .Release.TagName}}</h2>
				{{if and $.CanCreateRelease ($.Permission.CanRead $.UnitTypeCode)}}
				<div class="ds-row ds-row-wrap">
					<a class="ds-btn ds-btn-primary" href="{{$.RepoLink}}/releases/new">{{ctx.Locale.Tr "repo.release.new_release"}}</a>
					<a class="ds-btn ds-btn-secondary" href="{{$.RepoLink}}/compare/{{.Release.TagName | PathEscapeSegments}}...{{.Release.TargetBehind | PathEscapeSegments}}">{{ctx.Locale.Tr "asc_rp.rel_view"}}</a>
				</div>
				{{end}}
			</section>
			<section class="rp-card" aria-labelledby="rp-dl-h" data-testid="release-download">
				<h2 class="rp-rail-title" id="rp-dl-h">{{ctx.Locale.Tr "asc_rp.rel_download"}}</h2>
				<p class="rp-rel-line"><a class="rp-rel-name" href="{{$.RepoLink}}/releases/tag/{{.Release.TagName | PathEscapeSegments}}">{{.Release.TagName}}</a></p>
				{{if .Release.Attachments}}
				<ul class="rp-rail-list">
					{{range .Release.Attachments}}{{if not .ExternalURL}}<li><a href="{{.DownloadURL}}" download>{{.Name}}</a><span class="ds-num ds-c-2">{{.Size | ctx.Locale.TrSize}}</span></li>{{end}}{{end}}
				</ul>
				{{else}}<p class="rp-quiet">{{ctx.Locale.Tr "asc_rp.rel_no_assets"}}</p>{{end}}
			</section>
			{{end}}
			{{if .EnableFeed}}
			<section class="rp-card" aria-labelledby="rp-notify-h">
				<h2 class="rp-rail-title" id="rp-notify-h">{{ctx.Locale.Tr "asc_rp.rel_notify"}}</h2>
				<p class="rp-quiet">{{ctx.Locale.Tr "asc_rp.rel_notify_body"}}</p>
				<a class="ds-btn ds-btn-secondary" href="{{.RepoLink}}/releases.atom">{{ctx.Locale.Tr "asc_rp.rel_atom"}}</a>
			</section>
			{{end}}
		</aside>
		</div>
		{{else}}
			<div class="rp-sec rp-sec-b">
				{{template "shared/ds/empty" (dict "Icon" "package" "Title" (ctx.Locale.Tr "asc_rp.no_releases_title") "Body" (ctx.Locale.Tr "asc_rp.no_releases_body"))}}
			</div>
		{{end}}
		{{template "base/paginate" .}}
	</div>
</div>

{{template "base/footer" .}}
