{{/* The intent, facts strip, stack position, review and "where it is now" of a change (board Changeset). Dot: page data. */}}
{{if and .ChangeFacts (not .PageIsWiki)}}
<div class="rp-facts" data-testid="change-facts">
	{{if .ChangeIntent}}
	<section class="ds-card rp-why" aria-labelledby="rp-why-h">
		<h2 class="rp-rail-title" id="rp-why-h">{{ctx.Locale.Tr "asc_rp.why_exists"}}</h2>
		<p class="rp-why-text">{{.ChangeIntent}}</p>
	</section>
	{{end}}
	<dl class="rp-factstrip">
		<div><dt>{{ctx.Locale.Tr "asc_rp.fact_size"}}</dt><dd class="ds-num"><span class="rp-add">+{{.ChangeFacts.Additions}}</span> <span class="rp-del">&minus;{{.ChangeFacts.Deletions}}</span></dd></div>
		<div><dt>{{ctx.Locale.Tr "asc_rp.fact_files"}}</dt><dd class="ds-num">{{ctx.Locale.PrettyNumber .ChangeFacts.Files}}</dd></div>
		{{if .ChangeFacts.ChecksTotal}}<div><dt>{{ctx.Locale.Tr "asc_rp.fact_checks"}}</dt><dd class="ds-num">{{ctx.Locale.Tr "asc_rp.checks_n_of_n" .ChangeFacts.ChecksPass .ChangeFacts.ChecksTotal}}</dd></div>{{end}}
		{{with .ChangeBrief}}{{if .RiskLevel}}<div data-testid="change-fact-risk"><dt>{{ctx.Locale.Tr "asc_rp.fact_risk"}}</dt><dd>{{ctx.Locale.Tr (printf "asc_rp.risk_word_%s" .RiskLevel)}}</dd></div>{{end}}{{end}}
	</dl>
	{{with .ChangeBrief}}
	<section class="ds-card rp-look" aria-labelledby="rp-look-h" data-testid="change-brief">
		{{if .Where}}
		<h2 class="rp-rail-title" id="rp-look-h">{{ctx.Locale.Tr "asc_rp.where_to_look"}}</h2>
		<ul class="rp-look-list">
			{{range .Where}}<li><a href="{{.Link}}"><code>{{.Path}}{{if .Line}}:{{.Line}}{{end}}</code></a>{{if .Note}} <span>{{.Note}}</span>{{end}}</li>{{end}}
		</ul>
		{{else}}
		<h2 class="rp-rail-title" id="rp-look-h">{{ctx.Locale.Tr "asc_rp.fact_risk"}}</h2>
		{{end}}
		{{if or .RiskLevel .RiskNote}}
		<p class="rp-look-risk" data-testid="change-risk">{{if .Where}}<strong>{{ctx.Locale.Tr "asc_rp.fact_risk"}}</strong> {{end}}{{if .RiskLevel}}<span class="ds-chip {{if eq .RiskLevel "high"}}ds-chip-err{{else if eq .RiskLevel "medium"}}ds-chip-warn{{else}}ds-chip-ok{{end}}">{{ctx.Locale.Tr (printf "asc_review.risk_%s" .RiskLevel)}}</span>{{end}}{{if .RiskNote}} <span class="rp-look-note">{{.RiskNote}}</span>{{end}}</p>
		{{if .RiskReasons}}<ul class="rp-look-reasons">{{range .RiskReasons}}<li>{{.}}</li>{{end}}</ul>{{end}}
		{{end}}
	</section>
	{{end}}
	{{with .AscChangeFiles}}
	<section class="ds-card rp-groups" aria-labelledby="rp-groups-h" data-testid="change-groups">
		<h2 class="rp-rail-title" id="rp-groups-h">{{ctx.Locale.Tr "asc_rp.groups_title" .Total}}</h2>
		{{range .Groups}}
		<details class="rp-group" data-group="{{.Key}}"{{if not .Folded}} open{{end}}>
			<summary><span class="rp-group-name">{{ctx.Locale.Tr (print "asc_rp.group_" .Key)}}</span> <span class="ds-num">{{.Count}}</span> <span class="rp-delta"><span class="rp-add">+{{.Add}}</span> <span class="rp-del">&minus;{{.Del}}</span></span>{{if .Folded}} <span class="rp-quiet">{{ctx.Locale.Tr "asc_rp.group_folded"}}</span>{{end}}</summary>
			<ul class="rp-group-files">
				{{range .Files}}<li><a href="{{.Link}}"><code>{{.Name}}</code></a> <span class="rp-delta"><span class="rp-add">+{{.Add}}</span> <span class="rp-del">&minus;{{.Del}}</span></span></li>{{end}}
				{{if .More}}<li class="rp-quiet">{{ctx.Locale.Tr "asc_rp.rail_more" .More}}</li>{{end}}
			</ul>
		</details>
		{{end}}
		{{if .Hidden}}
		<p class="rp-groups-large" data-testid="change-large" role="status">{{ctx.Locale.Tr "asc_rp.large_state" .Total .Shown}} <a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{.AllLink}}">{{ctx.Locale.Tr "asc_rp.large_show_more" .Hidden}}</a></p>
		{{end}}
	</section>
	{{end}}
	{{with .ChangeStack}}
	<nav class="ds-card rp-stackpos" aria-label="{{ctx.Locale.Tr "asc_rp.stack_pos_label"}}">
		{{if .Prev}}<a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{.Prev.Link}}" rel="prev">{{svg "dsi-chevron-left" 16}}{{ctx.Locale.Tr "repo.diff.commit.previous-short"}}</a>{{else}}<span class="ds-btn ds-btn-secondary ds-btn-sm" aria-disabled="true">{{svg "dsi-chevron-left" 16}}{{ctx.Locale.Tr "repo.diff.commit.previous-short"}}</span>{{end}}
		<span class="rp-stackpos-t"><a href="{{.PullLink}}">{{ctx.Locale.Tr "asc_rp.stack_pos" .Position .Name}}</a> <span class="rp-quiet">{{ctx.Locale.Tr "asc_rp.stack_pos_of" .Total}}</span></span>
		{{if .Next}}<a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{.Next.Link}}" rel="next">{{ctx.Locale.Tr "repo.diff.commit.next-short"}}{{svg "dsi-chevron-right" 16}}</a>{{else}}<span class="ds-btn ds-btn-secondary ds-btn-sm" aria-disabled="true">{{ctx.Locale.Tr "repo.diff.commit.next-short"}}{{svg "dsi-chevron-right" 16}}</span>{{end}}
	</nav>
	{{end}}
</div>
{{end}}
