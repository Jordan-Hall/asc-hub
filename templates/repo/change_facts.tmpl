{{/* The intent, facts strip, stack position, review and "where it is now" of a change (board Changeset). Dot: page data. */}}
{{if and .ChangeFacts (not .PageIsWiki)}}
<div class="rp-facts" data-testid="change-facts">
	{{if .ChangeIntent}}
	<section class="ds-card rp-why" aria-labelledby="rp-why-h">
		<h2 class="rp-rail-title" id="rp-why-h">{{ctx.Locale.Tr "asc_rp.why_exists"}}</h2>
		<p class="rp-why-text">{{.ChangeIntent}}</p>
	</section>
	{{end}}
	<dl class="rp-factstrip">
		<div><dt>{{ctx.Locale.Tr "asc_rp.fact_size"}}</dt><dd class="ds-num"><span class="rp-add">+{{.ChangeFacts.Additions}}</span> <span class="rp-del">&minus;{{.ChangeFacts.Deletions}}</span></dd></div>
		<div><dt>{{ctx.Locale.Tr "asc_rp.fact_files"}}</dt><dd class="ds-num">{{ctx.Locale.PrettyNumber .ChangeFacts.Files}}</dd></div>
		{{if .ChangeFacts.ChecksTotal}}<div><dt>{{ctx.Locale.Tr "asc_rp.fact_checks"}}</dt><dd class="ds-num">{{ctx.Locale.Tr "asc_rp.checks_n_of_n" .ChangeFacts.ChecksPass .ChangeFacts.ChecksTotal}}</dd></div>{{end}}
	</dl>
	{{with .ChangeStack}}
	<nav class="ds-card rp-stackpos" aria-label="{{ctx.Locale.Tr "asc_rp.stack_pos_label"}}">
		{{if .Prev}}<a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{.Prev.Link}}" rel="prev">{{svg "dsi-chevron-left" 16}}{{ctx.Locale.Tr "repo.diff.commit.previous-short"}}</a>{{else}}<span class="ds-btn ds-btn-secondary ds-btn-sm" aria-disabled="true">{{svg "dsi-chevron-left" 16}}{{ctx.Locale.Tr "repo.diff.commit.previous-short"}}</span>{{end}}
		<span class="rp-stackpos-t"><a href="{{.PullLink}}">{{ctx.Locale.Tr "asc_rp.stack_pos" .Position .Name}}</a> <span class="rp-quiet">{{ctx.Locale.Tr "asc_rp.stack_pos_of" .Total}}</span></span>
		{{if .Next}}<a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{.Next.Link}}" rel="next">{{ctx.Locale.Tr "repo.diff.commit.next-short"}}{{svg "dsi-chevron-right" 16}}</a>{{else}}<span class="ds-btn ds-btn-secondary ds-btn-sm" aria-disabled="true">{{ctx.Locale.Tr "repo.diff.commit.next-short"}}{{svg "dsi-chevron-right" 16}}</span>{{end}}
	</nav>
	{{end}}
</div>
{{end}}
