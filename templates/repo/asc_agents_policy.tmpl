{{/*
What agents may do in this repository, from the repository policy ([agents] in .asc/policy.toml). Dot: the page data.
Template Attributes:
* AscAgentPolicy: ascAgentPolicy (Known, Scope, Denied, MaxChanges, MaxPaths)
The server enforces all of this on every update; the page only shows it.
*/}}
{{with .AscAgentPolicy}}
	<section class="rv-card rv-policy" aria-labelledby="rv-policy-title" data-testid="asc-agent-policy">
		<div class="rv-card-h"><h2 id="rv-policy-title">{{ctx.Locale.Tr "asc_review.policy_title"}}</h2></div>
		<div class="rv-card-b">
			{{if .Known}}
				<ul class="rv-access">
					<li><span class="rv-can">{{ctx.Locale.Tr "asc_review.policy_can"}}</span> {{ctx.Locale.Tr "asc_review.policy_read"}}</li>
					<li><span class="rv-can">{{ctx.Locale.Tr "asc_review.policy_can"}}</span> {{ctx.Locale.Tr "asc_review.policy_write"}}
						{{range $i, $g := .Scope}}{{if $i}}, {{end}}<code>{{$g}}</code>{{else}}{{ctx.Locale.Tr "asc_review.policy_write_default"}}{{end}}
					</li>
					<li><span class="rv-can">{{ctx.Locale.Tr "asc_review.policy_can"}}</span> {{ctx.Locale.Tr "asc_review.policy_stack"}}</li>
					<li><span class="rv-cannot">{{ctx.Locale.Tr "asc_review.policy_cannot"}}</span> {{ctx.Locale.Tr "asc_review.policy_no_trunk"}}</li>
					{{if .Denied}}<li><span class="rv-cannot">{{ctx.Locale.Tr "asc_review.policy_cannot"}}</span> {{ctx.Locale.Tr "asc_review.policy_denied"}} {{range $i, $g := .Denied}}{{if $i}}, {{end}}<code>{{$g}}</code>{{end}}</li>{{end}}
					{{if .MaxChanges}}<li><span class="rv-limit">{{ctx.Locale.Tr "asc_review.policy_limit"}}</span> {{ctx.Locale.Tr "asc_review.policy_max_changes" .MaxChanges}}</li>{{end}}
					{{if .MaxPaths}}<li><span class="rv-limit">{{ctx.Locale.Tr "asc_review.policy_limit"}}</span> {{ctx.Locale.Tr "asc_review.policy_max_paths" .MaxPaths}}</li>{{end}}
				</ul>
			{{else}}
				<p class="rv-muted">{{ctx.Locale.Tr "asc_review.policy_unknown"}}</p>
			{{end}}
		</div>
	</section>
{{end}}
