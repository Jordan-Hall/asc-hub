<div id="issue-filters" class="issue-list-toolbar wk-toolbar">
	<div class="issue-list-toolbar-left">
		{{if and $.CanWriteIssuesOrPulls .Issues}}
			<input type="checkbox" autocomplete="off" class="issue-checkbox-all tw-mr-4" title="{{ctx.Locale.Tr "repo.issues.action_check_all"}}">
		{{end}}
		{{template "repo/issue/openclose" .}}
		<!-- Total Tracked Time -->
		{{if .TotalTrackedTime}}
			<span class="wk-issue-stat" data-tooltip-content='{{ctx.Locale.Tr "tracked_time_summary"}}'>
				<span aria-hidden="true">{{svg "octicon-clock"}}</span>
				{{.TotalTrackedTime | Sec2Time}}
			</span>
		{{end}}
	</div>
	<div class="issue-list-toolbar-right">
		<div class="ui secondary filter menu">
			{{if .PageIsMilestones}}
				{{template "repo/issue/milestone/filter_list" .}}
			{{else}}
				{{template "repo/issue/filter_list" .}}
			{{end}}
		</div>
	</div>
</div>
