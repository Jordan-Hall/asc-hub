{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository view issue pull asc-repo-page asc-review-page">
	{{template "repo/header" .}}
	<div class="ui container">
		{{$rail := and .Issue.IsPull .PageIsPullConversation .AscStackPanel}}
		<div class="{{if $rail}}asc-review-layout{{end}}">
			{{if $rail}}
				<nav class="asc-stack-rail" aria-label="{{ctx.Locale.Tr "repo.pulls.asc_stack"}}">
					{{template "repo/pulls/asc_stack" .}}
				</nav>
			{{end}}
			<div class="{{if $rail}}asc-review-main{{end}}">
				{{template "repo/issue/view_title" .}}
				{{if .Issue.IsPull}}
					{{template "repo/pulls/tab_menu" .}}
				{{end}}
				{{template "repo/issue/view_content" .}}
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
