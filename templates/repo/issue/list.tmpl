{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="ds-main page-content repository issue-list rp-page">
	{{template "repo/header" (dict "HdrData" . "SubTitle" .Title "SubBack" .RepoLink)}}
	<div class="ds-container rp-body rp-skin">
	{{template "base/alert" .}}
	<div class="rp-band rp-list-band">
		<div class="rp-band-main">
			<p class="rp-eyebrow">{{.Repository.FullName}}</p>
			<h2 class="rp-h1">{{if .PageIsIssueList}}{{ctx.Locale.Tr "repo.issues"}}{{else if eq .Repository.GetStorageBackend "asc"}}{{ctx.Locale.Tr "asc_rp.tab_stacks"}}{{else}}{{ctx.Locale.Tr "repo.pulls"}}{{end}}</h2>
		</div>
	</div>

	{{if .PinnedIssues}}
		<div id="issue-pins" {{if .IsRepoAdmin}}data-is-repo-admin{{end}}>
			{{range .PinnedIssues}}
				<div class="issue-card tw-break-anywhere {{if $.IsRepoAdmin}}tw-cursor-grab{{end}}" data-move-url="{{$.Link}}/move_pin" data-issue-id="{{.ID}}">
					{{template "repo/issue/card" (dict "Issue" . "Page" $ "isPinnedIssueCard" true)}}
				</div>
			{{end}}
		</div>
	{{end}}

		<div class="{{if .PageIsIssueList}}ds-split{{end}}">
		<div class="ds-min0">
		<div class="list-header list-header-issues">
			{{template "repo/issue/navbar" .}}
			{{template "repo/issue/search" .}}
			{{if not .Repository.IsArchived}}
				{{if .PageIsIssueList}}
					<a class="primary button issue-list-new" href="{{.RepoLink}}/issues/new{{if .NewIssueChooseTemplate}}/choose{{end}}">{{ctx.Locale.Tr "repo.issues.new"}}</a>
				{{else}}
					<a class="primary button new-pr-button issue-list-new{{if not .PullRequestCtx.Allowed}} disabled{{end}}" href="{{if .PullRequestCtx.Allowed}}{{.Repository.Link}}/compare/{{.Repository.DefaultBranch | PathEscapeSegments}}...{{if ne .Repository.Owner.Name .PullRequestCtx.BaseRepo.Owner.Name}}{{PathEscape .Repository.Owner.Name}}:{{end}}{{.Repository.DefaultBranch | PathEscapeSegments}}{{end}}">{{ctx.Locale.Tr "repo.pulls.new"}}</a>
				{{end}}
			{{else}}
				{{if not .PageIsIssueList}}
					<a class="primary button issue-list-new{{if not .PullRequestCtx.Allowed}} disabled{{end}}" href="{{if .PullRequestCtx.Allowed}}{{.PullRequestCtx.BaseRepo.Link}}/compare/{{.PullRequestCtx.BaseRepo.DefaultBranch | PathEscapeSegments}}...{{if ne .Repository.Owner.Name .PullRequestCtx.BaseRepo.Owner.Name}}{{PathEscape .Repository.Owner.Name}}:{{end}}{{.Repository.DefaultBranch | PathEscapeSegments}}{{end}}">{{ctx.Locale.Tr "action.compare_commits_general"}}</a>
				{{end}}
			{{end}}
		</div>

		{{template "repo/issue/filters" .}}

		<div id="issue-actions" class="issue-list-toolbar tw-hidden">
			<div class="issue-list-toolbar-left">
				{{template "repo/issue/openclose" .}}
				<!-- Total Tracked Time -->
				{{if .TotalTrackedTime}}
					<div class="ui compact tiny secondary menu">
						<span class="item" data-tooltip-content='{{ctx.Locale.Tr "tracked_time_summary"}}'>
							{{svg "octicon-clock"}}
							{{.TotalTrackedTime | Sec2Time}}
						</span>
					</div>
				{{end}}
			</div>
			<div class="issue-list-toolbar-right">
				{{template "repo/issue/filter_actions" .}}
			</div>
		</div>
		{{template "shared/issuelist" dict "." . "listType" "repo"}}
		</div>
		{{if .PageIsIssueList}}
		<aside class="ds-rail rp-issue-rail" aria-label="{{ctx.Locale.Tr "repo.issues.new.labels"}}">
			<section class="rp-card" aria-labelledby="rp-rail-labels">
				<div class="rp-rail-head"><h2 class="rp-rail-title" id="rp-rail-labels">{{ctx.Locale.Tr "repo.issues.new.labels"}}</h2><a class="rp-sec-act" href="{{.RepoLink}}/labels">{{ctx.Locale.Tr "asc_rp.rail_manage"}}</a></div>
				{{if .Labels}}
				<ul class="rp-rail-list">
					{{range .Labels}}
						<li><a href="{{$.RepoLink}}/issues?labels={{.ID}}">{{RenderLabel ctx .}}</a><span class="ds-num ds-c-2">{{Eval .NumIssues "-" .NumClosedIssues}}</span></li>
					{{end}}
				</ul>
				{{else}}<p class="rp-quiet">{{ctx.Locale.Tr "repo.issues.new.no_items"}}</p>{{end}}
			</section>
			{{with .OpenMilestones}}{{if not (eq (printf "%T" .) "bool")}}{{range $i, $m := .}}{{if eq $i 0}}
			<section class="rp-card" aria-labelledby="rp-rail-ms">
				<div class="rp-rail-head"><h2 class="rp-rail-title" id="rp-rail-ms">{{ctx.Locale.Tr "repo.issues.new.milestone"}}</h2><a class="rp-sec-act" href="{{$.RepoLink}}/milestones">{{ctx.Locale.Tr "asc_rp.rail_all"}}</a></div>
				<p class="rp-rel-line"><a class="rp-rel-name" href="{{$.RepoLink}}/milestone/{{$m.ID}}">{{$m.Name}}</a></p>
				<progress class="wk-progress" max="100" value="{{$m.Completeness}}" aria-label="{{$m.Completeness}}%">{{$m.Completeness}}%</progress>
				<p class="rp-quiet">{{ctx.Locale.Tr "repo.milestones.completeness" $m.Completeness}} &middot; {{ctx.Locale.Tr "asc_rp.ms_counts" $m.NumClosedIssues $m.NumOpenIssues}}</p>
			</section>
			{{end}}{{end}}{{end}}{{end}}
		</aside>
		{{end}}
		</div>
	</div>
</div>
{{template "base/footer" .}}
