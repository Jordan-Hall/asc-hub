<div class="ds-scrollx wk-states" role="group" aria-label="{{ctx.Locale.Tr "asc_work.is_state"}}">
	<a class="ds-chip-btn{{if eq .State "open"}} is-on{{end}}" {{if eq .State "open"}}aria-current="true"{{end}} href="{{.OpenLink}}" data-test-name="open-issue-count">
		{{ctx.Locale.PrettyNumber .OpenCount}}&nbsp;{{ctx.Locale.Tr "repo.issues.open_title"}}
	</a>
	<a class="ds-chip-btn{{if eq .State "closed"}} is-on{{end}}" {{if eq .State "closed"}}aria-current="true"{{end}} href="{{.ClosedLink}}" data-test-name="closed-issue-count">
		{{ctx.Locale.PrettyNumber .ClosedCount}}&nbsp;{{ctx.Locale.Tr "repo.issues.closed_title"}}
	</a>
	{{if not .PageIsMilestones}}
		<a class="ds-chip-btn{{if eq .State "all"}} is-on{{end}}" {{if eq .State "all"}}aria-current="true"{{end}} href="{{.AllStatesLink}}" data-test-name="all-issue-count">
			{{ctx.Locale.PrettyNumber (.AllCount)}}&nbsp;{{ctx.Locale.Tr "repo.issues.all_title"}}
		</a>
	{{end}}
</div>
