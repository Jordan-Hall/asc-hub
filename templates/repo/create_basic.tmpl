{{$owner := .ContextUser}}{{if and (not .CanCreateRepo) .Orgs}}{{$owner = index .Orgs 0}}{{end}}
<div class="ds-form-row ds-form-row-2">
	<div class="ds-field">
		<label class="ds-label" id="repo_owner_label" for="uid">{{ctx.Locale.Tr "repo.owner"}}</label>
		{{/* the uid id is used by the repo-template code; a native select is a sheet on a phone */}}
		<select id="uid" name="uid" class="ds-select{{if .Err_Owner}} is-err{{end}}" required aria-describedby="repo_owner_help">
			{{if .CanCreateRepo}}
				<option value="{{.SignedUser.ID}}"{{if eq $owner.ID .SignedUser.ID}} selected{{end}}>{{.SignedUser.ShortName 40}}</option>
			{{end}}
			{{range .Orgs}}
				<option value="{{.ID}}"{{if eq $owner.ID .ID}} selected{{end}}>{{.ShortName 40}}</option>
			{{end}}
		</select>
		<div class="ds-hint" id="repo_owner_help">{{ctx.Locale.Tr "repo.owner_helper"}}</div>
	</div>
	<div class="ds-field">
		<label class="ds-label" for="repo_name">{{ctx.Locale.Tr "repo.repo_name"}}</label>
		<input id="repo_name" class="ds-input{{if .Err_RepoName}} is-err{{end}}" name="repo_name" value="{{.repo_name}}" required maxlength="100" autocorrect="off" autocapitalize="none" spellcheck="false" autocomplete="off"{{if .Err_RepoName}} aria-invalid="true"{{end}} aria-describedby="repo_name_help">
		<div class="ds-hint" id="repo_name_help">{{ctx.Locale.Tr "repo.repo_name_helper"}}</div>
		<div class="ds-hint" id="repo_name_status" role="status" aria-live="polite" data-check-url="{{AppSubUrl}}/repo/check_name" data-ok-text="{{ctx.Locale.Tr "asc_rp.newrepo_name_free"}}" data-testid="newrepo-name-status" hidden></div>
	</div>
</div>
<div class="ds-field">
	<label class="ds-label" for="repo_desc">{{ctx.Locale.Tr "repo.repo_desc"}} <span class="ds-opt">({{ctx.Locale.Tr "asc_shell.optional"}})</span></label>
	<textarea id="repo_desc" class="ds-textarea{{if .Err_Description}} is-err{{end}}" rows="2" name="description" placeholder="{{ctx.Locale.Tr "repo.repo_desc_helper"}}" maxlength="2048"{{if .Err_Description}} aria-invalid="true"{{end}}>{{.description}}</textarea>
</div>
{{template "repo/visibility_cards" (dict "Current" .visibility "Forced" .IsForcedPrivate)}}
