{{/*
The agent runs of a repository (routers/web/repo/asc_agents.go).
Template Attributes:
* AscAgentsRuns: []ascAgentRunRow, AscAgentsActive / AscAgentsWaiting / AscAgentsDone: how many of them are in that state
* AscAgentsWaitingRuns: the runs of the page that wait for a person
* AscAgentsNext: the link to the next page, if any
* AscAgentsFilterState / AscAgentsFilterMine / AscAgentsFilterAgent, AscAgentsStateFilters
* AscAgentsFailure / AscAgentsDisabled: see repo/asc_agents_notice
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository rv-agents">
	{{template "repo/header" .}}
	<div class="rv rv-page">
		{{template "base/alert" .}}
		<div class="rv-area">{{template "repo/asc_agents_nav" .}}</div>
		<header class="rv-head">
			<div class="rv-head-main">
				<div class="rv-eyebrow">{{.Repository.FullName}} · {{ctx.Locale.Tr "asc_review.agents_eyebrow"}}</div>
				<h1 class="rv-title">{{ctx.Locale.Tr "asc_review.agents_title"}}</h1>
				<p class="rv-lead">{{ctx.Locale.Tr "asc_review.agents_lead"}}</p>
			</div>
			{{if .AscAgentsCanStart}}<div class="rv-acts rv-desk"><a class="rv-btn rv-btn-primary" href="{{.AscAgentsBase}}/new">{{ctx.Locale.Tr "asc_review.agents_new"}}</a></div>{{end}}
		</header>
		{{template "repo/asc_agents_notice" .}}

		{{if not .AscAgentsDisabled}}
			{{if and .AscAgentFeatures (not .AscAgentsFailure)}}
			<div class="rv-stats" role="group" aria-label="{{ctx.Locale.Tr "asc_review.agents_stats_label"}}">
				<div class="rv-card rv-stat"><div class="rv-stat-l">{{ctx.Locale.Tr "asc_review.agents_stat_active"}}</div><div class="rv-stat-v">{{.AscAgentsActive}}</div><div class="rv-stat-d">{{ctx.Locale.Tr "asc_review.agents_stat_on_page"}}</div></div>
				<div class="rv-card rv-stat"><div class="rv-stat-l">{{ctx.Locale.Tr "asc_review.agents_stat_waiting"}}</div><div class="rv-stat-v">{{.AscAgentsWaiting}}</div><div class="rv-stat-d">{{ctx.Locale.Tr "asc_review.agents_stat_on_page"}}</div></div>
				<div class="rv-card rv-stat"><div class="rv-stat-l">{{ctx.Locale.Tr "asc_review.agents_stat_done"}}</div><div class="rv-stat-v">{{.AscAgentsDone}}</div><div class="rv-stat-d">{{ctx.Locale.Tr "asc_review.agents_stat_on_page"}}</div></div>
				<div class="rv-card rv-stat"><div class="rv-stat-l">{{ctx.Locale.Tr "asc_review.agents_stat_shown"}}</div><div class="rv-stat-v">{{len .AscAgentsRuns}}</div><div class="rv-stat-d">{{ctx.Locale.Tr "asc_review.agents_stat_on_page"}}</div></div>
			</div>
			{{end}}

			{{if .AscAgentsWaitingRuns}}
				<section class="rv-banner rv-banner-warn rv-needs" aria-labelledby="rv-needs-h" data-testid="asc-agents-needs-you">
					<div>
						<h2 id="rv-needs-h" class="rv-h4">{{ctx.Locale.Tr "asc_review.agents_needs_you" (len .AscAgentsWaitingRuns)}}</h2>
						<ul class="rv-needs-list">
							{{range .AscAgentsWaitingRuns}}
								<li><span><b>{{.Agent}}</b> · {{ctx.Locale.Tr "asc_review.agents_run_n" .ID}} · {{.Title}}</span> <a class="rv-btn rv-btn-secondary rv-btn-sm" href="{{.Link}}">{{ctx.Locale.Tr "asc_review.agents_open_run"}}</a></li>
							{{end}}
						</ul>
					</div>
				</section>
			{{end}}

			<form class="rv-filters" method="get" action="{{.AscAgentsBase}}" role="search" aria-label="{{ctx.Locale.Tr "asc_review.agents_filter_label"}}">
				<div class="rv-chips" role="group" aria-label="{{ctx.Locale.Tr "asc_review.agents_filter_state"}}">
					<a class="rv-chip-btn" href="{{.AscAgentsBase}}{{if .AscAgentsFilterMine}}?mine=1{{end}}"{{if not .AscAgentsFilterState}} aria-current="true"{{end}}>{{ctx.Locale.Tr "asc_review.agents_filter_all"}}</a>
					{{range .AscAgentsStateFilters}}<a class="rv-chip-btn" href="{{$.AscAgentsBase}}?state={{.Slug}}{{if $.AscAgentsFilterMine}}&amp;mine=1{{end}}{{if $.AscAgentsFilterAgent}}&amp;agent={{$.AscAgentsFilterAgent}}{{end}}"{{if eq $.AscAgentsFilterState .Slug}} aria-current="true"{{end}}>{{ctx.Locale.Tr (print "asc_review.run_filter_" .Slug)}}</a>{{end}}
				</div>
				<div class="rv-filter-fields">
					{{if .AscAgentsFilterState}}<input type="hidden" name="state" value="{{.AscAgentsFilterState}}">{{end}}
					<div class="rv-field">
						<label class="rv-label" for="rv-ag-agent">{{ctx.Locale.Tr "asc_review.agents_filter_agent"}}</label>
						<input class="rv-input" id="rv-ag-agent" type="text" name="agent" maxlength="40" value="{{.AscAgentsFilterAgent}}" placeholder="{{ctx.Locale.Tr "asc_review.agents_filter_any"}}" autocomplete="off" autocapitalize="none" spellcheck="false">
					</div>
					<label class="rv-check"><input type="checkbox" name="mine" value="1"{{if .AscAgentsFilterMine}} checked{{end}}> {{ctx.Locale.Tr "asc_review.agents_filter_mine"}}</label>
					<button class="rv-btn rv-btn-secondary" type="submit">{{ctx.Locale.Tr "asc_review.agents_filter_apply"}}</button>
				</div>
			</form>

			{{if .AscAgentsRuns}}
				<ul class="rv-list rv-runs" data-testid="asc-agent-runs">
					{{range .AscAgentsRuns}}
						<li class="rv-run">
							<span class="rv-av rv-av-agent" aria-hidden="true">{{.Initials}}</span>
							<div class="rv-run-who">
								<div class="rv-run-name">{{if .Agent}}{{.Agent}}{{else}}{{ctx.Locale.Tr "asc_review.agents_unnamed"}}{{end}}</div>
								<div class="rv-li-sub">{{ctx.Locale.Tr "asc_review.agents_run_n" .ID}}{{if not .Created.IsZero}} · {{DateUtils.TimeSince .Created}}{{end}}{{if .CreatedBy}} · {{ctx.Locale.Tr "asc_review.agents_by" .CreatedBy}}{{end}}</div>
							</div>
							<div class="rv-run-state">{{template "repo/asc_agents_pill" .State}}</div>
							<h2 class="rv-run-title"><a href="{{.Link}}">{{.Title}}</a></h2>
							<div class="rv-li-meta">
								<span>{{ctx.Locale.TrN .Changes "asc_review.agents_changes_one" "asc_review.agents_changes_other" .Changes}}</span>
								<span class="rv-num">{{ctx.Locale.Tr "asc_review.agents_usage" .Tokens .Cost}}</span>
							</div>
							{{if .Failure}}<div class="rv-run-fail" role="note">{{.Failure}}</div>{{end}}
						</li>
					{{end}}
				</ul>
				{{if .AscAgentsNext}}<p class="rv-more"><a class="rv-btn rv-btn-secondary" href="{{.AscAgentsNext}}">{{ctx.Locale.Tr "asc_review.agents_older"}}</a></p>{{end}}
			{{else if not .AscAgentsFailure}}
				<div class="rv-empty" data-testid="asc-agent-runs-empty">
					{{if or .AscAgentsFilterState .AscAgentsFilterMine .AscAgentsFilterAgent}}
						<h2>{{ctx.Locale.Tr "asc_review.agents_none_match"}}</h2>
						<p>{{ctx.Locale.Tr "asc_review.agents_none_match_help"}}</p>
						<div class="rv-acts"><a class="rv-btn rv-btn-secondary" href="{{.AscAgentsBase}}">{{ctx.Locale.Tr "asc_review.agents_clear"}}</a></div>
					{{else}}
						<h2>{{ctx.Locale.Tr "asc_review.agents_none"}}</h2>
						<p>{{ctx.Locale.Tr "asc_review.agents_none_help"}}</p>
						{{if .AscAgentsCanStart}}<div class="rv-acts"><a class="rv-btn rv-btn-primary" href="{{.AscAgentsBase}}/new">{{ctx.Locale.Tr "asc_review.agents_new"}}</a></div>{{end}}
					{{end}}
				</div>
			{{end}}
			{{if .AscAgentsCanStart}}<div class="rv-sticky rv-mob"><a class="rv-btn rv-btn-primary" href="{{.AscAgentsBase}}/new">{{ctx.Locale.Tr "asc_review.agents_new"}}</a></div>{{end}}
		{{else}}
			<div class="rv-empty" data-testid="asc-agents-disabled">
				<h2>{{ctx.Locale.Tr "asc_review.agents_disabled_title"}}</h2>
				<p>{{ctx.Locale.Tr "asc_review.agents_disabled_help"}}</p>
			</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
