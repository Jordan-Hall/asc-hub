{{/*
The top of every repository page: the sub bar on a phone, the title row (owner / name, visibility, watch, star, fork) and the one tab strip of the repository.
Pass the page data as ".", or (dict "HdrData" . "SubTitle" "History of main" "SubBack" "/path") to name the phone bar yourself.
Settings pages (PageIsRepoSettings) bring their own sub bar.
*/}}
{{$d := .}}{{$subTitle := ""}}{{$subBack := ""}}
{{if .HdrData}}{{$d = .HdrData}}{{$subTitle = .SubTitle}}{{$subBack = .SubBack}}{{end}}
{{if not $d.PageIsRepoSettings}}
	{{template "shared/ds/subbar" (dict "Data" $d "Title" (or $subTitle $d.Repository.FullName) "BackHref" (or $subBack $d.Repository.Owner.HomeLink) "BackLabel" $d.Repository.Owner.Name)}}
{{end}}
{{template "repo/header_main" $d}}
