{{/* The commit list with its search and count. Used by History, a pull request's commits and the compare page. */}}
{{if .PageIsCommits}}
	<form class="rp-filters ignore-dirty" action="{{.RepoLink}}/commits/{{.BranchNameSubURL}}/search" role="search">
		<div class="ds-inwrap rp-search">
			<label class="ds-sr" for="commit-search-q">{{ctx.Locale.Tr "search.commit_kind"}}</label>
			{{svg "dsi-search" 16}}
			<input class="ds-input" id="commit-search-q" type="search" spellcheck="false" name="q" maxlength="255" placeholder="{{ctx.Locale.Tr "search.commit_kind"}}" value="{{.Keyword}}">
		</div>
		{{template "repo/commits_search_dropdown" .}}
		<button class="ds-btn ds-btn-secondary" type="submit">{{ctx.Locale.Tr "search.search"}}</button>
	</form>
{{end}}

<div class="rp-sec-note rp-count">
	{{if or .PageIsCommits (gt .CommitCount 0)}}
		{{ctx.Locale.TrPluralString .CommitCount "counters.n_commits" (ctx.Locale.PrettyNumber .CommitCount)}}
	{{else if .IsNothingToCompare}}
		{{ctx.Locale.Tr "repo.commits.nothing_to_compare"}}
	{{else}}
		{{ctx.Locale.Tr "repo.commits.no_commits" $.BaseBranch $.HeadBranch}}
	{{end}}
	{{if .IsDiffCompare}}
		<span class="rp-range">
			<a class="rp-hash" href="{{$.CommitRepoLink}}/commit/{{.BeforeCommitID | PathEscape}}">{{if not .BaseIsCommit}}{{.BaseBranch}}{{else}}{{ShortSha .BaseBranch}}{{end}}</a>
			<span aria-hidden="true">&hellip;</span>
			<a class="rp-hash" href="{{$.CommitRepoLink}}/commit/{{.AfterCommitID | PathEscape}}">{{if not .HeadIsCommit}}{{.HeadBranch}}{{else}}{{ShortSha .HeadBranch}}{{end}}</a>
		</span>
	{{end}}
</div>

{{if and .Commits (gt .CommitCount 0)}}
	<div class="rp-sec rp-histcard">
		{{if .PageIsPullCommits}}
			{{template "repo/pulls/commits_list" .}}
		{{else}}
			{{template "repo/commits_list" .}}
		{{end}}
	</div>
{{else if .PageIsCommits}}
	<div class="rp-sec">{{template "shared/ds/empty" (dict "Icon" "history" "Title" (ctx.Locale.Tr "asc_rp.no_commits_title") "Body" (ctx.Locale.Tr "asc_rp.no_commits_body"))}}</div>
{{end}}

{{if .OldFilename}}
	<p class="rp-quiet ds-mt-12">{{ctx.Locale.Tr "repo.commits.renamed_from" .OldFilename}} (<a class="ds-link" href="{{.OldFilenameHistory}}">{{ctx.Locale.Tr "repo.commits.browse_further"}}</a>)</p>
{{end}}

{{template "base/paginate" .}}
