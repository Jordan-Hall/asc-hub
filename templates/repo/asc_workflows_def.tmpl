{{/*
One workflow definition (routers/web/repo/asc_workflows.go).
Template Attributes:
* AscWorkflowDef: ascWorkflowDef, AscWorkflowText: the file as text, AscWorkflowForm: *ascWorkflowTriggerForm
* AscWorkflowRuns: []ascWorkflowRunRow (the latest of this workflow), CanChangeWorkflows
* CsrfTokenHtml
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository asc-agents">
	{{template "repo/header" .}}
	<div class="ui container">
		{{template "base/alert" .}}
		{{template "repo/asc_agents_nav" .}}
		{{template "repo/asc_agents_notice" .}}
		{{with .AscWorkflowDef}}
			<div class="asc-run-head">
				<h2 class="asc-ag-title">{{.Name}}</h2>
				{{if not .Valid}}<span class="asc-pill asc-tone-bad">Not valid</span>{{else if .Enabled}}<span class="asc-pill asc-tone-ok">On</span>{{else}}<span class="asc-pill asc-tone-idle">Off</span>{{end}}
				{{if and $.CanChangeWorkflows .Valid}}
					<form class="asc-inline-form" method="post" action="{{.Link}}/enable">
						{{$.CsrfTokenHtml}}
						<input type="hidden" name="enabled" value="{{if .Enabled}}0{{else}}1{{end}}">
						<button class="ui basic button" type="submit">{{if .Enabled}}Switch off{{else}}Switch on{{end}}</button>
					</form>
				{{end}}
			</div>
			{{if .Description}}<p>{{.Description}}</p>{{end}}
			<p class="asc-muted">
				{{if .Path}}<code>{{.Path}}</code>{{end}}
				{{if .Source}} · definition version <code>{{.Source}}</code>{{end}}
				· at most {{.MaxParallel}} run{{if ne .MaxParallel 1}}s{{end}} at once.
				The version on the trunk tip is the one that runs.
			</p>
			{{if .Error}}<div class="ui negative message" role="alert">{{.Error}}</div>{{end}}

			<div class="asc-split">
				<div class="asc-main">
					<section class="asc-card" aria-labelledby="asc-wf-steps">
						<h3 id="asc-wf-steps" class="asc-card-title">Steps</h3>
						<ol class="asc-steps" data-testid="asc-workflow-steps">
							{{range .Steps}}
								<li class="asc-step">
									<div class="asc-run-main"><strong><code>{{.ID}}</code></strong> <span class="asc-pill asc-tone-idle">{{.Kind}}</span></div>
									<div class="asc-run-meta">
										{{if .Needs}}<span>after {{range $i, $n := .Needs}}{{if $i}}, {{end}}<code>{{$n}}</code>{{end}}</span>{{end}}
										{{if .Agent}}<span>agent <code>{{.Agent}}</code></span>{{end}}
										{{if .Paths}}<span>writes {{range $i, $n := .Paths}}{{if $i}}, {{end}}<code>{{$n}}</code>{{end}}</span>{{end}}
										{{if .Approvers}}<span>approved by {{range $i, $n := .Approvers}}{{if $i}}, {{end}}{{$n}}{{end}}</span>{{end}}
										{{if .Checks}}<span>checks {{range $i, $n := .Checks}}{{if $i}}, {{end}}<code>{{$n}}</code>{{end}}</span>{{end}}
										{{if .Timeout}}<span>times out after {{.Timeout}}</span>{{end}}
										{{if .Continue}}<span>continues on failure</span>{{end}}
									</div>
									{{if .Prompt}}<details><summary>Prompt</summary><pre class="asc-pre">{{.Prompt}}</pre></details>{{end}}
								</li>
							{{else}}
								<li class="asc-muted">No steps.</li>
							{{end}}
						</ol>
					</section>

					<section class="asc-card" aria-labelledby="asc-wf-triggers">
						<h3 id="asc-wf-triggers" class="asc-card-title">Starts when</h3>
						<ul class="asc-plain">
							{{range .Triggers}}
								<li>{{.Label}}
									{{if .Branches}} on {{range $i, $n := .Branches}}{{if $i}}, {{end}}<code>{{$n}}</code>{{end}}{{end}}
									{{if .Paths}} touching {{range $i, $n := .Paths}}{{if $i}}, {{end}}<code>{{$n}}</code>{{end}}{{end}}
									{{if .Cron}} (<code>{{.Cron}}</code> UTC){{end}}
									{{if .Agent}} for <code>@{{.Agent}}</code>{{end}}
								</li>
							{{else}}
								<li class="asc-muted">Only by hand.</li>
							{{end}}
						</ul>
					</section>

					{{if $.CanChangeWorkflows}}{{if .Valid}}
						<section class="asc-card" aria-labelledby="asc-wf-run">
							<h3 id="asc-wf-run" class="asc-card-title">Run it now</h3>
							<form class="ui form asc-form" method="post" action="{{.Link}}/trigger" data-testid="asc-workflow-trigger">
								{{$.CsrfTokenHtml}}
								<input type="hidden" name="op" value="{{$.AscWorkflowForm.OpID}}">
								{{if $.AscWorkflowForm.Summary}}<div class="ui negative message" role="alert">{{$.AscWorkflowForm.Summary}}</div>{{end}}
								{{range .Inputs}}
									<div class="field{{if index $.AscWorkflowForm.Errors .Name}} error{{end}}">
										<label for="asc-wf-in-{{.Name}}">{{.Name}}{{if .Required}} <span class="asc-muted">(required)</span>{{end}}</label>
										<input id="asc-wf-in-{{.Name}}" name="in_{{.Name}}" type="text" maxlength="4096" value="{{index $.AscWorkflowForm.Values .Name}}" autocomplete="off"{{if .Required}} aria-required="true"{{end}}>
										{{if .Description}}<small class="asc-muted">{{.Description}}</small>{{end}}
										{{with index $.AscWorkflowForm.Errors .Name}}<div class="asc-field-error" role="alert">{{.}}</div>{{end}}
									</div>
								{{end}}
								<div class="field{{if index $.AscWorkflowForm.Errors "change"}} error{{end}}">
									<label for="asc-wf-change">Change <span class="asc-muted">(optional, 32 letters k to z)</span></label>
									<input id="asc-wf-change" name="change" type="text" maxlength="32" value="{{$.AscWorkflowForm.Change}}" autocomplete="off" autocapitalize="none" spellcheck="false">
									{{with index $.AscWorkflowForm.Errors "change"}}<div class="asc-field-error" role="alert">{{.}}</div>{{end}}
								</div>
								<button class="ui primary button" type="submit">Run workflow</button>
							</form>
						</section>
					{{end}}{{end}}

					<section class="asc-card" aria-labelledby="asc-wf-latest">
						<h3 id="asc-wf-latest" class="asc-card-title">Latest runs</h3>
						{{if $.AscWorkflowRuns}}
							{{template "repo/asc_workflows_runlist" $.AscWorkflowRuns}}
							<p><a href="{{$.AscWorkflowsBase}}/runs?workflow={{.Name}}">All runs of {{.Name}}</a></p>
						{{else}}
							<p class="asc-muted">It has not run yet.</p>
						{{end}}
					</section>
				</div>
				<aside class="asc-side" aria-label="Inputs and budget">
					{{if .Inputs}}
						<section class="asc-card" aria-labelledby="asc-wf-inputs">
							<h3 id="asc-wf-inputs" class="asc-card-title">Inputs</h3>
							<ul class="asc-plain">
								{{range .Inputs}}<li><code>{{.Name}}</code>{{if .Required}} (required){{end}}{{if .Default}}, default <code>{{.Default}}</code>{{end}}{{if .Description}}<br><span class="asc-muted">{{.Description}}</span>{{end}}</li>{{end}}
							</ul>
						</section>
					{{end}}
					{{if .HasAgent}}
						<section class="asc-card" aria-labelledby="asc-wf-budget">
							<h3 id="asc-wf-budget" class="asc-card-title">Budget</h3>
							{{template "repo/asc_agents_meters" .Meters}}
							<p class="asc-muted">A cap on the sum over all agent steps. The server also applies the policy.</p>
						</section>
					{{end}}
					<section class="asc-card" aria-labelledby="asc-wf-file">
						<h3 id="asc-wf-file" class="asc-card-title">The file</h3>
						<details>
							<summary>Show {{if .Path}}<code>{{.Path}}</code>{{else}}the definition{{end}}</summary>
							<pre class="asc-pre" data-testid="asc-workflow-text">{{$.AscWorkflowText}}</pre>
						</details>
					</section>
				</aside>
			</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
