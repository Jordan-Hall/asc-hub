{{/*
One workflow definition (routers/web/repo/asc_workflows.go).
Template Attributes:
* AscWorkflowDef: ascWorkflowDef, AscWorkflowText: the file as text, AscWorkflowForm: *ascWorkflowTriggerForm
* AscWorkflowRuns: []ascWorkflowRunRow (the latest of this workflow), CanChangeWorkflows
* CsrfTokenHtml
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository rv-agents">
	{{template "repo/header" .}}
	<div class="rv rv-page">
		{{template "base/alert" .}}
		<div class="rv-area">{{template "repo/asc_agents_nav" .}}</div>
		{{template "repo/asc_agents_notice" .}}
		{{with .AscWorkflowDef}}
			<header class="rv-head">
				<div class="rv-head-main">
					<div class="rv-eyebrow"><a href="{{$.AscWorkflowsBase}}">{{ctx.Locale.Tr "asc_review.wf_title"}}</a></div>
					<h1 class="rv-title"><code class="rv-title-code">{{.Name}}</code>
						{{if not .Valid}}<span class="asc-pill asc-tone-bad">{{ctx.Locale.Tr "asc_review.wf_not_valid"}}</span>{{else if .Enabled}}<span class="asc-pill asc-tone-ok">{{ctx.Locale.Tr "asc_review.wf_on"}}</span>{{else}}<span class="asc-pill asc-tone-idle">{{ctx.Locale.Tr "asc_review.wf_off"}}</span>{{end}}
					</h1>
					{{if .Description}}<p class="rv-lead">{{.Description}}</p>{{end}}
					<p class="rv-li-meta">
						{{if .Path}}<span><code>{{.Path}}</code></span>{{end}}
						{{if .Source}}<span>{{ctx.Locale.Tr "asc_review.wf_def_version"}} <code>{{.Source}}</code></span>{{end}}
						<span>{{ctx.Locale.TrN .MaxParallel "asc_review.wf_parallel_one" "asc_review.wf_parallel_other" .MaxParallel}}</span>
					</p>
					<p class="rv-hint">{{ctx.Locale.Tr "asc_review.wf_trunk_tip"}}</p>
				</div>
				{{if and $.CanChangeWorkflows .Valid}}
					<form class="rv-acts" method="post" action="{{.Link}}/enable">
						{{$.CsrfTokenHtml}}
						<a class="rv-btn rv-btn-primary rv-end wf-run-link" href="#rv-wf-run" data-testid="asc-workflow-run-link">{{ctx.Locale.Tr "asc_review.wf_run_now"}}</a>
						<input type="hidden" name="enabled" value="{{if .Enabled}}0{{else}}1{{end}}">
						<button class="rv-btn rv-btn-secondary" type="submit">{{if .Enabled}}{{ctx.Locale.Tr "asc_review.wf_switch_off"}}{{else}}{{ctx.Locale.Tr "asc_review.wf_switch_on"}}{{end}}</button>
					</form>
				{{end}}
			</header>
			{{if .Error}}<div class="rv-banner rv-banner-err" role="alert"><div>{{.Error}}</div></div>{{end}}

			<div class="rv-cols rv-cols-main-side rv-gap">
				<div class="rv-stack">
					<section class="rv-card" aria-labelledby="rv-wf-steps">
						<div class="rv-card-h"><h2 id="rv-wf-steps">{{ctx.Locale.Tr "asc_review.wf_steps"}}</h2></div>
						{{if .Steps}}<ol class="wf-chain" aria-label="{{ctx.Locale.Tr "asc_review.wf_chain"}}" data-testid="asc-workflow-chain">
							{{range .Steps}}<li class="wf-link{{if .HasState}} wf-{{.State.Slug}}{{end}}"><b>{{.ID}}</b><span class="rv-pill rv-pill-outline">{{.Kind}}</span>{{if .HasState}}{{template "repo/asc_state_pill" dict "S" .State "P" "asc_review.step_state_"}}{{end}}</li>{{end}}
						</ol>{{end}}
						<ol class="rv-steps" data-testid="asc-workflow-steps">
							{{range $i, $s := .Steps}}
								<li class="rv-step">
									<span class="rv-step-n" aria-hidden="true">{{Eval $i "+" 1}}</span>
									<div class="rv-step-main">
										<div class="rv-step-top"><code class="rv-step-id">{{.ID}}</code> <span class="rv-pill rv-pill-outline">{{.Kind}}</span>{{if .HasState}} <span data-testid="asc-step-last-state">{{template "repo/asc_state_pill" dict "S" .State "P" "asc_review.step_state_"}}</span>{{end}}</div>
										<div class="rv-li-meta">
											{{if .Needs}}<span>{{ctx.Locale.Tr "asc_review.wf_after"}} {{range $j, $n := .Needs}}{{if $j}}, {{end}}<code>{{$n}}</code>{{end}}</span>{{end}}
											{{if .Agent}}<span>{{ctx.Locale.Tr "asc_review.wf_agent"}} <code>{{.Agent}}</code></span>{{end}}
											{{if .Paths}}<span>{{ctx.Locale.Tr "asc_review.wf_writes"}} {{range $j, $n := .Paths}}{{if $j}}, {{end}}<code>{{$n}}</code>{{end}}</span>{{end}}
											{{if .Approvers}}<span>{{ctx.Locale.Tr "asc_review.wf_approved_by"}} {{range $j, $n := .Approvers}}{{if $j}}, {{end}}{{$n}}{{end}}</span>{{end}}
											{{if .Checks}}<span>{{ctx.Locale.Tr "asc_review.wf_checks"}} {{range $j, $n := .Checks}}{{if $j}}, {{end}}<code>{{$n}}</code>{{end}}</span>{{end}}
											{{if .Timeout}}<span>{{ctx.Locale.Tr "asc_review.wf_times_out" .Timeout}}</span>{{end}}
											{{if .Continue}}<span>{{ctx.Locale.Tr "asc_review.wf_continues"}}</span>{{end}}
										</div>
										{{if .Command}}<div class="rv-li-meta"><span>{{ctx.Locale.Tr "asc_review.wf_runs_command"}} <code>{{range $j, $n := .Command}}{{if $j}} {{end}}{{$n}}{{end}}</code></span></div>{{end}}
										{{if .Secrets}}<div class="rv-li-meta" data-testid="asc-step-secrets">{{range .Secrets}}<span><code>{{.Env}}</code> {{ctx.Locale.Tr "asc_review.wf_from_secret"}} <code>{{.Name}}</code>{{if .Checked}}{{if .Set}} <span class="rv-pill rv-pill-ok">{{ctx.Locale.Tr "asc_review.wf_secret_set"}}</span>{{else}} <span class="rv-pill rv-pill-warn">{{ctx.Locale.Tr "asc_review.wf_secret_missing"}}</span>{{end}}{{end}}</span>{{end}}</div>{{end}}
										{{if .Prompt}}<details class="rv-details"><summary>{{ctx.Locale.Tr "asc_review.wf_prompt"}}</summary><pre class="rv-pre">{{.Prompt}}</pre></details>{{end}}
									</div>
								</li>
							{{else}}
								<li class="rv-card-b rv-muted">{{ctx.Locale.Tr "asc_review.wf_no_steps"}}</li>
							{{end}}
						</ol>
					</section>

					<div class="wf-pair">
					<section class="rv-card" aria-labelledby="rv-wf-triggers">
						<div class="rv-card-h"><h2 id="rv-wf-triggers">{{ctx.Locale.Tr "asc_review.wf_starts_when"}}</h2></div>
						<ul class="rv-card-b rv-plain">
							{{range .Triggers}}
								<li>{{.Label}}
									{{if .Branches}} {{ctx.Locale.Tr "asc_review.wf_on_branches"}} {{range $i, $n := .Branches}}{{if $i}}, {{end}}<code>{{$n}}</code>{{end}}{{end}}
									{{if .Paths}} {{ctx.Locale.Tr "asc_review.wf_touching"}} {{range $i, $n := .Paths}}{{if $i}}, {{end}}<code>{{$n}}</code>{{end}}{{end}}
									{{if .Cron}} (<code>{{.Cron}}</code> UTC){{end}}
									{{if .Agent}} {{ctx.Locale.Tr "asc_review.wf_for"}} <code>@{{.Agent}}</code>{{end}}
								</li>
							{{else}}
								<li class="rv-muted">{{ctx.Locale.Tr "asc_review.wf_by_hand"}}</li>
							{{end}}
						</ul>
					</section>

					{{if $.CanChangeWorkflows}}{{if .Valid}}
						<section class="rv-card" aria-labelledby="rv-wf-run">
							<div class="rv-card-h"><h2 id="rv-wf-run">{{ctx.Locale.Tr "asc_review.wf_run_now"}}</h2></div>
							<form class="rv-card-b rv-form" method="post" action="{{.Link}}/trigger" data-testid="asc-workflow-trigger">
								{{$.CsrfTokenHtml}}
								<input type="hidden" name="op" value="{{$.AscWorkflowForm.OpID}}">
								{{if $.AscWorkflowForm.Summary}}<div class="rv-banner rv-banner-err" role="alert"><div>{{$.AscWorkflowForm.Summary}}</div></div>{{end}}
								{{range .Inputs}}
									<div class="rv-field">
										<label class="rv-label" for="asc-wf-in-{{.Name}}">{{.Name}}{{if .Required}} <span class="rv-opt">{{ctx.Locale.Tr "asc_review.required"}}</span>{{end}}</label>
										<input class="rv-input" id="asc-wf-in-{{.Name}}" name="in_{{.Name}}" type="text" maxlength="4096" value="{{index $.AscWorkflowForm.Values .Name}}" autocomplete="off"{{if .Required}} aria-required="true"{{end}}{{if index $.AscWorkflowForm.Errors .Name}} aria-invalid="true"{{end}}>
										{{if .Description}}<small class="rv-hint">{{.Description}}</small>{{end}}
										{{with index $.AscWorkflowForm.Errors .Name}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
									</div>
								{{end}}
								<div class="rv-field">
									<label class="rv-label" for="asc-wf-change">{{ctx.Locale.Tr "asc_review.wf_change_label"}} <span class="rv-opt">{{ctx.Locale.Tr "asc_review.wf_change_optional"}}</span></label>
									<input class="rv-input" id="asc-wf-change" name="change" type="text" maxlength="32" value="{{$.AscWorkflowForm.Change}}" autocomplete="off" autocapitalize="none" spellcheck="false"{{if index $.AscWorkflowForm.Errors "change"}} aria-invalid="true"{{end}}>
									{{with index $.AscWorkflowForm.Errors "change"}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
								</div>
								<div class="rv-sticky"><button class="rv-btn rv-btn-primary" type="submit">{{ctx.Locale.Tr "asc_review.wf_run_button"}}</button></div>
							</form>
						</section>
					{{end}}{{end}}

					</div>

					<section aria-labelledby="rv-wf-latest">
						<div class="rv-row rv-section-head"><h2 id="rv-wf-latest" class="rv-h3">{{ctx.Locale.Tr "asc_review.wf_latest"}}</h2>{{if $.AscWorkflowRuns}}<a class="rv-end" href="{{$.AscWorkflowsBase}}/runs?workflow={{.Name}}">{{ctx.Locale.Tr "asc_review.wf_all_runs_of" .Name}}</a>{{end}}</div>
						{{if $.AscWorkflowRuns}}
							{{template "repo/asc_workflows_runlist" $.AscWorkflowRuns}}
						{{else}}
							<p class="rv-card rv-card-b rv-muted">{{ctx.Locale.Tr "asc_review.wf_not_run"}}</p>
						{{end}}
					</section>
				</div>
				<aside class="rv-side" aria-label="{{ctx.Locale.Tr "asc_review.wf_side_label"}}">
					{{if .Inputs}}
						<section class="rv-card" aria-labelledby="rv-wf-inputs">
							<div class="rv-card-h"><h2 id="rv-wf-inputs">{{ctx.Locale.Tr "asc_review.wf_inputs"}}</h2></div>
							<ul class="rv-card-b rv-plain">
								{{range .Inputs}}<li><code>{{.Name}}</code>{{if .Required}} {{ctx.Locale.Tr "asc_review.required"}}{{end}}{{if .Default}}, {{ctx.Locale.Tr "asc_review.wf_default"}} <code>{{.Default}}</code>{{end}}{{if .Description}}<br><span class="rv-muted">{{.Description}}</span>{{end}}</li>{{end}}
							</ul>
						</section>
					{{end}}
					{{if .HasAgent}}
						<section class="rv-card" aria-labelledby="rv-wf-budget">
							<div class="rv-card-h"><h2 id="rv-wf-budget">{{ctx.Locale.Tr "asc_review.run_budget"}}</h2></div>
							<div class="rv-card-b">
								<div class="rv-meters">{{template "repo/asc_agents_meters" .Meters}}</div>
								<p class="rv-hint">{{ctx.Locale.Tr "asc_review.wf_budget_help"}}</p>
							</div>
						</section>
					{{end}}
					{{if $.AscWorkflowSecretsShown}}
					<section class="rv-card" aria-labelledby="rv-wf-secrets" data-testid="asc-workflow-secrets">
						<div class="rv-card-h"><h2 id="rv-wf-secrets">{{ctx.Locale.Tr "asc_review.wf_secrets"}}</h2></div>
						<div class="rv-card-b">
							{{if $.AscWorkflowSecrets}}
							<ul class="rv-plain">{{range $.AscWorkflowSecrets}}<li><code>{{.Name}}</code>{{if .Hint}} <span class="rv-muted">&hellip;{{.Hint}}</span>{{end}}<br><span class="rv-muted">{{if .UsedBy}}{{ctx.Locale.Tr "asc_review.wf_secret_used_by"}} {{range $j, $n := .UsedBy}}{{if $j}}, {{end}}<code>{{$n}}</code>{{end}}{{else}}{{ctx.Locale.Tr "asc_review.wf_secret_unused"}}{{end}}</span></li>{{end}}</ul>
							{{else}}<p class="rv-muted">{{ctx.Locale.Tr "asc_review.wf_secrets_none"}}</p>{{end}}
							<p class="rv-hint">{{ctx.Locale.Tr "asc_review.wf_secrets_help"}}</p>
						</div>
					</section>
					{{end}}
					<section class="rv-card" aria-labelledby="rv-wf-file">
						<div class="rv-card-h"><h2 id="rv-wf-file">{{ctx.Locale.Tr "asc_review.wf_file"}}</h2>{{if .Path}}<code class="rv-bare rv-faint">{{.Path}}</code>{{end}}<button class="rv-btn rv-btn-secondary rv-btn-sm rv-end" type="button" data-clipboard-text="{{$.AscWorkflowText}}" data-testid="asc-workflow-copy">{{ctx.Locale.Tr "asc_review.wf_copy"}}</button></div>
						<div class="rv-term rv-term-flush"><div class="rv-term-b" id="asc-workflow-text" tabindex="0" role="region" aria-label="{{if .Path}}{{.Path}}{{else}}{{ctx.Locale.Tr "asc_review.wf_show_def"}}{{end}}" data-testid="asc-workflow-text">{{$.AscWorkflowText}}</div></div>
						{{if and $.CanChangeWorkflows $.AscWorkflowEditURL}}<div class="rv-card-b"><a class="rv-btn rv-btn-secondary" href="{{$.AscWorkflowEditURL}}" data-testid="asc-workflow-edit">{{ctx.Locale.Tr "asc_review.wf_edit_change"}}</a><p class="rv-hint">{{ctx.Locale.Tr "asc_review.wf_edit_help"}}</p></div>{{end}}
					</section>
				</aside>
			</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
