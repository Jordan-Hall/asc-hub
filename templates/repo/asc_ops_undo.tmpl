{{/*
The confirmation of an undo (routers/web/repo/asc_ops.go). The form carries the operation, the ref and the two heads
that were shown (the expected heads); the undo is made only if the log still matches them.
Template Attributes:
* AscUndo: *ascUndoPage (Preview *asctrust.UndoPreview, OpsURL, Problem)
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository rv-trust-page">
	{{template "repo/header" .}}
	<div class="rv rv-page">
		{{template "base/alert" .}}
		{{with .AscUndo}}
		<div class="rv-narrow" data-testid="asc-undo">
			<header class="rv-head">
				<div class="rv-head-main">
					<div class="rv-eyebrow"><a href="{{.OpsURL}}">{{ctx.Locale.Tr "asc_trust.ops.title"}}</a></div>
					<h1 class="rv-title">{{ctx.Locale.Tr "asc_trust.ops.undo_title"}}</h1>
				</div>
			</header>
			{{if .Problem}}
				<div class="rv-banner rv-banner-err" role="alert" data-testid="asc-undo-problem"><div>{{.Problem}}<div class="rv-acts"><a class="rv-btn rv-btn-secondary" href="{{.OpsURL}}">{{ctx.Locale.Tr "asc_review.back_to_log"}}</a></div></div></div>
			{{else if .Preview}}
			{{with .Preview}}
				<p class="rv-lead">{{ctx.Locale.Tr "asc_trust.ops.undo_lead"}}</p>
				<section class="rv-card rv-gap" aria-labelledby="asc-undo-what">
					<div class="rv-card-h">
						<h2 id="asc-undo-what">{{ctx.Locale.Tr "asc_trust.ops.undo_what"}}</h2>
						<span class="rv-pill rv-pill-info rv-end">{{ctx.Locale.Tr (printf "asc_trust.ops.via.%s" .Row.ViaKey)}}</span>
					</div>
					<dl class="rv-card-b rv-dl" data-testid="asc-undo-preview">
						<dt>{{ctx.Locale.Tr "asc_trust.ops.undo_ref"}}</dt>
						<dd><code>{{.Row.Label}}</code></dd>
						<dt>{{ctx.Locale.Tr "asc_trust.ops.undo_now"}}</dt>
						<dd>{{if .Current}}<code>{{.Row.NewShort}}</code>{{else}}{{ctx.Locale.Tr "asc_trust.ops.undo_none"}}{{end}}</dd>
						<dt>{{ctx.Locale.Tr "asc_trust.ops.undo_back"}}</dt>
						<dd>{{if .Restore}}<code>{{.Row.OldShort}}</code>{{else}}{{ctx.Locale.Tr "asc_trust.ops.undo_none"}}{{end}}</dd>
						<dt>{{ctx.Locale.Tr "asc_trust.ops.undo_when"}}</dt>
						<dd>{{DateUtils.TimeSince .Row.At}}</dd>
					</dl>
				</section>
				<form class="rv-form rv-gap" method="post" action="{{$.AscUndo.OpsURL}}/undo" data-testid="asc-undo-form">
					{{$.CsrfTokenHtml}}
					<input type="hidden" name="ref" value="{{.Row.Ref}}">
					<input type="hidden" name="seq" value="{{.Row.Seq}}">
					<input type="hidden" name="current" value="{{.Current}}">
					<input type="hidden" name="restore" value="{{.Restore}}">
					<input type="hidden" name="op" value="{{.Op}}">
					<div class="rv-field">
						<label class="rv-label" for="asc-undo-reason">{{ctx.Locale.Tr "asc_trust.ops.undo_reason"}}</label>
						<input class="rv-input" id="asc-undo-reason" name="reason" type="text" maxlength="256" autocomplete="off">
					</div>
					<p class="rv-hint">{{ctx.Locale.Tr "asc_trust.ops.note"}}</p>
					<div class="rv-sticky">
						<button class="rv-btn rv-btn-primary" type="submit" data-testid="asc-undo-confirm">{{ctx.Locale.Tr "asc_trust.ops.undo_confirm"}}</button>
						<a class="rv-btn rv-btn-secondary" href="{{$.AscUndo.OpsURL}}">{{ctx.Locale.Tr "asc_trust.ops.undo_cancel"}}</a>
					</div>
				</form>
			{{end}}
			{{end}}
		</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
