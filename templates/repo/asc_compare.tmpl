{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="ds-main page-content repository commits asc-repo-page rp-page rp-compare">
	{{template "repo/header" (dict "HdrData" . "SubTitle" (ctx.Locale.Tr "asc_rp.compare") "SubBack" .RepoLink)}}
	<div class="ds-container rp-body" id="asc-compare-container">
		{{template "base/alert" .}}
		<div class="rp-band">
			<div class="rp-band-main">
				<p class="rp-eyebrow">{{ctx.Locale.Tr "asc_rp.compare"}}</p>
				<h2 class="rp-h1">{{ctx.Locale.Tr "asc_rp.compare_title"}}</h2>
				<p class="rp-sub">{{ctx.Locale.Tr "repo.asc_compare"}}</p>
			</div>
		</div>
		<form class="rp-sec rp-cmp-form ds-form" method="get" action="{{.RepoLink}}/asc/compare">
			<div class="rp-cmp-fields">
				<div class="ds-field">
					<label class="ds-label" for="asc-compare-a">{{ctx.Locale.Tr "repo.asc_compare.a"}}</label>
					<select id="asc-compare-a" class="ds-select ds-mono" name="a"{{if .AscCompareError}} aria-invalid="true"{{end}}><option value=""{{if not .AscCompareA}} selected{{end}}>{{ctx.Locale.Tr "asc_rp.cmp_choose"}}</option>{{range $.AscCompareGroups}}<optgroup label="{{ctx.Locale.Tr .Label}}">{{range .Names}}<option value="{{.}}"{{if eq . $.AscCompareA}} selected{{end}}>{{.}}</option>{{end}}</optgroup>{{end}}</select>
				</div>
				<a class="ds-btn ds-btn-secondary ds-btn-icon rp-cmp-swap" href="{{.RepoLink}}/asc/compare?a={{.AscCompareB}}&b={{.AscCompareA}}{{if .AscCompareThreeDot}}&three_dot=1{{end}}" aria-label="{{ctx.Locale.Tr "asc_rp.swap_sides"}}">{{svg "dsi-sort" 18}}</a>
				<div class="ds-field">
					<label class="ds-label" for="asc-compare-b">{{ctx.Locale.Tr "repo.asc_compare.b"}}</label>
					<select id="asc-compare-b" class="ds-select ds-mono" name="b"{{if .AscCompareError}} aria-invalid="true"{{end}}><option value=""{{if not .AscCompareB}} selected{{end}}>{{ctx.Locale.Tr "asc_rp.cmp_choose"}}</option>{{range $.AscCompareGroups}}<optgroup label="{{ctx.Locale.Tr .Label}}">{{range .Names}}<option value="{{.}}"{{if eq . $.AscCompareB}} selected{{end}}>{{.}}</option>{{end}}</optgroup>{{end}}</select>
				</div>
			</div>
			<div class="rp-cmp-go">
				<label class="ds-check">
					<input id="asc-compare-three" name="three_dot" type="checkbox" value="1"{{if .AscCompareThreeDot}} checked{{end}}>
					<span>{{ctx.Locale.Tr "repo.asc_compare.three_dot"}}</span>
				</label>
				<button class="ds-btn ds-btn-primary" type="submit">{{ctx.Locale.Tr "repo.asc_compare.show"}}</button>
			</div>
		</form>
		{{if .AscCompareSame}}
			<div class="ds-banner ds-banner-info" role="status" data-testid="asc-compare-same">{{svg "dsi-info" 16}}<span>{{ctx.Locale.Tr "asc_rp.cmp_same" .AscCompareA}}</span></div>
		{{else if .AscCompareError}}
			<div class="ds-banner ds-banner-err" role="alert" data-testid="asc-compare-error">{{svg "dsi-alert" 16}}<span>{{ctx.Locale.Tr .AscCompareError}}</span></div>
			{{range .AscCompareHints}}
				<p class="rp-cmp-hint" data-testid="asc-compare-hint">{{ctx.Locale.Tr "asc_rp.did_you_mean" .Given}} <a class="ds-mono" href="{{$.RepoLink}}/asc/compare?{{if eq .Side "a"}}a={{.Hint | QueryEscape}}&b={{$.AscCompareB | QueryEscape}}{{else}}a={{$.AscCompareA | QueryEscape}}&b={{.Hint | QueryEscape}}{{end}}{{if $.AscCompareThreeDot}}&three_dot=1{{end}}">{{.Hint}}</a>?</p>
			{{end}}
		{{else}}
			{{with .AscCompare}}
			<p class="rp-cmp-sum" data-testid="asc-compare-summary">
				<span class="ds-chip ds-chip-ok">{{ctx.Locale.Tr "asc_rp.n_ahead" .Ahead}}</span>
				<span class="ds-chip ds-chip-warn">{{ctx.Locale.Tr "asc_rp.n_behind" .Behind}}</span>
				{{if .MergeBase}}<span class="rp-dim">{{ctx.Locale.Tr "asc_rp.common_ancestor"}} <code class="rp-hash">{{.MergeBase}}</code></span>{{end}}
			</p>
			<div class="rp-cmp-cols">
				<section class="rp-sec" aria-labelledby="rp-cmp-ahead">
					<div class="rp-sec-h">
						<h3 class="rp-sec-title" id="rp-cmp-ahead">{{ctx.Locale.Tr "repo.asc_compare.ahead"}}</h3>
						<span class="ds-count">{{.Ahead}}</span>
					</div>
					{{if .AheadList}}
					<ul class="rp-rows">
						{{range .AheadList}}
						<li class="rp-cmp-commit">
							<a class="rp-cmp-subject" href="{{$.RepoLink}}/commit/{{.SHA}}">{{.Subject}}</a>
							<span class="rp-ref-meta"><code class="rp-hash">{{slice .SHA 0 10}}</code><span>{{.Author}}</span>{{if .HasStat}}<span class="rp-delta"><span class="rp-add">+{{.Add}}</span> <span class="rp-del">&minus;{{.Del}}</span></span>{{end}}</span>
						</li>
						{{end}}
						{{if .AheadMore}}<li class="rp-cmp-commit rp-dim">{{ctx.Locale.Tr "repo.asc_compare.more"}}</li>{{end}}
					</ul>
					{{else}}
					<div class="rp-sec-b rp-dim">{{ctx.Locale.Tr "asc_rp.nothing_here"}}</div>
					{{end}}
				</section>
				<section class="rp-sec" aria-labelledby="rp-cmp-behind">
					<div class="rp-sec-h">
						<h3 class="rp-sec-title" id="rp-cmp-behind">{{ctx.Locale.Tr "repo.asc_compare.behind"}}</h3>
						<span class="ds-count">{{.Behind}}</span>
					</div>
					{{if .BehindList}}
					<ul class="rp-rows">
						{{range .BehindList}}
						<li class="rp-cmp-commit">
							<a class="rp-cmp-subject" href="{{$.RepoLink}}/commit/{{.SHA}}">{{.Subject}}</a>
							<span class="rp-ref-meta"><code class="rp-hash">{{slice .SHA 0 10}}</code><span>{{.Author}}</span>{{if .HasStat}}<span class="rp-delta"><span class="rp-add">+{{.Add}}</span> <span class="rp-del">&minus;{{.Del}}</span></span>{{end}}</span>
						</li>
						{{end}}
						{{if .BehindMore}}<li class="rp-cmp-commit rp-dim">{{ctx.Locale.Tr "repo.asc_compare.more"}}</li>{{end}}
					</ul>
					{{else}}
					<div class="rp-sec-b rp-dim">{{ctx.Locale.Tr "asc_rp.nothing_here"}}</div>
					{{end}}
				</section>
			</div>
			<section class="rp-sec rp-cmp-files" aria-labelledby="rp-cmp-files">
				<div class="rp-sec-h">
					<h3 class="rp-sec-title" id="rp-cmp-files">{{ctx.Locale.Tr "repo.asc_compare.files"}}</h3>
					<span class="ds-count">{{len .Files}}</span>
				</div>
				{{if .Files}}
				<ul class="rp-rows">
					{{range .Files}}<li class="rp-cmp-file">{{if eq .Status "A"}}<span class="ds-chip ds-chip-ok">{{ctx.Locale.Tr "asc_rp.st_added"}}</span>{{else if eq .Status "D"}}<span class="ds-chip ds-chip-err">{{ctx.Locale.Tr "asc_rp.st_deleted"}}</span>{{else if eq .Status "R"}}<span class="ds-chip ds-chip-warn">{{ctx.Locale.Tr "asc_rp.st_renamed"}}</span>{{else if eq .Status "M"}}<span class="ds-chip ds-chip-info">{{ctx.Locale.Tr "asc_rp.st_modified"}}</span>{{else}}<span class="ds-chip">{{.Status}}</span>{{end}} <code class="rp-cmp-path">{{.Path}}</code>{{if .HasStat}}{{if .Binary}} <span class="rp-dim">{{ctx.Locale.Tr "asc_rp.binary"}}</span>{{else}} <span class="rp-delta"><span class="rp-add">+{{.Add}}</span> <span class="rp-del">&minus;{{.Del}}</span></span>{{end}}{{end}}</li>{{end}}
				</ul>
				{{else}}
				<div class="rp-sec-b">
					{{template "shared/ds/empty" (dict "Icon" "inbox" "Title" (ctx.Locale.Tr "asc_rp.nothing_to_compare") "Body" (ctx.Locale.Tr "asc_rp.nothing_to_compare_body"))}}
				</div>
				{{end}}
			</section>
			{{end}}
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
