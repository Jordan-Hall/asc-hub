{{/* The path of the directory or file being viewed, as a breadcrumb. */}}
{{$n := len .TreeNames}}
{{$l := Eval $n "-" 1}}
{{if gt $n 0}}
	<nav class="rp-crumbs" aria-label="{{ctx.Locale.Tr "asc_rp.path_label"}}">
		<a href="{{$.BranchLink}}" title="{{.Repository.FullName}}">{{StringUtils.EllipsisString .Repository.FullName 40}}</a>
		{{- range $i, $v := .TreeNames -}}
			<span class="rp-crumb-sep" aria-hidden="true">/</span>
			{{- if eq $i $l -}}
				<b aria-current="page" title="{{$v}}">{{$v}}</b>
				<button type="button" class="rp-crumb-copy" data-clipboard-text="{{$.TreePath}}" aria-label="{{ctx.Locale.Tr "copy_path"}}" title="{{ctx.Locale.Tr "copy_path"}}">{{svg "dsi-copy" 14}}</button>
			{{- else -}}
				{{$p := index $.Paths $i}}<a href="{{$.BranchLink}}/{{PathEscapeSegments $p}}" title="{{$v}}">{{$v}}</a>
			{{- end -}}
		{{- end -}}
	</nav>
{{end}}
