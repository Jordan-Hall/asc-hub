{{/*
The agent tokens of a repository (routers/web/repo/asc_agents_tokens.go). Repository admins only.
Template Attributes:
* AscAgentTokens: []ascAgentTokenRow
* AscAgentTokenMade / AscAgentTokenSecret: only in the answer to the POST that made a token. The secret is shown once.
* AscAgentTokenForm: *ascAgentTokenForm, AscAgentTokenTTLs, AscBudgetFields, AscAgentPolicy
* CsrfTokenHtml
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository rv-agents">
	{{template "repo/header" .}}
	<div class="rv rv-page">
		{{template "base/alert" .}}
		<div class="rv-area">{{template "repo/asc_agents_nav" .}}</div>
		<header class="rv-head">
			<div class="rv-head-main">
				<div class="rv-eyebrow">{{.Repository.FullName}} · {{ctx.Locale.Tr "asc_review.agents_eyebrow"}}</div>
				<h1 class="rv-title">{{ctx.Locale.Tr "asc_review.tokens_title"}}</h1>
				<p class="rv-lead">{{ctx.Locale.Tr "asc_review.tokens_lead"}}</p>
			</div>
			<div class="rv-acts rv-desk"><a class="rv-btn rv-btn-primary" href="#rv-newtoken">{{ctx.Locale.Tr "asc_review.tokens_make"}}</a></div>
		</header>
		{{template "repo/asc_agents_notice" .}}

		{{if .AscAgentTokenSecret}}
			<section class="rv-card rv-secret" aria-labelledby="rv-secret-title" data-testid="asc-agent-secret">
				<div class="rv-card-h"><h2 id="rv-secret-title">{{ctx.Locale.Tr "asc_review.tokens_secret_title"}}</h2></div>
				<div class="rv-card-b rv-stack-s">
					<p>{{ctx.Locale.Tr "asc_review.tokens_secret_help"}}</p>
					<div class="rv-cmd">
						<input id="asc-secret-value" class="rv-secret-value" type="text" readonly value="{{.AscAgentTokenSecret}}" aria-label="{{ctx.Locale.Tr "asc_review.tokens_secret_label" .AscAgentTokenMade.Name}}" autocomplete="off" spellcheck="false" data-asc-select>
						<button class="rv-btn rv-btn-secondary" type="button" data-clipboard-target="#asc-secret-value">{{ctx.Locale.Tr "asc_review.copy"}}</button>
					</div>
					<p class="rv-hint">{{ctx.Locale.Tr "asc_review.tokens_secret_use"}} <code>ASC_TOKEN</code>. {{if not .AscAgentTokenMade.Expires.IsZero}}{{ctx.Locale.Tr "asc_review.tokens_secret_expires" (DateUtils.AbsoluteShort .AscAgentTokenMade.Expires)}}{{else}}{{ctx.Locale.Tr "asc_review.tokens_secret_soon"}}{{end}}</p>
				</div>
			</section>
		{{end}}

		<div class="rv-cols rv-cols-main-side">
			<div class="rv-stack">
				<section aria-labelledby="rv-tokens-title">
					<h2 id="rv-tokens-title" class="rv-h3 rv-section-title">{{ctx.Locale.Tr "asc_review.tokens_list"}}</h2>
					{{if .AscAgentTokens}}
						<ul class="rv-tokens" data-testid="asc-agent-tokens">
							{{range .AscAgentTokens}}
								<li class="rv-card rv-token">
									<div class="rv-token-top">
										<span class="rv-av rv-av-agent" aria-hidden="true">{{.Initials}}</span>
										<div class="rv-grow">
											<div class="rv-run-name">{{.Name}}</div>
											<div class="rv-li-sub"><code>{{.ID}}</code>{{if .Hint}} · {{ctx.Locale.Tr "asc_review.tokens_ends_in"}} <code>{{.Hint}}</code>{{end}}</div>
										</div>
										{{template "repo/asc_state_pill" dict "S" .State "P" "asc_review.token_state_"}}
									</div>
									<dl class="rv-dl rv-token-facts">
										{{if .Agent}}<dt>{{ctx.Locale.Tr "asc_review.new_agent"}}</dt><dd><code>{{.Agent}}</code></dd>{{end}}
										<dt>{{ctx.Locale.Tr "asc_review.tokens_writes"}}</dt><dd>{{range $i, $p := .Paths}}{{if $i}}, {{end}}<code>{{$p}}</code>{{else}}{{ctx.Locale.Tr "asc_review.tokens_default_scope"}}{{end}}</dd>
										{{if .MaxChanges}}<dt>{{ctx.Locale.Tr "asc_review.tokens_per_run"}}</dt><dd>{{ctx.Locale.Tr "asc_review.policy_max_changes" .MaxChanges}}</dd>{{end}}
										{{if .CreatedBy}}<dt>{{ctx.Locale.Tr "asc_review.tokens_made_by"}}</dt><dd>{{.CreatedBy}}</dd>{{end}}
										{{if not .Expires.IsZero}}<dt>{{if .CanRevoke}}{{ctx.Locale.Tr "asc_review.tokens_expires"}}{{else}}{{ctx.Locale.Tr "asc_review.tokens_expired"}}{{end}}</dt><dd>{{DateUtils.AbsoluteShort .Expires}}</dd>{{end}}
										<dt>{{ctx.Locale.Tr "asc_review.tokens_last_used"}}</dt><dd>{{if not .LastUsed.IsZero}}{{DateUtils.TimeSince .LastUsed}}{{else}}{{ctx.Locale.Tr "asc_review.tokens_never_used"}}{{end}}</dd>
										{{if not .Revoked.IsZero}}<dt>{{ctx.Locale.Tr "asc_review.tokens_revoked"}}</dt><dd>{{DateUtils.AbsoluteShort .Revoked}}</dd>{{end}}
									</dl>
									{{if .Meters}}<div class="rv-meters rv-token-meters">{{template "repo/asc_agents_meters" .Meters}}</div>{{end}}
									{{if .CanRevoke}}
										<details class="rv-disclose">
											<summary class="rv-btn rv-btn-secondary">{{ctx.Locale.Tr "asc_review.tokens_manage"}}</summary>
											<div class="rv-disclose-b rv-stack">
												<form class="rv-form" method="post" action="{{$.AscAgentsBase}}/tokens/{{.ID}}/budget">
													{{$.CsrfTokenHtml}}
													<p class="rv-hint">{{ctx.Locale.Tr "asc_review.tokens_budget_help"}}</p>
													<div class="rv-formgrid rv-formgrid-3">
														<div class="rv-field"><label class="rv-label" for="rv-b-ch-{{.ID}}">{{ctx.Locale.Tr "asc_review.new_changes"}}</label><input class="rv-input" id="rv-b-ch-{{.ID}}" name="{{$.AscBudgetFields.Changes}}" type="text" inputmode="numeric" maxlength="6" autocomplete="off"></div>
														<div class="rv-field"><label class="rv-label" for="rv-b-tk-{{.ID}}">{{ctx.Locale.Tr "asc_review.new_tokens"}}</label><input class="rv-input" id="rv-b-tk-{{.ID}}" name="{{$.AscBudgetFields.Tokens}}" type="text" inputmode="numeric" maxlength="15" autocomplete="off"></div>
														<div class="rv-field"><label class="rv-label" for="rv-b-co-{{.ID}}">{{ctx.Locale.Tr "asc_review.new_cost"}}</label><input class="rv-input" id="rv-b-co-{{.ID}}" name="{{$.AscBudgetFields.CostUSD}}" type="text" inputmode="decimal" maxlength="14" autocomplete="off"></div>
													</div>
													<button class="rv-btn rv-btn-secondary" type="submit">{{ctx.Locale.Tr "asc_review.tokens_set_budget"}}</button>
												</form>
												<form class="rv-form" method="post" action="{{$.AscAgentsBase}}/tokens/{{.ID}}/revoke">
													{{$.CsrfTokenHtml}}
													<div class="rv-field"><label class="rv-label" for="rv-rv-{{.ID}}">{{ctx.Locale.Tr "asc_review.tokens_reason"}} <span class="rv-opt">{{ctx.Locale.Tr "asc_review.optional"}}</span></label><input class="rv-input" id="rv-rv-{{.ID}}" name="reason" type="text" maxlength="256" autocomplete="off"></div>
													<button class="rv-btn rv-btn-danger" type="submit">{{ctx.Locale.Tr "asc_review.tokens_revoke"}}</button>
												</form>
											</div>
										</details>
									{{end}}
								</li>
							{{end}}
						</ul>
					{{else if not .AscAgentsFailure}}
						<div class="rv-empty" data-testid="asc-agent-tokens-empty">
							<h3>{{ctx.Locale.Tr "asc_review.tokens_none"}}</h3>
							<p>{{ctx.Locale.Tr "asc_review.tokens_none_help"}}</p>
							<div class="rv-acts"><a class="rv-btn rv-btn-primary" href="#rv-newtoken">{{ctx.Locale.Tr "asc_review.tokens_make"}}</a></div>
						</div>
					{{end}}
				</section>

				<section class="rv-card" id="rv-newtoken" aria-labelledby="rv-newtoken-title">
					<div class="rv-card-h"><h2 id="rv-newtoken-title">{{ctx.Locale.Tr "asc_review.tokens_make"}}</h2></div>
					<form class="rv-card-b rv-form" method="post" action="{{.AscAgentsBase}}/tokens" data-testid="asc-agent-token-form">
						{{.CsrfTokenHtml}}
						<input type="hidden" name="op" value="{{.AscAgentTokenForm.OpID}}">
						{{if .AscAgentTokenForm.Summary}}<div class="rv-banner rv-banner-err" role="alert"><div>{{.AscAgentTokenForm.Summary}}</div></div>{{end}}
						<div class="rv-formgrid rv-formgrid-2">
							<div class="rv-field">
								<label class="rv-label" for="asc-tk-name">{{ctx.Locale.Tr "asc_review.tokens_name"}}</label>
								<input class="rv-input" id="asc-tk-name" name="name" type="text" maxlength="64" required value="{{.AscAgentTokenForm.Name}}" autocomplete="off"{{if index .AscAgentTokenForm.Errors "name"}} aria-invalid="true"{{end}}>
								{{with index .AscAgentTokenForm.Errors "name"}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
							</div>
							<div class="rv-field">
								<label class="rv-label" for="asc-tk-agent">{{ctx.Locale.Tr "asc_review.new_agent"}}</label>
								<input class="rv-input" id="asc-tk-agent" name="agent" type="text" maxlength="40" required value="{{.AscAgentTokenForm.Agent}}" autocomplete="off" autocapitalize="none" spellcheck="false"{{if index .AscAgentTokenForm.Errors "agent"}} aria-invalid="true"{{end}}>
								{{with index .AscAgentTokenForm.Errors "agent"}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
							</div>
						</div>
						<div class="rv-field">
							<label class="rv-label" for="asc-tk-paths">{{ctx.Locale.Tr "asc_review.tokens_paths"}} <span class="rv-opt">{{ctx.Locale.Tr "asc_review.tokens_paths_help"}}</span></label>
							<textarea class="rv-textarea rv-mono" id="asc-tk-paths" name="paths" rows="3" maxlength="4500" spellcheck="false" placeholder="src/**&#10;tests/**"{{if index .AscAgentTokenForm.Errors "paths"}} aria-invalid="true"{{end}}>{{.AscAgentTokenForm.Paths}}</textarea>
							{{with index .AscAgentTokenForm.Errors "paths"}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
						</div>
						<div class="rv-formgrid rv-formgrid-2">
							<div class="rv-field">
								<label class="rv-label" for="asc-tk-ttl">{{ctx.Locale.Tr "asc_review.tokens_lasts"}}</label>
								<select class="rv-select" id="asc-tk-ttl" name="ttl"{{if index .AscAgentTokenForm.Errors "ttl"}} aria-invalid="true"{{end}}>
									{{range .AscAgentTokenTTLs}}<option value="{{.Seconds}}"{{if eq $.AscAgentTokenForm.TTL .Seconds}} selected{{end}}>{{.Label}}</option>{{end}}
								</select>
								{{with index .AscAgentTokenForm.Errors "ttl"}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
							</div>
							<div class="rv-field">
								<label class="rv-label" for="asc-tk-mcpr">{{ctx.Locale.Tr "asc_review.tokens_changes_per_run"}}</label>
								<input class="rv-input" id="asc-tk-mcpr" name="max_changes_per_run" type="text" inputmode="numeric" maxlength="6" value="{{.AscAgentTokenForm.MaxChanges}}" autocomplete="off"{{if index .AscAgentTokenForm.Errors "max_changes_per_run"}} aria-invalid="true"{{end}}>
								{{with index .AscAgentTokenForm.Errors "max_changes_per_run"}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
							</div>
						</div>
						<fieldset class="rv-fieldset rv-fieldset-box">
							<legend>{{ctx.Locale.Tr "asc_review.tokens_budget"}} <span class="rv-opt">{{ctx.Locale.Tr "asc_review.tokens_budget_empty"}}</span></legend>
							<div class="rv-formgrid rv-formgrid-3">
								<div class="rv-field">
									<label class="rv-label" for="asc-tk-changes">{{ctx.Locale.Tr "asc_review.new_changes"}}</label>
									<input class="rv-input" id="asc-tk-changes" name="{{.AscBudgetFields.Changes}}" type="text" inputmode="numeric" maxlength="6" value="{{.AscAgentTokenForm.Budget.Changes}}" autocomplete="off"{{if index .AscAgentTokenForm.Errors .AscBudgetFields.Changes}} aria-invalid="true"{{end}}>
									{{with index .AscAgentTokenForm.Errors .AscBudgetFields.Changes}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
								</div>
								<div class="rv-field">
									<label class="rv-label" for="asc-tk-tokens">{{ctx.Locale.Tr "asc_review.new_tokens"}}</label>
									<input class="rv-input" id="asc-tk-tokens" name="{{.AscBudgetFields.Tokens}}" type="text" inputmode="numeric" maxlength="15" value="{{.AscAgentTokenForm.Budget.Tokens}}" autocomplete="off"{{if index .AscAgentTokenForm.Errors .AscBudgetFields.Tokens}} aria-invalid="true"{{end}}>
									{{with index .AscAgentTokenForm.Errors .AscBudgetFields.Tokens}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
								</div>
								<div class="rv-field">
									<label class="rv-label" for="asc-tk-cost">{{ctx.Locale.Tr "asc_review.new_cost"}}</label>
									<input class="rv-input" id="asc-tk-cost" name="{{.AscBudgetFields.CostUSD}}" type="text" inputmode="decimal" maxlength="14" value="{{.AscAgentTokenForm.Budget.CostUSD}}" placeholder="2.50" autocomplete="off"{{if index .AscAgentTokenForm.Errors .AscBudgetFields.CostUSD}} aria-invalid="true"{{end}}>
									{{with index .AscAgentTokenForm.Errors .AscBudgetFields.CostUSD}}<div class="rv-error" role="alert">{{.}}</div>{{end}}
								</div>
							</div>
						</fieldset>
						<div class="rv-sticky"><button class="rv-btn rv-btn-primary" type="submit">{{ctx.Locale.Tr "asc_review.tokens_submit"}}</button></div>
					</form>
				</section>
			</div>
			<div class="rv-side">
				{{template "repo/asc_agents_policy" .}}
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
