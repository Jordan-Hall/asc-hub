{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="ds-main page-content repository branches rp-page">
	{{template "repo/header" (dict "HdrData" . "SubTitle" (ctx.Locale.Tr "repo.branches") "SubBack" .RepoLink)}}
	<div class="ds-container rp-body">
		{{template "base/alert" .}}
		<div class="rp-band">
			<div class="rp-band-main">
				<p class="rp-eyebrow">{{ctx.Locale.Tr "asc_rp.refs"}}</p>
				<h2 class="rp-h1">{{ctx.Locale.Tr "repo.branches"}}</h2>
				<p class="rp-sub">{{ctx.Locale.Tr "asc_rp.refs_sub"}}</p>
			</div>
			<div class="rp-band-acts">
				{{if .DefaultBranchBranch}}<a class="ds-btn ds-btn-secondary" href="{{.RepoLink}}/compare/{{PathEscapeSegments .DefaultBranchBranch.DBBranch.Name}}">{{ctx.Locale.Tr "asc_rp.compare_versions"}}</a>{{end}}
			</div>
		</div>
		<form class="rp-filters ignore-dirty" method="get" role="search">
			<div class="ds-inwrap rp-search">
				{{svg "dsi-search" 16}}
				<label class="ds-sr" for="rp-ref-q">{{ctx.Locale.Tr "search.branch_kind"}}</label>
				<input id="rp-ref-q" class="ds-input" type="search" name="q" value="{{.Keyword}}" maxlength="255" spellcheck="false" enterkeyhint="search" placeholder="{{ctx.Locale.Tr "search.branch_kind"}}">
			</div>
			<div class="rp-pills" role="group" aria-label="{{ctx.Locale.Tr "asc_rp.ref_kinds"}}">
				<a class="ds-chip-btn" href="{{.RepoLink}}/branches" aria-current="true">{{ctx.Locale.Tr "repo.branches"}} <span class="ds-count">{{.BranchesCount}}</span></a>
				{{if .Permission.CanRead $.UnitTypeCode}}<a class="ds-chip-btn" href="{{.RepoLink}}/tags">{{ctx.Locale.Tr "repo.release.tags"}} <span class="ds-count">{{.NumTags}}</span></a>{{end}}
			</div>
		</form>
		{{if .DefaultBranchBranch}}
			<section class="rp-sec rp-refcard" aria-labelledby="rp-default-branch">
				<div class="rp-sec-h">
					<div>
						<h3 class="rp-sec-title" id="rp-default-branch">{{ctx.Locale.Tr "repo.default_branch"}}</h3>
						<p class="rp-sec-sub">{{ctx.Locale.Tr "asc_rp.default_sub"}}</p>
					</div>
				</div>
				<ul class="rp-reflist">
					{{template "repo/branch/row" (dict "root" . "b" .DefaultBranchBranch "default" true)}}
				</ul>
			</section>
		{{end}}
		<section class="rp-sec rp-refcard" aria-labelledby="rp-branches">
			<div class="rp-sec-h">
				<div>
					<h3 class="rp-sec-title" id="rp-branches">{{ctx.Locale.Tr "repo.branches"}}</h3>
					<p class="rp-sec-sub">{{ctx.Locale.Tr "asc_rp.branches_sub"}}</p>
				</div>
				<span class="ds-count">{{.BranchesCount}}</span>
			</div>
			{{if .Branches}}
				<ul class="rp-reflist">
					{{range .Branches}}
						{{template "repo/branch/row" (dict "root" $ "b" . "default" false)}}
					{{end}}
				</ul>
			{{else}}
				<div class="rp-sec-b">
					{{if and .Keyword (eq .Repository.GetStorageBackend "asc")}}{{template "shared/ds/empty" (dict "Icon" "search" "Title" (ctx.Locale.Tr "asc_rp.no_ref_title") "Body" (ctx.Locale.Tr "asc_rp.no_ref_body") "PrimaryLabel" (ctx.Locale.Tr "asc_rp.search_stacks") "PrimaryHref" (printf "%s/pulls?q=%s" .RepoLink (QueryEscape .Keyword)))}}{{else}}{{template "shared/ds/empty" (dict "Icon" "search" "Title" (ctx.Locale.Tr "asc_rp.no_ref_title") "Body" (ctx.Locale.Tr "asc_rp.no_ref_body"))}}{{end}}
				</div>
			{{end}}
		</section>
		{{template "base/paginate" .}}
	</div>
</div>

<div class="ui g-modal-confirm delete modal" id="delete-branch">
	<div class="header">
		{{svg "octicon-trash"}}
		{{ctx.Locale.Tr "repo.branch.delete_html"}} <span class="name"></span>
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "repo.branch.delete_desc"}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>

<dialog id="create-branch-modal">
	<article>
		<header>{{ctx.Locale.Tr "repo.branch.new_branch"}}</header>
		<form class="ds-form" id="create-branch-form" action="" data-base-action="{{.Link}}/_new/branch/" method="post">
			{{.CsrfTokenHtml}}
			<div class="content">
				<div class="ds-field">
					{{ctx.Locale.Tr "repo.branch.create_new_branch"}}
					<span id="modal-create-branch-from-span"></span>
				</div>
				<div class="ds-field">
					<label class="ds-label" for="new_branch_name">{{ctx.Locale.Tr "repo.branch.name"}}</label>
					<input id="new_branch_name" class="ds-input" name="new_branch_name" required autocomplete="off">
				</div>
			</div>
			{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm")}}
		</form>
	</article>
</dialog>

<dialog id="rename-branch-modal">
	<article>
		<header>{{ctx.Locale.Tr "repo.settings.rename_branch"}}</header>
		<div class="content default-branch-warning">
			<div class="ds-banner ds-banner-warn" role="status">{{ctx.Locale.Tr "repo.branch.warning_rename_default_branch"}}</div>
		</div>
		<form class="ds-form" action="{{$.Repository.Link}}/settings/rename_branch" method="post">
			{{.CsrfTokenHtml}}
			<div class="content">
				<input name="from" type="hidden" required>
				<div class="ds-field">
					<span class="label-branch-from" data-locale="{{ctx.Locale.Tr "repo.branch.rename_branch_to"}}"></span>
				</div>
				<div class="ds-field">
					<label class="ds-label" for="to_branch_name">{{ctx.Locale.Tr "repo.branch.name"}}</label>
					<input id="to_branch_name" class="ds-input" name="to" required autocomplete="off">
				</div>
			</div>
			{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm")}}
		</form>
	</article>
</dialog>
{{template "base/footer" .}}
