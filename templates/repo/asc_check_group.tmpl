{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository asc-trust-page">
	{{template "repo/header" .}}
	<div class="ui container">
	{{with .AscCheckGroup}}
	<div class="asc-trust" data-testid="asc-check-group">
		<p class="asc-trust-links"><a href="{{.ChecksURL}}">Checks</a></p>
		{{if .Unsupported}}
			<div class="ui warning message" role="status">This ASC server does not group CI failures yet.</div>
		{{else if .Problem}}
			<div class="ui negative message" role="alert" data-testid="asc-group-problem">{{.Problem}}</div>
		{{else if .Detail}}
			<div class="asc-trust-head">
				<h2 class="asc-trust-title">{{if .Detail.Group.Title}}{{.Detail.Group.Title}}{{else}}{{.Detail.Group.TestName}}{{end}}</h2>
				<span class="ast-pill ast-pill-{{.Detail.Group.Tone}}" data-testid="asc-group-state">{{.Detail.Group.State}}</span>
				{{if .Detail.Group.Flaky}}<span class="ast-pill ast-pill-wn">Flaky</span>{{end}}
			</div>
			<p class="asc-trust-sub">
				{{if .Detail.Group.TestName}}<code class="asc-trust-code">{{.Detail.Group.TestName}}</code> {{end}}{{if .Detail.Group.JobName}}in {{.Detail.Group.JobName}} · {{end}}
				seen {{.Detail.Group.Occurrences}} times in {{.Detail.Group.ChangesAffected}} changes · first {{DateUtils.TimeSince .Detail.Group.FirstSeen}} · last {{DateUtils.TimeSince .Detail.Group.LastSeen}}
			</p>
			{{if .Detail.Group.Note}}<p class="asc-trust-sub">Note: {{.Detail.Group.Note}}</p>{{end}}

			{{if .History}}
			<section class="ast-card" aria-labelledby="asc-group-history">
				<div class="ast-card-head">
					<h3 id="asc-group-history" class="ast-card-title">History</h3>
					<form class="ast-inline-form" method="get" action="{{.GroupURL}}">
						<label class="tw-sr-only" for="asc-group-window">Window</label>
						<select id="asc-group-window" name="window" data-testid="asc-group-window">
							<option value="7"{{if eq .Window 7}} selected{{end}}>7 days</option>
							<option value="14"{{if eq .Window 14}} selected{{end}}>14 days</option>
							<option value="30"{{if eq .Window 30}} selected{{end}}>30 days</option>
							<option value="90"{{if eq .Window 90}} selected{{end}}>90 days</option>
							<option value="180"{{if eq .Window 180}} selected{{end}}>180 days</option>
						</select>
						<button class="ui basic button" type="submit">Show</button>
					</form>
				</div>
				{{template "repo/asc_strip" .History}}
			</section>
			{{end}}

			{{if .CanWrite}}
			<section class="ast-card" aria-labelledby="asc-group-actions">
				<div class="ast-card-head"><h3 id="asc-group-actions" class="ast-card-title">What to do with it</h3></div>
				<form class="ui form" method="post" action="{{.GroupURL}}/state" data-testid="asc-group-form">
					{{$.CsrfTokenHtml}}
					<input type="hidden" name="op" value="{{.Op}}">
					<div class="field">
						<label for="asc-group-note">Note (optional)</label>
						<input id="asc-group-note" name="note" type="text" maxlength="1024" autocomplete="off">
					</div>
					<div class="asc-trust-actions">
						{{if ne .Detail.Group.StateKey "acknowledged"}}<button class="ui basic button" type="submit" name="state" value="acknowledged">Acknowledge</button>{{end}}
						{{if ne .Detail.Group.StateKey "quarantined"}}<button class="ui basic button" type="submit" name="state" value="quarantined" data-testid="asc-group-quarantine">Quarantine this test</button>{{end}}
						{{if ne .Detail.Group.StateKey "resolved"}}<button class="ui basic button" type="submit" name="state" value="resolved">Mark resolved</button>{{end}}
						{{if ne .Detail.Group.StateKey "open"}}<button class="ui basic button" type="submit" name="state" value="open">Reopen</button>{{end}}
						<a class="ui basic button" href="{{$.RepoLink}}/issues/new?{{.IssueQuery}}">Open an issue</a>
					</div>
					<p class="asc-trust-sub">A quarantined test does not block landing. Quarantine needs a maintainer, and a policy that allows it (<code class="asc-trust-code">[ci] allow_quarantine</code>).</p>
				</form>
			</section>
			{{end}}

			<section class="ast-card" aria-labelledby="asc-group-where">
				<div class="ast-card-head"><h3 id="asc-group-where" class="ast-card-title">Where it happened</h3></div>
				<ul class="ast-occurrences" data-testid="asc-occurrences">
					{{range .Occurrences}}
					<li>
						<div class="asc-trust-sub">
							{{DateUtils.TimeSince .At}}{{if .Change}} · change <code class="asc-trust-code">{{.Change}}</code>{{if .Version}} v{{.Version}}{{end}}{{end}}{{if .Head}} · <code class="asc-trust-code">{{.Head}}</code>{{end}}{{if gt .Attempt 1}} · attempt {{.Attempt}}{{end}}
						</div>
						{{if .Message}}<pre class="ast-log" tabindex="0">{{.Message}}</pre>{{end}}
						<div class="asc-trust-actions">
							{{if .RunURL}}<a class="ui basic button" href="{{.RunURL}}">Show the run</a>{{end}}
							{{if and $.AscCheckGroup.CanRerun .RunID}}
							<form class="ast-inline-form" method="post" action="{{$.AscCheckGroup.ChecksURL}}/rerun">
								{{$.CsrfTokenHtml}}
								<input type="hidden" name="run" value="{{.RunID}}">
								<button class="ui basic button" type="submit" name="mode" value="failed">Re-run failed only</button>
								<button class="ui basic button" type="submit" name="mode" value="all">Re-run all</button>
							</form>
							{{end}}
						</div>
					</li>
					{{else}}
					<li class="text grey">No occurrences are kept for this group.</li>
					{{end}}
				</ul>
				{{if .NextURL}}<div class="asc-trust-actions"><a class="ui basic button" href="{{.NextURL}}" rel="next">Older occurrences</a></div>{{end}}
			</section>
		{{end}}
	</div>
	{{end}}
	</div>
</div>
{{template "base/footer" .}}
