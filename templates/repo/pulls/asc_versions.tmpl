{{/*
Versions panel of a stacked pull request (SPEC 20.5 flow 2, PLAN C37; design board Review versions).
Template Attributes:
* AscVersions: *pull.AscVersionList (nil or empty: nothing is shown)
* AscVersionFrom, AscVersionTo: uint32, the versions being shown (both 0: the ordinary diff; only To: that version)
* AscHeadVersion: uint32, the version the head of the pull request is at (0: the newest, or none)
* AscCanRestore: bool, the viewer may restore a version of this open pull request
* CsrfTokenHtml: the CSRF field of the restore form
* AscSignatures: map[uint32]asctrust.Badge, the Verified badge of each version that has one (nil: none is shown)
* AscVersionDetails: map[uint32]pull.AscVersionDetail (the commit message, short hash, +add/-del and the restack mark of each version; nil: none)
* AscVersionChecks: map[uint32][]AscVersionCheck (the check chips of each version; nil: none)
* AscBrief: the brief of the pull request, for the "Approved by" marker (nil: none)
* AscSinceVersion: uint32, the version of the viewer's last review (0 when there is none or it is the latest)
* Issue.Link: the pull request link
Numbers are inserted as they are; the actor name comes from asc and is escaped by the template engine. The base and head
pickers are plain radio buttons of a GET form, so the panel works without a script.
*/}}
{{if and .AscVersions .AscVersions.Versions}}
{{$latest := .AscVersions.Latest}}
{{$current := $latest}}
{{$head := $latest}}
{{if .AscHeadVersion}}{{$head = .AscHeadVersion}}{{$current = .AscHeadVersion}}{{end}}
{{if .AscVersionTo}}{{$current = .AscVersionTo}}{{end}}
<section class="rv rv-vers" data-testid="asc-versions" aria-label="{{ctx.Locale.Tr "asc_review.rev_versions"}}">
	<div class="rv-vers-bar">
		<details class="rv-menu rv-vers-pick">
			<summary class="rv-btn rv-btn-secondary rv-vers-sum">
				<span>{{ctx.Locale.Tr "repo.pulls.asc_versions.of" $current (len .AscVersions.Versions)}}</span>
				{{if $.AscSignatures}}{{template "repo/pulls/asc_signature_badge" (index $.AscSignatures $current)}}{{end}}
				{{svg "octicon-chevron-down" 14 "rv-caret"}}
			</summary>
			<div class="rv-menu-panel rv-vers-panel">
				<form method="get" action="{{.Issue.Link}}/files" class="rv-vers-form">
					<div class="rv-card-h"><h2 class="rv-h4">{{ctx.Locale.Tr "asc_review.rev_versions"}}</h2><span class="rv-faint">{{ctx.Locale.Tr "asc_review.rev_versions_help"}}</span></div>
					<ol class="rv-vlist">
						{{range .AscVersions.Newest}}
						<li class="rv-vrow{{if eq .N $current}} is-current{{end}}">
							<span class="rv-vnum">v{{.N}}</span>
							<div class="rv-vmain">
								<div class="rv-vtitle">
									<a href="{{$.Issue.Link}}/files?asc_to={{.N}}">{{ctx.Locale.Tr "repo.pulls.asc_versions.version" .N}}</a>
									{{if eq .N $head}}<span class="rv-pill rv-pill-info">{{ctx.Locale.Tr "asc_review.rev_current"}}</span>{{end}}
									{{if $.AscSignatures}}{{template "repo/pulls/asc_signature_badge" (index $.AscSignatures .N)}}{{end}}
								</div>
								<div class="rv-li-sub">{{.Actor}} · {{DateUtils.TimeSince .At}}</div>
								{{with index $.AscVersionDetails .N}}
								<div class="rv-li-sub" data-testid="asc-version-detail">
									{{if .Restack}}<span class="rv-pill rv-pill-outline">{{ctx.Locale.Tr "asc_review.rev_restack_row"}}</span> {{end}}{{if .Subject}}<span>{{.Subject}}</span> {{end}}<code>{{.Short}}</code> <span class="rv-nowrap"><span class="rv-add">+{{.Add}}</span> <span class="rv-del">&minus;{{.Del}}</span></span>
								</div>
								{{end}}
								{{$ver := .N}}
								{{with index $.AscVersionChecks .N}}
								<div class="rv-chips" data-testid="asc-version-checks">{{range .}}<span class="rv-pill rv-pill-{{if eq .Tone "ok"}}ok{{else if eq .Tone "err"}}err{{else}}warn{{end}}">{{.Name}}</span>{{end}}</div>
								{{end}}
								{{if $.AscBrief}}{{range $.AscBrief.Approvals}}{{if and (eq .Version $ver) (not .ChangesRequested)}}
								<div class="rv-li-sub" data-testid="asc-version-approved">{{ctx.Locale.Tr "asc_review.rev_approved_by" .Reviewer}}</div>
								{{end}}{{end}}{{end}}
							</div>
							<fieldset class="rv-fieldset rv-vpick">
								<legend class="rv-sr">{{ctx.Locale.Tr "repo.pulls.asc_versions.version" .N}}</legend>
								<label class="rv-check rv-check-inline"><input type="radio" name="asc_from" value="{{.N}}"{{if eq $.AscVersionFrom .N}} checked{{end}}> {{ctx.Locale.Tr "asc_review.rev_base"}}</label>
								<label class="rv-check rv-check-inline"><input type="radio" name="asc_to" value="{{.N}}"{{if eq $current .N}} checked{{end}}> {{ctx.Locale.Tr "asc_review.rev_head"}}</label>
							</fieldset>
							{{if and $.AscCanRestore (ne .N $head)}}
							<button class="rv-btn rv-btn-secondary rv-btn-sm" type="submit" form="asc-restore-{{.N}}">{{ctx.Locale.Tr "repo.pulls.asc_versions.restore_version" .N}}</button>
							{{end}}
						</li>
						{{end}}
					</ol>
					<div class="rv-card-f rv-acts">
						<button class="rv-btn rv-btn-primary" type="submit" data-testid="asc-versions-compare">{{ctx.Locale.Tr "asc_review.rev_compare"}}</button>
						<a class="rv-btn rv-btn-secondary" href="{{.Issue.Link}}/files">{{ctx.Locale.Tr "repo.pulls.asc_versions.latest"}}</a>
					</div>
				</form>
				{{if .AscCanRestore}}
				<div data-testid="asc-restore-version">
					{{range .AscVersions.Versions}}{{if ne .N $head}}
					<form id="asc-restore-{{.N}}" method="post" action="{{$.Issue.Link}}/asc/restore_version">
						{{$.CsrfTokenHtml}}
						<input type="hidden" name="version" value="{{.N}}">
					</form>
					{{end}}{{end}}
				</div>
				{{end}}
			</div>
		</details>
		{{if gt (len .AscVersions.Versions) 1}}
		<nav class="rv-chips rv-vers-steps" aria-label="{{ctx.Locale.Tr "repo.pulls.asc_versions.interdiff"}}">
			{{range .AscVersions.Steps}}
				<a class="rv-chip-btn" href="{{$.Issue.Link}}/files?asc_from={{.From}}&asc_to={{.To}}"{{if and (eq $.AscVersionTo .To) (eq $.AscVersionFrom .From)}} aria-current="page"{{end}}>{{ctx.Locale.Tr "repo.pulls.asc_versions.interdiff_step" .From .To}}</a>
			{{end}}
		</nav>
		{{end}}
		<div class="rv-vers-links">
			{{if .AscSinceVersion}}<a class="rv-btn rv-btn-secondary" href="{{.Issue.Link}}/files?asc_from={{.AscSinceVersion}}&asc_to={{.AscVersions.Latest}}" data-testid="asc-since-last-review">{{ctx.Locale.Tr "repo.pulls.asc_versions.since_review" .AscSinceVersion}}</a>{{end}}
			<a class="rv-btn rv-btn-secondary" href="{{.Issue.Link}}/asc/checks" data-testid="asc-checks-link">{{ctx.Locale.Tr "asc_review.rev_checks"}}</a>
		</div>
	</div>
</section>
{{end}}
