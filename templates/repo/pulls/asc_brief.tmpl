{{/*
The brief of a stacked change (board Review): what it does, why, how to check it, what could go wrong and where to look
first, with the size and risk class asc computed and "how it was made" when an agent run made the change.
Template Attributes:
* AscBrief: *repo.AscBrief (nil: nothing is shown)
Every text comes from the cleaned answer of asc and is escaped by the Go template; the links are made by the hub.
*/}}
{{with .AscBrief}}
<section class="rv-card rv-brief" id="asc-how-made" aria-labelledby="asc-brief-title" data-testid="asc-brief">
	<div class="rv-card-h">
		<h2 id="asc-brief-title">{{ctx.Locale.Tr "asc_review.brief_title"}}</h2>
		<div class="rv-row rv-row-wrap">
			{{if .RiskLevel}}<span class="ds-chip {{if eq .RiskLevel "high"}}ds-chip-err{{else if eq .RiskLevel "medium"}}ds-chip-warn{{else}}ds-chip-ok{{end}}">{{ctx.Locale.Tr (printf "asc_review.risk_%s" .RiskLevel)}}</span>{{end}}
			<span class="rp-delta" title="{{ctx.Locale.Tr "asc_review.brief_size_title"}}"><span class="rp-add">+{{.Added}}</span> <span class="rp-del">&minus;{{.Removed}}</span> <span class="rp-dim">{{ctx.Locale.TrN .Files "asc_review.brief_files_one" "asc_review.brief_files_other" .Files}}{{if .StatsTruncated}}+{{end}}</span></span>
		</div>
	</div>
	<div class="rv-card-b rv-brief-b">
		{{if .Written}}
			<dl class="rv-brief-dl">
				{{if .What}}<div><dt>{{ctx.Locale.Tr "asc_review.brief_what"}}</dt><dd>{{.What}}</dd></div>{{end}}
				{{if .Why}}<div><dt>{{ctx.Locale.Tr "asc_review.brief_why"}}</dt><dd>{{.Why}}</dd></div>{{end}}
				{{if .How}}<div><dt>{{ctx.Locale.Tr "asc_review.brief_how"}}</dt><dd>{{.How}}</dd></div>{{end}}
				{{if .RiskNote}}<div><dt>{{ctx.Locale.Tr "asc_review.brief_risk_note"}}</dt><dd>{{.RiskNote}}</dd></div>{{end}}
			</dl>
			{{if .Where}}
			<h3 class="rv-brief-h">{{ctx.Locale.Tr "asc_review.brief_where"}}</h3>
			<ul class="rv-brief-where">
				{{range .Where}}<li>{{if .Link}}<a class="rv-mono" href="{{.Link}}">{{.Path}}{{if .Line}}:{{.Line}}{{end}}</a>{{else}}<code>{{.Path}}{{if .Line}}:{{.Line}}{{end}}</code>{{end}}{{if .Note}} <span>{{.Note}}</span>{{end}}</li>{{end}}
			</ul>
			{{end}}
		{{else}}
			<p class="rp-quiet" data-testid="asc-brief-empty">{{ctx.Locale.Tr "asc_review.brief_empty"}}</p>
		{{end}}
		{{if $.AscBriefCanEdit}}
		<details class="rv-brief-edit" data-testid="asc-brief-edit">
			<summary class="ds-btn ds-btn-secondary ds-btn-sm">{{if .Written}}{{ctx.Locale.Tr "asc_review.brief_edit"}}{{else}}{{ctx.Locale.Tr "asc_review.brief_write"}}{{end}}</summary>
			<form class="ds-form ds-stack-12" action="{{$.Issue.Link}}/asc/brief" method="post">
				{{$.CsrfTokenHtml}}
				<div class="ds-field"><label class="ds-label" for="asc-brief-what">{{ctx.Locale.Tr "asc_review.brief_what"}}</label><textarea id="asc-brief-what" class="ds-textarea" name="what" rows="3" maxlength="8192">{{.What}}</textarea></div>
				<div class="ds-field"><label class="ds-label" for="asc-brief-why">{{ctx.Locale.Tr "asc_review.brief_why"}}</label><textarea id="asc-brief-why" class="ds-textarea" name="why" rows="3" maxlength="8192">{{.Why}}</textarea></div>
				<div class="ds-field"><label class="ds-label" for="asc-brief-how">{{ctx.Locale.Tr "asc_review.brief_how"}}</label><textarea id="asc-brief-how" class="ds-textarea" name="how" rows="3" maxlength="8192">{{.How}}</textarea></div>
				<div class="ds-field"><label class="ds-label" for="asc-brief-risk">{{ctx.Locale.Tr "asc_review.brief_risk_note"}}</label><textarea id="asc-brief-risk" class="ds-textarea" name="risk_note" rows="2" maxlength="8192">{{.RiskNote}}</textarea></div>
				<div class="ds-field"><label class="ds-label" for="asc-brief-where">{{ctx.Locale.Tr "asc_review.brief_where"}}</label><textarea id="asc-brief-where" class="ds-textarea ds-mono" name="where" rows="3" spellcheck="false" aria-describedby="asc-brief-where-hint">{{range .Where}}{{.Path}}{{if .Line}}:{{.Line}}{{end}}{{if .Note}} {{.Note}}{{end}}
{{end}}</textarea><span class="ds-hint" id="asc-brief-where-hint">{{ctx.Locale.Tr "asc_review.brief_where_hint"}}</span></div>
				<div><button type="submit" class="ds-btn ds-btn-primary ds-btn-sm">{{ctx.Locale.Tr "asc_review.brief_save"}}</button></div>
			</form>
		</details>
		{{end}}
		{{if .RiskReasons}}
		<h3 class="rv-brief-h">{{ctx.Locale.Tr "asc_review.brief_why_risk"}}</h3>
		<ul class="rv-brief-where">{{range .RiskReasons}}<li>{{.}}</li>{{end}}</ul>
		{{end}}
		{{with .Provenance}}
		<h3 class="rv-brief-h">{{ctx.Locale.Tr "asc_review.how_made"}}</h3>
		<p class="rv-brief-made" data-testid="asc-brief-made">
			<a href="{{.RunLink}}">{{ctx.Locale.Tr "asc_review.how_made_run" .RunID}}</a>
			{{if .Agent}}<span class="ds-chip ds-chip-agent">{{.Agent}}</span>{{end}}
			{{if .Title}}<span>{{.Title}}</span>{{end}}
			<span class="rp-dim">{{ctx.Locale.Tr "asc_review.how_made_counts" .ToolCalls .FilesRead .Versions}}{{if .Minutes}} · {{ctx.Locale.Tr "asc_review.how_made_minutes" .Minutes}}{{end}}</span>
		</p>
		{{end}}
		{{if .Approvals}}
		<h3 class="rv-brief-h">{{ctx.Locale.Tr "asc_review.approvals_title"}}</h3>
		<ul class="rv-brief-where" data-testid="asc-approvals">
			{{range .Approvals}}<li>{{if .ChangesRequested}}<span class="ds-chip ds-chip-err">{{ctx.Locale.Tr "asc_review.approvals_requested"}}</span>{{else}}<span class="ds-chip ds-chip-ok">{{ctx.Locale.Tr "asc_review.approvals_approved"}}</span>{{end}} <b>{{.Reviewer}}</b> <span class="rp-dim">{{ctx.Locale.Tr "asc_review.approvals_on_version" .Version}}{{if .Carried}} · {{ctx.Locale.Tr "asc_review.approvals_carried" .UnchangedFiles}}{{else if not .Applies}} · {{ctx.Locale.Tr "asc_review.approvals_stale"}}{{end}}</span></li>{{end}}
		</ul>
		{{end}}
		<p class="rv-brief-gate rp-dim" data-testid="asc-brief-gate">
			{{ctx.Locale.Tr "asc_review.gate_line" .OpenThreads .TotalThreads .ApprovalsCurrent .ChangesRequested}}
			{{if .ApprovalsCarried}} · {{ctx.Locale.Tr "asc_review.gate_carried" .ApprovalsCarried}}{{end}}
		</p>
	</div>
</section>
{{end}}
{{with .AscThreads}}
<section class="rv-card rv-threads" aria-labelledby="asc-threads-title" data-testid="asc-threads">
	<div class="rv-card-h"><h2 id="asc-threads-title">{{ctx.Locale.Tr "asc_review.threads_title"}}</h2><span class="rp-dim">{{ctx.Locale.Tr "asc_review.threads_lead"}}</span></div>
	<div class="rv-card-b ds-stack-12">
		{{range .}}
		<article class="rv-thread" data-resolved="{{.Resolved}}">
			<header class="rv-row rv-row-wrap">
				{{if .Path}}<code class="rv-mono">{{.Path}}{{if .Lines}}:{{.Lines}}{{end}}</code>{{else}}<span>{{ctx.Locale.Tr "asc_review.threads_whole"}}</span>{{end}}
				{{if .Version}}<span class="ds-chip ds-chip-outline">v{{.Version}}</span>{{end}}
				<span class="ds-chip {{if .Resolved}}ds-chip-ok{{else}}ds-chip-warn{{end}}">{{if .Resolved}}{{ctx.Locale.Tr "asc_review.threads_resolved"}}{{else}}{{ctx.Locale.Tr "asc_review.threads_open"}}{{end}}</span>
			</header>
			{{range .Comments}}
			<div class="rv-thread-c">
				<b>{{.Author}}</b>
				<p>{{.Body}}</p>
				{{if .Suggestion}}<pre class="ds-code" data-testid="asc-thread-suggestion"><code>{{.Suggestion}}</code></pre>{{if .Applied}}<span class="ds-chip ds-chip-ok">{{ctx.Locale.Tr "asc_review.threads_applied" .Applied}}</span>{{end}}{{end}}
			</div>
			{{end}}
		</article>
		{{end}}
	</div>
</section>
{{end}}
{{with .AscGate}}
<section class="rv-card rv-gate" aria-labelledby="asc-gate-title" data-testid="asc-gate">
	<div class="rv-card-h">
		<h2 id="asc-gate-title">{{ctx.Locale.Tr "asc_review.gate_title"}}</h2>
		{{if $.AscGateToClear}}<span class="ds-chip ds-chip-warn">{{ctx.Locale.Tr "asc_review.gate_to_clear" $.AscGateToClear}}</span>{{else}}<span class="ds-chip ds-chip-ok">{{ctx.Locale.Tr "asc_review.gate_clear"}}</span>{{end}}
	</div>
	<div class="rv-card-b">
	<ul class="rv-gate-list">
		{{range .}}
		<li class="rv-gate-rule{{if .Held}} is-held{{end}}" data-rule="{{.Kind}}">
			<span class="rv-gate-mark" aria-hidden="true">{{if .Held}}{{if .Pending}}&#9719;{{else}}&#9675;{{end}}{{else}}&#10003;{{end}}</span>
			<div>
				<b>{{ctx.Locale.Tr (printf "asc_review.gate_rule_%s" .Kind)}}</b>
				<span class="rp-dim">
				{{if eq .Kind "approvals"}}{{ctx.Locale.Tr "asc_review.gate_approvals" .Have .Need}}
				{{else if eq .Kind "checks"}}{{if .Held}}{{if .Pending}}{{ctx.Locale.Tr "asc_review.gate_checks_pending" .Have .Need}}{{else}}{{ctx.Locale.Tr "asc_review.gate_checks_failing" .Have .Need}}{{end}}{{else}}{{ctx.Locale.Tr "asc_review.gate_checks_ok" .Need}}{{end}}
				{{else if eq .Kind "order"}}{{if .Held}}{{ctx.Locale.Tr "asc_review.gate_order_held"}}{{else}}{{ctx.Locale.Tr "asc_review.gate_order_ok"}}{{end}}
				{{else if eq .Kind "threads"}}{{ctx.Locale.Tr "asc_review.gate_threads" .Have}}{{end}}
				</span>
				{{if .Names}}<span class="rv-gate-names">{{range $i, $n := .Names}}{{if $i}}, {{end}}<code>{{$n}}</code>{{end}}</span>{{end}}
			</div>
		</li>
		{{end}}
	</ul>
	<p class="rp-quiet ds-mt-12">{{if $.AscGateRules}}{{ctx.Locale.Tr "asc_review.gate_note"}}{{else}}{{ctx.Locale.Tr "asc_review.gate_no_policy"}}{{end}}</p>
	</div>
</section>
{{end}}
