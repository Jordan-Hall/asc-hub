{{/*
Stack rail, needs-restack banner and stack actions of a stacked pull request (design board Review).
Template Attributes:
* AscStackPanel: *pull.AscStackPanel
* AscActions: *repo.AscStackActions (set for a signed-in viewer of a stack in an asc repository); every button is a link to the
  confirmation page, which runs the dry run
* AscQueueStates: map of pull request index to queue state, for the labels
*/}}
{{with .AscStackPanel}}
<section class="rv rv-stackpanel" data-asc-stack aria-labelledby="asc-stack-title">
	<div class="rv-stackpanel-head">
		<h2 id="asc-stack-title" class="rv-eyebrow">{{ctx.Locale.Tr "repo.pulls.asc_stack"}} &middot; {{ctx.Locale.TrPluralString (len .Entries) "repo.pulls.asc_stack_changes" (printf "%d" (len .Entries))}}</h2>
		{{with $.AscActions}}<a class="rv-stackpanel-queue" href="{{.QueueURL}}">{{ctx.Locale.Tr "repo.asc_queue.title"}}</a>{{end}}
	</div>
	{{if .NeedsRestack}}
	<div class="rv-banner rv-banner-warn asc-needs-restack" role="status">
		<div>
			{{ctx.Locale.Tr "repo.pulls.asc_needs_restack"}}
			{{with $.AscActions}}{{if .CanRestack}}<div class="rv-acts"><a class="rv-btn rv-btn-primary rv-btn-sm" href="{{.ConfirmURL}}?op=restack" data-testid="asc-restack-link">{{ctx.Locale.Tr "repo.pulls.asc_op.restack"}}</a></div>{{end}}{{end}}
		</div>
	</div>
	{{end}}
	<ol class="rv-stn-list">
		{{range .Entries}}
		<li class="rv-stn rv-stn-{{.State}}{{if .Current}} is-current{{end}}"{{if .Current}} aria-current="step"{{end}}>
			<a class="rv-stn-link" href="{{.Link}}">
				<span class="rv-stn-tick" aria-hidden="true"><i class="rv-stn-dot"></i></span>
				<span class="rv-stn-body">
					<span class="rv-stn-title">{{.Title}}</span>
					<span class="rv-stn-meta">
						<span class="rv-mono rv-faint">{{.Position}}/{{len $.AscStackPanel.Entries}} #{{.Index}}</span>
						<span class="rv-pill {{if eq .State "merged"}}rv-pill-ok{{else if eq .State "closed"}}rv-pill-err{{else}}rv-pill-warn{{end}}">{{ctx.Locale.Tr (printf "repo.pulls.asc_stack_state_%s" .State)}}</span>
						{{if $.AscQueueStates}}{{with index $.AscQueueStates .Index}}<span class="rv-pill rv-pill-info asc-state asc-state-queued_{{.}}" data-testid="asc-queue-state">{{ctx.Locale.Tr (printf "repo.pulls.asc_op.state.queued_%s" .)}}</span>{{end}}{{end}}
					</span>
				</span>
			</a>
		</li>
		{{end}}
	</ol>
	{{if .MergeBlocked}}
	<p class="rv-hint rv-stack-note asc-stack-merge-blocked">
		{{ctx.Locale.Tr "repo.pulls.asc_stack_parent_unmerged"}}
		{{with .Parent}}<a href="{{.Link}}">#{{.Index}}</a>{{end}}
	</p>
	{{end}}
	{{with $.AscActions}}
	{{if or .CanQueue .CanUnqueue .CanMerge .CanRestack .CanRevert}}
	<div class="rv-stack-actions" data-testid="asc-stack-actions">
		{{if .CanQueue}}<a class="rv-btn rv-btn-primary rv-btn-block" href="{{.ConfirmURL}}?op=queue" data-testid="asc-queue-link">{{ctx.Locale.Tr "repo.pulls.asc_op.queue"}}</a>{{end}}
		{{if .CanUnqueue}}<a class="rv-btn rv-btn-secondary rv-btn-block" href="{{.ConfirmURL}}?op=unqueue" data-testid="asc-unqueue-link">{{ctx.Locale.Tr "repo.pulls.asc_op.unqueue"}}</a>{{end}}
		{{if .CanMerge}}<a class="rv-btn rv-btn-secondary rv-btn-block" href="{{.ConfirmURL}}?op=merge" data-testid="asc-merge-link">{{ctx.Locale.Tr "repo.pulls.asc_op.merge_stack"}}</a>{{end}}
		{{if .CanRestack}}<a class="rv-btn rv-btn-secondary rv-btn-block" href="{{.ConfirmURL}}?op=restack">{{ctx.Locale.Tr "repo.pulls.asc_op.restack"}}</a>{{end}}
		{{if .CanRevert}}
			<a class="rv-btn rv-btn-secondary rv-btn-block" href="{{.ConfirmURL}}?op=revert&scope=this" data-testid="asc-revert-link">{{ctx.Locale.Tr "repo.pulls.asc_op.revert_this"}}</a>
			{{if gt (len $.AscStackPanel.Entries) 1}}<a class="rv-btn rv-btn-secondary rv-btn-block" href="{{.ConfirmURL}}?op=revert&scope=stack">{{ctx.Locale.Tr "repo.pulls.asc_op.revert_stack"}}</a>{{end}}
		{{end}}
	</div>
	{{end}}
	{{end}}
	<div class="rv-term rv-stack-cmd" role="group" aria-label="{{ctx.Locale.Tr "asc_review.rev_cli_label"}}"><div class="rv-term-b"><span class="rv-cm">$ </span>asc stack sync</div></div>
</section>
{{end}}
