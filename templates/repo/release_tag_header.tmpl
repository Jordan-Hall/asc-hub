{{/* The band of the Releases and Tags pages: eyebrow, title, the two views of one list, search, feed and the one primary action (boards Releases, Refs). */}}
{{$canReadReleases := $.Permission.CanRead $.UnitTypeReleases}}
{{$canReadCode := $.Permission.CanRead $.UnitTypeCode}}
<div class="rp-band">
	<div class="rp-band-main">
		<p class="rp-eyebrow">{{if .PageIsTagList}}{{ctx.Locale.Tr "asc_rp.refs"}}{{else}}{{ctx.Locale.Tr "asc_rp.releases_eyebrow"}}{{end}}</p>
		<h2 class="rp-h1">{{if .PageIsTagList}}{{ctx.Locale.Tr "repo.release.tags"}}{{else}}{{ctx.Locale.Tr "asc_rp.releases_title"}}{{end}}</h2>
		<p class="rp-sub">{{if .PageIsTagList}}{{ctx.Locale.Tr "asc_rp.tags_sub"}}{{else}}{{ctx.Locale.Tr "asc_rp.releases_sub"}}{{end}}</p>
	</div>
	<div class="rp-band-acts">
		{{if $canReadReleases}}
			<div class="ds-seg switch" role="group" aria-label="{{ctx.Locale.Tr "asc_rp.releases_view"}}">
				<a class="item{{if and .PageIsReleaseList (not .PageIsSingleTag)}} active{{end}}" href="{{.RepoLink}}/releases{{if .Keyword}}?q={{.Keyword}}{{end}}"{{if and .PageIsReleaseList (not .PageIsSingleTag)}} aria-current="true"{{end}}>{{ctx.Locale.TrPluralString .NumReleases "counters.n_releases" (ctx.Locale.PrettyNumber .NumReleases)}}</a>
				{{if $canReadCode}}<a class="item{{if or .PageIsTagList .PageIsSingleTag}} active{{end}}" href="{{.RepoLink}}/tags{{if .Keyword}}?q={{.Keyword}}{{end}}"{{if or .PageIsTagList .PageIsSingleTag}} aria-current="true"{{end}}>{{ctx.Locale.TrPluralString .NumTags "counters.n_tags" (ctx.Locale.PrettyNumber .NumTags)}}</a>{{end}}
			</div>
		{{end}}
		{{if and (not .PageIsTagList) .CanCreateRelease}}
			<a class="ds-btn ds-btn-primary" href="{{$.RepoLink}}/releases/new">{{ctx.Locale.Tr "repo.release.new_release"}}</a>
		{{end}}
	</div>
</div>
<div class="rp-filters">
	{{if .ShowReleaseSearch}}
		<form class="ignore-dirty rp-search release-list-search" method="get" role="search">
			<div class="ds-inwrap">
				{{svg "dsi-search" 16}}
				<label class="ds-sr" for="rp-release-q">{{ctx.Locale.Tr "asc_rp.filter_releases"}}</label>
				<input id="rp-release-q" class="ds-input" type="search" name="q" value="{{.Keyword}}" maxlength="255" spellcheck="false" enterkeyhint="search" placeholder="{{ctx.Locale.Tr "asc_rp.filter_releases"}}">
			</div>
		</form>
	{{end}}
	{{if .EnableFeed}}
		<a class="ds-btn ds-btn-secondary" href="{{.RepoLink}}/{{if .PageIsTagList}}tags{{else}}releases{{end}}.rss">{{svg "octicon-rss" 16}}{{ctx.Locale.Tr "rss_feed"}}</a>
	{{end}}
</div>
