{{/*
Access for this run: the token the run works with, for a repository administrator (asc answers GetToken to no one else).
Template Attributes:
* AscAgentRunToken: ascAgentTokenRow (nil: nothing is shown); AscAgentsBase: the address of the agents area
*/}}
{{with .AscAgentRunToken}}
<section class="rv-card" aria-labelledby="ar-token-h" data-testid="asc-agent-run-token">
	<div class="rv-card-h"><h2 id="ar-token-h">{{ctx.Locale.Tr "asc_review.run_token_title"}}</h2><span class="rv-pill rv-pill-{{.State.Tone}}">{{.State.Label}}</span></div>
	<dl class="rv-card-b rv-dl rv-token-facts">
		<dt>{{ctx.Locale.Tr "asc_review.run_token_id"}}</dt><dd><a href="{{$.AscAgentsBase}}/tokens"><code>{{.ID}}</code></a></dd>
		{{if not .Expires.IsZero}}<dt>{{ctx.Locale.Tr "asc_review.tokens_expires"}}</dt><dd>{{DateUtils.AbsoluteShort .Expires}}</dd>{{end}}
		<dt>{{ctx.Locale.Tr "asc_review.run_token_writes"}}</dt><dd>{{range $i, $g := .Paths}}{{if $i}}, {{end}}<code>{{$g}}</code>{{else}}{{ctx.Locale.Tr "asc_review.policy_write_default"}}{{end}}</dd>
		{{if .MaxChanges}}<dt>{{ctx.Locale.Tr "asc_review.run_token_changes"}}</dt><dd>{{.MaxChanges}}</dd>{{end}}
	</dl>
</section>
{{end}}
