{{/* The two lists of the repository home: what is in flight and what landed (board Repo). */}}
{{$isAsc := eq .Repository.GetStorageBackend "asc"}}
{{if and .Repository.CanEnablePulls (.Permission.CanRead $.UnitTypePullRequests)}}
<section class="rp-sec" aria-labelledby="rp-flight-title" data-stack-scope>
	<div class="rp-sec-h">
		<div>
			<h2 class="rp-sec-title" id="rp-flight-title">{{if $isAsc}}{{ctx.Locale.Tr "asc_rp.flight_title"}}{{else}}{{ctx.Locale.Tr "asc_rp.flight_title_pulls"}}{{end}}</h2>
			<p class="rp-sec-sub">{{ctx.Locale.Tr "asc_rp.flight_sub"}}</p>
		</div>
		<a class="rp-sec-act" href="{{.RepoLink}}/pulls">{{ctx.Locale.TrN (.Repository.NumOpenPulls ctx) "asc_rp.all_stacks_one" "asc_rp.all_stacks_other" (ctx.Locale.PrettyNumber (.Repository.NumOpenPulls ctx))}}</a>
	</div>
	{{if .HomeStacksFailed}}
		<div class="rp-sec-b rp-stacks-error" role="alert">
			<strong>{{ctx.Locale.Tr "asc_rp.stacks_failed"}}</strong>
			<span class="rp-quiet">{{ctx.Locale.Tr "asc_rp.stacks_failed_id" .HomeStacksRequestID}}</span>
			<a class="ds-btn ds-btn-secondary" href="{{.RepoLink}}">{{ctx.Locale.Tr "asc_rp.try_again"}}</a>
		</div>
	{{else if .HomeStacks}}
		<div class="rp-stack-filter" data-stack-filter>
			<div class="ds-seg ds-seg-mini" role="group" aria-label="{{ctx.Locale.Tr "asc_rp.stacks_filter"}}">
				<button type="button" data-stack-show="all" aria-pressed="true">{{ctx.Locale.Tr "asc_rp.f_open"}} <span class="rp-count">{{.HomeStackCounts.Open}}</span></button>
				{{if .IsSigned}}<button type="button" data-stack-show="mine" aria-pressed="false">{{ctx.Locale.Tr "asc_rp.f_mine"}} <span class="rp-count">{{.HomeStackCounts.Mine}}</span></button>{{end}}
				<button type="button" data-stack-show="agent" aria-pressed="false">{{ctx.Locale.Tr "asc_rp.f_agents"}} <span class="rp-count">{{.HomeStackCounts.Agents}}</span></button>
			</div>
		</div>
		<ul class="rp-rows" data-stack-rows>
			{{range .HomeStacks}}
				{{template "repo/stack_row" .}}
			{{end}}
		</ul>
		<p class="rp-quiet rp-stack-none" data-stack-none hidden>{{ctx.Locale.Tr "asc_rp.f_none"}}</p>
	{{else}}
		<div class="rp-sec-b rp-quiet">{{ctx.Locale.Tr "asc_rp.flight_none"}}</div>
	{{end}}
</section>
{{end}}
{{if .HomeLanded}}
<section class="rp-sec" aria-labelledby="rp-landed-title">
	<div class="rp-sec-h">
		<div>
			<h2 class="rp-sec-title" id="rp-landed-title">{{ctx.Locale.Tr "asc_rp.landed_title" .BranchName}}</h2>
			<p class="rp-sec-sub">{{ctx.Locale.Tr "asc_rp.landed_sub"}}</p>
		</div>
		<a class="rp-sec-act" href="{{.RepoLink}}/commits/{{.BranchNameSubURL}}">{{ctx.Locale.Tr "repo.file_history"}}</a>
	</div>
	<ul class="rp-rows">
		{{range .HomeLanded}}
			<li class="rp-flight rp-flight-link">
				<span class="ds-dot ds-dot-ok" aria-hidden="true"></span>
				<div class="rp-flight-main">
					<div class="rp-flight-title"><a href="{{$.RepoLink}}/commit/{{PathEscape .ID.String}}">{{.Summary | RenderEmoji $.Context}}</a></div>
					<div class="rp-flight-meta">
						{{if .User}}<a href="{{.User.HomeLink}}">{{.User.GetDisplayName}}</a>{{else}}<span>{{.Author.Name}}</span>{{end}}<span class="rp-sep-dot"></span><a class="rp-hash" href="{{$.RepoLink}}/commit/{{PathEscape .ID.String}}" title="{{ctx.Locale.Tr "asc_rp.change_id"}}">{{ShortSha .ID.String}}</a>{{if .StackName}}<span class="rp-sep-dot"></span><a class="rp-hash" href="{{.StackLink}}" title="{{ctx.Locale.Tr "asc_rp.stack_name"}}">{{.StackName}}</a>{{end}}
					</div>
				</div>
				<div class="rp-flight-side">
					{{if .HasStat}}<span class="rp-delta"><span class="rp-add">+{{.Additions}}</span> <span class="rp-del">&minus;{{.Deletions}}</span></span>{{end}}
					{{if .Status}}
						{{if .Status.State.IsSuccess}}<span class="ds-chip ds-chip-ok">{{ctx.Locale.Tr "asc_rp.checks_ok"}}</span>
						{{else if .Status.State.IsPending}}<span class="ds-chip ds-chip-warn">{{ctx.Locale.Tr "asc_rp.checks_pending"}}</span>
						{{else if .Status.State.IsSkipped}}<span class="ds-chip">{{ctx.Locale.Tr "asc_rp.checks_skipped"}}</span>
						{{else}}<span class="ds-chip ds-chip-err">{{ctx.Locale.Tr "asc_rp.checks_failing"}}</span>{{end}}
					{{end}}
					<time class="rp-flight-when">{{DateUtils.TimeSince .Committer.When}}</time>
				</div>
				<span class="rp-open" aria-hidden="true">{{ctx.Locale.Tr "asc_rp.open"}}</span>
			</li>
		{{end}}
	</ul>
</section>
{{end}}
