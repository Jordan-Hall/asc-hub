{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository">
	{{template "repo/header" .}}
	<div class="ds-container">
		{{template "base/alert" .}}
		<div class="user-main-content twelve wide column">
			<h4 class="ds-card-top">
				{{ctx.Locale.Tr "repo.admin.manage_flags"}}
			</h4>
			<div class="ds-card ds-card-b ds-card-attach">
				<form class="ui form ds-form" action="{{.Link}}" method="post">
					<strong>{{ctx.Locale.Tr "repo.admin.enabled_flags"}}</strong>
					<div class="ds-card ds-card-b tw-pl-4">
						{{range $flag, $checked := .Flags}}
							<div class="ds-field">
								<div class="ui checkbox{{if $checked}} checked{{end}}">
									<input name="flags" type="checkbox" value="{{$flag}}" {{if $checked}}checked{{end}}>
									<label>{{$flag}}</label>
								</div>
							</div>
						{{end}}
					</div>

					<div class="ds-field">
						<button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "repo.admin.update_flags"}}</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
