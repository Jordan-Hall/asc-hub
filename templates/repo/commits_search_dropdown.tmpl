<div class="rp-select">
	<label class="ds-sr" for="commit-search-scope">{{ctx.Locale.Tr "asc_rp.search_scope"}}</label>
	<select class="ds-select" id="commit-search-scope" name="all">
		<option value="false"{{if not .All}} selected{{end}}>{{ctx.Locale.Tr "repo.commits.search_branch"}}</option>
		<option value="true"{{if .All}} selected{{end}}>{{ctx.Locale.Tr "repo.commits.search_all"}}</option>
	</select>
</div>
