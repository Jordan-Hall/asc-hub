{{/* The keys card of the file viewer and blame (board Code): each key is also a control or says which control it presses. Dot: page data. */}}
<section class="rp-card rp-codekeys" aria-labelledby="rp-keys-title">
	<h2 class="rp-rail-title" id="rp-keys-title">{{ctx.Locale.Tr "asc_rp.keys_title"}}</h2>
	<ul class="rp-codekeys-list">
		<li><a href="{{.RepoLink}}/find/{{.BranchNameSubURL}}" data-asc-key="t"><kbd class="ds-kbd">t</kbd><span>{{ctx.Locale.Tr "asc_rp.go_to_file"}}</span></a></li>
		{{if or .IsBlame .IsRepresentableAsText}}<li><span><kbd class="ds-kbd">b</kbd><span>{{ctx.Locale.Tr "asc_rp.key_blame"}}</span></span></li>{{end}}
		{{if and .IsViewFile (not .IsViewCommit)}}<li><span><kbd class="ds-kbd">y</kbd><span>{{ctx.Locale.Tr "repo.file_permalink"}}</span></span></li>{{end}}
		{{if and .IsViewFile .CanEditFile .Repository.CanEnableEditor}}<li><span><kbd class="ds-kbd">e</kbd><span>{{ctx.Locale.Tr "asc_rp.edit_file"}}</span></span></li>{{end}}
		{{if or .IsBlame (and .IsViewFile .IsRepresentableAsText)}}<li><button type="button" class="rp-codekeys-btn" data-asc-key="l" data-goto-line-open aria-haspopup="dialog"><kbd class="ds-kbd">l</kbd><span>{{ctx.Locale.Tr "asc_rp.key_line"}}</span></button></li>{{end}}
		<li><button type="button" class="rp-codekeys-btn" data-asc-key="[" data-asc-toggle="rp-tree-off" data-asc-toggle-target=".rp-codegrid" aria-pressed="false"><kbd class="ds-kbd">[</kbd><span>{{ctx.Locale.Tr "asc_rp.key_tree"}}</span></button></li>
		<li><span><kbd class="ds-kbd">g</kbd> <kbd class="ds-kbd">c</kbd><span>{{ctx.Locale.Tr "asc_rp.key_code"}}</span></span></li>
	</ul>
	{{if or .IsBlame (and .IsViewFile .IsRepresentableAsText)}}
	<dialog class="rp-goto" data-goto-line aria-labelledby="rp-goto-h">
		<form method="dialog" class="ds-form">
			<h2 class="rp-goto-h" id="rp-goto-h">{{ctx.Locale.Tr "asc_rp.key_line"}}</h2>
			<label class="ds-label" for="rp-goto-n">{{ctx.Locale.Tr "asc_rp.goto_line_number"}}</label>
			<input id="rp-goto-n" class="ds-input" type="number" min="1" step="1" inputmode="numeric" required autocomplete="off">
			<div class="rp-goto-actions">
				<button type="submit" value="cancel" class="ds-btn ds-btn-secondary" formnovalidate>{{ctx.Locale.Tr "cancel"}}</button>
				<button type="submit" value="go" class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "asc_rp.goto_line_go"}}</button>
			</div>
		</form>
	</dialog>
	{{end}}
</section>
