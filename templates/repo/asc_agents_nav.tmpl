{{/*
The area navigation of the agents and workflows pages: one row of buttons, scrolling sideways on a phone.
Template Attributes:
* AscAgentsTab: runs, new, tokens or workflows
* AscAgentFeatures: the person's agent features switch
* AscAgentsCanStart, AscAgentsCanAdmin: what the person may do (both imply the switch)
* AscAgentsBase, AscWorkflowsBase: the two link prefixes
*/}}
<nav class="rv-seg rv-area-nav" aria-label="{{ctx.Locale.Tr "asc_review.agents_nav_label"}}" data-testid="asc-agents-nav">
	{{if .AscAgentFeatures}}
		<a href="{{.AscAgentsBase}}"{{if eq .AscAgentsTab "runs"}} aria-current="page"{{end}}>{{ctx.Locale.Tr "asc_review.agents_nav_runs"}}</a>
	{{end}}
	<a href="{{.AscWorkflowsBase}}"{{if eq .AscAgentsTab "workflows"}} aria-current="page"{{end}}>{{ctx.Locale.Tr "asc_review.agents_nav_workflows"}}</a>
	{{if .AscAgentFeatures}}
		{{if .AscAgentsCanStart}}{{if eq .AscAgentsTab "new"}}<a href="{{.AscAgentsBase}}/new" aria-current="page">{{ctx.Locale.Tr "asc_review.agents_nav_new"}}</a>{{end}}{{end}}
		{{if .AscAgentsCanAdmin}}<a href="{{.AscAgentsBase}}/tokens"{{if eq .AscAgentsTab "tokens"}} aria-current="page"{{end}}>{{ctx.Locale.Tr "asc_review.agents_nav_access"}}</a>{{end}}
	{{end}}
</nav>
{{if not .AscAgentFeatures}}
	<div class="rv-banner rv-banner-agent" role="note" data-testid="asc-agents-off">
		<div>{{ctx.Locale.Tr "asc_review.agents_off_note"}} <a href="{{AppSubUrl}}/-/asc/agents">{{ctx.Locale.Tr "asc_review.agents_off_link"}}</a></div>
	</div>
{{end}}
