{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="ds-main page-content repository new migrate rp-page">
	<div class="ds-container ds-container-form rp-body rp-skin">
		<div class="rp-new-col">
			<form class="ui form ds-form" action="{{.Link}}" method="post">
				{{template "base/disable_form_autofill"}}
				<h2 class="ds-t-h3 ds-card-title">
					{{ctx.Locale.Tr "repo.migrate.git_title"}}
					<input id="service_type" type="hidden" name="service" value="{{.service}}">
				</h2>
				<div class="ds-card ds-card-b ds-stack-16">
					{{template "base/alert" .}}
					<p class="help">{{ctx.Locale.Tr "repo.migrate.git_help"}}</p>
					<div class="ds-required ds-field {{if .Err_CloneAddr}}is-err{{end}}">
						<label class="ds-label" for="clone_addr">{{ctx.Locale.Tr "repo.migrate.git_clone_address"}}</label>
						<input class="ds-input" id="clone_addr" name="clone_addr" value="{{.clone_addr}}" autofocus required autocomplete="url">
						<span class="ds-hint">
						{{ctx.Locale.Tr "repo.migrate.git_clone_address_desc"}}{{if .ContextUser.CanImportLocal}} {{ctx.Locale.Tr "repo.migrate.clone_local_path"}}{{end}}
						</span>
					</div>
					<div class="ds-field {{if .Err_Auth}}is-err{{end}}">
						<label class="ds-label" for="auth_username">{{ctx.Locale.Tr "username"}}</label>
						<input class="ds-input" id="auth_username" name="auth_username" value="{{.auth_username}}" {{if not .auth_username}}data-need-clear="true"{{end}}>
					</div>
					<div class="ds-field {{if .Err_Auth}}is-err{{end}}">
						<label class="ds-label" for="auth_password">{{ctx.Locale.Tr "password"}}</label>
						<input class="ds-input" id="auth_password" name="auth_password" type="password" value="{{.auth_password}}">
					</div>

					{{template "repo/migrate/options" .}}

					<hr class="ds-hr">

					<div class="ds-required ds-field {{if .Err_Owner}}is-err{{end}}">
						<label class="ds-label">{{ctx.Locale.Tr "repo.owner"}}</label>
						<div class="ui selection owner dropdown">
							<input type="hidden" id="uid" name="uid" value="{{.ContextUser.ID}}" required>
							<span class="text truncated-item-container" title="{{.ContextUser.Name}}">
								{{ctx.AvatarUtils.Avatar .ContextUser}}
								<span class="truncated-item-name">{{.ContextUser.ShortName 40}}</span>
							</span>
							{{svg "octicon-triangle-down" 14 "dropdown icon"}}
							<div class="menu" title="{{.SignedUser.Name}}">
								<div class="item truncated-item-container" data-value="{{.SignedUser.ID}}">
									{{ctx.AvatarUtils.Avatar .SignedUser}}
									<span class="truncated-item-name">{{.SignedUser.ShortName 40}}</span>
								</div>
								{{range .Orgs}}
									<div class="item truncated-item-container" data-value="{{.ID}}" title="{{.Name}}">
										{{ctx.AvatarUtils.Avatar .}}
										<span class="truncated-item-name">{{.ShortName 40}}</span>
									</div>
								{{end}}
							</div>
						</div>
					</div>

					<div class="ds-required ds-field {{if .Err_RepoName}}is-err{{end}}">
						<label class="ds-label" for="repo_name">{{ctx.Locale.Tr "repo.repo_name"}}</label>
						<input class="ds-input" id="repo_name" name="repo_name" value="{{.repo_name}}" required maxlength="100" autocorrect="off" autocapitalize="none" spellcheck="false">
					</div>
					<div class="ds-field">
						<label class="ds-label">{{ctx.Locale.Tr "repo.visibility"}}</label>
						<div class="ds-check">
							<input id="chk-private" name="private" type="checkbox"
								{{if .IsForcedPrivate}}
									checked disabled
								{{else}}
									{{if .private}}checked{{end}}
								{{end}}>
							<label for="chk-private">{{ctx.Locale.Tr "repo.visibility_helper"}}</label>
						</div>
						{{if .IsForcedPrivate}}
							<span class="ds-hint">{{ctx.Locale.Tr "repo.visibility_helper_forced"}}</span>
						{{end}}
						<span class="ds-hint">{{ctx.Locale.Tr "repo.visibility_description"}}</span>
					</div>
					<div class="ds-field {{if .Err_Description}}is-err{{end}}">
						<label class="ds-label" for="description">{{ctx.Locale.Tr "repo.repo_desc"}}</label>
						<textarea class="ds-textarea" id="description" name="description" maxlength="2048">{{.description}}</textarea>
					</div>

					<div class="ds-field">
						<button class="ds-btn ds-btn-primary">
							{{ctx.Locale.Tr "repo.migrate_repo"}}
						</button>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>
{{template "base/footer" .}}
