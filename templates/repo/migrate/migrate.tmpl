{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="ds-main page-content repository new migrate rp-page">
	<div class="ds-container rp-body">
		<h2 class="rp-h1 ds-mb-8">{{ctx.Locale.Tr "migrate.select.title"}}</h2>
		{{template "repo/migrate/helper" .}}
		<p class="help">{{ctx.Locale.Tr "repo.migrate.select_help"}}</p>
		<div class="migrate-entries">
			{{range .Services}}
				<a class="migrate-entry tw-items-center" href="{{AppSubUrl}}/repo/migrate?service_type={{.}}&org={{$.Org}}&mirror={{$.Mirror}}">
					{{if eq .Name "github"}}
						{{svg "octicon-mark-github" 184}}
					{{else}}
						{{svg (printf "gitea-%s" .Name) 184}}
					{{end}}
					<div class="content">
						<h3>
							{{.Title}}
						</h3>
						<div class="description">
							{{ctx.Locale.Tr (printf "migrate.%s.description" .Name)}}
						</div>
					</div>
				</a>
			{{end}}
		</div>
	</div>
</div>
{{template "base/footer" .}}
