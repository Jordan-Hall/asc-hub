{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository">
	{{template "repo/header" .}}
	<div class="ds-container ds-container-narrow rp-body">
		{{template "base/alert" .}}
		<section class="ds-card" aria-live="polite">
			<div class="ds-card-b ds-stack-16 rp-migrating">
				<div id="repo_migrating" class="rp-migrating-img" data-migrating-task-id="{{.MigrateTask.ID}}">
					<img src="{{AssetUrlPrefix}}/img/forgejo-loading.svg" alt="{{ctx.Locale.Tr "loading"}}" width="160" height="160">
				</div>
				<div id="repo_migrating_failed_image" class="rp-migrating-img tw-hidden">
					<span class="rp-migrating-err">{{svg "octicon-git-pull-request-closed" 96}}</span>
				</div>
				<div id="repo_migrating_progress">
					<p>{{ctx.Locale.Tr "repo.migrate.migrating" .CloneAddr}}</p>
					<p id="repo_migrating_progress_message"></p>
				</div>
				<div id="repo_migrating_failed" class="tw-hidden">
					{{if .CloneAddr}}
						<p>{{ctx.Locale.Tr "repo.migrate.migrating_failed" .CloneAddr}}</p>
					{{else}}
						<p>{{ctx.Locale.Tr "repo.migrate.migrating_failed_no_addr"}}</p>
					{{end}}
					<p id="repo_migrating_failed_error"></p>
				</div>
				{{if .Permission.IsAdmin}}
					<div class="ds-row ds-gap-8 ds-row-wrap">
						{{if .Failed}}
							<button type="button" class="ds-btn ds-btn-danger show-modal" data-modal="#delete-repo-modal">{{ctx.Locale.Tr "repo.settings.delete"}}</button>
						{{else}}
							<button type="button" class="ds-btn ds-btn-secondary show-modal" data-modal="#cancel-repo-modal">{{ctx.Locale.Tr "cancel"}}</button>
						{{end}}
						<button type="button" id="repo_migrating_retry" data-migrating-task-retry-url="{{.Link}}/settings/migrate/retry" class="ds-btn ds-btn-secondary tw-hidden">{{ctx.Locale.Tr "retry"}}</button>
					</div>
				{{end}}
			</div>
		</section>
	</div>
</div>

<dialog id="delete-repo-modal">
	<article>
		<header>{{ctx.Locale.Tr "repo.settings.delete"}}</header>
		<div class="content">
			<div class="ds-banner ds-banner-warn">
				{{ctx.Locale.Tr "repo.settings.delete_notices_1"}}<br>
				{{ctx.Locale.Tr "repo.settings.delete_notices_2" .Repository.FullName}}
				{{if .Repository.NumForks}}<br>
				{{ctx.Locale.Tr "repo.settings.delete_notices_fork_1"}}
				{{end}}
			</div>
		</div>
		<form class="ui form ds-form" action="{{.Link}}/settings" method="post">
			<div class="content">
				<input type="hidden" name="action" value="delete">
				<div class="ds-field">
					<label>
						{{ctx.Locale.Tr "repo.settings.enter_repo_name"}}
						<span class="ds-c-err">{{.Repository.FullName}}</span>
					</label>
				</div>
				<div class="ds-required ds-field">
					<label for="repo_name_to_delete">{{ctx.Locale.Tr "repo.settings.confirmation_string"}}</label>
					<input class="ds-input" id="repo_name_to_delete" name="repo_name" autocorrect="off" autocapitalize="none" spellcheck="false" required>
				</div>
			</div>
			<div class="actions">
				<button type="button" class="ui cancel button ds-btn ds-btn-secondary">{{ctx.Locale.Tr "settings.cancel"}}</button>
				<button type="submit" class="ds-btn ds-btn-danger">{{ctx.Locale.Tr "repo.settings.confirm_delete"}}</button>
			</div>
		</form>
	</article>
</dialog>

<dialog id="cancel-repo-modal">
	<article>
		<header>{{ctx.Locale.Tr "migrate.cancel.title"}}</header>
		<form action="{{.Link}}/settings/migrate/cancel" method="post">
			<div class="content">
				{{ctx.Locale.Tr "migrate.cancel.confirmation"}}
			</div>
			{{template "base/modal_actions_confirm" .}}
		</form>
	</article>
</dialog>

{{template "base/footer" .}}
