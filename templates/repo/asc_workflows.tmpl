{{/*
The workflows of a repository (routers/web/repo/asc_workflows.go).
Template Attributes:
* AscWorkflowDefs: []ascWorkflowDef, AscWorkflowSkipped: definitions the hub could not show
* AscWorkflowRecent: []ascWorkflowRunRow
* AscAgentsFailure / AscAgentsDisabled: see repo/asc_agents_notice
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository rv-agents">
	{{template "repo/header" .}}
	<div class="rv rv-page">
		{{template "base/alert" .}}
		<div class="rv-area">{{template "repo/asc_agents_nav" .}}</div>
		<header class="rv-head">
			<div class="rv-head-main">
				<div class="rv-eyebrow">{{.Repository.FullName}} · {{ctx.Locale.Tr "asc_review.wf_eyebrow"}}</div>
				<h1 class="rv-title">{{ctx.Locale.Tr "asc_review.wf_title"}}</h1>
				<p class="rv-lead">{{ctx.Locale.Tr "asc_review.wf_lead"}} <code>.asc/workflows/</code></p>
			</div>
			<div class="rv-acts"><a class="rv-btn rv-btn-secondary" href="{{.AscWorkflowsBase}}/runs">{{ctx.Locale.Tr "asc_review.wf_history"}}</a></div>
		</header>
		{{template "repo/asc_agents_notice" .}}

		{{if not .AscAgentsDisabled}}
			{{if or .AscWorkflowDefs .AscWorkflowState .AscWorkflowQ}}
			<div class="ag-bar" data-testid="asc-workflow-filters">
				<div class="rv-chips" role="group" aria-label="{{ctx.Locale.Tr "asc_review.wf_filter_state"}}">
					<a class="rv-chip-btn" href="{{.AscWorkflowsBase}}"{{if not .AscWorkflowState}} aria-current="true"{{end}}>{{ctx.Locale.Tr "asc_review.agents_filter_all"}} <span class="rv-count">{{.AscWorkflowCountAll}}</span></a>
					<a class="rv-chip-btn" href="{{.AscWorkflowsBase}}?state=on"{{if eq .AscWorkflowState "on"}} aria-current="true"{{end}}>{{ctx.Locale.Tr "asc_review.wf_on"}} <span class="rv-count">{{.AscWorkflowCountOn}}</span></a>
					<a class="rv-chip-btn" href="{{.AscWorkflowsBase}}?state=off"{{if eq .AscWorkflowState "off"}} aria-current="true"{{end}}>{{ctx.Locale.Tr "asc_review.wf_off"}} <span class="rv-count">{{.AscWorkflowCountOff}}</span></a>
					<a class="rv-chip-btn" href="{{.AscWorkflowsBase}}?state=invalid"{{if eq .AscWorkflowState "invalid"}} aria-current="true"{{end}}>{{ctx.Locale.Tr "asc_review.wf_not_valid"}} <span class="rv-count">{{.AscWorkflowCountInvalid}}</span></a>
				</div>
				<form class="ag-search" method="get" action="{{.AscWorkflowsBase}}" role="search">
					{{if .AscWorkflowState}}<input type="hidden" name="state" value="{{.AscWorkflowState}}">{{end}}
					<label class="rv-sr" for="wf-q">{{ctx.Locale.Tr "asc_review.wf_search"}}</label>
					<input class="rv-input ag-q" id="wf-q" type="search" name="q" maxlength="80" value="{{.AscWorkflowQ}}" placeholder="{{ctx.Locale.Tr "asc_review.wf_search"}}" autocomplete="off">
					<button class="rv-btn rv-btn-secondary" type="submit">{{ctx.Locale.Tr "asc_review.agents_filter_apply"}}</button>
				</form>
			</div>
			{{end}}
			<div class="rv-cols rv-cols-main-side rv-gap">
			<div class="rv-stack">
			{{if .AscWorkflowDefs}}
				<ul class="rv-list rv-wf-defs" data-testid="asc-workflow-defs">
					{{range .AscWorkflowDefs}}
						<li class="rv-wf">
							<div class="rv-wf-main">
								<h2 class="rv-wf-name"><a href="{{.Link}}"><code>{{.Name}}</code></a>
									{{if not .Valid}}<span class="asc-pill asc-tone-bad">{{ctx.Locale.Tr "asc_review.wf_not_valid"}}</span>{{else if .Enabled}}<span class="asc-pill asc-tone-ok">{{ctx.Locale.Tr "asc_review.wf_on"}}</span>{{else}}<span class="asc-pill asc-tone-idle">{{ctx.Locale.Tr "asc_review.wf_off"}}</span>{{end}}
								</h2>
								{{if .Description}}<p class="rv-li-sub">{{.Description}}</p>{{end}}
								<ul class="rv-wf-triggers" aria-label="{{ctx.Locale.Tr "asc_review.wf_starts_when"}}">
									{{range .Triggers}}<li class="rv-pill rv-pill-outline">{{.Label}}</li>{{end}}
								</ul>
								{{if .Steps}}<p class="rv-li-sub wf-chain" aria-label="{{ctx.Locale.Tr "asc_review.wf_chain"}}">{{range $i, $s := .Steps}}{{if $i}} <span aria-hidden="true">&gt;</span> {{end}}<code class="rv-bare">{{$s.ID}}</code>{{end}}</p>{{end}}
								<p class="rv-li-meta">
									<span>{{ctx.Locale.TrN (len .Steps) "asc_review.wf_steps_one" "asc_review.wf_steps_other" (len .Steps)}}</span>
									{{if .Path}}<span><code>{{.Path}}</code></span>{{end}}
								</p>
								{{if .Error}}<div class="rv-run-fail" role="note">{{.Error}}</div>{{end}}
							<div class="wf-hist" data-testid="asc-workflow-history">
								<span class="rv-faint wf-hist-l">{{ctx.Locale.Tr "asc_review.wf_last_runs"}}</span>
								{{if .History}}<span class="wf-hist-strip" role="img" aria-label="{{ctx.Locale.Tr "asc_review.wf_history_alt" (len .History)}}">{{range .History}}<i class="wf-h wf-tone-{{.Tone}}" title="{{.Label}}"></i>{{end}}</span><span class="rv-faint">{{ctx.Locale.Tr "asc_review.wf_last_at" (DateUtils.TimeSince .LastRun)}}</span>{{else}}<span class="rv-faint">{{ctx.Locale.Tr "asc_review.wf_never_run"}}</span>{{end}}
							</div>
							</div>
							<div class="rv-wf-act">
								{{if and .Valid $.CanChangeWorkflows}}
								<form method="post" action="{{.Link}}/enable" class="wf-switch-form">
									{{$.CsrfTokenHtml}}
									<input type="hidden" name="enabled" value="{{if .Enabled}}0{{else}}1{{end}}">
									<input type="hidden" name="next" value="list">
									<button class="wf-switch" type="submit" role="switch" aria-checked="{{if .Enabled}}true{{else}}false{{end}}" aria-label="{{ctx.Locale.Tr "asc_review.wf_switch" .Name}}"><span></span></button>
								</form>
								{{if and .Enabled (not .Inputs)}}
								<form method="post" action="{{.Link}}/trigger">
									{{$.CsrfTokenHtml}}
									<button class="rv-btn rv-btn-secondary rv-btn-sm" type="submit">{{ctx.Locale.Tr "asc_review.wf_run_now"}}</button>
								</form>
								{{end}}
								{{end}}
								<a class="rv-btn rv-btn-secondary rv-btn-sm" href="{{.Link}}">{{if .Valid}}{{ctx.Locale.Tr "asc_review.wf_open"}}{{else}}{{ctx.Locale.Tr "asc_review.wf_fix"}}{{end}}</a>
							</div>
						</li>
					{{end}}
				</ul>
				{{if .AscWorkflowSkipped}}<p class="rv-hint rv-gap">{{ctx.Locale.TrN .AscWorkflowSkipped "asc_review.wf_skipped_one" "asc_review.wf_skipped_other" .AscWorkflowSkipped}}</p>{{end}}
			{{else if not .AscAgentsFailure}}
				<div class="rv-empty" data-testid="asc-workflow-defs-empty">
					<h2>{{ctx.Locale.Tr "asc_review.wf_none"}}</h2>
					<p>{{ctx.Locale.Tr "asc_review.wf_none_help"}} <code>.asc/workflows/review.toml</code></p>
					{{if or .AscWorkflowState .AscWorkflowQ}}<div class="rv-acts"><a class="rv-btn rv-btn-secondary" href="{{.AscWorkflowsBase}}">{{ctx.Locale.Tr "asc_review.agents_clear"}}</a></div>{{end}}
				</div>
			{{end}}

			{{if .AscWorkflowRecent}}
				<section aria-labelledby="rv-wf-latest">
					<div class="rv-row rv-section-head"><h2 id="rv-wf-latest" class="rv-h3">{{ctx.Locale.Tr "asc_review.wf_latest"}}</h2><a class="rv-end" href="{{.AscWorkflowsBase}}/runs">{{ctx.Locale.Tr "asc_review.wf_all_runs"}}</a></div>
					{{template "repo/asc_workflows_runlist" .AscWorkflowRecent}}
				</section>
			{{end}}
			</div>
			<aside class="rv-side" aria-label="{{ctx.Locale.Tr "asc_review.wf_side_label"}}">
				<section class="rv-card" aria-labelledby="rv-wfl-secrets" data-testid="asc-workflows-secrets">
					<div class="rv-card-h"><h2 id="rv-wfl-secrets">{{ctx.Locale.Tr "asc_review.wf_secrets_vars"}}</h2></div>
					<div class="rv-card-b">
						<p class="rv-muted">{{ctx.Locale.Tr "asc_review.wf_secrets_vars_help"}}</p>
						{{if .AscWorkflowSecretsUsed}}<ul class="rv-plain wf-secret-list">{{range .AscWorkflowSecretsUsed}}<li><code>{{.Name}}</code><span class="rv-faint">{{range $i, $w := .Workflows}}{{if $i}}, {{end}}{{$w}}{{end}}</span></li>{{end}}</ul>{{end}}
						{{if .AscWorkflowSecretsManage}}<p><a class="rv-btn rv-btn-secondary rv-btn-sm" href="{{.RepoLink}}/settings/asc/workflow-secrets" data-testid="asc-workflows-secrets-manage">{{ctx.Locale.Tr "asc_review.wf_manage_settings"}}</a></p>{{end}}
					</div>
				</section>
				{{if .AscWorkflowAllowed}}
				<section class="rv-card" aria-labelledby="rv-wfl-cap" data-testid="asc-workflows-capacity">
					<div class="rv-card-h"><h2 id="rv-wfl-cap">{{ctx.Locale.Tr "asc_review.wf_capacity"}}</h2></div>
					<div class="rv-card-b">
						<p class="rv-row"><b class="wf-cap-n">{{.AscWorkflowRunning}}</b><span class="rv-faint rv-end">{{ctx.Locale.Tr "asc_review.wf_capacity_of" .AscWorkflowAllowed}}</span></p>
						<progress class="wf-cap" max="100" value="{{.AscWorkflowCapacityPct}}" aria-label="{{ctx.Locale.Tr "asc_review.wf_capacity"}}"></progress>
					</div>
				</section>
				{{end}}
			</aside>
			</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
