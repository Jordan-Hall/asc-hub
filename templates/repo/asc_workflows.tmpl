{{/*
The workflows of a repository (routers/web/repo/asc_workflows.go).
Template Attributes:
* AscWorkflowDefs: []ascWorkflowDef, AscWorkflowSkipped: definitions the hub could not show
* AscWorkflowRecent: []ascWorkflowRunRow
* AscAgentsFailure / AscAgentsDisabled: see repo/asc_agents_notice
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository rv-agents">
	{{template "repo/header" .}}
	<div class="rv rv-page">
		{{template "base/alert" .}}
		<div class="rv-area">{{template "repo/asc_agents_nav" .}}</div>
		<header class="rv-head">
			<div class="rv-head-main">
				<div class="rv-eyebrow">{{.Repository.FullName}} · {{ctx.Locale.Tr "asc_review.wf_eyebrow"}}</div>
				<h1 class="rv-title">{{ctx.Locale.Tr "asc_review.wf_title"}}</h1>
				<p class="rv-lead">{{ctx.Locale.Tr "asc_review.wf_lead"}} <code>.asc/workflows/</code></p>
			</div>
			<div class="rv-acts"><a class="rv-btn rv-btn-secondary" href="{{.AscWorkflowsBase}}/runs">{{ctx.Locale.Tr "asc_review.wf_history"}}</a></div>
		</header>
		{{template "repo/asc_agents_notice" .}}

		{{if not .AscAgentsDisabled}}
			{{if .AscWorkflowDefs}}
				<ul class="rv-list rv-wf-defs" data-testid="asc-workflow-defs">
					{{range .AscWorkflowDefs}}
						<li class="rv-wf">
							<div class="rv-wf-main">
								<h2 class="rv-wf-name"><a href="{{.Link}}"><code>{{.Name}}</code></a>
									{{if not .Valid}}<span class="asc-pill asc-tone-bad">{{ctx.Locale.Tr "asc_review.wf_not_valid"}}</span>{{else if .Enabled}}<span class="asc-pill asc-tone-ok">{{ctx.Locale.Tr "asc_review.wf_on"}}</span>{{else}}<span class="asc-pill asc-tone-idle">{{ctx.Locale.Tr "asc_review.wf_off"}}</span>{{end}}
								</h2>
								{{if .Description}}<p class="rv-li-sub">{{.Description}}</p>{{end}}
								<ul class="rv-wf-triggers" aria-label="{{ctx.Locale.Tr "asc_review.wf_starts_when"}}">
									{{range .Triggers}}<li class="rv-pill rv-pill-outline">{{.Label}}</li>{{end}}
								</ul>
								<p class="rv-li-meta">
									<span>{{ctx.Locale.TrN (len .Steps) "asc_review.wf_steps_one" "asc_review.wf_steps_other" (len .Steps)}}</span>
									{{if .Path}}<span><code>{{.Path}}</code></span>{{end}}
								</p>
								{{if .Error}}<div class="rv-run-fail" role="note">{{.Error}}</div>{{end}}
							</div>
							<div class="rv-wf-act"><a class="rv-btn rv-btn-secondary" href="{{.Link}}">{{if .Valid}}{{ctx.Locale.Tr "asc_review.wf_open"}}{{else}}{{ctx.Locale.Tr "asc_review.wf_fix"}}{{end}}</a></div>
						</li>
					{{end}}
				</ul>
				{{if .AscWorkflowSkipped}}<p class="rv-hint rv-gap">{{ctx.Locale.TrN .AscWorkflowSkipped "asc_review.wf_skipped_one" "asc_review.wf_skipped_other" .AscWorkflowSkipped}}</p>{{end}}
			{{else if not .AscAgentsFailure}}
				<div class="rv-empty" data-testid="asc-workflow-defs-empty">
					<h2>{{ctx.Locale.Tr "asc_review.wf_none"}}</h2>
					<p>{{ctx.Locale.Tr "asc_review.wf_none_help"}} <code>.asc/workflows/review.toml</code></p>
				</div>
			{{end}}

			{{if .AscWorkflowRecent}}
				<section class="rv-gap" aria-labelledby="rv-wf-latest">
					<div class="rv-row rv-section-head"><h2 id="rv-wf-latest" class="rv-h3">{{ctx.Locale.Tr "asc_review.wf_latest"}}</h2><a class="rv-end" href="{{.AscWorkflowsBase}}/runs">{{ctx.Locale.Tr "asc_review.wf_all_runs"}}</a></div>
					{{template "repo/asc_workflows_runlist" .AscWorkflowRecent}}
				</section>
			{{end}}
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
