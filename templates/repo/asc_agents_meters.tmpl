{{/*
The budget meters. Dot: []ascagentui.Meter. A native <progress> carries the value for assistive technology; the
script of a live page changes value and text in place (data-meter).
*/}}
{{range .}}
	<div class="asc-meter" data-meter="{{.Key}}">
		<div class="asc-meter-head">
			<span>{{.Label}}</span>
			<b data-meter-text>{{.Used}}{{if not .Unlimited}} of {{.Limit}}{{else}} (no limit){{end}}</b>
		</div>
		{{if not .Unlimited}}<progress class="asc-meter-bar{{if .Over}} is-over{{else if .Warn}} is-warn{{end}}" max="100" value="{{.Percent}}" aria-label="{{.Label}}">{{.Percent}}%</progress>{{end}}
	</div>
{{end}}
