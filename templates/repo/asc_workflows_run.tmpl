{{/*
One workflow run (routers/web/repo/asc_workflows.go; the script is web_src/js/features/asc-agent-run.ts).
Template Attributes:
* AscWorkflowRun: ascWorkflowRunRow (Steps with State, AgentLink, Log, Waiting), AscWorkflowRunActive
* AscWorkflowCanAct: the person may cancel, decide and run again (implies the agent features switch)
* AscWorkflowPollURL
* CsrfTokenHtml
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository asc-agents">
	{{template "repo/header" .}}
	<div class="ui container">
		{{template "base/alert" .}}
		{{template "repo/asc_agents_nav" .}}
		{{template "repo/asc_agents_notice" .}}
		{{with .AscWorkflowRun}}
		<div id="asc-workflow-run" class="asc-run-page is-everything" data-asc-workflow-run data-poll-url="{{$.AscWorkflowPollURL}}" data-active="{{if .State.Active}}true{{else}}false{{end}}">
			<div class="asc-run-head">
				<h2 class="asc-ag-title"><a href="{{$.AscWorkflowsBase}}/{{.Workflow}}">{{.Workflow}}</a> · run {{.ID}}</h2>
				<span data-run-state>{{template "repo/asc_agents_pill" .State}}</span>
				{{if $.AscWorkflowCanAct}}
					{{if .State.Active}}
						<form class="asc-inline-form" method="post" action="{{.Link}}/cancel" data-run-cancel>
							{{$.CsrfTokenHtml}}
							<button class="ui basic red button" type="submit">Cancel run</button>
						</form>
					{{else}}
						<form class="asc-inline-form" method="post" action="{{.Link}}/rerun">
							{{$.CsrfTokenHtml}}
							<button class="ui basic button" type="submit">Run again</button>
						</form>
					{{end}}
				{{end}}
			</div>
			<p class="asc-muted asc-run-sub">
				{{.Trigger}}
				{{if .StartedBy}} · by {{.StartedBy}}{{end}}
				{{if not .Created.IsZero}} · {{DateUtils.TimeSince .Created}}{{end}}
				{{if .Source}} · definition version <code>{{.Source}}</code>{{end}}
				{{if .Change}} · change {{if .ChangeURL}}<a href="{{.ChangeURL}}"><code>{{.Change}}</code></a>{{else}}<code>{{.Change}}</code>{{end}} (<a href="{{$.AscWorkflowsBase}}/runs?change={{.ChangeText}}">all runs for it</a>){{end}}
			</p>
			<div class="ui negative message{{if not .Error}} tw-hidden{{end}}" role="alert" data-run-failure>{{.Error}}</div>

			<div class="asc-split">
				<div class="asc-main">
					<section class="asc-card" aria-labelledby="asc-wfr-steps">
						<h3 id="asc-wfr-steps" class="asc-card-title">Steps</h3>
						<ol class="asc-steps" data-testid="asc-workflow-run-steps">
							{{range .Steps}}
								<li class="asc-step" data-step="{{.ID}}">
									<div class="asc-run-main">
										<strong><code>{{.ID}}</code></strong>
										<span data-step-state>{{template "repo/asc_agents_pill" .State}}</span>
									</div>
									<div class="asc-run-meta">
										{{if not .Started.IsZero}}<span>started {{DateUtils.TimeSince .Started}}</span>{{end}}
										{{if not .Finished.IsZero}}<span>finished {{DateUtils.TimeSince .Finished}}</span>{{end}}
										{{if .DecidedBy}}<span>decided by {{.DecidedBy}}</span>{{end}}
										{{if .AgentLink}}{{if $.AscAgentFeatures}}<a href="{{.AgentLink}}">Open agent run {{.AgentRunID}}</a>{{else}}<span>agent run {{.AgentRunID}}</span>{{end}}{{end}}
									</div>
									{{if .Comment}}<div class="asc-run-desc">“{{.Comment}}”</div>{{end}}
									<div class="asc-run-fail{{if not .Error}} tw-hidden{{end}}" data-step-error>{{.Error}}</div>
									{{if and .Waiting $.AscWorkflowCanAct}}
										<form class="ui form asc-approval" method="post" action="{{$.AscWorkflowRun.Link}}/decide" data-testid="asc-workflow-approval">
											{{$.CsrfTokenHtml}}
											<input type="hidden" name="step" value="{{.ID}}">
											<div class="field">
												<label for="asc-wfr-comment-{{.ID}}">Comment <span class="asc-muted">(optional)</span></label>
												<input id="asc-wfr-comment-{{.ID}}" name="comment" type="text" maxlength="1024" autocomplete="off">
											</div>
											<div class="asc-actions">
												<button class="ui primary button" type="submit" name="decision" value="approve">Approve</button>
												<button class="ui basic red button" type="submit" name="decision" value="reject">Reject</button>
											</div>
											<small class="asc-muted">Only a person the step names can decide. An agent never can.</small>
										</form>
									{{end}}
									{{if .Log}}
										<details class="asc-step-log">
											<summary>Log ({{len .Log}} newest{{if .LogHidden}}, {{.LogHidden}} older not shown{{end}})</summary>
											<ol class="asc-log">{{template "repo/asc_agents_events" .Log}}</ol>
										</details>
									{{end}}
								</li>
							{{else}}
								<li class="asc-muted">No steps have started.</li>
							{{end}}
						</ol>
					</section>
				</div>
				<aside class="asc-side" aria-label="Inputs and use">
					{{if .Inputs}}
						<section class="asc-card" aria-labelledby="asc-wfr-inputs">
							<h3 id="asc-wfr-inputs" class="asc-card-title">Inputs</h3>
							<dl class="asc-dl">{{range .Inputs}}<dt><code>{{.Name}}</code></dt><dd>{{.Value}}</dd>{{end}}</dl>
						</section>
					{{end}}
					<section class="asc-card" aria-labelledby="asc-wfr-use">
						<h3 id="asc-wfr-use" class="asc-card-title">Used so far</h3>
						<div data-meters>{{template "repo/asc_agents_meters" .Meters}}</div>
						{{if not .Meters}}<p class="asc-muted">Nothing used yet.</p>{{end}}
					</section>
				</aside>
			</div>
		</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
