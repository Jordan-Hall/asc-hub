{{/*
One workflow run (routers/web/repo/asc_workflows.go; the script is web_src/js/features/asc-agent-run.ts).
Template Attributes:
* AscWorkflowRun: ascWorkflowRunRow (Steps with State, AgentLink, Log, Waiting), AscWorkflowRunActive
* AscWorkflowCanAct: the person may cancel, decide and run again (implies the agent features switch)
* AscWorkflowPollURL
* CsrfTokenHtml
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository rv-agents">
	{{template "repo/header" .}}
	<div class="rv rv-page">
		{{template "base/alert" .}}
		<div class="rv-area">{{template "repo/asc_agents_nav" .}}</div>
		{{template "repo/asc_agents_notice" .}}
		{{with .AscWorkflowRun}}
		<div id="asc-workflow-run" class="rv-run-page is-everything" data-asc-workflow-run data-poll-url="{{$.AscWorkflowPollURL}}" data-active="{{if .State.Active}}true{{else}}false{{end}}">
			<header class="rv-head">
				<div class="rv-head-main">
					<div class="rv-eyebrow"><a href="{{$.AscWorkflowsBase}}/{{.Workflow}}">{{.Workflow}}</a></div>
					<h1 class="rv-title">{{ctx.Locale.Tr "asc_review.wf_run_n" .ID}} <span data-run-state>{{template "repo/asc_state_pill" dict "S" .State "P" "asc_review.wf_state_"}}</span></h1>
					<p class="rv-run-sub">
						<span>{{.Trigger}}</span>
						{{if .StartedBy}}<span>{{ctx.Locale.Tr "asc_review.agents_by" .StartedBy}}</span>{{end}}
						{{if not .Created.IsZero}}<span>{{DateUtils.TimeSince .Created}}</span>{{end}}
						{{if .Source}}<span>{{ctx.Locale.Tr "asc_review.wf_def_version"}} <code>{{.Source}}</code></span>{{end}}
						{{if .Change}}<span>{{ctx.Locale.Tr "asc_review.wf_change"}} {{if .ChangeURL}}<a href="{{.ChangeURL}}"><code>{{.Change}}</code></a>{{else}}<code>{{.Change}}</code>{{end}} (<a href="{{$.AscWorkflowsBase}}/runs?change={{.ChangeText}}">{{ctx.Locale.Tr "asc_review.wf_all_runs_for"}}</a>)</span>{{end}}
					</p>
				</div>
				{{if $.AscWorkflowCanAct}}
					{{if .State.Active}}
						<details class="ag-pop rv-acts" data-run-cancel data-testid="asc-wf-cancel">
							<summary class="rv-btn rv-btn-danger">{{ctx.Locale.Tr "asc_review.wf_cancel"}}</summary>
							<form class="ag-pop-b rv-form" method="post" action="{{.Link}}/cancel">
								{{$.CsrfTokenHtml}}
								<p class="rv-hint">{{ctx.Locale.Tr "asc_review.wf_cancel_help"}}</p>
								<button class="rv-btn rv-btn-danger rv-btn-sm" type="submit">{{ctx.Locale.Tr "asc_review.wf_cancel_confirm"}}</button>
							</form>
						</details>
					{{else}}
						<form class="rv-acts" method="post" action="{{.Link}}/rerun">
							{{$.CsrfTokenHtml}}
							<button class="rv-btn rv-btn-secondary" type="submit">{{ctx.Locale.Tr "asc_review.wf_rerun"}}</button>
						</form>
					{{end}}
				{{end}}
			</header>
			<div class="rv-banner rv-banner-err{{if not .Error}} tw-hidden{{end}}" role="alert" data-run-failure>{{.Error}}</div>
			{{if .ErrorPrivate}}<div class="rv-banner" role="note" data-testid="asc-wf-error-private"><div>{{ctx.Locale.Tr "asc_review.wf_private_error"}}</div></div>{{end}}

			<div class="rv-cols rv-cols-main-side rv-gap">
				<section class="rv-card wf-flowcard" aria-labelledby="rv-wfr-flow" data-testid="asc-wf-flow">
					<div class="rv-card-h"><h2 id="rv-wfr-flow">{{ctx.Locale.Tr "asc_review.wf_flow"}}</h2></div>
					<ol class="wf-flow">
						{{range $i, $s := .Steps}}<li class="wf-node wf-tone-{{$s.State.Tone}}{{if $s.State.Active}} is-active{{end}}" data-flow-step="{{$s.ID}}"><code>{{$s.ID}}</code>{{template "repo/asc_state_pill" dict "S" $s.State "P" "asc_review.step_state_"}}</li>{{end}}
					</ol>
				</section>
				<section class="rv-card" aria-labelledby="rv-wfr-steps">
					<div class="rv-card-h"><h2 id="rv-wfr-steps">{{ctx.Locale.Tr "asc_review.wf_steps"}}</h2></div>
					<ol class="rv-steps" data-testid="asc-workflow-run-steps">
						{{range .Steps}}
							<li class="rv-step" data-step="{{.ID}}">
								<div class="rv-step-main">
									<div class="rv-step-top">
										<code class="rv-step-id">{{.ID}}</code>
										<span data-step-state>{{template "repo/asc_state_pill" dict "S" .State "P" "asc_review.step_state_"}}</span>
									</div>
									<div class="rv-li-meta">
										{{if not .Started.IsZero}}<span>{{ctx.Locale.Tr "asc_review.wf_started"}} {{DateUtils.TimeSince .Started}}</span>{{end}}
										{{if not .Finished.IsZero}}<span>{{ctx.Locale.Tr "asc_review.wf_finished"}} {{DateUtils.TimeSince .Finished}}</span>{{end}}
										{{if .DecidedBy}}<span>{{ctx.Locale.Tr "asc_review.wf_decided_by" .DecidedBy}}</span>{{end}}
										{{if .AgentLink}}{{if $.AscAgentFeatures}}<a href="{{.AgentLink}}">{{ctx.Locale.Tr "asc_review.wf_open_agent_run" .AgentRunID}}</a>{{else}}<span>{{ctx.Locale.Tr "asc_review.wf_agent_run" .AgentRunID}}</span>{{end}}{{end}}
									</div>
									{{if .Comment}}<div class="rv-quote">“{{.Comment}}”</div>{{end}}
									<div class="rv-run-fail{{if not .Error}} tw-hidden{{end}}" data-step-error>{{.Error}}</div>
									{{if .Private}}<p class="rv-hint" data-testid="asc-wf-step-private">{{ctx.Locale.Tr "asc_review.wf_step_private"}}</p>{{end}}
									{{if and .Waiting $.AscWorkflowCanAct}}
										<form class="rv-form rv-approval" method="post" action="{{$.AscWorkflowRun.Link}}/decide" data-testid="asc-workflow-approval">
											{{$.CsrfTokenHtml}}
											<input type="hidden" name="step" value="{{.ID}}">
											<div class="rv-field">
												<label class="rv-label" for="asc-wfr-comment-{{.ID}}">{{ctx.Locale.Tr "asc_review.wf_comment"}} <span class="rv-opt">{{ctx.Locale.Tr "asc_review.optional"}}</span></label>
												<input class="rv-input" id="asc-wfr-comment-{{.ID}}" name="comment" type="text" maxlength="1024" autocomplete="off">
											</div>
											<div class="rv-sticky rv-sticky-inline">
												<button class="rv-btn rv-btn-primary" type="submit" name="decision" value="approve">{{ctx.Locale.Tr "asc_review.wf_approve"}}</button>
												<button class="rv-btn rv-btn-danger" type="submit" name="decision" value="reject">{{ctx.Locale.Tr "asc_review.wf_reject"}}</button>
											</div>
											<small class="rv-hint">{{ctx.Locale.Tr "asc_review.wf_approval_help"}}</small>
										</form>
									{{end}}
									{{if .Log}}
										<details class="rv-details asc-step-log">
											<summary>{{ctx.Locale.Tr "asc_review.wf_log" (len .Log)}}{{if .LogHidden}}, {{ctx.Locale.Tr "asc_review.wf_log_hidden" .LogHidden}}{{end}}</summary>
											<ol class="rv-log">{{template "repo/asc_agents_events" .Log}}</ol>
										</details>
									{{end}}
								</div>
							</li>
						{{else}}
							<li class="rv-card-b rv-muted">{{ctx.Locale.Tr "asc_review.wf_no_steps_started"}}</li>
						{{end}}
					</ol>
				</section>
				<aside class="rv-side" aria-label="{{ctx.Locale.Tr "asc_review.wf_side_run_label"}}">
					{{if .Inputs}}
						<section class="rv-card" aria-labelledby="rv-wfr-inputs">
							<div class="rv-card-h"><h2 id="rv-wfr-inputs">{{ctx.Locale.Tr "asc_review.wf_inputs"}}</h2></div>
							<dl class="rv-card-b rv-dl">{{range .Inputs}}<dt><code>{{.Name}}</code></dt><dd>{{.Value}}</dd>{{end}}</dl>
						</section>
					{{end}}
					<section class="rv-card" aria-labelledby="rv-wfr-use">
						<div class="rv-card-h"><h2 id="rv-wfr-use">{{ctx.Locale.Tr "asc_review.wf_used"}}</h2></div>
						<div class="rv-card-b">
							<div class="rv-meters" data-meters>{{template "repo/asc_agents_meters" .Meters}}</div>
							{{if not .Meters}}<p class="rv-muted">{{ctx.Locale.Tr "asc_review.wf_nothing_used"}}</p>{{end}}
						</div>
					</section>
				</aside>
			</div>
		</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
