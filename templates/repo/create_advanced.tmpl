<div class="ds-field">
	<label class="ds-label" for="issue_labels">{{ctx.Locale.Tr "repo.issue_labels"}}</label>
	<select id="issue_labels" class="ds-select" name="issue_labels">
		<option value="">{{ctx.Locale.Tr "repo.issue_labels_helper"}}</option>
		{{range .LabelTemplateFiles}}
			<option value="{{.DisplayName}}"{{if eq $.issueLabels .DisplayName}} selected{{end}}>{{.DisplayName}} ({{.Description}})</option>
		{{end}}
	</select>
</div>

{{$supportedFormatsLength := len .SupportedObjectFormats}}
{{/* An asc repository has no object format to choose: the default (sha1) is sent and kept. Only offer the choice for git storage. */}}
{{if .NewRepoIsAsc}}
	<input type="hidden" name="object_format_name" value="{{.DefaultObjectFormat.Name}}" required>
{{else if ge $supportedFormatsLength 2}}
	<div class="ds-field">
		<label class="ds-label" for="object_format_name">{{ctx.Locale.Tr "repo.object_format"}}</label>
		<select id="object_format_name" class="ds-select" name="object_format_name" required>
			{{range .SupportedObjectFormats}}
				<option value="{{.Name}}"{{if eq .Name $.DefaultObjectFormat.Name}} selected{{end}}>{{.Name}}</option>
			{{end}}
		</select>
		<div class="ds-hint">{{ctx.Locale.Tr "repo.object_format_helper"}}</div>
	</div>
{{else}}
	<input type="hidden" name="object_format_name" value="{{.DefaultObjectFormat.Name}}" required>
{{end}}

<div class="ds-field">
	<label class="ds-label" for="default_branch">{{if .NewRepoIsAsc}}{{ctx.Locale.Tr "repo.trunk"}}{{else}}{{ctx.Locale.Tr "repo.default_branch"}}{{end}}</label>
	<input id="default_branch" class="ds-input ds-mono" name="default_branch" value="{{.default_branch}}" placeholder="{{.default_branch}}" autocomplete="off" autocapitalize="none" spellcheck="false">
	<div class="ds-hint">{{if .NewRepoIsAsc}}{{ctx.Locale.Tr "repo.trunk_helper"}}{{else}}{{ctx.Locale.Tr "repo.default_branch_helper"}}{{end}}</div>
</div>

<label class="ds-switch rp-new-switch">
	<input name="template" type="checkbox" role="switch">
	<span class="ds-switch-track"></span>
	<span>
		<strong>{{ctx.Locale.Tr "repo.template_helper"}}</strong>
		<span class="ds-hint">{{ctx.Locale.Tr "repo.template_description"}}</span>
	</span>
</label>
