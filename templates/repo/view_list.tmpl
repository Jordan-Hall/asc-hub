{{/* The files of a directory: one card, the latest change first. htmx replaces #repo-files-table with this template while the last change of each file loads. */}}
<div class="rp-sec rp-files-card">
<table id="repo-files-table" class="rp-files" {{if .HasFilesWithoutLatestCommit}}hx-indicator="tr.notready td.message span" hx-trigger="load" hx-swap="morph" hx-get="{{.LastCommitLoaderURL}}"{{end}}>
	<caption class="ds-sr">{{ctx.Locale.Tr "repo.files.caption"}}</caption>
	<thead class="ds-sr">
		<tr>
			<th>{{ctx.Locale.Tr "repo.files.filename"}}</th>
			<th>{{ctx.Locale.Tr "repo.files.last_commit_message"}}</th>
			<th>{{ctx.Locale.Tr "asc_rp.col_author"}}</th>
			<th>{{ctx.Locale.Tr "asc_rp.col_size"}}</th>
			<th>{{ctx.Locale.Tr "repo.files.last_commit_date"}}</th>
		</tr>
	</thead>
	<tbody>
		<tr class="commit-list rp-files-last">
			<td colspan="5">
				<div class="rp-files-last-in">
					<div class="latest-commit rp-latest">{{template "repo/latest_commit" .}}</div>
					<div class="rp-files-last-meta">{{if .LatestCommit}}{{template "repo/shabox" (dict "sha1" .LatestCommit.ID.String "commitLink" (printf "%s/commit/%s" .RepoLink (.LatestCommit.ID.String|PathEscape)) "signature" .LatestCommit.Signature "verification" .LatestCommitVerification)}}{{template "repo/commit_statuses" dict "Status" .LatestCommitStatus "Statuses" .LatestCommitStatuses}}{{if .LatestCommit.Committer}}<span class="ds-hide-xs">{{DateUtils.TimeSince .LatestCommit.Committer.When}}</span>{{end}}{{end}}{{if and .CommitsCount (not .TreePath)}}<a class="ds-hide-xs" href="{{.RepoLink}}/commits/{{.BranchNameSubURL}}">{{ctx.Locale.TrN .CommitsCount "asc_rp.n_changes_one" "asc_rp.n_changes_other" (ctx.Locale.PrettyNumber .CommitsCount)}}</a>{{end}}</div>
				</div>
			</td>
		</tr>
		{{if .HasParentPath}}
			<tr class="has-parent entry">
				<td colspan="5" class="rp-files-up">{{$n := len .TreeNames}}<a href="{{.BranchLink}}{{if gt $n 1}}/{{PathEscapeSegments (index .Paths (Eval $n "-" 2))}}{{end}}">{{svg "dsi-arrow-left" 16}}<span aria-hidden="true">..</span><span class="ds-sr">{{ctx.Locale.Tr "asc_rp.parent_dir"}}</span></a></td>
			</tr>
		{{end}}
		{{range $item := .Files}}
			{{$entry := $item.Entry}}
			{{$commit := $item.Commit}}
			<tr data-entryname="{{$entry.Name}}" data-ready="{{if $commit}}true{{else}}false{{end}}" class="{{if not $commit}}not{{end}}ready entry">
				<td class="name">
					<span class="truncate">
						{{if $entry.IsSubmodule}}
							{{$submodule := $item.Submodule}}
							{{$refURL := $submodule.ResolveUpstreamURL $.Repository.HTMLURL}}
							{{$icon := (svg "octicon-file-submodule" 16 "rp-ico rp-ico-file")}}
							{{if $refURL}}
								<a href="{{$refURL}}">{{$icon}}{{$entry.Name}}</a><span class="at">@</span><a class="rp-hash" href="{{$refURL}}/commit/{{PathEscape $submodule.Commit.String}}">{{ShortSha $submodule.Commit.String}}</a>
							{{else}}
								{{$icon}}{{$entry.Name}}<span class="at">@</span>{{ShortSha $submodule.Commit.String}}
							{{end}}
						{{else}}
							{{if $entry.IsDir}}
								{{$subJumpablePathName := $entry.GetSubJumpablePathName}}
								<a href="{{$.TreeLink}}/{{PathEscapeSegments $subJumpablePathName}}" title="{{$subJumpablePathName}}">
									{{$subJumpablePathFields := StringUtils.Split $subJumpablePathName "/"}}
									{{$subJumpablePathFieldLast := (Eval (len $subJumpablePathFields) "-" 1)}}
									{{svg "dsi-folder" 18 "rp-ico rp-ico-dir"}}
									{{- if eq $subJumpablePathFieldLast 0 -}}
										{{$subJumpablePathName}}
									{{- else -}}
										{{$subJumpablePathPrefixes := slice $subJumpablePathFields 0 $subJumpablePathFieldLast -}}
										<span class="rp-dim">{{StringUtils.Join $subJumpablePathPrefixes "/"}}/</span>{{index $subJumpablePathFields $subJumpablePathFieldLast}}
									{{- end -}}
								</a>
							{{else}}
								<a href="{{$.TreeLink}}/{{PathEscapeSegments $entry.Name}}" title="{{$entry.Name}}">{{svg (printf "octicon-%s" (EntryIcon $entry)) 18 "rp-ico rp-ico-file"}}{{$entry.Name}}</a>
							{{end}}
						{{end}}
					</span>
				</td>
				<td class="message">
					<span class="truncate">
						{{if $commit}}
							{{$commitLink := printf "%s/commit/%s" $.RepoLink (PathEscape $commit.ID.String)}}
							{{RenderCommitMessageLinkSubject $.Context $commit.Message $commitLink ($.Repository.ComposeMetas ctx)}}
						{{else}}
							<span class="rp-sk rp-sk-line" aria-hidden="true"></span><span class="ds-sr">{{ctx.Locale.Tr "asc_rp.loading"}}</span>
						{{end}}
					</span>
				</td>
				<td class="author rp-col-opt">{{if $commit}}<span class="truncate">{{$commit.Author.Name}}</span>{{end}}</td>
				<td class="size rp-col-opt ds-num">{{if and (not $entry.IsDir) (not $entry.IsSubmodule)}}{{ctx.Locale.TrSize $entry.Size}}{{end}}</td>
				<td class="age">{{if $commit}}{{DateUtils.TimeSince $commit.Committer.When}}{{end}}</td>
			</tr>
		{{end}}
	</tbody>
</table>
</div>
