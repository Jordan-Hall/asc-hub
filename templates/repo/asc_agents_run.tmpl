{{/*
One agent run, live (routers/web/repo/asc_agents.go; the script is web_src/js/features/asc-agent-run.ts).
Template Attributes:
* AscAgentRun: ascAgentRunRow, AscAgentRunTarget, AscAgentRunStarted, AscAgentRunWaiting, AscAgentRunWorkflow
* AscAgentMeters: []ascagentui.Meter, AscAgentChanges: []ascagentui.ChangeLink (the result stack, bottom first)
* AscAgentEvents: []ascAgentEvent (the newest), AscAgentEventsHidden, AscAgentLastSeq, AscAgentFeedDone
* AscAgentCanAct: the person may stop and steer; AscAgentPolicy; AscAgentsPollURL
* CsrfTokenHtml
The page works without the script: the log shows what existed when it was drawn, and a reload shows the rest.
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository rv-agents">
	{{template "repo/header" .}}
	<div class="rv rv-page">
		{{template "base/alert" .}}
		<div class="rv-area">{{template "repo/asc_agents_nav" .}}</div>
		{{template "repo/asc_agents_notice" .}}
		{{if .AscAgentRun}}
		<div id="asc-agent-run"
			class="rv-run-page"
			data-asc-agent-run
			data-poll-url="{{.AscAgentsPollURL}}"
			data-last-seq="{{.AscAgentLastSeq}}"
			data-active="{{if .AscAgentRun.State.Active}}true{{else}}false{{end}}"
			data-done="{{if .AscAgentFeedDone}}true{{else}}false{{end}}">
			<header class="rv-head rv-run-head">
				<span class="rv-av rv-av-agent rv-av-lg" aria-hidden="true">{{.AscAgentRun.Initials}}</span>
				<div class="rv-head-main">
					<div class="rv-eyebrow">{{ctx.Locale.Tr "asc_review.agents_run_n" .AscAgentRun.ID}}{{if .AscAgentRun.Agent}} · {{.AscAgentRun.Agent}}{{end}}</div>
					<h1 class="rv-title" data-run-title>{{.AscAgentRun.Title}}</h1>
					<p class="rv-run-sub">
						<span data-run-state>{{template "repo/asc_agents_pill" .AscAgentRun.State}}</span>
						{{if .AscAgentRun.CreatedBy}}<span>{{ctx.Locale.Tr "asc_review.run_started_by" .AscAgentRun.CreatedBy}}</span>{{end}}
						{{if not .AscAgentRun.Created.IsZero}}<span>{{DateUtils.TimeSince .AscAgentRun.Created}}</span>{{end}}
						{{if .AscAgentRunTarget}}<span>{{ctx.Locale.Tr "asc_review.run_for"}} <code>{{.AscAgentRunTarget}}</code></span>{{end}}
						{{if .AscAgentRun.Model}}<span>{{ctx.Locale.Tr "asc_review.run_model"}} <code>{{.AscAgentRun.Model}}</code></span>{{end}}
						{{if .AscAgentRunWorkflow}}<span>{{ctx.Locale.Tr "asc_review.run_part_of"}} <a href="{{.AscWorkflowsBase}}/runs">{{ctx.Locale.Tr "asc_review.run_workflow_run" .AscAgentRunWorkflow}}</a></span>{{end}}
					</p>
				</div>
				{{if and .AscAgentCanAct .AscAgentRun.State.Active}}
					<form class="rv-acts" method="post" action="{{.AscAgentsBase}}/runs/{{.AscAgentRun.ID}}/cancel" data-run-cancel>
						{{.CsrfTokenHtml}}
						<button class="rv-btn rv-btn-danger" type="submit">{{ctx.Locale.Tr "asc_review.run_stop"}}</button>
					</form>
				{{end}}
			</header>
			<div class="rv-banner rv-banner-err{{if not .AscAgentRun.Failure}} tw-hidden{{end}}" role="alert" data-run-failure>{{.AscAgentRun.Failure}}</div>
			<div class="rv-banner rv-banner-warn{{if not .AscAgentRunWaiting}} tw-hidden{{end}}" role="status" data-run-waiting><div>{{ctx.Locale.Tr "asc_review.run_waiting"}} <a href="#rv-steer">{{ctx.Locale.Tr "asc_review.run_answer_link"}}</a></div></div>

			<div class="rv-cols rv-run-cols">
				<section class="rv-card rv-area-budget" aria-labelledby="rv-budget-title">
					<div class="rv-card-h"><h2 id="rv-budget-title">{{ctx.Locale.Tr "asc_review.run_budget"}}</h2></div>
					<div class="rv-card-b">
						<div class="rv-meters" data-meters>{{template "repo/asc_agents_meters" .AscAgentMeters}}</div>
						<p class="rv-hint">{{ctx.Locale.Tr "asc_review.run_budget_help"}}</p>
					</div>
				</section>

				<div class="rv-area-main rv-stack">
					<section class="rv-card" aria-labelledby="rv-activity-title">
						<div class="rv-card-h">
							<h2 id="rv-activity-title">{{ctx.Locale.Tr "asc_review.run_activity"}}</h2>
							<label class="rv-check rv-check-inline rv-end"><input type="checkbox" data-show-all> {{ctx.Locale.Tr "asc_review.run_show_all"}}</label>
						</div>
						<p class="rv-feed-status" data-feed-status role="status">{{if .AscAgentFeedDone}}{{ctx.Locale.Tr "asc_review.run_feed_done"}}{{else if .AscAgentRun.State.Active}}{{ctx.Locale.Tr "asc_review.run_feed_following"}}{{else}}{{ctx.Locale.Tr "asc_review.run_feed_over"}}{{end}}</p>
						{{if .AscAgentEventsHidden}}<p class="rv-feed-status">{{ctx.Locale.Tr "asc_review.run_events_hidden" .AscAgentEventsHidden}}</p>{{end}}
						<ol class="asc-log rv-log" data-log aria-live="off" data-testid="asc-agent-log">
							{{template "repo/asc_agents_events" .AscAgentEvents}}
						</ol>
						<p class="rv-feed-status{{if .AscAgentEvents}} tw-hidden{{end}}" data-log-empty>{{ctx.Locale.Tr "asc_review.run_log_empty"}}</p>
					</section>

					{{if .AscAgentCanAct}}
						<section class="rv-card rv-steer" id="rv-steer" aria-labelledby="rv-steer-title" data-run-steer{{if not .AscAgentRun.State.Active}} hidden{{end}}>
							<div class="rv-card-h"><h2 id="rv-steer-title">{{if .AscAgentRunWaiting}}{{ctx.Locale.Tr "asc_review.run_answer"}}{{else}}{{ctx.Locale.Tr "asc_review.run_steer"}}{{end}}</h2></div>
							<form class="rv-card-b rv-form" method="post" action="{{.AscAgentsBase}}/runs/{{.AscAgentRun.ID}}/input">
								{{.CsrfTokenHtml}}
								<div class="rv-field">
									<label for="asc-ag-input" class="rv-sr">{{ctx.Locale.Tr "asc_review.run_message_label"}}</label>
									<textarea class="rv-textarea" id="asc-ag-input" name="text" rows="3" required maxlength="{{.AscAgentsMaxInput}}" placeholder="{{ctx.Locale.Tr "asc_review.run_message_placeholder"}}"></textarea>
								</div>
								<button class="rv-btn rv-btn-agent" type="submit">{{if .AscAgentRun.Agent}}{{ctx.Locale.Tr "asc_review.run_send_to" .AscAgentRun.Agent}}{{else}}{{ctx.Locale.Tr "asc_review.run_send"}}{{end}}</button>
							</form>
						</section>
					{{end}}

					<section class="rv-card" aria-labelledby="rv-result-title" data-testid="asc-agent-result">
						<div class="rv-card-h"><h2 id="rv-result-title">{{ctx.Locale.Tr "asc_review.run_result"}}</h2></div>
						<p class="rv-card-b rv-muted{{if .AscAgentChanges}} tw-hidden{{end}}" data-result-empty>{{ctx.Locale.Tr "asc_review.run_result_empty"}}</p>
						{{if .AscAgentChanges}}
							<ol class="rv-result" data-result-list>
								{{range .AscAgentChanges}}
									<li class="rv-result-row">
										<span class="rv-result-pos">{{.Position}}</span>
										<code>{{.Short}}</code>
										{{if .HasPull}}
											<span class="rv-result-state">{{if .Merged}}<span class="asc-pill asc-tone-ok">{{ctx.Locale.Tr "asc_review.run_change_landed"}}</span>{{else if .Closed}}<span class="asc-pill asc-tone-idle">{{ctx.Locale.Tr "asc_review.run_change_closed"}}</span>{{else}}<span class="asc-pill asc-tone-wait">{{ctx.Locale.Tr "asc_review.run_change_waiting"}}</span>{{end}}</span>
											<a class="rv-btn rv-btn-secondary rv-btn-sm" href="{{.URL}}">{{ctx.Locale.Tr "asc_review.run_change_review" .PullID}}</a>
										{{else}}
											<span class="rv-muted rv-result-note">{{ctx.Locale.Tr "asc_review.run_change_draft"}}</span>
										{{end}}
									</li>
								{{end}}
							</ol>
						{{end}}
						<p class="rv-card-f rv-hint">{{ctx.Locale.Tr "asc_review.run_result_help"}}</p>
					</section>
				</div>

				<div class="rv-area-policy">{{template "repo/asc_agents_policy" .}}</div>
			</div>
			{{if and .AscAgentCanAct .AscAgentRunWaiting}}<div class="rv-sticky rv-mob"><a class="rv-btn rv-btn-primary" href="#rv-steer">{{ctx.Locale.Tr "asc_review.run_answer"}}</a></div>{{end}}
		</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
