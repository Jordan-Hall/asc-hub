{{/*
One agent run, live (routers/web/repo/asc_agents.go; the script is web_src/js/features/asc-agent-run.ts).
Template Attributes:
* AscAgentRun: ascAgentRunRow, AscAgentRunTarget, AscAgentRunStarted, AscAgentRunWaiting, AscAgentRunWorkflow
* AscAgentMeters: []ascagentui.Meter, AscAgentChanges: []ascagentui.ChangeLink (the result stack, bottom first)
* AscAgentEvents: []ascAgentEvent (the newest), AscAgentEventsHidden, AscAgentLastSeq, AscAgentFeedDone
* AscAgentCanAct: the person may stop and steer; AscAgentPolicy; AscAgentsPollURL
* CsrfTokenHtml
The page works without the script: the log shows what existed when it was drawn, and a reload shows the rest.
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository rv-agents">
	{{template "repo/header" .}}
	<div class="rv rv-page">
		{{template "base/alert" .}}
		<div class="rv-area">{{template "repo/asc_agents_nav" .}}</div>
		{{template "repo/asc_agents_notice" .}}
		{{if .AscAgentRun}}
		<div class="ar-wrap">
		{{if .AscAgentRunRail}}
		<nav class="ar-rail" aria-label="{{ctx.Locale.Tr "asc_review.run_rail_label"}}" data-testid="asc-agent-rail">
			<div class="ar-rail-h"><span>{{ctx.Locale.Tr "asc_review.agents_nav_runs"}}</span>{{if .AscAgentsCanStart}}<a class="rv-btn rv-btn-primary rv-btn-sm" href="{{.AscAgentsBase}}/new">{{ctx.Locale.Tr "asc_review.run_rail_new"}}</a>{{end}}</div>
			<ul>
				{{range .AscAgentRunRail}}
				<li><a href="{{.Link}}"{{if eq .ID $.AscAgentRun.ID}} aria-current="page"{{end}}><b>{{ctx.Locale.Tr "asc_review.agents_run_n" .ID}} · {{.Title}}</b><span>{{.Agent}} · {{.State.Label}}{{if .Paused}} · {{ctx.Locale.Tr "asc_review.agents_paused"}}{{end}}{{if .Pending}} · {{ctx.Locale.Tr "asc_review.agents_roster_waiting"}}{{end}}</span></a></li>
				{{end}}
			</ul>
		</nav>
		{{end}}
		<div id="asc-agent-run"
			class="rv-run-page"
			data-asc-agent-run
			data-poll-url="{{.AscAgentsPollURL}}"
			data-last-seq="{{.AscAgentLastSeq}}"
			data-active="{{if .AscAgentRun.State.Active}}true{{else}}false{{end}}"
			data-done="{{if .AscAgentFeedDone}}true{{else}}false{{end}}">
			<header class="rv-head rv-run-head">
				<span class="rv-av rv-av-agent rv-av-lg" aria-hidden="true">{{.AscAgentRun.Initials}}</span>
				<div class="rv-head-main">
					<div class="rv-eyebrow">{{ctx.Locale.Tr "asc_review.agents_run_n" .AscAgentRun.ID}}{{if .AscAgentRun.Agent}} · {{.AscAgentRun.Agent}}{{end}}</div>
					<h1 class="rv-title" data-run-title>{{.AscAgentRun.Title}}</h1>
					<p class="rv-run-sub">
						<span data-run-state>{{template "repo/asc_agents_pill" .AscAgentRun.State}}</span>
						{{if .AscAgentRun.CreatedBy}}<span>{{ctx.Locale.Tr "asc_review.run_started_by" .AscAgentRun.CreatedBy}}</span>{{end}}
						{{if not .AscAgentRun.Created.IsZero}}<span>{{DateUtils.TimeSince .AscAgentRun.Created}}</span>{{end}}
						{{if .AscAgentRunTarget}}<span>{{ctx.Locale.Tr "asc_review.run_for"}} <code>{{.AscAgentRunTarget}}</code></span>{{end}}
						{{if .AscAgentRun.Model}}<span>{{ctx.Locale.Tr "asc_review.run_model"}} <code>{{.AscAgentRun.Model}}</code></span>{{end}}
						{{if .AscAgentRunWorkflow}}<span>{{ctx.Locale.Tr "asc_review.run_part_of"}} <a href="{{.AscWorkflowsBase}}/runs">{{ctx.Locale.Tr "asc_review.run_workflow_run" .AscAgentRunWorkflow}}</a></span>{{end}}
					</p>
				</div>
				{{if and .AscAgentCanAct .AscAgentRun.State.Active}}
					<div class="rv-acts ar-acts">
						<form method="post" action="{{.AscAgentsBase}}/runs/{{.AscAgentRun.ID}}/pause">
							{{.CsrfTokenHtml}}
							<input type="hidden" name="paused" value="{{if .AscAgentRunPaused}}0{{else}}1{{end}}">
							<button class="rv-btn rv-btn-secondary" type="submit" title="{{ctx.Locale.Tr "asc_review.run_pause_help"}}">{{if .AscAgentRunPaused}}{{ctx.Locale.Tr "asc_review.run_resume"}}{{else}}{{ctx.Locale.Tr "asc_review.run_pause"}}{{end}}</button>
						</form>
						<details class="ag-pop ar-stop">
							<summary class="rv-btn rv-btn-danger">{{ctx.Locale.Tr "asc_review.run_stop"}}</summary>
							<form class="ag-pop-b rv-form" method="post" action="{{.AscAgentsBase}}/runs/{{.AscAgentRun.ID}}/cancel" data-run-cancel>
								{{.CsrfTokenHtml}}
								<p class="rv-hint">{{ctx.Locale.Tr "asc_review.agents_stop_help"}}</p>
								<label class="rv-label" for="ar-stop-reason">{{ctx.Locale.Tr "asc_review.agents_stop_reason"}}</label>
								<input class="rv-input" id="ar-stop-reason" name="reason" maxlength="256" autocomplete="off">
								<button class="rv-btn rv-btn-danger rv-btn-sm" type="submit">{{ctx.Locale.Tr "asc_review.agents_stop_confirm"}}</button>
							</form>
						</details>
					</div>
				{{end}}
			</header>
			{{if .AscAgentRunTask}}<p class="ar-task" data-testid="asc-agent-task">{{ctx.Locale.Tr "asc_review.run_task_by" .AscAgentRun.CreatedBy}} <q>{{.AscAgentRunTask}}</q></p>{{end}}
			{{with .AscAgentRequest}}
			<section class="rv-banner rv-banner-warn ar-ask" role="status" aria-labelledby="ar-ask-h" data-testid="asc-agent-permission">
				<div class="ar-ask-b">
					<p id="ar-ask-h"><b>{{ctx.Locale.Tr "asc_review.run_ask_waiting" .Agent}}</b> {{.Summary}}{{if .Detail}} <code>{{.Detail}}</code>{{end}}</p>
					{{if $.AscAgentCanAct}}
					<form class="ar-ask-acts" method="post" action="{{$.AscAgentsBase}}/requests/{{.ID}}/decide">
						{{$.CsrfTokenHtml}}
						<input type="hidden" name="run" value="{{.RunID}}">
						<button class="rv-btn rv-btn-primary rv-btn-sm" type="submit" name="decision" value="allow">{{ctx.Locale.Tr "asc_review.run_allow_once"}}</button>
						<button class="rv-btn rv-btn-secondary rv-btn-sm" type="submit" name="decision" value="deny">{{ctx.Locale.Tr "asc_review.run_deny_continue"}}</button>
						<a class="rv-btn rv-btn-ghost rv-btn-sm" href="#rv-steer">{{ctx.Locale.Tr "asc_review.run_answer_own"}}</a>
					</form>
					{{end}}
					<p class="rv-hint">{{ctx.Locale.Tr "asc_review.run_only_person"}}</p>
				</div>
			</section>
			{{end}}
			<div class="rv-banner rv-banner-err{{if not .AscAgentRun.Failure}} tw-hidden{{end}}" role="alert" data-run-failure>{{.AscAgentRun.Failure}}</div>
			<div class="rv-banner rv-banner-warn{{if or (not .AscAgentRunWaiting) .AscAgentRequest}} tw-hidden{{end}}" role="status" data-run-waiting><div>{{ctx.Locale.Tr "asc_review.run_waiting"}} <a href="#rv-steer">{{ctx.Locale.Tr "asc_review.run_answer_link"}}</a></div></div>

			{{if and .AscAgentCanAct (not .AscAgentRun.State.Active) .AscAgentRun.Failure}}
			<details class="rv-disclose ar-continue" data-testid="asc-agent-continue">
				<summary class="rv-btn rv-btn-primary">{{ctx.Locale.Tr "asc_review.run_continue"}}</summary>
				<form class="rv-disclose-b rv-form" method="post" action="{{.AscAgentsBase}}/runs/{{.AscAgentRun.ID}}/continue">
					{{.CsrfTokenHtml}}
					<p class="rv-hint">{{ctx.Locale.Tr "asc_review.run_continue_help"}}</p>
					{{template "repo/asc_agents_limits_fields" .}}
					<button class="rv-btn rv-btn-primary rv-btn-sm" type="submit">{{ctx.Locale.Tr "asc_review.run_continue_go"}}</button>
				</form>
			</details>
			{{end}}
			{{if eq .AscAgentRun.State.Slug "succeeded"}}
			<div class="rv-banner rv-banner-ok" role="status" data-testid="asc-agent-done"><div><b>{{ctx.Locale.Tr "asc_review.run_done_title"}}</b> {{ctx.Locale.TrN .AscAgentRun.Changes "asc_review.run_done_changes_one" "asc_review.run_done_changes_other" .AscAgentRun.Changes}} {{ctx.Locale.Tr "asc_review.run_done_summary" .AscAgentRunSummaryTime .AscAgentRunSummaryCost .AscAgentRunSummaryTokens}}</div></div>
			{{end}}
			{{if eq .AscAgentRun.State.Slug "cancelled"}}
			<div class="rv-banner ar-stopped" role="status" data-testid="asc-agent-stopped"><div><b>{{ctx.Locale.Tr "asc_review.run_stopped_title"}}</b> {{ctx.Locale.Tr "asc_review.run_stopped_help" .AscAgentRun.Agent}}</div></div>
			{{end}}
			<p class="rv-feed-status tw-hidden" role="status" data-reconnect>{{ctx.Locale.Tr "asc_review.run_reconnecting"}}</p>

			<div class="rv-cols rv-run-cols">
				<section class="rv-card rv-area-budget" aria-labelledby="rv-budget-title">
					<div class="rv-card-h"><h2 id="rv-budget-title">{{ctx.Locale.Tr "asc_review.run_budget"}}</h2></div>
					<div class="rv-card-b">
						<div class="rv-meters" data-meters>{{template "repo/asc_agents_meters" .AscAgentMeters}}</div>
						<p class="rv-hint">{{ctx.Locale.Tr "asc_review.run_budget_help"}}</p>
						{{if and .AscAgentCanAct .AscAgentRun.State.Active}}
						<details class="ar-edit" data-testid="asc-agent-limits">
							<summary class="rv-btn rv-btn-secondary rv-btn-sm">{{ctx.Locale.Tr "asc_review.run_edit_limits"}}</summary>
							<form class="rv-form" method="post" action="{{.AscAgentsBase}}/runs/{{.AscAgentRun.ID}}/limits">
								{{.CsrfTokenHtml}}
								<p class="rv-hint">{{ctx.Locale.Tr "asc_review.run_edit_limits_help"}}</p>
								{{template "repo/asc_agents_limits_fields" .}}
								<button class="rv-btn rv-btn-primary rv-btn-sm" type="submit">{{ctx.Locale.Tr "asc_review.run_edit_limits_save"}}</button>
							</form>
						</details>
						{{end}}
					</div>
				</section>

				<div class="rv-area-main rv-stack">
					{{with .AscAgentPlan}}
					<section class="rv-card ar-plan" id="ag-plan" aria-labelledby="ar-plan-h" data-testid="asc-agent-plan">
						<div class="rv-card-h"><h2 id="ar-plan-h">{{ctx.Locale.Tr "asc_review.run_plan"}}</h2>
							{{if .Approved}}<span class="rv-pill rv-pill-ok rv-end">{{if .DecidedAt}}{{ctx.Locale.Tr "asc_review.run_plan_approved_at" .DecidedBy .DecidedAt}}{{else}}{{ctx.Locale.Tr "asc_review.run_plan_approved"}}{{end}}</span>
							{{else if .Rejected}}<span class="rv-pill rv-pill-err rv-end">{{ctx.Locale.Tr "asc_review.run_plan_rejected" .DecidedBy}}</span>
							{{else if .Pending}}<span class="rv-pill rv-pill-warn rv-end">{{ctx.Locale.Tr "asc_review.run_plan_waiting"}}</span>{{end}}</div>
						<ol class="ar-steps">
							{{range .Request.Steps}}<li class="is-{{.State}}"><span class="ar-mark" aria-hidden="true">{{if eq .State "done"}}&#10003;{{else if eq .State "doing"}}&bull;{{end}}</span><div><b>{{.Index}} {{.Text}}</b><span class="rv-li-sub">{{if eq .State "done"}}{{ctx.Locale.Tr "asc_review.run_step_done"}}{{else if eq .State "doing"}}{{ctx.Locale.Tr "asc_review.run_step_doing"}}{{else}}{{ctx.Locale.Tr "asc_review.run_step_todo"}}{{end}}</span></div></li>{{end}}
						</ol>
						{{if and .Pending $.AscAgentCanAct}}
						<form class="rv-card-f ar-plan-acts" method="post" action="{{$.AscAgentsBase}}/requests/{{.Request.ID}}/decide">
							{{$.CsrfTokenHtml}}
							<input type="hidden" name="run" value="{{.Request.RunID}}">
							<button class="rv-btn rv-btn-primary rv-btn-sm" type="submit" name="decision" value="approve">{{ctx.Locale.Tr "asc_review.run_plan_approve"}}</button>
							<button class="rv-btn rv-btn-secondary rv-btn-sm" type="submit" name="decision" value="reject">{{ctx.Locale.Tr "asc_review.run_plan_reject"}}</button>
						</form>
						{{end}}
					</section>
					{{end}}
					<section class="rv-card" aria-labelledby="rv-activity-title">
						<div class="rv-card-h">
							<h2 id="rv-activity-title">{{ctx.Locale.Tr "asc_review.run_activity"}}</h2>
							<label class="rv-check rv-check-inline rv-end"><input type="checkbox" data-show-all> {{ctx.Locale.Tr "asc_review.run_show_all"}}</label>
						</div>
						<p class="rv-feed-status" data-feed-status role="status">{{if .AscAgentFeedDone}}{{ctx.Locale.Tr "asc_review.run_feed_done"}}{{else if .AscAgentRun.State.Active}}{{ctx.Locale.Tr "asc_review.run_feed_following"}}{{else}}{{ctx.Locale.Tr "asc_review.run_feed_over"}}{{end}}</p>
						{{if .AscAgentEventsHidden}}<p class="rv-feed-status">{{ctx.Locale.Tr "asc_review.run_events_hidden" .AscAgentEventsHidden}}</p>{{end}}
						<ol class="asc-log rv-log" data-log aria-live="off" data-testid="asc-agent-log">
							{{template "repo/asc_agents_events" .AscAgentEvents}}
						</ol>
						<p class="rv-feed-status{{if .AscAgentEvents}} tw-hidden{{end}}" data-log-empty>{{ctx.Locale.Tr "asc_review.run_log_empty"}}</p>
					</section>

					{{if .AscAgentCanAct}}
						<section class="rv-card rv-steer" id="rv-steer" aria-labelledby="rv-steer-title" data-run-steer{{if not .AscAgentRun.State.Active}} hidden{{end}}>
							<div class="rv-card-h"><h2 id="rv-steer-title">{{if .AscAgentRunWaiting}}{{ctx.Locale.Tr "asc_review.run_answer"}}{{else}}{{ctx.Locale.Tr "asc_review.run_steer"}}{{end}}</h2></div>
							<form class="rv-card-b rv-form" method="post" action="{{.AscAgentsBase}}/runs/{{.AscAgentRun.ID}}/input">
								{{.CsrfTokenHtml}}
								<div class="rv-field">
									<label for="asc-ag-input" class="rv-sr">{{ctx.Locale.Tr "asc_review.run_message_label"}}</label>
									<textarea class="rv-textarea" id="asc-ag-input" name="text" rows="3" required maxlength="{{.AscAgentsMaxInput}}" placeholder="{{ctx.Locale.Tr "asc_review.run_message_placeholder"}}"></textarea>
								</div>
								<button class="rv-btn rv-btn-agent" type="submit">{{if .AscAgentRun.Agent}}{{ctx.Locale.Tr "asc_review.run_send_to" .AscAgentRun.Agent}}{{else}}{{ctx.Locale.Tr "asc_review.run_send"}}{{end}}</button>
							</form>
						</section>
					{{end}}

					<section class="rv-card" aria-labelledby="rv-result-title" data-testid="asc-agent-result">
						<div class="rv-card-h"><h2 id="rv-result-title">{{ctx.Locale.Tr "asc_review.run_result"}}</h2></div>
						<p class="rv-card-b rv-muted{{if .AscAgentChanges}} tw-hidden{{end}}" data-result-empty>{{ctx.Locale.Tr "asc_review.run_result_empty"}}</p>
						{{if .AscAgentChanges}}
							<ol class="rv-result" data-result-list>
								{{range .AscAgentChanges}}
									<li class="rv-result-row">
										<span class="rv-result-pos">{{.Position}}</span>
										<code>{{.Short}}</code>
										{{if .HasPull}}
											<span class="rv-result-state">{{if .Merged}}<span class="asc-pill asc-tone-ok">{{ctx.Locale.Tr "asc_review.run_change_landed"}}</span>{{else if .Closed}}<span class="asc-pill asc-tone-idle">{{ctx.Locale.Tr "asc_review.run_change_closed"}}</span>{{else}}<span class="asc-pill asc-tone-wait">{{ctx.Locale.Tr "asc_review.run_change_waiting"}}</span>{{end}}</span>
											<a class="rv-btn rv-btn-secondary rv-btn-sm" href="{{.URL}}">{{ctx.Locale.Tr "asc_review.run_change_review" .PullID}}</a>
										{{else}}
											<span class="rv-muted rv-result-note">{{ctx.Locale.Tr "asc_review.run_change_draft"}}</span>
										{{end}}
									</li>
								{{end}}
							</ol>
						{{end}}
						<p class="rv-card-f rv-hint">{{ctx.Locale.Tr "asc_review.run_result_help"}}</p>
					</section>
				</div>

				<div class="rv-area-policy">
					{{template "repo/asc_agents_policy" .}}
					{{if .AscAgentCheckpoints}}
					<section class="rv-card ar-cps" aria-labelledby="ar-cps-h" data-testid="asc-agent-checkpoints">
						<div class="rv-card-h"><h2 id="ar-cps-h">{{ctx.Locale.Tr "asc_review.run_checkpoints"}}</h2></div>
						<ul class="rv-list">
							{{range .AscAgentCheckpoints}}
							<li class="ar-cp">
								<span>{{.Label}}{{if .RolledBack}} <span class="rv-pill">{{ctx.Locale.Tr "asc_review.run_cp_rolled" .RolledBy}}</span>{{end}}</span>
								{{if and $.AscAgentCanAct (not .RolledBack)}}
								<form method="post" action="{{$.AscAgentsBase}}/runs/{{$.AscAgentRun.ID}}/rollback">
									{{$.CsrfTokenHtml}}
									<input type="hidden" name="checkpoint" value="{{.ID}}">
									<button class="rv-btn rv-btn-ghost rv-btn-sm" type="submit"{{if not $.AscAgentRunPaused}} disabled title="{{ctx.Locale.Tr "asc_review.run_cp_pause_first"}}"{{end}}>{{ctx.Locale.Tr "asc_review.run_cp_rollback"}}</button>
								</form>
								{{end}}
							</li>
							{{end}}
						</ul>
						{{if not .AscAgentRunPaused}}<p class="rv-card-f rv-hint">{{ctx.Locale.Tr "asc_review.run_cp_help"}}</p>{{end}}
					</section>
					{{end}}
					<section class="rv-card rv-card-agent ar-audit" data-testid="asc-agent-audit"><div class="rv-card-b"><p><b>{{ctx.Locale.Tr "asc_review.run_audit_title"}}</b> {{ctx.Locale.Tr "asc_review.run_audit_text"}}</p><p><a href="{{.AscAgentsBase}}/runs/{{.AscAgentRun.ID}}/log" download>{{ctx.Locale.Tr "asc_review.run_audit_download"}}</a></p></div></section>
				</div>
			</div>
			</div>
			{{if and .AscAgentCanAct .AscAgentRunWaiting}}<div class="rv-sticky rv-mob"><a class="rv-btn rv-btn-primary" href="#rv-steer">{{ctx.Locale.Tr "asc_review.run_answer"}}</a></div>{{end}}
		</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
