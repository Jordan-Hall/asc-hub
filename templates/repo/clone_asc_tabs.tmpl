{{/* The git compatibility note (board GitNote): one collapsed disclosure after the asc commands. Needs AscGitAccess and CloneButtonOriginLink. */}}
{{if $.AscGitAccess}}
<details class="asc-git-compat rp-gitnote">
	<summary>
		<span class="rp-gitnote-ic" aria-hidden="true">{{svg "dsi-link" 16}}</span>
		<span class="rp-gitnote-lead">{{ctx.Locale.Tr "asc_rp.gitnote_lead"}}</span>
		<span class="rp-gitnote-toggle">{{ctx.Locale.Tr "asc_rp.gitnote_toggle"}}{{svg "dsi-chevron-down" 14}}</span>
	</summary>
	<div class="rp-gitnote-body">
		<p>{{ctx.Locale.Tr "repo.clone_with_git_help"}}{{if not SSHEnabled}} {{ctx.Locale.Tr "repo.clone_https_only_help"}}{{end}}</p>
		<div class="ds-term">
			<div class="ds-term-hd"><span>{{ctx.Locale.Tr "asc_rp.terminal"}}</span><button type="button" class="ds-copy" data-clipboard-target="#rp-git-clone-url">{{svg "dsi-copy" 14}} {{ctx.Locale.Tr "asc_download.copy"}}</button></div>
			<div class="ds-term-bd" tabindex="0" role="region" aria-label="{{ctx.Locale.Tr "asc_rp.terminal"}}"><span class="ds-pr">$</span> git clone <span class="js-clone-url">{{$.CloneButtonOriginLink.HTTPS}}</span></div>
		</div>
		<input type="text" class="js-clone-url ds-sr" id="rp-git-clone-url" data-clone-prefix="git clone " value="git clone {{$.CloneButtonOriginLink.HTTPS}}" readonly tabindex="-1" aria-hidden="true">
		<p class="rp-quiet" data-testid="gitnote-token-hint">{{ctx.Locale.Tr "asc_rp.gitnote_token_hint"}}</p>
	</div>
</details>
{{else}}
<p class="rp-quiet rp-gitnote-off" data-testid="gitnote-off">{{svg "dsi-link" 14}} {{ctx.Locale.Tr "asc_rp.gitnote_off"}}</p>
{{end}}
