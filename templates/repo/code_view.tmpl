{{/* The file viewer and blame (board Code): folder rail, the file, and what is known about it. */}}
{{$isAsc := eq .Repository.GetStorageBackend "asc"}}
{{$n := len .TreeNames}}
{{$dirLink := .BranchLink}}
{{if gt $n 1}}{{$dirLink = print .BranchLink "/" (PathEscapeSegments (index .Paths (Eval $n "-" 2)))}}{{end}}
{{$treeRel := PathEscapeSegments .TreePath}}
<div role="main" aria-label="{{.Title}}" class="ds-main page-content repository file list rp-page rp-codepage {{if .IsBlame}}blame{{end}}">
	{{template "shared/ds/subbar" (dict "Data" . "Title" .FileName "BackHref" $dirLink "BackLabel" .Repository.Name)}}
	<div class="ds-container ds-container-xl rp-codegrid">
		<aside class="rp-tree" id="rp-tree" aria-label="{{ctx.Locale.Tr "asc_rp.files"}}" data-loading-links>
			<div class="rp-tree-h">
				<h2 class="rp-tree-title">{{ctx.Locale.Tr "asc_rp.files"}}</h2>
				<a class="ds-btn ds-btn-ghost ds-btn-icon rp-tree-close" href="#" aria-label="{{ctx.Locale.Tr "asc_shell.close"}}">{{svg "dsi-x" 20}}</a>
			</div>
			<div class="rp-tree-b">
				{{if .AscTree}}
					<nav aria-label="{{ctx.Locale.Tr "asc_rp.files"}}">{{template "repo/code_tree" .AscTree}}</nav>
					{{if .AscTreeCut}}<p class="rp-tree-hint">{{ctx.Locale.Tr "asc_rp.tree_cut"}}</p>{{end}}
				{{end}}
				<p class="rp-tree-hint"><a href="{{.BranchLink}}">{{.Repository.FullName}}</a></p>
				<p class="rp-tree-hint">{{ctx.Locale.Tr "asc_rp.tree_keys_hint"}}</p>
				{{if .AscTreeTouched}}<p class="rp-tree-hint">{{ctx.Locale.TrN .AscTreeTouched "asc_rp.tree_touched_1" "asc_rp.tree_touched_n" (HTMLFormat `<span class="ds-count ds-count-hot rp-tree-count" aria-hidden="true">%d</span><span class="ds-sr">%d</span>` .AscTreeTouched .AscTreeTouched)}}</p>{{end}}
			</div>
		</aside>
		<div class="rp-codemain">
			{{template "base/alert" .}}
			<div class="rp-crumbbar">
				{{template "repo/filepath" .}}
			</div>
			<div class="rp-codebar">
				<div class="ds-seg" role="group" aria-label="{{ctx.Locale.Tr "asc_rp.file_view"}}" data-loading-links>
					<a href="{{.RepoLink}}/src/{{.BranchNameSubURL}}/{{$treeRel}}"{{if .IsViewFile}} aria-current="true"{{else}} data-asc-key="b"{{end}}>{{ctx.Locale.Tr "repo.code"}}</a>
					{{if or .IsBlame .IsRepresentableAsText}}<a href="{{.RepoLink}}/blame/{{.BranchNameSubURL}}/{{$treeRel}}"{{if .IsBlame}} aria-current="true"{{else}} data-asc-key="b"{{end}}>{{ctx.Locale.Tr "repo.blame"}}</a>{{end}}
					<a href="{{.RepoLink}}/commits/{{.BranchNameSubURL}}/{{$treeRel}}">{{ctx.Locale.Tr "repo.file_history"}}</a>
				</div>
				{{template "repo/branch_dropdown" dict "root" . "ContainerClasses" "rp-ref"}}
				<a class="ds-btn ds-btn-secondary ds-btn-icon rp-files-btn" href="#rp-tree" aria-label="{{ctx.Locale.Tr "asc_rp.files"}}" aria-haspopup="dialog">{{svg "dsi-folder" 18}}</a>
				<div class="rp-codebar-acts">
					<a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{$.RawFileLink}}">{{ctx.Locale.Tr "repo.file_raw"}}</a>
					{{if and .IsViewFile .Repository.CanEnableEditor}}
						{{if .CanEditFile}}<a class="ds-btn ds-btn-primary ds-btn-sm" data-asc-key="e" href="{{.RepoLink}}/_edit/{{PathEscapeSegments .BranchName}}/{{PathEscapeSegments .TreePath}}" title="{{.EditFileTooltip}}">{{if $isAsc}}{{ctx.Locale.Tr "asc_rp.propose_change"}} <kbd class="ds-kbd" aria-hidden="true">e</kbd>{{else}}{{ctx.Locale.Tr "asc_rp.edit_file"}}{{end}}</a>{{end}}
					{{end}}
					{{if .IsViewFile}}
					<details class="dropdown rp-dd rp-fileops">
						<summary class="ds-btn ds-btn-secondary ds-btn-sm ds-btn-icon" aria-label="{{ctx.Locale.Tr "repo.more_operations"}}">{{svg "dsi-dots" 18}}</summary>
						<div class="content rp-pop">
							<ul>
								<li><a download href="{{$.RawFileLink}}">{{svg "dsi-download" 18}}{{ctx.Locale.Tr "repo.download_file"}}</a></li>
								<li><a href="#" id="copy-content" class="{{if not .CanCopyContent}}disabled{{end}}"{{if or .IsImageFile (and .HasSourceRenderedToggle (not .IsDisplayingSource))}} data-link="{{$.RawFileLink}}"{{end}} title="{{if .CanCopyContent}}{{ctx.Locale.Tr "copy_content"}}{{else}}{{ctx.Locale.Tr "copy_type_unsupported"}}{{end}}">{{svg "dsi-copy" 18}}{{ctx.Locale.Tr "copy_content"}}</a></li>
								{{if not .IsViewCommit}}<li><a data-asc-key="y" href="{{.RepoLink}}/src/commit/{{PathEscape .CommitID}}/{{PathEscapeSegments .TreePath}}">{{svg "dsi-link" 18}}{{ctx.Locale.Tr "repo.file_permalink"}}</a></li>{{end}}
								{{if and .EnableFeed .IsViewBranch}}<li><a href="{{$.FeedURL}}/rss/{{$.BranchNameSubURL}}/{{PathEscapeSegments .TreePath}}">{{svg "octicon-rss" 18}}{{ctx.Locale.Tr "rss_feed"}}</a></li>{{end}}
								{{if .SymlinkURL}}<li><a href="{{$.SymlinkURL}}" data-kind="follow-symlink">{{svg "dsi-arrow-right" 18}}{{ctx.Locale.Tr "repo.file_follow"}}</a></li>{{end}}
								{{if and .Repository.CanEnableEditor .CanDeleteFile}}<li><a class="rp-danger" href="{{.RepoLink}}/_delete/{{PathEscapeSegments .BranchName}}/{{PathEscapeSegments .TreePath}}">{{svg "dsi-trash" 18}}{{ctx.Locale.Tr "repo.editor.delete_this_file"}}</a></li>{{end}}
							</ul>
						</div>
					</details>
					{{end}}
					{{if .EscapeStatus.Escaped}}
						<button type="button" class="ds-btn ds-btn-secondary ds-btn-sm unescape-button tw-hidden">{{ctx.Locale.Tr "repo.unescape_control_characters"}}</button>
						<button type="button" class="ds-btn ds-btn-secondary ds-btn-sm escape-button">{{ctx.Locale.Tr "repo.escape_control_characters"}}</button>
					{{end}}
				</div>
			</div>
			{{if .LatestCommit}}
			<div id="repo-file-commit-box" class="rp-sec rp-commitbar">
				<div class="latest-commit rp-latest">{{template "repo/latest_commit" .}}</div>
				<div class="rp-files-last-meta">
					<span class="ds-hide-xs">{{template "repo/shabox" (dict "sha1" .LatestCommit.ID.String "commitLink" (printf "%s/commit/%s" .RepoLink (.LatestCommit.ID.String|PathEscape)) "signature" .LatestCommit.Signature "verification" .LatestCommitVerification)}}</span>
					{{template "repo/commit_statuses" dict "Status" .LatestCommitStatus "Statuses" .LatestCommitStatuses}}
					{{if .LatestCommit.Committer}}<span>{{DateUtils.TimeSince .LatestCommit.Committer.When}}</span>{{end}}
				</div>
			</div>
			{{end}}
			<div data-loading-body>
			{{if .IsViewFile}}
				{{template "repo/view_file" .}}
			{{else}}
				{{template "repo/blame" .}}
			{{end}}
			</div>
			{{template "repo/code_loading"}}
			{{if and .IsViewFile .CanEditFile .Repository.CanEnableEditor}}
			<div class="ds-banner rp-editnote">
				{{svg "dsi-pencil" 18}}
				<div class="ds-banner-body"><b>{{ctx.Locale.Tr "asc_rp.edit_note_title"}}</b> {{if $isAsc}}{{ctx.Locale.Tr "asc_rp.edit_note_body_asc" .BranchName}}{{else}}{{ctx.Locale.Tr "asc_rp.edit_note_body" .BranchName}}{{end}}</div>
				{{if $isAsc}}
				<span class="rp-editnote-acts">
					<a class="ds-btn ds-btn-primary ds-btn-sm" href="{{.RepoLink}}/_edit/{{PathEscapeSegments .BranchName}}/{{PathEscapeSegments .TreePath}}?commit_choice=commit-to-new-branch">{{ctx.Locale.Tr "asc_rp.start_change"}}</a>
					{{if eq (len .AscMyStacks) 1}}
					<a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{(index .AscMyStacks 0).EditLink}}" title="{{(index .AscMyStacks 0).Title}}">{{ctx.Locale.Tr "asc_rp.add_to_stack"}}</a>
					{{else if .AscMyStacks}}
					<details class="dropdown rp-dd rp-addstack">
						<summary class="ds-btn ds-btn-secondary ds-btn-sm">{{ctx.Locale.Tr "asc_rp.add_to_stack"}}</summary>
						<div class="content rp-pop">
							<ul aria-label="{{ctx.Locale.Tr "asc_rp.add_to_stack"}}">
								{{range .AscMyStacks}}<li><a href="{{.EditLink}}">{{.Title}}</a></li>{{end}}
							</ul>
						</div>
					</details>
					{{end}}
				</span>
				{{else}}
				<a class="ds-btn ds-btn-primary ds-btn-sm" href="{{.RepoLink}}/_edit/{{PathEscapeSegments .BranchName}}/{{PathEscapeSegments .TreePath}}">{{ctx.Locale.Tr "asc_rp.edit_file"}}</a>
				{{end}}
			</div>
			{{end}}
		</div>
		<aside class="rp-codeside" aria-label="{{ctx.Locale.Tr "asc_rp.about_file"}}">
			{{template "repo/code_keys" .}}
			{{if .AscOutline}}
			<section class="rp-card rp-outline" aria-labelledby="rp-outline-h" data-testid="code-outline">
				<h2 class="rp-rail-title" id="rp-outline-h">{{ctx.Locale.Tr "asc_rp.outline_title"}}</h2>
				<ul class="rp-outline-list">
					{{range .AscOutline}}
					<li><span class="ds-chip ds-chip-outline">{{.Kind}}</span><a class="ds-mono" href="{{.Link}}">{{.Name}}</a>{{if .Line}}<span class="ds-num ds-c-2">{{.Line}}</span>{{end}}</li>
					{{end}}
				</ul>
				{{if .AscOutlineMore}}<p class="rp-quiet">{{ctx.Locale.Tr "repo.asc_symbols.truncated"}}</p>{{end}}
			</section>
			{{end}}
			{{if .AscUsedIn}}
			<section class="rp-card rp-outline" aria-labelledby="rp-usedin-h" data-testid="code-used-in">
				<h2 class="rp-rail-title" id="rp-usedin-h">{{ctx.Locale.Tr "asc_rp.used_in_title"}}</h2>
				<ul class="rp-outline-list">
					{{range .AscUsedIn}}
					<li><a class="ds-mono" href="{{.Link}}">{{.Name}}</a><span class="ds-num ds-c-2">{{ctx.Locale.TrN .Count "asc_rp.refs_one" "asc_rp.refs_other" .Count}}</span></li>
					{{end}}
				</ul>
			</section>
			{{end}}
			{{if .AscFileChanges}}
			<section class="rp-card" aria-labelledby="rp-filechanges-h" data-testid="code-open-changes">
				<h2 class="rp-rail-title" id="rp-filechanges-h">{{ctx.Locale.Tr "asc_rp.open_changes_file"}}</h2>
				<ul class="rp-outline-list">
					{{range .AscFileChanges}}
					<li><a href="{{.Link}}">{{.Title}}</a><span class="ds-chip ds-chip-outline ds-mono">{{.Stack}}</span></li>
					{{end}}
				</ul>
			</section>
			{{end}}
			<section class="rp-card">
				<h2 class="rp-rail-title">{{ctx.Locale.Tr "asc_rp.about_file"}}</h2>
				{{template "repo/file_info" .}}
			</section>
		</aside>
	</div>
</div>
