<div class="ds-field">
	<span class="ds-label" id="repo_template_label">{{ctx.Locale.Tr "repo.template"}}</span>
	{{/* The Fomantic search dropdown is filled from the repository search by repo-template.js (ids repo_template and repo_template_search) */}}
	<div id="repo_template_search" class="ui search selection dropdown tw-w-full" aria-labelledby="repo_template_label">
		<input type="hidden" id="repo_template" name="repo_template" value="{{if ne .repo_template 0}}{{.repo_template}}{{end}}">
		<div class="default text">{{.repo_template_name}}</div>
		<div class="menu">
		</div>
	</div>
</div>

<fieldset id="template_units" class="ds-fieldset tw-hidden simple-grid grid-2">
	<legend>{{ctx.Locale.Tr "repo.template.items"}}</legend>

	<label class="ds-check">
		<input name="git_content" id="tpl_git_content" type="checkbox" {{if .git_content}}checked{{end}}>
		<span>{{ctx.Locale.Tr "repo.template.git_content"}}</span>
	</label>
	<label class="ds-check">
		<input name="webhooks" type="checkbox" {{if .webhooks}}checked{{end}}>
		<span>{{ctx.Locale.Tr "repo.template.webhooks"}}</span>
	</label>
	<label class="ds-check">
		<input name="topics" type="checkbox" {{if .topics}}checked{{end}}>
		<span>{{ctx.Locale.Tr "repo.template.topics"}}</span>
	</label>
	<label class="ds-check">
		<input name="avatar" type="checkbox" {{if .avatar}}checked{{end}}>
		<span>{{ctx.Locale.Tr "repo.template.avatar"}}</span>
	</label>
	<label class="ds-check">
		<input name="labels" type="checkbox" {{if .labels}}checked{{end}}>
		<span>{{ctx.Locale.Tr "repo.template.issue_labels"}}</span>
	</label>
	<label class="ds-check">
		<input name="protected_branch" type="checkbox" {{if .protected_branch}}checked{{end}}>
		<span>{{ctx.Locale.Tr "repo.settings.protected_branch"}}</span>
	</label>
	<label class="ds-check">
		<input name="git_hooks" type="checkbox" {{if .git_hooks}}checked{{end}}>
		<span>{{ctx.Locale.Tr "repo.template.git_hooks"}}{{if not .SignedUser.CanEditGitHook}} <span class="ds-hint">{{ctx.Locale.Tr "repo.template.git_hooks_tooltip"}}</span>{{end}}</span>
	</label>
</fieldset>
