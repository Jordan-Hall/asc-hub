{{/* Blame: every line says which change wrote it (board Code, blame on). */}}
{{if or .UsesIgnoreRevs .FaultyIgnoreRevsFile}}
	{{$revsFileLink := URLJoin .RepoLink "src" .BranchNameSubURL "/.git-blame-ignore-revs"}}
	{{if .UsesIgnoreRevs}}
		<div class="ds-banner rp-filemsg" role="status">{{svg "dsi-info" 18}}<div class="ds-banner-body">{{ctx.Locale.Tr "repo.blame.ignore_revs" $revsFileLink "?bypass-blame-ignore=true"}}</div></div>
	{{else}}
		<div class="ds-banner ds-banner-err rp-filemsg" role="alert">{{svg "dsi-alert" 18}}<div class="ds-banner-body">{{ctx.Locale.Tr "repo.blame.ignore_revs.failed" $revsFileLink}}</div></div>
	{{end}}
{{end}}
<section class="rp-sec rp-filecard {{TabSizeClass .Editorconfig .FileName}} non-diff-file-content">
	<div class="rp-filebody">
		<div class="file-view code-view unicode-escaped">
			{{if .IsFileTooLarge}}
				{{template "shared/ds/empty" (dict "Icon" "package" "Title" (ctx.Locale.Tr "asc_rp.large_title" .FileName) "Body" (ctx.Locale.Tr "asc_rp.large_body") "PrimaryLabel" (ctx.Locale.Tr "repo.file_raw") "PrimaryHref" $.RawFileLink)}}
			{{else}}
			<div class="rp-codescroll" tabindex="0" role="region" aria-label="{{ctx.Locale.Tr "asc_rp.code_region" .FileName}}">
			<table>
				<tbody>
					{{range $row := .BlameRows}}
						<tr data-heat="{{$row.Heat}}" class="{{if and (gt $.CommitCnt 1) ($row.CommitMessage)}}top-line-blame{{end}}">
							<td class="lines-commit">
								<div class="blame-info">
									<div class="blame-data">
										{{if $row.CommitMessage}}<button type="button" class="blame-avatar rp-blame-open" data-blame-open aria-haspopup="dialog" aria-label="{{ctx.Locale.Tr "asc_rp.blame_who" $row.AuthorName}}">{{$row.Avatar}}</button>{{else}}<div class="blame-avatar">{{$row.Avatar}}</div>{{end}}
										{{if $row.IsAgent}}<span class="ds-chip ds-chip-agent rp-agent-chip">{{ctx.Locale.Tr "asc_rp.agent"}}</span>{{end}}
										<div class="blame-message">
											{{if $row.CommitMessage}}<a class="suppressed" href="{{$row.CommitURL}}" title="{{$row.CommitMessage}}">{{$row.CommitMessage}}</a>{{end}}
										</div>
										{{if $row.CommitMessage}}<a class="blame-sha rp-hash" href="{{$row.CommitURL}}">{{ShortSha $row.PartSha}}</a>{{end}}
										<div class="blame-time">{{$row.CommitSince}}</div>
									</div>
									{{if $row.CommitMessage}}
									<div class="rp-blame-card" role="tooltip">
										<strong class="rp-blame-card-t">{{$row.CommitMessage}}</strong>
										<span class="rp-blame-card-m">{{$row.AuthorName}}{{if $row.IsAgent}} <span class="ds-chip ds-chip-agent">{{ctx.Locale.Tr "asc_rp.agent"}}</span>{{end}} <span class="rp-sep-dot"></span> <span class="rp-hash">{{ShortSha $row.PartSha}}</span> <span class="rp-sep-dot"></span> {{$row.CommitSince}}</span>
										<span class="rp-blame-card-a"><a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{$row.CommitURL}}">{{ctx.Locale.Tr "asc_rp.open_change"}}</a>{{if $row.PreviousSha}} <a class="ds-btn ds-btn-ghost ds-btn-sm" href="{{$row.PreviousShaURL}}">{{ctx.Locale.Tr "repo.blame_prior"}}</a>{{end}}</span>
									</div>
									{{end}}
								</div>
							</td>
							<td class="lines-blame-btn">
								{{if $row.PreviousSha}}
									<a role="button" class="muted" href="{{$row.PreviousShaURL}}" title="{{ctx.Locale.Tr "repo.blame_prior"}}" aria-label="{{ctx.Locale.Tr "repo.blame_prior"}}">{{svg "octicon-versions"}}</a>
								{{end}}
							</td>
							<td class="lines-num">
								<span id="L{{$row.RowNumber}}" data-line-number="{{$row.RowNumber}}"></span>
							</td>
							{{if $.EscapeStatus.Escaped}}
								<td class="lines-escape">
									{{if $row.EscapeStatus.Escaped}}
										<button class="toggle-escape-button btn interact-bg" title="{{template "repo/diff/escape_title" dict "diff" $row}}"></button>
									{{end}}
								</td>
							{{end}}
							<td rel="L{{$row.RowNumber}}" class="lines-code blame-code chroma">
								<code class="code-inner">{{$row.Code}}</code>
							</td>
						</tr>
					{{end}}
				</tbody>
			</table>
			</div>
			<div class="code-line-menu tippy-target">
				{{if $.Permission.CanRead $.UnitTypeIssues}}
					<a class="item ref-in-new-issue" role="menuitem" data-url-issue-new="{{.RepoLink}}/issues/new" data-url-param-body-link="{{.Repository.Link}}/src/commit/{{PathEscape .CommitID}}/{{PathEscapeSegments .TreePath}}{{if $.HasSourceRenderedToggle}}?display=source{{end}}" rel="nofollow noindex">{{ctx.Locale.Tr "repo.issues.context.reference_issue"}}</a>
				{{end}}
				<a class="item copy-line-permalink" role="menuitem" data-url="{{.Repository.Link}}/src/commit/{{PathEscape .CommitID}}/{{PathEscapeSegments .TreePath}}{{if $.HasSourceRenderedToggle}}?display=source{{end}}">{{ctx.Locale.Tr "repo.file_copy_permalink"}}</a>
			</div>
			{{/* the phone sheets: tap an avatar for its change, long-press a line number to select it and share it */}}
			<dialog class="rp-sheet" data-blame-sheet aria-labelledby="rp-blame-sheet-h" data-t-line="{{ctx.Locale.Tr "asc_rp.blame_line" "{a}"}}" data-t-lines="{{ctx.Locale.Tr "asc_rp.blame_lines" "{a}" "{b}"}}" data-testid="blame-sheet">
				<div class="rp-sheet-grip" aria-hidden="true"></div>
				<h2 class="rp-sheet-h" id="rp-blame-sheet-h" data-blame-sheet-h></h2>
				<div class="rp-sheet-b" data-blame-sheet-change hidden></div>
				<div class="rp-sheet-b" data-blame-sheet-line hidden>
					<button type="button" class="ds-btn ds-btn-primary rp-sheet-act" data-blame-share hidden>{{ctx.Locale.Tr "asc_rp.blame_share"}}</button>
					<button type="button" class="ds-btn ds-btn-secondary rp-sheet-act" data-blame-copy>{{ctx.Locale.Tr "repo.file_copy_permalink"}}</button>
					{{if $.Permission.CanRead $.UnitTypeIssues}}<a class="ds-btn ds-btn-secondary rp-sheet-act" data-blame-issue href="{{.RepoLink}}/issues/new" rel="nofollow noindex">{{ctx.Locale.Tr "repo.issues.context.reference_issue"}}</a>{{end}}
				</div>
				<form method="dialog"><button class="ds-btn ds-btn-ghost rp-sheet-act">{{ctx.Locale.Tr "asc_rp.blame_close"}}</button></form>
			</dialog>
			{{end}}
		</div>
	</div>
</section>
