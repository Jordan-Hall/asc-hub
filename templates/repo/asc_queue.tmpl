{{/*
The merge queue of one branch (asc_queue.go).
Template Attributes:
* AscQueue: *automerge.AscQueueView (Branch, Paused, Landing, Active, Recent)
* AscQueueUsers: map of user id to user, for "queued by"
* AscQueueCanAdmin: the viewer may pause and resume
* AscQueueRevalidate: bool, lands carry no_content_merge
* AscQuarantine: *ascQuarantineView or nil (Rows of quarantined failure groups with the note that says why, More, ChecksURL, Problem)
Entry reasons are written by the queue worker from fixed texts and pull request numbers; the template engine escapes them.
*/}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository rv-trust-page">
	{{template "repo/header" .}}
	<div class="rv rv-page" data-testid="asc-queue">
		{{template "base/alert" .}}
		<div class="rv-area">{{template "repo/asc_stack_nav" (dict "Tab" "queue" "Link" .RepoLink)}}</div>
		<header class="rv-head">
			<div class="rv-head-main">
				<div class="rv-eyebrow">{{.Repository.FullName}} · {{ctx.Locale.Tr "asc_review.stack_eyebrow"}}</div>
				<h1 class="rv-title">{{ctx.Locale.Tr "repo.asc_queue.title"}}</h1>
				<p class="rv-lead">{{ctx.Locale.Tr "repo.asc_queue.desc"}}</p>
				<ul class="rv-facts">
					<li><span class="rv-pill {{if .AscQueue.Paused}}rv-pill-warn{{else}}rv-pill-ok{{end}}" data-testid="asc-queue-status">{{if .AscQueue.Paused}}{{ctx.Locale.Tr "repo.asc_queue.status_paused"}}{{else if .AscQueue.Landing}}{{ctx.Locale.Tr "repo.asc_queue.status_landing"}}{{else}}{{ctx.Locale.Tr "repo.asc_queue.status_running"}}{{end}}</span></li>
					<li><span class="rv-pill rv-pill-outline">{{ctx.Locale.Tr "asc_review.queue_branch"}} <code class="rv-bare">{{.AscQueue.Branch}}</code></span></li>
					<li><span class="rv-pill rv-pill-info">{{if .AscQueueRevalidate}}{{ctx.Locale.Tr "asc_review.queue_revalidate_on"}}{{else}}{{ctx.Locale.Tr "asc_review.queue_revalidate_off"}}{{end}}</span></li>
				</ul>
			</div>
			{{if .AscQueueCanAdmin}}
				<div class="rv-acts">
					{{if .AscQueue.Paused}}
						<button class="rv-btn rv-btn-secondary show-modal" type="button" data-modal="#asc-queue-resume-modal">{{ctx.Locale.Tr "repo.asc_queue.resume"}}</button>
					{{else}}
						<button class="rv-btn rv-btn-secondary show-modal" type="button" data-modal="#asc-queue-pause-modal">{{ctx.Locale.Tr "repo.asc_queue.pause"}}</button>
					{{end}}
				</div>
			{{end}}
		</header>

		{{if .AscQueue.Paused}}
			<div class="rv-banner rv-banner-warn" role="status"><div><b>{{ctx.Locale.Tr "repo.asc_queue.paused_done"}}</b> {{ctx.Locale.Tr "repo.asc_queue.pause_confirm"}}</div></div>
		{{end}}

		<div class="rv-stats rv-gap" role="group" aria-label="{{ctx.Locale.Tr "asc_review.queue_stats"}}" data-testid="asc-queue-stats">
			<div class="rv-card rv-stat"><div class="rv-stat-l">{{ctx.Locale.Tr "repo.asc_queue.waiting"}}</div><div class="rv-stat-v" data-q-waiting>{{len .AscQueue.Active}}</div><div class="rv-stat-d">{{if .AscQueueNext}}{{ctx.Locale.Tr "asc_review.queue_next_lands" .AscQueueNext}}{{else}}{{ctx.Locale.Tr "asc_review.queue_in_order"}}{{end}}</div></div>
			<div class="rv-card rv-stat"><div class="rv-stat-l">{{ctx.Locale.Tr "asc_review.queue_landed_today"}}</div><div class="rv-stat-v ag-v-ok">{{.AscQueueLandedToday}}</div><div class="rv-stat-d">{{ctx.Locale.Tr "asc_review.queue_recent_n" (len .AscQueue.Recent)}}</div></div>
			<div class="rv-card rv-stat"><div class="rv-stat-l">{{ctx.Locale.Tr "asc_review.queue_median"}}</div><div class="rv-stat-v" data-q-median>{{if .AscQueueMedian}}{{.AscQueueMedian}}{{else}}&mdash;{{end}}</div><div class="rv-stat-d">{{ctx.Locale.Tr "asc_review.queue_median_help"}}</div></div>
			<div class="rv-card rv-stat"><div class="rv-stat-l">{{ctx.Locale.Tr "asc_review.queue_refused"}}</div><div class="rv-stat-v{{if .AscQueueRefused}} ag-v-warn{{end}}">{{.AscQueueRefused}}</div><div class="rv-stat-d">{{ctx.Locale.Tr "asc_review.queue_refused_help"}}</div></div>
		</div>

		<div class="rv-cols rv-cols-main-side rv-gap">
			<div class="rv-stack">
				<section class="rv-card" aria-labelledby="rv-queue-waiting" data-testid="asc-queue-waiting"{{if .AscQueueLiveURL}} data-asc-queue-live="{{.AscQueueLiveURL}}"{{end}}>
					<div class="rv-card-h"><h2 id="rv-queue-waiting">{{ctx.Locale.Tr "repo.asc_queue.waiting"}}</h2><span class="rv-faint">{{ctx.Locale.Tr "asc_review.queue_in_order"}}</span><span class="rv-count rv-end">{{len .AscQueue.Active}}</span></div>
					{{if .AscQueue.Active}}
						<ol class="rv-queue" data-testid="asc-queue-active">
							{{range .AscQueue.Active}}
								<li class="rv-queue-row" data-q-change="{{.Entry.AscChange}}">
									<span class="rv-queue-pos" aria-label="{{ctx.Locale.Tr "repo.asc_queue.col_position"}}">{{.Position}}</span>
									<div class="rv-queue-main">
										<div class="rv-queue-title">{{if .PR}}<a href="{{.PR.Issue.Link}}">#{{.PR.Issue.Index}} {{.PR.Issue.Title}}</a>{{else}}<span class="rv-muted">{{ctx.Locale.Tr "repo.asc_queue.gone"}}</span>{{end}}</div>
										{{if .Entry.Reason}}<div class="rv-li-sub">{{.Entry.Reason}}</div>{{end}}
										{{with index $.AscQueueTimings .Entry.AscChange}}<div class="rv-li-sub ag-q-eta" data-q-eta>{{if .Detail}}{{.Detail}}{{if .ETA}}, {{ctx.Locale.Tr "asc_review.queue_lands_in" .ETA}}{{end}}{{else if .StartsIn}}{{ctx.Locale.Tr "asc_review.queue_starts_in" .StartsIn}}{{else if .ETA}}{{ctx.Locale.Tr "asc_review.queue_lands_in" .ETA}}{{end}}</div>{{end}}
										<div class="rv-li-meta"><span>{{ctx.Locale.Tr "repo.asc_queue.col_by"}} {{with index $.AscQueueUsers .Entry.DoerID}}{{.GetDisplayName}}{{end}}</span></div>
									</div>
									<div class="rv-queue-state">
										<span class="rv-pill {{if eq .Entry.State "blocked"}}rv-pill-err{{else if eq .Entry.State "landing"}}rv-pill-info{{else}}rv-pill-warn{{end}}">{{ctx.Locale.Tr (printf "repo.pulls.asc_op.state.queued_%s" .Entry.State)}}</span>
									</div>
									{{if and .CanCancel .PR}}<div class="rv-queue-act"><a class="rv-btn rv-btn-secondary rv-btn-sm" href="{{.PR.Issue.Link}}/asc/confirm?op=unqueue">{{ctx.Locale.Tr "repo.pulls.asc_op.unqueue"}}</a>{{if eq .Position 1}}<a class="rv-btn rv-btn-secondary rv-btn-sm" href="{{.PR.Issue.Link}}/asc/confirm?op=merge">{{ctx.Locale.Tr "asc_review.queue_merge_now"}}</a>{{end}}</div>{{end}}
								</li>
							{{end}}
						</ol>
					{{else}}
						<div class="rv-empty rv-empty-flat" data-testid="asc-queue-empty">
							<h3>{{ctx.Locale.Tr "asc_review.queue_empty_title"}}</h3>
							<p>{{ctx.Locale.Tr "repo.asc_queue.empty"}} {{ctx.Locale.Tr "asc_review.queue_empty_help"}}</p>
							<div class="rv-acts"><a class="rv-btn rv-btn-secondary" href="{{.RepoLink}}/pulls">{{ctx.Locale.Tr "asc_review.queue_open_changes"}}</a></div>
						</div>
					{{end}}
				</section>

				{{if .AscQueueStacks}}
				<section class="rv-card" aria-labelledby="asc-queue-stacks-title" data-testid="asc-queue-stacks">
					<div class="rv-card-h"><h2 id="asc-queue-stacks-title">{{ctx.Locale.Tr "repo.asc_queue.merge_stack_title"}}</h2><span class="rv-count rv-end">{{len .AscQueueStacks}}</span></div>
					<p class="rv-card-b rv-muted">{{ctx.Locale.Tr "repo.asc_queue.merge_stack_lead"}}</p>
					<ul class="rv-recent">
						{{range .AscQueueStacks}}
						<li class="rv-recent-row">
							<div class="rv-queue-main">
								<div class="rv-queue-title"><a href="{{.Link}}">#{{.Top.Issue.Index}} {{.Top.Issue.Title}}</a></div>
								<div class="rv-li-sub">{{ctx.Locale.TrN .Changes "repo.asc_queue.merge_stack_n_one" "repo.asc_queue.merge_stack_n_other" .Changes}}</div>
							</div>
							<div class="rv-queue-act">
								{{if .Queued}}<span class="rv-pill rv-pill-warn">{{ctx.Locale.Tr "repo.asc_queue.merge_stack_queued"}}</span>{{else}}<a class="rv-btn rv-btn-secondary rv-btn-sm" href="{{.QueueURL}}">{{ctx.Locale.Tr "repo.pulls.asc_op.queue"}}</a>{{end}}
								<a class="rv-btn rv-btn-secondary rv-btn-sm" href="{{.MergeURL}}">{{ctx.Locale.Tr "asc_review.queue_merge_now"}}</a>
							</div>
						</li>
						{{end}}
					</ul>
				</section>
				{{end}}

				{{with .AscQuarantine}}
				<section class="rv-card" aria-labelledby="asc-queue-quarantine-title">
					<div class="rv-card-h"><h2 id="asc-queue-quarantine-title">{{ctx.Locale.Tr "asc_trust.queue.quarantine_title"}}</h2>{{if .ChecksURL}}<a class="rv-end" href="{{.ChecksURL}}?state=quarantined">{{ctx.Locale.Tr "asc_review.queue_manage_checks"}}</a>{{end}}</div>
					<div class="rv-card-b">
						<p class="rv-muted">{{ctx.Locale.Tr "asc_trust.queue.quarantine_lead"}}</p>
						{{if .Problem}}
							<div class="rv-banner rv-banner-warn rv-gap" role="status" data-testid="asc-queue-quarantine-problem"><div>{{.Problem}}</div></div>
						{{else if .Rows}}
							<ul class="rv-quarantine rv-gap" data-testid="asc-queue-quarantine">
								{{range .Rows}}
									<li class="rv-inset rv-quarantine-row">
										<div class="rv-row rv-row-wrap">
											<a class="rv-quarantine-title" href="{{$.AscQuarantine.ChecksURL}}/groups/{{.ID}}">{{if .Title}}{{.Title}}{{else}}{{.TestName}}{{end}}</a>
											<span class="rv-pill rv-pill-warn rv-end">{{ctx.Locale.Tr "asc_trust.queue.quarantined"}}</span>
										</div>
										<div class="rv-li-sub">
											{{if .TestName}}<code>{{.TestName}}</code>{{end}}{{if .JobName}} {{ctx.Locale.Tr "asc_trust.queue.in_job" .JobName}}{{end}}
											· {{ctx.Locale.Tr "asc_trust.queue.seen" .Occurrences .ChangesAffected}}
											· {{ctx.Locale.Tr "asc_trust.queue.last_seen"}} {{DateUtils.TimeSince .LastSeen}}
										</div>
										<div class="rv-li-sub" data-testid="asc-queue-quarantine-why"><strong>{{ctx.Locale.Tr "asc_trust.queue.why"}}</strong> {{if .Note}}{{.Note}}{{else}}{{ctx.Locale.Tr "asc_trust.queue.no_note"}}{{end}}</div>
									</li>
								{{end}}
							</ul>
							{{if .More}}<p class="rv-gap"><a href="{{.ChecksURL}}?state=quarantined">{{ctx.Locale.Tr "asc_trust.queue.more"}}</a></p>{{end}}
						{{else}}
							<p class="rv-muted rv-gap" data-testid="asc-queue-quarantine-empty">{{ctx.Locale.Tr "asc_trust.queue.quarantine_empty"}}</p>
						{{end}}
					</div>
				</section>
				{{end}}

				{{if .AscQueue.Recent}}
				<section class="rv-card" aria-labelledby="rv-queue-recent">
					<div class="rv-card-h"><h2 id="rv-queue-recent">{{ctx.Locale.Tr "repo.asc_queue.recent"}}</h2></div>
					<ul class="rv-recent" data-testid="asc-queue-recent">
						{{range .AscQueue.Recent}}
							<li class="rv-recent-row">
								<div class="rv-queue-main">
									<div class="rv-queue-title">{{if .PR}}<a href="{{.PR.Issue.Link}}">#{{.PR.Issue.Index}} {{.PR.Issue.Title}}</a>{{else}}<span class="rv-muted">{{ctx.Locale.Tr "repo.asc_queue.gone"}}</span>{{end}}</div>
									{{if .Entry.Reason}}<div class="rv-li-sub">{{.Entry.Reason}}</div>{{end}}
								</div>
								<span class="rv-pill {{if eq .Entry.State "merged"}}rv-pill-ok{{else}}rv-pill-outline{{end}}">{{ctx.Locale.Tr (printf "repo.asc_queue.finished_%s" .Entry.State)}}</span>
								<span class="rv-faint rv-recent-when">{{DateUtils.TimeSince .Entry.UpdatedUnix}}</span>
							</li>
						{{end}}
					</ul>
				</section>
				{{end}}
			</div>

			<aside class="rv-side" aria-label="{{ctx.Locale.Tr "asc_review.queue_safe_title"}}">
				<section class="rv-card">
					<div class="rv-card-h"><h2>{{ctx.Locale.Tr "asc_review.queue_safe_title"}}</h2></div>
					<ul class="rv-card-b rv-bullets">
						<li>{{ctx.Locale.Tr "repo.asc_queue.revalidate_on"}}</li>
						<li>{{ctx.Locale.Tr "asc_review.queue_safe_permission"}}</li>
						<li>{{ctx.Locale.Tr "asc_review.queue_safe_pause"}}</li>
					</ul>
				</section>
			</aside>
		</div>

		{{if .AscQueueCanAdmin}}
		<dialog id="asc-queue-pause-modal">
			<article>
				<header>{{ctx.Locale.Tr "repo.asc_queue.pause"}}</header>
				<div class="content">
					<div class="rv-banner rv-banner-warn"><div>{{ctx.Locale.Tr "repo.asc_queue.pause_confirm"}}</div></div>
				</div>
				<form method="post" action="{{.RepoLink}}/asc/queue/pause">
					{{.CsrfTokenHtml}}
					<input type="hidden" name="branch" value="{{.AscQueue.Branch}}">
					<div class="actions">
						<button type="button" class="rv-btn rv-btn-secondary cancel">{{ctx.Locale.Tr "settings.cancel"}}</button>
						<button type="submit" class="rv-btn rv-btn-primary">{{ctx.Locale.Tr "repo.asc_queue.pause"}}</button>
					</div>
				</form>
			</article>
		</dialog>
		<dialog id="asc-queue-resume-modal">
			<article>
				<header>{{ctx.Locale.Tr "repo.asc_queue.resume"}}</header>
				<div class="content">
					<div class="rv-banner"><div>{{ctx.Locale.Tr "repo.asc_queue.resume_confirm"}}</div></div>
				</div>
				<form method="post" action="{{.RepoLink}}/asc/queue/resume">
					{{.CsrfTokenHtml}}
					<input type="hidden" name="branch" value="{{.AscQueue.Branch}}">
					<div class="actions">
						<button type="button" class="rv-btn rv-btn-secondary cancel">{{ctx.Locale.Tr "settings.cancel"}}</button>
						<button type="submit" class="rv-btn rv-btn-primary">{{ctx.Locale.Tr "repo.asc_queue.resume"}}</button>
					</div>
				</form>
			</article>
		</dialog>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
