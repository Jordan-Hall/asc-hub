{{/*
What a failed call looks like. Only fixed sentences and cleaned details; asc's own text never gets here.
Template Attributes:
* AscAgentsFailure: *ascagentui.Failure
* AscAgentsDisabled: the feature is off (a state to explain, not a fault)
*/}}
{{with .AscAgentsFailure}}
	<div class="rv-banner {{if $.AscAgentsDisabled}}rv-banner-agent{{else}}rv-banner-warn{{end}}" role="{{if $.AscAgentsDisabled}}status{{else}}alert{{end}}" data-testid="asc-agents-notice"{{if .Code}} data-code="{{.Code}}"{{end}}>
		<div>
			<p>{{.Message}}</p>
			{{if .Details}}<ul class="rv-notice-details">{{range .Details}}<li><code>{{.}}</code></li>{{end}}</ul>{{end}}
			{{if not $.AscAgentsDisabled}}<div class="rv-acts"><a class="rv-btn rv-btn-secondary" href="">{{ctx.Locale.Tr "asc_review.try_again"}}</a></div>{{end}}
		</div>
	</div>
{{end}}
