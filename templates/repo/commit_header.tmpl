{{$class := ""}}
{{if .Commit.Signature}}
	{{$class = (print $class " isSigned")}}
	{{if .Verification.Verified}}
		{{if eq .Verification.TrustStatus "trusted"}}
			{{$class = (print $class " isVerified")}}
		{{else if eq .Verification.TrustStatus "untrusted"}}
			{{$class = (print $class " isVerifiedUntrusted")}}
		{{else}}
			{{$class = (print $class " isVerifiedUnmatched")}}
		{{end}}
	{{else if .Verification.Warning}}
		{{$class = (print $class " isWarning")}}
	{{end}}
{{end}}
{{$canWrite := and ($.Permission.CanWrite $.UnitTypeCode) (not $.Repository.IsArchived) (not .IsDeleted)}}
<section class="rp-chead commit-header {{$class}}" aria-label="{{ctx.Locale.Tr "asc_rp.commit_summary"}}">
	<div class="rp-chead-top">
		<div class="rp-chead-main">
			<h3 class="rp-chead-title"><span class="commit-summary" title="{{.Commit.Summary}}">{{RenderCommitMessage $.Context .Commit.Message ($.Repository.ComposeMetas ctx)}}</span></h3>
			<div class="rp-chead-chips">
				{{if and .ChangeWhere .ChangeWhere.OnDefault}}<span class="ds-chip ds-chip-ok">{{ctx.Locale.Tr "asc_rp.landed_chip"}}</span>{{end}}
				{{with .ChangeStack}}<a class="ds-chip" href="{{.PullLink}}">{{.Name}} {{.Position}} / {{.Total}}</a>{{end}}
				{{template "repo/commit_statuses" dict "Status" .CommitStatus "Statuses" .CommitStatuses}}
				{{if .Commit.Signature}}
					{{if .Verification.Verified}}<span class="ds-chip ds-chip-ok">{{ctx.Locale.Tr "asc_rp.verified"}}</span>
					{{else if .Verification.Warning}}<span class="ds-chip ds-chip-warn">{{ctx.Locale.Tr "asc_rp.unverified"}}</span>{{end}}
				{{end}}
			</div>
		</div>
		<div class="rp-chead-acts">
			{{if .PageIsPullFiles}}
				<div class="ds-seg" role="group" aria-label="{{ctx.Locale.Tr "asc_rp.walk_commits"}}">
					{{if .PrevCommitLink}}<a href="{{.PrevCommitLink}}">{{svg "dsi-chevron-left" 16}} {{ctx.Locale.Tr "repo.diff.commit.previous-short"}}</a>{{else}}<a aria-disabled="true">{{svg "dsi-chevron-left" 16}} {{ctx.Locale.Tr "repo.diff.commit.previous-short"}}</a>{{end}}
					{{if .NextCommitLink}}<a href="{{.NextCommitLink}}">{{ctx.Locale.Tr "repo.diff.commit.next-short"}} {{svg "dsi-chevron-right" 16}}</a>{{else}}<a aria-disabled="true">{{ctx.Locale.Tr "repo.diff.commit.next-short"}} {{svg "dsi-chevron-right" 16}}</a>{{end}}
				</div>
			{{else if not $.PageIsWiki}}
				<a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{.SourcePath}}">{{svg "dsi-code" 16}}{{ctx.Locale.Tr "repo.diff.browse_source"}}</a>
				<button type="button" class="ds-btn ds-btn-secondary ds-btn-sm" data-clipboard-text="{{.CommitID}}">{{svg "dsi-copy" 16}}{{ctx.Locale.Tr "asc_rp.copy_id"}}</button>
				{{if $canWrite}}
					<details class="dropdown rp-dd rp-commit-ops">
						<summary class="ds-btn ds-btn-secondary ds-btn-sm">{{ctx.Locale.Tr "repo.commit.operations"}}{{svg "dsi-chevron-down" 16}}</summary>
						<div class="content rp-pop">
							<div class="rp-pop-h">{{ctx.Locale.Tr "repo.commit.operations"}}</div>
							<ul>
								<li><button type="button" class="show-modal" data-modal="#create-branch-modal">{{svg "dsi-branch" 18}}{{ctx.Locale.Tr "repo.branch.create_branch_operation"}}</button></li>
								<li><button type="button" class="show-modal" data-modal="#create-tag-modal">{{svg "dsi-tag" 18}}{{ctx.Locale.Tr "repo.tag.create_tag_operation"}}</button></li>
								<li><button type="button" class="show-modal revert-button"
									data-modal="#cherry-pick-modal"
									data-modal-cherry-pick-type="revert"
									data-modal-cherry-pick-header="{{ctx.Locale.Tr "repo.commit.revert-header" (ShortSha .CommitID)}}"
									data-modal-cherry-pick-content="{{ctx.Locale.Tr "repo.commit.revert-content"}}"
									data-modal-cherry-pick-submit="{{ctx.Locale.Tr "repo.commit.revert"}}">{{svg "dsi-undo" 18}}{{ctx.Locale.Tr "repo.commit.revert"}}</button></li>
								<li><button type="button" class="show-modal cherry-pick-button"
									data-modal="#cherry-pick-modal"
									data-modal-cherry-pick-type="cherry-pick"
									data-modal-cherry-pick-header="{{ctx.Locale.Tr "repo.commit.cherry-pick-header" (ShortSha .CommitID)}}"
									data-modal-cherry-pick-content="{{ctx.Locale.Tr "repo.commit.cherry-pick-content"}}"
									data-modal-cherry-pick-submit="{{ctx.Locale.Tr "repo.commit.cherry-pick"}}">{{svg "dsi-diff" 18}}{{ctx.Locale.Tr "repo.commit.cherry-pick"}}</button></li>
								{{if not .NoteRendered}}
									<li><button type="button" id="commit-notes-add-button">{{svg "dsi-pencil" 18}}{{ctx.Locale.Tr "repo.diff.git-notes.add"}}</button></li>
								{{end}}
							</ul>
						</div>
					</details>
				{{end}}
			{{end}}
		</div>
	</div>
	<div class="rp-chead-meta commit-header-row">
		<span class="rp-chead-who author">
			{{if .Author}}
				{{ctx.AvatarUtils.Avatar .Author 28 "ds-av ds-av-24"}}
				<a href="{{.Author.HomeLink}}"><strong>{{if .Author.FullName}}{{.Author.FullName}}{{else}}{{.Commit.Author.Name}}{{end}}</strong></a>
			{{else}}
				{{ctx.AvatarUtils.AvatarByEmail .Commit.Author.Email .Commit.Author.Email 28 "ds-av ds-av-24"}}
				<strong>{{.Commit.Author.Name}}</strong>
			{{end}}
		</span>
		<span class="rp-dim" id="authored-time">{{DateUtils.TimeSince .Commit.Author.When}}</span>
		{{if or (ne .Commit.Committer.Name .Commit.Author.Name) (ne .Commit.Committer.Email .Commit.Author.Email)}}
			<span class="rp-chead-who author">
				<span class="rp-dim">{{ctx.Locale.Tr "repo.diff.committed_by"}}</span>
				{{if ne .Verification.CommittingUser.ID 0}}
					{{ctx.AvatarUtils.Avatar .Verification.CommittingUser 28 "ds-av ds-av-24"}}
					<a href="{{.Verification.CommittingUser.HomeLink}}"><strong>{{.Commit.Committer.Name}}</strong></a>
				{{else}}
					{{ctx.AvatarUtils.AvatarByEmail .Commit.Committer.Email .Commit.Committer.Name 28 "ds-av ds-av-24"}}
					<strong>{{.Commit.Committer.Name}}</strong>
				{{end}}
			</span>
		{{end}}
		{{if .Parents}}
			<span class="rp-chead-sha">
				<span class="rp-dim">{{ctx.Locale.Tr "repo.diff.parent"}}</span>
				{{range .Parents}}
					<a class="rp-hash primary sha label" href="{{$.RepoLink}}/{{if $.PageIsWiki}}wiki/{{end}}commit/{{PathEscape .}}"><span class="shortsha">{{ShortSha .}}</span></a>
				{{end}}
			</span>
		{{end}}
		<span class="rp-chead-sha">
			<span class="rp-dim">{{ctx.Locale.Tr "repo.diff.commit"}}</span>
			{{if .PageIsPullFiles}}
				<a class="rp-hash primary sha label" href="{{printf "%s/commit/%s" $.RepoLink (PathEscape .CommitID)}}"><span class="shortsha">{{ShortSha .CommitID}}</span></a>
			{{else}}
				<span class="rp-hash primary sha label"><span class="shortsha">{{ShortSha .CommitID}}</span></span>
			{{end}}
		</span>
	</div>
	{{if IsMultilineCommitMessage .Commit.Message}}
		<pre class="commit-body rp-chead-body">{{RenderCommitBody $.Context .Commit.Message ($.Repository.ComposeMetas ctx)}}</pre>
	{{end}}
	{{template "repo/commit_load_branches_and_tags" .}}
</section>
{{if .Commit.Signature}}
	<div class="rp-sig signature-row {{$class}}">
		<div>
			{{if .Verification.Verified}}
				{{if ne .Verification.SigningUser.ID 0}}
					{{svg "dsi-lock" 16 "tw-mr-2"}}
					{{if eq .Verification.TrustStatus "trusted"}}
						<span class="ui text tw-mr-2">{{ctx.Locale.Tr "repo.commits.signed_by"}}:</span>
					{{else if eq .Verification.TrustStatus "untrusted"}}
						<span class="ui text tw-mr-2">{{ctx.Locale.Tr "repo.commits.signed_by_untrusted_user"}}:</span>
					{{else}}
						<span class="ui text tw-mr-2">{{ctx.Locale.Tr "repo.commits.signed_by_untrusted_user_unmatched"}}:</span>
					{{end}}
					{{ctx.AvatarUtils.Avatar .Verification.SigningUser 28 "tw-mr-2"}}
					<a href="{{.Verification.SigningUser.HomeLink}}"><strong>{{.Verification.SigningUser.GetDisplayName}}</strong></a>
				{{else}}
					<span title="{{ctx.Locale.Tr "gpg.default_key"}}">{{svg "gitea-lock-cog" 16 "tw-mr-2"}}</span>
					<span class="ui text tw-mr-2">{{ctx.Locale.Tr "repo.commits.signed_by"}}:</span>
					{{ctx.AvatarUtils.AvatarByEmail .Verification.SigningEmail "" 28 "tw-mr-2"}}
					<strong>{{.Verification.SigningUser.GetDisplayName}}</strong>
				{{end}}
			{{else}}
				{{svg "dsi-lock" 16 "tw-mr-2"}}
				<span class="ui text">{{ctx.Locale.Tr .Verification.Reason}}</span>
			{{end}}
		</div>
		<div>
			{{if .Verification.Verified}}
				{{svg "octicon-verified" 16 "tw-mr-2"}}
				{{if ne .Verification.SigningUser.ID 0}}
					{{if .Verification.SigningSSHKey}}
						<span class="ui text tw-mr-2">{{ctx.Locale.Tr "repo.commits.ssh_key_fingerprint"}}:</span>
						{{.Verification.SigningSSHKey.Fingerprint}}
					{{else}}
						<span class="ui text tw-mr-2">{{ctx.Locale.Tr "repo.commits.gpg_key_id"}}:</span>
						{{.Verification.SigningKey.PaddedKeyID}}
					{{end}}
				{{else}}
					{{if .Verification.SigningSSHKey}}
						<span class="ui text tw-mr-2" data-tooltip-content="{{ctx.Locale.Tr "gpg.default_key"}}">{{ctx.Locale.Tr "repo.commits.ssh_key_fingerprint"}}:</span>
						{{.Verification.SigningSSHKey.Fingerprint}}
					{{else}}
						<span class="ui text tw-mr-2" data-tooltip-content="{{ctx.Locale.Tr "gpg.default_key"}}">{{ctx.Locale.Tr "repo.commits.gpg_key_id"}}:</span>
						{{.Verification.SigningKey.PaddedKeyID}}
					{{end}}
				{{end}}
			{{else if .Verification.Warning}}
				{{svg "octicon-unverified" 16 "tw-mr-2"}}
				{{if .Verification.SigningSSHKey}}
					<span class="ui text tw-mr-2">{{ctx.Locale.Tr "repo.commits.ssh_key_fingerprint"}}:</span>
					{{.Verification.SigningSSHKey.Fingerprint}}
				{{else}}
					<span class="ui text tw-mr-2">{{ctx.Locale.Tr "repo.commits.gpg_key_id"}}:</span>
					{{.Verification.SigningKey.PaddedKeyID}}
				{{end}}
			{{else}}
				{{if .Verification.SigningKey}}
					{{if ne .Verification.SigningKey.KeyID ""}}
						{{svg "octicon-verified" 16 "tw-mr-2"}}
						<span class="ui text tw-mr-2">{{ctx.Locale.Tr "repo.commits.gpg_key_id"}}:</span>
						{{.Verification.SigningKey.PaddedKeyID}}
					{{end}}
				{{end}}
				{{if .Verification.SigningSSHKey}}
					{{if ne .Verification.SigningSSHKey.Fingerprint ""}}
						{{svg "octicon-verified" 16 "tw-mr-2"}}
						<span class="ui text tw-mr-2">{{ctx.Locale.Tr "repo.commits.ssh_key_fingerprint"}}:</span>
						{{.Verification.SigningSSHKey.Fingerprint}}
					{{end}}
				{{end}}
			{{end}}
		</div>
	</div>
{{end}}
{{if .NoteRendered}}
	<section class="rp-note git-notes" aria-label="{{ctx.Locale.Tr "repo.diff.git-notes"}}">
		<div class="rp-note-h">
			<span class="rp-note-title">{{svg "dsi-pencil" 16}}{{ctx.Locale.Tr "repo.diff.git-notes"}}</span>
			<span class="rp-dim">
				{{if .NoteAuthor}}
					<a href="{{.NoteAuthor.HomeLink}}"><strong>{{if .NoteAuthor.FullName}}{{.NoteAuthor.FullName}}{{else}}{{.NoteCommit.Author.Name}}{{end}}</strong></a>
				{{else}}
					<strong>{{.NoteCommit.Author.Name}}</strong>
				{{end}}
				<span id="note-authored-time">{{DateUtils.TimeSince .NoteCommit.Author.When}}</span>
			</span>
			{{if $canWrite}}
				<div class="rp-note-acts">
					<button id="commit-notes-edit-button" type="button" class="ds-btn ds-btn-secondary ds-btn-sm">{{ctx.Locale.Tr "edit"}}</button>
					<button type="button" class="ds-btn ds-btn-danger ds-btn-sm show-modal" data-modal="#delete-note-modal">{{ctx.Locale.Tr "remove"}}</button>
				</div>
			{{end}}
		</div>
		<div id="commit-notes-display-area" class="rp-note-b">
			<pre class="commit-body">{{.NoteRendered | SanitizeHTML}}</pre>
		</div>
	</section>
	{{if $canWrite}}
	<dialog id="delete-note-modal">
		<article>
			<header>{{ctx.Locale.Tr "repo.diff.git-notes.remove-header"}}</header>
			<div class="content">
				<p>{{ctx.Locale.Tr "repo.diff.git-notes.remove-body"}}</p>
			</div>
			<form action="{{.Link}}/notes/remove" method="post">
				{{.CsrfTokenHtml}}
				<div class="actions">
					<button type="button" class="ds-btn ds-btn-secondary cancel">{{ctx.Locale.Tr "settings.cancel"}}</button>
					<button type="submit" class="ds-btn ds-btn-danger-fill">{{ctx.Locale.Tr "remove"}}</button>
				</div>
			</form>
		</article>
	</dialog>
	{{end}}
{{end}}
{{if $canWrite}}
	<section id="commit-notes-edit-area" class="rp-note git-notes tw-hidden" aria-label="{{ctx.Locale.Tr "repo.diff.git-notes"}}">
		<form id="commit-notes-edit-form" class="ds-form rp-note-b" action="{{.Link}}/notes" method="post">
			{{.CsrfTokenHtml}}
			<div class="ds-field">
				<label class="ds-label" for="commit-notes-text">{{ctx.Locale.Tr "repo.diff.git-notes"}}</label>
				<textarea id="commit-notes-text" class="ds-textarea" name="notes">{{.NoteRaw}}</textarea>
			</div>
			<div class="rp-note-acts">
				<button id="commit-notes-cancel-button" type="button" class="ds-btn ds-btn-secondary">{{ctx.Locale.Tr "cancel"}}</button>
				<button id="commit-notes-save-button" type="submit" class="ds-btn ds-btn-primary">{{if .NoteRaw}}{{ctx.Locale.Tr "save"}}{{else}}{{ctx.Locale.Tr "add"}}{{end}}</button>
			</div>
		</form>
	</section>
	{{if not (or .PageIsPullFiles $.PageIsWiki)}}
	<dialog id="cherry-pick-modal">
		<article>
			<header><span id="cherry-pick-header"></span></header>
			<div class="content">
				<p id="cherry-pick-content" class="branch-dropdown"></p>
				{{template "repo/branch_dropdown" dict "root" .
					"noTag" true "disableCreateBranch" true
					"branchForm" "branch-dropdown-form"
					"branchURLPrefix" (printf "%s/_cherrypick/%s/" $.RepoLink .CommitID) "branchURLSuffix" ""
					"setAction" true "submitForm" true}}
			</div>
			<form method="get" action="{{$.RepoLink}}/_cherrypick/{{.CommitID}}/{{PathEscapeSegments $.Repository.DefaultBranch}}" id="branch-dropdown-form">
				<input type="hidden" name="ref" value="{{$.Repository.DefaultBranch}}">
				<input type="hidden" name="refType" value="branch">
				<input type="hidden" id="cherry-pick-type" name="cherry-pick-type">
				<div class="actions">
					<button type="button" class="ds-btn ds-btn-secondary cancel">{{ctx.Locale.Tr "settings.cancel"}}</button>
					<button type="submit" id="cherry-pick-submit" class="ds-btn ds-btn-primary"></button>
				</div>
			</form>
		</article>
	</dialog>
	<dialog id="create-branch-modal">
		<article>
			<header>{{ctx.Locale.Tr "repo.branch.new_branch"}}</header>
			<form class="ds-form" action="{{.RepoLink}}/branches/_new/commit/{{.CommitID}}" method="post">
				{{.CsrfTokenHtml}}
				<div class="content">
					<p>{{ctx.Locale.Tr "repo.branch.new_branch_from" (ShortSha .CommitID)}}</p>
					<div class="ds-field">
						<label class="ds-label" for="new_branch_name">{{ctx.Locale.Tr "repo.branch.name"}}</label>
						<input id="new_branch_name" class="ds-input" name="new_branch_name" required autocomplete="off">
					</div>
				</div>
				<div class="actions">
					<button type="button" class="ds-btn ds-btn-secondary cancel">{{ctx.Locale.Tr "settings.cancel"}}</button>
					<button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "repo.branch.confirm_create_branch"}}</button>
				</div>
			</form>
		</article>
	</dialog>
	<dialog id="create-tag-modal">
		<article>
			<header>{{ctx.Locale.Tr "repo.tag.create_tag_operation"}}</header>
			<form class="ds-form" action="{{.RepoLink}}/branches/_new/commit/{{.CommitID}}" method="post">
				{{.CsrfTokenHtml}}
				<div class="content">
					<input type="hidden" name="create_tag" value="true">
					<p>{{ctx.Locale.Tr "repo.tag.create_tag_from" (ShortSha .CommitID)}}</p>
					<div class="ds-field">
						<label class="ds-label" for="new_tag_name">{{ctx.Locale.Tr "repo.release.tag_name"}}</label>
						<input id="new_tag_name" class="ds-input" name="new_branch_name" required autocomplete="off">
					</div>
				</div>
				<div class="actions">
					<button type="button" class="ds-btn ds-btn-secondary cancel">{{ctx.Locale.Tr "settings.cancel"}}</button>
					<button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "repo.tag.confirm_create_tag"}}</button>
				</div>
			</form>
		</article>
	</dialog>
	{{end}}
{{end}}
