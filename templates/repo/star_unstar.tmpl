{{/* The star control of the repository title row. htmx swaps the form itself. */}}
<form class="rp-actg" hx-target="this" hx-post="{{$.RepoLink}}/action/{{if $.IsStaringRepo}}un{{end}}star" hx-on::after-settle="this.querySelector('button').focus()" method="post" action="{{$.RepoLink}}/action/{{if $.IsStaringRepo}}un{{end}}star">
	<button type="submit" class="rp-act"{{if not $.IsSigned}} disabled title="{{ctx.Locale.Tr "repo.star_guest_user"}}"{{end}} aria-pressed="{{if $.IsStaringRepo}}true{{else}}false{{end}}">
		{{if $.IsStaringRepo}}{{svg "octicon-star-fill" 16}}<span class="rp-act-text">{{ctx.Locale.Tr "repo.unstar"}}</span>{{else}}{{svg "octicon-star" 16}}<span class="rp-act-text">{{ctx.Locale.Tr "repo.star"}}</span>{{end}}
	</button>
	<a hx-boost="false" class="ds-count" href="{{$.RepoLink}}/stars" aria-label="{{ctx.Locale.TrPluralString .Repository.NumStars "stars.n_stars" (printf "%d" .Repository.NumStars)}}">{{CountFmt .Repository.NumStars}}</a>
</form>
