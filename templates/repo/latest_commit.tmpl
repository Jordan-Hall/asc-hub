{{if not .LatestCommit}}
	<span class="rp-sk" aria-hidden="true"></span><span class="ds-sr">{{ctx.Locale.Tr "asc_rp.loading"}}</span>
{{else}}
	{{if .LatestCommitUser}}
		{{ctx.AvatarUtils.Avatar .LatestCommitUser 24 "ds-avatar"}}
		{{if and .LatestCommitUser.FullName DefaultShowFullName}}
			<a class="rp-author ds-hide-xs" title="{{.LatestCommitUser.FullName}}" href="{{.LatestCommitUser.HomeLink}}">{{.LatestCommitUser.FullName}}</a>
		{{else}}
			<a class="rp-author ds-hide-xs" title="{{if .LatestCommit.Author}}{{.LatestCommit.Author.Name}}{{else}}{{.LatestCommitUser.Name}}{{end}}" href="{{.LatestCommitUser.HomeLink}}">{{if .LatestCommit.Author}}{{.LatestCommit.Author.Name}}{{else}}{{.LatestCommitUser.Name}}{{end}}</a>
		{{end}}
	{{else}}
		{{if .LatestCommit.Author}}
			{{ctx.AvatarUtils.AvatarByEmail .LatestCommit.Author.Email .LatestCommit.Author.Name 24 "ds-avatar"}}
			<span class="rp-author ds-hide-xs" title="{{.LatestCommit.Author.Name}}">{{.LatestCommit.Author.Name}}</span>
		{{end}}
	{{end}}
	{{$commitLink:= printf "%s/commit/%s" .RepoLink (PathEscape .LatestCommit.ID.String)}}
	<span class="rp-commit-msg" title="{{.LatestCommit.Summary}}"><span class="message-wrapper">{{RenderCommitMessageLinkSubject $.Context .LatestCommit.Message $commitLink ($.Repository.ComposeMetas ctx)}}</span>
		{{if IsMultilineCommitMessage .LatestCommit.Message}}
			<button type="button" class="rp-ellipsis js-toggle-commit-body" aria-expanded="false" aria-label="{{ctx.Locale.Tr "asc_rp.show_body"}}">&hellip;</button>
			<pre class="rp-commit-body commit-body tw-hidden">{{RenderCommitBody $.Context .LatestCommit.Message ($.Repository.ComposeMetas ctx)}}</pre>
		{{end}}
	</span>
{{end}}
