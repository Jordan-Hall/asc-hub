<h4 class="ui top attached header">
	{{ctx.Locale.Tr "packages.owner.settings.cargo.title"}}
</h4>
<div class="ui attached segment">
	<div class="ui form">
		<div class="ds-field">
			<label>{{ctx.Locale.Tr "packages.registry.documentation" "Cargo" "https://forgejo.org/docs/latest/user/packages/cargo/"}}</label>
		</div>
		{{if .CargoIndexExists}}
		<form class="ds-field" action="{{.Link}}/cargo/rebuild" method="post">
			<button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "packages.owner.settings.cargo.rebuild"}}</button>
		</form>
		<div class="ds-field">
			<label>{{ctx.Locale.Tr "packages.owner.settings.cargo.rebuild.description"}}</label>
		</div>
		{{else}}
		<form class="ds-field" action="{{.Link}}/cargo/initialize" method="post">
			<button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "packages.owner.settings.cargo.initialize"}}</button>
		</form>
		<div class="ds-field">
			<label>{{ctx.Locale.Tr "packages.owner.settings.cargo.initialize.description"}}</label>
		</div>
		{{end}}
	</div>
</div>
