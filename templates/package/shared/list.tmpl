{{/* The packages of an owner or a repository: search, type chips with counts, one row per package version. */}}
<div class="wk-packages">
{{template "base/alert" .}}
{{if .PackagesLoadFailed}}
<div class="ds-card" role="alert" data-testid="packages-error">
	{{template "shared/ds/empty" (dict "Icon" "alert" "Tone" "err" "Title" (ctx.Locale.Tr "asc_work.pk_err_title") "Body" (ctx.Locale.Tr "asc_work.pk_err_body" .RequestID) "PrimaryLabel" (ctx.Locale.Tr "asc_err.try_again") "PrimaryHref" .RetryLink "SecondaryLabel" (ctx.Locale.Tr "asc_err.status_page") "SecondaryHref" (print AppSubUrl "/-/status") "SecondaryGhost" true)}}
</div>
{{else}}
{{if .HasPackages}}
<div class="wk-pkg-filter">
	<form class="ui form ignore-dirty wk-search" role="search">
		<div class="ui small fluid action input wk-pkg-search">
			{{template "shared/search/input" dict "Value" .Query "Placeholder" (ctx.Locale.Tr "search.package_kind")}}
			{{if and .PackageType (ne .PackageType "all")}}<input type="hidden" name="type" value="{{.PackageType}}">{{end}}
			{{template "shared/search/button"}}
		</div>
	</form>
	<nav class="wk-pkg-types" aria-label="{{ctx.Locale.Tr "packages.filter.type"}}" data-testid="package-type-chips">
		{{$all := or (not .PackageType) (eq .PackageType "all")}}
		<a class="ds-chip-btn" href="?q={{QueryEscape .Query}}"{{if $all}} aria-current="true"{{end}}>{{ctx.Locale.Tr "packages.filter.type.all"}} <span class="ds-count">{{.PackageCountAll}}</span></a>
		{{range .PackageTypeCounts}}
			<a class="ds-chip-btn" href="?q={{QueryEscape $.Query}}&type={{.Type}}"{{if eq $.PackageType (print .Type)}} aria-current="true"{{end}}>{{.Type.Name}} <span class="ds-count">{{.Count}}</span></a>
		{{end}}
	</nav>
</div>
{{end}}
{{if .PackageDescriptors}}
<ul class="ds-list wk-rows">
	{{range .PackageDescriptors}}
		<li class="ds-li wk-row">
			<span class="ds-li-av" aria-hidden="true">{{svg .Package.Type.SVGName 24}}</span>
			<div class="ds-li-main">
				<div class="ds-li-title"><a class="tw-break-anywhere" href="{{.VersionWebLink}}">{{.Package.Name}}</a>
					<span class="ds-chip">{{.Package.Type.Name}}</span>
					<span class="ds-chip ds-mono">{{.Version.Version}}</span>
				</div>
				<div class="ds-li-sub">
					{{$timeStr := DateUtils.TimeSince .Version.CreatedUnix}}
					{{$hasRepositoryAccess := false}}
					{{if .Repository}}
						{{$hasRepositoryAccess = index $.RepositoryAccessMap .Repository.ID}}
					{{end}}
					{{if $hasRepositoryAccess}}
						{{ctx.Locale.Tr "packages.published_by_in" $timeStr .Creator.HomeLink .Creator.GetDisplayName .Repository.Link .Repository.FullName}}
					{{else}}
						{{ctx.Locale.Tr "packages.published_by" $timeStr .Creator.HomeLink .Creator.GetDisplayName}}
					{{end}}
				</div>
			</div>
			<div class="ds-li-stat"><b>{{.Version.DownloadCount}}</b><span>{{ctx.Locale.Tr "asc_work.pk_downloads"}}</span></div>
		</li>
	{{end}}
</ul>
{{else}}
	{{if not .HasPackages}}
		{{$body := ctx.Locale.Tr "packages.empty.documentation" "https://forgejo.org/docs/latest/user/packages/"}}
		{{template "shared/ds/empty" (dict "Icon" "package" "Title" (ctx.Locale.Tr "packages.empty") "Body" $body)}}
		{{if and .Repository .CanWritePackages}}
			{{$packagesUrl := URLJoin .Owner.HomeLink "-" "packages"}}
			<p class="ds-hint wk-quiet">{{ctx.Locale.Tr "packages.empty.repo" $packagesUrl}}</p>
		{{end}}
	{{else}}
		{{template "shared/ds/empty" (dict "Icon" "search" "Title" (ctx.Locale.Tr "packages.filter.no_result"))}}
	{{end}}
{{end}}
{{template "base/paginate" .}}
{{end}}
</div>
