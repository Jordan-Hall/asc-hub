{{$canWriteProject := and .CanWriteProjects (or (not .Repository) (not .Repository.IsArchived))}}

<div class="ds-container wk-pv-head">
	<div class="wk-head">
		<div class="wk-head-text">
			<h1 class="ds-t-h1 wk-title tw-break-anywhere">{{.Project.Title}}</h1>
			{{if .Project.IsClosed}}<span class="ds-chip">{{ctx.Locale.Tr "repo.issues.closed_title"}}</span>{{end}}
		</div>
		{{if $canWriteProject}}
			<div class="wk-head-btns">
				<a class="ds-btn ds-btn-secondary" href="{{.Link}}/edit?redirect=project">{{ctx.Locale.Tr "repo.issues.label_edit"}}</a>
				{{if .Project.IsClosed}}
					<button class="ds-btn ds-btn-secondary link-action" data-url="{{.Link}}/open">{{ctx.Locale.Tr "repo.projects.open"}}</button>
				{{else}}
					<button class="ds-btn ds-btn-secondary link-action" data-url="{{.Link}}/close">{{ctx.Locale.Tr "repo.projects.close"}}</button>
				{{end}}
				<button class="ds-btn ds-btn-danger delete-button" data-url="{{.Link}}/delete" data-id="{{.Project.ID}}" data-modal-id="delete-project">{{ctx.Locale.Tr "repo.issues.label_delete"}}</button>
				<button class="ds-btn ds-btn-primary show-modal" data-modal="#new-project-column-item">{{ctx.Locale.Tr "new_project_column"}}</button>
			</div>
		{{end}}
	</div>
	{{if $canWriteProject}}
		<dialog id="new-project-column-item">
			<article>
				<header>{{ctx.Locale.Tr "repo.projects.column.new"}}</header>
				<form class="ui form ds-form">
					<div class="content">
						<div class="required ds-field">
							<label for="new_project_column">{{ctx.Locale.Tr "repo.projects.column.new_title"}}</label>
							<input class="new-project-column" id="new_project_column" name="title" required>
						</div>

						<div class="ds-field color-field">
							<label for="new_project_column_color_picker">{{ctx.Locale.Tr "repo.projects.column.color"}}</label>
							<div class="js-color-picker-input column">
								<input class="ds-input" maxlength="7" placeholder="#c320f6" id="new_project_column_color_picker" name="color">
								{{template "repo/issue/label_precolors"}}
							</div>
						</div>
					</div>
					<div class="actions">
						<button type="button" class="ui cancel button">{{ctx.Locale.Tr "settings.cancel"}}</button>
						<button data-url="{{$.Link}}" class="ds-btn ds-btn-primary" id="new_project_column_submit">{{ctx.Locale.Tr "repo.projects.column.new_submit"}}</button>
					</div>
				</form>
			</article>
		</dialog>
	{{end}}
	{{if $.Project.RenderedContent}}<div class="content markup wk-pv-desc">{{$.Project.RenderedContent}}</div>{{end}}
	{{if or .SwitchProjects $canWriteProject}}
		<div class="wk-pv-tools">
			{{if .SwitchProjects}}
				<details class="wk-pv-switch" data-testid="project-switch">
					<summary class="ds-btn ds-btn-secondary ds-btn-sm">{{svg "dsi-layers" 16}}{{ctx.Locale.Tr "asc_work.pj_switch"}}{{svg "dsi-chevron-down" 14}}</summary>
					<ul class="wk-pv-menu" aria-label="{{ctx.Locale.Tr "asc_work.pj_switch"}}">
						{{range .SwitchProjects}}<li><a class="wk-pv-menu-item" href="{{.Link ctx}}">{{.Title}}</a></li>{{end}}
					</ul>
				</details>
			{{end}}
			{{if $canWriteProject}}
				<button type="button" class="ds-btn ds-btn-primary ds-btn-sm show-modal" data-modal="#project-add-card" data-testid="project-add-card">{{svg "dsi-plus" 16}}{{ctx.Locale.Tr "asc_work.pj_add_card"}}</button>
			{{end}}
		</div>
	{{end}}
	{{if $canWriteProject}}
		<dialog id="project-add-card">
			<article>
				<header>{{ctx.Locale.Tr "asc_work.pj_add_card"}}</header>
				<form class="ds-form project-add-card-form" data-url="{{$.Link}}/cards">
					<div class="content">
						<div class="ds-field">
							<label for="project-add-card-ref">{{ctx.Locale.Tr "asc_work.pj_card_ref"}}</label>
							<input class="ds-input" id="project-add-card-ref" name="ref" required autocomplete="off" placeholder="{{if $.Repository}}#12{{else}}repo#12{{end}}" aria-describedby="project-add-card-hint project-add-card-err">
							<p class="ds-hint" id="project-add-card-hint">{{if $.Repository}}{{ctx.Locale.Tr "asc_work.pj_card_ref_hint_repo"}}{{else}}{{ctx.Locale.Tr "asc_work.pj_card_ref_hint_owner"}}{{end}}</p>
							<p class="ds-err-msg" id="project-add-card-err" role="alert" data-failed="{{ctx.Locale.Tr "asc_work.pj_card_failed" "{id}"}}" data-failed-no-id="{{ctx.Locale.Tr "asc_work.pj_card_failed_no_id"}}" hidden></p>
						</div>
					</div>
					<div class="actions">
						<button type="button" class="ui cancel button">{{ctx.Locale.Tr "settings.cancel"}}</button>
						<button type="submit" class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "asc_work.pj_add_card_submit"}}</button>
					</div>
				</form>
			</article>
		</dialog>
	{{end}}
</div>

<div id="project-board"{{if $canWriteProject}} data-moved="{{ctx.Locale.Tr "asc_work.pj_moved" "{card}" "{column}"}}" data-move-failed="{{ctx.Locale.Tr "asc_work.pj_move_failed" "{card}" "{id}"}}" data-move-failed-no-id="{{ctx.Locale.Tr "asc_work.pj_move_failed_no_id" "{card}"}}" data-moving="{{ctx.Locale.Tr "asc_work.pj_moving" "{card}" "{column}"}}" data-column-failed="{{ctx.Locale.Tr "asc_work.pj_column_failed" "{id}"}}" data-column-failed-no-id="{{ctx.Locale.Tr "asc_work.pj_column_failed_no_id"}}"{{end}}>
	<p id="project-board-status" class="ds-sr" role="status" aria-live="polite" data-testid="project-board-status"></p>
	<div class="ds-container">
		<div id="project-board-error" class="ds-banner ds-banner-err wk-pv-error" role="alert" data-testid="project-board-error" hidden>
			{{svg "dsi-alert" 18}}<p class="ds-banner-body"></p>
			<button type="button" class="ds-btn ds-btn-ghost ds-btn-sm ds-banner-close" aria-label="{{ctx.Locale.Tr "asc_work.pj_error_dismiss"}}">{{svg "dsi-x" 16}}</button>
		</div>
		{{if not .ProjectCardCount}}
			<div class="ds-card wk-pv-empty" data-testid="project-board-empty">
				{{$body := ctx.Locale.Tr "asc_work.pj_board_empty_read"}}{{if $canWriteProject}}{{$body = ctx.Locale.Tr "asc_work.pj_board_empty_body"}}{{end}}
				{{template "shared/ds/empty" (dict "Icon" "columns" "Title" (ctx.Locale.Tr "asc_work.pj_board_empty") "Body" $body)}}
			</div>
		{{end}}
	</div>
	{{$hidden := 0}}{{range .Columns}}{{if .Hidden}}{{$hidden = 1}}{{end}}{{end}}
	{{if $hidden}}
		<div class="ds-container wk-pv-hidden" data-testid="project-hidden-columns">
			<span class="ds-t-meta">{{ctx.Locale.Tr "asc_work.pj_hidden_columns"}}</span>
			{{range .Columns}}{{if .Hidden}}
				<span class="ds-chip wk-pv-hidden-col">
					{{.Title}} <span class="ds-t-meta">{{ctx.Locale.TrN (len (index $.IssuesMap .ID)) "asc_work.pj_cards_one" "asc_work.pj_cards_other" (len (index $.IssuesMap .ID))}}</span>
					{{if $canWriteProject}}<button type="button" class="ds-btn ds-btn-ghost ds-btn-sm project-column-visibility" data-url="{{$.Link}}/{{.ID}}/hidden" data-hidden="false" data-testid="project-column-show">{{ctx.Locale.Tr "asc_work.pj_show_column"}}</button>{{end}}
				</span>
			{{end}}{{end}}
		</div>
	{{end}}
	<div class="board {{if $canWriteProject}}sortable{{end}}"{{if $canWriteProject}} data-url="{{$.Link}}/move"{{end}}>
		{{range .Columns}}{{if not .Hidden}}
			<div class="project-column"{{if .Color}} style="background: {{.Color}} !important; color: {{ContrastColor .Color}} !important"{{end}} data-id="{{.ID}}" data-sorting="{{.Sorting}}" data-url="{{$.Link}}/{{.ID}}">
				<div class="project-column-header{{if $canWriteProject}} tw-cursor-grab{{end}}">
					<div class="ds-chip project-column-title tw-py-1">
						<div class="ds-chip ds-chip-outline project-column-issue-count">
							{{len (index $.IssuesMap .ID)}}
						</div>
						<span class="project-column-title-label">{{.Title}}</span>
					</div>
					{{if $canWriteProject}}
						<div class="ui dropdown jump item">
							<div class="tw-px-2">
								{{svg "octicon-kebab-horizontal"}}
							</div>
							<div class="menu user-menu">
								<a class="item show-modal button" data-modal="#edit-project-column-modal-{{.ID}}">
									{{svg "octicon-pencil"}}
									{{ctx.Locale.Tr "repo.projects.column.edit"}}
								</a>
								{{if not .Default}}
									<a class="item project-column-visibility" role="button" tabindex="0" data-url="{{$.Link}}/{{.ID}}/hidden" data-hidden="true" data-testid="project-column-hide">
										{{svg "octicon-eye-closed"}}
										{{ctx.Locale.Tr "asc_work.pj_hide_column"}}
									</a>
									<a class="item show-modal button default-project-column-show"
										data-modal="#default-project-column-modal-{{.ID}}"
										data-modal-default-project-column-header="{{ctx.Locale.Tr "repo.projects.column.set_default"}}"
										data-modal-default-project-column-content="{{ctx.Locale.Tr "repo.projects.column.set_default_desc"}}"
										data-url="{{$.Link}}/{{.ID}}/default">
										{{svg "octicon-pin"}}
										{{ctx.Locale.Tr "repo.projects.column.set_default"}}
									</a>
									<a class="item show-modal button show-delete-project-column-modal"
										data-modal="#delete-project-column-modal-{{.ID}}"
										data-url="{{$.Link}}/{{.ID}}">
										{{svg "octicon-trash"}}
										{{ctx.Locale.Tr "repo.projects.column.delete"}}
									</a>
								{{end}}

								<dialog class="edit-project-column-modal" id="edit-project-column-modal-{{.ID}}">
									<article>
										<header>{{ctx.Locale.Tr "repo.projects.column.edit"}}</header>
										<form class="ui form ds-form">
											<div class="content">
												<div class="required ds-field">
													<label for="new_project_column_title">{{ctx.Locale.Tr "repo.projects.column.edit_title"}}</label>
													<input class="project-column-title-input" id="new_project_column_title" name="title" value="{{.Title}}" required>
												</div>

												<div class="ds-field color-field">
													<label for="new_project_column_color">{{ctx.Locale.Tr "repo.projects.column.color"}}</label>
													<div class="js-color-picker-input column">
														<input class="ds-input" maxlength="7" placeholder="#c320f6" id="new_project_column_color" name="color" value="{{.Color}}">
														{{template "repo/issue/label_precolors"}}
													</div>
												</div>

											</div>
											<div class="actions">
												<button type="button" class="ui cancel button">{{ctx.Locale.Tr "settings.cancel"}}</button>
												<button data-url="{{$.Link}}/{{.ID}}" class="ds-btn ds-btn-primary edit-project-column-button">{{ctx.Locale.Tr "repo.projects.column.edit"}}</button>
											</div>
										</form>
									</article>
								</dialog>

								<dialog class="default-project-column-modal" id="default-project-column-modal-{{.ID}}">
									<article>
										<header><span id="default-project-column-header"></span></header>
										<div class="content">
											<label id="default-project-column-content"></label>
										</div>
										{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm")}}
									</article>
								</dialog>

								<dialog id="delete-project-column-modal-{{.ID}}">
									<article>
										<header>{{ctx.Locale.Tr "repo.projects.column.delete"}}</header>
										<div class="content">
											<label>
												{{ctx.Locale.Tr "repo.projects.column.deletion_desc"}}
											</label>
										</div>
										{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm")}}
									</article>
								</dialog>
							</div>
						</div>
					{{end}}
				</div>
				<div class="divider"{{if .Color}} style="color: {{ContrastColor .Color}} !important"{{end}}></div>
				<div class="ui cards" data-url="{{$.Link}}/{{.ID}}" data-project="{{$.Project.ID}}" data-board="{{.ID}}" id="board_{{.ID}}">
					{{range (index $.IssuesMap .ID)}}
						<div class="issue-card tw-break-anywhere {{if $canWriteProject}}tw-cursor-grab{{end}}" data-issue="{{.ID}}">
							{{template "repo/issue/card" (dict "Issue" . "Page" $)}}
							{{if $canWriteProject}}
								<button type="button" class="ds-btn ds-btn-ghost ds-btn-sm project-card-move" aria-haspopup="menu" aria-expanded="false" data-testid="project-card-move" aria-label="{{ctx.Locale.Tr "asc_work.pj_move_label" .Title}}">{{svg "dsi-columns" 14}}<span>{{ctx.Locale.Tr "asc_work.pj_move"}}</span></button>
							{{end}}
						</div>
					{{end}}
				</div>
			</div>
		{{end}}{{end}}
	</div>
</div>

{{if $canWriteProject}}
	<div class="ui g-modal-confirm delete modal" id="delete-project">
		<div class="header">
			{{svg "octicon-trash"}}
			{{ctx.Locale.Tr "repo.projects.deletion"}}
		</div>
		<div class="content">
			<p>{{ctx.Locale.Tr "repo.projects.deletion_desc"}}</p>
		</div>
		{{template "base/modal_actions_confirm" .}}
	</div>
{{end}}
