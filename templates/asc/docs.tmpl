{{/* The documentation start page (board Docs, Mobile-Docs). Route GET /-/docs, with ?q= for the search. The guides ship inside the hub (services/ascdocs). */}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="ds-main ds-land site site-docs">
	<section class="ds-land-hero site-hero" aria-labelledby="docs-title">
		<div class="ds-container">
			<p class="ds-t-eyebrow ds-land-eyebrow-dark">{{ctx.Locale.Tr "asc_site.docs_eyebrow"}}</p>
			<h1 class="ds-land-title" id="docs-title">{{ctx.Locale.Tr "asc_site.docs_h1"}}</h1>
			<p class="ds-land-lead">{{ctx.Locale.Tr "asc_site.docs_lead"}}</p>
			<form class="site-docsearch" role="search" method="get" action="{{AppSubUrl}}/-/docs">
				<div class="ds-inwrap">
					{{svg "dsi-search" 16}}
					<label class="ds-sr" for="docs-q">{{ctx.Locale.Tr "asc_site.docs_search"}}</label>
					<input id="docs-q" class="ds-input" type="search" name="q" value="{{.DocsQuery}}" maxlength="100" autocomplete="off" spellcheck="false" placeholder="{{ctx.Locale.Tr "asc_site.docs_search"}}">
				</div>
			</form>
			{{if .DocsPopular}}
				<p class="site-popular"><span>{{ctx.Locale.Tr "asc_site.docs_popular"}}</span>
					{{range .DocsPopular}}<a class="ds-chip ds-chip-outline" href="{{AppSubUrl}}/-/docs?q={{QueryEscape .}}">{{.}}</a>{{end}}
				</p>
			{{end}}
		</div>
	</section>

	{{if .DocsSearched}}
	<section class="ds-land-sec" aria-labelledby="docs-results">
		<div class="ds-container">
			<h2 class="ds-t-h3" id="docs-results">{{ctx.Locale.Tr "asc_site.docs_results" .DocsQuery}}</h2>
			{{if .DocsHits}}
				<ul class="site-hits">
					{{range .DocsHits}}
						<li class="ds-card"><div class="ds-card-b"><a class="ds-t-h4" href="{{AppSubUrl}}/-/docs/{{.Page.Slug}}">{{.Page.Title}}</a><p class="ds-c-2 ds-mt-8">{{.Snippet}}</p></div></li>
					{{end}}
				</ul>
			{{else}}
				<p class="ds-t-body" role="status">{{ctx.Locale.Tr "asc_site.docs_none"}}</p>
			{{end}}
		</div>
	</section>
	{{end}}

	<section class="ds-land-sec" aria-label="{{ctx.Locale.Tr "asc_site.docs_title"}}">
		<div class="ds-container">
			<ul class="site-doccards">
				{{range .DocsPages}}
					<li><a class="ds-card ds-card-link site-doccard" href="{{AppSubUrl}}/-/docs/{{.Slug}}"><span class="ds-card-b"><b class="ds-t-h4">{{.Title}}</b><span class="ds-c-2 ds-t-small">{{.Summary}}</span></span></a></li>
				{{end}}
			</ul>
		</div>
	</section>

	<section class="ds-land-sec ds-land-sec-flush" aria-label="{{ctx.Locale.Tr "asc_site.docs_install_h"}}">
		<div class="ds-container site-two site-two-wide">
			{{if .DocsNew}}
			<article class="ds-card">
				<div class="ds-card-h"><h2 class="ds-t-h4">{{ctx.Locale.Tr "asc_site.docs_new"}}</h2></div>
				<ul class="ds-list">
					{{range .DocsNew}}
						<li class="ds-li"><div class="ds-li-main"><span class="ds-chip ds-chip-outline">{{.Kind}}</span> <a class="ds-li-title" href="{{AppSubUrl}}/-/docs/{{.Slug}}">{{.Title}}</a><div class="ds-li-sub">{{.Summary}}</div></div><time class="ds-t-small ds-c-2" datetime="{{.Date}}">{{.Date}}</time></li>
					{{end}}
				</ul>
			</article>
			{{end}}
			<aside class="ds-callout site-help" aria-labelledby="docs-help">
				<h2 class="ds-t-h4" id="docs-help">{{ctx.Locale.Tr "asc_site.docs_help_h"}}</h2>
				<p class="ds-c-2 ds-mt-8">{{ctx.Locale.Tr "asc_site.docs_help_t"}}</p>
				<p class="ds-mt-12"><a class="ds-btn ds-btn-secondary" href="https://github.com/Jordan-Hall/asc-hub/issues" target="_blank" rel="noopener noreferrer">{{ctx.Locale.Tr "asc_site.docs_help_issue"}}</a></p>
			</aside>
		</div>
	</section>
	<section class="ds-land-sec ds-land-sec-flush">
		<div class="ds-container">
			<article class="ds-card"><div class="ds-card-b">
				<h2 class="ds-t-h3">{{ctx.Locale.Tr "asc_site.docs_install_h"}}</h2>
				<p class="ds-c-2 ds-mt-8">{{ctx.Locale.Tr "asc_site.docs_install_t"}}</p>
				<div class="ds-row ds-row-wrap ds-gap-8 ds-mt-16">
					<a class="ds-btn ds-btn-primary" href="{{AppSubUrl}}/download">{{ctx.Locale.Tr "asc_site.about_download"}}</a>
					<a class="ds-btn ds-btn-secondary" href="{{AppSubUrl}}/-/docs/why">{{ctx.Locale.Tr "asc_site.docs_why_h"}}</a>
				</div>
			</div></article>
		</div>
	</section>
</div>
{{template "base/footer" .}}
