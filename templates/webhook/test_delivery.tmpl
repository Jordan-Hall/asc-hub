{{/* Send a fake event to a repository webhook; the page reloads on its Recent deliveries a few seconds later. For an
ASC agent hook the sample event starts a real agent run, and the button says so. */}}
{{$agent := eq .Webhook.Type "asc_agent"}}
<button type="button" class="ds-btn ds-btn-secondary ds-btn-sm wh-dl-test" id="test-delivery" data-link="{{.Link}}/test" data-redirect="{{.Link}}?tab=deliveries"{{if not .Webhook.IsActive}} disabled aria-describedby="wh-dl-test-help"{{else if $agent}} aria-describedby="wh-dl-test-help"{{end}}>{{if $agent}}{{ctx.Locale.Tr "asc_hooks.agent_test"}}{{else}}{{ctx.Locale.Tr "asc_hooks.send_test"}}{{end}}</button>
{{if not .Webhook.IsActive}}<p class="ds-hint" id="wh-dl-test-help">{{ctx.Locale.Tr "repo.settings.webhook.test_delivery_desc_disabled"}}</p>{{else if $agent}}<p class="ds-hint" id="wh-dl-test-help">{{ctx.Locale.Tr "asc_hooks.agent_test_hint"}}</p>{{end}}
