{{/* The Settings tab of one webhook: its payload address, for a hook that signs its deliveries the content type and
the secret (masked, Replace to type a new one), for an ASC agent hook the agent, its branch and its task instead of
the address, the ASC events it sends in four groups, and the Active switch beside
Send test delivery. There is no Save: the page's script saves each field when it changes (a form without script has
the Save button) and the switch pauses or resumes the hook at once. The data is the page data. */}}
<form class="ds-form wh-set" id="wh-set" method="post" action="{{.BaseLink}}/{{.Webhook.ID}}/settings" data-wh-autosave>
	{{.CsrfTokenHtml}}
	{{if eq .Webhook.Type "asc_agent"}}
		<div class="wh-set-grid">
			<div class="ds-field">
				<label class="ds-label" for="agent">{{ctx.Locale.Tr "asc_hooks.agent"}}</label>
				<input class="ds-input" id="agent" name="agent" type="text" maxlength="40" value="{{.HookMetadata.Agent}}" required autocomplete="off" autocapitalize="none" spellcheck="false" list="agent_list" aria-describedby="agent_help">
				<datalist id="agent_list">{{range .AgentRoster}}<option value="{{.Name}}"></option>{{end}}</datalist>
				<p class="ds-err-msg" id="agent_err" role="alert" hidden>{{svg "dsi-alert" 16}}<span></span></p>
				<p class="ds-hint" id="agent_help">{{ctx.Locale.Tr "asc_hooks.agent_hint"}}</p>
			</div>
			<div class="ds-field">
				<label class="ds-label" for="target">{{ctx.Locale.Tr "asc_hooks.agent_target"}}</label>
				<input class="ds-input ds-mono" id="target" name="target" type="text" maxlength="255" value="{{.HookMetadata.Target}}" required autocomplete="off" spellcheck="false" aria-describedby="target_help">
				<p class="ds-err-msg" id="target_err" role="alert" hidden>{{svg "dsi-alert" 16}}<span></span></p>
				<p class="ds-hint" id="target_help">{{ctx.Locale.Tr "asc_hooks.agent_target_hint"}}</p>
			</div>
		</div>
		<div class="ds-field">
			<label class="ds-label" for="task">{{ctx.Locale.Tr "asc_hooks.agent_task"}}</label>
			<textarea class="ds-textarea" id="task" name="task" rows="5" maxlength="8192" required aria-describedby="task_help">{{.HookMetadata.Task}}</textarea>
			<p class="ds-err-msg" id="task_err" role="alert" hidden>{{svg "dsi-alert" 16}}<span></span></p>
			<p class="ds-hint" id="task_help">{{ctx.Locale.Tr "asc_hooks.agent_task_hint"}}</p>
		</div>
	{{else}}
		<div class="ds-field{{if .Err_PayloadURL}} error{{end}}">
			<label class="ds-label" for="payload_url">{{ctx.Locale.Tr "asc_hooks.payload_url"}}</label>
			<div class="ds-inwrap">
				{{svg "dsi-lock" 16}}
				<input class="ds-input" id="payload_url" name="payload_url" type="url" value="{{.Webhook.URL}}" required aria-describedby="payload_url_help">
			</div>
			<p class="ds-err-msg" id="payload_url_err" role="alert" hidden>{{svg "dsi-alert" 16}}<span></span></p>
			<p class="ds-hint" id="payload_url_help">{{ctx.Locale.Tr "asc_hooks.url_hint"}}</p>
		</div>
		{{if .HookHasSecret}}
			<div class="wh-set-grid">
				<div class="ds-field">
					<label class="ds-label" for="content_type">{{ctx.Locale.Tr "asc_hooks.content_type"}}</label>
					<select class="ds-input ds-select" id="content_type" name="content_type">
						<option value="1"{{if ne .Webhook.ContentType 2}} selected{{end}}>application/json</option>
						<option value="2"{{if eq .Webhook.ContentType 2}} selected{{end}}>application/x-www-form-urlencoded</option>
					</select>
				</div>
				<div class="ds-field">
					<label class="ds-label" for="secret">{{ctx.Locale.Tr "asc_hooks.secret"}}</label>
					<div class="ds-inwrap">
						<input class="ds-input wh-secret-in" id="secret" name="secret" type="password" autocomplete="new-password" aria-describedby="secret_help"{{if .Webhook.Secret}} placeholder="••••••••••••"{{end}}>
						{{if .Webhook.Secret}}<button type="button" class="ds-btn ds-btn-ghost ds-btn-sm ds-trail" data-wh-replace="secret">{{ctx.Locale.Tr "asc_hooks.secret_replace"}}</button>{{end}}
					</div>
					<p class="ds-hint" id="secret_help">{{ctx.Locale.Tr "asc_hooks.secret_hint"}}</p>
				</div>
			</div>
		{{end}}
	{{end}}
	<fieldset class="wh-send">
		<legend class="ds-sb">{{ctx.Locale.Tr "asc_hooks.send_me"}}</legend>
		<div class="wh-send-grid">
			{{range .SendGroups}}
				<fieldset class="wh-send-group">
					<legend class="ds-t-micro ds-c-3">{{ctx.Locale.Tr .Label}}</legend>
					{{range .Options}}
						<label class="ds-check"><input type="checkbox" name="asc_events" value="{{.Event}}"{{if .On}} checked{{end}}>{{ctx.Locale.Tr .Label}}</label>
					{{end}}
				</fieldset>
			{{end}}
		</div>
	</fieldset>
	<p class="ds-sr" role="status" data-wh-status data-saved="{{ctx.Locale.Tr "asc_hooks.saved"}}"></p>
	<p class="ds-err-msg" role="alert" data-wh-failed hidden>{{svg "dsi-alert" 16}}<span>{{ctx.Locale.Tr "asc_hooks.not_saved"}}</span></p>
	<noscript><button class="ds-btn ds-btn-primary" type="submit">{{ctx.Locale.Tr "asc_hooks.save"}}</button></noscript>
</form>
<div class="wh-set-foot">
	<form method="post" action="{{.BaseLink}}/{{.Webhook.ID}}/active">
		{{.CsrfTokenHtml}}
		<input type="hidden" name="active" value="{{not .Webhook.IsActive}}">
		<button class="ds-switch-btn" type="submit" role="switch" aria-checked="{{.Webhook.IsActive}}" aria-labelledby="wh-active-l" aria-describedby="wh-active-h"><span class="ds-switch-track" aria-hidden="true"></span></button>
	</form>
	<div class="wh-set-active">
		<div class="ds-sb" id="wh-active-l">{{ctx.Locale.Tr "asc_hooks.active"}}</div>
		<div class="ds-t-small ds-c-2" id="wh-active-h">{{ctx.Locale.Tr "asc_hooks.active_hint"}}</div>
	</div>
	{{if .Permission.IsAdmin}}{{template "webhook/test_delivery" .}}{{end}}
</div>
