<p>{{ctx.Locale.Tr "repo.settings.add_web_hook_desc" "https://feishu.cn" (ctx.Locale.Tr "repo.settings.web_hook_name_feishu_only")}}</p>
<p>{{ctx.Locale.Tr "repo.settings.add_web_hook_desc" "https://larksuite.com" (ctx.Locale.Tr "repo.settings.web_hook_name_larksuite_only")}}</p>
<form class="ui form ds-form" action="{{.BaseLink}}/{{or .Webhook.ID "feishu/new"}}" method="post">
	<div class="required ds-field {{if .Err_PayloadURL}}error{{end}}">
		<label for="payload_url">{{ctx.Locale.Tr "repo.settings.payload_url"}}</label>
		<input class="ds-input" id="payload_url" name="payload_url" type="url" value="{{.Webhook.URL}}" autofocus required{{if AscEnabled}} aria-describedby="payload_url_help"{{if .PayloadURLRefused}} aria-invalid="true"{{end}}{{end}}>
		{{template "webhook/payload_url_help" .}}
	</div>
	{{template "webhook/shared-settings" .}}
</form>
