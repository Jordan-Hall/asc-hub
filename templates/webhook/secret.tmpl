{{/* The secret field of a webhook that signs its deliveries. An existing webhook's secret is never shown again:
the field is empty, leaving it empty keeps the secret, and the server can regenerate it. */}}
<div class="ds-field {{if .Err_Secret}}error{{end}}">
	<label for="secret">{{ctx.Locale.Tr "repo.settings.secret"}}</label>
	{{if gt .Webhook.ID 0}}
		<input class="ds-input" id="secret" name="secret" type="password" autocomplete="new-password"{{if .Webhook.Secret}} placeholder="{{ctx.Locale.Tr "asc_hooks.secret_set"}}"{{end}}>
	{{else}}
		<input class="ds-input" id="secret" name="secret" type="password" value="{{.Webhook.Secret}}" autocomplete="new-password">
	{{end}}
	{{if .Webhook.ID}}
		<div class="ds-row ds-row-wrap ds-gap-8 wh-secret">
			<button type="submit" class="ds-btn ds-btn-secondary ds-btn-sm" form="wh-secret-form" aria-describedby="wh-secret-help">{{ctx.Locale.Tr "asc_hooks.regenerate_secret"}}</button>
			<span class="ds-hint" id="wh-secret-help">{{ctx.Locale.Tr "asc_hooks.regenerate_secret_help"}}</span>
		</div>
	{{end}}
</div>
