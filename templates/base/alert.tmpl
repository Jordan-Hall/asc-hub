{{if .Flash.ErrorMsg}}
	<div id="flash-message" class="ds-banner ds-banner-err flash-message flash-error" role="alert" hx-swap-oob="true">
		<p>{{.Flash.ErrorMsg | SanitizeHTML}}</p>
	</div>
{{end}}
{{if .Flash.SuccessMsg}}
	<div id="flash-message" class="ds-banner ds-banner-ok flash-message flash-success" hx-swap-oob="true">
		<p>{{.Flash.SuccessMsg | SanitizeHTML}}</p>
	</div>
{{end}}
{{if .Flash.InfoMsg}}
	<div id="flash-message" class="ds-banner flash-message flash-info" hx-swap-oob="true">
		<p>{{.Flash.InfoMsg | SanitizeHTML}}</p>
	</div>
{{end}}
{{if .Flash.WarningMsg}}
	<div id="flash-message" class="ds-banner ds-banner-warn flash-message flash-warning" hx-swap-oob="true">
		<p>{{.Flash.WarningMsg | SanitizeHTML}}</p>
	</div>
{{end}}
{{if and (not .Flash.ErrorMsg) (not .Flash.SuccessMsg) (not .Flash.InfoMsg) (not .Flash.WarningMsg) (not .IsHTMX)}}
	<div id="flash-message" hx-swap-oob="true"></div>
{{end}}
