<!DOCTYPE html>
<html lang="{{ctx.Locale.Lang}}" data-theme="{{ThemeName .SignedUser}}">
<head>
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<meta name="theme-color" content="#0b1220">
	{{/* Display `- .Repository.FullName` only if `.Title` does not already start with that. */}}
	<title>{{if .Title}}{{.Title}} - {{end}}{{if and (.Repository.Name) (not (StringUtils.HasPrefix .Title .Repository.FullName))}}{{.Repository.FullName}} - {{else}}{{if and (.ContextUser.IsOrganization) (.ContextUser.Name) (not (StringUtils.HasPrefix .Title .ContextUser.Name)) (not (StringUtils.HasPrefix .Title .ContextUser.FullName))}}{{.ContextUser.Name}} - {{end}}{{end}}{{AppName}}</title>
	<link rel="manifest" href="{{AppSubUrl}}/manifest.json">
	<meta name="author" content="{{if .Repository}}{{.Owner.Name}}{{else}}{{AppName}}{{end}}">
	<meta name="description" content="{{if .Repository}}{{.Repository.Name}}{{if .Repository.Description}} - {{.Repository.Description}}{{end}}{{else}}{{ctx.Locale.Tr "startpage.meta_description"}}{{end}}">
	<meta name="keywords" content="{{ctx.Locale.Tr "startpage.meta_keywords"}}">
	<meta name="referrer" content="same-origin">
{{if .GoGetImport}}
	<meta name="go-import" content="{{.GoGetImport}} git {{.RepoCloneLink.HTTPS}}">
	<meta name="go-source" content="{{.GoGetImport}} _ {{.GoDocDirectory}} {{.GoDocFile}}">
{{end}}
{{if and .EnableFeed .FeedURL}}
	<link rel="alternate" type="application/atom+xml" title="" href="{{.FeedURL}}.atom">
	<link rel="alternate" type="application/rss+xml" title="" href="{{.FeedURL}}.rss">
{{end}}
	<link rel="icon" href="{{AssetUrlPrefix}}/img/favicon.svg" type="image/svg+xml">
	<link rel="alternate icon" href="{{AssetUrlPrefix}}/img/favicon.png" type="image/png">
{{if and FederationEnabled .PageIsUserProfile .ContextUser .ContextUser.IsIndividual}}
	<link rel="alternate" type="application/activity+json" href="{{.ContextUser.APActorID}}">
{{end}}
	{{template "base/head_script" .}}
	{{template "shared/user/mention_highlight" .}}
	{{template "base/head_opengraph" .}}
	{{template "base/head_style" .}}
	{{template "custom/header" .}}
</head>
<body class="no-js ds-app{{if or .PageIsInstall (not .IsSigned)}} ds-has-no-bnav{{end}}" hx-swap="outerHTML" hx-ext="morph" hx-push-url="false">
	{{template "custom/body_outer_pre" .}}

	<div class="ds-shell">
		{{if not .PageIsInstall}}<a class="ds-skip" href="#main-content">{{ctx.Locale.Tr "aria.skip_to_content"}}</a>{{end}}
		<noscript>
			<div class="ds-banner ds-banner-warn ds-noscript">{{ctx.Locale.Tr "enable_javascript"}}</div>
		</noscript>

		{{template "custom/body_inner_pre" .}}

		{{if not .PageIsInstall}}
			{{template "base/head_navbar" .}}
			{{/* the target of the skip link: after the navigation, before the page */}}
			<a id="main-content" class="skip-target" tabindex="-1"></a>
		{{end}}

{{if false}}
	{{/* to make html structure "likely" complete to prevent IDE warnings */}}
	</div>
</body>
</html>
{{end}}
