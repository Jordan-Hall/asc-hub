{{/*
The application header of every page (ASC design system, board A2):
- desktop (1024 and wider): .ds-hdr-desktop, the brand, the primary links, the search field that opens the command palette, Inbox, Create and the account menu
- phone and tablet: .ds-topbar (menu, brand, search, account), the bottom navigation and the menu drawer
- the overlays (drawer, account menu, create menu, command palette) are siblings of the header so a page that brings its own .ds-subbar keeps them
The script in web_src/js/features/ds-shell.js opens and closes the overlays: elements with data-ds-open="id" open the overlay with that id, data-ds-close closes it. Without script, the links in the overlay triggers still work: the drawer and the menus open through :target, the search field is a link to the explore page.
*/}}
{{$notificationUnreadCount := 0}}
{{if and .IsSigned .NotificationUnreadCount}}
	{{$notificationUnreadCount = call .NotificationUnreadCount}}
{{end}}
{{$inboxHref := print AppSubUrl "/notifications"}}
{{if AscEnabled}}{{$inboxHref = print AppSubUrl "/-/asc/inbox"}}{{end}}
{{$docsURL := "https://github.com/Jordan-Hall/asc-hub/blob/asc/v16/docs/asc/README.md"}}
{{$aboutURL := "https://github.com/Jordan-Hall/asc-hub/blob/asc/v16/docs/asc/WHY.md"}}
{{$exploreHref := print AppSubUrl "/explore/repos"}}
{{if and (not .IsSigned) .IsLandingPageOrganizations}}{{$exploreHref = print AppSubUrl "/explore/organizations"}}{{end}}

<header id="navbar" class="ds-hdr{{if not .IsSigned}} ds-hdr-lg{{end}}" role="banner">
	{{/* ---------------- desktop ---------------- */}}
	<div class="ds-hdr-desktop">
		<a class="ds-brand" href="{{AppSubUrl}}/" aria-label="{{AppName}}: {{if .IsSigned}}{{ctx.Locale.Tr "dashboard"}}{{else}}{{ctx.Locale.Tr "home"}}{{end}}">
			{{template "base/brand_tile" .}}
			<span>{{AppName}}</span>
		</a>

		<nav class="ds-hdr-nav" aria-label="{{ctx.Locale.Tr "aria.navbar"}}">
			{{if and .IsSigned (not .HideNavbarLinks)}}
				{{if not .UnitPullsGlobalDisabled}}
					<a href="{{AppSubUrl}}/pulls"{{if .PageIsPulls}} aria-current="page"{{end}}>{{ctx.Locale.Tr "asc_shell.nav_changes"}}</a>
				{{end}}
				{{if AscEnabled}}
					<a href="{{AppSubUrl}}/-/asc/agents"{{if .PageIsAscAgents}} aria-current="page"{{end}}>{{ctx.Locale.Tr "asc_shell.nav_agents"}}</a>
				{{end}}
				<a href="{{$exploreHref}}"{{if .PageIsExplore}} aria-current="page"{{end}}>{{ctx.Locale.Tr "explore"}}</a>
				{{if AscDownloadAvailable}}
					<a href="{{AppSubUrl}}/download"{{if .PageIsAscDownload}} aria-current="page"{{end}}>{{ctx.Locale.Tr "asc_download.nav"}}</a>
				{{end}}
			{{else if not .IsSigned}}
				<a href="{{$exploreHref}}"{{if .PageIsExplore}} aria-current="page"{{end}}>{{ctx.Locale.Tr "explore"}}</a>
				{{if AscDownloadAvailable}}
					<a href="{{AppSubUrl}}/download"{{if .PageIsAscDownload}} aria-current="page"{{end}}>{{ctx.Locale.Tr "asc_download.nav"}}</a>
				{{end}}
				<a href="{{$docsURL}}" target="_blank" rel="noopener noreferrer">{{ctx.Locale.Tr "docs"}}</a>
				<a href="{{$aboutURL}}" target="_blank" rel="noopener noreferrer">{{ctx.Locale.Tr "asc_shell.nav_about"}}</a>
			{{end}}
			{{template "custom/extra_links" .}}
		</nav>

		{{if and .IsSigned (not .HideNavbarLinks)}}
			<button type="button" class="ds-hdr-search" data-ds-open="ds-palette" aria-haspopup="dialog" aria-controls="ds-palette" aria-keyshortcuts="/ Control+K">
				{{svg "dsi-search" 15}}
				<span class="ds-grow">{{if AscEnabled}}{{ctx.Locale.Tr "asc_shell.search_placeholder_asc"}}{{else}}{{ctx.Locale.Tr "asc_shell.search_placeholder"}}{{end}}</span>
				<span class="ds-kbd" aria-hidden="true">/</span>
			</button>
			<span class="ds-kbd ds-hdr-kbd" aria-hidden="true">Ctrl K</span>
			<span class="ds-hdr-sp"></span>

			<div class="ds-hdr-right">
				{{if EnableTimetracking}}
				<a class="active-stopwatch-trigger ds-hdr-ic{{if not .ActiveStopwatch}} tw-hidden{{end}}" href="{{.ActiveStopwatch.IssueLink}}" data-tippy-content="{{ctx.Locale.Tr "active_stopwatch"}}" aria-label="{{ctx.Locale.Tr "active_stopwatch"}}">
					{{svg "octicon-stopwatch" 18}}
					<span class="header-stopwatch-dot"></span>
				</a>
				<div class="active-stopwatch-popup tippy-target tw-p-2">
					<div class="tw-flex tw-items-center">
						<a class="stopwatch-link tw-flex tw-items-center" href="{{.ActiveStopwatch.IssueLink}}">
							{{svg "octicon-issue-opened" 16 "tw-mr-2"}}
							<span class="stopwatch-issue">{{.ActiveStopwatch.RepoSlug}}#{{.ActiveStopwatch.IssueIndex}}</span>
							<span class="ds-chip ds-chip-info stopwatch-time tw-my-0 tw-mx-4" data-seconds="{{.ActiveStopwatch.Seconds}}">
								{{if .ActiveStopwatch}}{{Sec2Time .ActiveStopwatch.Seconds}}{{end}}
							</span>
						</a>
						<form class="stopwatch-commit" method="post" action="{{.ActiveStopwatch.IssueLink}}/times/stopwatch/toggle">
							<button type="submit" class="ds-btn ds-btn-ghost ds-btn-sm ds-btn-icon" data-tooltip-content="{{ctx.Locale.Tr "repo.issues.stop_tracking"}}" aria-label="{{ctx.Locale.Tr "repo.issues.stop_tracking"}}">{{svg "octicon-square-fill"}}</button>
						</form>
						<form class="stopwatch-cancel" method="post" action="{{.ActiveStopwatch.IssueLink}}/times/stopwatch/cancel">
							<button type="submit" class="ds-btn ds-btn-ghost ds-btn-sm ds-btn-icon" data-tooltip-content="{{ctx.Locale.Tr "repo.issues.cancel_tracking"}}" aria-label="{{ctx.Locale.Tr "repo.issues.cancel_tracking"}}">{{svg "octicon-trash"}}</button>
						</form>
					</div>
				</div>
				{{end}}

				{{if AscEnabled}}
				<a class="ds-hdr-link{{if .PageIsAscInbox}} is-active{{end}}" href="{{$inboxHref}}"{{if .PageIsAscInbox}} aria-current="page"{{end}} data-asc-inbox-link>
					<span>{{ctx.Locale.Tr "user.asc_inbox"}}</span>
					<span class="ds-count ds-count-hot tw-hidden" data-asc-count-url="{{AppSubUrl}}/-/asc/inbox/count" data-asc-count></span>
				</a>
				{{end}}

				<a class="ds-hdr-ic" href="{{AppSubUrl}}/notifications" data-tooltip-content="{{ctx.Locale.Tr "notifications"}}" aria-label="{{ctx.Locale.Tr "notifications"}}">
					{{svg "dsi-bell" 18}}
					<span class="notification_count ds-pip-dot{{if not $notificationUnreadCount}} tw-hidden{{end}}">{{$notificationUnreadCount}}</span>
				</a>

				<button type="button" class="ds-hdr-plus" data-ds-open="ds-create" aria-haspopup="menu" aria-controls="ds-create" aria-expanded="false" aria-label="{{ctx.Locale.Tr "create_new"}}">{{svg "dsi-plus" 18}}</button>
				<button type="button" class="ds-hdr-av" data-ds-open="ds-account" aria-haspopup="menu" aria-controls="ds-account" aria-expanded="false" aria-label="{{ctx.Locale.Tr "user_profile_and_more"}}">{{ctx.AvatarUtils.Avatar .SignedUser 34}}</button>
			</div>
		{{else if .IsSigned}}
			<span class="ds-hdr-sp"></span>
			<div class="ds-hdr-right">
				<button type="button" class="ds-hdr-av" data-ds-open="ds-account" aria-haspopup="menu" aria-controls="ds-account" aria-expanded="false" aria-label="{{ctx.Locale.Tr "user_profile_and_more"}}">{{ctx.AvatarUtils.Avatar .SignedUser 34}}</button>
			</div>
		{{else}}
			<div class="ds-hdr-actions">
				<a class="ds-btn ds-btn-ghost ds-btn-ondark-text" rel="nofollow" href="{{AppSubUrl}}/user/login{{if not .PageIsSignIn}}?redirect_to={{.CurrentURL}}{{end}}"{{if .PageIsSignIn}} aria-current="page"{{end}}>{{ctx.Locale.Tr "sign_in"}}</a>
				{{if .ShowRegistrationButton}}
					<a class="ds-btn ds-btn-accent" href="{{AppSubUrl}}/user/sign_up"{{if .PageIsSignUp}} aria-current="page"{{end}}>{{ctx.Locale.Tr "asc_shell.create_account"}}</a>
				{{end}}
			</div>
		{{end}}
	</div>

	{{/* ---------------- phone and tablet ---------------- */}}
	<div class="ds-topbar">
		<a class="ds-ti" href="#ds-drawer" data-ds-open="ds-drawer" aria-haspopup="dialog" aria-controls="ds-drawer" aria-expanded="false" aria-label="{{ctx.Locale.Tr "toggle_menu"}}">{{svg "dsi-menu" 22}}</a>
		<a class="ds-brand" href="{{AppSubUrl}}/" aria-label="{{AppName}}: {{if .IsSigned}}{{ctx.Locale.Tr "dashboard"}}{{else}}{{ctx.Locale.Tr "home"}}{{end}}">
			{{template "base/brand_tile" .}}
			<span>{{AppName}}</span>
		</a>
		<span class="ds-topbar-sp"></span>
		{{if .IsSigned}}
			{{if not .HideNavbarLinks}}
			<a class="ds-ti" href="{{$exploreHref}}" data-ds-open="ds-palette" aria-haspopup="dialog" aria-controls="ds-palette" aria-label="{{ctx.Locale.Tr "asc_shell.search_label"}}">{{svg "dsi-search" 20}}</a>
			{{end}}
			<button type="button" class="ds-hdr-av" data-ds-open="ds-account" aria-haspopup="menu" aria-controls="ds-account" aria-expanded="false" aria-label="{{ctx.Locale.Tr "user_profile_and_more"}}">{{ctx.AvatarUtils.Avatar .SignedUser 34}}</button>
		{{else}}
			<a class="ds-btn ds-btn-accent ds-topbar-signin" rel="nofollow" href="{{AppSubUrl}}/user/login{{if not .PageIsSignIn}}?redirect_to={{.CurrentURL}}{{end}}">{{ctx.Locale.Tr "sign_in"}}</a>
		{{end}}
	</div>
</header>

{{/* ================= overlays ================= */}}
<div class="ds-scrim" id="ds-scrim" data-ds-close></div>

{{/* the menu drawer (phone and tablet) */}}
<div class="ds-drawer" id="ds-drawer" role="dialog" aria-modal="true" aria-label="{{ctx.Locale.Tr "toggle_menu"}}">
	<div class="ds-drawer-head">
		{{if .IsSigned}}
			{{ctx.AvatarUtils.Avatar .SignedUser 40}}
			<div class="ds-grow">
				<div class="ds-sb ds-truncate">{{if .SignedUser.FullName}}{{.SignedUser.FullName}}{{else}}{{.SignedUser.Name}}{{end}}</div>
				<div class="ds-t-small ds-c-2 ds-mono ds-truncate">@{{.SignedUser.Name}}</div>
			</div>
		{{else}}
			<a class="ds-brand ds-brand-ink ds-grow" href="{{AppSubUrl}}/">{{template "base/brand_tile" .}}<span>{{AppName}}</span></a>
		{{end}}
		<a class="ds-ti ds-ti-light" href="#main-content" data-ds-close aria-label="{{ctx.Locale.Tr "asc_shell.close"}}">{{svg "dsi-x" 20}}</a>
	</div>
	<nav class="ds-drawer-body" aria-label="{{ctx.Locale.Tr "aria.navbar"}}">
		{{if and .IsSigned (not .HideNavbarLinks)}}
			<div class="ds-mi-label">{{ctx.Locale.Tr "asc_shell.group_work"}}</div>
			<a class="ds-mi{{if .PageIsAscInbox}} is-active{{end}}" href="{{$inboxHref}}"{{if .PageIsAscInbox}} aria-current="page"{{end}}>{{ctx.Locale.Tr "user.asc_inbox"}}{{if AscEnabled}} <span class="ds-count ds-count-hot tw-hidden" data-asc-count-url="{{AppSubUrl}}/-/asc/inbox/count" data-asc-count></span>{{end}}</a>
			{{if not .UnitPullsGlobalDisabled}}
				<a class="ds-mi" href="{{AppSubUrl}}/pulls"{{if .PageIsPulls}} aria-current="page"{{end}}>{{ctx.Locale.Tr "asc_shell.nav_changes"}}</a>
			{{end}}
			{{if AscEnabled}}
				<a class="ds-mi" href="{{AppSubUrl}}/-/asc/agents"{{if .PageIsAscAgents}} aria-current="page"{{end}}>{{ctx.Locale.Tr "asc_shell.nav_agents"}}</a>
			{{end}}
		{{end}}
		<div class="ds-mi-label">{{ctx.Locale.Tr "asc_shell.group_hub"}}</div>
		<a class="ds-mi" href="{{$exploreHref}}"{{if .PageIsExplore}} aria-current="page"{{end}}>{{ctx.Locale.Tr "explore"}}</a>
		{{if AscDownloadAvailable}}
			<a class="ds-mi" href="{{AppSubUrl}}/download"{{if .PageIsAscDownload}} aria-current="page"{{end}}>{{ctx.Locale.Tr "asc_download.nav"}}</a>
		{{end}}
		<a class="ds-mi" href="{{$docsURL}}" target="_blank" rel="noopener noreferrer">{{ctx.Locale.Tr "docs"}}</a>
		{{if not .IsSigned}}
			<a class="ds-mi" href="{{$aboutURL}}" target="_blank" rel="noopener noreferrer">{{ctx.Locale.Tr "asc_shell.nav_about"}}</a>
		{{end}}
		{{if .IsSigned}}
			<div class="ds-mi-label">{{ctx.Locale.Tr "asc_shell.group_account"}}</div>
			<a class="ds-mi" href="{{.SignedUser.HomeLink}}">{{ctx.Locale.Tr "your_profile"}}</a>
			<a class="ds-mi" href="{{AppSubUrl}}/user/settings#settings-menu">{{ctx.Locale.Tr "your_settings"}}</a>
		{{end}}
	</nav>
	<div class="ds-drawer-foot">
		{{if StringUtils.HasPrefix (ThemeName .SignedUser) "asc-"}}
			<div>
				<div class="ds-t-micro ds-c-2 ds-mb-8">{{ctx.Locale.Tr "asc_shell.appearance"}}</div>
				{{template "base/theme_toggle" (dict "Data" . "Auto" true)}}
			</div>
		{{end}}
		{{if .IsSigned}}
			<button type="button" class="ds-input ds-drawer-search" data-ds-open="ds-palette" aria-haspopup="dialog" aria-controls="ds-palette">{{ctx.Locale.Tr "asc_shell.search_or_command"}}</button>
			<a class="ds-btn ds-btn-primary ds-btn-block" href="{{AppSubUrl}}/repo/create">{{ctx.Locale.Tr "new_repo.link"}}</a>
		{{else}}
			<a class="ds-btn ds-btn-secondary ds-btn-block" rel="nofollow" href="{{AppSubUrl}}/user/login{{if not .PageIsSignIn}}?redirect_to={{.CurrentURL}}{{end}}">{{ctx.Locale.Tr "sign_in"}}</a>
			{{if .ShowRegistrationButton}}
				<a class="ds-btn ds-btn-primary ds-btn-block" href="{{AppSubUrl}}/user/sign_up">{{ctx.Locale.Tr "asc_shell.create_account"}}</a>
			{{end}}
		{{end}}
	</div>
</div>

{{if .IsSigned}}
{{/* the account menu: a bottom sheet on a phone, a popover on a desktop */}}
<div class="ds-pop" id="ds-account" role="dialog" aria-modal="false" aria-label="{{ctx.Locale.Tr "user_profile_and_more"}}">
	<div class="ds-pop-body">
		<div class="ds-pop-head">
			<span class="ds-av ds-av-40" aria-hidden="true">{{ctx.AvatarUtils.Avatar .SignedUser 40}}</span>
			<div class="ds-grow">
				<div class="ds-sb ds-truncate">{{if .SignedUser.FullName}}{{.SignedUser.FullName}}{{else}}{{.SignedUser.Name}}{{end}}</div>
				<div class="ds-t-small ds-mono ds-truncate">@{{.SignedUser.Name}}</div>
			</div>
			<a class="ds-ti ds-ti-light ds-only-mobile" href="#main-content" data-ds-close aria-label="{{ctx.Locale.Tr "asc_shell.close"}}">{{svg "dsi-x" 20}}</a>
		</div>
		<hr>
		<a class="ds-mi" href="{{.SignedUser.HomeLink}}">{{svg "dsi-user" 18}}{{ctx.Locale.Tr "your_profile"}}</a>
		{{if not .DisableStars}}
			<a class="ds-mi" href="{{.SignedUser.HomeLink}}?tab=stars">{{svg "octicon-star" 18}}{{ctx.Locale.Tr "your_starred"}}</a>
		{{end}}
		{{if AscEnabled}}
			<a class="ds-mi" href="{{$inboxHref}}">{{svg "dsi-inbox" 18}}{{ctx.Locale.Tr "user.asc_inbox"}}<span class="ds-count ds-count-hot tw-hidden" data-asc-count-url="{{AppSubUrl}}/-/asc/inbox/count" data-asc-count></span></a>
			<a class="ds-mi" href="{{AppSubUrl}}/-/asc/agents">{{svg "dsi-agent" 18}}{{ctx.Locale.Tr "asc_shell.your_agents"}}</a>
		{{end}}
		<a class="ds-mi" href="{{AppSubUrl}}/notifications/subscriptions">{{svg "dsi-bell" 18}}{{ctx.Locale.Tr "asc_shell.subscriptions"}}</a>
		<a class="ds-mi" href="{{AppSubUrl}}/user/settings#settings-menu">{{svg "dsi-sliders" 18}}{{ctx.Locale.Tr "your_settings"}}</a>
		{{if .IsAdmin}}
			<a class="ds-mi" href="{{AppSubUrl}}/admin">{{svg "dsi-shield-check" 18}}{{ctx.Locale.Tr "admin_panel"}}</a>
		{{end}}
		{{if StringUtils.HasPrefix (ThemeName .SignedUser) "asc-"}}
			<hr>
			<div class="ds-pop-pad">
				<div class="ds-t-micro ds-c-3 ds-mb-8">{{ctx.Locale.Tr "asc_shell.appearance"}}</div>
				{{template "base/theme_toggle" (dict "Data" . "Auto" true)}}
				<div class="ds-row ds-justify-between ds-mt-12">
					<span class="ds-t-small">{{ctx.Locale.Tr "asc_shell.density"}}</span>
					<div class="ds-seg ds-seg-mini" role="group" aria-label="{{ctx.Locale.Tr "asc_shell.density"}}">
						<button type="button" data-ds-density-set="comfy" aria-pressed="true">{{ctx.Locale.Tr "asc_shell.density_comfy"}}</button>
						<button type="button" data-ds-density-set="compact" aria-pressed="false">{{ctx.Locale.Tr "asc_shell.density_compact"}}</button>
					</div>
				</div>
			</div>
		{{end}}
		<hr>
		<a class="ds-mi" target="_blank" rel="noopener noreferrer" href="{{$docsURL}}">{{svg "dsi-book" 18}}{{ctx.Locale.Tr "asc_shell.documentation"}}{{svg "dsi-external" 14 "ds-ml-auto ds-c-3"}}</a>
		{{if not .RunModeIsProd}}
			<a class="ds-mi" href="{{AppSubUrl}}/-/demo">{{svg "dsi-flask" 18}}{{ctx.Locale.Tr "asc_shell.demo_pages"}}</a>
		{{end}}
		<a class="ds-mi link-action" href data-url="{{AppSubUrl}}/user/logout">{{svg "dsi-sign-out" 18}}{{ctx.Locale.Tr "sign_out"}}</a>
	</div>
</div>

{{/* the create menu */}}
<div class="ds-pop ds-pop-create" id="ds-create" role="dialog" aria-modal="false" aria-label="{{ctx.Locale.Tr "create_new"}}">
	<div class="ds-pop-body">
		<div class="ds-mi-label">{{ctx.Locale.Tr "asc_shell.create_label"}}</div>
		<a class="ds-mi" href="{{AppSubUrl}}/repo/create">{{svg "dsi-book" 18}}{{ctx.Locale.Tr "new_repo.link"}}</a>
		{{if not .DisableMigrations}}
			<a class="ds-mi" href="{{AppSubUrl}}/repo/migrate">{{svg "dsi-upload" 18}}{{ctx.Locale.Tr "new_migrate.link"}}</a>
		{{end}}
		{{if .SignedUser.CanCreateOrganization}}
			<a class="ds-mi" href="{{AppSubUrl}}/org/create">{{svg "dsi-building" 18}}{{ctx.Locale.Tr "new_org.link"}}</a>
		{{end}}
	</div>
</div>
{{end}}

{{/* the command palette: search and jump, with the destinations of this hub */}}
<div class="ds-palette" id="ds-palette" role="dialog" aria-modal="true" aria-label="{{ctx.Locale.Tr "asc_shell.search_label"}}" data-ds-palette
	data-asc-search-url="{{if AscEnabled}}{{AppSubUrl}}/-/asc/search{{else}}{{AppSubUrl}}/explore/repos{{end}}"
	data-explore-repos-url="{{AppSubUrl}}/explore/repos" data-explore-users-url="{{AppSubUrl}}/explore/users"
	data-t-repos="{{ctx.Locale.Tr "asc_shell.palette_search_repos"}}" data-t-people="{{ctx.Locale.Tr "asc_shell.palette_search_people"}}" data-t-code="{{ctx.Locale.Tr "asc_shell.palette_search_code"}}">
	<div class="ds-palette-box">
		<form class="ds-palette-bar" role="search" action="{{if AscEnabled}}{{AppSubUrl}}/-/asc/search{{else}}{{AppSubUrl}}/explore/repos{{end}}" method="get">
			<label class="ds-palette-field">
				{{svg "dsi-search" 16}}
				<span class="ds-sr">{{ctx.Locale.Tr "asc_shell.search_label"}}</span>
				<input type="search" name="q" data-asc-search autocomplete="off" autocapitalize="none" spellcheck="false" enterkeyhint="search" placeholder="{{ctx.Locale.Tr "asc_shell.search_or_command"}}">
			</label>
			<button type="button" class="ds-palette-cancel" data-ds-close>{{ctx.Locale.Tr "cancel"}}</button>
		</form>
		<div class="ds-palette-list" data-ds-palette-list>
			<div data-ds-palette-dynamic></div>
			<div class="ds-palette-group" data-ds-group>{{ctx.Locale.Tr "asc_shell.palette_go_to"}}</div>
			{{if .IsSigned}}
				{{if AscEnabled}}
					<a class="ds-palette-item" href="{{$inboxHref}}" data-ds-text="{{ctx.Locale.Tr "user.asc_inbox"}}">{{svg "dsi-inbox" 17}}<span class="ds-pi-main">{{ctx.Locale.Tr "user.asc_inbox"}}<small>{{ctx.Locale.Tr "asc_shell.palette_inbox_sub"}}</small></span></a>
				{{end}}
				<a class="ds-palette-item" href="{{AppSubUrl}}/pulls" data-ds-text="{{ctx.Locale.Tr "asc_shell.nav_changes"}}">{{svg "dsi-changes" 17}}<span class="ds-pi-main">{{ctx.Locale.Tr "asc_shell.nav_changes"}}<small>{{ctx.Locale.Tr "asc_shell.palette_changes_sub"}}</small></span></a>
				{{if AscEnabled}}
					<a class="ds-palette-item" href="{{AppSubUrl}}/-/asc/agents" data-ds-text="{{ctx.Locale.Tr "asc_shell.nav_agents"}}">{{svg "dsi-agent" 17}}<span class="ds-pi-main">{{ctx.Locale.Tr "asc_shell.nav_agents"}}<small>{{ctx.Locale.Tr "asc_shell.palette_agents_sub"}}</small></span></a>
				{{end}}
			{{end}}
			<a class="ds-palette-item" href="{{$exploreHref}}" data-ds-text="{{ctx.Locale.Tr "explore"}}">{{svg "dsi-globe" 17}}<span class="ds-pi-main">{{ctx.Locale.Tr "explore"}}<small>{{ctx.Locale.Tr "asc_shell.palette_explore_sub"}}</small></span></a>
			{{if AscDownloadAvailable}}
				<a class="ds-palette-item" href="{{AppSubUrl}}/download" data-ds-text="{{ctx.Locale.Tr "asc_download.nav"}}">{{svg "dsi-download" 17}}<span class="ds-pi-main">{{ctx.Locale.Tr "asc_download.nav"}}<small>{{ctx.Locale.Tr "asc_shell.palette_download_sub"}}</small></span></a>
			{{end}}
			{{if .IsSigned}}
				<a class="ds-palette-item" href="{{AppSubUrl}}/user/settings" data-ds-text="{{ctx.Locale.Tr "your_settings"}}">{{svg "dsi-sliders" 17}}<span class="ds-pi-main">{{ctx.Locale.Tr "your_settings"}}<small>{{ctx.Locale.Tr "asc_shell.palette_settings_sub"}}</small></span></a>
				<div class="ds-palette-group" data-ds-group>{{ctx.Locale.Tr "asc_shell.palette_commands"}}</div>
				<a class="ds-palette-item" href="{{AppSubUrl}}/repo/create" data-ds-text="{{ctx.Locale.Tr "new_repo.link"}}">{{svg "dsi-plus" 17}}<span class="ds-pi-main">{{ctx.Locale.Tr "new_repo.link"}}<small>{{ctx.Locale.Tr "asc_shell.palette_new_repo_sub"}}</small></span></a>
				{{if .SignedUser.CanCreateOrganization}}
					<a class="ds-palette-item" href="{{AppSubUrl}}/org/create" data-ds-text="{{ctx.Locale.Tr "new_org.link"}}">{{svg "dsi-building" 17}}<span class="ds-pi-main">{{ctx.Locale.Tr "new_org.link"}}<small>{{ctx.Locale.Tr "asc_shell.palette_new_org_sub"}}</small></span></a>
				{{end}}
			{{end}}
		</div>
		<div class="ds-palette-empty" data-ds-palette-empty hidden>{{ctx.Locale.Tr "asc_shell.palette_empty"}}</div>
		<div class="ds-palette-foot" aria-hidden="true">
			<span><span class="ds-kbd">&uarr;</span> <span class="ds-kbd">&darr;</span> {{ctx.Locale.Tr "asc_shell.palette_move"}}</span>
			<span><span class="ds-kbd">&crarr;</span> {{ctx.Locale.Tr "asc_shell.palette_open"}}</span>
			<span><span class="ds-kbd">Esc</span> {{ctx.Locale.Tr "asc_shell.palette_close"}}</span>
		</div>
	</div>
</div>

{{/* the bottom navigation of a phone: Inbox, Changes, Explore, Search, Me */}}
{{if and .IsSigned (not .HideNavbarLinks)}}
<nav class="ds-bnav" aria-label="{{ctx.Locale.Tr "asc_shell.bottom_nav"}}">
	<a href="{{$inboxHref}}"{{if or .PageIsAscInbox .PageIsNotifications}} aria-current="page"{{end}}>
		{{svg "dsi-inbox" 22}}
		<span>{{ctx.Locale.Tr "user.asc_inbox"}}</span>
		{{if AscEnabled}}<span class="ds-pip tw-hidden" data-asc-count-url="{{AppSubUrl}}/-/asc/inbox/count" data-asc-count></span>{{end}}
	</a>
	<a href="{{AppSubUrl}}/pulls"{{if .PageIsPulls}} aria-current="page"{{end}}>{{svg "dsi-changes" 22}}<span>{{ctx.Locale.Tr "asc_shell.nav_changes"}}</span></a>
	<a href="{{$exploreHref}}"{{if .PageIsExplore}} aria-current="page"{{end}}>{{svg "dsi-globe" 22}}<span>{{ctx.Locale.Tr "explore"}}</span></a>
	<button type="button" data-ds-open="ds-palette" aria-haspopup="dialog" aria-controls="ds-palette">{{svg "dsi-search" 22}}<span>{{ctx.Locale.Tr "asc_shell.nav_search"}}</span></button>
	<button type="button" data-ds-open="ds-account" aria-haspopup="menu" aria-controls="ds-account" aria-expanded="false"{{if .PageIsUserSettings}} aria-current="page"{{end}}>{{svg "dsi-user" 22}}<span>{{ctx.Locale.Tr "asc_shell.nav_me"}}</span></button>
</nav>
{{end}}
