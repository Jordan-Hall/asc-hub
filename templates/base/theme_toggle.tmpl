{{/* The light, dark and system choice as three pressed-state buttons. head_style.tmpl holds the script that applies it and keeps aria-pressed. Only for the asc themes. Called with (dict "Data" .) or, for the account menu, (dict "Data" . "Auto" true) to label the third button "Auto" like the boards. */}}
{{if StringUtils.HasPrefix (ThemeName .Data.SignedUser) "asc-"}}
<div class="ds-seg ds-seg-fill" role="group" aria-label="{{ctx.Locale.Tr "asc_shell.theme_label"}}">
	<button type="button" data-ds-theme-set="light" aria-pressed="false">{{ctx.Locale.Tr "asc_shell.theme_light"}}</button>
	<button type="button" data-ds-theme-set="dark" aria-pressed="false">{{ctx.Locale.Tr "asc_shell.theme_dark"}}</button>
	<button type="button" data-ds-theme-set="system" aria-pressed="false">{{if .Auto}}{{ctx.Locale.Tr "asc_shell.theme_auto"}}{{else}}{{ctx.Locale.Tr "asc_shell.theme_system"}}{{end}}</button>
</div>
{{end}}
