{{/*
The pager of every list (ASC design system: .ds-pager-wrap > .ds-pager).
Reads .Page (the paginator), .Link and the page's own query parameters; links keep the filters.
Renders nothing for a single page. 44px targets on a phone; the note "Page 2 of 9" shows beside the buttons from 768.
*/}}
{{$paginationParams := .Page.GetParams}}
{{$paginationLink := $.Link}}
{{if eq $paginationLink AppSubUrl}}{{$paginationLink = print $paginationLink "/"}}{{end}}
{{with .Page.Paginater}}
	{{if gt .TotalPages 1}}
		<div class="ds-pager-wrap center page buttons">
			<span class="ds-pager-note ds-hide-sm">{{ctx.Locale.Tr "asc_shell.page_of" .Current .TotalPages}}</span>
			<nav class="ds-pager" aria-label="{{ctx.Locale.Tr "asc_shell.pagination"}}">
				{{if .HasPrevious}}
					<a class="ds-pager-nav" rel="prev" href="{{$paginationLink}}?page={{.Previous}}{{if $paginationParams}}&{{$paginationParams}}{{end}}" aria-label="{{ctx.Locale.Tr "repo.issues.previous"}}">{{svg "dsi-chevron-left" 16}}<span class="ds-hide-sm">{{ctx.Locale.Tr "repo.issues.previous"}}</span></a>
				{{else}}
					<span class="ds-pager-nav ds-disabled" aria-hidden="true">{{svg "dsi-chevron-left" 16}}<span class="ds-hide-sm">{{ctx.Locale.Tr "repo.issues.previous"}}</span></span>
				{{end}}
				{{range .Pages}}
					{{if eq .Num -1}}
						<span aria-hidden="true">&hellip;</span>
					{{else if .IsCurrent}}
						<a href="{{$paginationLink}}?page={{.Num}}{{if $paginationParams}}&{{$paginationParams}}{{end}}" aria-current="page">{{.Num}}</a>
					{{else}}
						<a href="{{$paginationLink}}?page={{.Num}}{{if $paginationParams}}&{{$paginationParams}}{{end}}">{{.Num}}</a>
					{{end}}
				{{end}}
				{{if .HasNext}}
					<a class="ds-pager-nav" rel="next" href="{{$paginationLink}}?page={{.Next}}{{if $paginationParams}}&{{$paginationParams}}{{end}}" aria-label="{{ctx.Locale.Tr "repo.issues.next"}}"><span class="ds-hide-sm">{{ctx.Locale.Tr "repo.issues.next"}}</span>{{svg "dsi-chevron-right" 16}}</a>
				{{else}}
					<span class="ds-pager-nav ds-disabled" aria-hidden="true"><span class="ds-hide-sm">{{ctx.Locale.Tr "repo.issues.next"}}</span>{{svg "dsi-chevron-right" 16}}</span>
				{{end}}
			</nav>
		</div>
	{{end}}
{{end}}
