{{/* Install progress (board Install, state "Installing"): five steps, the first .Done of them done. install.js shows it and moves it on: it marks each li[data-ins-run-step] is-done or is-cur, fills data-ins-run-label from data-label ("{n}" and "{total}") and data-ins-run-bar, and writes the state of each step for screen readers from data-t-done / data-t-now / data-t-todo. */}}
<div class="ds-stack ds-stack-16 ins-run" data-ins-run data-done="{{.Done}}" data-label="{{ctx.Locale.Tr "asc_install.run_step" "{n}" "{total}"}}" data-t-done="{{ctx.Locale.Tr "asc_install.step_done"}}" data-t-now="{{ctx.Locale.Tr "asc_install.run_now"}}" data-t-todo="{{ctx.Locale.Tr "asc_install.run_todo"}}">
	<p class="ds-t-small ds-c-2" data-ins-run-label></p>
	<progress class="ins-mstep-bar" max="10" value="0" data-ins-run-bar aria-label="{{ctx.Locale.Tr "asc_install.post_h"}}"></progress>
	<ol class="ins-run-list ds-t-small">
		<li data-ins-run-step><span class="ins-run-ic ins-run-done">{{svg "dsi-check-circle" 16}}</span><span class="ins-run-ic ins-run-now">{{svg "dsi-refresh" 16}}</span><span class="ins-run-ic ins-run-todo">{{svg "dsi-clock" 16}}</span><span>{{ctx.Locale.Tr "asc_install.run_s1"}}</span><span class="tw-sr-only" data-ins-run-state></span></li>
		<li data-ins-run-step><span class="ins-run-ic ins-run-done">{{svg "dsi-check-circle" 16}}</span><span class="ins-run-ic ins-run-now">{{svg "dsi-refresh" 16}}</span><span class="ins-run-ic ins-run-todo">{{svg "dsi-clock" 16}}</span><span>{{ctx.Locale.Tr "asc_install.run_s2"}}</span><span class="tw-sr-only" data-ins-run-state></span></li>
		<li data-ins-run-step><span class="ins-run-ic ins-run-done">{{svg "dsi-check-circle" 16}}</span><span class="ins-run-ic ins-run-now">{{svg "dsi-refresh" 16}}</span><span class="ins-run-ic ins-run-todo">{{svg "dsi-clock" 16}}</span><span>{{ctx.Locale.Tr "asc_install.run_s3"}}</span><span class="tw-sr-only" data-ins-run-state></span></li>
		<li data-ins-run-step><span class="ins-run-ic ins-run-done">{{svg "dsi-check-circle" 16}}</span><span class="ins-run-ic ins-run-now">{{svg "dsi-refresh" 16}}</span><span class="ins-run-ic ins-run-todo">{{svg "dsi-clock" 16}}</span><span>{{ctx.Locale.Tr "asc_install.run_s4"}}</span><span class="tw-sr-only" data-ins-run-state></span></li>
		<li data-ins-run-step><span class="ins-run-ic ins-run-done">{{svg "dsi-check-circle" 16}}</span><span class="ins-run-ic ins-run-now">{{svg "dsi-refresh" 16}}</span><span class="ins-run-ic ins-run-todo">{{svg "dsi-clock" 16}}</span><span>{{ctx.Locale.Tr "asc_install.run_s5"}}</span><span class="tw-sr-only" data-ins-run-state></span></li>
	</ol>
</div>
