{{/* The tabs of a person's profile: views of one person, a scrolling pill row on a phone and an underlined strip from 1024. */}}
<nav class="ds-tabs wk-pf-tabs" aria-label="{{ctx.Locale.Tr "asc_work.pf_tabs"}}">
	{{if .ContextUser.IsIndividual}}
		<a class="ds-tab" href="{{.ContextUser.HomeLink}}?tab=overview"{{if eq .TabName "overview"}} aria-current="page"{{end}}>{{ctx.Locale.Tr "user.overview"}}</a>
		<a class="ds-tab" href="{{.ContextUser.HomeLink}}?tab=work"{{if eq .TabName "work"}} aria-current="page"{{end}}>{{ctx.Locale.Tr "asc_work.pf_work"}}{{if .AscWorkCount}} <span class="ds-count">{{.AscWorkCount}}</span>{{end}}</a>
		<a class="ds-tab" href="{{.ContextUser.HomeLink}}?tab=reviews"{{if eq .TabName "reviews"}} aria-current="page"{{end}}>{{ctx.Locale.Tr "asc_work.pf_reviews"}}{{if .AscReviewCount}} <span class="ds-count">{{.AscReviewCount}}</span>{{end}}</a>
	{{end}}
	<a class="ds-tab" href="{{.ContextUser.HomeLink}}?tab=repositories"{{if eq .TabName "repositories"}} aria-current="page"{{end}}>{{ctx.Locale.Tr "user.repositories"}}{{if .RepoCount}} <span class="ds-count">{{.RepoCount}}</span>{{end}}<span hidden test-name="repository-count">{{.RepoCount}}</span></a>
	{{if or .ContextUser.IsIndividual .CanReadProjects}}
		<a class="ds-tab" href="{{.ContextUser.HomeLink}}/-/projects"{{if .PageIsViewProjects}} aria-current="page"{{end}}>{{ctx.Locale.Tr "user.projects"}}{{if .ProjectCount}} <span class="ds-count">{{.ProjectCount}}</span>{{end}}<span hidden test-name="project-count">{{.ProjectCount}}</span></a>
	{{end}}
	{{if and .IsPackageEnabled (or .ContextUser.IsIndividual .CanReadPackages)}}
		<a class="ds-tab" href="{{.ContextUser.HomeLink}}/-/packages"{{if .IsPackagesPage}} aria-current="page"{{end}}>{{ctx.Locale.Tr "packages.title"}}{{if .PackageCount}} <span class="ds-count">{{.PackageCount}}</span>{{end}}<span hidden test-name="package-count">{{.PackageCount}}</span></a>
	{{end}}
	{{if and .IsRepoIndexerEnabled (or .ContextUser.IsIndividual .CanReadCode)}}
		<a class="ds-tab" href="{{.ContextUser.HomeLink}}/-/code"{{if .IsCodePage}} aria-current="page"{{end}}>{{ctx.Locale.Tr "user.code"}}</a>
	{{end}}
	{{if .ContextUser.IsIndividual}}
		{{if or (eq .TabName "activity") .IsAdmin (eq .SignedUserID .ContextUser.ID) (not .ContextUser.KeepActivityPrivate)}}
			<a class="ds-tab" href="{{.ContextUser.HomeLink}}?tab=activity"{{if eq .TabName "activity"}} aria-current="page"{{end}}>{{ctx.Locale.Tr "user.activity"}}</a>
		{{end}}
		{{if and FederationEnabled (eq .SignedUserID .ContextUser.ID)}}
			<a class="ds-tab" href="{{.ContextUser.HomeLink}}?tab=feed"{{if eq .TabName "feed"}} aria-current="page"{{end}}>{{ctx.Locale.Tr "user.activitypub_feed.feed"}}</a>
		{{end}}
		{{if not .DisableStars}}
			<a class="ds-tab" href="{{.ContextUser.HomeLink}}?tab=stars"{{if eq .TabName "stars"}} aria-current="page"{{end}}>{{ctx.Locale.Tr "user.starred"}}{{if .ContextUser.NumStars}} <span class="ds-count">{{.ContextUser.NumStars}}</span>{{end}}</a>
		{{else}}
			<a class="ds-tab" href="{{.ContextUser.HomeLink}}?tab=watching"{{if eq .TabName "watching"}} aria-current="page"{{end}}>{{ctx.Locale.Tr "user.watched"}}</a>
		{{end}}
	{{end}}
</nav>
