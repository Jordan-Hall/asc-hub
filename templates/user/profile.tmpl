{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content user profile asc-profile">
	{{template "shared/user/asc_profile_band" .}}
	<div class="ap-pfwrap ap-pfbody">
		{{template "base/alert" .}}
		{{$activityVisible := or .IsAdmin (eq .SignedUserID .ContextUser.ID) (not .ContextUser.KeepActivityPrivate)}}
		{{if eq .TabName "overview"}}
			<div class="ap-pfgrid">
				<div class="ap-main">
					{{if .AscProfileWork}}
						<section class="ap-panel padded" aria-labelledby="ap-work-title">
							<div class="ap-sechead"><h2 id="ap-work-title">{{ctx.Locale.Tr "user.asc_profile.working_now"}}</h2><span>{{ctx.Locale.Tr "user.asc_profile.resume" (or .ContextUser.FullName .ContextUser.Name)}}</span></div>
							<ul class="ap-work">
								{{range .AscProfileWork}}
									<li>
										<a href="{{.Link}}">
											<span class="ap-dot {{.Tone}}" aria-hidden="true"></span>
											<span class="body">
												<span class="title">{{.Title}}</span>
												<span class="where">{{.Repo}}{{if .Detail}} &middot; {{.Detail}}{{end}} &middot; {{DateUtils.TimeSince .Updated}}</span>
											</span>
											{{if .State}}<span class="ap-pill {{.StateTone}}">{{.State}}</span>{{end}}
										</a>
									</li>
								{{end}}
							</ul>
						</section>
					{{end}}
					{{if .ProfileReadme}}
						<div id="readme_profile" class="{{if not .IsProfileReadmePlain}}markup{{end}}">
						{{if .IsProfileReadmePlain}}
							<pre>{{.ProfileReadme}}</pre>
						{{else}}
							{{.ProfileReadme}}
						{{end}}
						</div>
					{{end}}
					{{if $activityVisible}}
						{{if .AscHeat}}
							<section class="ap-panel padded" aria-labelledby="ap-heat-title">
								<div class="ap-sechead"><h2 id="ap-heat-title">{{ctx.Locale.Tr "user.asc_profile.contributions"}}</h2><span>{{ctx.Locale.TrN .AscHeat.Total "user.asc_profile.total_one" "user.asc_profile.total_n" .AscHeat.Total}}</span></div>
								{{template "user/asc_heatmap" .AscHeat}}
							</section>
						{{end}}
						<section class="ap-panel" aria-labelledby="ap-recent-title">
							<div class="ap-panel-head"><h2 id="ap-recent-title">{{ctx.Locale.Tr "user.asc_profile.recent_activity"}}</h2><span class="hint"><a href="{{.ContextUser.HomeLink}}?tab=activity">{{ctx.Locale.Tr "user.asc_profile.all_activity"}}</a></span></div>
							{{if .Feeds}}
								<ul class="ap-recent">
									{{range .Feeds}}<li><span class="ap-dot" aria-hidden="true"></span><span>{{template "user/dashboard/feed_sentence" .}}</span></li>{{end}}
								</ul>
							{{else}}
								<p class="ap-empty">{{ctx.Locale.Tr "user.asc_profile.activity_empty"}}</p>
							{{end}}
						</section>
					{{else}}
						<p class="ap-quiet" id="visibility-hint">{{ctx.Locale.Tr "user.disabled_public_activity"}}</p>
					{{end}}
				</div>
				<aside class="ap-aside" aria-label="{{ctx.Locale.Tr "user.asc_profile.about"}}">
					{{if .AscProfileRepos}}
						<section class="ap-panel padded" aria-labelledby="ap-prepos-title">
							<h2 id="ap-prepos-title">{{ctx.Locale.Tr "user.repositories"}}</h2>
							<ul class="ap-pfrepos">
								{{range .AscProfileRepos}}
									<li><a href="{{.Link}}">{{.FullName}}</a><span>{{ctx.Locale.TrN .Changes "user.asc_profile.changes_one" "user.asc_profile.changes_n" .Changes}}</span></li>
								{{end}}
							</ul>
						</section>
					{{end}}
					{{if and .Orgs .HasOrgsVisible}}
						<section class="ap-panel padded" aria-labelledby="ap-porgs-title">
							<h2 id="ap-porgs-title">{{ctx.Locale.Tr "user.asc_profile.organizations"}}</h2>
							<div class="ap-pills">
								{{range .Orgs}}
									{{if (or .Visibility.IsPublic (and ($.SignedUser) (or .Visibility.IsLimited (and (.HasMemberWithUserID ctx $.SignedUserID) .Visibility.IsPrivate) ($.IsAdmin))))}}
										<a class="ap-pill" href="{{.HomeLink}}">{{.DisplayName}}</a>
									{{end}}
								{{end}}
							</div>
						</section>
					{{end}}
					<section class="ap-panel padded ap-note">
						{{if eq .SignedUserID .ContextUser.ID}}
							{{ctx.Locale.Tr "user.asc_profile.visible_self" (print AppSubUrl "/user/settings#keep-activity-private")}}
						{{else}}
							{{ctx.Locale.Tr "user.asc_profile.visible_other" (or .ContextUser.FullName .ContextUser.Name)}}
						{{end}}
					</section>
				</aside>
			</div>
		{{else if eq .TabName "activity"}}
			{{if eq .SignedUserID .ContextUser.ID}}
			<p id="visibility-hint">
				{{if .ContextUser.KeepActivityPrivate}}
					{{ctx.Locale.Tr "user.public_activity.visibility_hint.self_private" (print AppSubUrl "/user/settings#keep-activity-private")}}
				{{else}}
					{{if eq .ContextUser.Visibility 2}}
						{{ctx.Locale.Tr "user.public_activity.visibility_hint.self_private_profile" (print AppSubUrl "/user/settings#visibility-setting")}}
					{{else}}
						{{ctx.Locale.Tr "user.public_activity.visibility_hint.self_public" (print AppSubUrl "/user/settings#keep-activity-private")}}
					{{end}}
				{{end}}
			</p>
			{{else}}
				{{if .IsAdmin}}
				<div id="visibility-hint" class="ui info message">
					{{if or .ContextUser.KeepActivityPrivate (eq .ContextUser.Visibility 2)}}
						{{ctx.Locale.Tr "user.public_activity.visibility_hint.admin_private"}}
					{{else}}
						{{ctx.Locale.Tr "user.public_activity.visibility_hint.admin_public"}}
					{{end}}
				</div>
				{{else}}
					{{if .ContextUser.KeepActivityPrivate}}
						<p id="visibility-hint">{{ctx.Locale.Tr "user.disabled_public_activity"}}</p>
					{{end}}
				{{end}}
			{{end}}
			{{if $activityVisible}}
				{{if .AscHeat}}
					<section class="ap-panel padded" aria-labelledby="ap-heat-title">
						<div class="ap-sechead"><h2 id="ap-heat-title">{{ctx.Locale.Tr "user.asc_profile.contributions"}}</h2><span>{{ctx.Locale.TrN .AscHeat.Total "user.asc_profile.total_one" "user.asc_profile.total_n" .AscHeat.Total}}</span></div>
						{{template "user/asc_heatmap" .AscHeat}}
					</section>
				{{end}}
				{{template "user/dashboard/feeds" .}}
			{{end}}
		{{else if eq .TabName "stars"}}
			<div class="stars">
				{{template "shared/repo_search" .}}
				{{template "explore/repo_list" .}}
				{{template "base/paginate" .}}
			</div>
		{{else if eq .TabName "following"}}
			{{template "repo/user_cards" .}}
		{{else if eq .TabName "followers"}}
			{{template "repo/user_cards" .}}
		{{else if and FederationEnabled (eq .TabName "feed")}}
			{{if eq .SignedUserID .ContextUser.ID}}
				{{if .FollowingFeeds}}
					{{template "user/dashboard/ap_feed" .}}
				{{else}}
					{{template "user/dashboard/ap_feed_guide" .}}
				{{end}}
			{{end}}
		{{else}}
			{{template "shared/repo_search" .}}
			{{template "explore/repo_list" .}}
			{{template "base/paginate" .}}
		{{end}}
	</div>
</div>

<div class="ui g-modal-confirm delete modal" id="block-user">
	<div class="header">
		{{ctx.Locale.Tr "user.block_user"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "user.block_user.detail"}}</p>
		<ul>
			<li>{{ctx.Locale.Tr "user.block_user.detail_1"}}</li>
			<li>{{ctx.Locale.Tr "user.block_user.detail_2"}}</li>
			<li>{{ctx.Locale.Tr "user.block_user.detail_3"}}</li>
		</ul>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>

{{template "base/footer" .}}
