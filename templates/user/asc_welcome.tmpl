{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content hub-welcome">
	<div class="hub-container">
		<header class="hub-page-head">
			<h1 class="hub-page-title">{{ctx.Locale.Tr "asc_welcome.heading"}}</h1>
			<p class="hub-page-lead">{{ctx.Locale.Tr "asc_welcome.lead"}}</p>
		</header>

		<div class="hub-welcome-layout">
			<ol class="hub-welcome-steps">
				<li class="hub-wstep is-done">
					<div class="hub-wstep-head">
						<span class="hub-wstep-mark" aria-hidden="true">{{svg "octicon-check" 16}}</span>
						<h2 class="hub-wstep-title">{{ctx.Locale.Tr "asc_welcome.step1_title"}}</h2>
						<span class="hub-chip hub-chip-ok">{{ctx.Locale.Tr "asc_welcome.done"}}</span>
					</div>
					<p class="hub-wstep-text">{{ctx.Locale.Tr "asc_welcome.step1_text" .SignedUser.Name}}</p>
				</li>

				<li class="hub-wstep{{if gt .WelcomeRepos 0}} is-done{{else}} is-current{{end}}">
					<div class="hub-wstep-head">
						<span class="hub-wstep-mark" aria-hidden="true">{{if gt .WelcomeRepos 0}}{{svg "octicon-check" 16}}{{else}}2{{end}}</span>
						<h2 class="hub-wstep-title">{{ctx.Locale.Tr "asc_welcome.step2_title"}}</h2>
						{{if gt .WelcomeRepos 0}}<span class="hub-chip hub-chip-ok">{{ctx.Locale.Tr "asc_welcome.done"}}</span>{{end}}
					</div>
					<p class="hub-wstep-text">{{if gt .WelcomeRepos 0}}{{ctx.Locale.TrN .WelcomeRepos "asc_welcome.step2_have_one" "asc_welcome.step2_have_many" .WelcomeRepos}}{{else}}{{ctx.Locale.Tr "asc_welcome.step2_text"}}{{end}}</p>
					<ul class="hub-wchoices">
						{{if .WelcomeMigrations}}
						<li><a class="hub-wchoice" href="{{AppSubUrl}}/repo/migrate?service_type=1">
							<span class="hub-wchoice-title">{{svg "octicon-git-branch" 18}} {{ctx.Locale.Tr "asc_welcome.from_git"}}</span>
							<span class="hub-wchoice-text">{{ctx.Locale.Tr "asc_welcome.from_git_text"}}</span>
						</a></li>
						<li><a class="hub-wchoice" href="{{AppSubUrl}}/repo/migrate">
							<span class="hub-wchoice-title">{{svg "octicon-repo-push" 18}} {{ctx.Locale.Tr "asc_welcome.from_service"}}</span>
							<span class="hub-wchoice-text">{{ctx.Locale.Tr "asc_welcome.from_service_text"}}</span>
						</a></li>
						{{end}}
						<li><a class="hub-wchoice" href="{{AppSubUrl}}/repo/create">
							<span class="hub-wchoice-title">{{svg "octicon-plus" 18}} {{ctx.Locale.Tr "asc_welcome.start_empty"}}</span>
							<span class="hub-wchoice-text">{{ctx.Locale.Tr "asc_welcome.start_empty_text"}}</span>
						</a></li>
					</ul>
				</li>

				<li class="hub-wstep">
					<div class="hub-wstep-head">
						<span class="hub-wstep-mark" aria-hidden="true">3</span>
						<h2 class="hub-wstep-title">{{ctx.Locale.Tr "asc_welcome.step3_title"}}</h2>
					</div>
					<p class="hub-wstep-text">{{ctx.Locale.Tr "asc_welcome.step3_text"}}</p>
					{{if .AscDownload}}<p class="hub-wstep-text"><a class="hub-btn hub-btn-primary-solid" href="{{AppSubUrl}}/download">{{svg "octicon-download" 16}} {{ctx.Locale.Tr "asc_download.home_cta"}}</a></p>{{end}}
					<pre class="hub-code" tabindex="0"><code>asc auth login --host {{.AscHubURL}} --prompt
asc clone {{.AscHubURL}}/{{.SignedUser.Name}}/REPOSITORY</code></pre>
				</li>
			</ol>

			<aside class="asc-welcome-side">
				<section class="hub-panel" aria-labelledby="asc-checks-title">
					<h2 class="hub-panel-title" id="asc-checks-title">{{ctx.Locale.Tr "asc_welcome.checks_title"}}</h2>
					<ul class="hub-checks">
						<li class="hub-check">
							<span>{{ctx.Locale.Tr "asc_welcome.check_email"}}</span>
							{{if .WelcomeActive}}<span class="hub-check-ok">{{ctx.Locale.Tr "asc_welcome.ok"}}</span>{{else}}<a class="hub-check-todo" href="{{AppSubUrl}}/user/settings/account">{{ctx.Locale.Tr "asc_welcome.confirm"}}</a>{{end}}
						</li>
						{{if .WelcomeSSH}}
						<li class="hub-check">
							<span>{{ctx.Locale.Tr "asc_welcome.check_ssh"}}</span>
							{{if gt .WelcomeKeys 0}}<span class="hub-check-ok">{{ctx.Locale.Tr "asc_welcome.ok"}}</span>{{else}}<a class="hub-check-todo" href="{{AppSubUrl}}/user/settings/keys">{{ctx.Locale.Tr "asc_welcome.add_one"}}</a>{{end}}
						</li>
						{{end}}
						<li class="hub-check">
							<span>{{ctx.Locale.Tr "asc_welcome.check_token"}}</span>
							{{if gt .WelcomeTokens 0}}<span class="hub-check-ok">{{ctx.Locale.Tr "asc_welcome.ok"}}</span>{{else}}<a class="hub-check-todo" href="{{AppSubUrl}}/user/settings/applications">{{ctx.Locale.Tr "asc_welcome.create_one"}}</a>{{end}}
						</li>
					</ul>
				</section>
				<section class="hub-panel" aria-labelledby="asc-look-title">
					<h2 class="hub-panel-title" id="asc-look-title">{{ctx.Locale.Tr "asc_welcome.look_title"}}</h2>
					<p class="hub-panel-text">{{ctx.Locale.Tr "asc_welcome.look_text"}}</p>
					<a class="hub-panel-link" href="{{AppSubUrl}}/explore/repos">{{ctx.Locale.Tr "asc_welcome.look_link"}}</a>
				</section>
			</aside>
		</div>
		<p class="hub-welcome-skip"><a href="{{AppSubUrl}}/">{{ctx.Locale.Tr "asc_welcome.skip"}}</a></p>
	</div>
</div>
{{template "base/footer" .}}
