{{/* The activity of a person or an organization: one row per action with who, what, where and when, and the detail of the action. */}}
<div id="activity-feed" class="ds-card wk-activity">
	<ul class="ds-list">
		{{range .Feeds}}
			<li class="ds-li">
				<span class="ds-li-av">{{ctx.AvatarUtils.AvatarByAction .}}</span>
				<div class="ds-li-main wk-act-main">
					<div class="wk-act-sentence">
						{{template "user/dashboard/feed_sentence" .}}
					</div>
					{{if .GetOpType.InActions "commit_repo" "mirror_sync_push"}}
						{{$push := ActionContent2Commits ctx .}}
						{{$repoLink := (.GetRepoLink ctx)}}
						{{$repo := .Repo}}
						<ul class="wk-act-commits">
							{{range $push.Commits}}
								<li>
									<img class="ui avatar" src="{{$push.AvatarLink $.Context .AuthorEmail}}" alt="" title="{{.AuthorName}}" width="16" height="16" loading="lazy">
									{{template "repo/shabox" (dict
										"sha1" .Sha1
										"commitLink" (printf "%s/commit/%s" $repoLink .Sha1)
										"signature" .Signature
										"verification" .Verification
									)}}
									<span class="wk-act-msg">{{RenderCommitMessage $.Context .Message ($repo.ComposeMetas ctx)}}</span>
								</li>
							{{end}}
						</ul>
						{{if and (gt $push.Len 1) $push.CompareURL}}
							<a class="ds-link ds-t-small" href="{{AppSubUrl}}/{{$push.CompareURL}}">{{ctx.Locale.Tr "action.compare_commits" $push.Len}} »</a>
						{{end}}
					{{else if .GetOpType.InActions "create_issue"}}
						<span class="wk-act-title">{{RenderIssueTitle ctx (index .GetIssueInfos 1) (.Repo.ComposeMetas ctx)}}</span>
					{{else if .GetOpType.InActions "create_pull_request"}}
						<span class="wk-act-title">{{RenderIssueTitle ctx (index .GetIssueInfos 1) (.Repo.ComposeMetas ctx)}}</span>
					{{else if .GetOpType.InActions "comment_issue" "approve_pull_request" "reject_pull_request" "comment_pull"}}
						<a href="{{.GetCommentLink ctx}}" class="wk-act-title">{{RenderRefIssueTitle $.Context (.GetIssueTitle ctx)}}</a>
						{{$comment := index .GetIssueInfos 1}}
						{{if $comment}}
							<div class="markup wk-act-comment">{{RenderMarkdownToHtml ctx $comment}}</div>
						{{end}}
					{{else if .GetOpType.InActions "merge_pull_request"}}
						<div class="wk-act-title">{{index .GetIssueInfos 1}}</div>
					{{else if .GetOpType.InActions "close_issue" "reopen_issue" "close_pull_request" "reopen_pull_request"}}
						<span class="wk-act-title">{{RenderIssueTitle ctx (.GetIssueTitle ctx) (.Repo.ComposeMetas ctx)}}</span>
					{{else if .GetOpType.InActions "pull_review_dismissed"}}
						<div class="wk-act-title">{{ctx.Locale.Tr "action.review_dismissed_reason"}}</div>
						<div class="wk-act-title">{{index .GetIssueInfos 2 | RenderEmoji $.Context}}</div>
					{{end}}
				</div>
				<span class="wk-act-ic" aria-hidden="true">{{svg (printf "octicon-%s" (ActionIcon .GetOpType)) 20}}</span>
			</li>
		{{end}}
	</ul>
	{{template "base/paginate" .}}
</div>
