<section class="ds-card" aria-labelledby="sp-gpg">
	<div class="ds-card-h">
		<h2 id="sp-gpg">{{ctx.Locale.Tr "settings.manage_gpg_keys"}}</h2>
		<span class="ds-card-sub">{{ctx.Locale.Tr "settings.gpg_desc"}} {{ctx.Locale.Tr "settings.gpg_helper" "https://docs.codeberg.org/security/gpg-key/"}}</span>
		<button type="button" class="ds-btn ds-btn-primary ds-btn-sm ds-ml-auto show-panel toggle" data-panel="#add-gpg-key-panel">{{ctx.Locale.Tr "settings.add_key"}}</button>
	</div>
	<div class="{{if not .HasGPGError}}tw-hidden{{end}}" id="add-gpg-key-panel">
		<form class="ui form ds-form wk-card-form{{if .HasGPGError}} error{{end}}" action="{{.Link}}" method="post">
			{{.CsrfTokenHtml}}
			<input type="hidden" name="title" value="none">
			<div class="required field ds-field {{if .Err_Content}}error{{end}}">
				<label class="ds-label" for="gpg-key-content">{{ctx.Locale.Tr "settings.key_content"}}</label>
				<textarea id="gpg-key-content" name="content" class="ds-textarea ds-mono{{if .Err_Content}} is-err{{end}}" rows="4" spellcheck="false" placeholder="{{ctx.Locale.Tr "settings.key_content_gpg_placeholder"}}" required>{{.content}}</textarea>
			</div>
			{{if .Err_Signature}}
				<div class="ds-banner ds-banner-err" role="alert"><span aria-hidden="true">{{svg "dsi-alert" 18}}</span><div class="ds-banner-body">{{ctx.Locale.Tr "settings.gpg_token_required"}}</div></div>
				<div class="ds-field">
					<label class="ds-label" for="gpg-token-new">{{ctx.Locale.Tr "settings.gpg_token"}}</label>
					<input id="gpg-token-new" class="ds-input ds-mono" readonly value="{{.TokenToSign}}">
					<p class="ds-hint">{{ctx.Locale.Tr "keys.verify.token.hint" (printf "?verify_gpg=%s" .KeyID)}}</p>
					<p class="ds-hint">{{ctx.Locale.Tr "settings.gpg_token_help"}}</p>
					<p><code class="ds-mono ds-break">{{printf `echo "%s" | gpg -a --default-key %s --detach-sig` .TokenToSign .PaddedKeyID}}</code></p>
				</div>
				<div class="required field ds-field">
					<label class="ds-label" for="gpg-key-signature">{{ctx.Locale.Tr "settings.gpg_token_signature"}}</label>
					<textarea id="gpg-key-signature" name="signature" class="ds-textarea ds-mono" rows="4" spellcheck="false" placeholder="{{ctx.Locale.Tr "settings.key_signature_gpg_placeholder"}}" required>{{.signature}}</textarea>
				</div>
			{{end}}
			<input name="type" type="hidden" value="gpg">
			<div class="ds-row ds-row-wrap">
				<button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "settings.add_key"}}</button>
				<button type="button" class="ds-btn ds-btn-secondary hide-panel" data-panel="#add-gpg-key-panel">{{ctx.Locale.Tr "cancel"}}</button>
			</div>
		</form>
	</div>
	{{if .GPGKeys}}
	<ul class="ds-list wk-rows">
		{{range .GPGKeys}}
			<li class="ds-li wk-row">
				<span class="ds-li-av" aria-hidden="true">{{svg "dsi-key" 20}}</span>
				<div class="ds-li-main">
					<div class="ds-li-title"><span class="ds-mono ds-break">{{.PaddedKeyID}}</span>
						{{if .Verified}}<span class="ds-chip ds-chip-ok" data-tooltip-content="{{ctx.Locale.Tr "settings.gpg_key_verified_long"}}">{{ctx.Locale.Tr "settings.gpg_key_verified"}}</span>{{end}}
						{{if or .ExpiredUnix.IsZero ($.PageStartTime.Before .ExpiredUnix.AsTime)}}{{else}}<span class="ds-chip ds-chip-warn">{{ctx.Locale.Tr "asc_work.sp_expired"}}</span>{{end}}
					</div>
					{{if .Emails}}<div class="ds-li-sub" data-tooltip-content="{{ctx.Locale.Tr "settings.gpg_key_matched_identities_long"}}">{{ctx.Locale.Tr "settings.gpg_key_matched_identities"}} {{range .Emails}}<b>{{.Email}}</b> {{end}}</div>{{end}}
					{{if .SubsKey}}<div class="ds-li-sub">{{ctx.Locale.Tr "settings.subkeys"}}: <span class="ds-mono">{{range .SubsKey}}{{.PaddedKeyID}} {{end}}</span></div>{{end}}
					<div class="ds-li-meta">
						<span>{{ctx.Locale.Tr "settings.added_on" (DateUtils.Day .AddedUnix)}}</span>
						<span>{{if not .ExpiredUnix.IsZero}}{{ctx.Locale.Tr "settings.valid_until_date" (DateUtils.Day .ExpiredUnix)}}{{else}}{{ctx.Locale.Tr "settings.valid_forever"}}{{end}}</span>
					</div>
				</div>
				<div class="wk-row-acts">
					{{if and (not .Verified) (ne $.VerifyingID .KeyID)}}
						<a class="ds-btn ds-btn-secondary ds-btn-sm" href="?verify_gpg={{.KeyID}}">{{ctx.Locale.Tr "settings.gpg_key_verify"}}</a>
					{{end}}
					<button type="button" class="ds-btn ds-btn-danger ds-btn-sm delete-button" data-modal-id="delete-gpg" data-url="{{$.Link}}/delete?type=gpg" data-id="{{.ID}}">{{ctx.Locale.Tr "settings.delete_key"}}</button>
				</div>
			</li>
			{{if and (not .Verified) (eq $.VerifyingID .KeyID)}}
			<li class="ds-li">
				<form class="ui form ds-form ds-stack-16 ds-grow ds-min0{{if $.HasGPGVerifyError}} error{{end}}" action="{{$.Link}}" method="post">
					{{$.CsrfTokenHtml}}
					<h3 class="ds-t-h3">{{ctx.Locale.Tr "settings.gpg_token_required"}}</h3>
					<input type="hidden" name="title" value="none">
					<input type="hidden" name="content" value="{{.KeyID}}">
					<input type="hidden" name="key_id" value="{{.KeyID}}">
					<div class="ds-field">
						<label class="ds-label" for="gpg-token">{{ctx.Locale.Tr "settings.gpg_token"}}</label>
						<input id="gpg-token" class="ds-input ds-mono" readonly value="{{$.TokenToSign}}">
						<p class="ds-hint">{{ctx.Locale.Tr "keys.verify.token.hint" (printf "?verify_gpg=%s" .KeyID)}}</p>
						<p class="ds-hint">{{ctx.Locale.Tr "settings.gpg_token_help"}}</p>
						<p><code class="ds-mono ds-break">{{printf `echo "%s" | gpg -a --default-key %s --detach-sig` $.TokenToSign .PaddedKeyID}}</code></p>
					</div>
					<div class="required field ds-field">
						<label class="ds-label" for="gpg-key-signature">{{ctx.Locale.Tr "settings.gpg_token_signature"}}</label>
						<textarea id="gpg-key-signature" name="signature" class="ds-textarea ds-mono" rows="4" spellcheck="false" placeholder="{{ctx.Locale.Tr "settings.key_signature_gpg_placeholder"}}" required>{{$.signature}}</textarea>
					</div>
					<input name="type" type="hidden" value="verify_gpg">
					<div class="ds-row ds-row-wrap">
						<button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "settings.gpg_key_verify"}}</button>
						<a class="ds-btn ds-btn-secondary" href="{{$.Link}}">{{ctx.Locale.Tr "settings.cancel"}}</a>
					</div>
				</form>
			</li>
			{{end}}
		{{end}}
	</ul>
	{{else}}
		{{template "shared/ds/empty" (dict "Icon" "key" "Title" (ctx.Locale.Tr "asc_work.sp_gpg_empty") "Body" (ctx.Locale.Tr "asc_work.sp_gpg_empty_body"))}}
	{{end}}
	<div class="ui g-modal-confirm delete modal" id="delete-gpg">
		<div class="header">
			{{svg "dsi-trash" 16}}
			{{ctx.Locale.Tr "settings.gpg_key_deletion"}}
		</div>
		<div class="content">
			<p>{{ctx.Locale.Tr "settings.gpg_key_deletion_desc"}}</p>
		</div>
		{{template "base/modal_actions_confirm" .}}
	</div>
</section>
