{{template "user/settings/layout_head" (dict "ctxData" . "pageClass" "ds-main user settings applications wk-settings")}}
{{template "user/settings/page_head" (dict "Title" (ctx.Locale.Tr "settings.generate_new_token") "Lead" (ctx.Locale.Tr "asc_work.sp_token_new_lead"))}}
<div class="wk-sp">
	<form id="scoped-access-form" class="ui form ds-form wk-sp-form" action="{{.Link}}" method="post">
		{{.CsrfTokenHtml}}
		<section class="ds-card" aria-labelledby="sp-token-name">
			<div class="ds-card-h"><h2 id="sp-token-name">{{ctx.Locale.Tr "settings.token_name"}}</h2></div>
			<div class="ds-card-b ds-stack-16">
				<div class="required field ds-field {{if .Err_Name}}error{{end}}">
					<label class="ds-label" for="name">{{ctx.Locale.Tr "settings.token_name"}}</label>
					<input id="name" class="ds-input{{if .Err_Name}} is-err{{end}}" name="name" value="{{.name}}" {{if eq .Autofocus "name"}}autofocus{{end}} required maxlength="255">
				</div>
				<div class="ds-field">
					<label class="ds-label" for="expires">{{ctx.Locale.Tr "settings.token_expires"}}</label>
					<select id="expires" class="ds-select" name="expires">
						{{range .ExpiryChoices}}<option value="{{.}}"{{if eq (printf "%d" .) $.expires}} selected{{end}}>{{ctx.Locale.Tr "settings.token_expires_in" .}}</option>{{end}}
						<option value="never"{{if eq $.expires "never"}} selected{{end}}>{{ctx.Locale.Tr "settings.token_expires_never"}}</option>
					</select>
					<span class="ds-hint">{{ctx.Locale.Tr "settings.token_expires_help"}}</span>
				</div>
			</div>
		</section>

		<section class="ds-card" aria-labelledby="sp-token-access">
			<div class="ds-card-h"><h2 id="sp-token-access">{{ctx.Locale.Tr "settings.repo_and_org_access"}}</h2></div>
			<div class="ds-card-b ds-stack-16">
				<fieldset class="wk-fieldset">
					<legend class="ds-sr">{{ctx.Locale.Tr "settings.repo_and_org_access"}}</legend>
					<div class="wk-radio-cards">
						<label class="wk-radio-card" for="resource-all">
							<input id="resource-all" class="enable-system" type="radio" name="resource" value="all" {{if eq .resource "all"}}checked{{end}}>
							<span><b>{{ctx.Locale.Tr "settings.permissions_access_all"}}</b><span class="ds-hint">{{ctx.Locale.Tr "settings.access_token.resource_all_help"}}</span></span>
						</label>
						<label class="wk-radio-card" for="resource-public-only">
							<input id="resource-public-only" class="enable-system" type="radio" name="resource" value="public-only" {{if eq .resource "public-only"}}checked{{end}}>
							<span><b>{{ctx.Locale.Tr "settings.permissions_public_only"}}</b><span class="ds-hint">{{ctx.Locale.Tr "settings.access_token.resource_public_only_help"}}{{if $.IsAdmin}} {{ctx.Locale.Tr "settings.access_token.admin_disabled"}}{{end}}</span></span>
						</label>
						<label class="wk-radio-card" for="resource-repo-specific">
							<input id="resource-repo-specific" class="enable-system" type="radio" name="resource" value="repo-specific" {{if eq .resource "repo-specific"}}checked{{end}}>
							<span><b>{{ctx.Locale.Tr "settings.permissions_access_specific_repositories"}}</b><span class="ds-hint">{{ctx.Locale.Tr "settings.access_token.resource_specific_repo_help"}}{{if $.IsAdmin}} {{ctx.Locale.Tr "settings.access_token.admin_disabled"}}{{end}}</span></span>
						</label>
					</div>
				</fieldset>
				<div id="repo-selector-wrapper" role="group">
					<div id="repo-selector" class="wk-repo-selector">
						<!-- left-hand side: repo list from a search -->
						<div class="ui tab active list">
							<h3 class="ds-t-h3">{{ctx.Locale.Tr "settings.access_token.available_repositories"}}</h3>
							<div class="wk-inline-field">
								<input class="ds-input" type="search" name="repo_search" spellcheck="false" {{if eq .Autofocus "search"}}autofocus{{end}} placeholder="{{ctx.Locale.Tr "search.repo_kind"}}" aria-label="{{ctx.Locale.Tr "search.repo_kind"}}" value="{{.repo_search}}">
								<button class="ds-btn ds-btn-secondary" aria-label="{{ctx.Locale.Tr "search.search"}}" type="submit" name="set_page" value="1" formnovalidate="true" formmethod="get">{{ctx.Locale.Tr "search.search"}}</button>
							</div>
							{{if eq (len .Repos) 0}}
								<p class="ds-hint">{{ctx.Locale.Tr "settings.access_token.no_repositories_found"}}</p>
							{{else}}
								<ul class="ds-list wk-rows wk-repo-rows">
									{{range .Repos}}
										<li class="ds-li wk-row">
											<div class="ds-li-main"><div class="ds-li-title"><span class="ds-break">{{.FullName}}</span></div></div>
											<button class="ds-btn ds-btn-secondary ds-btn-sm" type="submit" aria-label="{{ctx.Locale.Tr "repo.editor.add" .FullName}}" formnovalidate="true" name="add_selected_repo" value="{{.FullName}}" formmethod="get">{{ctx.Locale.Tr "add"}}</button>
										</li>
									{{end}}
								</ul>
							{{end}}

							{{/* Can't use base/paginate template include here because all the pagination links in
							that template are simple <a href=...> links.  Here, we need to turn them into form
							buttons so that we can submit the current form.  If a user just changed a value (eg. set
							the token name, changed a selected permission) and then clicked a pagination button, the
							new value that they changed needs to be submitted.  base/paginate would allow preserving
							old values from before the change, but not new updates. */}}
							{{with .Page.Paginater}}
								<input type="hidden" name="page" value="{{.Current}}">
								<nav class="ds-row ds-row-wrap wk-pager" aria-label="{{ctx.Locale.Tr "asc_shell.pagination"}}">
									<button class="ds-btn ds-btn-secondary ds-btn-sm" type="submit" {{if not .HasPrevious}}disabled{{end}} formnovalidate="true" name="set_page" value="{{.Previous}}" formmethod="get">{{ctx.Locale.Tr "repo.issues.previous"}}</button>
									{{range .Pages}}
										{{if eq .Num -1}}
											<span aria-hidden="true">...</span>
										{{else}}
											<button class="ds-btn ds-btn-sm {{if .IsCurrent}}ds-btn-primary{{else}}ds-btn-secondary{{end}}" type="submit" formnovalidate="true" name="set_page" value="{{.Num}}" formmethod="get" {{if .IsCurrent}}aria-current="page"{{end}}>{{.Num}}</button>
										{{end}}
									{{end}}
									<button class="ds-btn ds-btn-secondary ds-btn-sm" type="submit" {{if not .HasNext}}disabled{{end}} formnovalidate="true" name="set_page" value="{{.Next}}" formmethod="get">{{ctx.Locale.Tr "repo.issues.next"}}</button>
								</nav>
							{{end}}
						</div>

						<!-- right-hand side: selected repositories -->
						<div>
							<h3 class="ds-t-h3">{{ctx.Locale.TrPluralString (len .SelectedRepos) "settings.access_token.selected_repositories" (len .SelectedRepos)}}</h3>
							{{if eq (len .SelectedRepos) 0}}
								<p class="ds-hint">{{ctx.Locale.Tr "settings.access_token.no_repositories_selected"}}</p>
							{{else}}
								<ul class="ds-list wk-rows wk-repo-rows">
									{{range .SelectedRepos}}
										<li class="ds-li wk-row">
											<input type="hidden" name="selected_repo" value="{{.FullName}}">
											<div class="ds-li-main"><div class="ds-li-title"><span class="ds-break">{{.FullName}}</span></div></div>
											<button class="ds-btn ds-btn-secondary ds-btn-sm" type="submit" aria-label="{{ctx.Locale.Tr "settings.access_token.remove" .FullName}}" formnovalidate="true" name="remove_selected_repo" value="{{.FullName}}" formmethod="get">{{ctx.Locale.Tr "remove"}}</button>
										</li>
									{{end}}
								</ul>
							{{end}}
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="ds-card" aria-labelledby="sp-token-scopes">
			<div class="ds-card-h"><h2 id="sp-token-scopes">{{ctx.Locale.Tr "settings.select_permissions"}}</h2><span class="ds-card-sub">{{ctx.Locale.Tr "settings.access_token_desc" (printf "%s/api/swagger" AppSubUrl) "https://forgejo.org/docs/latest/user/token-scope/"}}</span></div>
			<div class="ds-card-b">
				<div class="wk-scope-grid">
					{{range .Categories}}
						<div class="ds-field access-token-category">
							<label class="ds-label category-label" for="access-token-scope-{{.}}">{{with index $.CategoryLabels .}}{{.}}{{else}}{{.}}{{end}}</label>
							<select class="ds-select access-token-select" name="scope" id="access-token-scope-{{.}}">
								<option value="">{{ctx.Locale.Tr "settings.permission_no_access"}}</option>
								<option value="read:{{.}}" {{if (SliceUtils.Contains $.scope (printf "read:%s" .))}} selected {{end}}>{{ctx.Locale.Tr "settings.permission_read"}}</option>
								<option value="write:{{.}}" {{if (SliceUtils.Contains $.scope (printf "write:%s" .))}} selected {{end}}>{{ctx.Locale.Tr "settings.permission_write"}}</option>
							</select>
						</div>
					{{end}}
				</div>
			</div>
		</section>

		<div class="ds-sticky-actions wk-form-actions">
			<a class="ds-btn ds-btn-secondary" href="{{AppSubUrl}}/user/settings/applications">{{ctx.Locale.Tr "cancel"}}</a>
			<button id="scoped-access-submit" class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "settings.generate_token"}}</button>
		</div>
	</form>
</div>
{{template "user/settings/layout_footer" .}}
