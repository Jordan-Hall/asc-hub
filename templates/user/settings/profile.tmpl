{{template "user/settings/layout_head" (dict "ctxData" . "pageClass" "ds-main user settings profile wk-settings")}}
{{template "user/settings/page_head" (dict "Title" (ctx.Locale.Tr "settings.profile") "Lead" (ctx.Locale.Tr "asc_work.sp_profile_lead"))}}
<div class="wk-sp">
	<form id="avatar-settings" class="ui form ds-form wk-sp-form" action="{{.Link}}/avatar" method="post" enctype="multipart/form-data">
		{{.CsrfTokenHtml}}
		<section class="ds-card" aria-labelledby="sp-photo">
			<div class="ds-card-h"><h2 id="sp-photo">{{ctx.Locale.Tr "asc_work.sp_photo"}}</h2><span class="ds-card-sub">{{ctx.Locale.Tr "asc_work.sp_photo_hint"}}</span></div>
			<div class="ds-card-b ds-stack-16">
				<div class="wk-avatar-row">
					<span class="wk-avatar-now wk-avatar-round" id="avatar-now">{{ctx.AvatarUtils.Avatar .SignedUser 96}}</span>
					<div class="ds-stack-12 ds-grow ds-min0">
						<input type="hidden" name="source" value="local">
						<div class="ds-row ds-row-wrap">
							<label class="ds-btn ds-btn-secondary" for="new-avatar">{{svg "dsi-upload" 16}} {{ctx.Locale.Tr "asc_work.sp_photo_upload"}}</label>
							<input id="new-avatar" class="tw-sr-only" name="avatar" type="file" data-asc-autosubmit data-image-preview="avatar-now" accept="image/png,image/jpeg,image/gif,image/webp">
							{{if .SignedUser.UseCustomAvatar}}<button class="ds-btn ds-btn-ghost link-action" type="button" data-url="{{.Link}}/avatar/delete">{{ctx.Locale.Tr "asc_work.sp_photo_remove"}}</button>{{end}}
						</div>
						<p class="ds-hint">{{ctx.Locale.Tr "avatar.constraints_hint" (ctx.Locale.TrSize .MaxAvatarFileSize) .MaxAvatarWidth .MaxAvatarHeight}}</p>
						{{if not .DisableGravatar}}
							<details>
								<summary class="ds-link">{{ctx.Locale.Tr "settings.lookup_avatar_by_mail"}}</summary>
								<div class="ds-field {{if .Err_Gravatar}}error{{end}}">
									<label class="ds-label" for="gravatar">{{ctx.Locale.Tr "asc_work.sp_avatar_email"}}</label>
									<input id="gravatar" class="ds-input{{if .Err_Gravatar}} is-err{{end}}" name="gravatar" value="{{.SignedUser.AvatarEmail}}">
								</div>
								<button class="ds-btn ds-btn-secondary" name="source" value="lookup">{{ctx.Locale.Tr "settings.update_avatar"}}</button>
							</details>
						{{end}}
					</div>
				</div>
			</div>
		</section>
	</form>
	<form id="profile-form" class="ui form ds-form wk-sp-form" action="{{.Link}}" method="post">
		{{.CsrfTokenHtml}}
		<section class="ds-card" aria-labelledby="sp-public">
			<div class="ds-card-h"><h2 id="sp-public">{{ctx.Locale.Tr "settings.public_profile"}}</h2><span class="ds-card-sub">{{ctx.Locale.Tr "settings.profile_desc"}}</span></div>
			<div class="ds-card-b ds-stack-16">
				<div class="ds-form-row">
					<div class="ds-field {{if .Err_FullName}}error{{end}}">
						<label class="ds-label" for="full_name">{{ctx.Locale.Tr "asc_work.sp_display_name"}}</label>
						<input id="full_name" class="ds-input" name="full_name" value="{{.SignedUser.FullName}}" maxlength="100">
					</div>
					<div class="ds-field {{if .Err_Name}}error{{end}}">
						<label class="ds-label" for="username">{{ctx.Locale.Tr "username"}}</label>
						<input id="username" class="ds-input{{if .Err_Name}} is-err{{end}}" name="name" value="{{.SignedUser.Name}}" data-name="{{.SignedUser.Name}}" autofocus required {{if or .UserRenameDisabled .IsReverseProxy}}disabled{{end}} maxlength="40">
						<p class="ds-hint">
							{{if or .UserRenameDisabled .IsReverseProxy}}
								{{ctx.Locale.Tr "settings.password_username_disabled"}}
							{{else}}
								{{ctx.Locale.Tr "settings.change_username_prompt"}}
								{{if gt .CooldownPeriod 0}}
									{{ctx.Locale.TrN .CooldownPeriod "settings.change_username_redirect_prompt.with_cooldown.one" "settings.change_username_redirect_prompt.with_cooldown.few" .CooldownPeriod}}
								{{else}}
									{{ctx.Locale.Tr "settings.change_username_redirect_prompt"}}
								{{end}}
							{{end}}
						</p>
					</div>
				</div>
				<div class="ds-field {{if .Err_Biography}}error{{end}}">
					<label class="ds-label" for="biography">{{ctx.Locale.Tr "user.user_bio"}}</label>
					<textarea id="biography" class="ds-textarea" name="biography" rows="3" placeholder="{{ctx.Locale.Tr "settings.biography_placeholder"}}" maxlength="255">{{.SignedUser.Description}}</textarea>
				</div>
				<div class="ds-form-row ds-form-row-2">
					<div class="ds-field" id="label-pronouns">
						<label class="ds-label" for="pronouns-input">{{ctx.Locale.Tr "settings.pronouns"}}</label>
						<input id="pronouns-input" class="ds-input" name="pronouns" list="pronouns" placeholder="{{ctx.Locale.Tr "settings.pronouns_unspecified"}}" value="{{.SignedUser.Pronouns}}" maxlength="50">
						<datalist id="pronouns">
							{{range .CommonPronouns}}
								<option value="{{.}}"></option>
							{{end}}
						</datalist>
					</div>
					<div class="ds-field">
						<label class="ds-label" for="location">{{ctx.Locale.Tr "settings.location"}}</label>
						<input id="location" class="ds-input" name="location" placeholder="{{ctx.Locale.Tr "settings.location_placeholder"}}" value="{{.SignedUser.Location}}" maxlength="50">
					</div>
				</div>
				<div class="ds-field {{if .Err_Website}}error{{end}}">
					<label class="ds-label" for="website">{{ctx.Locale.Tr "settings.website"}}</label>
					<input id="website" class="ds-input" name="website" type="url" value="{{.SignedUser.Website}}" maxlength="255" pattern="{{.ValidSiteURLPattern}}">
					<p class="ds-hint">{{ctx.Locale.Tr "form.website.valid_url_schemes" (StringUtils.Join .ValidSiteURLSchemes ", ")}}</p>
				</div>
				<div class="wk-preview wk-preview-inline" data-preview-form="profile-form" role="group" aria-labelledby="sp-preview">
					<p class="ds-t-eyebrow" id="sp-preview">{{ctx.Locale.Tr "asc_work.sp_preview_title"}}</p>
					<div class="ds-card-b wk-preview-body">
						<span class="wk-preview-avatar">{{ctx.AvatarUtils.Avatar .SignedUser 48}}</span>
						<div class="ds-min0">
							<b class="wk-preview-name" data-preview-field="full_name" data-preview-fallback="name"></b>
							<div class="ds-hint">@<span data-preview-field="name"></span><span data-preview-field="pronouns" data-preview-empty class="wk-preview-sep"></span></div>
							<p class="wk-preview-bio" data-preview-field="biography" data-preview-empty></p>
							<div class="ds-hint" data-preview-field="location" data-preview-empty></div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="ds-card" aria-labelledby="sp-contact">
			<div class="ds-card-h"><h2 id="sp-contact">{{ctx.Locale.Tr "asc_work.sp_contact"}}</h2><span class="ds-card-sub">{{ctx.Locale.Tr "asc_work.sp_contact_hint"}}</span></div>
			<div class="ds-card-b ds-stack-16">
				<div class="ds-field">
					<label class="ds-label" for="public-email">{{ctx.Locale.Tr "asc_work.sp_public_email"}}</label>
					<select class="ds-select" id="public-email" name="keep_email_private">
						<option value="on"{{if .SignedUser.KeepEmailPrivate}} selected{{end}}>{{ctx.Locale.Tr "asc_work.sp_email_hidden"}}</option>
						<option value=""{{if not .SignedUser.KeepEmailPrivate}} selected{{end}}>{{.SignedUser.Email}}</option>
					</select>
					<div class="ds-hint">{{ctx.Locale.Tr "asc_work.sp_public_email_hint"}}</div>
				</div>
				<div class="ds-field">
					<label class="ds-label" for="profile-tz">{{ctx.Locale.Tr "asc_work.sp_tz"}}</label>
					<select class="ds-select" id="profile-tz" name="tz">
						<option value=""{{if not .TimeZone}} selected{{end}}>UTC</option>
						{{range .TimeZones}}{{if ne . "UTC"}}<option{{if eq . $.TimeZone}} selected{{end}}>{{.}}</option>{{end}}{{end}}
					</select>
					<div class="ds-hint">{{ctx.Locale.Tr "asc_work.sp_tz_hint"}}</div>
				</div>
			</div>
		</section>

		<section class="ds-card" aria-labelledby="privacy-user-settings">
			<div class="ds-card-h"><h2 id="privacy-user-settings">{{ctx.Locale.Tr "settings.privacy"}}</h2><span class="ds-card-sub">{{ctx.Locale.Tr "asc_work.sp_visibility_hint"}}</span></div>
			<div class="ds-card-b ds-stack-16">
				<fieldset id="visibility-setting" class="wk-fieldset {{if .Err_Visibility}}error{{end}}">
					<legend class="ds-label">{{ctx.Locale.Tr "settings.visibility"}}</legend>
					<div class="wk-radio-cards">
						{{range $mode := .AllowedUserVisibilityModes}}
							{{if $mode.IsPublic}}
								<label class="wk-radio-card"><input type="radio" name="visibility" value="0" {{if $.SignedUser.Visibility.IsPublic}}checked{{end}}><span><b>{{ctx.Locale.Tr "settings.visibility.public"}}</b><span class="ds-hint">{{ctx.Locale.Tr "settings.visibility.public_tooltip"}}</span></span></label>
							{{else if $mode.IsLimited}}
								<label class="wk-radio-card"><input type="radio" name="visibility" value="1" {{if $.SignedUser.Visibility.IsLimited}}checked{{end}}><span><b>{{ctx.Locale.Tr "settings.visibility.limited"}}</b><span class="ds-hint">{{ctx.Locale.Tr "settings.visibility.limited_tooltip"}}</span></span></label>
							{{else if $mode.IsPrivate}}
								<label class="wk-radio-card"><input type="radio" name="visibility" value="2" {{if $.SignedUser.Visibility.IsPrivate}}checked{{end}}><span><b>{{ctx.Locale.Tr "settings.visibility.private"}}</b><span class="ds-hint">{{ctx.Locale.Tr "settings.visibility.private_tooltip"}}</span></span></label>
							{{end}}
						{{end}}
					</div>
					<p class="ds-hint">{{ctx.Locale.Tr "settings.visibility.description" "https://forgejo.org/docs/latest/user/repo-permissions/#profile-and-visibility"}}</p>
				</fieldset>

				<div class="wk-switch-rows">
					{{if .SignedUser.KeepActivityPrivate}}<input type="hidden" name="keep_activity_private" value="on">{{end}}
					<label class="ds-switch wk-switch-row">
						<input name="keep_pronouns_private" type="checkbox" role="switch" {{if .SignedUser.KeepPronounsPrivate}}checked{{end}}>
						<span class="ds-switch-track"></span>
						<span class="wk-switch-text"><b>{{ctx.Locale.Tr "settings.keep_pronouns_private"}}</b><span class="ds-hint">{{ctx.Locale.Tr "settings.keep_pronouns_private.description"}}</span></span>
					</label>
				</div>
			</div>
		</section>

		<div class="ds-savebar wk-form-actions" data-savebar data-savebar-one="{{ctx.Locale.Tr "asc_rp.unsaved_one"}}" data-savebar-n="{{ctx.Locale.Tr "asc_rp.unsaved_n"}}">
			<span class="ds-savebar-note" data-savebar-note aria-live="polite"></span>
			<button type="button" class="ds-btn ds-btn-secondary" data-savebar-discard>{{ctx.Locale.Tr "asc_work.discard"}}</button>
			<button class="ds-btn ds-btn-primary" data-savebar-submit disabled>{{ctx.Locale.Tr "settings.update_profile"}}</button>
		</div>
	</form>
</div>
{{template "user/settings/layout_footer" .}}
