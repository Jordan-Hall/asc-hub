{{template "user/settings/layout_head" (dict "ctxData" . "pageClass" "ds-main user settings twofa wk-settings" "HideNavbarLinks" .HideNavbarLinks)}}
{{$title := ctx.Locale.Tr "settings.twofa_enroll"}}{{if .ReenrollTwofa}}{{$title = ctx.Locale.Tr "settings.twofa_reenroll"}}{{end}}
{{template "user/settings/page_head" (dict "Title" $title "Lead" (ctx.Locale.Tr "settings.scan_this_image"))}}
<div class="wk-sp">
	<section class="ds-card" aria-labelledby="sp-enroll">
		<div class="ds-card-h"><h2 id="sp-enroll">{{ctx.Locale.Tr "asc_work.sp_authenticator"}}</h2></div>
		<div class="ds-card-b ds-stack-16">
			<div class="wk-qr"><img src="{{.QrUri}}" alt="{{.TwofaSecret}}" width="200" height="200"></div>
			<p class="ds-hint">{{ctx.Locale.Tr "settings.or_enter_secret" .TwofaSecret}}</p>
			<form class="ui form ds-form ds-stack-16" action="{{.Link}}" method="post">
				{{.CsrfTokenHtml}}
				<div class="required field ds-field {{if .Err_Passcode}}error{{end}}">
					<label class="ds-label" for="passcode">{{ctx.Locale.Tr "passcode"}}</label>
					<input id="passcode" class="ds-input{{if .Err_Passcode}} is-err{{end}}" name="passcode" inputmode="numeric" autocomplete="one-time-code" autofocus required>
					<p class="ds-hint">{{ctx.Locale.Tr "settings.then_enter_passcode"}}</p>
				</div>
				<div class="ds-row ds-row-wrap">
					<button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "auth.verify"}}</button>
					<a class="ds-btn ds-btn-secondary" href="{{AppSubUrl}}/user/settings/security">{{ctx.Locale.Tr "cancel"}}</a>
				</div>
			</form>
		</div>
	</section>
</div>
{{template "user/settings/layout_footer" .}}
