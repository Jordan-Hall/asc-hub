<section class="ds-card" aria-labelledby="sp-openid">
	<div class="ds-card-h"><h2 id="sp-openid">{{ctx.Locale.Tr "settings.manage_openid"}}</h2><span class="ds-card-sub">{{ctx.Locale.Tr "settings.openid_desc"}}</span></div>
	{{if .OpenIDs}}
	<ul class="ds-list wk-rows">
		{{range .OpenIDs}}
			<li class="ds-li wk-row">
				<span class="ds-li-av" aria-hidden="true">{{svg "fontawesome-openid" 20}}</span>
				<div class="ds-li-main">
					<div class="ds-li-title"><span class="ds-break">{{.URI}}</span></div>
				</div>
				<div class="wk-row-acts">
					<form action="{{AppSubUrl}}/user/settings/security/openid/toggle_visibility" method="post">
						{{$.CsrfTokenHtml}}
						<input name="id" type="hidden" value="{{.ID}}">
						{{if .Show}}
							<button class="ds-btn ds-btn-secondary ds-btn-sm"><span aria-hidden="true">{{svg "dsi-eye" 16}}</span> {{ctx.Locale.Tr "settings.hide_openid"}}</button>
						{{else}}
							<button class="ds-btn ds-btn-secondary ds-btn-sm"><span aria-hidden="true">{{svg "dsi-eye" 16}}</span> {{ctx.Locale.Tr "settings.show_openid"}}</button>
						{{end}}
					</form>
					<button type="button" class="ds-btn ds-btn-danger ds-btn-sm delete-button" data-modal-id="delete-openid" data-url="{{AppSubUrl}}/user/settings/security/openid/delete" data-id="{{.ID}}">{{ctx.Locale.Tr "settings.delete_key"}}</button>
				</div>
			</li>
		{{end}}
	</ul>
	{{end}}
	<form class="ui form ds-form wk-card-form" action="{{AppSubUrl}}/user/settings/security/openid" method="post">
		{{.CsrfTokenHtml}}
		<div class="required field ds-field {{if .Err_OpenID}}error{{end}}">
			<label class="ds-label" for="openid">{{ctx.Locale.Tr "settings.add_new_openid"}}</label>
			<div class="wk-inline-field">
				<input id="openid" class="ds-input{{if .Err_OpenID}} is-err{{end}}" name="openid" type="text" required>
				<button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "settings.add_openid"}}</button>
			</div>
		</div>
	</form>
	<div class="ui g-modal-confirm delete modal" id="delete-openid">
		<div class="header">
			{{svg "dsi-trash" 18}}
			{{ctx.Locale.Tr "settings.openid_deletion"}}
		</div>
		<div class="content">
			<p>{{ctx.Locale.Tr "settings.openid_deletion_desc"}}</p>
		</div>
		{{template "base/modal_actions_confirm" .}}
	</div>
</section>
