<section class="ds-card" aria-labelledby="sp-twofa">
	<div class="ds-card-h"><h2 id="sp-twofa">{{ctx.Locale.Tr "settings.twofa"}}</h2><span class="ds-card-sub">{{ctx.Locale.Tr "settings.twofa_desc"}}</span></div>
	<ul class="ds-list wk-rows">
		{{if .TOTPEnrolled}}
		<li class="ds-li wk-row">
			<div class="ds-li-main">
				<div class="ds-li-title"><span>{{ctx.Locale.Tr "asc_work.sp_authenticator"}}</span><span class="ds-chip ds-chip-ok">{{ctx.Locale.Tr "asc_work.sp_on"}}</span></div>
				<div class="ds-li-sub">{{ctx.Locale.Tr "settings.twofa_is_enrolled"}} {{ctx.Locale.Tr "settings.twofa_reenroll.description"}}</div>
			</div>
			<div class="wk-row-acts">
				<a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{AppSubUrl}}/user/settings/security/two_factor/reenroll">{{ctx.Locale.Tr "settings.twofa_reenroll"}}</a>
			</div>
		</li>
		<li class="ds-li wk-row">
			<div class="ds-li-main">
				<div class="ds-li-title"><span>{{ctx.Locale.Tr "asc_work.sp_recovery"}}</span></div>
				<div class="ds-li-sub">{{ctx.Locale.Tr "settings.regenerate_scratch_token_desc"}}</div>
			</div>
			<div class="wk-row-acts">
				<form action="{{AppSubUrl}}/user/settings/security/two_factor/regenerate_scratch" method="post" enctype="multipart/form-data">
					{{.CsrfTokenHtml}}
					<button class="ds-btn ds-btn-secondary ds-btn-sm">{{ctx.Locale.Tr "settings.twofa_scratch_token_regenerate"}}</button>
				</form>
			</div>
		</li>
		{{if .SignedUser.MustHaveTwoFactor}}
			<li class="ds-li"><p class="ds-hint">{{ctx.Locale.Tr "settings.twofa_unroll_unavailable"}}</p></li>
		{{else}}
		<li class="ds-li wk-row">
			<div class="ds-li-main">
				<div class="ds-li-title"><span>{{ctx.Locale.Tr "settings.twofa_disable"}}</span></div>
				<div class="ds-li-sub">{{ctx.Locale.Tr "settings.twofa_disable_note"}}</div>
			</div>
			<div class="wk-row-acts">
				<form class="ui form" action="{{AppSubUrl}}/user/settings/security/two_factor/disable" method="post" enctype="multipart/form-data" id="disable-form">
					{{.CsrfTokenHtml}}
					<button type="button" class="ds-btn ds-btn-danger ds-btn-sm delete-button" data-modal-id="disable-twofa" data-type="form" data-form="#disable-form">{{ctx.Locale.Tr "settings.twofa_disable"}}</button>
				</form>
			</div>
		</li>
		{{end}}
		{{else}}
		{{/* The recovery tip is there as a means of encouraging a user to enroll */}}
		<li class="ds-li wk-row">
			<div class="ds-li-main">
				<div class="ds-li-title"><span>{{ctx.Locale.Tr "asc_work.sp_authenticator"}}</span><span class="ds-chip">{{ctx.Locale.Tr "asc_work.sp_off"}}</span></div>
				<div class="ds-li-sub">{{ctx.Locale.Tr "settings.twofa_not_enrolled"}}</div>
				<div class="ds-li-sub">{{ctx.Locale.Tr "settings.twofa_recovery_tip"}}</div>
			</div>
			<div class="wk-row-acts">
				<a class="ds-btn ds-btn-primary ds-btn-sm" href="{{AppSubUrl}}/user/settings/security/two_factor/enroll">{{ctx.Locale.Tr "settings.twofa_enroll"}}</a>
			</div>
		</li>
		{{end}}
	</ul>
	<div class="ui g-modal-confirm delete modal" id="disable-twofa">
		<div class="header">
			{{svg "dsi-trash" 18}}
			{{ctx.Locale.Tr "settings.twofa_disable"}}
		</div>
		<div class="content">
			<p>{{ctx.Locale.Tr "settings.twofa_disable_desc"}}</p>
		</div>
		{{template "base/modal_actions_confirm" .}}
	</div>
</section>
