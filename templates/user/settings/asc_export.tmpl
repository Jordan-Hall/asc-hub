{{template "user/settings/layout_head" (dict "ctxData" . "pageClass" "ds-main user settings asc-trust-page wk-settings")}}
{{template "user/settings/page_head" (dict "Title" (ctx.Locale.Tr "asc_shell.export_title") "Lead" (ctx.Locale.Tr "asc_shell.export_lead"))}}
<div class="wk-sp">
{{with .AscExport}}
<div class="ds-stack-16" data-testid="asc-export">
	{{if .Unsupported}}
		<div class="ds-banner ds-banner-warn" role="status" data-testid="asc-export-unsupported"><span aria-hidden="true">{{svg "dsi-alert" 18}}</span><div class="ds-banner-body">{{ctx.Locale.Tr "asc_shell.export_unsupported"}}</div></div>
	{{else}}
		{{if .Problem}}<div class="ds-banner ds-banner-err" role="alert" data-testid="asc-export-problem"><span aria-hidden="true">{{svg "dsi-alert" 18}}</span><div class="ds-banner-body">{{.Problem}}</div></div>{{else}}
		<section class="ds-card" aria-labelledby="asc-export-list">
			<div class="ds-card-h">
				<h2 id="asc-export-list">{{ctx.Locale.Tr "asc_shell.export_title"}}</h2>
				{{if not .Busy}}
				<form class="ds-ml-auto" method="post" action="{{.URL}}" data-testid="asc-export-request">
					{{$.CsrfTokenHtml}}
					<input type="hidden" name="op" value="{{.RequestOp}}">
					<button class="ds-btn ds-btn-primary" type="submit">{{ctx.Locale.Tr "asc_shell.export_request"}}</button>
				</form>
				{{end}}
			</div>
			{{if .Busy}}<div class="ds-card-b"><p class="ds-hint" role="status" data-testid="asc-export-busy">{{ctx.Locale.Tr "asc_shell.export_busy"}}</p></div>{{end}}
			<ul class="ds-list wk-rows" data-testid="asc-export-list">
				{{range .Rows}}
				<li class="ds-li wk-row" data-state="{{.State}}">
					<span class="ds-li-av" aria-hidden="true">{{svg "dsi-download" 20}}</span>
					<div class="ds-li-main">
						<div class="ds-li-title">
							<span class="ds-chip {{if eq .State "ready"}}ds-chip-ok{{else if eq .State "failed"}}ds-chip-err{{else if eq .State "expired"}}ds-chip-warn{{end}}">{{if eq .State "pending"}}{{ctx.Locale.Tr "asc_shell.export_state_pending"}}{{else if eq .State "running"}}{{ctx.Locale.Tr "asc_shell.export_state_running"}}{{else if eq .State "ready"}}{{ctx.Locale.Tr "asc_shell.export_state_ready"}}{{else if eq .State "failed"}}{{ctx.Locale.Tr "asc_shell.export_state_failed"}}{{else}}{{ctx.Locale.Tr "asc_shell.export_state_expired"}}{{end}}</span>
							{{if .Truncated}}<span class="ds-chip ds-chip-warn">{{ctx.Locale.Tr "asc_shell.export_truncated"}}</span>{{end}}
						</div>
						<div class="ds-li-meta">
							{{if not .Requested.IsZero}}<span>{{ctx.Locale.Tr "asc_shell.export_requested" (DateUtils.TimeSince .Requested)}}</span>{{end}}
							{{if eq .State "ready"}}
								<span>{{ctx.Locale.TrSize .Size}}</span>
								<span>{{ctx.Locale.Tr "asc_shell.export_rows" .Rows}}</span>
								{{if not .Expires.IsZero}}<span>{{ctx.Locale.Tr "asc_shell.export_expires" (DateUtils.Day .Expires)}}</span>{{end}}
							{{end}}
						</div>
						{{if .Error}}<p class="ds-hint ds-break">{{.Error}}</p>{{end}}
					</div>
					<div class="wk-row-acts">
						{{if .Downloadable $.AscExport.Now}}<a class="ds-btn" href="{{$.AscExport.URL}}/{{.ID}}" download>{{ctx.Locale.Tr "asc_shell.export_download"}}</a>{{end}}
						<form method="post" action="{{$.AscExport.URL}}/{{.ID}}/delete">
							{{$.CsrfTokenHtml}}
							<input type="hidden" name="op" value="{{index $.AscExport.DeleteOps .ID}}">
							<button class="ds-btn ds-btn-danger" type="submit" aria-label="{{ctx.Locale.Tr "asc_shell.export_delete_for" (DateUtils.Day .Requested)}}">{{ctx.Locale.Tr "asc_shell.export_delete"}}</button>
						</form>
					</div>
				</li>
				{{else}}
				<li class="ds-li" data-testid="asc-export-empty"><p class="ds-hint">{{ctx.Locale.Tr "asc_shell.export_none"}}</p></li>
				{{end}}
			</ul>
		</section>
		{{end}}
	{{end}}
</div>
{{end}}
</div>
{{template "user/settings/layout_footer" .}}
