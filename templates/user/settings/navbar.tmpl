{{/*
The settings menu (board A2 "settings side list", Mobile-UserSettingsMenu): the left column on a desktop, a page of its own on a phone (opens from #settings-menu).
Entries use shared/ds/snav_item; groups are headings, never colour.
*/}}
{{if not .HideNavbarLinks}}
{{$base := print AppSubUrl "/user/settings"}}
{{$keysLabel := ctx.Locale.Tr "settings.gpg_keys"}}{{if SSHEnabled}}{{$keysLabel = ctx.Locale.Tr "settings.ssh_gpg_keys"}}{{end}}
<nav class="ds-settings-nav" id="settings-menu" aria-label="{{ctx.Locale.Tr "user.settings"}}">
	{{template "shared/ds/snav_bar" (dict "Title" (ctx.Locale.Tr "user.settings"))}}
	<div class="ds-settings-nav-in">
		{{template "shared/ds/snav_who" (dict "Entity" .SignedUser "Name" (or .SignedUser.FullName .SignedUser.Name) "Sub" (print "@" .SignedUser.Name) "Href" .SignedUser.HomeLink "Label" (ctx.Locale.Tr "your_profile"))}}

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_account"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" $base "Label" (ctx.Locale.Tr "settings.profile") "Icon" "user" "Active" .PageIsSettingsProfile)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/account") "Label" (ctx.Locale.Tr "settings.account") "Icon" "mail" "Active" .PageIsSettingsAccount)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/appearance") "Label" (ctx.Locale.Tr "settings.appearance") "Icon" "palette" "Active" .PageIsSettingsAppearance)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/notifications") "Label" (ctx.Locale.Tr "asc_work.sn_notifications") "Icon" "bell" "Active" .PageIsSettingsNotifications)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/privacy") "Label" (ctx.Locale.Tr "asc_work.sn_privacy") "Icon" "eye" "Active" (or .PageIsSettingsPrivacy .PageIsBlockedUsers))}}
		</ul>

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_security"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/security") "Label" (ctx.Locale.Tr "settings.security") "Icon" "shield-check" "Active" .PageIsSettingsSecurity)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/applications") "Label" (ctx.Locale.Tr "asc_work.sn_tokens") "Icon" "key" "Active" .PageIsSettingsApplications)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/keys") "Label" (ctx.Locale.Tr "asc_work.sn_ssh_signing") "Icon" "terminal" "Active" .PageIsSettingsKeys)}}
			{{if .AscEnabled}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/keys") "Label" (ctx.Locale.Tr "asc_shell.sn_signing_keys") "Icon" "fingerprint" "Active" .PageIsSettingsAscKeys)}}
			{{end}}
		</ul>

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_integrations"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/authorized-integrations") "Label" (ctx.Locale.Tr "asc_work.sn_applications") "Icon" "puzzle" "Active" .PageIsSettingsAuthorizedIntegrations)}}
			{{if not DisableWebhooks}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/hooks") "Label" (ctx.Locale.Tr "repo.settings.hooks") "Icon" "link" "Active" .PageIsSettingsHooks)}}
			{{end}}
			{{if .EnablePackages}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/packages") "Label" (ctx.Locale.Tr "packages.title") "Icon" "package" "Active" .PageIsSettingsPackages)}}
			{{end}}
			{{if .EnableActions}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/actions/runners") "Label" (ctx.Locale.Tr "actions.runners") "Icon" "cpu" "Active" .PageIsSharedSettingsRunners)}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/actions/secrets") "Label" (ctx.Locale.Tr "secrets.secrets") "Icon" "lock" "Active" .PageIsSharedSettingsSecrets)}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/actions/variables") "Label" (ctx.Locale.Tr "actions.variables") "Icon" "hash" "Active" .PageIsSharedSettingsVariables)}}
			{{end}}
		</ul>

		{{if .AscEnabled}}
		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_byo"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/ai") "Label" (ctx.Locale.Tr "ascbyo.nav_ai") "Icon" "sparkles" "Active" .PageIsSettingsAscAI)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/storage") "Label" (ctx.Locale.Tr "ascbyo.nav_storage") "Icon" "database" "Active" .PageIsSettingsAscStorage)}}
		</ul>
		{{end}}

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_workspace"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/organization") "Label" (ctx.Locale.Tr "settings.organization") "Icon" "building" "Active" .PageIsSettingsOrganization)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/repos") "Label" (ctx.Locale.Tr "settings.repos") "Icon" "book" "Active" .PageIsSettingsRepos)}}
			{{if .EnableQuota}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/storage_overview") "Label" (ctx.Locale.Tr "settings.storage_overview") "Icon" "gauge" "Active" .PageIsStorageOverview)}}
			{{end}}
		</ul>

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_other"}}</h2>
		<ul class="ds-settings-list">
			{{if .IsAdmin}}
				{{template "shared/ds/snav_item" (dict "Href" (print AppSubUrl "/admin") "Label" (ctx.Locale.Tr "admin_panel") "Icon" "shield-check" "Badge" (ctx.Locale.Tr "asc_shell.sn_admin_badge"))}}
			{{end}}
			<li><a class="is-danger link-action" href data-url="{{AppSubUrl}}/user/logout"><span class="ds-ico" aria-hidden="true">{{svg "dsi-sign-out" 17}}</span><span>{{ctx.Locale.Tr "sign_out"}}</span><span class="ds-chev" aria-hidden="true">{{svg "dsi-chevron-right" 18}}</span></a></li>
		</ul>
	</div>
</nav>
{{end}}
