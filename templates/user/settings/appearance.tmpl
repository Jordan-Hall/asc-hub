{{template "user/settings/layout_head" (dict "ctxData" . "pageClass" "ds-main user settings appearance wk-settings")}}
{{template "user/settings/page_head" (dict "Title" (ctx.Locale.Tr "settings.appearance") "Lead" (ctx.Locale.Tr "asc_work.sp_appearance_lead"))}}
<div class="wk-sp">
	<!-- Theme -->
	<form class="ui form ds-form wk-sp-form" action="{{.Link}}/theme" method="post">
		{{.CsrfTokenHtml}}
		<section class="ds-card" aria-labelledby="sp-theme">
			<div class="ds-card-h"><h2 id="sp-theme">{{ctx.Locale.Tr "settings.manage_themes"}}</h2><span class="ds-card-sub">{{ctx.Locale.Tr "settings.theme_desc"}}</span></div>
			<div class="ds-card-b ds-stack-16">
				{{$currentTheme := ThemeName $.SignedUser}}
				<div class="wk-radio-cards wk-cols-3 wk-theme-cards" role="group" aria-label="{{ctx.Locale.Tr "settings.ui"}}">
					{{range $i, $a := .AllThemes}}{{if or (StringUtils.HasPrefix $a "asc-") (eq $currentTheme $a)}}
						<button type="submit" name="theme" value="{{$a}}" class="wk-radio-card wk-theme-card wk-pressed-card" aria-pressed="{{if eq $currentTheme $a}}true{{else}}false{{end}}"{{if eq $a "asc-light"}} data-ds-theme-set="light"{{else if eq $a "asc-dark"}} data-ds-theme-set="dark"{{else if eq $a "asc-auto"}} data-ds-theme-set="system"{{end}}>
							<span class="wk-theme-body">
								{{if eq $a "asc-light"}}<span class="wk-theme-prev is-light" aria-hidden="true"><i></i><i></i></span>
								{{else if eq $a "asc-dark"}}<span class="wk-theme-prev is-dark" aria-hidden="true"><i></i><i></i></span>
								{{else if eq $a "asc-auto"}}<span class="wk-theme-prev is-auto" aria-hidden="true"><i></i><i></i></span>{{end}}
								<b>{{call $.ThemeName $a}}</b>
								{{if eq $a "asc-light"}}<span class="ds-hint">{{ctx.Locale.Tr "asc_work.sp_theme_light"}}</span>
								{{else if eq $a "asc-dark"}}<span class="ds-hint">{{ctx.Locale.Tr "asc_work.sp_theme_dark"}}</span>
								{{else if eq $a "asc-auto"}}<span class="ds-hint">{{ctx.Locale.Tr "asc_work.sp_theme_auto"}}</span>{{end}}
							</span>
						</button>
					{{end}}{{end}}
				</div>
			</div>
		</section>
	</form>

	<!-- Density -->
	<section class="ds-card" aria-labelledby="sp-density">
		<div class="ds-card-h"><h2 id="sp-density">{{ctx.Locale.Tr "asc_work.sp_density"}}</h2><span class="ds-card-sub">{{ctx.Locale.Tr "asc_work.sp_density_hint"}}</span></div>
		<div class="ds-card-b">
			<div class="wk-radio-cards wk-cols-3" role="group" aria-label="{{ctx.Locale.Tr "asc_work.sp_density"}}">
				<button type="button" class="wk-radio-card wk-pressed-card" data-ds-density-set="comfy" aria-pressed="true"><span><b>{{ctx.Locale.Tr "asc_shell.density_comfy"}}</b><span class="ds-hint">{{ctx.Locale.Tr "asc_work.sp_density_comfy"}}</span></span></button>
				<button type="button" class="wk-radio-card wk-pressed-card" data-ds-density-set="compact" aria-pressed="false"><span><b>{{ctx.Locale.Tr "asc_shell.density_compact"}}</b><span class="ds-hint">{{ctx.Locale.Tr "asc_work.sp_density_compact"}}</span></span></button>
			</div>
		</div>
	</section>

	<!-- Motion and keys: browser choices that apply at once, with an undo toast -->
	<section class="ds-card" aria-labelledby="sp-browser">
		<div class="ds-card-h"><h2 id="sp-browser">{{ctx.Locale.Tr "asc_work.sp_browser"}}</h2><span class="ds-card-sub">{{ctx.Locale.Tr "asc_work.sp_browser_hint"}}</span></div>
		<div class="ds-card-b wk-switch-rows">
			<label class="ds-switch wk-switch-row">
				<input type="checkbox" role="switch" data-pref="motion" data-pref-default="0" data-toast-on="{{ctx.Locale.Tr "asc_work.sp_motion_on"}}" data-toast-off="{{ctx.Locale.Tr "asc_work.sp_motion_off"}}" data-toast-undo="{{ctx.Locale.Tr "asc_work.undo"}}">
				<span class="ds-switch-track"></span>
				<span class="wk-switch-text"><b>{{ctx.Locale.Tr "asc_work.sp_motion"}}</b><span class="ds-hint">{{ctx.Locale.Tr "asc_work.sp_motion_hint"}}</span></span>
			</label>
			<label class="ds-switch wk-switch-row">
				<input type="checkbox" role="switch" data-pref="keys" data-pref-default="1" checked data-toast-on="{{ctx.Locale.Tr "asc_work.sp_keys_on"}}" data-toast-off="{{ctx.Locale.Tr "asc_work.sp_keys_off"}}" data-toast-undo="{{ctx.Locale.Tr "asc_work.undo"}}">
				<span class="ds-switch-track"></span>
				<span class="wk-switch-text"><b>{{ctx.Locale.Tr "asc_work.sp_keys"}}</b><span class="ds-hint">{{ctx.Locale.Tr "asc_work.sp_keys_hint"}}</span></span>
			</label>
		</div>
	</section>

	<!-- Language -->
	<form class="ui form ds-form wk-sp-form" action="{{.Link}}/language" method="post">
		{{.CsrfTokenHtml}}
		<section class="ds-card" aria-labelledby="sp-language">
			<div class="ds-card-h"><h2 id="sp-language">{{ctx.Locale.Tr "settings.language.title"}}</h2><span class="ds-card-sub">{{ctx.Locale.Tr "settings.language.description"}}</span></div>
			<div class="ds-card-b ds-stack-16">
				<div class="ds-field">
					<label class="ds-label" for="language">{{ctx.Locale.Tr "settings.language.title"}}</label>
					<select id="language" class="ds-select" name="language">
						{{range .AllLangs}}<option value="{{.Lang}}"{{if eq $.SignedUser.Language .Lang}} selected{{end}}>{{.Name}}</option>{{end}}
					</select>
					<p class="ds-hint">{{ctx.Locale.Tr "settings.language.localization_project" "https://forgejo.org/docs/next/contributor/localization/"}}</p>
				</div>
				<div><button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "settings.update_language"}}</button></div>
			</div>
		</section>
	</form>

	<!-- Hints -->
	<form class="ui form ds-form wk-sp-form" action="{{.Link}}/hints" method="post">
		{{.CsrfTokenHtml}}
		<section class="ds-card" id="hints" aria-labelledby="sp-hints">
			<div class="ds-card-h"><h2 id="sp-hints">{{ctx.Locale.Tr "settings.hints"}}</h2></div>
			<div class="ds-card-b ds-stack-16">
				<label class="ds-switch wk-switch-row">
					<input name="enable_repo_unit_hints" type="checkbox" role="switch" {{if $.SignedUser.EnableRepoUnitHints}}checked{{end}}>
					<span class="ds-switch-track"></span>
					<span class="wk-switch-text"><b>{{ctx.Locale.Tr "settings.additional_repo_units_hint"}}</b><span class="ds-hint">{{ctx.Locale.Tr "settings.additional_repo_units_hint_description"}}</span></span>
				</label>
				<div><button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "settings.update_hints"}}</button></div>
			</div>
		</section>
	</form>

	<!-- Shown comment event types -->
	<form class="ui form ds-form wk-sp-form" action="{{.Link}}/hidden_comments" method="post">
		{{.CsrfTokenHtml}}
		<section class="ds-card" aria-labelledby="sp-hidden">
			<div class="ds-card-h"><h2 id="sp-hidden">{{ctx.Locale.Tr "settings.hidden_comment_types"}}</h2><span class="ds-card-sub">{{ctx.Locale.Tr "settings.hidden_comment_types_description"}}</span></div>
			<div class="ds-card-b ds-stack-16">
				<fieldset class="wk-fieldset wk-check-grid">
					<legend class="ds-sr">{{ctx.Locale.Tr "settings.hidden_comment_types"}}</legend>
					{{range $key := (StringUtils.Make "reference" "label" "milestone" "assignee" "title" "branch" "time_tracking" "deadline" "dependency" "lock" "review_request" "pull_request_push" "project" "issue_ref")}}
						<div class="ds-check">
							<input id="hide-{{$key}}" name="{{$key}}" type="checkbox" {{if (call $.IsCommentTypeGroupChecked $key)}}checked{{end}}>
							<label for="hide-{{$key}}">{{ctx.Locale.Tr (printf "settings.comment_type_group_%s" $key)}}
								{{if eq $key "reference"}}<span class="ds-hint">{{ctx.Locale.Tr "settings.hidden_comment_types.ref_tooltip"}}</span>{{end}}
								{{if eq $key "issue_ref"}}<span class="ds-hint">{{ctx.Locale.Tr "settings.hidden_comment_types.issue_ref_tooltip"}}</span>{{end}}
							</label>
						</div>
					{{end}}
				</fieldset>
				<div><button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "save"}}</button></div>
			</div>
		</section>
	</form>
</div>
{{template "user/settings/layout_footer" .}}
