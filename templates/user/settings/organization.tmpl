{{template "user/settings/layout_head" (dict "ctxData" . "pageClass" "ds-main user settings organization wk-settings")}}
{{template "user/settings/page_head" (dict "Title" (ctx.Locale.Tr "settings.orgs") "Lead" (ctx.Locale.Tr "asc_work.sp_orgs_lead"))}}
<div class="wk-sp">
	<section class="ds-card" aria-labelledby="sp-orgs">
		<div class="ds-card-h">
			<h2 id="sp-orgs">{{ctx.Locale.Tr "settings.orgs"}}</h2>
			{{if .SignedUser.CanCreateOrganization}}
				<a class="ds-btn ds-btn-primary ds-btn-sm ds-ml-auto" href="{{AppSubUrl}}/org/create">{{ctx.Locale.Tr "admin.orgs.new_orga"}}</a>
			{{end}}
		</div>
		{{if .Orgs}}
		<ul class="ds-list wk-rows orgs">
			{{range .Orgs}}
				<li class="ds-li wk-row">
					<span class="ds-li-av">{{ctx.AvatarUtils.Avatar . 40}}</span>
					<div class="ds-li-main">
						<div class="ds-li-title">{{template "shared/user/name" .}}</div>
						{{if .Description}}<div class="ds-li-sub">{{.Description}}</div>{{end}}
					</div>
					<div class="wk-row-acts">
						<a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{.HomeLink}}">{{ctx.Locale.Tr "asc_work.sp_open"}}</a>
						<form>
							<button type="button" class="ds-btn ds-btn-danger ds-btn-sm delete-button" data-modal-id="leave-organization"
								data-url="{{.OrganisationLink}}/members/action/leave" data-datauid="{{$.SignedUser.ID}}"
								data-name="{{$.SignedUser.DisplayName}}"
								data-data-organization-name="{{.DisplayName}}">{{ctx.Locale.Tr "org.members.leave"}}</button>
						</form>
					</div>
				</li>
			{{end}}
		</ul>
		{{template "base/paginate" .}}
		{{else}}
			{{template "shared/ds/empty" (dict "Icon" "building" "Title" (ctx.Locale.Tr "settings.orgs_none") "PrimaryHref" (print AppSubUrl "/org/create") "PrimaryLabel" (ctx.Locale.Tr "admin.orgs.new_orga"))}}
		{{end}}
	</section>
</div>

<div class="ui g-modal-confirm delete modal" id="leave-organization">
	<div class="header">
		{{ctx.Locale.Tr "org.members.leave"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "org.members.leave.detail" (`<span class="dataOrganizationName"></span>`|TrustHTML)}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>

{{template "user/settings/layout_footer" .}}
