{{template "user/settings/layout_head" (dict "ctxData" . "pageClass" "ds-main user settings repos wk-settings")}}
{{template "user/settings/page_head" (dict "Title" (ctx.Locale.Tr "settings.repos") "Lead" (ctx.Locale.Tr "asc_work.sp_repos_lead"))}}
<div class="wk-sp">
	<section class="ds-card" aria-labelledby="sp-repos">
		<div class="ds-card-h"><h2 id="sp-repos">{{ctx.Locale.Tr "settings.repos"}}</h2></div>
		{{if or .allowAdopt .allowDelete}}
			{{if .Dirs}}
			<ul class="ds-list wk-rows">
				{{range $dirI, $dir := .Dirs}}
					{{$repo := index $.ReposMap $dir}}
					<li class="ds-li wk-row">
						{{if $repo}}
							<span class="ds-li-av" aria-hidden="true">{{if $repo.IsPrivate}}{{svg "dsi-lock" 20}}{{else}}{{svg "dsi-book" 20}}{{end}}</span>
							<div class="ds-li-main">
								<div class="ds-li-title"><a class="ds-break" href="{{$repo.Link}}">{{$repo.OwnerName}}/{{$repo.Name}}</a>
									{{if $repo.IsPrivate}}<span class="ds-chip">{{ctx.Locale.Tr "repo.desc.private"}}</span>{{end}}
								</div>
								<div class="ds-li-meta">
									<span {{if not (eq $repo.Size 0)}}data-tooltip-content="{{$repo.SizeDetailsString ctx.Locale}}"{{end}}>{{ctx.Locale.TrSize $repo.Size}}</span>
									{{if $repo.IsFork}}<span>{{ctx.Locale.Tr "repo.forked_from"}} <a href="{{$repo.BaseRepo.Link}}">{{$repo.BaseRepo.OwnerName}}/{{$repo.BaseRepo.Name}}</a></span>{{end}}
								</div>
							</div>
						{{else}}
							<span class="ds-li-av" aria-hidden="true">{{svg "dsi-folder" 20}}</span>
							<div class="ds-li-main">
								<div class="ds-li-title"><span class="ds-break">{{$.ContextUser.Name}}/{{$dir}}</span><span class="ds-chip ds-chip-warn">{{ctx.Locale.Tr "asc_work.sp_unadopted"}}</span></div>
							</div>
							<div class="wk-row-acts">
								{{if $.allowAdopt}}
									<button type="button" class="ds-btn ds-btn-primary ds-btn-sm show-modal" data-modal="#adopt-unadopted-modal-{{$dirI}}">{{ctx.Locale.Tr "repo.adopt_preexisting_label"}}</button>
									<dialog id="adopt-unadopted-modal-{{$dirI}}">
										<article>
											<header>{{ctx.Locale.Tr "repo.adopt_preexisting"}}</header>
											<div class="content">
												<p>{{ctx.Locale.Tr "repo.adopt_preexisting_content" $dir}}</p>
											</div>
											<form class="ui form" method="post" action="{{AppSubUrl}}/user/settings/repos/unadopted">
												{{$.CsrfTokenHtml}}
												<input type="hidden" name="id" value="{{$dir}}">
												<input type="hidden" name="action" value="adopt">
												{{template "base/modal_actions_confirm" $}}
											</form>
										</article>
									</dialog>
								{{end}}
								{{if $.allowDelete}}
									<button type="button" class="ds-btn ds-btn-danger ds-btn-sm show-modal" data-modal="#delete-unadopted-modal-{{$dirI}}">{{ctx.Locale.Tr "repo.delete_preexisting_label"}}</button>
									<dialog id="delete-unadopted-modal-{{$dirI}}">
										<article>
											<header>{{ctx.Locale.Tr "repo.delete_preexisting"}}</header>
											<div class="content">
												<p>{{ctx.Locale.Tr "repo.delete_preexisting_content" $dir}}</p>
											</div>
											<form class="ui form" method="post" action="{{AppSubUrl}}/user/settings/repos/unadopted">
												{{$.CsrfTokenHtml}}
												<input type="hidden" name="id" value="{{$dir}}">
												<input type="hidden" name="action" value="delete">
												{{template "base/modal_actions_confirm" $}}
											</form>
										</article>
									</dialog>
								{{end}}
							</div>
						{{end}}
					</li>
				{{end}}
			</ul>
			{{template "base/paginate" .}}
			{{else}}
				{{template "shared/ds/empty" (dict "Icon" "book" "Title" (ctx.Locale.Tr "settings.repos_none"))}}
			{{end}}
		{{else}}
			{{if .Repos}}
			<ul class="ds-list wk-rows">
				{{range .Repos}}
					<li class="ds-li wk-row">
						<span class="ds-li-av" aria-hidden="true">{{if .IsPrivate}}{{svg "dsi-lock" 20}}{{else}}{{svg "dsi-book" 20}}{{end}}</span>
						<div class="ds-li-main">
							<div class="ds-li-title"><a class="ds-break" href="{{.Link}}">{{.OwnerName}}/{{.Name}}</a>
								{{if .IsPrivate}}<span class="ds-chip">{{ctx.Locale.Tr "repo.desc.private"}}</span>{{end}}
							</div>
							<div class="ds-li-meta">
								<span>{{ctx.Locale.TrSize .Size}}</span>
								{{if .IsFork}}<span>{{ctx.Locale.Tr "repo.forked_from"}} <a href="{{.BaseRepo.Link}}">{{.BaseRepo.OwnerName}}/{{.BaseRepo.Name}}</a></span>{{end}}
							</div>
						</div>
					</li>
				{{end}}
			</ul>
			{{template "base/paginate" .}}
			{{else}}
				{{template "shared/ds/empty" (dict "Icon" "book" "Title" (ctx.Locale.Tr "settings.repos_none"))}}
			{{end}}
		{{end}}
	</section>
</div>
{{template "user/settings/layout_footer" .}}
