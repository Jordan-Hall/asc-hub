{{/* Shared by the account, organization and administration application pages: list of OAuth2 applications and the form that creates one. Put it inside a .ds-card. */}}
<div class="ds-card-b"><p class="ds-hint">{{ctx.Locale.Tr "settings.oauth2_application_create_description"}}</p></div>
{{if .Applications}}
<ul class="ds-list wk-rows">
	{{range .Applications}}
		{{$isBuiltin := and $.BuiltinApplications (index $.BuiltinApplications .ClientID)}}
		<li class="ds-li wk-row">
			<span class="ds-li-av" aria-hidden="true">{{svg "dsi-puzzle" 20}}</span>
			<div class="ds-li-main">
				<div class="ds-li-title"><span class="ds-break">{{.Name}}</span>
					{{if $isBuiltin}}<span class="ds-chip" data-tooltip-content="{{ctx.Locale.Tr "settings.oauth2_application_locked"}}">{{ctx.Locale.Tr "locked"}}</span>{{end}}
				</div>
				<div class="ds-li-meta"><span>{{ctx.Locale.Tr "settings.oauth2_client_id"}} <code class="ds-mono ds-break">{{.ClientID}}</code></span></div>
			</div>
			{{if not $isBuiltin}}
			<div class="wk-row-acts">
				<a href="{{$.Link}}/oauth2/{{.ID}}" class="ds-btn ds-btn-secondary ds-btn-sm">{{ctx.Locale.Tr "settings.oauth2_application_edit"}}</a>
				<button type="button" class="ds-btn ds-btn-danger ds-btn-sm delete-button" data-modal-id="remove-gitea-oauth2-application" data-url="{{$.Link}}/oauth2/{{.ID}}/delete">{{ctx.Locale.Tr "settings.delete_key"}}</button>
			</div>
			{{end}}
		</li>
	{{end}}
</ul>
{{end}}
<form class="ui form ds-form wk-card-form ignore-dirty" action="{{.Link}}/oauth2" method="post">
	{{.CsrfTokenHtml}}
	<h3 class="ds-t-h3">{{ctx.Locale.Tr "settings.create_oauth2_application"}}</h3>
	<div class="required field ds-field {{if .Err_AppName}}error{{end}}">
		<label class="ds-label" for="application-name">{{ctx.Locale.Tr "settings.oauth2_application_name"}}</label>
		<input id="application-name" class="ds-input{{if .Err_AppName}} is-err{{end}}" name="application_name" value="{{.application_name}}" required maxlength="255">
	</div>
	<div class="required field ds-field {{if .Err_RedirectURI}}error{{end}}">
		<label class="ds-label" for="redirect-uris">{{ctx.Locale.Tr "settings.oauth2_redirect_uris"}}</label>
		<textarea name="redirect_uris" id="redirect-uris" class="ds-textarea{{if .Err_RedirectURI}} is-err{{end}}" rows="3" required></textarea>
	</div>
	<div class="ds-check {{if .Err_ConfidentialClient}}error{{end}}">
		<input id="confidential-client" type="checkbox" name="confidential_client" checked>
		<label for="confidential-client">{{ctx.Locale.Tr "settings.oauth2_confidential_client"}}</label>
	</div>
	<div><button class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "settings.create_oauth2_application_button"}}</button></div>
</form>
<div class="ui g-modal-confirm delete modal" id="remove-gitea-oauth2-application">
	<div class="header">
		{{svg "dsi-trash" 16}}
		{{ctx.Locale.Tr "settings.remove_oauth2_application"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "settings.oauth2_application_remove_description"}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>
