{{template "user/settings/layout_head" (dict "ctxData" . "pageClass" "ds-main user settings asc-trust-page wk-settings")}}
{{template "user/settings/page_head" (dict "Title" (ctx.Locale.Tr "asc_shell.sn_signing_keys") "Lead" (ctx.Locale.Tr "asc_work.sk_lead"))}}
<div class="wk-sp">
{{with .AscKeys}}
<div class="ds-stack-16" data-testid="asc-keys">
	{{if .Unsupported}}
		<div class="ds-banner ds-banner-warn" role="status" data-testid="asc-keys-unsupported"><span aria-hidden="true">{{svg "dsi-alert" 18}}</span><div class="ds-banner-body">{{ctx.Locale.Tr "asc_work.sk_unsupported"}}</div></div>
	{{else}}
		{{if .Problem}}<div class="ds-banner ds-banner-err" role="alert" data-testid="asc-keys-problem"><span aria-hidden="true">{{svg "dsi-alert" 18}}</span><div class="ds-banner-body">{{.Problem}}</div></div>{{end}}

		{{if .Page}}
		<section class="ds-card" aria-labelledby="asc-keys-list">
			<div class="ds-card-h"><h2 id="asc-keys-list">{{ctx.Locale.Tr "asc_work.sk_your_keys"}}</h2></div>
			<ul class="ds-list wk-rows" data-testid="asc-keys-list">
				{{range .Page.Keys}}
				<li class="ds-li wk-row" data-state="{{.State}}">
					<span class="ds-li-av" aria-hidden="true">{{svg "dsi-fingerprint" 20}}</span>
					<div class="ds-li-main">
						<div class="ds-li-title"><span class="ds-break">{{.Title}}</span>
							<span class="ds-chip {{if eq .State "live"}}ds-chip-ok{{else if eq .State "expired"}}ds-chip-warn{{else}}ds-chip-err{{end}}">{{if eq .State "live"}}{{ctx.Locale.Tr "asc_work.sk_live"}}{{else if eq .State "expired"}}{{ctx.Locale.Tr "asc_work.sp_expired"}}{{else}}{{ctx.Locale.Tr "asc_work.sk_revoked"}}{{end}}</span>
							<span class="ds-chip">{{.Kind}}</span>
						</div>
						<div class="ds-li-sub ds-mono ds-break">{{.Fingerprint}}</div>
						<div class="ds-li-meta">
							<span>{{ctx.Locale.Tr "asc_work.sk_added" (DateUtils.TimeSince .Created)}}</span>
							{{if not .Expires.IsZero}}<span>{{ctx.Locale.Tr "asc_work.sk_expires" (DateUtils.AbsoluteShort .Expires)}}</span>{{end}}
							{{if not .LastUsed.IsZero}}<span>{{ctx.Locale.Tr "asc_work.sk_last_used" (DateUtils.TimeSince .LastUsed)}}</span>{{end}}
							{{if not .Revoked.IsZero}}<span>{{ctx.Locale.Tr "asc_work.sk_revoked_at" (DateUtils.TimeSince .Revoked)}}{{if .RevokedReason}}: {{.RevokedReason}}{{end}}</span>{{end}}
						</div>
					</div>
					{{if eq .State "live"}}
					<form class="ui form ds-form wk-row-acts ast-key-revoke" method="post" action="{{$.AscKeys.KeysURL}}/revoke">
						{{$.CsrfTokenHtml}}
						<input type="hidden" name="id" value="{{.ID}}">
						<input type="hidden" name="op" value="{{index $.AscKeys.RevokeOps .ID}}">
						<label class="ds-sr" for="asc-key-reason-{{.ID}}">{{ctx.Locale.Tr "asc_work.sk_reason_for" .Title}}</label>
						<input id="asc-key-reason-{{.ID}}" class="ds-input" name="reason" type="text" maxlength="256" placeholder="{{ctx.Locale.Tr "asc_work.sk_reason"}}" autocomplete="off">
						<button class="ds-btn ds-btn-danger" type="submit">{{ctx.Locale.Tr "asc_work.sk_revoke"}}</button>
					</form>
					<details class="ds-details wk-key-rotate" data-testid="asc-key-rotate">
						<summary>{{ctx.Locale.Tr "asc_shell.key_rotate"}}<span class="ds-sr"> {{.Title}}</span></summary>
						<form class="ui form ds-form ds-stack-12" method="post" action="{{$.AscKeys.KeysURL}}/rotate">
							{{$.CsrfTokenHtml}}
							<input type="hidden" name="id" value="{{.ID}}">
							<input type="hidden" name="op" value="{{index $.AscKeys.RotateOps .ID}}">
							<p class="ds-hint">{{ctx.Locale.Tr "asc_shell.key_rotate_help"}}</p>
							<div class="ds-field"><label class="ds-label" for="asc-rot-title-{{.ID}}">{{ctx.Locale.Tr "asc_work.sk_title"}}</label><input id="asc-rot-title-{{.ID}}" class="ds-input" name="title" type="text" maxlength="100" required autocomplete="off"></div>
							<div class="ds-field"><label class="ds-label" for="asc-rot-key-{{.ID}}">{{ctx.Locale.Tr "asc_work.sk_public"}}</label><textarea id="asc-rot-key-{{.ID}}" class="ds-textarea ds-mono" name="public_key" rows="3" spellcheck="false" autocomplete="off" required placeholder="ssh-ed25519 AAAAC3Nza..."></textarea></div>
							<div class="ds-field"><label class="ds-label" for="asc-rot-exp-{{.ID}}">{{ctx.Locale.Tr "asc_work.sk_expires_label"}}</label><input id="asc-rot-exp-{{.ID}}" class="ds-input" name="expires" type="date"></div>
							<div class="ds-row"><button class="ds-btn ds-btn-secondary" type="submit">{{ctx.Locale.Tr "asc_shell.key_rotate_button"}}</button></div>
						</form>
					</details>
					{{end}}
				</li>
				{{else}}
				<li class="ds-li" data-testid="asc-keys-empty"><p class="ds-hint">{{ctx.Locale.Tr "asc_work.sk_none"}}</p></li>
				{{end}}
			</ul>
		</section>
		{{end}}

		<section class="ds-card" aria-labelledby="asc-keys-add">
			<div class="ds-card-h"><h2 id="asc-keys-add">{{ctx.Locale.Tr "asc_work.sk_add"}}</h2><span class="ds-card-sub">{{ctx.Locale.Tr "asc_work.sk_kinds"}}</span></div>
			<form class="ui form ds-form wk-card-form" method="post" action="{{.KeysURL}}" data-testid="asc-keys-form">
				{{$.CsrfTokenHtml}}
				<input type="hidden" name="op" value="{{.AddOp}}">
				<div class="required field ds-field">
					<label class="ds-label" for="asc-key-title">{{ctx.Locale.Tr "asc_work.sk_title"}}</label>
					<input id="asc-key-title" class="ds-input" name="title" type="text" maxlength="100" value="{{.Title}}" placeholder="{{ctx.Locale.Tr "asc_work.sk_title_ph"}}" required autocomplete="off">
				</div>
				<div class="required field ds-field">
					<label class="ds-label" for="asc-key-public">{{ctx.Locale.Tr "asc_work.sk_public"}}</label>
					<textarea id="asc-key-public" class="ds-textarea ds-mono ast-key-text" name="public_key" rows="4" spellcheck="false" autocomplete="off" wrap="soft" placeholder="ssh-ed25519 AAAAC3Nza..." required></textarea>
					<p class="ds-hint">{{ctx.Locale.Tr "asc_work.sk_public_hint"}}</p>
				</div>
				<div class="ds-field">
					<label class="ds-label" for="asc-key-expires">{{ctx.Locale.Tr "asc_work.sk_expires_label"}}</label>
					<input id="asc-key-expires" class="ds-input" name="expires" type="date" value="{{.Expires}}">
					<p class="ds-hint">{{ctx.Locale.Tr "asc_work.sk_expires_hint"}}</p>
				</div>
				<div><button class="ds-btn ds-btn-primary" type="submit" data-testid="asc-keys-add">{{ctx.Locale.Tr "asc_work.sk_add_button"}}</button></div>
			</form>
		</section>

		{{if .Page}}
		<section class="ds-card" aria-labelledby="asc-keys-how">
			<div class="ds-card-h"><h2 id="asc-keys-how">{{ctx.Locale.Tr "asc_work.sk_sign"}}</h2></div>
			<div class="ds-card-b ds-stack-12">
				<p class="ds-hint">{{ctx.Locale.Tr "asc_work.sk_sign_body" .Namespace}}</p>
				<div class="ds-codebox"><pre class="ds-codebox-bd" tabindex="0" role="region" aria-label="asc sign"><code>asc sign</code></pre></div>
				{{if .Page.Server.Configured}}
				<p class="ds-hint" data-testid="asc-keys-server">{{ctx.Locale.Tr "asc_work.sk_server_key"}} <code class="ds-mono ds-break">{{.Page.Server.Fingerprint}}</code> ({{.Page.Server.Kind}}).</p>
				{{end}}
			</div>
		</section>
		{{end}}
	{{end}}
</div>
{{end}}
</div>
{{template "user/settings/layout_footer" .}}
