{{template "base/head" .}}
{{template "user/auth/shell_start" (dict "Data" . "Hook" "user signin" "Title" (ctx.Locale.Tr "auth.login_userpass"))}}
	<form class="ds-form" action="{{.Link}}" method="post">
		{{template "shared/ds/field" (dict "ID" "user_name" "Name" "user_name" "Label" (ctx.Locale.Tr "home.uname_holder") "Value" .user_name "Autofocus" true "Required" true "Extra" "off" "Error" .Err_UserName)}}
		{{template "shared/ds/field" (dict "ID" "password" "Name" "password" "Type" "password" "Label" (ctx.Locale.Tr "password") "Value" .password "Autocomplete" "off" "Required" true "Reveal" true "Error" .Err_Password "LabelHref" (print AppSubUrl "/user/forgot_password") "LabelLink" (ctx.Locale.Tr "auth.forgot_password"))}}
		<div class="ds-check"><input id="remember" name="remember" type="checkbox"><label for="remember">{{ctx.Locale.Tr "auth.remember_me"}}</label></div>
		<button type="submit" class="ds-btn ds-btn-primary ds-btn-lg ds-btn-block">{{ctx.Locale.Tr "sign_in"}}</button>
		{{if .ShowRegistrationButton}}
			<p class="ds-auth-alt"><a class="ds-link" href="{{AppSubUrl}}/user/sign_up">{{ctx.Locale.Tr "auth.sign_up_button"}}</a></p>
		{{end}}
	</form>
{{template "user/auth/shell_end" (dict "Data" .)}}
{{template "base/footer" .}}
