{{$alertOn := or (not .LinkAccountMode) .LinkAccountModeSignIn}}
{{if $alertOn}}<div class="ds-auth-flash">{{template "base/alert" .}}</div>{{end}}
<form class="ds-form" action="{{.ChangePasscodeLink}}" method="post">
	{{template "shared/ds/field" (dict "ID" "password" "Name" "password" "Type" "password" "Label" (ctx.Locale.Tr "password") "Value" .password "Autocomplete" "new-password" "Required" true "Reveal" true "Error" (and .Err_Password $alertOn))}}
	{{template "shared/ds/field" (dict "ID" "retype" "Name" "retype" "Type" "password" "Label" (ctx.Locale.Tr "re_type") "Autocomplete" "new-password" "Required" true)}}
	<button type="submit" class="ds-btn ds-btn-primary ds-btn-lg ds-btn-block">{{ctx.Locale.Tr "settings.update_password"}}</button>
</form>
