{{template "base/head" .}}
{{template "user/auth/shell_start" (dict "Data" . "Hook" "oauth2-authorize-application-box" "Title" (ctx.Locale.Tr "auth.authorization_failed"))}}
	<div class="ds-stack-16">
		<div class="ds-banner ds-banner-err" role="alert">{{svg "dsi-alert" 18}}<div class="ds-banner-body"><b>{{.Error.ErrorDescription}}</b></div></div>
		<p class="ds-t-body">{{ctx.Locale.Tr "auth.authorization_failed_desc"}}</p>
	</div>
{{template "user/auth/shell_end" (dict "Data" .)}}
{{template "base/footer" .}}
