{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="ds-main ds-auth user link-account">
	<div class="ds-auth-pane">
		<div class="ds-auth-form">
			<h1 class="ds-auth-title">{{.Title}}</h1>
			<nav class="ds-tabs ds-auth-tabs" aria-label="{{.Title}}" role="tablist">
				{{if not .AllowOnlyInternalRegistration}}
					<button type="button" class="ds-tab" role="tab" data-tab="auth-link-signup-tab" aria-selected="{{if not .user_exists}}true{{else}}false{{end}}">{{ctx.Locale.Tr "auth.oauth_signup_tab"}}</button>
				{{end}}
				<button type="button" class="ds-tab" role="tab" data-tab="auth-link-signin-tab" aria-selected="{{if .user_exists}}true{{else}}false{{end}}">{{ctx.Locale.Tr "auth.oauth_signin_tab"}}</button>
			</nav>
			<div class="ui tab ds-tabpanel {{if not .user_exists}}active{{end}}" data-tab="auth-link-signup-tab" role="tabpanel">
				{{template "user/auth/signup_inner" .}}
			</div>
			<div class="ui tab ds-tabpanel {{if .user_exists}}active{{end}}" data-tab="auth-link-signin-tab" role="tabpanel">
				<div class="user signin">
					{{template "user/auth/signin_inner" .}}
				</div>
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
