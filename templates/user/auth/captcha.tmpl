{{if .EnableCaptcha}}{{if eq .CaptchaType "image"}}
	<div class="ds-field">
		<input type="hidden" name="img-captcha-id" value="{{.Captcha}}">
		<img class="captcha-img ds-captcha" onclick="this.src=`{{AppSubUrl}}/captcha/{{.Captcha}}.png?reload=${Date.now()}`" src="{{AppSubUrl}}/captcha/{{.Captcha}}.png" alt="{{ctx.Locale.Tr "captcha"}}">
	</div>
	{{template "shared/ds/field" (dict "ID" "captcha" "Name" "img-captcha-response" "Label" (ctx.Locale.Tr "captcha") "Required" true "Autocomplete" "off" "Error" .Err_Captcha)}}
{{else if eq .CaptchaType "recaptcha"}}
	<div class="ds-field ds-captcha-box">
		<div id="captcha" data-captcha-type="g-recaptcha" class="g-recaptcha-style" data-sitekey="{{.RecaptchaSitekey}}"></div>
	</div>
	<script defer src='{{URLJoin .RecaptchaURL "api.js"}}'></script>
{{else if eq .CaptchaType "hcaptcha"}}
	<div class="ds-field ds-captcha-box">
		<div id="captcha" data-captcha-type="h-captcha" class="h-captcha-style" data-sitekey="{{.HcaptchaSitekey}}"></div>
	</div>
	<script defer src='https://hcaptcha.com/1/api.js'></script>
{{else if eq .CaptchaType "mcaptcha"}}
	<div class="ds-field ds-captcha-box">
		<div class="m-captcha-style" id="mcaptcha__widget-container"></div>
		<div id="captcha" data-captcha-type="m-captcha" data-sitekey="{{.McaptchaSitekey}}" data-instance-url="{{.McaptchaURL}}"></div>
	</div>
{{else if eq .CaptchaType "cfturnstile"}}
	<div class="ds-field ds-captcha-box">
		<div id="captcha" data-captcha-type="cf-turnstile" data-sitekey="{{.CfTurnstileSitekey}}"></div>
	</div>
	<script defer src='https://challenges.cloudflare.com/turnstile/v0/api.js'></script>
{{end}}{{end}}
