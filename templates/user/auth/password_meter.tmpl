{{/*
The strength meter and rule list under a new password field. It works as a plain list of rules without script; asc-password.js ticks the rules and fills the bar as the person types. The server still checks the rules.
Props: ID (the password field's id)
*/}}
{{$p := PasswordPolicy}}
<div class="ds-pw" data-password-meter data-for="{{.ID}}" data-min="{{$p.MinLength}}" data-classes="{{$p.Classes}}"
	data-t-empty="{{ctx.Locale.Tr "asc_auth.pw_empty"}}" data-t-1="{{ctx.Locale.Tr "asc_auth.pw_weak"}}" data-t-2="{{ctx.Locale.Tr "asc_auth.pw_fair"}}" data-t-3="{{ctx.Locale.Tr "asc_auth.pw_good"}}" data-t-4="{{ctx.Locale.Tr "asc_auth.pw_strong"}}"
	data-t-met="{{ctx.Locale.Tr "asc_auth.pw_met"}}" data-t-unmet="{{ctx.Locale.Tr "asc_auth.pw_unmet"}}">
	<div class="ds-pw-head">
		<span class="ds-pw-title" id="{{.ID}}-pw-title">{{ctx.Locale.Tr "asc_auth.pw_label"}}</span>
		<span class="ds-pw-level" data-pw-level role="status" aria-live="polite">{{ctx.Locale.Tr "asc_auth.pw_empty"}}</span>
	</div>
	<div class="ds-pw-bar" data-pw-bar aria-hidden="true"><i></i><i></i><i></i><i></i></div>
	<ul class="ds-pw-rules" aria-labelledby="{{.ID}}-pw-title">
		<li data-rule="length"><span class="ds-pw-mark" aria-hidden="true">{{svg "dsi-check" 12}}</span><span>{{ctx.Locale.Tr "asc_auth.pw_rule_length" $p.MinLength}}</span><span class="ds-sr" data-pw-state>{{ctx.Locale.Tr "asc_auth.pw_unmet"}}</span></li>
		{{if $p.Classes}}
			{{range $class := StringUtils.Split $p.Classes ","}}
				<li data-rule="{{$class}}"><span class="ds-pw-mark" aria-hidden="true">{{svg "dsi-check" 12}}</span><span>{{ctx.Locale.Tr (printf "asc_auth.pw_rule_%s" $class)}}</span><span class="ds-sr" data-pw-state>{{ctx.Locale.Tr "asc_auth.pw_unmet"}}</span></li>
			{{end}}
		{{else}}
			<li data-rule="mix"><span class="ds-pw-mark" aria-hidden="true">{{svg "dsi-check" 12}}</span><span>{{ctx.Locale.Tr "asc_auth.pw_rule_mix"}}</span><span class="ds-sr" data-pw-state>{{ctx.Locale.Tr "asc_auth.pw_unmet"}}</span></li>
		{{end}}
	</ul>
</div>
