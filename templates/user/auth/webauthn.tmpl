{{template "base/head" .}}
{{template "user/auth/shell_start" (dict "Data" . "Hook" "user signin webauthn-prompt" "Title" (ctx.Locale.Tr "webauthn.insert_key") "Lead" (ctx.Locale.Tr "webauthn.sign_in"))}}
	{{template "user/auth/webauthn_error" .}}
	<div class="ds-auth-key">
		<span class="ds-empty-ic" aria-hidden="true">{{svg "dsi-key" 34}}</span>
		<div class="ds-auth-key-wait"><span class="is-loading ds-auth-spin" aria-hidden="true"></span><span>{{ctx.Locale.Tr "webauthn.press_button"}}</span></div>
	</div>
	{{if .HasTwoFactor}}
		<p class="ds-auth-alt"><a class="ds-link" href="{{AppSubUrl}}/user/two_factor">{{ctx.Locale.Tr "webauthn.use_twofa"}}</a></p>
	{{end}}
{{template "user/auth/shell_end" (dict "Data" .)}}
{{template "base/footer" .}}
