{{template "base/head" .}}
{{template "user/auth/shell_start" (dict "Data" . "Hook" "user signin openid" "Title" "OpenID" "Lead" (ctx.Locale.Tr "auth.openid_signin_desc"))}}
	<form class="ds-form" action="{{.Link}}" method="post">
		{{template "shared/ds/field" (dict "ID" "openid" "Name" "openid" "Label" "OpenID URI" "Value" .openid "Autofocus" true "Required" true "Extra" "off" "Mono" true "Error" .Err_OpenID)}}
		<div class="ds-check"><input id="remember" name="remember" type="checkbox"><label for="remember">{{ctx.Locale.Tr "auth.remember_me"}}</label></div>
		<button type="submit" class="ds-btn ds-btn-primary ds-btn-lg ds-btn-block">{{ctx.Locale.Tr "sign_in"}}</button>
	</form>
	{{template "user/auth/webauthn_error" .}}
	<p class="ds-auth-alt"><a class="ds-link" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "auth.back_to_sign_in"}}</a></p>
{{template "user/auth/shell_end" (dict "Data" .)}}
{{template "base/footer" .}}
