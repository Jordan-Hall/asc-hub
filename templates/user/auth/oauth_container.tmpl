{{if or .OAuth2Providers .EnableOpenIDSignIn}}
{{if or (and .PageIsSignUp (not .DisableRegistration)) (and .PageIsSignIn .EnableInternalSignIn)}}
	<div class="ds-or" role="separator"><span>{{ctx.Locale.Tr "asc_auth.or_continue_with"}}</span></div>
{{end}}
<div id="oauth2-login-navigator">
	<div id="oauth2-login-navigator-inner" class="ds-auth-providers">
		{{range $provider := .OAuth2Providers}}
			<a class="{{$provider.Name}} ds-btn ds-btn-secondary ds-btn-block oauth-login-link" href="{{AppSubUrl}}/user/oauth2/{{$provider.DisplayName | PathEscape}}">
				{{$provider.IconHTML 22}}
				{{ctx.Locale.Tr "sign_in_with_provider" $provider.DisplayName}}
			</a>
		{{end}}
		{{if .EnableOpenIDSignIn}}
			<a class="openid ds-btn ds-btn-secondary ds-btn-block" href="{{AppSubUrl}}/user/login/openid">
				{{svg "fontawesome-openid" 22}}
				{{ctx.Locale.Tr "auth.sign_in_openid"}}
			</a>
		{{end}}
	</div>
</div>
{{end}}
