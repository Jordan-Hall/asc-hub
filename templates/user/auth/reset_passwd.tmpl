{{template "base/head" .}}
{{template "user/auth/shell_start" (dict "Data" . "Hook" "user reset password" "Icon" "dsi-key" "Title" (ctx.Locale.Tr "auth.reset_password"))}}
	<form class="ds-form ignore-dirty" action="{{.Link}}" method="post">
		<input name="code" type="hidden" value="{{.Code}}">
		{{if .user_email}}
			{{template "shared/ds/field" (dict "ID" "user_name" "Name" "user_name_shown" "Label" (ctx.Locale.Tr "email") "Value" .user_email "Disabled" true "Extra" "off")}}
		{{end}}
		{{if .IsResetForm}}
			{{template "shared/ds/field" (dict "ID" "password" "Name" "password" "Type" "password" "Label" (ctx.Locale.Tr "settings.new_password") "Value" .password "Autocomplete" "new-password" "Autofocus" true "Required" true "Reveal" true "Error" .Err_Password)}}
			{{template "user/auth/password_meter" (dict "ID" "password")}}
			{{if not .user_signed_in}}
				<div class="ds-check"><input id="remember" name="remember" type="checkbox"><label for="remember">{{ctx.Locale.Tr "auth.remember_me"}}</label></div>
			{{end}}
			{{if .has_two_factor}}
				<h2 class="ds-t-h4">{{ctx.Locale.Tr "twofa"}}</h2>
				<div class="ds-banner ds-banner-warn">{{svg "dsi-info" 18}}<div class="ds-banner-body">{{ctx.Locale.Tr "settings.twofa_is_enrolled"}}</div></div>
				{{if .scratch_code}}
					{{template "shared/ds/field" (dict "ID" "token" "Name" "token" "Label" (ctx.Locale.Tr "auth.scratch_code") "Autocomplete" "off" "Autofocus" true "Required" true "Extra" "off" "Mono" true "Error" .Err_Token)}}
					<input type="hidden" name="scratch_code" value="true">
				{{else}}
					{{template "shared/ds/field" (dict "ID" "passcode" "Name" "passcode" "Type" "number" "Label" (ctx.Locale.Tr "passcode") "Autocomplete" "off" "Autofocus" true "Required" true "Mono" true "Error" .Err_Passcode)}}
				{{end}}
			{{end}}
			<button type="submit" class="ds-btn ds-btn-primary ds-btn-lg ds-btn-block">{{ctx.Locale.Tr "auth.reset_password_helper"}}</button>
			{{if and .has_two_factor (not .scratch_code)}}
				<p class="ds-auth-alt"><a class="ds-link" href="?code={{.Code}}&scratch_code=true">{{ctx.Locale.Tr "auth.use_scratch_code"}}</a></p>
			{{end}}
		{{else}}
			<p class="ds-t-body">{{ctx.Locale.Tr "auth.invalid_code_forgot_password" (printf "%s/user/forgot_password" AppSubUrl)}}</p>
		{{end}}
	</form>
{{template "user/auth/shell_end" (dict "Data" .)}}
{{template "base/footer" .}}
