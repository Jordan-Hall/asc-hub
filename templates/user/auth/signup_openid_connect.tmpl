{{template "base/head" .}}
{{template "user/auth/shell_start" (dict "Data" . "Hook" "user signup" "Title" (ctx.Locale.Tr "auth.openid_connect_title") "Lead" (ctx.Locale.Tr "auth.openid_connect_desc"))}}
	{{template "user/auth/signup_openid_navbar" .}}
	<form class="ds-form" action="{{.Link}}" method="post">
		{{template "shared/ds/field" (dict "ID" "user_name" "Name" "user_name" "Label" (ctx.Locale.Tr "home.uname_holder") "Value" .user_name "Autofocus" true "Required" true "Extra" "off" "Error" .Err_UserName)}}
		{{template "shared/ds/field" (dict "ID" "password" "Name" "password" "Type" "password" "Label" (ctx.Locale.Tr "password") "Value" .password "Autocomplete" "off" "Required" true "Reveal" true "Error" .Err_Password)}}
		{{template "shared/ds/field" (dict "ID" "openid" "Name" "openid_shown" "Label" "OpenID URI" "Value" .OpenID "Readonly" true "Mono" true)}}
		<button type="submit" class="ds-btn ds-btn-primary ds-btn-lg ds-btn-block">{{ctx.Locale.Tr "auth.openid_connect_submit"}}</button>
		<p class="ds-auth-alt"><a class="ds-link" href="{{AppSubUrl}}/user/forgot_password">{{ctx.Locale.Tr "auth.forgot_password"}}</a></p>
	</form>
{{template "user/auth/shell_end" (dict "Data" .)}}
{{template "base/footer" .}}
