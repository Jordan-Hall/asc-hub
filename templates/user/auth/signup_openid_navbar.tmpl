<nav class="ds-tabs ds-auth-tabs" aria-label="{{ctx.Locale.Tr "auth.openid_connect_title"}}">
	{{template "shared/ds/tab" (dict "Label" (ctx.Locale.Tr "auth.openid_connect_title") "Href" (print AppSubUrl "/user/openid/connect") "Active" .PageIsOpenIDConnect)}}
	{{if and .EnableOpenIDSignUp (not .AllowOnlyInternalRegistration)}}
		{{template "shared/ds/tab" (dict "Label" (ctx.Locale.Tr "auth.openid_register_title") "Href" (print AppSubUrl "/user/openid/register") "Active" .PageIsOpenIDRegister)}}
	{{end}}
</nav>
