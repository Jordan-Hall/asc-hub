{{/* The sign in form: the username and password, the remember choice, other ways in and the hint for the command line. Also used by the account linking page. */}}
{{$alertOn := or (not .LinkAccountMode) .LinkAccountModeSignIn}}
{{if $alertOn}}<div class="ds-auth-flash">{{template "base/alert" .}}</div>{{end}}
{{if .LinkAccountMode}}<h2 class="ds-t-h3 ds-mb-16">{{ctx.Locale.Tr "auth.oauth_signin_title"}}</h2>{{end}}
{{if .EnableInternalSignIn}}
<form class="ds-form" action="{{.SignInLink}}" method="post">
	{{template "shared/ds/field" (dict "ID" "user_name" "Name" "user_name" "Label" (ctx.Locale.Tr "home.uname_holder") "Value" .user_name "Autofocus" true "Required" true "Extra" "off" "Error" (and .Err_UserName $alertOn))}}
	{{if or (not .DisablePassword) .LinkAccountMode}}
		{{template "shared/ds/field" (dict "ID" "password" "Name" "password" "Type" "password" "Label" (ctx.Locale.Tr "password") "Value" .password "Autocomplete" "current-password" "Required" true "Reveal" true "Error" (and .Err_Password $alertOn) "LabelHref" (print AppSubUrl "/user/forgot_password") "LabelLink" (ctx.Locale.Tr "auth.forgot_password"))}}
	{{end}}
	{{if not .LinkAccountMode}}
		<div class="ds-check"><input id="remember" name="remember" type="checkbox"><label for="remember">{{ctx.Locale.Tr "auth.remember_me"}}</label></div>
	{{end}}

	{{template "user/auth/captcha" .}}

	<button type="submit" class="ds-btn ds-btn-primary ds-btn-lg ds-btn-block">
		{{if .LinkAccountMode}}{{ctx.Locale.Tr "auth.oauth_signin_submit"}}{{else}}{{ctx.Locale.Tr "sign_in"}}{{end}}
	</button>
</form>
{{end}}

{{template "custom/signin_mid"}}

{{template "user/auth/oauth_container" .}}

{{template "user/auth/webauthn_error" .}}

{{if and (not .LinkAccountMode) .ShowRegistrationButton}}
	<p class="ds-auth-alt">{{ctx.Locale.Tr "auth.hint_register" (printf "%s/user/sign_up" AppSubUrl)}}</p>
{{end}}

{{if and .EnableInternalSignIn (not .LinkAccountMode)}}
	<div class="ds-callout ds-auth-cli">
		<span class="ds-pr" aria-hidden="true">$</span>
		<p>{{ctx.Locale.Tr "asc_auth.cli_hint" AscHubHost}}</p>
	</div>
{{end}}
