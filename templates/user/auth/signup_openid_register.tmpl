{{template "base/head" .}}
{{template "user/auth/shell_start" (dict "Data" . "Hook" "user signup" "Title" (ctx.Locale.Tr "auth.openid_register_title") "Lead" (ctx.Locale.Tr "auth.openid_register_desc"))}}
	{{template "user/auth/signup_openid_navbar" .}}
	<form class="ds-form" action="{{.Link}}" method="post">
		{{template "shared/ds/field" (dict "ID" "user_name" "Name" "user_name" "Label" (ctx.Locale.Tr "username") "Value" .user_name "Autofocus" true "Required" true "Extra" "off" "Error" .Err_UserName)}}
		{{template "shared/ds/field" (dict "ID" "email" "Name" "email" "Type" "email" "Label" (ctx.Locale.Tr "email") "Value" .email "Required" true "Error" .Err_Email)}}
		{{template "user/auth/captcha" .}}
		{{template "shared/ds/field" (dict "ID" "openid" "Name" "openid_shown" "Label" "OpenID URI" "Value" .OpenID "Readonly" true "Mono" true)}}
		<button type="submit" class="ds-btn ds-btn-primary ds-btn-lg ds-btn-block">{{ctx.Locale.Tr "auth.create_new_account"}}</button>
	</form>
{{template "user/auth/shell_end" (dict "Data" .)}}
{{template "base/footer" .}}
