{{template "base/head" .}}
{{template "user/auth/shell_start" (dict "Data" . "Hook" "user forgot password" "Title" (ctx.Locale.Tr "auth.forgot_password_title"))}}
	<form class="ds-form ignore-dirty" action="{{.Link}}" method="post">
		{{if .IsResetSent}}
			<p class="ds-t-body">{{ctx.Locale.Tr "auth.reset_password_mail_sent_prompt" .Email .ResetPwdCodeLives}}</p>
		{{else if .IsResetRequest}}
			{{template "shared/ds/field" (dict "ID" "email" "Name" "email" "Type" "email" "Label" (ctx.Locale.Tr "email") "Value" .Email "Autofocus" true "Required" true "Autocomplete" "email" "Error" .Err_Email)}}
			<button type="submit" class="ds-btn ds-btn-primary ds-btn-lg ds-btn-block">{{ctx.Locale.Tr "auth.send_reset_mail"}}</button>
		{{else if .IsResetDisable}}
			<p class="ds-t-body">
				{{if $.IsAdmin}}{{ctx.Locale.Tr "auth.disable_forgot_password_mail_admin"}}{{else}}{{ctx.Locale.Tr "auth.disable_forgot_password_mail"}}{{end}}
			</p>
		{{else if .ResendLimited}}
			<p class="ds-t-body">{{ctx.Locale.Tr "auth.resent_limit_prompt"}}</p>
		{{end}}
		<p class="ds-auth-alt"><a class="ds-link" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "auth.back_to_sign_in"}}</a></p>
	</form>
{{template "user/auth/shell_end" (dict "Data" .)}}
{{template "base/footer" .}}
