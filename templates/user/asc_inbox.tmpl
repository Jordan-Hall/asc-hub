{{/*
The inbox (design boards "Inbox" and "Mobile-Inbox": whose turn it is). routers/web/user/asc_inbox_page.go builds .AscInbox.
Template Attributes:
* AscInbox: *user.AscInboxPage
* AscInboxSnoozed: how many items are hidden by a snooze
* CsrfTokenHtml
Under 1024 the page shows the list, or the pane of the chosen item (AscInbox.Explicit) with a way back; from 1024 both sit side by side.
*/}}
{{template "base/head" .}}
{{$p := .AscInbox}}
<div role="main" aria-label="{{.Title}}" class="ds-main wk-page wk-inbox{{if $p.Explicit}} is-detail{{end}}">
	{{if $p.Explicit}}
		{{template "shared/ds/subbar" (dict "Data" . "Title" (ctx.Locale.Tr "user.asc_inbox") "BackHref" (print AppSubUrl "/-/asc/inbox") "BackLabel" (ctx.Locale.Tr "asc_work.inbox_back"))}}
	{{end}}
	<div class="wk-inbox-grid">
		<section class="wk-inbox-list" aria-labelledby="wk-inbox-title">
			<div class="wk-inbox-top">
				<h1 id="wk-inbox-title" class="ds-t-h1 wk-title">{{ctx.Locale.Tr "user.asc_inbox"}} <span class="wk-title-sub">{{ctx.Locale.Tr "user.asc_inbox.subtitle"}}</span></h1>
				<nav class="wk-itabs" aria-label="{{ctx.Locale.Tr "user.asc_inbox.tabs"}}">
					{{range $p.Tabs}}
						<a href="{{.URL}}"{{if .Active}} aria-current="page"{{end}}>{{.Label}}{{if .Count}} <span class="ds-count">{{.Count}}</span>{{end}}</a>
					{{end}}
				</nav>
				{{if $p.Repos}}
					<form class="wk-ifilters" method="get" action="{{AppSubUrl}}/-/asc/inbox">
						{{if ne $p.Tab "needs"}}<input type="hidden" name="tab" value="{{$p.Tab}}">{{end}}
						<label class="ds-selectpill">
							<span class="ds-sr">{{ctx.Locale.Tr "user.asc_inbox.filter_repo"}}</span>
							<select name="repo" data-asc-autosubmit>
								<option value="">{{ctx.Locale.Tr "user.asc_inbox.all_repos"}}</option>
								{{range $p.Repos}}<option value="{{.}}"{{if eq . $p.Repo}} selected{{end}}>{{.}}</option>{{end}}
							</select>
							{{svg "dsi-chevron-down" 14}}
						</label>
						<noscript><button class="ds-btn ds-btn-secondary" type="submit">{{ctx.Locale.Tr "user.asc_inbox.apply"}}</button></noscript>
						<label class="ds-selectpill">
							<span class="ds-sr">{{ctx.Locale.Tr "user.asc_inbox.filter_kind"}}</span>
							<select name="kind" data-asc-autosubmit>
								<option value="">{{ctx.Locale.Tr "user.asc_inbox.kind_all"}}</option>
								<option value="humans"{{if eq $p.Kind "humans"}} selected{{end}}>{{ctx.Locale.Tr "user.asc_inbox.kind_humans"}}</option>
								<option value="agents"{{if eq $p.Kind "agents"}} selected{{end}}>{{ctx.Locale.Tr "user.asc_inbox.kind_agents"}}</option>
							</select>
							{{svg "dsi-chevron-down" 14}}
						</label>
						<label class="ds-selectpill">
							<span class="ds-sr">{{ctx.Locale.Tr "user.asc_inbox.sorted_by"}}</span>
							<select name="sort" data-asc-autosubmit>
								<option value="">{{ctx.Locale.Tr "user.asc_inbox.sort_new"}}</option>
								<option value="oldest"{{if eq $p.Sort "oldest"}} selected{{end}}>{{ctx.Locale.Tr "user.asc_inbox.sort_oldest"}}</option>
								<option value="repo"{{if eq $p.Sort "repo"}} selected{{end}}>{{ctx.Locale.Tr "user.asc_inbox.sort_repo"}}</option>
							</select>
							{{svg "dsi-chevron-down" 14}}
						</label>
					</form>
				{{end}}
			</div>

			{{with $p.Undo}}
				<div class="ds-toast wk-undo" role="status" data-asc-undo>
					{{svg "dsi-check" 16}}
					<div class="ds-toast-text"><b>{{ctx.Locale.Tr "user.asc_inbox.done_toast"}}</b><span class="ds-sub">{{.Title}}</span></div>
					<form method="post" action="{{AppSubUrl}}/-/asc/inbox/state">
						{{$.CsrfTokenHtml}}
						<input type="hidden" name="pull" value="{{.PullID}}">
						<input type="hidden" name="tab" value="{{$p.Tab}}">
						<input type="hidden" name="do" value="restore">
						<button class="ds-toast-action" type="submit">{{ctx.Locale.Tr "user.asc_inbox.undo"}}</button>
					</form>
				</div>
			{{end}}
			{{if $p.Rows}}
				<div data-bulk>
				<div class="wk-bulkbar" data-bulk-bar hidden>
					<label class="wk-irow-check wk-bulkbar-all"><input type="checkbox" checked data-bulk-unselect><span class="ds-sr">{{ctx.Locale.Tr "asc_work.bulk_clear"}}</span></label>
					<b class="wk-bulkbar-count" data-bulk-count role="status" aria-live="polite" data-one="{{ctx.Locale.Tr "asc_work.bulk_one"}}" data-n="{{ctx.Locale.Tr "asc_work.bulk_n"}}"></b>
					<span class="wk-bulkbar-acts">
						<button type="button" class="ds-btn ds-btn-secondary ds-btn-sm" data-bulk-do data-bulk-url="{{AppSubUrl}}/-/asc/inbox/state" data-bulk-field="pull" data-bulk-fields='{"do":"done","tab":"{{$p.Tab}}"}' data-failed="{{ctx.Locale.Tr "asc_work.bulk_failed"}}">{{ctx.Locale.Tr "user.asc_inbox.mark_done"}}</button>
						<button type="button" class="ds-btn ds-btn-secondary ds-btn-sm" data-bulk-do data-bulk-url="{{AppSubUrl}}/-/asc/inbox/state" data-bulk-field="pull" data-bulk-fields='{"do":"snooze","for":"4h","tab":"{{$p.Tab}}"}' data-failed="{{ctx.Locale.Tr "asc_work.bulk_failed"}}">{{ctx.Locale.Tr "user.asc_inbox.snooze"}}</button>
						<button type="button" class="ds-btn ds-btn-secondary ds-btn-sm" data-bulk-do data-bulk-url="{{AppSubUrl}}/-/asc/inbox/state" data-bulk-field="pull" data-bulk-fields='{"do":"unwatch","tab":"{{$p.Tab}}"}' data-failed="{{ctx.Locale.Tr "asc_work.bulk_failed"}}">{{ctx.Locale.Tr "user.asc_inbox.unwatch"}}</button>
					</span>
				</div>
				<ul class="wk-ilist" data-asc-list data-asc-swipe data-asc-inbox-live="{{$p.LiveURL}}">
					{{template "user/asc_inbox_rows" (dict "Page" $p "CsrfTokenHtml" $.CsrfTokenHtml)}}
				</ul>
				<p class="ds-sr" role="status" data-asc-inbox-news data-one="{{ctx.Locale.Tr "asc_work.inbox_new_one"}}" data-n="{{ctx.Locale.Tr "asc_work.inbox_new_n"}}"></p>
				</div>
			{{else if $p.DayOne}}
				<div class="ds-empty wk-empty-in" data-asc-inbox-dayone>
					<span class="ds-empty-ic" aria-hidden="true">{{svg "dsi-inbox" 32}}</span>
					<h3>{{ctx.Locale.Tr "asc_work.inbox_dayone_title"}}</h3>
					<p>{{ctx.Locale.Tr "asc_work.inbox_dayone_text"}}</p>
					<div class="ds-empty-acts"><a class="ds-btn ds-btn-primary" href="{{AppSubUrl}}/repo/create">{{ctx.Locale.Tr "user.asc_dash.new_repository"}}</a></div>
				</div>
			{{else}}
				<div class="ds-empty wk-empty-in" data-asc-inbox-live="{{$p.LiveURL}}">
					<span class="ds-empty-ic" aria-hidden="true">{{svg "dsi-inbox" 32}}</span>
					<h3>{{ctx.Locale.Tr (printf "asc_work.inbox_empty_title_%s" $p.Tab)}}</h3>
					<p>{{ctx.Locale.Tr (printf "user.asc_inbox.empty.%s" $p.Tab)}}</p>
					<div class="ds-empty-acts">
						<a class="ds-btn ds-btn-primary" href="{{AppSubUrl}}/-/asc/inbox" data-asc-inbox-more data-one="{{ctx.Locale.Tr "asc_work.inbox_new_show_one"}}" data-n="{{ctx.Locale.Tr "asc_work.inbox_new_show_n"}}" hidden></a>
						<a class="ds-btn ds-btn-secondary" href="{{AppSubUrl}}/notifications/subscriptions">{{ctx.Locale.Tr "asc_work.inbox_watch_more"}}</a>
					</div>
				</div>
			{{end}}
			<p class="wk-hintbar">
				{{if gt $p.Total (len $p.Rows)}}{{ctx.Locale.Tr "asc_work.inbox_showing" (len $p.Rows) $p.Total}}{{else}}{{ctx.Locale.Tr "user.asc_inbox.count" $p.Total}}{{end}}
				<span class="ds-hide-md"><kbd class="ds-kbd">j</kbd> <kbd class="ds-kbd">k</kbd> {{ctx.Locale.Tr "user.asc_inbox.key_move"}} &middot; <kbd class="ds-kbd">e</kbd> {{ctx.Locale.Tr "user.asc_inbox.key_done"}} &middot; <kbd class="ds-kbd">s</kbd> {{ctx.Locale.Tr "user.asc_inbox.key_snooze"}} &middot; <kbd class="ds-kbd">p</kbd> {{ctx.Locale.Tr "user.asc_inbox.key_pin"}}</span>
			</p>
			{{if .AscInboxSnoozed}}<p class="wk-hintbar">{{ctx.Locale.Tr "user.asc_inbox.snoozed" .AscInboxSnoozed}}</p>{{end}}
		</section>

		{{with $p.Detail}}
		<section class="wk-inbox-detail" aria-labelledby="wk-detail-title">
			<div class="wk-detail-top">
				<span class="ds-chip ds-chip-warn">{{ctx.Locale.Tr (printf "user.asc_inbox.turn.%s" .Row.Entry.Section)}}</span>
				<span class="wk-detail-where">{{.Row.Dash.Where}}</span>
				<a class="ds-btn ds-btn-secondary ds-btn-sm wk-detail-open" href="{{.Row.Entry.Link}}" data-asc-open>{{ctx.Locale.Tr "user.asc_inbox.open_review"}}</a>
			</div>
			<h2 id="wk-detail-title" class="wk-detail-title">{{.Row.Dash.Title}}</h2>

			<section class="ds-card wk-card" aria-labelledby="wk-why-title">
				<div class="ds-card-b">
					<h3 class="ds-t-micro wk-eyebrow" id="wk-why-title">{{ctx.Locale.Tr "user.asc_inbox.why_title"}}</h3>
					<p class="wk-why">{{.Why}}</p>
					<div class="wk-facts">
						{{if .Info}}
							{{if .Info.HasDiff}}<span><b>+{{.Info.Additions}} &minus;{{.Info.Deletions}}</b> {{ctx.Locale.TrN .Info.Files "user.asc_dash.in_file_one" "user.asc_dash.in_file_n" .Info.Files}}</span>{{end}}
							{{if .Info.ChecksFail}}<span class="ds-c-err"><b>{{ctx.Locale.TrN .Info.ChecksFail "user.asc_dash.check_failing_one" "user.asc_dash.check_failing_n" .Info.ChecksFail}}</b></span>
							{{else if .Info.ChecksPending}}<span>{{ctx.Locale.Tr "user.asc_dash.checks_running"}}</span>
							{{else if .Info.ChecksPass}}<span class="ds-c-ok"><b>{{ctx.Locale.TrN .Info.ChecksPass "user.asc_dash.check_pass_one" "user.asc_dash.check_pass_n" .Info.ChecksPass}}</b></span>{{end}}
							{{if .Info.Approvals}}<span>{{ctx.Locale.TrN .Info.Approvals "user.asc_dash.approval_one" "user.asc_dash.approval_n" .Info.Approvals}}</span>{{end}}
						{{end}}
						{{if .Row.Entry.Conflicted}}<span class="ds-c-err"><b>{{ctx.Locale.Tr "user.asc_dash.conflicts"}}</b></span>{{end}}
					</div>
				</div>
			</section>

			<section class="ds-card wk-card" aria-labelledby="wk-thread-title">
				<div class="ds-card-h"><h3 id="wk-thread-title">{{ctx.Locale.Tr "user.asc_inbox.thread"}}</h3></div>
				{{range .Comments}}
					<div class="wk-comment">
						{{ctx.AvatarUtils.Avatar .Poster 32}}
						<div class="wk-comment-body">
							<div class="wk-comment-who"><b>{{.Poster.GetDisplayName}}</b> <span class="ds-c-2">{{DateUtils.TimeSince .Created}}</span></div>
							<div class="wk-comment-text">{{.Body}}</div>
						</div>
					</div>
				{{else}}
					<p class="wk-quiet">{{ctx.Locale.Tr "user.asc_inbox.thread_empty"}}</p>
				{{end}}
				<form class="wk-reply form-fetch-action" method="post" action="{{.ReviewURL}}">
					{{$.CsrfTokenHtml}}
					{{if .CommitID}}<input type="hidden" name="commit_id" value="{{.CommitID}}">{{end}}
					<label class="ds-sr" for="wk-reply-text">{{ctx.Locale.Tr "user.asc_inbox.reply_label"}}</label>
					<textarea class="ds-textarea" id="wk-reply-text" name="content" rows="2" placeholder="{{ctx.Locale.Tr "user.asc_inbox.reply_placeholder"}}"></textarea>
					<div class="wk-reply-actions">
						{{if .CanReview}}
							<button class="ds-btn ds-btn-primary" type="submit" name="type" value="approve">{{ctx.Locale.Tr "user.asc_inbox.approve"}}</button>
							<button class="ds-btn ds-btn-secondary" type="submit" name="type" value="reject">{{ctx.Locale.Tr "user.asc_inbox.request_changes"}}</button>
						{{end}}
						<button class="ds-btn ds-btn-secondary" type="submit" name="type" value="comment">{{ctx.Locale.Tr "user.asc_inbox.reply"}}</button>
					</div>
				</form>
			</section>

			<div class="wk-detail-actions">
				<a class="ds-btn ds-btn-secondary" href="{{.Row.Entry.Link}}">{{ctx.Locale.Tr "user.asc_inbox.open_review"}} <kbd class="ds-kbd ds-hide-md">Enter</kbd></a>
				<details class="wk-snooze" data-asc-snooze>
					<summary class="ds-btn ds-btn-secondary">{{ctx.Locale.Tr "user.asc_inbox.snooze"}} <kbd class="ds-kbd ds-hide-md">s</kbd></summary>
					<div class="wk-snooze-menu">
						{{$d := $.AscInbox.Detail}}
						{{range $k := (StringUtils.Make "today" "tomorrow" "monday" "checks")}}
							{{$off := or (and (eq $k "today") (not $d.SnoozeToday)) (and (eq $k "checks") (not $d.SnoozeChecks))}}
							<form method="post" action="{{AppSubUrl}}/-/asc/inbox/state">
								{{$.CsrfTokenHtml}}
								<input type="hidden" name="pull" value="{{$d.Row.Entry.PullID}}">
								<input type="hidden" name="tab" value="{{$d.Return}}">
								<input type="hidden" name="do" value="snooze">
								<input type="hidden" name="for" value="{{$k}}">
								<button type="submit" data-asc-snooze-for="{{$k}}"{{if $off}} disabled aria-describedby="wk-snooze-{{$k}}-off"{{end}}>{{ctx.Locale.Tr (printf "user.asc_inbox.snooze_%s" $k)}}</button>
								{{if $off}}<span class="ds-sr" id="wk-snooze-{{$k}}-off">{{ctx.Locale.Tr (printf "user.asc_inbox.snooze_%s_off" $k)}}</span>{{end}}
							</form>
						{{end}}
						<form class="wk-snooze-date" method="post" action="{{AppSubUrl}}/-/asc/inbox/state" data-asc-snooze-date>
							{{$.CsrfTokenHtml}}
							<input type="hidden" name="pull" value="{{$d.Row.Entry.PullID}}">
							<input type="hidden" name="tab" value="{{$d.Return}}">
							<input type="hidden" name="do" value="snooze">
							<input type="hidden" name="for" value="date">
							<label class="wk-snooze-date-l" for="wk-snooze-on">{{ctx.Locale.Tr "user.asc_inbox.snooze_date"}}</label>
							<span class="wk-snooze-date-row">
								<input class="ds-input" id="wk-snooze-on" type="date" name="on" required min="{{$d.SnoozeFirst}}" max="{{$d.SnoozeLast}}">
								<button class="ds-btn ds-btn-secondary ds-btn-sm" type="submit">{{ctx.Locale.Tr "user.asc_inbox.snooze_date_go"}}</button>
							</span>
						</form>
					</div>
				</details>
				<form method="post" action="{{AppSubUrl}}/-/asc/inbox/state">
					{{$.CsrfTokenHtml}}
					<input type="hidden" name="pull" value="{{.Row.Entry.PullID}}">
					<input type="hidden" name="tab" value="{{.Return}}">
					<input type="hidden" name="do" value="{{if .Done}}restore{{else}}done{{end}}">
					<button class="ds-btn ds-btn-secondary" type="submit" data-asc-done>{{if .Done}}{{ctx.Locale.Tr "user.asc_inbox.restore"}}{{else}}{{ctx.Locale.Tr "user.asc_inbox.mark_done"}} <kbd class="ds-kbd ds-hide-md">e</kbd>{{end}}</button>
				</form>
				<form method="post" action="{{AppSubUrl}}/-/asc/inbox/state">
					{{$.CsrfTokenHtml}}
					<input type="hidden" name="pull" value="{{.Row.Entry.PullID}}">
					<input type="hidden" name="tab" value="{{.Return}}">
					<input type="hidden" name="do" value="{{if .Pinned}}unpin{{else}}pin{{end}}">
					<button class="ds-btn ds-btn-secondary" type="submit" data-asc-pin>{{if .Pinned}}{{ctx.Locale.Tr "user.asc_inbox.unpin"}}{{else}}{{ctx.Locale.Tr "user.asc_inbox.pin"}}{{end}} <kbd class="ds-kbd ds-hide-md">p</kbd></button>
				</form>
			</div>
			{{if and $p.Explicit $p.NextURL}}
				<div class="ds-sticky-actions wk-inbox-next"><a class="ds-btn ds-btn-primary" href="{{$p.NextURL}}">{{ctx.Locale.Tr "user.asc_inbox.open_next"}}</a></div>
			{{end}}
		</section>
		{{else}}
			<section class="wk-inbox-detail wk-inbox-none" aria-label="{{ctx.Locale.Tr "user.asc_inbox"}}">
				<p class="wk-quiet">{{ctx.Locale.Tr "user.asc_inbox.pick"}}</p>
			</section>
		{{end}}
	</div>
	{{if and (not $p.Explicit) $p.Rows}}
		{{$first := index $p.Rows 0}}
		{{if $first.Entry}}
			<div class="wk-inbox-first">
				<div class="ds-sticky-actions"><a class="ds-btn ds-btn-primary" href="{{$first.URL}}"><span class="ds-truncate">{{ctx.Locale.Tr "asc_work.inbox_open_first" $first.Dash.Title}}</span></a></div>
			</div>
		{{end}}
	{{end}}
</div>
{{template "base/footer" .}}
