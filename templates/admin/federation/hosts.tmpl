{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin user")}}
	{{template "admin/head" (dict "Title" (ctx.Locale.Tr "asc_admin.federation") "Desc" (ctx.Locale.Tr "asc_admin.fed_lead"))}}
	{{template "admin/federation_tabs" (dict "Active" "hosts")}}

	<div class="adm-sec">
		{{if .Hosts}}
			<div class="ds-table-wrap adm-only-md">
				<table class="ds-table">
					<caption class="ds-sr">{{ctx.Locale.Tr "admin.federation.hosts.manage_panel"}}</caption>
					<thead>
						<tr>
							<th scope="col">{{ctx.Locale.Tr "admin.federation.host.fqdn"}}</th>
							<th scope="col">{{ctx.Locale.Tr "admin.federation.host.software_name"}}</th>
							<th scope="col">{{ctx.Locale.Tr "admin.federation.host.created"}}</th>
							<th scope="col">{{ctx.Locale.Tr "admin.federation.host.latest_activity"}}</th>
							<th scope="col"><span class="ds-sr">{{ctx.Locale.Tr "asc_admin.col_actions"}}</span></th>
						</tr>
					</thead>
					<tbody>
						{{range .Hosts}}
							<tr>
								<td><span class="adm-who-name adm-mono">{{.HostFqdn}}</span><span class="adm-who-sub adm-mono">{{.HostSchema}}:{{.HostPort}}</span></td>
								<td>{{.NodeInfo.SoftwareName}}</td>
								<td>{{DateUtils.AbsoluteShort .Created}}</td>
								<td>{{DateUtils.FullTime .LatestActivity}}</td>
								<td class="ds-r"><a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{$.Link}}/{{.ID}}" aria-label="{{ctx.Locale.Tr "asc_admin.fed_show_details"}}: {{.HostFqdn}}">{{ctx.Locale.Tr "asc_admin.fed_show_details"}}</a></td>
							</tr>
						{{end}}
					</tbody>
				</table>
			</div>
			<ul class="ds-list adm-only-sm">
				{{range .Hosts}}
					<li class="ds-li">
						<span class="adm-tile" aria-hidden="true">{{svg "dsi-globe" 18}}</span>
						<div class="ds-li-main">
							<div class="ds-li-title adm-mono ds-break"><a href="{{$.Link}}/{{.ID}}">{{.HostFqdn}}</a></div>
							<div class="ds-li-sub">{{.NodeInfo.SoftwareName}}</div>
							<div class="ds-li-meta"><span>{{DateUtils.FullTime .LatestActivity}}</span></div>
						</div>
					</li>
				{{end}}
			</ul>
			{{template "base/paginate" .}}
		{{else}}
			<div class="ds-card">{{template "shared/ds/empty" (dict "Icon" "globe" "Title" (ctx.Locale.Tr "asc_admin.fed_none_title") "Body" (ctx.Locale.Tr "asc_admin.fed_none_text"))}}</div>
		{{end}}
	</div>
{{template "admin/layout_footer" .}}
