{{/* The federated people of a page: the table from 768, a list under it. */}}
{{if .Users}}
	<div class="ds-table-wrap adm-only-md">
		<table class="ds-table">
			<caption class="ds-sr">{{ctx.Locale.Tr "admin.federation.users.manage_panel"}}</caption>
			<thead>
				<tr>
					<th scope="col">{{ctx.Locale.Tr "admin.federation.user.external_id"}}</th>
					<th scope="col">{{ctx.Locale.Tr "admin.federation.user.inbox_path"}}</th>
					<th scope="col"><span class="ds-sr">{{ctx.Locale.Tr "asc_admin.col_actions"}}</span></th>
				</tr>
			</thead>
			<tbody>
				{{range .Users}}
					<tr>
						<td class="adm-mono ds-break">{{.ExternalID}}</td>
						<td class="adm-mono ds-break">{{.InboxPath}}</td>
						<td class="ds-r"><a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{AppUrl}}admin/users/{{.UserID}}">{{ctx.Locale.Tr "asc_admin.fed_show_person"}}</a></td>
					</tr>
				{{end}}
			</tbody>
		</table>
	</div>
	<ul class="ds-list adm-only-sm">
		{{range .Users}}
			<li class="ds-li">
				<div class="ds-li-main">
					<div class="ds-li-title adm-mono ds-break">{{.ExternalID}}</div>
					<div class="ds-li-sub adm-mono ds-break">{{.InboxPath}}</div>
					<div class="ds-li-actions"><a class="ds-btn ds-btn-secondary" href="{{AppUrl}}admin/users/{{.UserID}}">{{ctx.Locale.Tr "asc_admin.fed_show_person"}}</a></div>
				</div>
			</li>
		{{end}}
	</ul>
{{else}}
	<div class="ds-card">{{template "shared/ds/empty" (dict "Icon" "users" "Title" (ctx.Locale.Tr "asc_admin.fed_none_title") "Body" (ctx.Locale.Tr "asc_admin.fed_none_text"))}}</div>
{{end}}
