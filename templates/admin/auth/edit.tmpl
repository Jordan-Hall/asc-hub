{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin edit authentication")}}
	{{template "admin/head" (dict "Title" (ctx.Locale.Tr "admin.auths.edit") "Desc" (ctx.Locale.Tr "asc_admin.auth_edit_lead"))}}

	<form class="adm-form adm-form-card" action="{{.Link}}" method="post">
		{{.CsrfTokenHtml}}
		{{template "base/disable_form_autofill"}}
		<section class="ds-card"><div class="ds-card-b ds-form">
				<input type="hidden" name="id" value="{{.Source.ID}}">
				<div class="ds-field">
					<span class="ds-label">{{ctx.Locale.Tr "admin.auths.auth_type"}}</span>
					<input type="hidden" id="auth_type" name="type" value="{{.Source.Type.Int}}">
					<span>{{.Source.TypeName}}</span>
				</div>
				<div class="required {{if .Err_Name}}error{{end}} ds-field">
					<label class="ds-label" for="auth_name">{{ctx.Locale.Tr "admin.auths.auth_name"}}</label>
					<input class="ds-input" id="auth_name" name="name" value="{{.Source.Name}}" autofocus required>
				</div>

				<!-- LDAP and DLDAP -->
				{{if or .Source.IsLDAP .Source.IsDLDAP}}
					{{$cfg:=.Source.Cfg}}
					<div class="required {{if .Err_SecurityProtocol}}error{{end}} ds-field">
						<label class="ds-label" for="security_protocol">{{ctx.Locale.Tr "admin.auths.security_protocol"}}</label>
						<select class="ds-select" id="security_protocol" name="security_protocol">
								{{range .SecurityProtocols}}
									<option value="{{.Type.Int}}"{{if eq (print $cfg.SecurityProtocol.Int) (print .Type.Int)}} selected{{end}}>{{.Name}}</option>
								{{end}}
							</select>
					</div>
					<div class="required ds-field">
						<label class="ds-label" for="host">{{ctx.Locale.Tr "admin.auths.host"}}</label>
						<input class="ds-input" id="host" name="host" value="{{$cfg.Host}}" placeholder="mydomain.com" required>
					</div>
					<div class="required ds-field">
						<label class="ds-label" for="port">{{ctx.Locale.Tr "admin.auths.port"}}</label>
						<input class="ds-input" id="port" name="port" value="{{$cfg.Port}}"  placeholder="636" required>
					</div>
					<div class="has-tls {{if not .HasTLS}}tw-hidden{{end}} ds-field">
						<div class="ds-check"><input id="chk-skip_verify" name="skip_verify" type="checkbox" {{if .Source.SkipVerify}}checked{{end}}><label for="chk-skip_verify">{{ctx.Locale.Tr "admin.auths.skip_tls_verify"}}</label></div>
					</div>
					{{if .Source.IsLDAP}}
						<div class="ds-field">
							<label class="ds-label" for="bind_dn">{{ctx.Locale.Tr "admin.auths.bind_dn"}}</label>
							<input class="ds-input" id="bind_dn" name="bind_dn" value="{{$cfg.BindDN}}" placeholder="cn=Search,dc=mydomain,dc=com">
						</div>
						<div class="ds-field">
							<label class="ds-label" for="bind_password">{{ctx.Locale.Tr "admin.auths.bind_password"}}</label>
							<input class="ds-input" id="bind_password" name="bind_password" type="password" value="{{$cfg.BindPassword}}">
						</div>
					{{end}}
					<div class="{{if .Source.IsLDAP}}required{{end}} ds-field">
							<label class="ds-label" for="user_base">{{ctx.Locale.Tr "admin.auths.user_base"}}</label>
							<input class="ds-input" id="user_base" name="user_base" value="{{$cfg.UserBase}}" placeholder="ou=Users,dc=mydomain,dc=com" {{if .Source.IsLDAP}}required{{end}}>
					</div>
					{{if .Source.IsDLDAP}}
						<div class="required ds-field">
							<label class="ds-label" for="user_dn">{{ctx.Locale.Tr "admin.auths.user_dn"}}</label>
							<input class="ds-input" id="user_dn" name="user_dn" value="{{$cfg.UserDN}}" placeholder="uid=%s,ou=Users,dc=mydomain,dc=com" required>
						</div>
					{{end}}
					<div class="required ds-field">
						<label class="ds-label" for="filter">{{ctx.Locale.Tr "admin.auths.filter"}}</label>
						<input class="ds-input" id="filter" name="filter" value="{{$cfg.Filter}}" placeholder="(&(objectClass=posixAccount)(|(uid=%[1]s)(mail=%[1]s)))" required>
					</div>
					<div class="ds-field">
						<label class="ds-label" for="admin_filter">{{ctx.Locale.Tr "admin.auths.admin_filter"}}</label>
						<input class="ds-input" id="admin_filter" name="admin_filter" value="{{$cfg.AdminFilter}}">
					</div>
					<div class="ds-field">
						<label class="ds-label" for="restricted_filter">{{ctx.Locale.Tr "admin.auths.restricted_filter"}}</label>
						<input class="ds-input" id="restricted_filter" name="restricted_filter" value="{{$cfg.RestrictedFilter}}">
						<p class="ds-hint">{{ctx.Locale.Tr "admin.auths.restricted_filter_helper"}}</p>
					</div>
					<div class="ds-field">
						<label class="ds-label" for="attribute_username">{{ctx.Locale.Tr "admin.auths.attribute_username"}}</label>
						<input class="ds-input" id="attribute_username" name="attribute_username" value="{{$cfg.AttributeUsername}}" placeholder="{{ctx.Locale.Tr "admin.auths.attribute_username_placeholder"}}">
					</div>
					<div class="ds-field">
						<label class="ds-label" for="attribute_name">{{ctx.Locale.Tr "admin.auths.attribute_name"}}</label>
						<input class="ds-input" id="attribute_name" name="attribute_name" value="{{$cfg.AttributeName}}">
					</div>
					<div class="ds-field">
						<label class="ds-label" for="attribute_surname">{{ctx.Locale.Tr "admin.auths.attribute_surname"}}</label>
						<input class="ds-input" id="attribute_surname" name="attribute_surname" value="{{$cfg.AttributeSurname}}">
					</div>
					<div class="required ds-field">
						<label class="ds-label" for="attribute_mail">{{ctx.Locale.Tr "admin.auths.attribute_mail"}}</label>
						<input class="ds-input" id="attribute_mail" name="attribute_mail" value="{{$cfg.AttributeMail}}" placeholder="mail" required>
					</div>
					<div class="ds-field">
						<label class="ds-label" for="default_domain_name">{{ctx.Locale.Tr "admin.auths.default_domain_name"}}</label>
						<input class="ds-input" id="default_domain_name" name="default_domain_name" value="{{$cfg.DefaultDomainName}}" placeholder="localhost.local" >
					</div>
					<div class="ds-field">
						<label class="ds-label" for="attribute_ssh_public_key">{{ctx.Locale.Tr "admin.auths.attribute_ssh_public_key"}}</label>
						<input class="ds-input" id="attribute_ssh_public_key" name="attribute_ssh_public_key" value="{{$cfg.AttributeSSHPublicKey}}" placeholder="SshPublicKey">
					</div>
					<div class="ds-field">
						<label class="ds-label" for="attribute_avatar">{{ctx.Locale.Tr "admin.auths.attribute_avatar"}}</label>
						<input class="ds-input" id="attribute_avatar" name="attribute_avatar" value="{{$cfg.AttributeAvatar}}" placeholder="jpegPhoto">
					</div>

					<!-- ldap group begin -->
					<div class="ds-field">
						<div class="ds-check"><input id="chk-groups_enabled" type="checkbox" name="groups_enabled" class="js-ldap-group-toggle" {{if $cfg.GroupsEnabled}}checked{{end}}><label for="chk-groups_enabled">{{ctx.Locale.Tr "admin.auths.enable_ldap_groups"}}</label></div>
					</div>
					<div id="ldap-group-options" class="ds-card-inset ds-form adm-inset {{if not $cfg.GroupsEnabled}}tw-hidden{{end}}">
						<div class="ds-field">
							<label class="ds-label" for="f-group_dn">{{ctx.Locale.Tr "admin.auths.group_search_base"}}</label>
							<input class="ds-input" id="f-group_dn" name="group_dn" value="{{$cfg.GroupDN}}" placeholder="ou=group,dc=mydomain,dc=com">
						</div>
						<div class="ds-field">
							<label class="ds-label" for="f-group_member_uid">{{ctx.Locale.Tr "admin.auths.group_attribute_list_users"}}</label>
							<input class="ds-input" id="f-group_member_uid" name="group_member_uid" value="{{$cfg.GroupMemberUID}}" placeholder="memberUid">
						</div>
						<div class="ds-field">
							<label class="ds-label" for="f-user_uid">{{ctx.Locale.Tr "admin.auths.user_attribute_in_group"}}</label>
							<input class="ds-input" id="f-user_uid" name="user_uid" value="{{$cfg.UserUID}}" placeholder="uid">
						</div>
						<div class="ds-field">
							<label class="ds-label" for="f-group_filter">{{ctx.Locale.Tr "admin.auths.verify_group_membership"}}</label>
							<input class="ds-input" id="f-group_filter" name="group_filter" value="{{$cfg.GroupFilter}}" placeholder="(|(cn=gitea_users)(cn=admins))">
						</div>
						<div class="ds-field">
							<label class="ds-label" for="f-group_team_map">{{ctx.Locale.Tr "admin.auths.map_group_to_team"}}</label>
							<textarea class="ds-textarea" id="f-group_team_map" name="group_team_map" rows="5" placeholder='{"cn=my-group,cn=groups,dc=example,dc=org": {"MyForgejoOrganization": ["MyForgejoTeam1", "MyForgejoTeam2"]}}'>{{$cfg.GroupTeamMap}}</textarea>
						</div>
						<div class="ds-check"><input id="chk-group_team_map_removal" name="group_team_map_removal" type="checkbox" {{if $cfg.GroupTeamMapRemoval}}checked{{end}}><label for="chk-group_team_map_removal">{{ctx.Locale.Tr "admin.auths.map_group_to_team_removal"}}</label></div>
					</div>
					<!-- ldap group end -->

					{{if .Source.IsLDAP}}
						<div class="ds-field">
							<div class="ds-check"><input id="use_paged_search" name="use_paged_search" type="checkbox" {{if $cfg.UsePagedSearch}}checked{{end}}><label for="use_paged_search">{{ctx.Locale.Tr "admin.auths.use_paged_search"}}</label></div>
						</div>
						<div class="required search-page-size{{if not $cfg.UsePagedSearch}} tw-hidden{{end}} ds-field">
							<label class="ds-label" for="search_page_size">{{ctx.Locale.Tr "admin.auths.search_page_size"}}</label>
							<input class="ds-input" id="search_page_size" name="search_page_size" value="{{if $cfg.UsePagedSearch}}{{$cfg.SearchPageSize}}{{end}}">
						</div>
						<div class="ds-field">
							<div class="ds-check"><input id="chk-attributes_in_bind" name="attributes_in_bind" type="checkbox" {{if $cfg.AttributesInBind}}checked{{end}}><label for="chk-attributes_in_bind">{{ctx.Locale.Tr "admin.auths.attributes_in_bind"}}</label></div>
						</div>
					{{end}}
					<div class="optional ds-field">
						<div class="ds-check"><input id="skip_local_two_fa" name="skip_local_two_fa" type="checkbox" {{if $cfg.SkipLocalTwoFA}}checked{{end}}><label for="skip_local_two_fa">{{ctx.Locale.Tr "admin.auths.skip_local_two_fa"}}</label></div>
<p class="ds-hint">{{ctx.Locale.Tr "admin.auths.skip_local_two_fa_helper"}}</p>
					</div>
					<div class="ds-field">
						<div class="ds-check"><input id="allow_deactivate_all" name="allow_deactivate_all" type="checkbox" {{if $cfg.AllowDeactivateAll}}checked{{end}}><label for="allow_deactivate_all">{{ctx.Locale.Tr "admin.auths.allow_deactivate_all"}}</label></div>
					</div>
				{{end}}

				<!-- SMTP -->
				{{if .Source.IsSMTP}}
					{{$cfg:=.Source.Cfg}}
					<div class="required ds-field">
						<label class="ds-label" for="smtp_auth">{{ctx.Locale.Tr "admin.auths.smtp_auth"}}</label>
						<select class="ds-select" id="smtp_auth" name="smtp_auth" required>
								{{range .SMTPAuths}}
									<option value="{{.}}"{{if eq (print $cfg.Auth) (print .)}} selected{{end}}>{{.}}</option>
								{{end}}
							</select>
					</div>
					<div class="required ds-field">
						<label class="ds-label" for="smtp_host">{{ctx.Locale.Tr "admin.auths.smtphost"}}</label>
						<input class="ds-input" id="smtp_host" name="smtp_host" value="{{$cfg.Host}}" required>
					</div>
					<div class="required ds-field">
						<label class="ds-label" for="smtp_port">{{ctx.Locale.Tr "admin.auths.smtpport"}}</label>
						<input class="ds-input" id="smtp_port" name="smtp_port" value="{{$cfg.Port}}" required>
					</div>
					<div class="ds-field">
						<div class="ds-check"><input id="force_smtps" name="force_smtps" type="checkbox" {{if $cfg.ForceSMTPS}}checked{{end}}><label for="force_smtps">{{ctx.Locale.Tr "admin.auths.force_smtps"}}</label></div>
						<p class="ds-hint">{{ctx.Locale.Tr "admin.auths.force_smtps_helper"}}</p>
					</div>
					<div class="has-tls {{if not .HasTLS}}tw-hidden{{end}} ds-field">
						<div class="ds-check"><input id="chk-skip_verify" name="skip_verify" type="checkbox" {{if $cfg.SkipVerify}}checked{{end}}><label for="chk-skip_verify">{{ctx.Locale.Tr "admin.auths.skip_tls_verify"}}</label></div>
					</div>
					<div class="ds-field">
						<label class="ds-label" for="helo_hostname">{{ctx.Locale.Tr "admin.auths.helo_hostname"}}</label>
						<input class="ds-input" id="helo_hostname" name="helo_hostname" value="{{$cfg.HeloHostname}}">
						<p class="ds-hint">{{ctx.Locale.Tr "admin.auths.helo_hostname_helper"}}</p>
					</div>
					<div class="ds-field">
						<div class="ds-check"><input id="disable_helo" name="disable_helo" type="checkbox" {{if $cfg.DisableHelo}}checked{{end}}><label for="disable_helo">{{ctx.Locale.Tr "admin.auths.disable_helo"}}</label></div>
					</div>
					<div class="ds-field">
						<label class="ds-label" for="allowed_domains">{{ctx.Locale.Tr "admin.auths.allowed_domains"}}</label>
						<input class="ds-input" id="allowed_domains" name="allowed_domains" value="{{$cfg.AllowedDomains}}">
						<p class="ds-hint">{{ctx.Locale.Tr "admin.auths.allowed_domains_helper"}}</p>
					</div>
					<div class="optional ds-field">
						<div class="ds-check"><input id="skip_local_two_fa" name="skip_local_two_fa" type="checkbox" {{if $cfg.SkipLocalTwoFA}}checked{{end}}><label for="skip_local_two_fa">{{ctx.Locale.Tr "admin.auths.skip_local_two_fa"}}</label></div>
<p class="ds-hint">{{ctx.Locale.Tr "admin.auths.skip_local_two_fa_helper"}}</p>
					</div>
				{{end}}

				<!-- PAM -->
				{{if .Source.IsPAM}}
					{{$cfg:=.Source.Cfg}}
					<div class="required ds-field">
						<label class="ds-label" for="pam_service_name">{{ctx.Locale.Tr "admin.auths.pam_service_name"}}</label>
						<input class="ds-input" id="pam_service_name" name="pam_service_name" value="{{$cfg.ServiceName}}" required>
					</div>
					<div class="ds-field">
						<label class="ds-label" for="pam_email_domain">{{ctx.Locale.Tr "admin.auths.pam_email_domain"}}</label>
						<input class="ds-input" id="pam_email_domain" name="pam_email_domain" value="{{$cfg.EmailDomain}}">
					</div>
					<div class="optional ds-field">
						<div class="ds-check"><input id="skip_local_two_fa" name="skip_local_two_fa" type="checkbox" {{if $cfg.SkipLocalTwoFA}}checked{{end}}><label for="skip_local_two_fa">{{ctx.Locale.Tr "admin.auths.skip_local_two_fa"}}</label></div>
<p class="ds-hint">{{ctx.Locale.Tr "admin.auths.skip_local_two_fa_helper"}}</p>
					</div>
				{{end}}

				<!-- OAuth2 -->
				{{if .Source.IsOAuth2}}
					{{$cfg:=.Source.Cfg}}
					<div class="required ds-field">
						<label class="ds-label" for="oauth2_provider">{{ctx.Locale.Tr "admin.auths.oauth2_provider"}}</label>
						<select class="ds-select" id="oauth2_provider" name="oauth2_provider" required>
								{{range .OAuth2Providers}}
									<option value="{{.Name}}"{{if eq (print $cfg.Provider) (print .Name)}} selected{{end}}>{{.DisplayName}}</option>
								{{end}}
							</select>
					</div>
					<div class="required ds-field">
						<label class="ds-label" for="oauth2_key">{{ctx.Locale.Tr "admin.auths.oauth2_clientID"}}</label>
						<input class="ds-input" id="oauth2_key" name="oauth2_key" value="{{$cfg.ClientID}}" required>
					</div>
					<div class="required ds-field">
						<label class="ds-label" for="oauth2_secret">{{ctx.Locale.Tr "admin.auths.oauth2_clientSecret"}}</label>
						<input class="ds-input" id="oauth2_secret" name="oauth2_secret" value="{{$cfg.ClientSecret}}" required>
					</div>
					<div class="optional ds-field">
						<label class="ds-label" for="oauth2_icon_url">{{ctx.Locale.Tr "admin.auths.oauth2_icon_url"}}</label>
						<input class="ds-input" id="oauth2_icon_url" name="oauth2_icon_url" value="{{$cfg.IconURL}}">
					</div>
					<div class="open_id_connect_auto_discovery_url required ds-field">
						<label class="ds-label" for="open_id_connect_auto_discovery_url">{{ctx.Locale.Tr "admin.auths.openIdConnectAutoDiscoveryURL"}}</label>
						<input class="ds-input" id="open_id_connect_auto_discovery_url" name="open_id_connect_auto_discovery_url" value="{{$cfg.OpenIDConnectAutoDiscoveryURL}}">
					</div>
					<div class="optional ds-field">
						<div class="ds-check"><input id="skip_local_two_fa" name="skip_local_two_fa" type="checkbox" {{if $cfg.SkipLocalTwoFA}}checked{{end}}><label for="skip_local_two_fa">{{ctx.Locale.Tr "admin.auths.skip_local_two_fa"}}</label></div>
<p class="ds-hint">{{ctx.Locale.Tr "admin.auths.skip_local_two_fa_helper"}}</p>
					</div>
					<div class="optional ds-field">
						<div class="ds-check"><input id="allow_username_change" name="allow_username_change" type="checkbox" {{if $cfg.AllowUsernameChange}}checked{{end}}><label for="allow_username_change">{{ctx.Locale.Tr "admin.auths.allow_username_change"}}</label></div>
<p class="ds-hint">{{ctx.Locale.Tr "admin.auths.allow_username_change.description"}}</p>
					</div>
					<div class="oauth2_use_custom_url ds-field">
						<div class="ds-check"><input id="oauth2_use_custom_url" name="oauth2_use_custom_url" type="checkbox" {{if $cfg.CustomURLMapping}}checked{{end}}><label for="oauth2_use_custom_url">{{ctx.Locale.Tr "admin.auths.oauth2_use_custom_url"}}</label></div>
					</div>
					<div class="oauth2_use_custom_url_field oauth2_auth_url required ds-field">
						<label class="ds-label" for="oauth2_auth_url">{{ctx.Locale.Tr "admin.auths.oauth2_authURL"}}</label>
						<input class="ds-input" id="oauth2_auth_url" name="oauth2_auth_url" value="{{if $cfg.CustomURLMapping}}{{$cfg.CustomURLMapping.AuthURL}}{{end}}">
					</div>
					<div class="oauth2_use_custom_url_field oauth2_token_url required ds-field">
						<label class="ds-label" for="oauth2_token_url">{{ctx.Locale.Tr "admin.auths.oauth2_tokenURL"}}</label>
						<input class="ds-input" id="oauth2_token_url" name="oauth2_token_url" value="{{if $cfg.CustomURLMapping}}{{$cfg.CustomURLMapping.TokenURL}}{{end}}">
					</div>
					<div class="oauth2_use_custom_url_field oauth2_profile_url required ds-field">
						<label class="ds-label" for="oauth2_profile_url">{{ctx.Locale.Tr "admin.auths.oauth2_profileURL"}}</label>
						<input class="ds-input" id="oauth2_profile_url" name="oauth2_profile_url" value="{{if $cfg.CustomURLMapping}}{{$cfg.CustomURLMapping.ProfileURL}}{{end}}">
					</div>
					<div class="oauth2_use_custom_url_field oauth2_email_url required ds-field">
						<label class="ds-label" for="oauth2_email_url">{{ctx.Locale.Tr "admin.auths.oauth2_emailURL"}}</label>
						<input class="ds-input" id="oauth2_email_url" name="oauth2_email_url" value="{{if $cfg.CustomURLMapping}}{{$cfg.CustomURLMapping.EmailURL}}{{end}}">
					</div>
					<div class="oauth2_use_custom_url_field oauth2_tenant required ds-field">
						<label class="ds-label" for="oauth2_tenant">{{ctx.Locale.Tr "admin.auths.oauth2_tenant"}}</label>
						<input class="ds-input" id="oauth2_tenant" name="oauth2_tenant" value="{{if $cfg.CustomURLMapping}}{{$cfg.CustomURLMapping.Tenant}}{{end}}">
					</div>

					{{range .OAuth2Providers}}
						{{if .CustomURLSettings}}
							<input id="{{.Name}}_customURLSettings" type="hidden" data-required="{{.CustomURLSettings.Required}}" data-available="true">
							<input id="{{.Name}}_token_url" value="{{.CustomURLSettings.TokenURL.Value}}" data-available="{{.CustomURLSettings.TokenURL.Available}}" data-required="{{.CustomURLSettings.TokenURL.Required}}" type="hidden">
							<input id="{{.Name}}_auth_url" value="{{.CustomURLSettings.AuthURL.Value}}" data-available="{{.CustomURLSettings.AuthURL.Available}}" data-required="{{.CustomURLSettings.AuthURL.Required}}" type="hidden">
							<input id="{{.Name}}_profile_url" value="{{.CustomURLSettings.ProfileURL.Value}}" data-available="{{.CustomURLSettings.ProfileURL.Available}}" data-required="{{.CustomURLSettings.ProfileURL.Required}}" type="hidden">
							<input id="{{.Name}}_email_url" value="{{.CustomURLSettings.EmailURL.Value}}" data-available="{{.CustomURLSettings.EmailURL.Available}}" data-required="{{.CustomURLSettings.EmailURL.Required}}" type="hidden">
							<input id="{{.Name}}_tenant" value="{{.CustomURLSettings.Tenant.Value}}" data-available="{{.CustomURLSettings.Tenant.Available}}" data-required="{{.CustomURLSettings.Tenant.Required}}" type="hidden">
						{{end}}
						{{if .CanProvideSSHKeys}}
							<input id="{{.Name}}_canProvideSSHKeys" type="hidden">
						{{end}}
					{{end}}

					<div class="ds-field">
						<label class="ds-label" for="oauth2_scopes">{{ctx.Locale.Tr "admin.auths.oauth2_scopes"}}</label>
						<input class="ds-input" id="oauth2_scopes" name="oauth2_scopes" value="{{if $cfg.Scopes}}{{StringUtils.Join $cfg.Scopes ","}}{{end}}">
					</div>
					<div class="oauth2_attribute_ssh_public_key ds-field">
						<label class="ds-label" for="oauth2_attribute_ssh_public_key">{{ctx.Locale.Tr "admin.auths.attribute_ssh_public_key"}}</label>
						<input class="ds-input" id="oauth2_attribute_ssh_public_key" name="oauth2_attribute_ssh_public_key" value="{{$cfg.AttributeSSHPublicKey}}" placeholder="sshpubkey">
					</div>
					<div class="ds-field">
						<label class="ds-label" for="oauth2_required_claim_name">{{ctx.Locale.Tr "admin.auths.oauth2_required_claim_name"}}</label>
						<input class="ds-input" id="oauth2_required_claim_name" name="oauth2_required_claim_name" value="{{$cfg.RequiredClaimName}}">
						<p class="ds-hint">{{ctx.Locale.Tr "admin.auths.oauth2_required_claim_name_helper"}}</p>
					</div>
					<div class="ds-field">
						<label class="ds-label" for="oauth2_required_claim_value">{{ctx.Locale.Tr "admin.auths.oauth2_required_claim_value"}}</label>
						<input class="ds-input" id="oauth2_required_claim_value" name="oauth2_required_claim_value" value="{{$cfg.RequiredClaimValue}}">
						<p class="ds-hint">{{ctx.Locale.Tr "admin.auths.oauth2_required_claim_value_helper"}}</p>
					</div>
					<div class="ds-field">
						<label class="ds-label" for="oauth2_group_claim_name">{{ctx.Locale.Tr "admin.auths.oauth2_group_claim_name"}}</label>
