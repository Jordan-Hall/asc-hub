<div class="smtp {{if not (eq .type 3)}}tw-hidden{{end}} ds-form">
	<div class="required ds-field">
		<label class="ds-label" for="smtp_auth">{{ctx.Locale.Tr "admin.auths.smtp_auth"}}</label>
		<select class="ds-select" id="smtp_auth" name="smtp_auth">
				{{range .SMTPAuths}}
					<option value="{{.}}"{{if eq (print $.smtp_auth) (print .)}} selected{{end}}>{{.}}</option>
				{{end}}
			</select>
	</div>
	<div class="required ds-field">
		<label class="ds-label" for="smtp_host">{{ctx.Locale.Tr "admin.auths.smtphost"}}</label>
		<input class="ds-input" id="smtp_host" name="smtp_host" value="{{.smtp_host}}">
	</div>
	<div class="required ds-field">
		<label class="ds-label" for="smtp_port">{{ctx.Locale.Tr "admin.auths.smtpport"}}</label>
		<input class="ds-input" id="smtp_port" name="smtp_port" value="{{.smtp_port}}">
	</div>
	<div class="ds-field">
		<div class="ds-check"><input id="force_smtps" name="force_smtps" type="checkbox" {{if .force_smtps}}checked{{end}}><label for="force_smtps">{{ctx.Locale.Tr "admin.auths.force_smtps"}}</label></div>
<p class="ds-hint">{{ctx.Locale.Tr "admin.auths.force_smtps_helper"}}</p>
	</div>
	<div class="ds-field">
		<div class="ds-check"><input id="chk-skip_verify" name="skip_verify" type="checkbox" {{if .skip_verify}}checked{{end}}><label for="chk-skip_verify">{{ctx.Locale.Tr "admin.auths.skip_tls_verify"}}</label></div>
	</div>
	<div class="ds-field">
		<label class="ds-label" for="helo_hostname">{{ctx.Locale.Tr "admin.auths.helo_hostname"}}</label>
		<input class="ds-input" id="helo_hostname" name="helo_hostname" value="{{.helo_hostname}}">
		<p class="ds-hint">{{ctx.Locale.Tr "admin.auths.helo_hostname_helper"}}</p>
	</div>
	<div class="ds-field">
		<div class="ds-check"><input id="disable_helo" name="disable_helo" type="checkbox" {{if .disable_helo}}checked{{end}}><label for="disable_helo">{{ctx.Locale.Tr "admin.auths.disable_helo"}}</label></div>
	</div>
	<div class="ds-field">
		<label class="ds-label" for="allowed_domains">{{ctx.Locale.Tr "admin.auths.allowed_domains"}}</label>
		<input class="ds-input" id="allowed_domains" name="allowed_domains" value="{{.allowed_domains}}">
		<p class="ds-hint">{{ctx.Locale.Tr "admin.auths.allowed_domains_helper"}}</p>
	</div>
	<div class="optional ds-field">
		<div class="ds-check"><input id="skip_local_two_fa" name="skip_local_two_fa" type="checkbox" {{if .skip_local_two_fa}}checked{{end}}><label for="skip_local_two_fa">{{ctx.Locale.Tr "admin.auths.skip_local_two_fa"}}</label></div>
<p class="ds-hint">{{ctx.Locale.Tr "admin.auths.skip_local_two_fa_helper"}}</p>
	</div>
</div>
