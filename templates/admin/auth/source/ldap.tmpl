<div class="ldap dldap {{if not (or (eq .type 2) (eq .type 5))}}tw-hidden{{end}} ds-form">
	<div class="required {{if .Err_SecurityProtocol}}error{{end}} ds-field">
		<label class="ds-label" for="security_protocol">{{ctx.Locale.Tr "admin.auths.security_protocol"}}</label>
		<select class="ds-select" id="security_protocol" name="security_protocol">
				{{range .SecurityProtocols}}
					<option value="{{.Type.Int}}"{{if eq (print $.security_protocol) (print .Type.Int)}} selected{{end}}>{{.Name}}</option>
				{{end}}
			</select>
	</div>
	<div class="required ds-field">
		<label class="ds-label" for="host">{{ctx.Locale.Tr "admin.auths.host"}}</label>
		<input class="ds-input" id="host" name="host" value="{{.host}}" placeholder="mydomain.com">
	</div>
	<div class="required ds-field">
		<label class="ds-label" for="port">{{ctx.Locale.Tr "admin.auths.port"}}</label>
		<input class="ds-input" id="port" name="port" value="{{.port}}"  placeholder="636">
	</div>
	<div class="has-tls {{if not .HasTLS}}tw-hidden{{end}} ds-field">
		<div class="ds-check"><input id="chk-skip_verify" name="skip_verify" type="checkbox" {{if .skip_verify}}checked{{end}}><label for="chk-skip_verify">{{ctx.Locale.Tr "admin.auths.skip_tls_verify"}}</label></div>
	</div>
	<div class="ldap {{if not (eq .type 2)}}tw-hidden{{end}} ds-field">
		<label class="ds-label" for="bind_dn">{{ctx.Locale.Tr "admin.auths.bind_dn"}}</label>
		<input class="ds-input" id="bind_dn" name="bind_dn" value="{{.bind_dn}}" placeholder="cn=Search,dc=mydomain,dc=com">
	</div>
	<div class="ldap {{if not (eq .type 2)}}tw-hidden{{end}} ds-field">
		<label class="ds-label" for="bind_password">{{ctx.Locale.Tr "admin.auths.bind_password"}}</label>
		<input class="ds-input" id="bind_password" name="bind_password" type="password" autocomplete="off" value="{{.bind_password}}">
	</div>
	<div class="binddnrequired {{if (eq .type 2)}}required{{end}} ds-field">
		<label class="ds-label" for="user_base">{{ctx.Locale.Tr "admin.auths.user_base"}}</label>
		<input class="ds-input" id="user_base" name="user_base" value="{{.user_base}}" placeholder="ou=Users,dc=mydomain,dc=com">
	</div>
	<div class="dldap required {{if not (eq .type 5)}}tw-hidden{{end}} ds-field">
		<label class="ds-label" for="user_dn">{{ctx.Locale.Tr "admin.auths.user_dn"}}</label>
		<input class="ds-input" id="user_dn" name="user_dn" value="{{.user_dn}}" placeholder="uid=%s,ou=Users,dc=mydomain,dc=com">
	</div>
	<div class="required ds-field">
		<label class="ds-label" for="filter">{{ctx.Locale.Tr "admin.auths.filter"}}</label>
		<input class="ds-input" id="filter" name="filter" value="{{.filter}}" placeholder="(&(objectClass=posixAccount)(|(uid=%[1]s)(mail=%[1]s)))">
	</div>
	<div class="ds-field">
		<label class="ds-label" for="admin_filter">{{ctx.Locale.Tr "admin.auths.admin_filter"}}</label>
		<input class="ds-input" id="admin_filter" name="admin_filter" value="{{.admin_filter}}">
	</div>
	<div class="ds-field">
		<label class="ds-label" for="restricted_filter">{{ctx.Locale.Tr "admin.auths.restricted_filter"}}</label>
		<input class="ds-input" id="restricted_filter" name="restricted_filter" value="{{.restricted_filter}}">
		<p class="ds-hint">{{ctx.Locale.Tr "admin.auths.restricted_filter_helper"}}</p>
	</div>
	<div class="ds-field">
		<label class="ds-label" for="attribute_username">{{ctx.Locale.Tr "admin.auths.attribute_username"}}</label>
		<input class="ds-input" id="attribute_username" name="attribute_username" value="{{.attribute_username}}" placeholder="{{ctx.Locale.Tr "admin.auths.attribute_username_placeholder"}}">
	</div>
	<div class="ds-field">
		<label class="ds-label" for="attribute_name">{{ctx.Locale.Tr "admin.auths.attribute_name"}}</label>
		<input class="ds-input" id="attribute_name" name="attribute_name" value="{{.attribute_name}}">
	</div>
	<div class="ds-field">
		<label class="ds-label" for="attribute_surname">{{ctx.Locale.Tr "admin.auths.attribute_surname"}}</label>
		<input class="ds-input" id="attribute_surname" name="attribute_surname" value="{{.attribute_surname}}">
	</div>
	<div class="required ds-field">
		<label class="ds-label" for="attribute_mail">{{ctx.Locale.Tr "admin.auths.attribute_mail"}}</label>
		<input class="ds-input" id="attribute_mail" name="attribute_mail" value="{{.attribute_mail}}" placeholder="mail">
	</div>
	<div class="ds-field">
		<label class="ds-label" for="default_domain_name">{{ctx.Locale.Tr "admin.auths.default_domain_name"}}</label>
		<input class="ds-input" id="default_domain_name" name="default_domain_name" value="{{.default_domain_name}}" placeholder="localhost.local">
	</div>
	<div class="ds-field">
		<label class="ds-label" for="attribute_ssh_public_key">{{ctx.Locale.Tr "admin.auths.attribute_ssh_public_key"}}</label>
		<input class="ds-input" id="attribute_ssh_public_key" name="attribute_ssh_public_key" value="{{.attribute_ssh_public_key}}" placeholder="SshPublicKey">
	</div>
	<div class="ds-field">
		<label class="ds-label" for="attribute_avatar">{{ctx.Locale.Tr "admin.auths.attribute_avatar"}}</label>
		<input class="ds-input" id="attribute_avatar" name="attribute_avatar" value="{{.attribute_avatar}}" placeholder="jpegPhoto">
	</div>

	<!-- ldap group begin -->
	<div class="ds-field">
		<div class="ds-check"><input id="chk-groups_enabled" type="checkbox" name="groups_enabled" class="js-ldap-group-toggle" {{if .groups_enabled}}checked{{end}}><label for="chk-groups_enabled">{{ctx.Locale.Tr "admin.auths.enable_ldap_groups"}}</label></div>
	</div>
	<div id="ldap-group-options" class="ui segment secondary">
		<div class="ds-field">
			<label class="ds-label">{{ctx.Locale.Tr "admin.auths.group_search_base"}}</label>
			<input class="ds-input" name="group_dn" value="{{.group_dn}}" placeholder="ou=group,dc=mydomain,dc=com">
		</div>
		<div class="ds-field">
			<label class="ds-label">{{ctx.Locale.Tr "admin.auths.group_attribute_list_users"}}</label>
			<input class="ds-input" name="group_member_uid" value="{{.group_member_uid}}" placeholder="memberUid">
		</div>
		<div class="ds-field">
			<label class="ds-label">{{ctx.Locale.Tr "admin.auths.user_attribute_in_group"}}</label>
			<input class="ds-input" name="user_uid" value="{{.user_uid}}" placeholder="uid">
		</div>
		<div class="ds-field">
			<label class="ds-label">{{ctx.Locale.Tr "admin.auths.verify_group_membership"}}</label>
			<input class="ds-input" name="group_filter" value="{{.group_filter}}" placeholder="(|(cn=gitea_users)(cn=admins))">
		</div>
		<div class="ds-field">
			<label class="ds-label">{{ctx.Locale.Tr "admin.auths.map_group_to_team"}}</label>
			<textarea class="ds-textarea" name="group_team_map" rows="5" placeholder='{"cn=my-group,cn=groups,dc=example,dc=org": {"MyForgejoOrganization": ["MyForgejoTeam1", "MyForgejoTeam2"]}}'>{{.group_team_map}}</textarea>
		</div>
		<div class="ds-check"><input id="chk-group_team_map_removal" name="group_team_map_removal" type="checkbox" {{if .group_team_map_removal}}checked{{end}}><label for="chk-group_team_map_removal">{{ctx.Locale.Tr "admin.auths.map_group_to_team_removal"}}</label></div>
	</div>
	<!-- ldap group end -->

	<div class="ldap {{if not (eq .type 2)}}tw-hidden{{end}} ds-field">
		<div class="ds-check"><input id="use_paged_search" name="use_paged_search" class="use-paged-search" type="checkbox" {{if .use_paged_search}}checked{{end}}><label for="use_paged_search">{{ctx.Locale.Tr "admin.auths.use_paged_search"}}</label></div>
	</div>
	<div class="ldap search-page-size required {{if or (not (eq .type 2)) (not .use_paged_search)}}tw-hidden{{end}} ds-field">
		<label class="ds-label" for="search_page_size">{{ctx.Locale.Tr "admin.auths.search_page_size"}}</label>
		<input class="ds-input" id="search_page_size" name="search_page_size" value="{{.search_page_size}}">
	</div>
	<div class="optional ds-field">
		<div class="ds-check"><input id="skip_local_two_fa" name="skip_local_two_fa" type="checkbox" {{if .skip_local_two_fa}}checked{{end}}><label for="skip_local_two_fa">{{ctx.Locale.Tr "admin.auths.skip_local_two_fa"}}</label></div>
<p class="ds-hint">{{ctx.Locale.Tr "admin.auths.skip_local_two_fa_helper"}}</p>
	</div>
	<div class="ds-field">
		<div class="ds-check"><input id="allow_deactivate_all" name="allow_deactivate_all" type="checkbox" {{if .allow_deactivate_all}}checked{{end}}><label for="allow_deactivate_all">{{ctx.Locale.Tr "admin.auths.allow_deactivate_all"}}</label></div>
	</div>
</div>
