{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin authentication")}}
	{{template "admin/head" (dict "Title" (ctx.Locale.Tr "asc_admin.authentication") "Desc" (ctx.Locale.Tr "asc_admin.auth_lead"))}}

	{{if .Sources}}
		<div class="ds-table-wrap adm-only-md">
			<table class="ds-table">
				<caption class="ds-sr">{{ctx.Locale.Tr "admin.auths.auth_manage_panel"}}</caption>
				<thead>
					<tr>
						<th scope="col">{{ctx.Locale.Tr "asc_admin.col_source"}}</th>
						<th scope="col">{{ctx.Locale.Tr "asc_admin.col_status"}}</th>
						<th scope="col">{{ctx.Locale.Tr "asc_admin.col_updated"}}</th>
						<th scope="col"><span class="ds-sr">{{ctx.Locale.Tr "asc_admin.col_actions"}}</span></th>
					</tr>
				</thead>
				<tbody>
					{{range .Sources}}
						<tr>
							<td>
								<div class="adm-who">
									<span class="adm-tile" aria-hidden="true">{{svg "dsi-lock" 18}}</span>
									<div class="adm-who-text">
										<a class="adm-who-name" href="{{AppSubUrl}}/admin/auths/{{.ID}}">{{.Name}}</a>
										<span class="adm-who-sub">{{.TypeName}}</span>
									</div>
								</div>
							</td>
							<td>{{if .IsActive}}<span class="ds-chip ds-chip-ok">{{svg "dsi-check" 14}}{{ctx.Locale.Tr "asc_admin.auth_active"}}</span>{{else}}<span class="ds-chip ds-chip-warn">{{svg "dsi-alert" 14}}{{ctx.Locale.Tr "asc_admin.auth_inactive"}}</span>{{end}}</td>
							<td>{{DateUtils.AbsoluteShort .UpdatedUnix}}</td>
							<td class="ds-r"><a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{AppSubUrl}}/admin/auths/{{.ID}}" aria-label="{{ctx.Locale.Tr "edit"}}: {{.Name}}">{{ctx.Locale.Tr "edit"}}</a></td>
						</tr>
					{{end}}
				</tbody>
			</table>
		</div>

		<ul class="ds-list adm-only-sm">
			{{range .Sources}}
				<li class="ds-li">
					<span class="adm-tile" aria-hidden="true">{{svg "dsi-lock" 18}}</span>
					<div class="ds-li-main">
						<div class="ds-li-title"><a href="{{AppSubUrl}}/admin/auths/{{.ID}}">{{.Name}}</a>{{if .IsActive}} <span class="ds-chip ds-chip-ok">{{svg "dsi-check" 14}}{{ctx.Locale.Tr "asc_admin.auth_active"}}</span>{{else}} <span class="ds-chip ds-chip-warn">{{svg "dsi-alert" 14}}{{ctx.Locale.Tr "asc_admin.auth_inactive"}}</span>{{end}}</div>
						<div class="ds-li-sub">{{.TypeName}}</div>
						<div class="ds-li-meta"><span>{{ctx.Locale.Tr "asc_admin.updated_on" (DateUtils.AbsoluteShort .UpdatedUnix)}}</span></div>
						<div class="ds-li-actions"><a class="ds-btn ds-btn-secondary" href="{{AppSubUrl}}/admin/auths/{{.ID}}" aria-label="{{ctx.Locale.Tr "edit"}}: {{.Name}}">{{ctx.Locale.Tr "edit"}}</a></div>
					</div>
				</li>
			{{end}}
		</ul>
	{{else}}
		<div class="ds-card">
			{{template "shared/ds/empty" (dict "Icon" "lock" "Title" (ctx.Locale.Tr "asc_admin.auth_none_title") "Body" (ctx.Locale.Tr "asc_admin.auth_none_text"))}}
		</div>
	{{end}}

	<p class="adm-sec"><a class="ds-btn ds-btn-primary" href="{{AppSubUrl}}/admin/auths/new">{{svg "dsi-plus" 16}}{{ctx.Locale.Tr "asc_admin.auth_add"}}</a></p>
	<p class="ds-t-small ds-c-2 ds-mt-12">{{ctx.Locale.Tr "asc_admin.auth_local_note"}}</p>
{{template "admin/layout_footer" .}}
