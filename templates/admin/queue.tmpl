{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin monitor")}}
	{{template "admin/head" (dict "Title" (ctx.Locale.Tr "asc_admin.monitor") "Desc" (ctx.Locale.Tr "asc_admin.monitor_lead"))}}

	<section class="ds-card adm-sec" aria-labelledby="adm-queues">
		<div class="ds-card-h"><h2 id="adm-queues">{{ctx.Locale.Tr "asc_admin.monitor_tab_queues"}}</h2><span class="ds-card-sub">{{ctx.Locale.Tr "asc_admin.queues_note"}}</span></div>
		{{if .QueuesTotal}}
			{{template "admin/queue_table" (dict "Queues" .Queues "Link" $.Link)}}
			{{if .IdleQueues}}
				<details class="adm-idle">
					<summary>{{ctx.Locale.Tr "asc_admin.monitor_idle_queues" (len .IdleQueues)}}</summary>
					{{template "admin/queue_table" (dict "Queues" .IdleQueues "Link" $.Link)}}
				</details>
			{{end}}
		{{else}}
			{{template "shared/ds/empty" (dict "Icon" "queue" "Title" (ctx.Locale.Tr "asc_admin.queue_none"))}}
		{{end}}
	</section>

	<section class="ds-card adm-sec" aria-labelledby="adm-cron">
		<div class="ds-card-h"><h2 id="adm-cron">{{ctx.Locale.Tr "asc_admin.monitor_tab_cron"}}</h2><span class="ds-card-sub">{{ctx.Locale.Tr "asc_admin.cron_note"}}</span></div>
		<details class="adm-idle"{{if gt .CronFailed 0}} open{{end}}>
		<summary>{{ctx.Locale.Tr "asc_admin.monitor_all_tasks" (len .Entries)}}{{if gt .CronFailed 0}} <span class="ds-chip ds-chip-err">{{ctx.Locale.Tr "asc_admin.monitor_failed_tasks" .CronFailed}}</span>{{end}}</summary>
		<form method="post" action="{{AppSubUrl}}/admin">
			{{.CsrfTokenHtml}}
			<input type="hidden" name="from" value="monitor">
			<div class="ds-table-wrap adm-only-md adm-flat">
				<table class="ds-table">
					<caption class="ds-sr">{{ctx.Locale.Tr "admin.monitor.cron"}}</caption>
					<thead>
						<tr>
							<th scope="col">{{ctx.Locale.Tr "asc_admin.col_task"}}</th>
							<th scope="col">{{ctx.Locale.Tr "asc_admin.col_schedule"}}</th>
							<th scope="col">{{ctx.Locale.Tr "asc_admin.col_next"}}</th>
							<th scope="col">{{ctx.Locale.Tr "asc_admin.col_last"}}</th>
							<th scope="col" class="ds-r">{{ctx.Locale.Tr "asc_admin.col_runs"}}</th>
							<th scope="col"><span class="ds-sr">{{ctx.Locale.Tr "asc_admin.col_actions"}}</span></th>
						</tr>
					</thead>
					<tbody>
						{{range .Entries}}
							<tr>
								<td><span class="adm-who-name">{{ctx.Locale.Tr (printf "admin.dashboard.%s" .Name)}}</span></td>
								<td class="adm-mono">{{.Spec}}</td>
								<td>{{DateUtils.FullTime .Next}}</td>
								<td>{{if gt .Prev.Year 1}}{{DateUtils.FullTime .Prev}}{{else}}<span class="ds-c-2">{{ctx.Locale.Tr "asc_admin.cron_never"}}</span>{{end}}{{if .Status}} {{template "admin/cron_result" .}}{{end}}</td>
								<td class="ds-r ds-num">{{.ExecTimes}}</td>
								<td class="ds-r"><button type="submit" class="ds-btn ds-btn-secondary ds-btn-sm" name="op" value="{{.Name}}" aria-label="{{ctx.Locale.Tr "asc_admin.cron_run_now"}}: {{ctx.Locale.Tr (printf "admin.dashboard.%s" .Name)}}">{{ctx.Locale.Tr "asc_admin.cron_run_now"}}</button></td>
							</tr>
						{{end}}
					</tbody>
				</table>
			</div>
			<ul class="adm-rows adm-only-sm">
				{{range .Entries}}
					<li class="ds-li adm-mrow">
						<div class="adm-mrow-title">{{ctx.Locale.Tr (printf "admin.dashboard.%s" .Name)}}</div>
						<dl class="adm-mrow-kv">
							<div><dt>{{ctx.Locale.Tr "asc_admin.col_schedule"}}</dt><dd class="adm-mono">{{.Spec}}</dd></div>
							<div><dt>{{ctx.Locale.Tr "asc_admin.col_next"}}</dt><dd>{{DateUtils.FullTime .Next}}</dd></div>
							<div><dt>{{ctx.Locale.Tr "asc_admin.col_last"}}</dt><dd>{{if gt .Prev.Year 1}}{{DateUtils.FullTime .Prev}}{{else}}<span class="ds-c-2">{{ctx.Locale.Tr "asc_admin.cron_never"}}</span>{{end}}{{if .Status}} {{template "admin/cron_result" .}}{{end}}</dd></div>
						</dl>
						<div class="adm-mrow-act"><button type="submit" class="ds-btn ds-btn-secondary" name="op" value="{{.Name}}">{{ctx.Locale.Tr "asc_admin.cron_run_now"}}</button></div>
					</li>
				{{end}}
			</ul>
		</form>
		</details>
	</section>

	<section class="ds-card adm-sec" aria-labelledby="adm-trace">
		<div class="ds-card-h"><h2 id="adm-trace">{{ctx.Locale.Tr "asc_admin.monitor_tab_trace"}}</h2><span class="ds-card-sub">{{ctx.Locale.Tr "asc_admin.trace_note"}}</span></div>
		<div class="ds-card-b ds-row ds-row-wrap">
			<a class="ds-btn ds-btn-secondary" href="{{AppSubUrl}}/admin/monitor/stacktrace">{{svg "dsi-terminal" 16}}{{ctx.Locale.Tr "asc_admin.monitor_open_trace"}}</a>
			<a class="ds-btn ds-btn-secondary" href="{{AppSubUrl}}/admin/monitor/stats">{{ctx.Locale.Tr "asc_admin.monitor_tab_stats"}}</a>
		</div>
	</section>
{{template "admin/layout_footer" .}}
