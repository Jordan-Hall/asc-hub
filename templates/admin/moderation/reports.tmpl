{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin")}}
	{{template "admin/head" (dict "Title" (ctx.Locale.Tr "asc_admin.moderation") "Desc" (ctx.Locale.Tr "asc_admin.mod_lead"))}}

	{{if .Reports}}
		{{$postURL := print AppSubUrl "/admin/abuse_reports/act"}}
		<ul class="ds-list">
			{{range .Reports}}
				{{$id := print "report-" .ID}}
				<li class="ds-li ds-li-wrap report" id="{{$id}}" hx-target="#{{$id}}" hx-indicator="#{{$id}}" hx-vals='{"content_type": {{.ContentType}}, "content_id": {{.ContentID}}}'>
					<span class="adm-tile adm-tile-warn" aria-hidden="true">{{svg .ContentTypeIconName 18}}</span>
					<div class="ds-li-main">
						<div class="ds-li-title">
							{{if .ContentReference}}<a href="{{AppSubUrl}}/{{.ContentURL}}">{{.ContentReference}}</a>{{else}}<em>{{ctx.Locale.Tr "admin.moderation.deleted_content_ref" .ContentType .ContentID}}</em>{{end}}
							<span class="ds-chip ds-chip-warn">{{svg "dsi-flag" 14}}{{ctx.Locale.Tr (index $.AbuseCategories .Category)}}</span>
						</div>
						<div class="ds-li-sub ds-break">{{ctx.Locale.Tr "moderation.report_remarks"}}: <em>{{.Remarks}}</em></div>
						<div class="ds-li-meta">
							<span>{{if .ReporterName}}{{ctx.Locale.Tr "asc_admin.mod_report_by"}} <a class="ds-link" href="{{AppSubUrl}}/{{.ReporterName}}">{{.ReporterName}}</a>{{else}}{{ctx.Locale.Tr "asc_admin.mod_report_by"}} {{$.GhostUserName}}{{end}}</span>
							<span>{{DateUtils.TimeSince .CreatedUnix}}</span>
							<a href="{{AppSubUrl}}/admin/moderation/reports/type/{{.ContentType}}/id/{{.ContentID}}">{{ctx.Locale.Tr "asc_admin.mod_reported_times" .ReportedTimes}}</a>
						</div>
						<div class="ds-li-actions">
							<button type="button" class="ds-btn ds-btn-secondary ds-btn-sm" hx-post="{{$postURL}}" hx-vals='{"report_action": {{$.MarkAsIgnored}}}'>{{ctx.Locale.Tr "asc_admin.mod_dismiss"}}</button>
							<button type="button" class="ds-btn ds-btn-secondary ds-btn-sm" hx-post="{{$postURL}}" hx-vals='{"report_action": {{$.MarkAsHandled}}}'>{{ctx.Locale.Tr "asc_admin.mod_mark_handled"}}</button>
							{{if .ContentReference}}{{/* the reference is missing when the content was already deleted */}}
								{{if .ReportedContentIsUser}}
									<button type="button" class="ds-btn ds-btn-danger ds-btn-sm" hx-post="{{$postURL}}" hx-swap="none" hx-vals='{"content_action": {{$.ActionSuspendAccount}}}'>{{ctx.Locale.Tr "moderation.action.account.suspend"}}</button>
									<button type="button" class="ds-btn ds-btn-danger ds-btn-sm" hx-post="{{$postURL}}" hx-confirm="{{ctx.Locale.Tr "moderation.action.account.delete"}}" hx-vals='{"content_action": {{$.ActionDeleteAccount}}, "report_action": {{$.MarkAsHandled}}}'>{{ctx.Locale.Tr "moderation.action.account.delete"}}</button>
								{{else if .ReportedContentIsRepo}}
									<button type="button" class="ds-btn ds-btn-danger ds-btn-sm" hx-post="{{$postURL}}" hx-confirm="{{ctx.Locale.Tr "moderation.action.repo.delete"}}" hx-vals='{"content_action": {{$.ActionDeleteRepo}}, "report_action": {{$.MarkAsHandled}}}'>{{ctx.Locale.Tr "moderation.action.repo.delete"}}</button>
								{{else if .ReportedContentIsIssue}}
									<button type="button" class="ds-btn ds-btn-danger ds-btn-sm" hx-post="{{$postURL}}" hx-confirm="{{ctx.Locale.Tr "moderation.action.issue.delete"}}" hx-vals='{"content_action": {{$.ActionDeleteIssue}}, "report_action": {{$.MarkAsHandled}}}'>{{ctx.Locale.Tr "moderation.action.issue.delete"}}</button>
								{{else if .ReportedContentIsComment}}
									<button type="button" class="ds-btn ds-btn-danger ds-btn-sm" hx-post="{{$postURL}}" hx-confirm="{{ctx.Locale.Tr "moderation.action.comment.delete"}}" hx-vals='{"content_action": {{$.ActionDeleteComment}}, "report_action": {{$.MarkAsHandled}}}'>{{ctx.Locale.Tr "moderation.action.comment.delete"}}</button>
								{{end}}
							{{end}}
						</div>
					</div>
				</li>
			{{end}}
		</ul>
	{{else}}
		<div class="ds-card">
			{{template "shared/ds/empty" (dict "Icon" "check-circle" "Title" (ctx.Locale.Tr "asc_admin.mod_none_title") "Body" (ctx.Locale.Tr "admin.moderation.no_open_reports"))}}
		</div>
	{{end}}
{{template "admin/layout_footer" .}}
