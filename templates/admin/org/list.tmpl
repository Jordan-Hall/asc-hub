{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin user")}}
	{{template "admin/head" (dict "Title" (ctx.Locale.Tr "asc_admin.organizations") "Desc" (ctx.Locale.Tr "asc_admin.orgs_lead") "ActionLabel" (ctx.Locale.Tr "admin.orgs.new_orga") "ActionHref" (print AppSubUrl "/org/create") "ActionIcon" "plus")}}

	<div class="adm-filter">
		<form class="ds-filterbar-form ignore-dirty" role="search" method="get" action="{{AppSubUrl}}/admin/orgs">
			<div class="ds-inwrap">
				{{svg "dsi-search" 16}}
				<label class="ds-sr" for="adm-org-q">{{ctx.Locale.Tr "asc_admin.orgs_search"}}</label>
				<input id="adm-org-q" class="ds-input" type="search" name="q" value="{{.Keyword}}" maxlength="255" spellcheck="false" enterkeyhint="search" placeholder="{{ctx.Locale.Tr "asc_admin.orgs_search"}}">
			</div>
			<label class="ds-selectpill">
				<span class="ds-sr">{{ctx.Locale.Tr "repo.issues.filter_sort"}}</span>
				<select name="sort">
					<option value="alphabetically"{{if or (eq .SortType "alphabetically") (not .SortType)}} selected{{end}}>{{ctx.Locale.Tr "repo.issues.label.filter_sort.alphabetically"}}</option>
					<option value="reversealphabetically"{{if eq .SortType "reversealphabetically"}} selected{{end}}>{{ctx.Locale.Tr "repo.issues.label.filter_sort.reverse_alphabetically"}}</option>
					<option value="newest"{{if eq .SortType "newest"}} selected{{end}}>{{ctx.Locale.Tr "repo.issues.filter_sort.latest"}}</option>
					<option value="oldest"{{if eq .SortType "oldest"}} selected{{end}}>{{ctx.Locale.Tr "repo.issues.filter_sort.oldest"}}</option>
					<option value="recentupdate"{{if eq .SortType "recentupdate"}} selected{{end}}>{{ctx.Locale.Tr "repo.issues.filter_sort.recentupdate"}}</option>
					<option value="leastupdate"{{if eq .SortType "leastupdate"}} selected{{end}}>{{ctx.Locale.Tr "repo.issues.filter_sort.leastupdate"}}</option>
				</select>
				{{svg "dsi-chevron-down" 16}}
			</label>
			<button type="submit" class="ds-btn ds-btn-secondary">{{ctx.Locale.Tr "asc_shell.search_label"}}</button>
		</form>
	</div>

	{{if .Users}}
		<div class="ds-table-wrap adm-only-md">
			<table class="ds-table">
				<caption class="ds-sr">{{ctx.Locale.Tr "admin.orgs.org_manage_panel"}}</caption>
				<thead>
					<tr>
						<th scope="col">{{ctx.Locale.Tr "asc_admin.col_org"}}</th>
						<th scope="col" class="ds-r">{{ctx.Locale.Tr "asc_admin.col_people"}}</th>
						<th scope="col" class="ds-r">{{ctx.Locale.Tr "admin.orgs.teams"}}</th>
						<th scope="col" class="ds-r">{{ctx.Locale.Tr "asc_admin.col_repos"}}</th>
						<th scope="col">{{ctx.Locale.Tr "asc_admin.col_created"}}</th>
						<th scope="col"><span class="ds-sr">{{ctx.Locale.Tr "asc_admin.col_actions"}}</span></th>
					</tr>
				</thead>
				<tbody>
					{{range .Users}}
						<tr>
							<td>
								<div class="adm-who">
									{{ctx.AvatarUtils.Avatar . 40 "ds-avatar-org"}}
									<div class="adm-who-text">
										<a class="adm-who-name" href="{{.HomeLink}}">{{if .FullName}}{{.FullName}}{{else}}{{.Name}}{{end}}</a>
										<span class="adm-who-sub adm-mono">{{.Name}}</span>
									</div>
									{{if .Visibility.IsPrivate}}<span class="ds-chip">{{svg "dsi-lock" 14}}{{ctx.Locale.Tr "repo.desc.private"}}</span>{{end}}
									{{if eq .Type 3}}<span class="ds-chip">{{ctx.Locale.Tr "admin.users.reserved"}}</span>{{end}}
								</div>
							</td>
							<td class="ds-r ds-num">{{.NumMembers}}</td>
							<td class="ds-r ds-num">{{.NumTeams}}</td>
							<td class="ds-r ds-num">{{.NumRepos}}</td>
							<td>{{DateUtils.AbsoluteShort .CreatedUnix}}</td>
							<td class="ds-r"><a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{.OrganisationLink}}/settings" aria-label="{{ctx.Locale.Tr "asc_admin.open"}}: {{.Name}}">{{ctx.Locale.Tr "asc_admin.open"}}</a></td>
						</tr>
					{{end}}
				</tbody>
			</table>
		</div>

		<ul class="ds-list adm-only-sm">
			{{range .Users}}
				<li class="ds-li">
					<span class="ds-li-av">{{ctx.AvatarUtils.Avatar . 40 "ds-avatar-org"}}</span>
					<div class="ds-li-main">
						<div class="ds-li-title"><a href="{{.HomeLink}}">{{if .FullName}}{{.FullName}}{{else}}{{.Name}}{{end}}</a>
							{{if .Visibility.IsPrivate}}<span class="ds-chip">{{svg "dsi-lock" 14}}{{ctx.Locale.Tr "repo.desc.private"}}</span>{{end}}
							{{if eq .Type 3}}<span class="ds-chip">{{ctx.Locale.Tr "admin.users.reserved"}}</span>{{end}}
						</div>
						<div class="ds-li-sub adm-mono">{{.Name}}</div>
						<div class="ds-li-meta">
							<span>{{ctx.Locale.TrN .NumMembers "asc_admin.members_one" "asc_admin.members_other" .NumMembers}}</span>
							<span>{{ctx.Locale.TrN .NumRepos "asc_admin.repos_one" "asc_admin.repos_other" .NumRepos}}</span>
							<span>{{ctx.Locale.Tr "asc_admin.created_on" (DateUtils.AbsoluteShort .CreatedUnix)}}</span>
						</div>
						<div class="ds-li-actions"><a class="ds-btn ds-btn-secondary" href="{{.OrganisationLink}}/settings" aria-label="{{ctx.Locale.Tr "asc_admin.open"}}: {{.Name}}">{{ctx.Locale.Tr "asc_admin.open"}}</a></div>
					</div>
				</li>
			{{end}}
		</ul>

		<div class="adm-table-foot">
			<p class="ds-t-small ds-c-2">{{ctx.Locale.Tr "asc_admin.shown_of" (len .Users) .Total}}</p>
			{{template "base/paginate" .}}
		</div>
	{{else if .Keyword}}
		<div class="ds-card">
			{{template "shared/ds/empty" (dict "Icon" "search" "Title" (ctx.Locale.Tr "asc_admin.no_results_title") "Body" (ctx.Locale.Tr "asc_admin.orgs_no_results") "PrimaryLabel" (ctx.Locale.Tr "asc_admin.clear_filters") "PrimaryHref" (print AppSubUrl "/admin/orgs"))}}
		</div>
	{{else}}
		<div class="ds-card">
			{{template "shared/ds/empty" (dict "Icon" "building" "Title" (ctx.Locale.Tr "asc_admin.orgs_empty_title") "Body" (ctx.Locale.Tr "asc_admin.orgs_empty_text") "PrimaryLabel" (ctx.Locale.Tr "admin.orgs.new_orga") "PrimaryHref" (print AppSubUrl "/org/create"))}}
		</div>
	{{end}}
{{template "admin/layout_footer" .}}
