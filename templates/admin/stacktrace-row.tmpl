{{/* One process of the stack trace page, with its goroutine stacks and its child processes. Props: Process, root (the page data). */}}
<li class="ds-li ds-li-wrap adm-proc">
	<span class="adm-tile" aria-hidden="true">
		{{if eq .Process.Type "request"}}{{svg "dsi-globe" 18}}{{else if eq .Process.Type "system"}}{{svg "dsi-cpu" 18}}{{else if eq .Process.Type "normal"}}{{svg "dsi-terminal" 18}}{{else if eq .Process.Type "git"}}{{svg "dsi-branch" 18}}{{else}}{{svg "dsi-code" 18}}{{end}}
	</span>
	<div class="ds-li-main">
		<div class="ds-li-title"><span class="ds-break">{{.Process.Description}}</span></div>
		{{if ne .Process.Type "none"}}<div class="ds-li-meta"><span>{{DateUtils.TimeSince .Process.Start}}</span></div>{{end}}
		{{if .Process.Stacks}}
			<div class="adm-stacks">
				{{range .Process.Stacks}}
					<details class="adm-stack">
						<summary>
							<span class="ds-break">{{.Description}}{{if gt .Count 1}} &times; {{.Count}}{{end}}</span>
							{{range .Labels}}<span class="ds-chip ds-chip-outline">{{.Name}}: {{.Value}}</span>{{end}}
						</summary>
						<ol class="adm-frames">
							{{range .Entry}}
								<li><code class="ds-break">{{.Function}}</code><span class="adm-mono ds-c-2 ds-break">{{.File}}:{{.Line}}</span></li>
							{{end}}
						</ol>
					</details>
				{{end}}
			</div>
		{{end}}
		{{if .Process.Children}}
			<ul class="adm-rows adm-children">
				{{range .Process.Children}}
					{{template "admin/stacktrace-row" dict "Process" . "root" $.root}}
				{{end}}
			</ul>
		{{end}}
	</div>
	{{if or (eq .Process.Type "request") (eq .Process.Type "normal")}}
		<div class="adm-row-side"><button type="button" class="ds-btn ds-btn-danger ds-btn-sm delete-button" data-url="{{.root.Link}}/cancel/{{.Process.PID}}" data-id="{{.Process.PID}}" data-name="{{.Process.Description}}" data-modal-id="cancel-process" aria-label="{{ctx.Locale.Tr "asc_admin.trace_cancel"}}: {{.Process.Description}}">{{svg "dsi-x" 16}}{{ctx.Locale.Tr "asc_admin.cancel"}}</button></div>
	{{end}}
</li>
