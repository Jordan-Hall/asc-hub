{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin monitor")}}
	{{template "admin/head" (dict "Title" (ctx.Locale.Tr "asc_admin.monitor") "Desc" (ctx.Locale.Tr "asc_admin.stats_note"))}}
	{{template "admin/monitor_tabs" (dict "Active" "stats")}}

	<section class="ds-card adm-sec" aria-labelledby="adm-stats-h">
		<div class="ds-card-h"><h2 id="adm-stats-h">{{ctx.Locale.Tr "admin.dashboard.statistic"}}</h2></div>
		<dl class="adm-kv adm-kv-cfg">
			{{range $statsKey, $statsValue := .Stats}}
				<div><dt>{{$statsKey}}</dt><dd class="adm-mono">{{$statsValue}}</dd></div>
			{{end}}
		</dl>
	</section>
{{template "admin/layout_footer" .}}
