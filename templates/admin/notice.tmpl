{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin notice")}}
	{{template "admin/head" (dict "Title" (ctx.Locale.Tr "asc_admin.notices") "Desc" (ctx.Locale.Tr "asc_admin.notices_lead"))}}

	{{if .Notices}}
		<ul class="ds-list">
			{{range .Notices}}
				<li class="ds-li ds-li-wrap">
					<span class="adm-tile adm-tile-warn" aria-hidden="true">{{svg "dsi-bell" 18}}</span>
					<div class="ds-li-main">
						<div class="ds-li-title"><span class="ds-clamp-2 ds-break">{{.Description}}</span> <span class="ds-chip ds-chip-info">{{ctx.Locale.Tr .TrStr}}</span></div>
						<div class="ds-li-meta"><span>{{DateUtils.TimeSince .CreatedUnix}}</span><span>#{{.ID}}</span></div>
					</div>
					<div class="adm-row-side">
						<form method="post" action="{{AppSubUrl}}/admin/notices/delete">
							{{$.CsrfTokenHtml}}
							<input type="hidden" name="ids[]" value="{{.ID}}">
							<input type="hidden" name="dismiss" value="true">
							<button type="submit" class="ds-btn ds-btn-secondary ds-btn-sm" aria-label="{{ctx.Locale.Tr "asc_admin.dismiss"}}: #{{.ID}}">{{ctx.Locale.Tr "asc_admin.dismiss"}}</button>
						</form>
					</div>
				</li>
			{{end}}
		</ul>
		<div class="adm-table-foot">
			<div class="ds-row ds-row-wrap ds-gap-12 ds-items-center">
				<button type="button" class="ds-btn ds-btn-secondary show-modal" data-modal="#adm-dismiss-all">{{ctx.Locale.Tr "asc_admin.dismiss_all"}}</button>
				<p class="ds-t-small ds-c-2">{{ctx.Locale.Tr "asc_admin.notices_keep_note"}}</p>
			</div>
			{{template "base/paginate" .}}
		</div>
		{{template "shared/ds/confirm" (dict "Data" . "ID" "adm-dismiss-all" "Title" (ctx.Locale.Tr "asc_admin.dismiss_all") "Body" (ctx.Locale.Tr "asc_admin.dismiss_all_body") "Action" (print AppSubUrl "/admin/notices/empty") "Confirm" (ctx.Locale.Tr "asc_admin.dismiss_all") "Danger" true)}}
	{{else}}
		<div class="ds-card">
			{{template "shared/ds/empty" (dict "Icon" "check-circle" "Title" (ctx.Locale.Tr "asc_admin.notices_empty_title") "Body" (ctx.Locale.Tr "asc_admin.notices_empty_text"))}}
		</div>
	{{end}}
{{template "admin/layout_footer" .}}
