{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin config")}}
	{{template "admin/head" (dict "Title" (ctx.Locale.Tr "asc_admin.configuration") "Desc" (ctx.Locale.Tr "asc_admin.config_lead"))}}

	{{with .ConfigFile}}
		{{if .Changed}}
			<div class="ds-banner ds-banner-warn adm-sec" role="status" data-testid="config-restart">{{svg "dsi-alert" 18}}<div class="ds-banner-body">
				<p><strong>{{ctx.Locale.TrN (len .Changed) "asc_admin.config_restart_1" "asc_admin.config_restart_n" (len .Changed) .Path}}</strong></p>
				<p class="adm-cfg-changed">{{range $i, $k := .Changed}}{{if $i}}, {{end}}<code>{{$k}}</code>{{end}}</p>
			</div></div>
		{{else if .Problem}}
			<div class="ds-banner ds-banner-warn adm-sec" role="status" data-testid="config-unread">{{svg "dsi-alert" 18}}<p class="ds-banner-body">{{.Problem}}</p></div>
		{{end}}
	{{end}}
	{{template "admin/config_runtime" .}}
	{{template "admin/config_curated" .}}

	<details class="ds-details adm-sec" id="adm-all">
		<summary>{{ctx.Locale.Tr "asc_admin.config_show_all"}}</summary>
		<p class="adm-details-note">{{ctx.Locale.Tr "asc_admin.config_show_all_note"}}</p>
		{{template "admin/config_runtime_more" .}}
		<div class="adm-sec-h adm-sec"><h2>{{ctx.Locale.Tr "asc_admin.config_tab_summary"}}</h2><span class="adm-card-sub">{{ctx.Locale.Tr "asc_admin.config_server_note"}}</span></div>
		{{template "admin/config_server" .}}
	</details>
{{template "admin/layout_footer" .}}
