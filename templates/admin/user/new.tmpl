{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin new user")}}
	{{template "admin/head" (dict "Title" (ctx.Locale.Tr "admin.users.new_account") "Desc" (ctx.Locale.Tr "asc_admin.new_person_lead"))}}

	<form class="adm-form adm-form-card" action="{{.Link}}" method="post">
		{{.CsrfTokenHtml}}
		{{template "base/disable_form_autofill"}}
		<section class="ds-card">
			<div class="ds-card-h"><h2>{{ctx.Locale.Tr "asc_admin.section_account"}}</h2></div>
			<div class="ds-card-b ds-form">
				<div class="ds-form-row ds-form-row-2">
					<div class="ds-field">
						<label class="ds-label" for="login_type">{{ctx.Locale.Tr "admin.users.auth_source"}}</label>
						<select class="ds-select{{if .Err_LoginType}} is-err{{end}}" id="login_type" name="login_type" data-password="required" required>
							<option value="0-0"{{if eq .login_type "0-0"}} selected{{end}}>{{ctx.Locale.Tr "admin.users.local"}}</option>
							{{range .Sources}}<option value="{{.Type.Int}}-{{.ID}}"{{if eq $.login_type (printf "%d-%d" .Type.Int .ID)}} selected{{end}}>{{.Name}}</option>{{end}}
						</select>
					</div>
					<div class="ds-field">
						<label class="ds-label" for="visibility">{{ctx.Locale.Tr "settings.visibility"}}</label>
						<select class="ds-select{{if .Err_Visibility}} is-err{{end}}" id="visibility" name="visibility">
							{{$cur := printf "%d" .DefaultUserVisibilityMode}}{{if .visibility}}{{$cur = printf "%d" .visibility}}{{end}}
							{{range $mode := .AllowedUserVisibilityModes}}
								{{if $mode.IsPublic}}<option value="0"{{if eq $cur "0"}} selected{{end}}>{{ctx.Locale.Tr "settings.visibility.public"}}</option>
								{{else if $mode.IsLimited}}<option value="1"{{if eq $cur "1"}} selected{{end}}>{{ctx.Locale.Tr "settings.visibility.limited"}}</option>
								{{else if $mode.IsPrivate}}<option value="2"{{if eq $cur "2"}} selected{{end}}>{{ctx.Locale.Tr "settings.visibility.private"}}</option>{{end}}
							{{end}}
						</select>
					</div>
				</div>

				<div class="ds-field required non-local {{if eq .login_type "0-0"}}tw-hidden{{end}}">
					<label class="ds-label" for="login_name">{{ctx.Locale.Tr "admin.users.auth_login_name"}}</label>
					<input class="ds-input{{if .Err_LoginName}} is-err{{end}}" id="login_name" name="login_name" value="{{.login_name}}">
				</div>
				<div class="ds-form-row ds-form-row-2">
					<div class="ds-field required">
						<label class="ds-label" for="user_name">{{ctx.Locale.Tr "username"}}</label>
						<input class="ds-input{{if .Err_UserName}} is-err{{end}}" id="user_name" type="text" name="user_name" value="{{.user_name}}" autofocus required maxlength="40" autocorrect="off" autocapitalize="none" spellcheck="false">
					</div>
					<div class="ds-field required">
						<label class="ds-label" for="email">{{ctx.Locale.Tr "email"}}</label>
						<input class="ds-input{{if .Err_Email}} is-err{{end}}" id="email" name="email" type="email" value="{{.email}}" required>
					</div>
				</div>
				<div class="ds-field required local {{if not (eq .login_type "0-0")}}tw-hidden{{end}}">
					<label class="ds-label" for="password">{{ctx.Locale.Tr "password"}}</label>
					<input class="ds-input{{if .Err_Password}} is-err{{end}}" id="password" name="password" type="password" autocomplete="new-password" value="{{.password}}"{{if eq .login_type "0-0"}} required{{end}}>
				</div>
				<div class="local {{if ne .login_type "0-0"}}tw-hidden{{end}}">
					{{template "admin/check" (dict "ID" "must_change_password" "Name" "must_change_password" "Label" (ctx.Locale.Tr "auth.allow_password_change") "Checked" true)}}
				</div>
				{{if .CanSendEmail}}
					{{template "admin/check" (dict "ID" "send_notify" "Name" "send_notify" "Label" (ctx.Locale.Tr "admin.users.send_register_notify") "Checked" .send_notify)}}
				{{end}}
			</div>
		</section>
		<div class="ds-sticky-actions">
			<a class="ds-btn ds-btn-secondary" href="{{AppSubUrl}}/admin/users">{{ctx.Locale.Tr "cancel"}}</a>
			<button class="ds-btn ds-btn-primary" type="submit">{{ctx.Locale.Tr "admin.users.new_account"}}</button>
		</div>
	</form>
{{template "admin/layout_footer" .}}
