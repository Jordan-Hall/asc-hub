{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin edit user")}}
	{{template "admin/head_open" (dict "Title" (ctx.Locale.Tr "admin.users.edit_account") "Desc" (ctx.Locale.Tr "asc_admin.edit_person_lead"))}}
		<a class="ds-btn ds-btn-secondary" href="{{AppSubUrl}}/admin/users/{{.User.ID}}">{{svg "dsi-user" 16}}{{ctx.Locale.Tr "admin.users.details"}}</a>
	{{template "admin/head_close" .}}

	<form class="adm-form adm-form-card" action="./edit" method="post">
		{{.CsrfTokenHtml}}
		{{template "base/disable_form_autofill"}}
		<section class="ds-card" aria-labelledby="adm-e-acct">
			<div class="ds-card-h"><h2 id="adm-e-acct">{{ctx.Locale.Tr "asc_admin.section_account"}}</h2></div>
			<div class="ds-card-b ds-form">
				<div class="ds-form-row ds-form-row-2">
					<div class="ds-field">
						<label class="ds-label" for="user_name">{{ctx.Locale.Tr "username"}}</label>
						<input class="ds-input{{if .Err_UserName}} is-err{{end}}" id="user_name" name="user_name" value="{{.User.Name}}" autofocus{{if not .User.IsLocal}} disabled{{end}} maxlength="40" autocorrect="off" autocapitalize="none" spellcheck="false">
					</div>
					<div class="ds-field">
						<label class="ds-label" for="email">{{ctx.Locale.Tr "email"}}</label>
						<input class="ds-input{{if .Err_Email}} is-err{{end}}" id="email" name="email" type="email" value="{{.User.Email}}" required>
					</div>
				</div>
				<div class="ds-form-row ds-form-row-2">
					<div class="ds-field">
						<label class="ds-label" for="login_type">{{ctx.Locale.Tr "admin.users.auth_source"}}</label>
						<select class="ds-select{{if .Err_LoginType}} is-err{{end}}" id="login_type" name="login_type" required>
							<option value="0-0"{{if eq .LoginSource.ID 0}} selected{{end}}>{{ctx.Locale.Tr "admin.users.local"}}</option>
							{{range .Sources}}<option value="{{.Type.Int}}-{{.ID}}"{{if eq $.LoginSource.ID .ID}} selected{{end}}>{{.Name}}</option>{{end}}
						</select>
					</div>
					<div class="ds-field">
						<label class="ds-label" for="visibility">{{ctx.Locale.Tr "settings.visibility"}}</label>
						<select class="ds-select{{if .Err_Visibility}} is-err{{end}}" id="visibility" name="visibility">
							{{range $mode := .AllowedUserVisibilityModes}}
								{{if $mode.IsPublic}}<option value="0"{{if $.User.Visibility.IsPublic}} selected{{end}}>{{ctx.Locale.Tr "settings.visibility.public"}}</option>
								{{else if $mode.IsLimited}}<option value="1"{{if $.User.Visibility.IsLimited}} selected{{end}}>{{ctx.Locale.Tr "settings.visibility.limited"}}</option>
								{{else if $mode.IsPrivate}}<option value="2"{{if $.User.Visibility.IsPrivate}} selected{{end}}>{{ctx.Locale.Tr "settings.visibility.private"}}</option>{{end}}
							{{end}}
						</select>
					</div>
				</div>
				<div class="ds-field required non-local {{if eq .User.LoginSource 0}}tw-hidden{{end}}">
					<label class="ds-label" for="login_name">{{ctx.Locale.Tr "admin.users.auth_login_name"}}</label>
					<input class="ds-input{{if .Err_LoginName}} is-err{{end}}" id="login_name" name="login_name" value="{{.User.LoginName}}">
				</div>
				<div class="ds-field local {{if not (or (.User.IsLocal) (.User.IsOAuth2))}}tw-hidden{{end}}">
					<label class="ds-label" for="password">{{ctx.Locale.Tr "password"}} <span class="ds-opt">({{ctx.Locale.Tr "asc_shell.optional"}})</span></label>
					<input class="ds-input{{if .Err_Password}} is-err{{end}}" id="password" name="password" type="password" autocomplete="new-password" aria-describedby="adm-pw-help">
					<p class="ds-hint" id="adm-pw-help">{{ctx.Locale.Tr "admin.users.password_helper"}}</p>
				</div>
			</div>
		</section>

		<section class="ds-card" aria-labelledby="adm-e-prof">
			<div class="ds-card-h"><h2 id="adm-e-prof">{{ctx.Locale.Tr "asc_admin.section_profile"}}</h2></div>
			<div class="ds-card-b ds-form">
				<div class="ds-form-row ds-form-row-2">
					<div class="ds-field">
						<label class="ds-label" for="full_name">{{ctx.Locale.Tr "settings.full_name"}}</label>
						<input class="ds-input{{if .Err_FullName}} is-err{{end}}" id="full_name" name="full_name" value="{{.User.FullName}}" maxlength="100">
					</div>
					<div class="ds-field">
						<label class="ds-label" for="pronouns">{{ctx.Locale.Tr "settings.pronouns"}}</label>
						<input class="ds-input" id="pronouns" name="pronouns" value="{{.User.Pronouns}}" maxlength="50">
					</div>
				</div>
				{{template "admin/check" (dict "ID" "hide_email" "Name" "hide_email" "Label" (ctx.Locale.Tr "settings.keep_email_private") "Checked" .User.KeepEmailPrivate "Hint" (ctx.Locale.Tr "settings.keep_email_private_popup" .User.GetPlaceholderEmail))}}
				<div class="ds-form-row ds-form-row-2">
					<div class="ds-field">
						<label class="ds-label" for="language">{{ctx.Locale.Tr "settings.language"}}</label>
						<select class="ds-select{{if .Err_Language}} is-err{{end}}" id="language" name="language">
							{{range .AllLangs}}<option value="{{.Lang}}"{{if eq $.User.Language .Lang}} selected{{end}}>{{.Name}}</option>{{end}}
						</select>
					</div>
					<div class="ds-field">
						<label class="ds-label" for="location">{{ctx.Locale.Tr "settings.location"}}</label>
						<input class="ds-input{{if .Err_Location}} is-err{{end}}" id="location" name="location" value="{{.User.Location}}" maxlength="50">
					</div>
				</div>
				<div class="ds-field">
					<label class="ds-label" for="website">{{ctx.Locale.Tr "settings.website"}}</label>
					<input class="ds-input{{if .Err_Website}} is-err{{end}}" id="website" name="website" type="url" value="{{.User.Website}}" maxlength="255" pattern="{{.ValidSiteURLPattern}}" aria-describedby="adm-web-help">
					<p class="ds-hint" id="adm-web-help">{{ctx.Locale.Tr "form.website.valid_url_schemes" (StringUtils.Join .ValidSiteURLSchemes ", ")}}</p>
				</div>
			</div>
		</section>

		<section class="ds-card" aria-labelledby="adm-e-perm">
			<div class="ds-card-h"><h2 id="adm-e-perm">{{ctx.Locale.Tr "asc_admin.section_permissions"}}</h2></div>
			<div class="ds-card-b ds-form">
				<div class="ds-field">
					<label class="ds-label" for="max_repo_creation">{{ctx.Locale.Tr "admin.users.max_repo_creation"}}</label>
					<input class="ds-input{{if .Err_MaxRepoCreation}} is-err{{end}}" id="max_repo_creation" name="max_repo_creation" type="number" min="-1" value="{{.User.MaxRepoCreation}}" aria-describedby="adm-max-help">
					<p class="ds-hint" id="adm-max-help">{{ctx.Locale.Tr "admin.users.max_repo_creation_desc"}}</p>
				</div>
				{{template "admin/check" (dict "ID" "active" "Name" "active" "Label" (ctx.Locale.Tr "admin.users.is_activated") "Checked" .User.IsActive "Hint" (ctx.Locale.Tr "admin.users.activated.description"))}}
				{{template "admin/check" (dict "ID" "prohibit_login" "Name" "prohibit_login" "Label" (ctx.Locale.Tr "admin.users.prohibit_login") "Checked" .User.ProhibitLogin "Disabled" (eq .User.ID .SignedUserID) "Hint" (ctx.Locale.Tr "admin.users.block.description"))}}
				{{template "admin/check" (dict "ID" "admin" "Name" "admin" "Label" (ctx.Locale.Tr "admin.users.is_admin") "Checked" .User.IsAdmin "Hint" (ctx.Locale.Tr "admin.users.admin.description"))}}
				{{template "admin/check" (dict "ID" "restricted" "Name" "restricted" "Label" (ctx.Locale.Tr "admin.users.is_restricted") "Checked" .User.IsRestricted "Hint" (ctx.Locale.Tr "admin.users.restricted.description"))}}
				{{if not DisableGitHooks}}
					{{template "admin/check" (dict "ID" "allow_git_hook" "Name" "allow_git_hook" "Label" (ctx.Locale.Tr "admin.users.allow_git_hook") "Checked" .User.CanEditGitHook "Hint" (ctx.Locale.Tr "admin.users.allow_git_hook_tooltip"))}}
				{{end}}
				{{if not (or (DisableImportLocal) (.DisableMigrations))}}
					{{template "admin/check" (dict "ID" "allow_import_local" "Name" "allow_import_local" "Label" (ctx.Locale.Tr "admin.users.allow_import_local") "Checked" .User.CanImportLocal "Hint" (ctx.Locale.Tr "admin.users.local_import.description"))}}
				{{end}}
				{{if not .DisableRegularOrgCreation}}
					{{template "admin/check" (dict "ID" "allow_create_organization" "Name" "allow_create_organization" "Label" (ctx.Locale.Tr "admin.users.allow_create_organization") "Checked" .User.CanCreateOrganization "Hint" (ctx.Locale.Tr "admin.users.organization_creation.description"))}}
				{{end}}
				{{if .TwoFactorEnabled}}
					{{template "admin/check" (dict "ID" "reset_2fa" "Name" "reset_2fa" "Label" (ctx.Locale.Tr "admin.users.reset_2fa"))}}
				{{end}}
			</div>
		</section>

		<div class="ds-sticky-actions">
			<a class="ds-btn ds-btn-secondary" href="{{AppSubUrl}}/admin/users">{{ctx.Locale.Tr "cancel"}}</a>
			<button class="ds-btn ds-btn-primary" type="submit">{{ctx.Locale.Tr "admin.users.update_profile"}}</button>
		</div>
	</form>

	<section class="ds-card adm-sec" aria-labelledby="adm-e-avatar">
		<div class="ds-card-h"><h2 id="adm-e-avatar">{{ctx.Locale.Tr "settings.avatar"}}</h2></div>
		<form class="ds-card-b ds-form" action="./avatar" method="post" enctype="multipart/form-data">
			{{.CsrfTokenHtml}}
			<div class="adm-who">{{ctx.AvatarUtils.Avatar .User 72}}</div>
			{{if not .DisableGravatar}}
				<div class="ds-field">
					<div class="ds-check"><input type="radio" id="avatar-lookup" name="source" value="lookup"{{if not .User.UseCustomAvatar}} checked{{end}}><label for="avatar-lookup">{{ctx.Locale.Tr "settings.lookup_avatar_by_mail"}}</label></div>
				</div>
				<div class="ds-field">
					<label class="ds-label" for="gravatar">{{ctx.Locale.Tr "asc_admin.avatar_email"}}</label>
					<input class="ds-input{{if .Err_Gravatar}} is-err{{end}}" id="gravatar" name="gravatar" value="{{.User.AvatarEmail}}">
				</div>
			{{end}}
			<div class="ds-field">
				<div class="ds-check"><input type="radio" id="avatar-local" name="source" value="local"{{if .User.UseCustomAvatar}} checked{{end}}><label for="avatar-local">{{ctx.Locale.Tr "settings.enable_custom_avatar"}}</label></div>
			</div>
			<div class="ds-field">
				<label class="ds-label" for="avatar">{{ctx.Locale.Tr "settings.choose_new_avatar"}}</label>
				<input class="ds-input" id="avatar" name="avatar" type="file" accept="image/png,image/jpeg,image/gif,image/webp" aria-describedby="adm-av-help">
				<p class="ds-hint" id="adm-av-help">{{ctx.Locale.Tr "avatar.constraints_hint" (ctx.Locale.TrSize .MaxAvatarFileSize) .MaxAvatarWidth .MaxAvatarHeight}}</p>
			</div>
			<div class="ds-row ds-row-wrap ds-gap-8">
				<button class="ds-btn ds-btn-primary" type="submit">{{ctx.Locale.Tr "settings.update_avatar"}}</button>
				<button class="ds-btn ds-btn-danger link-action" type="button" data-url="./avatar/delete">{{ctx.Locale.Tr "settings.delete_current_avatar"}}</button>
			</div>
		</form>
	</section>

	<section class="ds-card adm-danger adm-sec" aria-labelledby="adm-e-del">
		<div class="ds-card-b adm-danger-in">
			<div class="ds-min0">
				<h2 id="adm-e-del" class="ds-t-h4">{{ctx.Locale.Tr "asc_admin.delete_person"}}</h2>
				<p class="ds-t-small ds-c-2">{{ctx.Locale.Tr "asc_admin.delete_person_text"}}</p>
			</div>
			<button type="button" class="ds-btn ds-btn-danger show-modal" data-modal="#delete-user-modal">{{ctx.Locale.Tr "admin.users.delete_account"}}</button>
		</div>
	</section>

<dialog id="delete-user-modal">
	<article>
		<header>{{ctx.Locale.Tr "settings.delete_account_title"}}</header>
		<form method="post" action="./delete">
			{{.CsrfTokenHtml}}
			<div class="content ds-form">
				<p>{{ctx.Locale.Tr "settings.delete_account_desc"}}</p>
				{{template "admin/check" (dict "ID" "purge" "Name" "purge" "Label" (ctx.Locale.Tr "admin.users.purge") "Hint" (ctx.Locale.Tr "admin.users.purge_help"))}}
			</div>
			<div class="actions">
				<button type="button" class="ds-btn ds-btn-secondary cancel">{{ctx.Locale.Tr "cancel"}}</button>
				<button type="submit" class="ds-btn ds-btn-danger-fill">{{ctx.Locale.Tr "modal.confirm"}}</button>
			</div>
		</form>
	</article>
</dialog>
{{template "admin/layout_footer" .}}
