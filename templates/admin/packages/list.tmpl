{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin user")}}
	{{template "admin/head" (dict "Title" (ctx.Locale.Tr "asc_admin.packages") "Desc" (ctx.Locale.Tr "asc_admin.packages_lead"))}}

	<div class="ds-grid-stats adm-stats adm-stats-3" role="group" aria-label="{{ctx.Locale.Tr "asc_admin.figures"}}">
		<div class="ds-stat"><div class="ds-stat-label">{{ctx.Locale.Tr "asc_admin.packages"}}</div><div class="ds-stat-value">{{ctx.Locale.PrettyNumber .TotalCount}}</div></div>
		<div class="ds-stat"><div class="ds-stat-label">{{ctx.Locale.Tr "admin.packages.size"}}</div><div class="ds-stat-value">{{ctx.Locale.TrSize .TotalBlobSize}}</div></div>
		<div class="ds-stat"><div class="ds-stat-label">{{ctx.Locale.Tr "asc_admin.unreferenced"}}</div><div class="ds-stat-value">{{ctx.Locale.TrSize .TotalUnreferencedBlobSize}}</div></div>
	</div>

	<div class="adm-filter adm-sec">
		<form class="ds-filterbar-form ignore-dirty" role="search" method="get" action="{{AppSubUrl}}/admin/packages">
			<div class="ds-inwrap">
				{{svg "dsi-search" 16}}
				<label class="ds-sr" for="adm-pkg-q">{{ctx.Locale.Tr "asc_admin.packages_search"}}</label>
				<input id="adm-pkg-q" class="ds-input" type="search" name="q" value="{{.Query}}" maxlength="255" spellcheck="false" enterkeyhint="search" placeholder="{{ctx.Locale.Tr "asc_admin.packages_search"}}">
			</div>
			<label class="ds-selectpill">
				<span class="ds-sr">{{ctx.Locale.Tr "packages.filter.type"}}</span>
				<select name="type">
					<option value="">{{ctx.Locale.Tr "asc_admin.packages_all_types"}}</option>
					{{range $type := .AvailableTypes}}<option{{if eq $.PackageType $type}} selected{{end}} value="{{$type}}">{{$type.Name}}</option>{{end}}
				</select>
				{{svg "dsi-chevron-down" 16}}
			</label>
			<button type="submit" class="ds-btn ds-btn-secondary">{{ctx.Locale.Tr "asc_shell.search_label"}}</button>
		</form>
	</div>

	{{if .PackageDescriptors}}
		<div class="ds-table-wrap adm-only-md">
			<table class="ds-table">
				<caption class="ds-sr">{{ctx.Locale.Tr "admin.packages.package_manage_panel"}}</caption>
				<thead>
					<tr>
						<th scope="col">{{ctx.Locale.Tr "asc_admin.col_package"}}</th>
						<th scope="col">{{ctx.Locale.Tr "asc_admin.col_type"}}</th>
						<th scope="col">{{ctx.Locale.Tr "asc_admin.col_version"}}</th>
						<th scope="col" class="ds-r">{{ctx.Locale.Tr "asc_admin.col_size"}}</th>
						<th scope="col">{{ctx.Locale.Tr "asc_admin.col_published"}}</th>
						<th scope="col"><span class="ds-sr">{{ctx.Locale.Tr "asc_admin.col_actions"}}</span></th>
					</tr>
				</thead>
				<tbody>
					{{range .PackageDescriptors}}
						<tr>
							<td>
								<span class="adm-who-name ds-break">{{.Package.Name}}</span>
								<span class="adm-who-sub"><a class="ds-link" href="{{.Owner.HomeLink}}">{{.Owner.Name}}</a>{{if .Repository}} · <a class="ds-link" href="{{.Repository.Link}}">{{.Repository.Name}}</a>{{end}}</span>
							</td>
							<td><span class="ds-chip ds-chip-outline">{{.Package.Type.Name}}</span></td>
							<td><a class="ds-link adm-mono" href="{{.VersionWebLink}}">{{.Version.Version}}</a></td>
							<td class="ds-r ds-num">{{ctx.Locale.TrSize .CalculateBlobSize}}</td>
							<td>{{DateUtils.TimeSince .Version.CreatedUnix}}</td>
							<td class="ds-r"><button type="button" class="ds-btn ds-btn-danger ds-btn-sm delete-button" data-url="{{$.Link}}/delete?page={{$.Page.Paginater.Current}}&sort={{$.SortType}}" data-id="{{.Version.ID}}" data-name="{{.Package.Name}}" data-data-version="{{.Version.Version}}" data-modal-id="delete-package" aria-label="{{ctx.Locale.Tr "asc_admin.delete"}}: {{.Package.Name}} {{.Version.Version}}">{{ctx.Locale.Tr "asc_admin.delete"}}</button></td>
						</tr>
					{{end}}
				</tbody>
			</table>
		</div>

		<ul class="ds-list adm-only-sm">
			{{range .PackageDescriptors}}
				<li class="ds-li">
					<div class="ds-li-main">
						<div class="ds-li-title ds-break"><span>{{.Package.Name}}</span> <span class="ds-chip ds-chip-outline">{{.Package.Type.Name}}</span></div>
						<div class="ds-li-sub"><a class="ds-link adm-mono" href="{{.VersionWebLink}}">{{.Version.Version}}</a> · <a class="ds-link" href="{{.Owner.HomeLink}}">{{.Owner.Name}}</a></div>
						<div class="ds-li-meta">
							<span>{{ctx.Locale.TrSize .CalculateBlobSize}}</span>
							<span>{{DateUtils.TimeSince .Version.CreatedUnix}}</span>
						</div>
						<div class="ds-li-actions"><button type="button" class="ds-btn ds-btn-danger delete-button" data-url="{{$.Link}}/delete?page={{$.Page.Paginater.Current}}&sort={{$.SortType}}" data-id="{{.Version.ID}}" data-name="{{.Package.Name}}" data-data-version="{{.Version.Version}}" data-modal-id="delete-package">{{svg "dsi-trash" 16}}{{ctx.Locale.Tr "asc_admin.delete"}}</button></div>
					</div>
				</li>
			{{end}}
		</ul>

		<div class="adm-table-foot">
			<p class="ds-t-small ds-c-2">{{ctx.Locale.Tr "asc_admin.shown_of" (len .PackageDescriptors) .TotalCount}}</p>
			{{template "base/paginate" .}}
		</div>
	{{else if or .Query .PackageType}}
		<div class="ds-card">
			{{template "shared/ds/empty" (dict "Icon" "search" "Title" (ctx.Locale.Tr "asc_admin.no_results_title") "Body" (ctx.Locale.Tr "asc_admin.packages_no_results") "PrimaryLabel" (ctx.Locale.Tr "asc_admin.clear_filters") "PrimaryHref" (print AppSubUrl "/admin/packages"))}}
		</div>
	{{else}}
		<div class="ds-card">
			{{template "shared/ds/empty" (dict "Icon" "package" "Title" (ctx.Locale.Tr "asc_admin.packages_empty_title") "Body" (ctx.Locale.Tr "asc_admin.packages_empty_text"))}}
		</div>
	{{end}}

	<form class="adm-sec" method="post" action="{{AppSubUrl}}/admin/packages/cleanup">
		{{.CsrfTokenHtml}}
		<button class="ds-btn ds-btn-secondary" type="submit">{{svg "dsi-trash" 16}}{{ctx.Locale.Tr "asc_admin.packages_cleanup"}}</button>
		<p class="ds-hint ds-mt-8">{{ctx.Locale.Tr "asc_admin.packages_cleanup_note"}}</p>
		<p class="ds-mt-8"><a href="{{AppSubUrl}}/admin/packages/cleanup/rules">{{ctx.Locale.Tr "asc_admin.packages_rules_link"}}</a></p>
	</form>

<div class="ui g-modal-confirm delete modal" id="delete-package">
	<div class="header">
		{{svg "octicon-trash"}}
		{{ctx.Locale.Tr "packages.settings.delete"}}
	</div>
	<div class="content">
		{{ctx.Locale.Tr "packages.settings.delete.notice" (`<span class="name"></span>`|TrustHTML) (`<span class="dataVersion"></span>`|TrustHTML)}}
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>
{{template "admin/layout_footer" .}}
