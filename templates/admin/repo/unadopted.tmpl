{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin")}}
	{{template "admin/head" (dict "Title" (ctx.Locale.Tr "admin.repos.unadopted") "Desc" (ctx.Locale.Tr "asc_admin.unadopted_lead") "ActionLabel" (ctx.Locale.Tr "asc_admin.repositories") "ActionHref" (print AppSubUrl "/admin/repos") "Secondary" true)}}

	<div class="adm-filter">
		<form class="ds-filterbar-form ignore-dirty" role="search" method="get" action="{{AppSubUrl}}/admin/repos/unadopted">
			<input name="search" value="true" type="hidden">
			<div class="ds-inwrap">
				{{svg "dsi-search" 16}}
				<label class="ds-sr" for="adm-adopt-q">{{ctx.Locale.Tr "repo.adopt_search"}}</label>
				<input id="adm-adopt-q" class="ds-input" type="search" name="q" value="{{.Keyword}}" maxlength="255" spellcheck="false" enterkeyhint="search" placeholder="{{ctx.Locale.Tr "repo.adopt_search"}}" autofocus>
			</div>
			<button type="submit" class="ds-btn ds-btn-secondary">{{ctx.Locale.Tr "asc_shell.search_label"}}</button>
		</form>
	</div>

	{{if .search}}
		{{if .Dirs}}
			<ul class="ds-list">
				{{range $dirI, $dir := .Dirs}}
					<li class="ds-li ds-li-wrap">
						<span class="adm-tile" aria-hidden="true">{{svg "dsi-folder" 18}}</span>
						<div class="ds-li-main"><div class="ds-li-title adm-mono ds-break">{{$dir}}</div></div>
						<div class="adm-row-side">
							<button type="button" class="ds-btn ds-btn-primary ds-btn-sm show-modal" data-modal="#adopt-unadopted-modal-{{$dirI}}">{{svg "dsi-plus" 16}}{{ctx.Locale.Tr "repo.adopt_preexisting_label"}}</button>
							<button type="button" class="ds-btn ds-btn-danger ds-btn-sm show-modal" data-modal="#delete-unadopted-modal-{{$dirI}}">{{svg "dsi-x" 16}}{{ctx.Locale.Tr "repo.delete_preexisting_label"}}</button>
						</div>
					</li>
				{{end}}
			</ul>
			{{range $dirI, $dir := .Dirs}}
				{{template "shared/ds/confirm" (dict "Data" $ "ID" (print "adopt-unadopted-modal-" $dirI) "Title" (ctx.Locale.Tr "repo.adopt_preexisting") "Body" (ctx.Locale.Tr "repo.adopt_preexisting_content" $dir) "Action" (print AppSubUrl "/admin/repos/unadopted") "Confirm" (ctx.Locale.Tr "modal.confirm") "Fields" (dict "id" $dir "action" "adopt" "q" $.Keyword "page" $.CurrentPage))}}
				{{template "shared/ds/confirm" (dict "Data" $ "ID" (print "delete-unadopted-modal-" $dirI) "Title" (ctx.Locale.Tr "repo.delete_preexisting") "Body" (ctx.Locale.Tr "repo.delete_preexisting_content" $dir) "Action" (print AppSubUrl "/admin/repos/unadopted") "Confirm" (ctx.Locale.Tr "modal.confirm") "Danger" true "Fields" (dict "id" $dir "action" "delete" "q" $.Keyword "page" $.CurrentPage))}}
			{{end}}
		{{else}}
			<div class="ds-card">
				{{template "shared/ds/empty" (dict "Icon" "folder" "Title" (ctx.Locale.Tr "asc_admin.unadopted_none_title") "Body" (ctx.Locale.Tr "admin.repos.unadopted.no_more"))}}
			</div>
		{{end}}
		{{template "base/paginate" .}}
	{{else}}
		<div class="ds-card">
			{{template "shared/ds/empty" (dict "Icon" "search" "Title" (ctx.Locale.Tr "asc_admin.unadopted_search_title") "Body" (ctx.Locale.Tr "asc_admin.unadopted_search_text"))}}
		</div>
	{{end}}
{{template "admin/layout_footer" .}}
