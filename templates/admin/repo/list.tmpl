{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin")}}
	{{template "admin/head" (dict "Title" (ctx.Locale.Tr "asc_admin.repositories") "Desc" (ctx.Locale.Tr "asc_admin.repos_lead") "ActionLabel" (ctx.Locale.Tr "admin.repos.unadopted") "ActionHref" (print AppSubUrl "/admin/repos/unadopted") "ActionIcon" "folder" "Secondary" true)}}

	<div class="adm-filter">
		<form class="ds-filterbar-form ignore-dirty" role="search" method="get" action="{{AppSubUrl}}/admin/repos">
			<div class="ds-inwrap">
				{{svg "dsi-search" 16}}
				<label class="ds-sr" for="adm-repo-q">{{ctx.Locale.Tr "asc_admin.repos_search"}}</label>
				<input id="adm-repo-q" class="ds-input" type="search" name="q" value="{{.Keyword}}" maxlength="255" spellcheck="false" enterkeyhint="search" placeholder="{{ctx.Locale.Tr "asc_admin.repos_search"}}">
			</div>
			<label class="ds-selectpill">
				<span class="ds-sr">{{ctx.Locale.Tr "repo.issues.filter_sort"}}</span>
				<select name="sort">
					<option value="recentupdate"{{if or (eq .SortType "recentupdate") (not .SortType)}} selected{{end}}>{{ctx.Locale.Tr "repo.issues.filter_sort.recentupdate"}}</option>
					<option value="leastupdate"{{if eq .SortType "leastupdate"}} selected{{end}}>{{ctx.Locale.Tr "repo.issues.filter_sort.leastupdate"}}</option>
					<option value="alphabetically"{{if eq .SortType "alphabetically"}} selected{{end}}>{{ctx.Locale.Tr "repo.issues.label.filter_sort.alphabetically"}}</option>
					<option value="reversealphabetically"{{if eq .SortType "reversealphabetically"}} selected{{end}}>{{ctx.Locale.Tr "repo.issues.label.filter_sort.reverse_alphabetically"}}</option>
					<option value="newest"{{if eq .SortType "newest"}} selected{{end}}>{{ctx.Locale.Tr "repo.issues.filter_sort.latest"}}</option>
					<option value="oldest"{{if eq .SortType "oldest"}} selected{{end}}>{{ctx.Locale.Tr "repo.issues.filter_sort.oldest"}}</option>
					<option value="reversegitsize"{{if eq .SortType "reversegitsize"}} selected{{end}}>{{ctx.Locale.Tr "admin.repos.size"}} ↓</option>
					<option value="gitsize"{{if eq .SortType "gitsize"}} selected{{end}}>{{ctx.Locale.Tr "admin.repos.size"}} ↑</option>
				</select>
				{{svg "dsi-chevron-down" 16}}
			</label>
			<button type="submit" class="ds-btn ds-btn-secondary">{{ctx.Locale.Tr "asc_shell.search_label"}}</button>
		</form>
	</div>

	{{if .Repos}}
		<div class="ds-table-wrap adm-only-md">
			<table class="ds-table">
				<caption class="ds-sr">{{ctx.Locale.Tr "admin.repos.repo_manage_panel"}}</caption>
				<thead>
					<tr>
						<th scope="col">{{ctx.Locale.Tr "asc_admin.col_repo"}}</th>
						<th scope="col">{{ctx.Locale.Tr "asc_admin.visibility"}}</th>
						<th scope="col" class="ds-r">{{ctx.Locale.Tr "admin.repos.size"}}</th>
						<th scope="col" class="ds-r">{{ctx.Locale.Tr "admin.repos.issues"}}</th>
						<th scope="col">{{ctx.Locale.Tr "asc_admin.col_activity"}}</th>
						<th scope="col"><span class="ds-sr">{{ctx.Locale.Tr "asc_admin.col_actions"}}</span></th>
					</tr>
				</thead>
				<tbody>
					{{range .Repos}}
						<tr>
							<td>
								<a class="adm-who-name" href="{{.Link}}">{{.FullName}}</a>
								<span class="adm-who-sub">{{.Owner.DisplayName}}</span>
							</td>
							<td>{{template "admin/repo/visibility_chip" .}}</td>
							<td class="ds-r ds-num">{{template "admin/repo/size" .}}</td>
							<td class="ds-r ds-num">{{.NumIssues ctx}}</td>
							<td>{{DateUtils.TimeSince .UpdatedUnix}}</td>
							<td class="ds-r">
								<div class="adm-acts">
									<a class="ds-btn ds-btn-secondary ds-btn-sm" href="{{.Link}}/settings" aria-label="{{ctx.Locale.Tr "asc_admin.manage"}}: {{.FullName}}">{{ctx.Locale.Tr "asc_admin.manage"}}</a>
									<button type="button" class="ds-btn ds-btn-danger ds-btn-sm delete-button" data-url="{{$.Link}}/delete?page={{$.Page.Paginater.Current}}&sort={{$.SortType}}" data-id="{{.ID}}" data-name="{{.FullName}}" data-modal-id="delete-repo" aria-label="{{ctx.Locale.Tr "asc_admin.delete"}}: {{.FullName}}">{{svg "dsi-trash" 16}}</button>
								</div>
							</td>
						</tr>
					{{end}}
				</tbody>
			</table>
		</div>

		<ul class="ds-list adm-only-sm">
			{{range .Repos}}
				<li class="ds-li">
					<div class="ds-li-main">
						<div class="ds-li-title"><a href="{{.Link}}">{{.FullName}}</a></div>
						<div class="ds-li-sub">{{.Owner.DisplayName}}</div>
						<div class="ds-chips adm-chip-row">{{template "admin/repo/visibility_chip" .}}</div>
						<div class="ds-li-meta">
							<span>{{template "admin/repo/size" .}}</span>
							<span>{{ctx.Locale.Tr "org.repo_updated" (DateUtils.TimeSince .UpdatedUnix)}}</span>
						</div>
						<div class="ds-li-actions">
							<a class="ds-btn ds-btn-secondary" href="{{.Link}}/settings" aria-label="{{ctx.Locale.Tr "asc_admin.manage"}}: {{.FullName}}">{{ctx.Locale.Tr "asc_admin.manage"}}</a>
							<button type="button" class="ds-btn ds-btn-danger delete-button" data-url="{{$.Link}}/delete?page={{$.Page.Paginater.Current}}&sort={{$.SortType}}" data-id="{{.ID}}" data-name="{{.FullName}}" data-modal-id="delete-repo">{{svg "dsi-trash" 16}}{{ctx.Locale.Tr "asc_admin.delete"}}</button>
						</div>
					</div>
				</li>
			{{end}}
		</ul>

		<div class="adm-table-foot">
			<p class="ds-t-small ds-c-2">{{ctx.Locale.Tr "asc_admin.shown_of" (len .Repos) .Total}}</p>
			{{template "base/paginate" .}}
		</div>
	{{else if .Keyword}}
		<div class="ds-card">
			{{template "shared/ds/empty" (dict "Icon" "search" "Title" (ctx.Locale.Tr "asc_admin.no_results_title") "Body" (ctx.Locale.Tr "asc_admin.repos_no_results") "PrimaryLabel" (ctx.Locale.Tr "asc_admin.clear_filters") "PrimaryHref" (print AppSubUrl "/admin/repos"))}}
		</div>
	{{else}}
		<div class="ds-card">
			{{template "shared/ds/empty" (dict "Icon" "file" "Title" (ctx.Locale.Tr "asc_admin.repos_empty_title") "Body" (ctx.Locale.Tr "asc_admin.repos_empty_text"))}}
		</div>
	{{end}}

	<section class="adm-sec" aria-labelledby="adm-unadopted">
		<div class="adm-sec-h"><h2 id="adm-unadopted">{{ctx.Locale.Tr "admin.repos.unadopted"}}</h2></div>
		<div class="ds-card">
			{{template "shared/ds/empty" (dict "Icon" "folder" "Title" (ctx.Locale.Tr "asc_admin.unadopted_none_title") "Body" (ctx.Locale.Tr "asc_admin.unadopted_lead") "PrimaryLabel" (ctx.Locale.Tr "asc_admin.unadopted_search_title") "PrimaryHref" (print AppSubUrl "/admin/repos/unadopted?search=true"))}}
		</div>
	</section>

<div class="ui g-modal-confirm delete modal" id="delete-repo">
	<div class="header">
		{{svg "octicon-trash"}}
		{{ctx.Locale.Tr "repo.settings.delete"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "repo.settings.delete_desc"}}</p>
		{{ctx.Locale.Tr "repo.settings.delete_notices_2" (`<span class="name"></span>`|TrustHTML)}}<br>
		{{ctx.Locale.Tr "repo.settings.delete_notices_fork_1"}}<br>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>
{{template "admin/layout_footer" .}}
