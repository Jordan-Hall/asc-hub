{{/* The site administration menu: the same shell as the account settings (user/settings/navbar). */}}
{{$base := print AppSubUrl "/admin"}}
<nav class="ds-settings-nav" id="settings-menu" aria-label="{{ctx.Locale.Tr "admin.settings"}}">
	{{template "shared/ds/snav_bar" (dict "Title" (ctx.Locale.Tr "admin.settings"))}}
	<div class="ds-settings-nav-in">
		{{template "shared/ds/snav_who" (dict "Icon" "shield-check" "Name" (ctx.Locale.Tr "admin.settings") "Sub" (ctx.Locale.Tr "asc_shell.sn_admin_sub"))}}

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_shell.sn_overview"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" $base "Label" (ctx.Locale.Tr "admin.dashboard") "Icon" "grid" "Active" .PageIsAdminDashboard)}}
			{{if .DatabaseType.IsMySQL}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/self_check") "Label" (ctx.Locale.Tr "admin.self_check") "Icon" "activity" "Active" .PageIsAdminSelfCheck)}}
			{{end}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/notices") "Label" (ctx.Locale.Tr "admin.notices") "Icon" "bell" "Active" .PageIsAdminNotices)}}
		</ul>

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "admin.identity_access"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/users") "Label" (ctx.Locale.Tr "admin.users") "Icon" "users" "Active" .PageIsAdminUsers)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/orgs") "Label" (ctx.Locale.Tr "admin.organizations") "Icon" "building" "Active" .PageIsAdminOrganizations)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/emails") "Label" (ctx.Locale.Tr "admin.emails") "Icon" "mail" "Active" .PageIsAdminEmails)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/auths") "Label" (ctx.Locale.Tr "admin.authentication") "Icon" "key" "Active" .PageIsAdminAuthentications)}}
			{{if .EnableModeration}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/moderation/reports") "Label" (ctx.Locale.Tr "admin.moderation.moderation_reports") "Icon" "flag" "Active" .PageIsAdminModerationReports)}}
			{{end}}
		</ul>

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "admin.assets"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/repos") "Label" (ctx.Locale.Tr "admin.repositories") "Icon" "book" "Active" .PageIsAdminRepositories)}}
			{{if .EnablePackages}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/packages") "Label" (ctx.Locale.Tr "packages.title") "Icon" "package" "Active" .PageIsAdminPackages)}}
			{{end}}
		</ul>

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "admin.integrations"}}</h2>
		<ul class="ds-settings-list">
			{{if .EnableOAuth2}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/applications") "Label" (ctx.Locale.Tr "settings.applications") "Icon" "puzzle" "Active" .PageIsAdminApplications)}}
			{{end}}
			{{if not DisableWebhooks}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/hooks") "Label" (ctx.Locale.Tr "admin.hooks") "Icon" "link" "Active" (or .PageIsAdminDefaultHooks .PageIsAdminSystemHooks))}}
			{{end}}
			{{if .EnableActions}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/actions/runners") "Label" (ctx.Locale.Tr "actions.runners") "Icon" "cpu" "Active" .PageIsSharedSettingsRunners)}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/actions/variables") "Label" (ctx.Locale.Tr "actions.variables") "Icon" "hash" "Active" .PageIsSharedSettingsVariables)}}
			{{end}}
			{{if .EnableFederation}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/federation/hosts") "Label" (ctx.Locale.Tr "admin.federation.hosts") "Icon" "globe" "Active" .PageIsAdminFederationHosts)}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/federation/users") "Label" (ctx.Locale.Tr "admin.federation.users") "Icon" "users" "Active" .PageIsAdminFederationUsers)}}
			{{end}}
		</ul>

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "admin.config"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/config") "Label" (ctx.Locale.Tr "admin.config_summary") "Icon" "list" "Active" .PageIsAdminConfigSummary)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/config/settings") "Label" (ctx.Locale.Tr "admin.config_settings") "Icon" "sliders" "Active" .PageIsAdminConfigSettings)}}
			{{if .AscEnabled}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/audit") "Label" (ctx.Locale.Tr "asc_shell.sn_audit_log") "Icon" "history" "Active" .PageIsAdminAscAudit)}}
			{{end}}
		</ul>

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "admin.monitor"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/monitor/stats") "Label" (ctx.Locale.Tr "admin.monitor.stats") "Icon" "chart" "Active" .PageIsAdminMonitorStats)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/monitor/cron") "Label" (ctx.Locale.Tr "admin.monitor.cron") "Icon" "clock" "Active" .PageIsAdminMonitorCron)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/monitor/queue") "Label" (ctx.Locale.Tr "admin.monitor.queues") "Icon" "queue" "Active" .PageIsAdminMonitorQueue)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/monitor/stacktrace") "Label" (ctx.Locale.Tr "admin.monitor.stacktrace") "Icon" "layers" "Active" .PageIsAdminMonitorStacktrace)}}
		</ul>
	</div>
</nav>
