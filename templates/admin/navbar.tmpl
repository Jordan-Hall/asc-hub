{{/* The site administration menu: the same shell as the account settings (user/settings/navbar). One entry per page of the boards (H1 to H16). */}}
{{$base := print AppSubUrl "/admin"}}
<nav class="ds-settings-nav" id="settings-menu" aria-label="{{ctx.Locale.Tr "asc_admin.menu"}}">
	{{template "shared/ds/snav_bar" (dict "Title" (ctx.Locale.Tr "asc_admin.site_admin"))}}
	<div class="ds-settings-nav-in">
		{{template "shared/ds/snav_who" (dict "Icon" "shield-check" "Name" (ctx.Locale.Tr "asc_admin.site_admin") "Sub" AppDomain)}}

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_admin.grp_overview"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" $base "Label" (ctx.Locale.Tr "asc_admin.dashboard") "Icon" "gauge" "Active" .PageIsAdminDashboard)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/self_check") "Label" (ctx.Locale.Tr "asc_admin.health") "Icon" "activity" "Active" .PageIsAdminSelfCheck)}}
		</ul>

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_admin.grp_people"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/users") "Label" (ctx.Locale.Tr "asc_admin.users") "Icon" "users" "Active" (or .PageIsAdminUsers .PageIsAdminEmails))}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/orgs") "Label" (ctx.Locale.Tr "asc_admin.organizations") "Icon" "building" "Active" .PageIsAdminOrganizations)}}
			{{if .EnableModeration}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/moderation/reports") "Label" (ctx.Locale.Tr "asc_admin.moderation") "Icon" "flag" "Active" .PageIsAdminModerationReports)}}
			{{end}}
		</ul>

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_admin.grp_content"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/repos") "Label" (ctx.Locale.Tr "asc_admin.repositories") "Icon" "file" "Active" .PageIsAdminRepositories)}}
			{{if .EnablePackages}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/packages") "Label" (ctx.Locale.Tr "asc_admin.packages") "Icon" "package" "Active" .PageIsAdminPackages)}}
			{{end}}
			{{if .EnableFederation}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/federation/hosts") "Label" (ctx.Locale.Tr "asc_admin.federation") "Icon" "globe" "Active" (or .PageIsAdminFederationHosts .PageIsAdminFederationUsers))}}
			{{end}}
		</ul>

		{{if or .EnableActions (not DisableWebhooks) .EnableOAuth2}}
			<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_admin.grp_automation"}}</h2>
			<ul class="ds-settings-list">
				{{if .EnableActions}}
					{{template "shared/ds/snav_item" (dict "Href" (print $base "/actions/runners") "Label" (ctx.Locale.Tr "asc_admin.runners") "Icon" "cpu" "Active" (or .PageIsSharedSettingsRunners .PageIsSharedSettingsVariables))}}
				{{end}}
				{{if not DisableWebhooks}}
					{{template "shared/ds/snav_item" (dict "Href" (print $base "/hooks") "Label" (ctx.Locale.Tr "asc_admin.hooks_apps") "Icon" "link" "Active" (or .PageIsAdminDefaultHooks .PageIsAdminSystemHooks .PageIsAdminApplications))}}
				{{else if .EnableOAuth2}}
					{{template "shared/ds/snav_item" (dict "Href" (print $base "/applications") "Label" (ctx.Locale.Tr "asc_admin.hooks_apps") "Icon" "link" "Active" .PageIsAdminApplications)}}
				{{end}}
			</ul>
		{{end}}

		<h2 class="ds-settings-group">{{ctx.Locale.Tr "asc_admin.grp_system"}}</h2>
		<ul class="ds-settings-list">
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/config") "Label" (ctx.Locale.Tr "asc_admin.configuration") "Icon" "sliders" "Active" (or .PageIsAdminConfig .PageIsAdminConfigSummary .PageIsAdminConfigSettings))}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/monitor/queue") "Label" (ctx.Locale.Tr "asc_admin.monitor") "Icon" "server" "Active" (or .PageIsAdminMonitor .PageIsAdminMonitorStats .PageIsAdminMonitorCron .PageIsAdminMonitorQueue .PageIsAdminMonitorStacktrace))}}
			{{if .AscEnabled}}
				{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/audit") "Label" (ctx.Locale.Tr "asc_admin.audit") "Icon" "history" "Active" .PageIsAdminAscAudit)}}
			{{end}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/maintenance") "Label" (ctx.Locale.Tr "asc_admin.maintenance") "Icon" "alert" "Active" .PageIsAdminMaintenance)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/asc/backups") "Label" (ctx.Locale.Tr "asc_admin.backups") "Icon" "cloud-download" "Active" .PageIsAdminBackups)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/auths") "Label" (ctx.Locale.Tr "asc_admin.authentication") "Icon" "lock" "Active" .PageIsAdminAuthentications)}}
			{{template "shared/ds/snav_item" (dict "Href" (print $base "/notices") "Label" (ctx.Locale.Tr "asc_admin.notices") "Icon" "bell" "Active" .PageIsAdminNotices)}}
		</ul>
	</div>
</nav>
