{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin asc-backup-restore")}}
	{{template "admin/head" (dict "Title" (ctx.Locale.Tr "asc_shell.bk_restore_title") "Desc" (ctx.Locale.Tr "asc_shell.bk_restore_lead") "ActionLabel" (ctx.Locale.Tr "asc_shell.bk_back") "ActionHref" (print AppSubUrl "/admin/asc/backups") "ActionIcon" "arrow-left" "Secondary" true)}}
{{with .AscBackupRestore}}
	{{if .Problem}}
		<div class="ds-banner ds-banner-err" role="alert" data-testid="asc-restore-problem"><span aria-hidden="true">{{svg "dsi-alert" 18}}</span><div class="ds-banner-body">{{.Problem}}</div></div>
	{{else}}
	{{with .Preview}}
		<div class="ds-banner ds-banner-warn" role="note" data-testid="asc-restore-warning"><span aria-hidden="true">{{svg "dsi-alert" 18}}</span><div class="ds-banner-body"><strong>{{ctx.Locale.Tr "asc_shell.bk_restore_loses_title"}}.</strong> {{ctx.Locale.Tr "asc_shell.bk_restore_loses" (DateUtils.AbsoluteShort .LosesSince)}}{{if .ReadOnly}} {{ctx.Locale.Tr "asc_shell.bk_restore_readonly"}}{{end}}</div></div>
		{{range .Warnings}}<div class="ds-banner ds-banner-warn" role="note"><span aria-hidden="true">{{svg "dsi-alert" 18}}</span><div class="ds-banner-body">{{.}}</div></div>{{end}}

		<div class="ds-grid-stats" role="group" aria-label="{{ctx.Locale.Tr "asc_shell.bk_restore_holds"}}">
			{{template "shared/ds/stat" (dict "Label" (ctx.Locale.Tr "asc_shell.bk_col_started") "Value" (DateUtils.AbsoluteShort .Backup.Started) "Sub" .Backup.Target)}}
			{{template "shared/ds/stat" (dict "Label" (ctx.Locale.Tr "asc_shell.bk_restore_database") "Value" .Database)}}
			{{template "shared/ds/stat" (dict "Label" (ctx.Locale.Tr "asc_shell.bk_restore_objects") "Value" .Objects "Sub" .ObjectBytesText)}}
		</div>

		{{if not .Verified}}
		<div class="ds-banner ds-banner-err" role="status" data-testid="asc-restore-unverified"><span aria-hidden="true">{{svg "dsi-alert" 18}}</span><div class="ds-banner-body">{{ctx.Locale.Tr "asc_shell.bk_restore_unverified"}}</div></div>
		{{else}}
		<form class="ds-card adm-sec ds-form" method="post" action="{{$.AscBackupRestore.Base}}/{{$.AscBackupRestore.ID}}/restore" data-testid="asc-restore-form">
			{{$.CsrfTokenHtml}}
			<input type="hidden" name="op" value="{{$.AscBackupRestore.Op}}">
			<div class="ds-card-h"><h2>{{ctx.Locale.Tr "asc_shell.bk_restore_confirm_title"}}</h2></div>
			<div class="ds-card-b ds-stack-16">
				<div class="ds-field">
					<label class="ds-label" for="bk-confirm">{{ctx.Locale.Tr "asc_shell.bk_restore_type" $.AscBackupRestore.Word}}</label>
					<input id="bk-confirm" class="ds-input ds-mono" name="confirm" autocomplete="off" spellcheck="false" required pattern="{{$.AscBackupRestore.Word}}" aria-describedby="bk-confirm-hint">
					<p id="bk-confirm-hint" class="ds-hint">{{ctx.Locale.Tr "asc_shell.bk_restore_hint"}}</p>
				</div>
				<div class="ds-row"><button class="ds-btn ds-btn-danger" type="submit">{{ctx.Locale.Tr "asc_shell.bk_restore_stage"}}</button></div>
			</div>
		</form>
		{{end}}
	{{end}}
	{{end}}
{{end}}
{{template "admin/layout_footer" .}}
