{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin user")}}
	{{template "admin/head" (dict "Title" (ctx.Locale.Tr "admin.emails") "Desc" (ctx.Locale.Tr "asc_admin.emails_lead"))}}

	<div class="adm-filter">
		<form class="ds-filterbar-form ignore-dirty" role="search" method="get" action="{{AppSubUrl}}/admin/emails">
			<div class="ds-inwrap">
				{{svg "dsi-search" 16}}
				<label class="ds-sr" for="adm-mail-q">{{ctx.Locale.Tr "asc_admin.emails_search"}}</label>
				<input id="adm-mail-q" class="ds-input" type="search" name="q" value="{{.Keyword}}" maxlength="255" spellcheck="false" enterkeyhint="search" placeholder="{{ctx.Locale.Tr "asc_admin.emails_search"}}">
			</div>
			<label class="ds-selectpill">
				<span class="ds-sr">{{ctx.Locale.Tr "repo.issues.filter_sort"}}</span>
				<select name="sort">
					<option value="email"{{if or (eq .SortType "email") (not .SortType)}} selected{{end}}>{{ctx.Locale.Tr "admin.emails.filter_sort.email"}}</option>
					<option value="reverseemail"{{if eq .SortType "reverseemail"}} selected{{end}}>{{ctx.Locale.Tr "admin.emails.filter_sort.email_reverse"}}</option>
					<option value="username"{{if eq .SortType "username"}} selected{{end}}>{{ctx.Locale.Tr "admin.emails.filter_sort.name"}}</option>
					<option value="reverseusername"{{if eq .SortType "reverseusername"}} selected{{end}}>{{ctx.Locale.Tr "admin.emails.filter_sort.name_reverse"}}</option>
				</select>
				{{svg "dsi-chevron-down" 16}}
			</label>
			<button type="submit" class="ds-btn ds-btn-secondary">{{ctx.Locale.Tr "asc_shell.search_label"}}</button>
		</form>
	</div>

	{{if .Emails}}
		<div class="ds-table-wrap adm-only-md">
			<table class="ds-table">
				<caption class="ds-sr">{{ctx.Locale.Tr "admin.emails.email_manage_panel"}}</caption>
				<thead>
					<tr>
						<th scope="col">{{ctx.Locale.Tr "asc_admin.col_person"}}</th>
						<th scope="col">{{ctx.Locale.Tr "email"}}</th>
						<th scope="col">{{ctx.Locale.Tr "asc_admin.col_status"}}</th>
						<th scope="col"><span class="ds-sr">{{ctx.Locale.Tr "asc_admin.col_actions"}}</span></th>
					</tr>
				</thead>
				<tbody>
					{{range .Emails}}
						<tr>
							<td><a class="adm-who-name" href="{{AppSubUrl}}/{{.Name | PathEscape}}">{{if .FullName}}{{.FullName}}{{else}}{{.Name}}{{end}}</a>{{if .FullName}}<span class="adm-who-sub adm-mono">@{{.Name}}</span>{{end}}</td>
							<td class="ds-break">{{.Email}}</td>
							<td>{{template "admin/emails/state" (dict "Mail" . "Q" $)}}</td>
							<td class="ds-r"><button type="button" class="ds-btn ds-btn-danger ds-btn-sm delete-button" data-url="{{$.Link}}/delete" data-id="{{.ID}}" data-data-uid="{{.UID}}" data-modal-id="delete-email" aria-label="{{ctx.Locale.Tr "asc_admin.delete"}}: {{.Email}}">{{ctx.Locale.Tr "asc_admin.delete"}}</button></td>
						</tr>
					{{end}}
				</tbody>
			</table>
		</div>

		<ul class="ds-list adm-only-sm">
			{{range .Emails}}
				<li class="ds-li">
					<div class="ds-li-main">
						<div class="ds-li-title ds-break">{{.Email}}</div>
						<div class="ds-li-sub"><a class="ds-link" href="{{AppSubUrl}}/{{.Name | PathEscape}}">{{if .FullName}}{{.FullName}}{{else}}{{.Name}}{{end}}</a></div>
						<div class="ds-chips adm-chip-row">{{template "admin/emails/state" (dict "Mail" . "Q" $)}}</div>
						<div class="ds-li-actions"><button type="button" class="ds-btn ds-btn-danger delete-button" data-url="{{$.Link}}/delete" data-id="{{.ID}}" data-data-uid="{{.UID}}" data-modal-id="delete-email">{{svg "dsi-trash" 16}}{{ctx.Locale.Tr "asc_admin.delete"}}</button></div>
					</div>
				</li>
			{{end}}
		</ul>

		<div class="adm-table-foot">
			<p class="ds-t-small ds-c-2">{{ctx.Locale.Tr "asc_admin.shown_of" (len .Emails) .Total}}</p>
			{{template "base/paginate" .}}
		</div>
	{{else}}
		<div class="ds-card">
			{{template "shared/ds/empty" (dict "Icon" "mail" "Title" (ctx.Locale.Tr "asc_admin.no_results_title") "Body" (ctx.Locale.Tr "asc_admin.emails_no_results") "PrimaryLabel" (ctx.Locale.Tr "asc_admin.clear_filters") "PrimaryHref" (print AppSubUrl "/admin/emails"))}}
		</div>
	{{end}}

<dialog id="change-email-modal">
	<article>
		<header>{{ctx.Locale.Tr "admin.emails.change_email_header"}}</header>
		<form id="email-action-form" action="{{AppSubUrl}}/admin/emails/activate" method="post">
			{{.CsrfTokenHtml}}
			<div class="content"><p>{{ctx.Locale.Tr "admin.emails.change_email_text"}}</p></div>
			<input type="hidden" id="query-sort" name="sort" value="{{.SortType}}">
			<input type="hidden" id="query-keyword" name="q" value="{{.Keyword}}">
			<input type="hidden" id="query-primary" name="is_primary" value="{{.IsPrimary}}" required>
			<input type="hidden" id="query-activated" name="is_activated" value="{{.IsActivated}}" required>
			<input type="hidden" id="form-uid" name="uid" value="" required>
			<input type="hidden" id="form-email" name="email" value="" required>
			<input type="hidden" id="form-primary" name="primary" value="" required>
			<input type="hidden" id="form-activate" name="activate" value="" required>
			<div class="actions">
				<button type="button" class="ds-btn ds-btn-secondary cancel">{{ctx.Locale.Tr "cancel"}}</button>
				<button type="submit" class="ds-btn ds-btn-primary">{{ctx.Locale.Tr "modal.confirm"}}</button>
			</div>
		</form>
	</article>
</dialog>

<div class="ui g-modal-confirm delete modal" id="delete-email">
	<div class="header">
		{{svg "octicon-trash"}}
		{{ctx.Locale.Tr "admin.emails.delete"}}
	</div>
	<div class="content">
		{{ctx.Locale.Tr "admin.emails.delete_desc"}}
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>
{{template "admin/layout_footer" .}}
