{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content hub-download">
	<div class="hub-container">
		<header class="hub-page-head">
			<h1 class="hub-page-title">{{ctx.Locale.Tr "asc_download.title"}}</h1>
			<p class="hub-page-lead">{{ctx.Locale.Tr "asc_download.lead"}}</p>
		</header>

		{{if .AscDownloadAdminNote}}
			<div class="ui warning message" role="note">
				<div class="header">{{ctx.Locale.Tr "asc_download.admin_note_title"}}</div>
				<p>{{.AscDownloadAdminNote}}</p>
			</div>
		{{end}}

		{{with .AscDownload}}
		{{$view := .}}
		{{$offers := .Offers}}
		{{$m := .Offers.Manifest}}
		<div class="hub-dl-meta">
			<span class="hub-chip hub-chip-accent">{{ctx.Locale.Tr "asc_download.version" $m.Version}}</span>
			{{if $m.ReleasedAt}}<span class="hub-dl-meta-text">{{ctx.Locale.Tr "asc_download.released" $m.ReleasedAt}}</span>{{end}}
			{{if $m.ReleaseNotesURL}}<a class="hub-dl-meta-link" href="{{$m.ReleaseNotesURL}}" target="_blank" rel="noopener noreferrer">{{ctx.Locale.Tr "asc_download.release_notes"}}</a>{{end}}
		</div>

		<div class="hub-dl-layout">
			<div class="hub-dl hub-dl-main" data-asc-download data-active-os="{{$view.ActiveOS}}" data-active-arch="{{$view.ActiveArch}}">
				{{if $view.Detected}}<p class="hub-dl-detected">{{ctx.Locale.Tr "asc_download.detected"}}</p>{{end}}
				<div class="hub-dl-tabs" role="tablist" aria-label="{{ctx.Locale.Tr "asc_download.choose_system"}}" hidden>
					{{range $offers.OSes}}
						<button type="button" role="tab" class="hub-dl-tab" id="asc-dl-tab-{{.OS}}" data-os="{{.OS}}" aria-controls="asc-dl-{{.OS}}" aria-selected="{{if eq .OS $view.ActiveOS}}true{{else}}false{{end}}" tabindex="{{if eq .OS $view.ActiveOS}}0{{else}}-1{{end}}">{{.Label}}</button>
					{{end}}
				</div>

				{{range $os := $offers.OSes}}
				<section class="hub-dl-panel" id="asc-dl-{{$os.OS}}" data-os="{{$os.OS}}" role="tabpanel" aria-labelledby="asc-dl-tab-{{$os.OS}}">
					<h2 class="hub-dl-panel-title">{{$os.Label}}</h2>
					{{range $arch := $os.Arches}}
					{{$recommended := and (eq $os.OS $view.ActiveOS) (eq $arch.Arch $view.ActiveArch) $view.Detected}}
					<article class="hub-dl-arch" data-arch="{{$arch.Arch}}"{{if $recommended}} data-recommended{{end}}>
						<header class="hub-dl-arch-head">
							<h3 class="hub-dl-arch-title">{{$arch.Label}}</h3>
							<span class="hub-chip hub-chip-accent hub-dl-badge"{{if not $recommended}} hidden{{end}}>{{ctx.Locale.Tr "asc_download.recommended"}}</span>
						</header>
						{{with $arch.Primary}}
							<a class="ui primary button hub-dl-button" href="{{.URL}}" download="{{.Name}}">
								{{svg "octicon-download" 18}}
								<span>{{ctx.Locale.Tr "asc_download.download_for" $os.Label}}</span>
								<span class="hub-dl-button-size">{{ctx.Locale.TrSize .Size}}</span>
							</a>
						{{end}}

						<ul class="hub-dl-files">
							{{range $arch.Files}}
							<li class="hub-dl-file">
								<div class="hub-dl-file-head">
									<a class="hub-dl-file-name" href="{{.URL}}" download="{{.Name}}">{{.Name}}</a>
									<span class="hub-dl-file-meta">{{ctx.Locale.Tr (printf "asc_download.kind_%s" .Kind)}} &middot; {{ctx.Locale.TrSize .Size}}</span>
								</div>
								<div class="hub-dl-hash">
									<span class="hub-dl-hash-label">{{ctx.Locale.Tr "asc_download.sha256"}}</span>
									<code class="hub-hash">{{.SHA256}}</code>
									<button type="button" class="ui basic compact icon button hub-copy" data-clipboard-text="{{.SHA256}}" aria-label="{{ctx.Locale.Tr "asc_download.copy_hash"}}">{{svg "octicon-copy" 16}}</button>
								</div>
								{{if .SignatureURL}}<a class="hub-dl-file-sig" href="{{.SignatureURL}}" download="{{.Signature}}">{{svg "octicon-verified" 16}} {{ctx.Locale.Tr "asc_download.signature"}} ({{.Signature}})</a>{{end}}
							</li>
							{{end}}
						</ul>

						{{range $arch.Commands}}
						<div class="hub-dl-command">
							<div class="hub-dl-command-head">
								<h4 class="hub-dl-command-title">{{svg "octicon-terminal" 16}} {{ctx.Locale.Tr "asc_download.install_title"}} <span class="hub-dl-command-shell">{{.Title}}</span></h4>
								<button type="button" class="ui basic compact button hub-copy" data-clipboard-text="{{.Text}}">{{svg "octicon-copy" 16}} <span>{{ctx.Locale.Tr "asc_download.copy"}}</span></button>
							</div>
							<pre class="hub-code" tabindex="0"><code>{{.Text}}</code></pre>
						</div>
						{{end}}
					</article>
					{{end}}

					{{if $os.PackageCommands}}
					<div class="hub-dl-packages">
						<h3 class="hub-dl-arch-title">{{ctx.Locale.Tr "asc_download.package_managers"}}</h3>
						{{range $os.PackageCommands}}
						<div class="hub-dl-command">
							<div class="hub-dl-command-head">
								<h4 class="hub-dl-command-title">{{svg "octicon-package" 16}} {{.Title}}</h4>
								<button type="button" class="ui basic compact button hub-copy" data-clipboard-text="{{.Text}}">{{svg "octicon-copy" 16}} <span>{{ctx.Locale.Tr "asc_download.copy"}}</span></button>
							</div>
							<pre class="hub-code" tabindex="0"><code>{{.Text}}</code></pre>
						</div>
						{{end}}
					</div>
					{{end}}
				</section>
				{{end}}
				<p class="hub-dl-note">{{svg "octicon-shield-check" 16}} {{ctx.Locale.Tr "asc_download.install_check_note"}}</p>
			</div>

			<aside class="hub-dl-side">
				<section class="hub-panel" aria-labelledby="asc-connect-title">
					<h2 class="hub-panel-title" id="asc-connect-title">{{ctx.Locale.Tr "asc_download.connect_title"}}</h2>
					<p class="hub-panel-text">{{ctx.Locale.Tr "asc_download.connect_desc"}}</p>
					<div class="hub-dl-command">
						<div class="hub-dl-command-head">
							<span class="hub-dl-command-shell">{{ctx.Locale.Tr "asc_download.terminal"}}</span>
							<button type="button" class="ui basic compact button hub-copy" data-clipboard-text="{{$offers.ConnectCommand}}">{{svg "octicon-copy" 16}} <span>{{ctx.Locale.Tr "asc_download.copy"}}</span></button>
						</div>
						<pre class="hub-code" tabindex="0"><code>{{$offers.ConnectCommand}}</code></pre>
					</div>
					<a class="hub-panel-link" href="{{AppSubUrl}}/user/settings/applications">{{ctx.Locale.Tr "asc_download.create_token"}}</a>
				</section>

				{{if or $m.Extensions.VSCode $m.Extensions.JetBrains}}
				<section class="hub-panel" aria-labelledby="asc-editors-title">
					<h2 class="hub-panel-title" id="asc-editors-title">{{ctx.Locale.Tr "asc_download.extensions_title"}}</h2>
					<ul class="hub-link-list">
						{{if $m.Extensions.VSCode}}<li><a href="{{$m.Extensions.VSCode}}" target="_blank" rel="noopener noreferrer">{{ctx.Locale.Tr "asc_download.extension_vscode"}}</a></li>{{end}}
						{{if $m.Extensions.JetBrains}}<li><a href="{{$m.Extensions.JetBrains}}" target="_blank" rel="noopener noreferrer">{{ctx.Locale.Tr "asc_download.extension_jetbrains"}}</a></li>{{end}}
					</ul>
				</section>
				{{end}}

				{{if $offers.Checksums}}
				<section class="hub-panel" aria-labelledby="asc-verify-title">
					<h2 class="hub-panel-title" id="asc-verify-title">{{ctx.Locale.Tr "asc_download.checksums_title"}}</h2>
					<p class="hub-panel-text">{{ctx.Locale.Tr "asc_download.checksums_desc"}}</p>
					<ul class="hub-link-list">
						<li><a href="{{$offers.Checksums.URL}}" download="{{$offers.Checksums.Name}}">{{ctx.Locale.Tr "asc_download.checksums_file"}} ({{$offers.Checksums.Name}})</a></li>
						{{if $offers.ChecksumsSig}}<li><a href="{{$offers.ChecksumsSig.URL}}" download="{{$offers.ChecksumsSig.Name}}">{{ctx.Locale.Tr "asc_download.checksums_signature"}} ({{$offers.ChecksumsSig.Name}})</a></li>{{end}}
					</ul>
					{{if $m.MinisignPublicKey}}
					<p class="hub-panel-text hub-panel-label">{{ctx.Locale.Tr "asc_download.public_key"}}</p>
					<code class="hub-hash">{{$m.MinisignPublicKey}}</code>
					{{end}}
					{{if $offers.VerifyCommand}}
					<div class="hub-dl-command">
						<div class="hub-dl-command-head">
							<span class="hub-dl-command-shell">{{ctx.Locale.Tr "asc_download.verify_command"}}</span>
							<button type="button" class="ui basic compact button hub-copy" data-clipboard-text="{{$offers.VerifyCommand}}">{{svg "octicon-copy" 16}} <span>{{ctx.Locale.Tr "asc_download.copy"}}</span></button>
						</div>
						<pre class="hub-code" tabindex="0"><code>{{$offers.VerifyCommand}}</code></pre>
					</div>
					{{end}}
				</section>
				{{end}}
			</aside>
		</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
