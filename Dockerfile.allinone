# ASC Hub in one image: the hub (a Forgejo v16 fork) and the asc backend (`asc` and `asc serve`).
#
#   docker build -f Dockerfile.allinone --build-arg ASC_IMAGE=ghcr.io/jordan-hall/asc-serve:<tag> -t asc-hub .
#
# ASC_IMAGE is the published asc-serve image that the `asc` binary is copied from. There is no
# default tag on purpose: pin the one you tested with, by digest (image@sha256:...). The hub is built exactly as in
# Dockerfile.rootless (same build stage), then both programs run under asc-hub-entrypoint.
#
# The runtime base is Debian (glibc), not Alpine, because the asc binary is built against glibc.
# The hub binary is a static executable, so it runs on either.

ARG ASC_IMAGE

# Fails with a blank base name when ASC_IMAGE is not given.
FROM ${ASC_IMAGE} AS asc-bin

# data.forgejo.org/oci/xx:latest
FROM --platform=$BUILDPLATFORM data.forgejo.org/oci/xx@sha256:40fe21f44bb8cddf1eb1226db190d0a984118f62ee02a91b77d99448d28264a6 AS xx

# data.forgejo.org/oci/golang:1.26-alpine3.23
FROM --platform=$BUILDPLATFORM data.forgejo.org/oci/golang@sha256:34414731924cf2263160f0021f5cf6e1807382d85248f7cb419d4187b96d5e43 AS build-env

ARG GOPROXY
ENV GOPROXY=${GOPROXY:-https://proxy.golang.org,direct}

ARG RELEASE_VERSION
ARG TAGS="sqlite sqlite_unlock_notify"
ENV TAGS="bindata timetzdata $TAGS"
ARG CGO_EXTRA_CFLAGS

#
# Transparently cross compile for the target platform
#
COPY --from=xx / /
ARG TARGETPLATFORM
RUN apk --no-cache add clang lld
RUN xx-apk --no-cache add gcc musl-dev
ENV CGO_ENABLED=1
RUN xx-go --wrap
#
# for go generate and binfmt to find
#
RUN cp /*-alpine-linux-musl*/lib/ld-musl-*.so.1 /lib || true

RUN apk --no-cache add build-base git nodejs npm

COPY . ${GOPATH}/src/forgejo.org
WORKDIR ${GOPATH}/src/forgejo.org

RUN make clean-no-bindata
RUN make frontend
# environment-to-ini has no C dependency here: build it static so that it runs on the Debian base.
RUN CGO_ENABLED=0 go build contrib/environment-to-ini/environment-to-ini.go && xx-verify --static environment-to-ini
RUN make FORGEJO_GENERATE_SKIP_HASH=true RELEASE_VERSION=$RELEASE_VERSION go-check generate-backend static-executable && xx-verify gitea

# Copy local files
COPY docker/rootless /tmp/local
COPY docker/allinone /tmp/allinone

# Set permissions
RUN chmod 755 /tmp/local/usr/local/bin/docker-entrypoint.sh \
              /tmp/local/usr/local/bin/docker-setup.sh \
              /tmp/local/usr/local/bin/gitea \
              /tmp/allinone/usr/local/bin/asc-hub-entrypoint \
              /tmp/allinone/usr/local/bin/asc-hub-healthcheck \
              /tmp/allinone/usr/local/bin/asc-hub-backup \
              /go/src/forgejo.org/gitea \
              /go/src/forgejo.org/environment-to-ini
RUN chmod 644 /go/src/forgejo.org/contrib/autocompletion/bash_autocomplete

# Same Debian base (tag and digest) as the asc-serve image.
FROM debian:trixie-20261020-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
ARG RELEASE_VERSION
ARG ASC_IMAGE
LABEL maintainer="ASC Hub" \
      org.opencontainers.image.authors="The ASC Authors, based on Forgejo" \
      org.opencontainers.image.url="https://github.com/Jordan-Hall/asc-hub" \
      org.opencontainers.image.documentation="https://github.com/Jordan-Hall/asc-hub/blob/asc/v16/docs/asc/OPERATIONS.md" \
      org.opencontainers.image.source="https://github.com/Jordan-Hall/asc-hub" \
      org.opencontainers.image.version="${RELEASE_VERSION}" \
      org.opencontainers.image.vendor="ASC" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.title="ASC Hub" \
      org.opencontainers.image.description="ASC Hub with asc serve in one container: source control for people and their agents. A fork of Forgejo." \
      io.asc.serve.image="${ASC_IMAGE}"

# 3000: web, behind your HTTPS proxy. Nothing else is exposed: git over SSH is off (no SSH server starts)
# unless ASC_HUB_SSH_ENABLE=true, and then you publish its port yourself. asc serve listens on 127.0.0.1:7890 only.
EXPOSE 3000

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      curl \
      dumb-init \
      findutils \
      gettext-base \
      git \
      gnupg \
      gzip \
      openssh-client \
      tar \
      util-linux \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 1000 git \
 && useradd --system --uid 1000 --gid 1000 --home-dir /var/lib/gitea/git --no-create-home --shell /bin/bash git \
 && mkdir -p /var/lib/gitea \
 && chown git:git /var/lib/gitea

COPY --from=build-env /tmp/local /
COPY --from=build-env /tmp/allinone /
RUN cd /usr/local/bin ; ln -s gitea forgejo
COPY --from=build-env --chown=root:root /go/src/forgejo.org/gitea /app/gitea/gitea
RUN ln -s /app/gitea/gitea /app/gitea/forgejo-cli
COPY --from=build-env --chown=root:root /go/src/forgejo.org/environment-to-ini /usr/local/bin/environment-to-ini
COPY --from=build-env /go/src/forgejo.org/contrib/autocompletion/bash_autocomplete /etc/profile.d/gitea_bash_autocomplete.sh
# The asc binary is the CLI and the server (`asc serve`); a lazy git bridge also runs it as [asc] ASC_BINARY.
COPY --from=asc-bin --chown=root:root /usr/local/bin/asc /usr/local/bin/asc

#git:git
USER 1000:1000
ENV GITEA_WORK_DIR=/var/lib/gitea
ENV GITEA_CUSTOM=/var/lib/gitea/custom
ENV GITEA_TEMP=/tmp/gitea
ENV TMPDIR=/tmp/gitea

ENV GITEA_APP_INI=${GITEA_CUSTOM}/conf/app.ini
ENV HOME="/var/lib/gitea/git"
# HTTPS only by default: no SSH server. ASC_HUB_SSH_ENABLE=true (see docs/asc/OPERATIONS.md) turns it on.
ENV ASC_HUB_SSH_ENABLE=false \
    DISABLE_SSH=true \
    START_SSH_SERVER=false
VOLUME ["/var/lib/gitea"]
WORKDIR /var/lib/gitea

# Healthy only when the hub and asc serve both answer.
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD ["/usr/local/bin/asc-hub-healthcheck"]

STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/bin/dumb-init", "--single-child", "--", "/usr/local/bin/asc-hub-entrypoint"]
CMD []
